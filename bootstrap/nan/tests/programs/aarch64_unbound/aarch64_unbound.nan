//! Loads from an address the entry root leaves unmapped, which halts the kernel on the unbound abort vector.

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    take k.anchor(0u8, run: fn(exec: task::Executor) limits stack 16_384 {
        discard trusted "the kernel halts at the load, which no handler resumes" { hw::Ptr[u64].of_addr(0x1_0000_0000).read() }
    })
} main
