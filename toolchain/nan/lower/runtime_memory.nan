//! Memory: byte copies, fills and comparisons; the cell table with each cell's limit, charge, parent and state; chunks of 64 KiB drawn through a cell and charged to its chain; and the allocations carved from the chunks a domain draws through one cell. A cell handle is the cell's index in its low 32 bits and its generation in its high 32. A cell record is its limit, its charge, its parent's index plus one, its generation, whether it is open and, for a chain whose root cell is over a region, the supply of the region's chunks, which each cell of the chain copies from its parent and draws from instead of the platform. Each drawn run of chunks has a record, found from the address of its first chunk through the chunk map: its cell handle, its domain, its live allocation count, the offset of its free bytes, its chunk count, its links in its domain's list and its address. A run passes to an enclosing domain when a value it holds leaves the domain owning it, and the runs a domain still owns are freed when it ends.

const MEMORY_CHUNK: u64 = 65_536

/// The most returned single chunks the runtime keeps mapped for the next draws.
const MEMORY_KEPT: u64 = 64

/// The cell table's capacity.
const MEMORY_CELLS: u64 = 65_536

const CELL_RECORD: u64 = 40

/// The chunk map: a table of 2^15 pointers, indexed by bits 47 to 32 of a chunk's address, to
/// tables of 2^16 chunk records, indexed by bits 31 to 16.
const MAP_ROOTS: u64 = 32_768

const MAP_LEAVES: u64 = 65_536

const CELL_LIMIT: u64 = 0

const CELL_CHARGE: u64 = 8

const CELL_PARENT: u64 = 16

const CELL_GENERATION: u64 = 20

const CELL_OPEN: u64 = 24

const CELL_SUPPLY: u64 = 32

/// The offsets of a region's supply record: its first chunk's address, its chunk count, then its
/// map of a bit per chunk.
const SUPPLY_BASE: u64 = 0

const SUPPLY_COUNT: u64 = 8

const SUPPLY_MAP: u64 = 16

const CHUNK_CELL: u64 = 0

const CHUNK_DOMAIN: u64 = 8

const CHUNK_LIVE: u64 = 16

const CHUNK_USED: u64 = 24

const CHUNK_COUNT: u64 = 32

const CHUNK_NEXT: u64 = 40

const CHUNK_PREVIOUS: u64 = 48

const CHUNK_BASE: u64 = 56

const CHUNK_SIZE: u64 = 64

/// A domain's pool of the chunk it carves for one cell: the next pool, the cell handle and the
/// chunk's record.
const MEMORY_POOL_NEXT: u64 = 0

const MEMORY_POOL_CELL: u64 = 8

const MEMORY_POOL_CHUNK: u64 = 16

const MEMORY_POOL_SIZE: u64 = 24

/// The least alignment of an allocation carved from a chunk on a machine target, which suits
/// devices reaching a DMA buffer of any type.
const MIN_ALIGN: u64 = 16

/// The byte routines of `mem_op`: the C library's on `x86_64-host`; on a machine target, which
/// has no C library, the copy and fill compiler stubs and a comparison loop.
fn memory_bytes(mut lo: Lowering, mut fx: Fx, routine: Routine) {
    let params = mut fx.entry()
    expect params.len() > 2
    if lo.machine() {
        machine_bytes(mut lo, mut fx, routine, params: params.view())
        return
    }
    match routine {
        Routine.Copy => {
            discard mut lo.call_libc(mut fx, name: "memmove", args: params.view(), returns: fx.types1(PTR).view())
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.Fill => {
            let byte = mut fx.b.ireduce(clif::Type.Int32, x: params[1])
            discard mut lo.call_libc(mut fx, name: "memset", args: fx.list3(params[0], b: byte, c: params[2]).view(), returns: fx.types1(PTR).view())
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        else => {
            let order = mut lo.call_libc(mut fx, name: "memcmp", args: params.view(), returns: fx.types1(clif::Type.Int32).view())
            mut fx.b.ret(order.view())
        }
    }
} memory_bytes

/// The byte routines of a machine target.
fn machine_bytes(mut lo: Lowering, mut fx: Fx, routine: Routine, params: Slice[clif::Value]) {
    let flags = clif::MemFlags.unaligned()
    let zero = mut fx.ptr(0)
    match routine {
        Routine.Copy => {
            discard mut lo.call_stub(mut fx, stub: Stub.Copy, args: params)
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.Fill => {
            discard mut lo.call_stub(mut fx, stub: Stub.Fill, args: params)
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        else => {
            expect params.len() > 2
            let left = params[0]
            let right = params[1]
            let len = params[2]
            let equal = mut fx.int(clif::Type.Int32, value: 0)
            let compared = mut fx.repeat(fx.list2(zero, b: equal).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
                expect state.len() > 0
                let index = state[0]
                let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: index, y: len)
                let ordered = mut fx1.choose(inside, results: fx1.types1(clif::Type.Int32).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
                    let left_at = mut fx2.b.iadd(left, y: index)
                    let right_at = mut fx2.b.iadd(right, y: index)
                    let left_byte = mut fx2.b.load(clif::Type.Int8, flags, p: left_at, offset: 0)
                    let right_byte = mut fx2.b.load(clif::Type.Int8, flags, p: right_at, offset: 0)
                    let left_wide = mut fx2.b.uextend(clif::Type.Int32, x: left_byte)
                    let right_wide = mut fx2.b.uextend(clif::Type.Int32, x: right_byte)
                    let difference = mut fx2.b.isub(left_wide, y: right_wide)
                    return fx2.list1(difference)
                }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
                    let same_bytes = mut fx2.int(clif::Type.Int32, value: 0)
                    return fx2.list1(same_bytes)
                })
                let order = ordered[0]
                let same = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: order, y: 0)
                let more = mut fx1.b.band(inside, y: same)
                let next = mut fx1.b.iadd_imm_s(index, y: 1)
                return Pass(again: more, next: fx1.list2(next, b: order))
            })
            mut fx.b.ret(fx.list1(compared[1]).view())
        }
    }
} machine_bytes

fn memory_define(mut lo: Lowering, mut fx: Fx, routine: Routine) {
    let params = mut fx.entry()
    expect params.len() > 0
    match routine {
        Routine.Alloc or Routine.AllocIn => {
            let domain = match routine {
                Routine.Alloc => current_domain(mut lo, mut fx)
                else => params[3]
            }
            let state_address = mut lo.state(mut fx)
            let lock = mut fx.offset(state_address, offset: STATE_LOCK)
            discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
            let address = allocate(mut lo, mut fx, handle: params[0], size: params[1], align: params[2], domain)
            discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
            mut fx.b.ret(fx.list1(address).view())
        }
        Routine.Free => {
            let state_address = mut lo.state(mut fx)
            let lock = mut fx.offset(state_address, offset: STATE_LOCK)
            discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
            memory_release(mut lo, mut fx, address: params[0])
            discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.Split => {
            let state_address = mut lo.state(mut fx)
            let lock = mut fx.offset(state_address, offset: STATE_LOCK)
            discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
            let handle = new_cell(mut lo, mut fx, limit: params[1], parent: params[0])
            discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
            mut fx.b.ret(fx.list1(handle).view())
        }
        Routine.Close => {
            let state_address = mut lo.state(mut fx)
            let lock = mut fx.offset(state_address, offset: STATE_LOCK)
            discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
            let record = live_cell(mut lo, mut fx, handle: params[0])
            let found = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
            mut fx.if_true(found, then: fn(mut fx1: Fx) {
                let closed = mut fx1.int(clif::Type.Int32, value: 0)
                mut fx1.store(closed, addr: record, offset: CELL_OPEN)
                let generation = mut fx1.load(clif::Type.Int32, addr: record, offset: CELL_GENERATION)
                let next = mut fx1.b.iadd_imm_s(generation, y: 1)
                mut fx1.store(next, addr: record, offset: CELL_GENERATION)
            })
            discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.Charged or Routine.Limit => {
            let record = memory_cell_record(mut lo, mut fx, handle: params[0])
            let field = match routine {
                Routine.Charged => CELL_CHARGE
                else => CELL_LIMIT
            }
            let bytes = mut fx.load(PTR, addr: record, offset: field)
            mut fx.b.ret(fx.list1(bytes).view())
        }
        Routine.TaskEnv => {
            let address = mut lo.record_alloc(mut fx, size: params[0])
            let failed = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: address, y: 0)
            mut fx.if_true(failed, then: fn[mut lo](mut fx1: Fx) {
                raise_kind(mut lo, fx: mut fx1, kind: "trap.exhausted")
            })
            mut fx.b.ret(fx.list1(address).view())
        }
        Routine.TaskEnvFree => {
            mut lo.record_free(mut fx, address: params[0])
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.Lift => {
            let state_address = mut lo.state(mut fx)
            let lock = mut fx.offset(state_address, offset: STATE_LOCK)
            discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
            let lifted = memory_lift(mut lo, mut fx, address: params[0], to: params[1])
            discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
            mut fx.b.ret(fx.list1(lifted).view())
        }
        else => {
            expect false
        }
    }
} memory_define

/// The record of a cell by handle, whatever its generation.
fn memory_cell_record(mut lo: Lowering, mut fx: Fx, handle: clif::Value) -> clif::Value {
    let index = mut fx.b.band_imm_s(handle, y: 0xFFFF_FFFF)
    return record_at(mut lo, mut fx, index)
} memory_cell_record

fn record_at(mut lo: Lowering, mut fx: Fx, index: clif::Value) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    let cells = mut fx.load(PTR, addr: state_address, offset: STATE_CELLS)
    let offset = mut fx.b.imul_imm_s(index, y: i64.fit(CELL_RECORD))
    return mut fx.b.iadd(cells, y: offset)
} record_at

/// The record of a cell whose handle is live, zero for a stale one.
fn live_cell(mut lo: Lowering, mut fx: Fx, handle: clif::Value) -> clif::Value {
    let record = memory_cell_record(mut lo, mut fx, handle)
    let generation = mut fx.load(clif::Type.Int32, addr: record, offset: CELL_GENERATION)
    let shifted = mut fx.b.ushr_imm_s(handle, y: 32)
    let wanted = mut fx.b.ireduce(clif::Type.Int32, x: shifted)
    let live = mut fx.b.icmp(clif::IntCC.Equal, x: generation, y: wanted)
    let zero = mut fx.ptr(0)
    return mut fx.b.select(live, x: record, y: zero)
} live_cell

/// Adds a cell with a limit under a parent handle, or a root cell when the parent is the
/// all-ones handle; gives its handle.
fn new_cell(mut lo: Lowering, mut fx: Fx, limit: clif::Value, parent: clif::Value) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    let count = mut fx.load(PTR, addr: state_address, offset: STATE_CELL_COUNT)
    let full = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: count, y: i64.fit(MEMORY_CELLS))
    mut fx.if_true(full, then: fn[mut lo](mut fx1: Fx) {
        raise_kind(mut lo, fx: mut fx1, kind: "trap.exhausted")
    })
    let next = mut fx.b.iadd_imm_s(count, y: 1)
    mut fx.store(next, addr: state_address, offset: STATE_CELL_COUNT)
    let record = record_at(mut lo, mut fx, index: count)
    mut fx.store(limit, addr: record, offset: CELL_LIMIT)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: record, offset: CELL_CHARGE)
    let root = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: parent, y: -1)
    let parent_low = mut fx.b.band_imm_s(parent, y: 0xFFFF_FFFF)
    let parent_plus = mut fx.b.iadd_imm_s(parent_low, y: 1)
    let parent_narrow = mut fx.b.ireduce(clif::Type.Int32, x: parent_plus)
    let none = mut fx.int(clif::Type.Int32, value: 0)
    let parent_index = mut fx.b.select(root, x: none, y: parent_narrow)
    mut fx.store(parent_index, addr: record, offset: CELL_PARENT)
    mut fx.store(none, addr: record, offset: CELL_GENERATION)
    let open = mut fx.int(clif::Type.Int32, value: 1)
    mut fx.store(open, addr: record, offset: CELL_OPEN)
    let supplies = mut fx.choose_in(mut lo, condition: root, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let no_supply = mut fx1.ptr(0)
        return fx1.list1(no_supply)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let index = mut fx1.b.band_imm_s(parent, y: 0xFFFF_FFFF)
        let parent_record = record_at(mut lo1, fx: mut fx1, index)
        let inherited = mut fx1.load(PTR, addr: parent_record, offset: CELL_SUPPLY)
        return fx1.list1(inherited)
    })
    mut fx.store(supplies[0], addr: record, offset: CELL_SUPPLY)
    return count
} new_cell

/// Adds a root cell whose supply is the `count` chunks from `head` and whose limit is their
/// size; gives its handle. The caller holds the lock.
fn memory_region_cell(mut lo: Lowering, mut fx: Fx, head: clif::Value, count: clif::Value) -> clif::Value {
    let limit = mut fx.b.imul_imm_s(count, y: i64.fit(MEMORY_CHUNK))
    let root = mut fx.int(PTR, value: -1)
    let handle = new_cell(mut lo, mut fx, limit, parent: root)
    let rounded = mut fx.b.iadd_imm_s(count, y: 63)
    let words = mut fx.b.ushr_imm_s(rounded, y: 6)
    let map_size = mut fx.b.imul_imm_s(words, y: 8)
    let size = mut fx.b.iadd_imm_s(map_size, y: i64.fit(SUPPLY_MAP))
    let record = mut lo.record_alloc(mut fx, size)
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
    mut fx.if_true(missing, then: fn[mut lo](mut fx1: Fx) {
        raise_kind(mut lo, fx: mut fx1, kind: "trap.exhausted")
    })
    mut fx.store(head, addr: record, offset: SUPPLY_BASE)
    mut fx.store(count, addr: record, offset: SUPPLY_COUNT)
    let cell = memory_cell_record(mut lo, mut fx, handle)
    mut fx.store(record, addr: cell, offset: CELL_SUPPLY)
    return handle
} memory_region_cell

/// A region's supply by its record.
fn region_supply(mut fx: Fx, record: clif::Value) -> ChunkSupply {
    let base = mut fx.load(PTR, addr: record, offset: SUPPLY_BASE)
    let count = mut fx.load(PTR, addr: record, offset: SUPPLY_COUNT)
    let map = mut fx.offset(record, offset: SUPPLY_MAP)
    return ChunkSupply(base: base, count: count, map: map)
} region_supply

/// Draws `count` chunks through a cell: charges every cell of its chain and maps them, or gives
/// zero when a cell of the chain is closed or would pass its limit, or the supply runs out.
fn memory_draw(mut lo: Lowering, mut fx: Fx, handle: clif::Value, count: clif::Value) -> clif::Value {
    let head = live_cell(mut lo, mut fx, handle)
    let bytes = mut fx.b.imul_imm_s(count, y: i64.fit(MEMORY_CHUNK))
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
    let fits = chain_fits(mut lo, mut fx, head, bytes, start: present)
    let drawn_chunks = mut fx.choose(fits, results: fx.types1(PTR).view(), then: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let region = mut fx1.load(PTR, addr: head, offset: CELL_SUPPLY)
        let platform = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: region, y: 0)
        return mut fx1.choose_in(mut lo, condition: platform, results: fx1.types1(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let taken_chunks = platform_chunks(mut lo2, fx: mut fx2, count)
            return fx2.list1(taken_chunks)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let supply = region_supply(mut fx2, record: region)
            let base = take_chunks(mut fx2, supply, count)
            let taken = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: base, y: 0)
            mut fx2.if_true(taken, then: fn[mut lo2](mut fx3: Fx) {
                let len = mut fx3.b.imul_imm_s(count, y: i64.fit(MEMORY_CHUNK))
                heap_clear(mut lo2, fx: mut fx3, base, len)
            })
            return fx2.list1(base)
        })
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let unmapped = mut fx1.ptr(0)
        return fx1.list1(unmapped)
    })
    let mapped = drawn_chunks[0]
    let drawn = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: mapped, y: 0)
    mut fx.if_true(drawn, then: fn[mut lo](mut fx1: Fx) {
        walk_chain(mut lo, fx: mut fx1, head, visit: fn(mut fx2: Fx, record: clif::Value) {
            let charge = mut fx2.load(PTR, addr: record, offset: CELL_CHARGE)
            let charged = mut fx2.b.iadd(charge, y: bytes)
            mut fx2.store(charged, addr: record, offset: CELL_CHARGE)
        })
    })
    return mapped
} memory_draw

/// Whether every cell of the chain from a record is open and stays within its limit with
/// `bytes` more charged.
fn chain_fits(mut lo: Lowering, mut fx: Fx, head: clif::Value, bytes: clif::Value, start: clif::Value) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    let cells = mut fx.load(PTR, addr: state_address, offset: STATE_CELLS)
    let result = mut fx.repeat(fx.list2(head, b: start).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 1
        let record = state[0]
        let fits = state[1]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
        let checked = mut fx1.choose(present, results: fx1.types2(PTR, b: clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let open_word = mut fx2.load(clif::Type.Int32, addr: record, offset: CELL_OPEN)
            let open = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: open_word, y: 0)
            let limit = mut fx2.load(PTR, addr: record, offset: CELL_LIMIT)
            let charge = mut fx2.load(PTR, addr: record, offset: CELL_CHARGE)
            let room = mut fx2.b.isub(limit, y: charge)
            let within = mut fx2.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: bytes, y: room)
            let below = mut fx2.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: charge, y: limit)
            let open_within = mut fx2.b.band(open, y: within)
            let ok = mut fx2.b.band(open_within, y: below)
            let still_fits = mut fx2.b.band(fits, y: ok)
            let parent_word = mut fx2.load(clif::Type.Int32, addr: record, offset: CELL_PARENT)
            let parent = mut fx2.b.uextend(PTR, x: parent_word)
            let has_parent = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: parent, y: 0)
            let index = mut fx2.b.iadd_imm_s(parent, y: -1)
            let offset = mut fx2.b.imul_imm_s(index, y: i64.fit(CELL_RECORD))
            let parent_record = mut fx2.b.iadd(cells, y: offset)
            let zero = mut fx2.ptr(0)
            let next = mut fx2.b.select(has_parent, x: parent_record, y: zero)
            return fx2.list2(next, b: still_fits)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let zero = mut fx2.ptr(0)
            return fx2.list2(zero, b: fits)
        })
        let more = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: checked[0], y: 0)
        return Pass(again: more, next: take checked)
    })
    return result[1]
} chain_fits

/// Runs `visit` on every cell record of the chain from a record.
fn walk_chain(mut lo: Lowering, mut fx: Fx, head: clif::Value, visit: fn(mut fx: Fx, record: clif::Value)) {
    let state_address = mut lo.state(mut fx)
    let cells = mut fx.load(PTR, addr: state_address, offset: STATE_CELLS)
    discard mut fx.repeat(fx.list1(head).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 0
        let record = state[0]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
        let next = mut fx1.choose(present, results: fx1.types1(PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            visit(mut fx2, record)
            let parent_word = mut fx2.load(clif::Type.Int32, addr: record, offset: CELL_PARENT)
            let parent = mut fx2.b.uextend(PTR, x: parent_word)
            let has_parent = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: parent, y: 0)
            let index = mut fx2.b.iadd_imm_s(parent, y: -1)
            let offset = mut fx2.b.imul_imm_s(index, y: i64.fit(CELL_RECORD))
            let parent_record = mut fx2.b.iadd(cells, y: offset)
            let zero = mut fx2.ptr(0)
            let following = mut fx2.b.select(has_parent, x: parent_record, y: zero)
            return fx2.list1(following)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let zero = mut fx2.ptr(0)
            return fx2.list1(zero)
        })
        let more = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: next[0], y: 0)
        return Pass(again: more, next: take next)
    })
} walk_chain

/// Subtracts a returned chunk's bytes from every open cell of the chain from a record.
fn uncharge(mut lo: Lowering, mut fx: Fx, head: clif::Value, bytes: clif::Value) {
    walk_chain(mut lo, mut fx, head, visit: fn(mut fx1: Fx, record: clif::Value) {
        let open_word = mut fx1.load(clif::Type.Int32, addr: record, offset: CELL_OPEN)
        let open = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: open_word, y: 0)
        let charge = mut fx1.load(PTR, addr: record, offset: CELL_CHARGE)
        let less = mut fx1.b.isub(charge, y: bytes)
        let kept = mut fx1.b.select(open, x: less, y: charge)
        mut fx1.store(kept, addr: record, offset: CELL_CHARGE)
    })
} uncharge

/// An allocation of `size` bytes aligned to `align` through a cell, in a chunk of a domain;
/// zero on exhaustion. The caller holds the lock.
fn allocate(mut lo: Lowering, mut fx: Fx, handle: clif::Value, size: clif::Value, align: clif::Value, domain: clif::Value) -> clif::Value {
    let large = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThan, x: size, y: i64.fit(MEMORY_CHUNK))
    let allocated = mut fx.choose_in(mut lo, condition: large, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let total = mut fx1.b.iadd_imm_s(size, y: i64.fit(MEMORY_CHUNK) - 1)
        let count = mut fx1.b.ushr_imm_s(total, y: 16)
        let record = new_chunk(mut lo1, fx: mut fx1, handle, count, domain)
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
        return mut fx1.choose(present, results: fx1.types1(PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let one = mut fx2.ptr(1)
            mut fx2.store(one, addr: record, offset: CHUNK_LIVE)
            mut fx2.store(size, addr: record, offset: CHUNK_USED)
            let base = mut fx2.load(PTR, addr: record, offset: CHUNK_BASE)
            return fx2.list1(base)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let exhausted = mut fx2.ptr(0)
            return fx2.list1(exhausted)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let carved = memory_carve(mut lo1, fx: mut fx1, handle, size, align, domain)
        return fx1.list1(carved)
    })
    return allocated[0]
} allocate

/// Draws a run of chunks through a cell for a domain, with its record written, mapped and
/// linked; zero on exhaustion.
fn new_chunk(mut lo: Lowering, mut fx: Fx, handle: clif::Value, count: clif::Value, domain: clif::Value) -> clif::Value {
    let base = memory_draw(mut lo, mut fx, handle, count)
    let drawn = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: base, y: 0)
    let records = mut fx.choose(drawn, results: fx.types1(PTR).view(), then: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let size = mut fx1.ptr(CHUNK_SIZE)
        let record = mut lo.record_alloc(mut fx1, size)
        let missing = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
        mut fx1.if_true(missing, then: fn[mut lo](mut fx2: Fx) {
            raise_kind(mut lo, fx: mut fx2, kind: "trap.exhausted")
        })
        mut fx1.store(handle, addr: record, offset: CHUNK_CELL)
        mut fx1.store(domain, addr: record, offset: CHUNK_DOMAIN)
        mut fx1.store(count, addr: record, offset: CHUNK_COUNT)
        mut fx1.store(base, addr: record, offset: CHUNK_BASE)
        let head = mut fx1.load(PTR, addr: domain, offset: DOMAIN_CHUNKS)
        mut fx1.store(head, addr: record, offset: CHUNK_NEXT)
        let has_head = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
        mut fx1.if_true(has_head, then: fn(mut fx2: Fx) {
            mut fx2.store(record, addr: head, offset: CHUNK_PREVIOUS)
        })
        mut fx1.store(record, addr: domain, offset: DOMAIN_CHUNKS)
        let leaf = map_leaf(mut lo, fx: mut fx1, base)
        mut fx1.store(record, addr: leaf, offset: 0)
        return fx1.list1(record)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let exhausted = mut fx1.ptr(0)
        return fx1.list1(exhausted)
    })
    return records[0]
} new_chunk

/// The address of the chunk map's slot for the chunk at an address, its table made when
/// missing.
fn map_leaf(mut lo: Lowering, mut fx: Fx, base: clif::Value) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    let roots = mut fx.load(PTR, addr: state_address, offset: STATE_CHUNK_MAP)
    let root_index = mut fx.b.ushr_imm_s(base, y: 32)
    let root_offset = mut fx.b.imul_imm_s(root_index, y: 8)
    let root = mut fx.b.iadd(roots, y: root_offset)
    let found = mut fx.load(PTR, addr: root, offset: 0)
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: found, y: 0)
    let tables = mut fx.choose(missing, results: fx.types1(PTR).view(), then: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let size = mut fx1.ptr(MAP_LEAVES * 8)
        let table = mut lo.record_alloc(mut fx1, size)
        let failed = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: table, y: 0)
        mut fx1.if_true(failed, then: fn[mut lo](mut fx2: Fx) {
            raise_kind(mut lo, fx: mut fx2, kind: "trap.exhausted")
        })
        mut fx1.store(table, addr: root, offset: 0)
        return fx1.list1(table)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(found)
    })
    let table = tables[0]
    let leaf_index = mut fx.b.ushr_imm_s(base, y: 16)
    let leaf_masked = mut fx.b.band_imm_s(leaf_index, y: i64.fit(MAP_LEAVES) - 1)
    let leaf = mut fx.b.imul_imm_s(leaf_masked, y: 8)
    return mut fx.b.iadd(table, y: leaf)
} map_leaf

/// The offset in a chunk of the first byte aligned to `align` after its used bytes.
fn carve_start(mut fx: Fx, record: clif::Value, align: clif::Value) -> clif::Value {
    let used = mut fx.load(PTR, addr: record, offset: CHUNK_USED)
    let mask = mut fx.b.iadd_imm_s(align, y: -1)
    let bumped = mut fx.b.iadd(used, y: mask)
    let inverse = mut fx.b.bnot(mask)
    return mut fx.b.band(bumped, y: inverse)
} carve_start

/// Carves a small allocation from the chunk a domain's pool for a cell holds, on a machine
/// target at least `MIN_ALIGN`-aligned, drawing a new chunk when it lacks room.
fn memory_carve(mut lo: Lowering, mut fx: Fx, handle: clif::Value, size: clif::Value, align: clif::Value, domain: clif::Value) -> clif::Value {
    let pool = domain_pool(mut lo, mut fx, domain, handle)
    let current = mut fx.load(PTR, addr: pool, offset: MEMORY_POOL_CHUNK)
    var alignment = align
    if lo.machine() {
        let least = mut fx.ptr(MIN_ALIGN)
        alignment = mut fx.b.umax(align, y: least)
    }
    let has_chunk = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: current, y: 0)
    let fitting = mut fx.choose(has_chunk, results: fx.types1(clif::Type.Int8).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let offset = carve_start(mut fx1, record: current, align: alignment)
        let end = mut fx1.b.iadd(offset, y: size)
        let room = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedLessThanOrEqual, x: end, y: i64.fit(MEMORY_CHUNK))
        return fx1.list1(room)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let no_room = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(no_room)
    })
    let carving = mut fx.choose(fitting[0], results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(current)
    }, otherwise: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let one = mut fx1.ptr(1)
        let drawn_record = new_chunk(mut lo, fx: mut fx1, handle, count: one, domain)
        let drawn = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: drawn_record, y: 0)
        mut fx1.if_true(drawn, then: fn(mut fx2: Fx) {
            mut fx2.store(drawn_record, addr: pool, offset: MEMORY_POOL_CHUNK)
        })
        return fx1.list1(drawn_record)
    })
    let record = carving[0]
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
    let carved = mut fx.choose(present, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let offset = carve_start(mut fx1, record, align: alignment)
        let end = mut fx1.b.iadd(offset, y: size)
        mut fx1.store(end, addr: record, offset: CHUNK_USED)
        let live = mut fx1.load(PTR, addr: record, offset: CHUNK_LIVE)
        let more = mut fx1.b.iadd_imm_s(live, y: 1)
        mut fx1.store(more, addr: record, offset: CHUNK_LIVE)
        let base = mut fx1.load(PTR, addr: record, offset: CHUNK_BASE)
        let address = mut fx1.b.iadd(base, y: offset)
        return fx1.list1(address)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let exhausted = mut fx1.ptr(0)
        return fx1.list1(exhausted)
    })
    return carved[0]
} memory_carve

/// The pool of a domain for a cell handle, added when missing.
fn domain_pool(mut lo: Lowering, mut fx: Fx, domain: clif::Value, handle: clif::Value) -> clif::Value {
    let head = mut fx.load(PTR, addr: domain, offset: DOMAIN_POOLS)
    let searched = mut fx.repeat(fx.list1(head).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 0
        let pool = state[0]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: pool, y: 0)
        let next = mut fx1.choose(present, results: fx1.types2(PTR, b: clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let cell = mut fx2.load(PTR, addr: pool, offset: MEMORY_POOL_CELL)
            let same = mut fx2.b.icmp(clif::IntCC.Equal, x: cell, y: handle)
            let following = mut fx2.load(PTR, addr: pool, offset: MEMORY_POOL_NEXT)
            let kept = mut fx2.b.select(same, x: pool, y: following)
            let again = mut fx2.b.bxor_imm_s(same, y: 1)
            return fx2.list2(kept, b: again)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let zero = mut fx2.ptr(0)
            let stop = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list2(zero, b: stop)
        })
        return Pass(again: next[1], next: fx1.list1(next[0]))
    })
    let found = searched[0]
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: found, y: 0)
    let pools = mut fx.choose(missing, results: fx.types1(PTR).view(), then: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let size = mut fx1.ptr(MEMORY_POOL_SIZE)
        let pool = mut lo.record_alloc(mut fx1, size)
        let failed = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: pool, y: 0)
        mut fx1.if_true(failed, then: fn[mut lo](mut fx2: Fx) {
            raise_kind(mut lo, fx: mut fx2, kind: "trap.exhausted")
        })
        mut fx1.store(handle, addr: pool, offset: MEMORY_POOL_CELL)
        let first_pool = mut fx1.load(PTR, addr: domain, offset: DOMAIN_POOLS)
        mut fx1.store(first_pool, addr: pool, offset: MEMORY_POOL_NEXT)
        mut fx1.store(pool, addr: domain, offset: DOMAIN_POOLS)
        return fx1.list1(pool)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(found)
    })
    return pools[0]
} domain_pool

/// Frees an allocation: its chunk returns once none of its allocations is live. The caller
/// holds the lock.
fn memory_release(mut lo: Lowering, mut fx: Fx, address: clif::Value) {
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: address, y: 0)
    mut fx.if_true(present, then: fn[mut lo](mut fx1: Fx) {
        let base = mut fx1.b.band_imm_s(address, y: ~(i64.fit(MEMORY_CHUNK) - 1))
        let leaf = map_leaf(mut lo, fx: mut fx1, base)
        let record = mut fx1.load(PTR, addr: leaf, offset: 0)
        let live = mut fx1.load(PTR, addr: record, offset: CHUNK_LIVE)
        let fewer = mut fx1.b.iadd_imm_s(live, y: -1)
        mut fx1.store(fewer, addr: record, offset: CHUNK_LIVE)
        let empty = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: fewer, y: 0)
        mut fx1.if_true(empty, then: fn[mut lo](mut fx2: Fx) {
            return_chunk(mut lo, fx: mut fx2, record)
        })
    })
} memory_release

/// Returns a run of chunks by its record: takes it out of its domain, uncharges its chain,
/// returns it to its chain's supply and drops its record. The caller holds the lock.
fn return_chunk(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    detach(mut fx, record)
    let handle = mut fx.load(PTR, addr: record, offset: CHUNK_CELL)
    let cell = memory_cell_record(mut lo, mut fx, handle)
    let count = mut fx.load(PTR, addr: record, offset: CHUNK_COUNT)
    let bytes = mut fx.b.imul_imm_s(count, y: i64.fit(MEMORY_CHUNK))
    uncharge(mut lo, mut fx, head: cell, bytes)
    let base = mut fx.load(PTR, addr: record, offset: CHUNK_BASE)
    let leaf = map_leaf(mut lo, mut fx, base)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: leaf, offset: 0)
    let region = mut fx.load(PTR, addr: cell, offset: CELL_SUPPLY)
    let platform = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: region, y: 0)
    discard mut fx.choose_in(mut lo, condition: platform, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let used = mut fx1.load(PTR, addr: record, offset: CHUNK_USED)
        give_platform_chunks(mut lo1, fx: mut fx1, base, count, used)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let supply = region_supply(mut fx1, record: region)
        give_chunks(mut fx1, supply, base, count)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    mut lo.record_free(mut fx, address: record)
} return_chunk

/// Draws `count` zeroed chunks from the platform: a kept single chunk when one is wanted and
/// kept, otherwise newly mapped ones; zero when the system refuses. The caller holds the lock.
fn platform_chunks(mut lo: Lowering, mut fx: Fx, count: clif::Value) -> clif::Value {
    let state = mut lo.state(mut fx)
    let kept = mut fx.load(PTR, addr: state, offset: STATE_KEPT_CHUNKS)
    let single = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: count, y: 1)
    let held = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: kept, y: 0)
    let reuse = mut fx.b.band(single, y: held)
    let drawn = mut fx.choose_in(mut lo, condition: reuse, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let next = mut fx1.load(PTR, addr: kept, offset: 0)
        mut fx1.store(next, addr: state, offset: STATE_KEPT_CHUNKS)
        let left = mut fx1.load(PTR, addr: state, offset: STATE_KEPT_COUNT)
        let fewer = mut fx1.b.iadd_imm_s(left, y: -1)
        mut fx1.store(fewer, addr: state, offset: STATE_KEPT_COUNT)
        let zero = mut fx1.ptr(0)
        mut fx1.store(zero, addr: kept, offset: 0)
        return fx1.list1(kept)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let mapped = system_map_chunks(mut lo1, fx: mut fx1, count)
        return fx1.list1(mapped)
    })
    return drawn[0]
} platform_chunks

/// Returns `count` chunks from `base`, of which the first `used` bytes were written, to the
/// platform: a single chunk is zeroed and kept for the next draws while fewer than
/// `MEMORY_KEPT` are, any other run unmapped. The caller holds the lock.
fn give_platform_chunks(mut lo: Lowering, mut fx: Fx, base: clif::Value, count: clif::Value, used: clif::Value) {
    let state = mut lo.state(mut fx)
    let kept = mut fx.load(PTR, addr: state, offset: STATE_KEPT_COUNT)
    let single = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: count, y: 1)
    let room = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: kept, y: i64.fit(MEMORY_KEPT))
    let keep = mut fx.b.band(single, y: room)
    discard mut fx.choose_in(mut lo, condition: keep, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.ptr(0)
        discard mut lo1.call_routine(mut fx1, routine: Routine.Fill, args: fx1.list3(base, b: zero, c: used).view())
        let head = mut fx1.load(PTR, addr: state, offset: STATE_KEPT_CHUNKS)
        mut fx1.store(head, addr: base, offset: 0)
        mut fx1.store(base, addr: state, offset: STATE_KEPT_CHUNKS)
        let more = mut fx1.b.iadd_imm_s(kept, y: 1)
        mut fx1.store(more, addr: state, offset: STATE_KEPT_COUNT)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        system_unmap_chunks(mut lo1, fx: mut fx1, base, count)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} give_platform_chunks

/// Takes a run of chunks out of its domain's list and out of the pool carving it.
fn detach(mut fx: Fx, record: clif::Value) {
    let domain = mut fx.load(PTR, addr: record, offset: CHUNK_DOMAIN)
    let next = mut fx.load(PTR, addr: record, offset: CHUNK_NEXT)
    let previous = mut fx.load(PTR, addr: record, offset: CHUNK_PREVIOUS)
    let has_previous = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: previous, y: 0)
    discard mut fx.choose(has_previous, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(next, addr: previous, offset: CHUNK_NEXT)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(next, addr: domain, offset: DOMAIN_CHUNKS)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    let has_next = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: next, y: 0)
    mut fx.if_true(has_next, then: fn(mut fx1: Fx) {
        mut fx1.store(previous, addr: next, offset: CHUNK_PREVIOUS)
    })
    let head = mut fx.load(PTR, addr: domain, offset: DOMAIN_POOLS)
    discard mut fx.repeat(fx.list1(head).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 0
        let pool = state[0]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: pool, y: 0)
        let following = mut fx1.choose(present, results: fx1.types1(PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let held = mut fx2.load(PTR, addr: pool, offset: MEMORY_POOL_CHUNK)
            let same = mut fx2.b.icmp(clif::IntCC.Equal, x: held, y: record)
            mut fx2.if_true(same, then: fn(mut fx3: Fx) {
                let zero = mut fx3.ptr(0)
                mut fx3.store(zero, addr: pool, offset: MEMORY_POOL_CHUNK)
            })
            let next_pool = mut fx2.load(PTR, addr: pool, offset: MEMORY_POOL_NEXT)
            return fx2.list1(next_pool)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let zero = mut fx2.ptr(0)
            return fx2.list1(zero)
        })
        let more = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: following[0], y: 0)
        return Pass(again: more, next: take following)
    })
} detach

/// The record of the run of chunks an allocation lies at the start of, zero for an address no
/// chunk holds.
fn chunk_of(mut lo: Lowering, mut fx: Fx, address: clif::Value) -> clif::Value {
    let root = mut fx.b.ushr_imm_s(address, y: 32)
    let mapped = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: root, y: i64.fit(MAP_ROOTS))
    let records = mut fx.choose_in(mut lo, condition: mapped, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let state_address = mut lo1.state(mut fx1)
        let roots = mut fx1.load(PTR, addr: state_address, offset: STATE_CHUNK_MAP)
        let slot_offset = mut fx1.b.imul_imm_s(root, y: 8)
        let slot = mut fx1.b.iadd(roots, y: slot_offset)
        let table = mut fx1.load(PTR, addr: slot, offset: 0)
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: table, y: 0)
        return mut fx1.choose(present, results: fx1.types1(PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let leaf_index = mut fx2.b.ushr_imm_s(address, y: 16)
            let leaf_masked = mut fx2.b.band_imm_s(leaf_index, y: i64.fit(MAP_LEAVES) - 1)
            let leaf_offset = mut fx2.b.imul_imm_s(leaf_masked, y: 8)
            let leaf = mut fx2.b.iadd(table, y: leaf_offset)
            let record = mut fx2.load(PTR, addr: leaf, offset: 0)
            return fx2.list1(record)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let unmapped = mut fx2.ptr(0)
            return fx2.list1(unmapped)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let unmapped = mut fx1.ptr(0)
        return fx1.list1(unmapped)
    })
    return records[0]
} chunk_of

/// `Lift(address, domain) -> lifted`: passes the run of chunks an allocation lies in to a
/// domain when a domain nested in it owns the run; nonzero when it passed.
fn memory_lift(mut lo: Lowering, mut fx: Fx, address: clif::Value, to: clif::Value) -> clif::Value {
    let record = chunk_of(mut lo, mut fx, address)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
    let lifted = mut fx.choose(present, results: fx.types1(clif::Type.Int8).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let owner = mut fx1.load(PTR, addr: record, offset: CHUNK_DOMAIN)
        let inside = nested_in(mut fx1, inner: owner, outer: to)
        mut fx1.if_true(inside, then: fn(mut fx2: Fx) {
            detach(mut fx2, record)
            mut fx2.store(to, addr: record, offset: CHUNK_DOMAIN)
            let zero = mut fx2.ptr(0)
            mut fx2.store(zero, addr: record, offset: CHUNK_PREVIOUS)
            let head = mut fx2.load(PTR, addr: to, offset: DOMAIN_CHUNKS)
            mut fx2.store(head, addr: record, offset: CHUNK_NEXT)
            let has_head = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
            mut fx2.if_true(has_head, then: fn(mut fx3: Fx) {
                mut fx3.store(record, addr: head, offset: CHUNK_PREVIOUS)
            })
            mut fx2.store(record, addr: to, offset: DOMAIN_CHUNKS)
        })
        return fx1.list1(inside)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let unlifted = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(unlifted)
    })
    return lifted[0]
} memory_lift

/// Frees every run of chunks a domain owns, and its pools.
fn free_chunks(mut lo: Lowering, mut fx: Fx, domain: clif::Value) {
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        let head = mut fx1.load(PTR, addr: domain, offset: DOMAIN_CHUNKS)
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
        mut fx1.if_true(present, then: fn[mut lo](mut fx2: Fx) {
            return_chunk(mut lo, fx: mut fx2, record: head)
        })
        return Pass(again: present, next: mem::List[clif::Value].empty(fx1.alloc))
    })
    let pools = mut fx.load(PTR, addr: domain, offset: DOMAIN_POOLS)
    discard mut fx.repeat(fx.list1(pools).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 0
        let pool = state[0]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: pool, y: 0)
        let next = mut fx1.choose_in(mut lo, condition: present, results: fx1.types1(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let following = mut fx2.load(PTR, addr: pool, offset: MEMORY_POOL_NEXT)
            mut lo2.record_free(mut fx2, address: pool)
            return fx2.list1(following)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let zero = mut fx2.ptr(0)
            return fx2.list1(zero)
        })
        return Pass(again: present, next: take next)
    })
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
} free_chunks
