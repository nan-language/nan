    defer take minter.close()
    let runner = try Runner.served(minter.mint(0))
    let lent = try await runner.resource(1)
    let away = attempt await runner.resource(1)
    try await runner.put_resource(1, resource: take lent)
    let back = try await runner.resource(1)
    try await runner.put_resource(1, resource: take back)
    let released = reach(shelved, body: tally_count)
    expect away.is_err() and released == Some(0)
} runner_lent_resources_leave_their_kind_until_put

