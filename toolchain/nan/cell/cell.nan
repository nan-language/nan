//! State changed through read access: a value replaced and later restored, every value it held kept.

/// A value replaced and restored through read access. Each value it held stays stored; the current
/// one is selected by its index, so views of earlier values stay valid.
pkg struct Swap[T: Send] {
    values: mem::Arena[T]
    current: core::atomic::AtomicU32
} Swap

pkg fn Swap.of(take value: T, alloc: mem::Alloc) -> Swap[T] {
    let values = mem::Arena[T].empty(alloc)
    let initial = values.push(take value)
    return Swap(values: take values, current: core::atomic::AtomicU32.of(initial.index()))
} Swap.of

/// The current value.
pkg proj fn Swap.get(self) -> T {
    return self.values.at(mem::Id[T].of(self.current.load()))
} Swap.get

/// Makes `value` current, giving the token that makes the value it replaces current again.
pkg fn Swap.replace(self, take value: T) -> u32 {
    let id = self.values.push(take value)
    return self.current.swap(id.index())
} Swap.replace

/// Makes current again the value a replacement gave the token of.
pkg fn Swap.restore(self, token: u32) {
    self.current.store(token)
} Swap.restore

test replaced_values_restore_in_order for Swap.restore {
    let alloc = testing::world().alloc
    let held = Swap.of(1u32, alloc)
    let outer = held.replace(2)
    let inner = held.replace(3)
    let newest = held.get()
    held.restore(inner)
    let restored = held.get()
    held.restore(outer)
    let original = held.get()
    expect newest == 3 and restored == 2 and original == 1
} replaced_values_restore_in_order

/// A set filled through read access, telling which of the tasks adding one key at once added it.
pkg struct Claims[K: Eq and Hash and Send] {
    held: mem::OnceMap[K, u32]
    tickets: core::atomic::AtomicU32
} Claims

pkg fn Claims.empty(alloc: mem::Alloc) -> Claims[K] {
    return Claims(held: mem::OnceMap[K, u32].empty(seed: 0, alloc), tickets: core::atomic::AtomicU32.of(0))
} Claims.empty

/// Adds a key, giving whether this call added it.
pkg fn Claims.claim(self, take key: K) -> bool {
    let Some(ticket) = self.tickets.fetch_add(1) else {
        expect false
        return false
    }
    return self.held.insert(take key, value: ticket) == ticket
} Claims.claim

pkg fn Claims.contains(self, key: K) -> bool {
    return self.held.get(key).is_some()
} Claims.contains

test the_first_claim_of_a_key_adds_it for Claims.claim {
    let alloc = testing::world().alloc
    let claims = Claims[u32].empty(alloc)
    let added = claims.claim(7)
    let again = claims.claim(7)
    let other = claims.claim(8)
    let held = claims.contains(7)
    expect added and not again and other and held
} the_first_claim_of_a_key_adds_it
