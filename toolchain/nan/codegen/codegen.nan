//! The code generator: instruction selection, register allocation and emission of x86-64 machine code for the functions lowering builds.

/// The start of a run of code with one source location.
pkg struct Located derives Copy, Eq {
    pkg offset: u32
    pkg loc: clif::SourceLoc
} Located

/// What code generation takes from the target: whether code is position-independent, reaching
/// the symbols other objects define through the global offset table and calling them through
/// the procedure linkage table; whether a frame reaching the guard page size probes the pages it
/// spans; and whether code may use the SSE registers, which then hold float values.
pkg struct Isa derives Copy, Eq {
    pkg pic: bool
    pkg probes: bool
    pkg floats: bool
} Isa

pkg fn Isa.of(target: workspace::Target) -> Isa {
    if target.is_machine() {
        return Isa(pic: false, probes: false, floats: false)
    }
    return Isa(pic: true, probes: true, floats: true)
} Isa.of

/// A compiled function: its machine code, the alignment its start needs, the relocations of the
/// code, its frame size from the return address down, the code offset at which each run of code
/// with one source location other than the default starts, in offset order, and whether its
/// calls can be left out when nothing reads their results.
pkg struct Code {
    pkg bytes: mem::Bytes
    pkg align: u32
    pkg relocs: mem::List[x64::Reloc]
    pkg frame: u64
    pkg locations: mem::List[Located]
    pkg removable: bool
} Code

/// Compiles a function built by lowering into x86-64 machine code, its calls of the functions
/// whose bodies `leaves` holds taking those bodies in place, its calls of the functions whose
/// calls can be left out left out when nothing reads their results, its stack slots held in
/// values where they can be and its edges threaded.
pkg fn compile(func: clif::Function, isa: Isa, leaves: Leaves, alloc: mem::Alloc) -> Code {
    return match promoted(func, leaves, alloc) {
        Some(simpler) => match threaded(simpler, alloc) {
            Some(threads) => code_of(threads, isa, leaves, alloc)
            None => code_of(simpler, isa, leaves, alloc)
        }
        None => match threaded(func, alloc) {
            Some(threads) => code_of(threads, isa, leaves, alloc)
            None => code_of(func, isa, leaves, alloc)
        }
    }
} compile

fn code_of(func: clif::Function, isa: Isa, leaves: Leaves, alloc: mem::Alloc) -> Code {
    var vcode = select(func, isa, alloc)
    mut vcode.remove_dead(alloc)
    let allocation = allocate(vcode, alloc)
    var code = emit(vcode, allocation, isa, alloc)
    code.removable = is_left_out_callee(func, leaves, alloc)
    return code
} code_of
