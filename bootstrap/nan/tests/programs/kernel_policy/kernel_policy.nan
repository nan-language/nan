//! Runs every task bound to CPU 0 in 1 ms slices keyed by deadline or weighted time but those of class 3, which CPU 0 steals from CPU 1 by halves while CPU 1 steals from CPU 0 before, idling in `mwait`, waking from a sleep, ordering tasks by deadline, sharing the CPU by weight, passing a serial executor's turn by seed and running tasks of class 1 in slices of 1 ns, which end before they run.

registers Uart {
    data: u8 at 0x0 write
} Uart

/// The iterations each spinning task of the serial run counts, more than a slice takes.
const SPINS: u64 = 4_000_000

/// The nanoseconds the weighted accounts share the CPU.
const SHARING_NS: u64 = 300_000_000

/// The nanoseconds each task of the steal run spins.
const STEAL_SPIN_NS: u64 = 20_000_000

/// What the policy records of the steal run: whether it is armed and CPU 0 has stolen, up to three
/// tasks of class 3 that ran on CPU 0, and the switches of other tasks onto another CPU.
struct Probe {
    armed: core::atomic::AtomicBool
    stole: core::atomic::AtomicBool
    seen: mem::List[core::atomic::AtomicU64]
    strays: core::atomic::AtomicU64
} Probe

struct Paced {
    probe: mem::Shared[Probe]
} Paced

impl Paced: hw::Policy

fn Paced.place(self, t: hw::IrqsDisabled, task: hw::TaskView) -> hw::Placement limits notrap, terminates, noalloc, stack 4_096 {
    let key = match task.deadline_ns {
        Some(deadline) => deadline
        None => task.ran_ns / u64.widen(task.share.weight)
    }
    if task.share.class == 3 {
        return hw::Placement(cpu: 1, key: key, bound: false)
    }
    return hw::Placement(cpu: 0, key: key, bound: true)
} Paced.place

fn Paced.steal(self, t: hw::IrqsDisabled, cpu: u32, round: u32) -> Option[hw::Steal] limits notrap, terminates, noalloc, stack 4_096 {
    let probe = self.probe.contents()
    if not probe.armed.load() {
        if cpu == 1 {
            return Some(hw::Steal(cpu: 0, tasks: 4_294_967_295))
        }
        return None
    }
    if cpu != 0 or probe.stole.swap(true) {
        return None
    }
    return Some(hw::Steal(cpu: 1, tasks: 4_294_967_295))
} Paced.steal

fn Paced.slice(self, t: hw::IrqsDisabled, cpu: u32, task: hw::TaskView) -> u64 limits notrap, terminates, noalloc, stack 4_096 {
    let probe = self.probe.contents()
    if task.share.class != 3 and cpu != 0 {
        discard probe.strays.fetch_add(1)
    }
    if task.share.class == 3 and cpu == 0 {
        note_seen(probe, id: task.task)
    }
    if task.share.class == 1 {
        return 1
    }
    return 1_000_000
} Paced.slice

fn Paced.idle(self, t: hw::IrqsDisabled, cpu: u32, until_ns: Option[u64]) -> hw::Idle limits notrap, terminates, noalloc, stack 4_096 {
    return hw::Idle.Mwait(0)
} Paced.idle

/// Records a task id among those seen, unless seen or three are.
fn note_seen(probe: Probe, id: u64) limits notrap, terminates, noalloc {
    for slot in probe.seen {
        match slot.compare_swap(expected: 0, replacement: id) {
            Ok(_) => return
            Err(held) => {
                if held == id {
                    return
                }
            }
        }
    }
} note_seen

fn say(text: Str) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in text.as_bytes() {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say

/// Writes a digit after a space.
fn say_digit(value: u64) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    mut uart.write(Uart.data, value: 32)
    mut uart.write(Uart.data, value: 48 + u8.truncate(value % 10))
    take uart.unmap()
} say_digit

/// Counts to `SPINS` without awaiting, then records `id` at the next place of `order`.
fn spin_then_record(id: u64, order: mem::List[core::atomic::AtomicU64], done: core::atomic::AtomicU64) {
    var count: u64 = 0
    while count < SPINS {
        count = count.wrapping_add(1)
    }
    let Some(place) = done.fetch_add(1) else {
        return
    }
    discard order[usize.widen(place)].swap(id)
} spin_then_record

/// Writes a line of a name and the ids `order` holds.
fn say_order(name: Str, order: mem::List[core::atomic::AtomicU64]) {
    say(text: name)
    for slot in order {
        say_digit(value: slot.load())
    }
    say(text: "\n")
} say_order

/// A list of `count` zeroed atomic words.
fn slots(count: u64, alloc: mem::Alloc) -> mem::List[core::atomic::AtomicU64] {
    var made = mem::List[core::atomic::AtomicU64].empty(alloc)
    for _ in 0..<count {
        mut made.push(core::atomic::AtomicU64.of(0))
    }
    return made
} slots

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    let clock = k.clock()
    let probe = mem::Shared.of(Probe(armed: core::atomic::AtomicBool.of(false), stole: core::atomic::AtomicBool.of(false), seen: slots(count: 3, alloc), strays: core::atomic::AtomicU64.of(0)), alloc)
    mut k.policy(Paced(probe: probe.share()))
    take k.anchor(0u8, run: fn[take probe](exec: task::Executor) fails task::Cancelled uses wait limits stack 65_536 {
        try await clock.sleep_ns(1_000_000)
        say(text: "slept\n")
        let edf = slots(count: 3, alloc)
        let edf_done = core::atomic::AtomicU64.of(0)
        try await task::scope(exec, body: fn(s: task::Scope) {
            for at in 0..<3u64 {
                let id = (at + 2) % 3 + 1
                discard s.spawn(fn() fails task::Cancelled uses wait limits stack 8_192 {
                    discard try await task::within_ns(clock, ns: id * 60_000_000_000, body: fn() limits stack 4_096 {
                        spin_for_then_record(clock, id, order: edf, done: edf_done)
                    })
                })
            }
        })
        say_order(name: "edf", order: edf)
        let heavy = exec.split(task::Share(weight: 3, class: 0, reserve_ppm: 0))
        defer take heavy.close()
        let light = exec.split(task::Share(weight: 1, class: 0, reserve_ppm: 0))
        defer take light.close()
        let stop = core::atomic::AtomicBool.of(false)
        var shared = false
        try await task::scope(exec, body: fn[mut shared](s: task::Scope) fails task::Cancelled uses wait {
            for account in 0..<2u32 {
                let spinner = match account {
                    0 => heavy.executor()
                    else => light.executor()
                }
                discard s.spawn(fn() fails task::Cancelled uses wait limits stack 8_192 {
                    try await task::scope(spinner, body: fn(inner: task::Scope) {
                        discard inner.spawn(fn() limits stack 4_096 {
                            while not stop.load() {
                            }
                        })
                    })
                })
            }
            try await clock.sleep_ns(SHARING_NS)
            let heavy_ns = heavy.used_ns()
            let light_ns = light.used_ns()
            shared = light_ns > 0 and heavy_ns >= 2 * light_ns and heavy_ns <= 4 * light_ns
            discard stop.swap(true)
        })
        if shared {
            say(text: "shares 3:1\n")
        }
        let serial = exec.serial(42)
        defer take serial.close()
        let turns = slots(count: 4, alloc)
        let turns_done = core::atomic::AtomicU64.of(0)
        let turned = serial.executor()
        try await task::scope(turned, body: fn(outer: task::Scope) {
            discard outer.spawn(fn() fails task::Cancelled uses wait limits stack 8_192 {
                try await task::scope(turned, body: fn(s: task::Scope) {
                    for id in 0..<4u64 {
                        discard s.spawn(fn() limits stack 4_096 {
                            spin_then_record(id, order: turns, done: turns_done)
                        })
                    }
                })
            })
        })
        say_order(name: "serial", order: turns)
        let brief = exec.split(task::Share(weight: 1, class: 1, reserve_ppm: 0))
        defer take brief.close()
        let brief_done = core::atomic::AtomicU64.of(0)
        try await task::scope(brief.executor(), body: fn(s: task::Scope) {
            for _ in 0..<2u64 {
                discard s.spawn(fn() limits stack 4_096 {
                    discard brief_done.fetch_add(1)
                })
            }
        })
        say(text: "brief")
        say_digit(value: brief_done.load())
        say(text: "\n")
        try await steal_run(exec, clock, probe: probe.contents())
    })
} main

/// Spins for `EDF_SPIN_NS` of the clock without awaiting, longer than any slice lasts before its
/// task is preempted, then records `id` at the next place of `order`.
fn spin_for_then_record(clock: sys::Clock, id: u64, order: mem::List[core::atomic::AtomicU64], done: core::atomic::AtomicU64) {
    spin_for(clock, ns: EDF_SPIN_NS)
    let Some(place) = done.fetch_add(1) else {
        return
    }
    discard order[usize.widen(place)].swap(id)
} spin_for_then_record

/// The nanoseconds each deadline task spins.
const EDF_SPIN_NS: u64 = 100_000_000

/// Spins for `ns` nanoseconds of the clock without awaiting.
fn spin_for(clock: sys::Clock, ns: u64) {
    let Ok(start) = attempt clock.elapsed_ns() else {
        return
    }
    loop {
        let Ok(now) = attempt clock.elapsed_ns() else {
            return
        }
        if now - start >= ns {
            break
        }
    }
} spin_for

/// Runs four tasks of class 3 spinning on CPU 1, from which CPU 0 steals once, then writes how
/// many of them ran on CPU 0 and whether every other task stayed bound to it.
fn steal_run(exec: task::Executor, clock: sys::Clock, probe: Probe) fails task::Cancelled uses wait {
    let spread = exec.split(task::Share(weight: 1, class: 3, reserve_ppm: 0))
    defer take spread.close()
    discard probe.armed.swap(true)
    try await task::scope(spread.executor(), body: fn(s: task::Scope) {
        for _ in 0..<4u64 {
            discard s.spawn(fn() limits stack 4_096 {
                spin_for(clock, ns: STEAL_SPIN_NS)
            })
        }
    })
    var stolen: u64 = 0
    for slot in probe.seen {
        if slot.load() != 0 {
            stolen += 1
        }
    }
    say(text: "stolen")
    say_digit(value: stolen)
    say(text: "\n")
    if probe.strays.load() == 0 {
        say(text: "bound kept\n")
    }
} steal_run
