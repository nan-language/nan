test hash_map_insert_replaces_the_value for HashMap.insert {
    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    let added = mut levels.insert(1, value: 10)
    let replaced = mut levels.insert(1, value: 11)
    expect added == None
    expect replaced == Some(10)
    expect levels[1] == 11
} hash_map_insert_replaces_the_value

test hash_map_try_insert_adds_the_entry for HashMap.try_insert {
    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    let added = try mut levels.try_insert(1, value: 10)
    expect added == None
    expect levels.contains(1)
} hash_map_try_insert_adds_the_entry

test reinserted_keys_come_last for HashMap.remove {
    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    discard mut levels.insert(1, value: 10)
    discard mut levels.insert(2, value: 20)
    let removed = mut levels.remove(1)
    discard mut levels.insert(1, value: 11)
    var keys: u32 = 0
    for entry in levels {
        keys = keys * 10 + u32.widen(entry.key())
    }
    expect removed == Some(10)
    expect keys == 21
} reinserted_keys_come_last

test hash_map_get_finds_present_keys for HashMap.get {
    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    discard mut levels.insert(1, value: 10)
    expect levels.get(1) == Some(10)
    expect levels.get(2) == None
} hash_map_get_finds_present_keys

test hash_map_get_mut_reaches_the_value for HashMap.get_mut {
    let world = testing::world()
    var buffers = HashMap[u8, Bytes].empty(7, alloc: world.alloc)
    discard mut buffers.insert(1, value: Bytes.empty(world.alloc))
    match mut buffers.get_mut(1) {
        Some(found) => {
            var buffer = found
            mut buffer.push(9)
        }
        None => {
        }
    }
    expect buffers[1].len() == 1
} hash_map_get_mut_reaches_the_value

test hash_map_at_projects_the_value for HashMap.at {
    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    discard mut levels.insert(1, value: 10)
    expect levels.at(1) == 10
} hash_map_at_projects_the_value

test hash_map_at_mut_projects_the_value for HashMap.at_mut {
    let world = testing::world()
    var buffers = HashMap[u8, Bytes].empty(7, alloc: world.alloc)
    discard mut buffers.insert(1, value: Bytes.empty(world.alloc))
    var buffer = mut buffers.at_mut(1)
    mut buffer.push(9)
    expect buffers[1].len() == 1
} hash_map_at_mut_projects_the_value

test hash_map_cursor_yields_in_insertion_order for HashMap.cursor {
    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    discard mut levels.insert(2, value: 20)
    discard mut levels.insert(1, value: 10)
    var keys: u32 = 0
    for entry in levels {
        keys = keys * 10 + u32.widen(entry.key())
    }
    expect keys == 21
} hash_map_cursor_yields_in_insertion_order

test hash_map_cursor_mut_writes_values for HashMap.cursor_mut {
    let world = testing::world()
    var buffers = HashMap[u8, Bytes].empty(7, alloc: world.alloc)
    discard mut buffers.insert(1, value: Bytes.empty(world.alloc))
    for entry in mut buffers {
        var buffer = mut entry.value_mut()
        mut buffer.push(9)
    }
    expect buffers[1].len() == 1
} hash_map_cursor_mut_writes_values

test hash_map_into_cursor_yields_in_insertion_order for HashMap.into_cursor {
    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    discard mut levels.insert(2, value: 20)
    discard mut levels.insert(1, value: 10)
    var values: u32 = 0
    for pair in take levels {
        values = values * 100 + u32.widen(pair.value)
    }
    expect values == 2_010
} hash_map_into_cursor_yields_in_insertion_order

test hash_map_retain_keeps_accepted_entries for HashMap.retain {
    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    discard mut levels.insert(1, value: 10)
    discard mut levels.insert(2, value: 20)
    mut levels.retain(keep: fn(key: u8, value: u8) => key > 1 and value > 15)
    expect levels.len() == 1
    expect levels.contains(2)
} hash_map_retain_keeps_accepted_entries

test set_len_counts_values for Set.len {
    var seen = Set[u8].empty(testing::world().alloc)
    discard mut seen.insert(1)
    discard mut seen.insert(1)
    expect seen.len() == 1
} set_len_counts_values

test set_insert_reports_present_values for Set.insert {
    var seen = Set[u8].empty(testing::world().alloc)
    let added = mut seen.insert(1)
    let again = mut seen.insert(1)
    expect added
    expect not again
} set_insert_reports_present_values

test set_remove_reports_removed_values for Set.remove {
    var seen = Set[u8].empty(testing::world().alloc)
    discard mut seen.insert(1)
    let removed = mut seen.remove(1)
    expect removed
    expect not seen.contains(1)
} set_remove_reports_removed_values

test set_cursor_yields_ascending_values for Set.cursor {
    var seen = Set[u8].empty(testing::world().alloc)
    discard mut seen.insert(2)
    discard mut seen.insert(1)
    var digits: u32 = 0
    for value in seen {
        digits = digits * 10 + u32.widen(value)
    }
    expect digits == 12
} set_cursor_yields_ascending_values

test set_into_cursor_yields_ascending_values for Set.into_cursor {
    var seen = Set[u8].empty(testing::world().alloc)
    discard mut seen.insert(2)
    discard mut seen.insert(1)
    var digits: u32 = 0
    for value in take seen {
        digits = digits * 10 + u32.widen(value)
    }
    expect digits == 12
} set_into_cursor_yields_ascending_values

test set_retain_keeps_accepted_values for Set.retain {
    var seen = Set[u8].empty(testing::world().alloc)
    discard mut seen.insert(1)
    discard mut seen.insert(5)
    mut seen.retain(keep: fn(value: u8) => value > 3)
    expect seen.len() == 1
    expect seen.contains(5)
} set_retain_keeps_accepted_values

test contains_by_finds_the_matching_value for Set.contains_by {
    var seen = Set[u8].empty(testing::world().alloc)
    discard mut seen.insert(1)
    discard mut seen.insert(5)
    let found = seen.contains_by(fn(value: u8) => value.cmp(5))
    expect found
} contains_by_finds_the_matching_value

test bounded_len_counts_elements for Bounded.len {
    var codes = Bounded[u16, 2].empty()
    mut codes.push(404)
    expect codes.len() == 1
} bounded_len_counts_elements

test is_full_at_the_bound for Bounded.is_full {
    var codes = Bounded[u16, 1].empty()
    expect not codes.is_full()
    mut codes.push(404)
    expect codes.is_full()
} is_full_at_the_bound

test bounded_push_appends for Bounded.push {
    var codes = Bounded[u16, 2].empty()
    mut codes.push(404)
    mut codes.push(500)
    expect codes[1] == 500
} bounded_push_appends

test bounded_try_push_fails_when_full for Bounded.try_push {
    var codes = Bounded[u16, 1].empty()
    try mut codes.try_push(404)
    let refused = attempt mut codes.try_push(500)
    expect refused.is_err()
    expect codes[0] == 404
} bounded_try_push_fails_when_full

test bounded_pop_removes_the_last_element for Bounded.pop {
    var codes = Bounded[u16, 2].empty()
    mut codes.push(404)
    let last = mut codes.pop()
    expect last == Some(404)
    expect codes.len() == 0
} bounded_pop_removes_the_last_element

test bounded_at_reaches_elements for Bounded.at {
    var codes = Bounded[u16, 2].empty()
    mut codes.push(404)
    expect codes.at(0) == 404
} bounded_at_reaches_elements

test bounded_at_mut_writes_elements for Bounded.at_mut {
    let world = testing::world()
    var buffers = Bounded[Bytes, 1].empty()
    mut buffers.push(Bytes.empty(world.alloc))
    var buffer = mut buffers.at_mut(0)
    mut buffer.push(9)
    expect buffers[0].len() == 1
} bounded_at_mut_writes_elements

test bounded_cursor_yields_in_index_order for Bounded.cursor {
    var codes = Bounded[u16, 2].empty()
    mut codes.push(1)
    mut codes.push(2)
    var digits: u32 = 0
    for code in codes {
        digits = digits * 10 + u32.widen(code)
    }
    expect digits == 12
} bounded_cursor_yields_in_index_order

test bounded_cursor_mut_writes_elements for Bounded.cursor_mut {
    var codes = Bounded[u16, 2].empty()
    mut codes.push(1)
    for code in mut codes {
        code = 7
    }
    expect codes[0] == 7
} bounded_cursor_mut_writes_elements

test bounded_into_cursor_owns_elements for Bounded.into_cursor {
    var codes = Bounded[u16, 2].empty()
    mut codes.push(1)
    mut codes.push(2)
    var digits: u32 = 0
    for code in take codes {
        digits = digits * 10 + u32.widen(code)
    }
    expect digits == 12
} bounded_into_cursor_owns_elements

test once_map_len_counts_entries for OnceMap.len {
    let cache = OnceMap[u8, u64].empty(7, alloc: testing::world().alloc)
    discard cache.insert(1, value: 10)
    discard cache.insert(1, value: 20)
    let count = cache.len()
    expect count == 1
} once_map_len_counts_entries

test once_map_insert_keeps_the_first_value for OnceMap.insert {
    let cache = OnceMap[u8, u64].empty(7, alloc: testing::world().alloc)
    discard cache.insert(1, value: 10)
    let stored = cache.insert(1, value: 20)
    expect stored == 10
} once_map_insert_keeps_the_first_value

test arena_cursor_next_ends_with_none for ArenaCursor.next {
    let numbers = Arena[u8].empty(testing::world().alloc)
    discard numbers.push(4)
    var cursor = numbers.cursor()
    let earlier = mut cursor.next()
    let later = mut cursor.next()
    expect earlier == Some(4)
    expect later == None
} arena_cursor_next_ends_with_none

test pool_cursor_next_skips_freed_slots for PoolCursor.next {
    var numbers = Pool[u8, Unit].empty(testing::world().alloc)
    let freed = mut numbers.insert(4)
    discard mut numbers.insert(5)
    discard mut numbers.remove(freed)
    var cursor = numbers.cursor()
    let earlier = mut cursor.next()
    let later = mut cursor.next()
    expect earlier == Some(5)
    expect later == None
} pool_cursor_next_skips_freed_slots

test list_cursor_next_ends_with_none for ListCursor.next {
    var values = List[u8].empty(testing::world().alloc)
    mut values.push(4)
    var cursor = take values.into_cursor()
    let earlier = mut cursor.next()
    let later = mut cursor.next()
    expect earlier == Some(4)
    expect later == None
} list_cursor_next_ends_with_none

test bounded_cursor_next_ends_with_none for BoundedCursor.next {
    var codes = Bounded[u16, 1].empty()
    mut codes.push(404)
    var cursor = codes.into_cursor()
    let earlier = mut cursor.next()
    let later = mut cursor.next()
    expect earlier == Some(404)
    expect later == None
} bounded_cursor_next_ends_with_none

test map_cursor_next_ends_with_none for MapCursor.next {
    var levels = Map[u8, u8].empty(testing::world().alloc)
    discard mut levels.insert(1, value: 10)
    var cursor = levels.cursor()
    let earlier = mut cursor.next()
    expect earlier.is_some()
    let later = mut cursor.next()
    expect later.is_none()
} map_cursor_next_ends_with_none

