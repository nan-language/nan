//! Entry of the batch runner and the board its jobs record on.

pub closed struct Board derives Copy {
    pub finished: u32
    pub last: u32
} Board

fn main(take world: host::World) fails task::Cancelled uses wait {
    var delays = mem::List[u64].empty(world.alloc)
    mut delays.push(30)
    mut delays.push(10)
    mut delays.push(20)
    let board = try await run_batch(delays.view(), limit_ms: 25, world: world)
    world.log.info("finished", value: board.finished)
    world.log.info("last", value: board.last)
} main

/// Starts one job per delay, which sleeps that long and then records its index on the board, and
/// gives the board once every job has ended or `limit_ms` have passed.
pub fn run_batch(delays: Slice[u64], limit_ms: u64, world: host::World) -> Board fails task::Cancelled uses wait {
    let board = task::Cown.of(Board(finished: 0, last: 0), alloc: world.alloc)
    let clock = world.clock
    let exec = world.exec
    discard try await task::within(clock, ms: limit_ms, body: fn() fails task::Cancelled uses wait {
        try await task::scope(exec, body: fn(s: task::Scope) {
            for index in 0..<delays.len() {
                let delay = delays[index]
                let job = u32.fit(index)
                let mine = board.share()
                discard s.spawn(fn[take mine]() fails task::Cancelled uses wait {
                    try await clock.sleep(delay)
                    await when mut mine {
                        mine.finished += 1
                        mine.last = job
                    }
                })
            }
        })
    })
    return await when board => board
} run_batch
