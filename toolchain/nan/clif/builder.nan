} Builder.srem

pkg fn Builder.umulhi(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Umulhi, x, y)
} Builder.umulhi

pkg fn Builder.smulhi(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Smulhi, x, y)
} Builder.smulhi

pkg fn Builder.band(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Band, x, y)
} Builder.band

pkg fn Builder.band_imm_s(mut self, x: Value, y: i64) -> Value {
    return mut self.binary_imm(Opcode.Band, x, y)
} Builder.band_imm_s

pkg fn Builder.bor(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Bor, x, y)
} Builder.bor

pkg fn Builder.bor_imm_s(mut self, x: Value, y: i64) -> Value {
    return mut self.binary_imm(Opcode.Bor, x, y)
} Builder.bor_imm_s

pkg fn Builder.bxor(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Bxor, x, y)
} Builder.bxor

pkg fn Builder.bxor_imm_s(mut self, x: Value, y: i64) -> Value {
    return mut self.binary_imm(Opcode.Bxor, x, y)
} Builder.bxor_imm_s

pkg fn Builder.bnot(mut self, x: Value) -> Value {
    let ty = self.value_type(x)
    return mut self.unary(Opcode.Bnot, ctrl_typevar: ty, arg: x)
} Builder.bnot

/// `x` and not `y`: a `bnot` then a `band`, as Cranelift builds it.
pkg fn Builder.band_not(mut self, x: Value, y: Value) -> Value {
    let neg = mut self.bnot(y)
    return mut self.band(x, y: neg)
} Builder.band_not

pkg fn Builder.ishl(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Ishl, x, y)
} Builder.ishl

pkg fn Builder.ishl_imm_s(mut self, x: Value, y: i64) -> Value {
    return mut self.binary_imm(Opcode.Ishl, x, y)
} Builder.ishl_imm_s

pkg fn Builder.ushr(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Ushr, x, y)
} Builder.ushr

pkg fn Builder.ushr_imm_s(mut self, x: Value, y: i64) -> Value {
    return mut self.binary_imm(Opcode.Ushr, x, y)
} Builder.ushr_imm_s

pkg fn Builder.sshr(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Sshr, x, y)
} Builder.sshr

pkg fn Builder.sshr_imm_s(mut self, x: Value, y: i64) -> Value {
