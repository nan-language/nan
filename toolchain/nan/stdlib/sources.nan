    \\} exhausted_alloc_fails_the_channel
    \\
    \\test split_sender_feeds_the_same_receiver for Sender.split {
    \\    let world = testing::world()
    \\    let channel = Channel[u32].bounded(2, alloc: world.alloc)
    \\    let sender = channel.sender
    \\    var receiver = channel.receiver
    \\    let other = sender.split()
    \\    try await other.send(5)
    \\    try await sender.send(6)
    \\    let older = try await mut receiver.receive()
    \\    let newer = try await mut receiver.receive()
    \\    expect older == Some(5)
    \\    expect newer == Some(6)
    \\} split_sender_feeds_the_same_receiver
    \\
    \\test send_without_a_receiver_fails_closed for Sender.send {
    \\    let world = testing::world()
    \\    let channel = Channel[u32].bounded(1, alloc: world.alloc)
    \\    let sender = channel.sender
    \\    discard channel.receiver
    \\    let outcome = attempt await sender.send(5)
    \\    let closed = match outcome {
    \\        Err(SendError.Closed) => true
    \\        else => false
    \\    }
    \\    expect closed
    \\} send_without_a_receiver_fails_closed
    \\
    \\test receive_ends_once_every_sender_is_released for Receiver.receive {
    \\    let world = testing::world()
    \\    let channel = Channel[u32].bounded(1, alloc: world.alloc)
    \\    let sender = channel.sender
    \\    var receiver = channel.receiver
    \\    try await sender.send(3)
    \\    discard sender
    \\    let value = try await mut receiver.receive()
    \\    let end = try await mut receiver.receive()
    \\    expect value == Some(3)
    \\    expect end == None
    \\} receive_ends_once_every_sender_is_released
    \\
    \\test drain_visits_values_oldest_first for Receiver.drain {
    \\    let world = testing::world()
    \\    let channel = Channel[u32].bounded(2, alloc: world.alloc)
    \\    let sender = channel.sender
    \\    let receiver = channel.receiver
    \\    try await sender.send(1)
    \\    try await sender.send(2)
    \\    discard sender
    \\    var digits: u32 = 0
    \\    try await take receiver.drain(visit: fn[mut digits](take value: u32) {
    \\        digits = digits * 10 + value
    \\    })
    \\    expect digits == 12
    \\} drain_visits_values_oldest_first
    \\

const TEXT_TESTING_PACKAGE: Str =
    \\//! The simulated world and structural comparison.
    \\
    \\package testing {
    \\    language 1
    \\    targets any
    \\} testing
    \\

const TEXT_TESTING_TESTING: Str =
    \\//! The simulated world and structural comparison.
    \\
    \\pub fn world() -> host::World
    \\    example mem::Bytes.zeroed(3, alloc: world().alloc).len() == 3
    \\
    \\pub fn same[T: Any](actual: T, expected: T) -> bool limits pure, notrap, terminates
    \\    example same(Some(3u8), expected: Some(3))
    \\    example not same(b"ab", expected: b"ac")
    \\

const TEXT_TEXT_CASE_CASE: Str =
    \\//! Case folding and comparison of text without regard to case.
    \\
    \\pub fn fold(c: char) -> char limits pure, notrap, terminates
    \\    example fold('Σ') == 'σ'
    \\    example fold('ß') == 'ß'
    \\{
    \\    let bits = c.to_bits()
    \\    if bits < 0x80 {
    \\        return c.to_ascii_lowercase()
    \\    }
    \\    var below: usize = 0
    \\    var above = RUNS.len()
    \\    for _ in 0..<RUNS.len() {
    \\        if below >= above or above > RUNS.len() {
    \\            break
    \\        }
    \\        let middle = below + (above - below) / 2
    \\        if RUNS[middle].low <= bits {
    \\            below = middle + 1
    \\        } else {
    \\            above = middle
    \\        }
    \\    }
    \\    if below == 0 or below > RUNS.len() {
    \\        return c
    \\    }
    \\    let run = RUNS[below - 1]
    \\    if bits < run.low or bits > run.high {
    \\        return c
    \\    }
    \\    let offset = bits - run.low
    \\    if run.alternate and offset % 2 != 0 {
    \\        return c
    \\    }
    \\    return char.checked_from_bits(run.to.wrapping_add(offset)).value_or(c)
    \\} fold
    \\
    \\pub fn eq(text: Str, other: Str) -> bool limits pure, notrap, terminates
    \\    example eq("ΣΊΣΥΦΟΣ", other: "σίσυφος")
    \\    example not eq("Straße", other: "STRASSE")
    \\{
    \\    let bytes = other.as_bytes()
    \\    var at: usize = 0
    \\    for c in text {
    \\        let Some(d) = utf8::char_at(bytes, at) else {
    \\            return false
    \\        }
    \\        if c != d and fold(c) != fold(d) {
    \\            return false
    \\        }
    \\        at = at.saturating_add(d.utf8_len())
    \\    }
    \\    return at == bytes.len()
    \\} eq
    \\
    \\test fold_maps_ascii_and_latin_1 for fold {
    \\    expect fold('A') == 'a'
    \\    expect fold('z') == 'z'
    \\    expect fold('@') == '@'
    \\    expect fold('À') == 'à'
    \\    expect fold('Þ') == 'þ'
    \\    expect fold('×') == '×'
    \\    expect fold('µ') == 'μ'
    \\} fold_maps_ascii_and_latin_1
    \\
    \\test fold_unites_the_greek_sigmas for fold {
    \\    expect fold('Σ') == 'σ'
    \\    expect fold('ς') == 'σ'
    \\    expect fold('σ') == 'σ'
    \\} fold_unites_the_greek_sigmas
    \\
    \\test fold_maps_alternating_and_distant_runs for fold {
    \\    expect fold('Ā') == 'ā'
    \\    expect fold('ā') == 'ā'
    \\    expect fold('Ж') == 'ж'
    \\    expect fold('\\u{1E9E}') == 'ß'
    \\    expect fold('\\u{10400}') == '\\u{10428}'
    \\    expect fold('\\u{1E921}') == '\\u{1E943}'
    \\    expect fold('\\u{1E943}') == '\\u{1E943}'
    \\} fold_maps_alternating_and_distant_runs
    \\
    \\test fold_keeps_the_dotted_and_dotless_i for fold {
    \\    expect fold('I') == 'i'
    \\    expect fold('ı') == 'ı'
    \\    expect fold('İ') == 'İ'
    \\} fold_keeps_the_dotted_and_dotless_i
    \\
    \\test eq_compares_folded_chars for eq {
    \\    expect eq("FAT.TXT", other: "fat.txt")
    \\    expect eq("Ünïcödé", other: "üNÏCÖDÉ")
    \\    expect not eq("fat", other: "fats")
    \\    expect not eq("fats", other: "fat")
    \\    expect not eq("ı", other: "i")
    \\    expect eq("", other: "")
    \\} eq_compares_folded_chars
    \\
    \\test eq_matches_chars_of_other_lengths for eq {
    \\    expect eq("\\u{212A}elvin", other: "kelvin")
    \\    expect eq("\\u{212B}ngström", other: "ångström")
    \\    expect eq("\\u{1C80}", other: "в")
    \\} eq_matches_chars_of_other_lengths
    \\

const TEXT_TEXT_CASE_TABLE: Str =
    \\//! The simple case folding of Unicode 18.0.0: the mappings of its CaseFolding.txt of status C or S.
    \\
