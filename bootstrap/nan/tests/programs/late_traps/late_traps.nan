//! A keyed task an abandoned stepper leaves running traps once the domain's body has returned; a later domain's trap then settles.

pub closed struct Env {
} Env

pub closed enum Note {
    Start
} Note

pub closed struct Idle derives Encode {
} Idle

impl Idle: sys::Component[Env, Note]

pub fn Idle.start(mut env: Env) -> Idle = Idle()

pub fn Idle.on(mut self, take message: Note, mut env: Env, mut cx: sys::Cx[Note]) {
    mut cx.spawn(key: 1, run: fn(out: sys::Outbox[Note]) {
        discard share(busy(20_000_000), items: 0)
    })
} Idle.on

fn busy(rounds: u64) -> u32 {
    var count: u64 = 0
    var left = rounds
    while left > 0 {
        count = count.wrapping_add(left)
        left -= 1
    }
    return u32.truncate(count & 1)
} busy

fn share(total: u32, items: u32) -> u32 {
    return total / items
} share

fn main(take world: host::World) fails task::Cancelled uses wait {
    let exec = world.exec
    let alloc = world.alloc
    let late = try await sys::Domain.run(fn() -> u32 fails task::Cancelled {
        var stepper = try sys::Stepper[Idle, Env, Note].start(Env(), exec, alloc)
        mut stepper.deliver(Note.Start)
        take stepper.abandon()
        return 7
    }, exec, alloc)
    match late {
        Ok(value) => world.log.info("late returned", value: value)
        Err(trap) => world.log.info("late kind", value: trap.kind())
    }
    let later = try await sys::Domain.run(fn() -> u32 {
        return share(1, items: 0)
    }, exec, alloc)
    world.log.info("later trapped", value: later.is_err())
} main
