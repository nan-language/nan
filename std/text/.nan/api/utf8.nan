item "text::utf8::valid_prefix"
text "pub fn valid_prefix(bytes: Slice[u8]) -> usize limits pure, notrap, terminates"
text "    ensures result <= bytes.len()"
text "    example valid_prefix(b\"ok\\xFF\") == 2"
text "    example valid_prefix(b\"\\xC3\\xA9\") == 2"
