//! A configuration re-encoded with the fields of a newer release, and settings read and written in the shape of their first release.

pub flexible struct Config derives Eq, Encode {
    pub retries: u8
} Config

pub closed struct Settings derives Eq, Encode {
    pub retries: u8
    pub backoff: u16
} Settings

struct FirstSettings derives Encode {
    retries: u8
} FirstSettings

migrate fn Settings.from_first(take old: FirstSettings) -> Settings limits notrap, terminates {
    return Settings(retries: old.retries, backoff: 100)
} Settings.from_first

migrate fn Settings.to_first(self, alloc: mem::Alloc) -> FirstSettings limits notrap, terminates {
    return FirstSettings(retries: self.retries)
} Settings.to_first

fn main(take world: host::World) fails task::Cancelled uses wait {
    let alloc = world.alloc
    let decoded = attempt mem::wire::Codec[Config].decode(Untrusted.of(b"\x03\x01a\x01\x01\x04mode\x01\x07\x07retries\x01\x03"), alloc)
    match decoded {
        Ok(config) => {
            world.log.info("equal", value: config == Config(retries: 3))
            var kept = mem::Bytes.empty(alloc)
            mem::wire::Codec[Config].encode(config, out: mut kept)
            world.log.info("kept", value: kept.view())
            var json = text::String.empty(alloc)
            text::json::Codec[Config].encode(config, out: mut json)
            world.log.info("json", value: json.as_str())
        }
        Err(error) => world.log.info("decoded", value: error)
    }
    var fresh = mem::Bytes.empty(alloc)
    mem::wire::Codec[Config].encode(Config(retries: 2), out: mut fresh)
    world.log.info("fresh", value: fresh.view())
    let older = mem::wire::Codec[FirstSettings].schema_hash()
    match attempt mem::wire::Codec[Settings].decode_from(older, raw: Untrusted.of(b"\x01\x07retries\x01\x03"), alloc) {
        Ok(settings) => world.log.info("migrated backoff", value: settings.backoff)
        Err(error) => world.log.info("migrated", value: error)
    }
    match attempt mem::wire::Codec[Settings].decode_from(mem::wire::Codec[u8].schema_hash(), raw: Untrusted.of(b"\x03"), alloc) {
        Ok(settings) => world.log.info("unknown retries", value: settings.retries)
        Err(error) => world.log.info("unknown", value: error)
    }
    var earlier = mem::Bytes.empty(alloc)
    let written = mem::wire::Codec[Settings].encode_as(Settings(retries: 4, backoff: 50), schema: older, out: mut earlier, alloc)
    world.log.info("written", value: written)
    world.log.info("earlier", value: earlier.view())
    let refused = mem::wire::Codec[Settings].encode_as(Settings(retries: 4, backoff: 50), schema: mem::wire::Codec[u8].schema_hash(), out: mut earlier, alloc)
    world.log.info("refused", value: refused)
} main
