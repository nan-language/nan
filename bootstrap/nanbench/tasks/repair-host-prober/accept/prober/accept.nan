//! Acceptance tests of the prober.

test a_listening_port_is_up for is_up {
    let world = testing::world()
    let listener = try await world.net.listen(4_311)
    let listening = try await is_up(world.net, port: 4_311)
    let silent = try await is_up(world.net, port: 4_312)
    discard listener
    expect listening
    expect not silent
} a_listening_port_is_up

test only_listening_ports_count for count_up {
    let world = testing::world()
    let lower = try await world.net.listen(4_320)
    let upper = try await world.net.listen(4_323)
    let beyond = try await world.net.listen(4_324)
    let counted = try await count_up(world.net, start: 4_320, count: 4)
    let none_counted = try await count_up(world.net, start: 4_321, count: 0)
    discard lower
    discard upper
    discard beyond
    expect counted == 2
    expect none_counted == 0
} only_listening_ports_count

test the_status_file_holds_the_count for record_status {
    let world = testing::world()
    try await world.fs.write_all("status.txt", data: b"up=99999\n")
    try await record_status(world.fs, up: 3, alloc: world.alloc)
    let saved = try await world.fs.read_all("status.txt", alloc: world.alloc)
    expect testing::same(saved.view(), expected: Untrusted.of(b"up=3\n"))
} the_status_file_holds_the_count
