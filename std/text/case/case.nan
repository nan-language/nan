//! Case folding and comparison of text without regard to case.

pub fn fold(c: char) -> char limits pure, notrap, terminates
    example fold('Σ') == 'σ'
    example fold('ß') == 'ß'
{
    let bits = c.to_bits()
    if bits < 0x80 {
        return c.to_ascii_lowercase()
    }
    var below: usize = 0
    var above = RUNS.len()
    for _ in 0..<RUNS.len() {
        if below >= above or above > RUNS.len() {
            break
        }
        let middle = below + (above - below) / 2
        if RUNS[middle].low <= bits {
            below = middle + 1
        } else {
            above = middle
        }
    }
    if below == 0 or below > RUNS.len() {
        return c
    }
    let run = RUNS[below - 1]
    if bits < run.low or bits > run.high {
        return c
    }
    let offset = bits - run.low
    if run.alternate and offset % 2 != 0 {
        return c
    }
    return char.checked_from_bits(run.to.wrapping_add(offset)).value_or(c)
} fold

pub fn eq(text: Str, other: Str) -> bool limits pure, notrap, terminates
    example eq("ΣΊΣΥΦΟΣ", other: "σίσυφος")
    example not eq("Straße", other: "STRASSE")
{
    let bytes = other.as_bytes()
    var at: usize = 0
    for c in text {
        let Some(d) = utf8::char_at(bytes, at) else {
            return false
        }
        if c != d and fold(c) != fold(d) {
            return false
        }
        at = at.saturating_add(d.utf8_len())
    }
    return at == bytes.len()
} eq

test fold_maps_ascii_and_latin_1 for fold {
    expect fold('A') == 'a'
    expect fold('z') == 'z'
    expect fold('@') == '@'
    expect fold('À') == 'à'
    expect fold('Þ') == 'þ'
    expect fold('×') == '×'
    expect fold('µ') == 'μ'
} fold_maps_ascii_and_latin_1

test fold_unites_the_greek_sigmas for fold {
    expect fold('Σ') == 'σ'
    expect fold('ς') == 'σ'
    expect fold('σ') == 'σ'
} fold_unites_the_greek_sigmas

test fold_maps_alternating_and_distant_runs for fold {
    expect fold('Ā') == 'ā'
    expect fold('ā') == 'ā'
    expect fold('Ж') == 'ж'
    expect fold('\u{1E9E}') == 'ß'
    expect fold('\u{10400}') == '\u{10428}'
    expect fold('\u{1E921}') == '\u{1E943}'
    expect fold('\u{1E943}') == '\u{1E943}'
} fold_maps_alternating_and_distant_runs

test fold_keeps_the_dotted_and_dotless_i for fold {
    expect fold('I') == 'i'
    expect fold('ı') == 'ı'
    expect fold('İ') == 'İ'
} fold_keeps_the_dotted_and_dotless_i

test eq_compares_folded_chars for eq {
    expect eq("FAT.TXT", other: "fat.txt")
    expect eq("Ünïcödé", other: "üNÏCÖDÉ")
    expect not eq("fat", other: "fats")
    expect not eq("fats", other: "fat")
    expect not eq("ı", other: "i")
    expect eq("", other: "")
} eq_compares_folded_chars

test eq_matches_chars_of_other_lengths for eq {
    expect eq("\u{212A}elvin", other: "kelvin")
    expect eq("\u{212B}ngström", other: "ångström")
    expect eq("\u{1C80}", other: "в")
} eq_matches_chars_of_other_lengths
