//! `nan upgrade --language <N> [<scope>]`: moves each package of the scope to language version N. The toolchain implements version 1 alone, which retires no form, so the command reports an unsupported N, an N below a package's version and the errors of the scope, and writes no file.

/// `nan upgrade --language`.
fn upgrade_language(invocation: Invocation, session: check::Session, current: Str, mut trace: Trace, alloc: mem::Alloc) -> output::Output {
    let held = session.workspace.contents()
    let Some(resolved) = scope::Scope.resolve(held, current, written: invocation.scope(), alloc) else {
        let unknown = match invocation.scope() {
            Some(written) => written
            None => "."
        }
        return invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: unknown, alloc)
    }
    let Some(language) = invocation.value("--language") else {
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: resolved.written.as_str(), alloc)
    }
    let Some(version) = platform::parse_decimal(language) else {
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: resolved.written.as_str(), alloc)
    }
    trace.scope = Some(text::String.of(resolved.written.as_str(), alloc))
    var diagnostics = mem::List[diagnostic::Diagnostic].empty(alloc)
    if not implements(version) {
        mut diagnostics.push(diagnostic::Diagnostic.new(diagnostic::Code.LanguageUnsupported, alloc))
    }
    let scoped = resolved.scope.package_index(held)
    for index in 0..<held.packages.len() {
        if scoped.is_some() and scoped != Some(index) {
            continue
        }
        let Some(source) = held.packages.get(index) else {
            expect false
            continue
        }
        let Some(manifest) = source.manifest else {
            continue
        }
        let Some(declared) = manifest.language else {
            continue
        }
        if wide::Wide.of_u64(version).lt(declared.version) {
            var path = text::String.of(source.dir.as_str(), alloc)
            mut path.append("/package.nan")
            mut diagnostics.push(diagnostic::Diagnostic.at(diagnostic::Code.LanguageDowngrade, path: path.as_str(), line: declared.line, alloc))
        }
    }
    for reported in take session.reported(resolved.scope) {
        if reported.code.class() == diagnostic::Class.Error {
            mut diagnostics.push(take reported)
        }
    }
    let errors = diagnostics.len()
    let std = session.std.contents()
    var records = mem::List[output::Record].empty(alloc)
    for reported in diagnostics {
        mut records.push(record(held, std, scope: resolved.scope, reported, alloc))
    }
    var verdict = output::Verdict.Ok
    if errors > 0 {
        verdict = output::Verdict.Failed
    }
    return output::Output(command: invocation.command(resolved.written.as_str(), skip: true, alloc), elision: invocation.command(resolved.written.as_str(), skip: false, alloc), verdict: verdict, summary: written_summary(files: 0, errors, incomplete: 0, alloc), records: take records)
} upgrade_language

/// Whether the toolchain implements a language version.
fn implements(version: u64) -> bool {
    for language in toolchain::LANGUAGES {
        if language == version {
            return true
        }
    }
    return false
} implements
