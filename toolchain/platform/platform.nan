//! What every system running the toolchain shares: how its calls fail, the kinds of files, how processes end, and the program's arguments.

/// What a call of the system failed with: the kinds the toolchain tells apart, or the error code
/// of any other failure, 0 when the system gave none.
pub closed enum IoError derives Copy, Eq, Render {
    NotFound
    AlreadyExists
    BrokenPipe
    InvalidData
    Other(i32)
} IoError

/// What kind of file a path names, a symbolic link or a junction being a `Symlink`.
pub closed enum FileKind derives Copy, Eq {
    Regular
    Directory
    Symlink
    Other
} FileKind

/// An entry of a directory: its name, as the bytes the system gives, and what kind of file it is.
pub closed struct DirEntry {
    pub name: mem::Bytes
    pub kind: FileKind
} DirEntry

/// How a process ended: the status it exited with, or the number of the signal that ended it.
pub closed enum Status derives Copy, Eq {
    Exited(i32)
    Signalled(i32)
} Status

/// Whether a process exited with status 0.
pub fn Status.is_success(self) -> bool = self == Status.Exited(0)

/// What a program wrote to its standard output and error, and how it ended.
pub closed struct Output {
    pub status: Status
    pub stdout: mem::Bytes
    pub stderr: mem::Bytes
} Output

/// The program's arguments as texts; none when one is not well-formed UTF-8.
pub validator fn arguments(raw: Untrusted[mem::List[mem::Bytes]], alloc: mem::Alloc) -> Option[mem::List[text::String]] {
    var args = mem::List[text::String].empty(alloc)
    for arg in raw.inspect() {
        let Ok(written) = attempt text::String.try_from_utf8(arg.view(), alloc) else {
            return None
        }
        mut args.push(take written)
    }
    return Some(take args)
} arguments
