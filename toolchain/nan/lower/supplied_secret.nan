//! Secret values: each member of `core::Secret` lowered to one fixed sequence of integer instructions, without a branch, a division or an address computed from its operands, but for the shifts' check of their public amount.

/// Defines a member of `core::Secret`.
fn secret_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) -> bool {
    if not supply.path.starts_with("core::Secret.") {
        return false
    }
    let Some(scalar) = lo.ck.types().scalar_of(supply.type_arg(lo, index: 0)) else {
        expect false
        return false
    }
    let signed = scalar.is_signed()
    let member = supply.member()
    let a = supply.param(0).scalar_value()
    if member == "of" or member == "reveal" {
        supply.ret(mut lo, mut fx, held: Held.Scalar(a))
        return true
    }
    if member == "bit_not" {
        var flipped = a
        if scalar == ty::Scalar.Bool {
            flipped = mut fx.b.bxor_imm_s(a, y: 1)
        } else {
            flipped = mut fx.b.bnot(a)
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(flipped))
        return true
    }
    if member == "widen" {
        let Some(source) = lo.ck.types().scalar_of(supply.type_arg(lo, index: 1)) else {
            expect false
            return false
        }
        var widened = a
        if source.is_signed() {
            widened = mut fx.b.sextend(scalar_type(scalar), x: a)
        } else {
            widened = mut fx.b.uextend(scalar_type(scalar), x: a)
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(widened))
        return true
    }
    if member == "truncate" {
        supply.ret(mut lo, mut fx, held: Held.Scalar(place_resize(mut fx, value: a, target: scalar_type(scalar))))
        return true
    }
    let b = supply.param(1).scalar_value()
    if member == "shl" or member == "shr" {
        let amount = body_widen(mut fx, value: b)
        let too_far = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: amount, y: i64.widen(scalar.bits()))
        mut fx.if_true(too_far, then: fn[mut lo](mut fx1: Fx) {
            raise_kind(mut lo, fx: mut fx1, kind: "trap.shift")
        })
        var shifted = a
        if member == "shl" {
            shifted = mut fx.b.ishl(a, y: b)
        } else if signed {
            shifted = mut fx.b.sshr(a, y: b)
        } else {
            shifted = mut fx.b.ushr(a, y: b)
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(shifted))
        return true
    }
    if member == "rotate_left" {
        let width = mut fx.int(clif::Type.Int32, value: i64.widen(scalar.bits()))
        let turn = mut fx.b.isub(width, y: b)
        supply.ret(mut lo, mut fx, held: Held.Scalar(mut fx.b.rotr(a, y: turn)))
        return true
    }
    if member == "select" {
        let chosen = mut fx.b.select(a, x: b, y: supply.param(2).scalar_value())
        supply.ret(mut lo, mut fx, held: Held.Scalar(chosen))
        return true
    }
    let Some(cond) = secret_comparison(member, signed) else {
        let Some(held) = secret_binary(mut fx, member, signed, a, b) else {
            return false
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(held))
        return true
    }
    supply.ret(mut lo, mut fx, held: Held.Scalar(mut fx.b.icmp(cond, x: a, y: b)))
    return true
} secret_lower

/// The condition a Secret comparison tests, by its name and the signedness of its operands.
fn secret_comparison(member: Str, signed: bool) -> Option[clif::IntCC] {
    return match first member {
        "eq" => Some(clif::IntCC.Equal)
        "ne" => Some(clif::IntCC.NotEqual)
        "lt" if signed => Some(clif::IntCC.SignedLessThan)
        "lt" => Some(clif::IntCC.UnsignedLessThan)
        "le" if signed => Some(clif::IntCC.SignedLessThanOrEqual)
        "le" => Some(clif::IntCC.UnsignedLessThanOrEqual)
        "gt" if signed => Some(clif::IntCC.SignedGreaterThan)
        "gt" => Some(clif::IntCC.UnsignedGreaterThan)
        "ge" if signed => Some(clif::IntCC.SignedGreaterThanOrEqual)
        "ge" => Some(clif::IntCC.UnsignedGreaterThanOrEqual)
        else => None
    }
} secret_comparison

/// The one instruction computing a Secret member on two values, by its name.
fn secret_binary(mut fx: Fx, member: Str, signed: bool, a: clif::Value, b: clif::Value) -> Option[clif::Value] {
    return match first member {
        "wrapping_add" => Some(mut fx.b.iadd(a, y: b))
        "wrapping_sub" => Some(mut fx.b.isub(a, y: b))
        "wrapping_mul" => Some(mut fx.b.imul(a, y: b))
        "mul_high" if signed => Some(mut fx.b.smulhi(a, y: b))
        "mul_high" => Some(mut fx.b.umulhi(a, y: b))
        "bit_and" => Some(mut fx.b.band(a, y: b))
        "bit_or" => Some(mut fx.b.bor(a, y: b))
        "bit_xor" => Some(mut fx.b.bxor(a, y: b))
        "rotate_right" => Some(mut fx.b.rotr(a, y: b))
        else => None
    }
} secret_binary
