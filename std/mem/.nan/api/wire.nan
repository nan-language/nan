item "mem::wire::Schema.accepts"
text "pub fn Schema.accepts(self, old: Schema, alloc: mem::Alloc) -> bool"
text "    example Codec[text::Fixed[16]].schema(testing::world().alloc).accepts(Codec[text::Fixed[8]].schema(testing::world().alloc), alloc: testing::world().alloc)"
text "    example not Codec[u16].schema(testing::world().alloc).accepts(Codec[u8].schema(testing::world().alloc), alloc: testing::world().alloc)"
interface "afm34y4wuri2qut4kzfmtcsryohhaawikps2tjow7pk76lesaldh4yn"
digest any "effects alloc | authority none | may-trap yes | may-not-terminate"
head "pub fn Schema.accepts(self, old: Schema, alloc: mem::Alloc) -> bool"
accepted "example Codec[text::Fixed[16]].schema(testing::world().alloc).accepts(Codec[text::Fixed[8]].schema(testing::world().alloc), alloc: testing::world().alloc)"
accepted "example not Codec[u16].schema(testing::world().alloc).accepts(Codec[u8].schema(testing::world().alloc), alloc: testing::world().alloc)"
test "mem::wire::nodes_shared_or_out_of_order_accept_nothing" "" "aefbalqpnogre7y27epbaovf4l4tdkxidka46p2u7x6dlcpjwod2ck3" "aefbalqpnogre7y27epbaovf4l4tdkxidka46p2u7x6dlcpjwod2ck3" "aefbalqpnogre7y27epbaovf4l4tdkxidka46p2u7x6dlcpjwod2ck3"
test "mem::wire::records_accept_defaulted_and_dropped_fields" "" "aefbalqpnogre7y27epbaovf4l4tdkxidka46p2u7x6dlcpjwod2ck3" "agktn232i2kosrmk5wuxvqjj37xdovk7hstu7uliyysc3binh2q5arx"
