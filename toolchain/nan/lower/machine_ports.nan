//! The ports the machine descriptors name: the serial port reports and test frames are written to, the 16550 on x86_64 and the UART the AArch64 machine's discovery finds; the exit port that ends the emulator; and the emulator's configuration device, from which a test image reads the texts naming its run.

/// The serial and exit ports the x86_64 descriptors name.
const SERIAL_PORT: u64 = 0x3F8

const EXIT_PORT: u64 = 0xF4

/// The PL011's registers: the data register, the flag register, whose transmit-full bit is the bit
/// `TRANSMIT` a 16550's line status register sets while its transmitter is empty, the integer and
/// fractional baud divisors, the line control register with eight data bits and its FIFOs
/// enabled, and the control register enabling the UART, its transmitter and its receiver.
const PL011_FLAG: u64 = 0x18

const PL011_IBRD: u64 = 0x24

const PL011_FBRD: u64 = 0x28

const PL011_LINE_CONTROL: u64 = 0x2C

const PL011_EIGHT_BITS: u64 = 0x70

const PL011_CONTROL: u64 = 0x30

const PL011_ENABLE: u64 = 0x301

const TRANSMIT: i64 = 0x20

/// The divisors giving 115200 baud from a 24 MHz UART clock, which a PL011 the firmware left
/// without a divisor gets.
const PL011_DIVISORS: Array[RegisterWrite, 2] = listed_pl011_divisors()

fn listed_pl011_divisors() -> Array[RegisterWrite, 2] {
    var listed = Array[RegisterWrite, 2].filled(RegisterWrite(register: PL011_IBRD, value: 13))
    listed[1] = RegisterWrite(register: PL011_FBRD, value: 1)
    return listed
} listed_pl011_divisors

/// The writes programming the 16550, each a register's index and its value: no
/// interrupts, the divisor latch open, divisor 1, then 8N1 with the latch closed, the FIFOs on
/// and cleared, and the modem lines raised with loopback off. A memory-mapped 16550 keeps its
/// divisor and gets the writes after the divisor's.
const SERIAL_SETUP: Array[RegisterWrite, 7] = listed_serial_setup()

fn listed_serial_setup() -> Array[RegisterWrite, 7] {
    var listed = Array[RegisterWrite, 7].filled(RegisterWrite(register: 1, value: 0x00))
    listed[1] = RegisterWrite(register: 3, value: 0x80)
    listed[2] = RegisterWrite(register: 0, value: 0x01)
    listed[3] = RegisterWrite(register: 1, value: 0x00)
    listed[4] = RegisterWrite(register: 3, value: 0x03)
    listed[5] = RegisterWrite(register: 2, value: 0xC7)
    listed[6] = RegisterWrite(register: 4, value: 0x03)
    return listed
} listed_serial_setup

const MAPPED_SETUP: usize = 3

/// A value written to a register at an offset.
struct RegisterWrite derives Copy {
    register: u64
    value: u64
} RegisterWrite

/// The UART's line status register.
const LINE_STATUS: u64 = 5

/// Programs the serial port's UART to 8 data bits, no parity and one stop bit, its FIFOs on: the
/// 16550 at an x86_64 port to 115200 baud; on AArch64 the UART the machine record names, keeping
/// its baud rate, a PL011 without a divisor getting 115200 baud from a 24 MHz clock and an SBSA
/// generic UART nothing.
fn Lowering.serial_init(mut self, mut fx: Fx) {
    if self.ck.db().target.arch() != Some(workspace::Arch.Aarch64) {
        for setup in SERIAL_SETUP {
            expect setup.register < 8
            let port = mut fx.ptr(SERIAL_PORT + setup.register)
            let value = mut fx.ptr(setup.value)
            mut self.port_out(mut fx, width: 1, port, value)
        }
        return
    }
    let record = mut self.machine_record(mut fx)
    let base = mut fx.load(PTR, addr: record, offset: MACHINE_UART)
    let kind = mut fx.load(PTR, addr: record, offset: MACHINE_UART_KIND)
    let pl011 = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: UART_PL011)
    mut fx.if_true(pl011, then: fn[mut self](mut fx1: Fx) {
        pl011_write(mut self, fx: mut fx1, base, register: PL011_CONTROL, value: 0)
        let divisor_at = mut fx1.b.iadd_imm_s(base, y: i64.fit(PL011_IBRD))
        let divisor = mut self.mmio_read(mut fx1, width: 4, address: divisor_at)
        let unset = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: divisor, y: 0)
        mut fx1.if_true(unset, then: fn[mut self](mut fx2: Fx) {
            for setup in PL011_DIVISORS {
                pl011_write(mut self, fx: mut fx2, base, register: setup.register, value: setup.value)
            }
        })
        pl011_write(mut self, fx: mut fx1, base, register: PL011_LINE_CONTROL, value: PL011_EIGHT_BITS)
        pl011_write(mut self, fx: mut fx1, base, register: PL011_CONTROL, value: PL011_ENABLE)
    })
    let ns16550 = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: UART_NS16550)
    mut fx.if_true(ns16550, then: fn[mut self](mut fx1: Fx) {
        for index in MAPPED_SETUP..<SERIAL_SETUP.len() {
            let setup = SERIAL_SETUP[index]
            let at = mut self.uart_register(mut fx1, record, index: setup.register)
            let value = mut fx1.ptr(setup.value)
            mut self.uart_write(mut fx1, record, at, value)
        }
    })
} Lowering.serial_init

/// Writes `value` to a PL011 register at an offset from its base.
fn pl011_write(mut lo: Lowering, mut fx: Fx, base: clif::Value, register: u64, value: u64) {
    let at = mut fx.b.iadd_imm_s(base, y: i64.fit(register))
    let written = mut fx.ptr(value)
    mut lo.mmio_write(mut fx, width: 4, address: at, value: written)
} pl011_write

/// Writes a byte range to the serial port, each byte once its transmitter can take one; on
/// AArch64 nothing is written when the machine has no UART.
fn Lowering.serial_write(mut self, mut fx: Fx, text: clif::Value, len: clif::Value) {
    if self.ck.db().target.arch() != Some(workspace::Arch.Aarch64) {
        let data = mut fx.ptr(SERIAL_PORT)
        let status = mut fx.ptr(SERIAL_PORT + LINE_STATUS)
        mut self.write_bytes(mut fx, text, len, busy: fn(mut lo1: Lowering, mut fx1: Fx) -> clif::Value {
            let line = mut lo1.port_in(mut fx1, width: 1, port: status)
            let flag = mut fx1.b.band_imm_s(line, y: TRANSMIT)
            return mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: flag, y: 0)
        }, put: fn(mut lo1: Lowering, mut fx1: Fx, byte: clif::Value) {
            mut lo1.port_out(mut fx1, width: 1, port: data, value: byte)
        })
        return
    }
    let record = mut self.machine_record(mut fx)
    let base = mut fx.load(PTR, addr: record, offset: MACHINE_UART)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: base, y: 0)
    mut fx.if_true(present, then: fn[mut self](mut fx1: Fx) {
        let kind = mut fx1.load(PTR, addr: record, offset: MACHINE_UART_KIND)
        let ns16550 = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: UART_NS16550)
        let status_register = mut self.uart_register(mut fx1, record, index: LINE_STATUS)
        let flag_at = mut fx1.b.iadd_imm_s(base, y: i64.fit(PL011_FLAG))
        let status = mut fx1.b.select(ns16550, x: status_register, y: flag_at)
        let empty = mut fx1.ptr(0)
        let full = mut fx1.ptr(u64.fit(TRANSMIT))
        let busy_value = mut fx1.b.select(ns16550, x: empty, y: full)
        mut self.write_bytes(mut fx1, text, len, busy: fn(mut lo2: Lowering, mut fx2: Fx) -> clif::Value {
            let line = mut lo2.uart_read(mut fx2, record, at: status)
            let flag = mut fx2.b.band_imm_s(line, y: TRANSMIT)
            return mut fx2.b.icmp(clif::IntCC.Equal, x: flag, y: busy_value)
        }, put: fn(mut lo2: Lowering, mut fx2: Fx, byte: clif::Value) {
            mut lo2.uart_write(mut fx2, record, at: base, value: byte)
        })
    })
} Lowering.serial_write

/// Writes each byte of a range through `put` once `busy` gives zero.
fn Lowering.write_bytes(mut self, mut fx: Fx, text: clif::Value, len: clif::Value, busy: fn(mut lo: Lowering, mut fx: Fx) -> clif::Value, put: fn(mut lo: Lowering, mut fx: Fx, byte: clif::Value)) {
    let start = mut fx.ptr(0)
    mut fx.each(start, end: len, body: fn[mut self](mut fx1: Fx, index: clif::Value) {
        discard mut fx1.repeat(mem::List[clif::Value].empty(fx1.alloc).view(), body: fn[mut self](mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            let again = busy(mut self, fx: mut fx2)
            return Pass(again: again, next: mem::List[clif::Value].empty(fx2.alloc))
        })
        let at = mut fx1.b.iadd(text, y: index)
        let loaded = mut fx1.b.load(clif::Type.Int8, flags: clif::MemFlags.unaligned(), p: at, offset: 0)
        let byte = mut fx1.b.uextend(PTR, x: loaded)
        put(mut self, fx: mut fx1, byte)
    })
} Lowering.write_bytes

/// The address of the AArch64 UART's register of an index, its registers lying `1 << shift` bytes
/// apart.
fn Lowering.uart_register(mut self, mut fx: Fx, record: clif::Value, index: u64) -> clif::Value {
    let base = mut fx.load(PTR, addr: record, offset: MACHINE_UART)
    let shift = mut fx.load(PTR, addr: record, offset: MACHINE_UART_SHIFT)
    let index_value = mut fx.ptr(index)
    let offset = mut fx.b.ishl(index_value, y: shift)
    return mut fx.b.iadd(base, y: offset)
} Lowering.uart_register

/// Reads an AArch64 UART register at the UART's access width.
fn Lowering.uart_read(mut self, mut fx: Fx, record: clif::Value, at: clif::Value) -> clif::Value {
    let width = mut fx.load(PTR, addr: record, offset: MACHINE_UART_WIDTH)
    let bytes = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: width, y: 1)
    let read = mut fx.choose_in(mut self, condition: bytes, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut lo1.mmio_read(mut fx1, width: 1, address: at))
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut lo1.mmio_read(mut fx1, width: 4, address: at))
    })
    return read[0]
} Lowering.uart_read

/// Writes an AArch64 UART register at the UART's access width.
fn Lowering.uart_write(mut self, mut fx: Fx, record: clif::Value, at: clif::Value, value: clif::Value) {
    let width = mut fx.load(PTR, addr: record, offset: MACHINE_UART_WIDTH)
    let bytes = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: width, y: 1)
    discard mut fx.choose_in(mut self, condition: bytes, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        mut lo1.mmio_write(mut fx1, width: 1, address: at, value)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        mut lo1.mmio_write(mut fx1, width: 4, address: at, value)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} Lowering.uart_write

/// Ends the machine through the exit port the emulator reads, writing the status byte and then
/// stopping the processor with maskable interrupts disabled. On AArch64 the exit is a semihosting
/// call whose subcode is twice the status plus one, the exit status the x86_64 exit device gives
/// the emulator. Nothing follows.
fn Lowering.exit_machine(mut self, mut fx: Fx, status: clif::Value) {
    if self.ck.db().target.arch() == Some(workspace::Arch.Aarch64) {
        let doubled = mut fx.b.ishl_imm_s(status, y: 1)
        let code = mut fx.b.bor_imm_s(doubled, y: 1)
        discard mut self.call_stub(mut fx, stub: Stub.SemiExit, args: Array[clif::Value, 1].filled(code).view())
        mut fx.b.trap(clif::TrapCode(user: 1))
        return
    }
    let port = mut fx.ptr(EXIT_PORT)
    mut self.port_out(mut fx, width: 1, port, value: status)
    discard mut self.call_stub(mut fx, stub: Stub.Halt, args: mem::List[clif::Value].empty(fx.alloc).view())
    mut fx.b.trap(clif::TrapCode(user: 1))
} Lowering.exit_machine

/// The emulator's configuration device: its x86_64 selector and data ports, and its AArch64
/// memory-mapped data register and the selector register after it, which takes the selector
/// big-endian; the selector of its file directory, and the bytes of a directory entry, which
/// holds the file's size and selector big-endian, two reserved bytes and its NUL-padded name.
const FW_CFG_SELECTOR: u64 = 0x510

const FW_CFG_DATA: u64 = 0x511

const FW_CFG_MMIO_DATA: u64 = 0x0902_0000

const FW_CFG_MMIO_SELECTOR: u64 = 0x0902_0008

const FW_CFG_FILE_DIR: u64 = 0x19

const FW_CFG_NAME: u64 = 56

/// An emulator configuration file read into a runtime record: the record's address, and the
/// file's length.
struct FwCfgFile derives Copy {
    address: clif::Value
    len: clif::Value
} FwCfgFile

/// Reads the emulator's configuration file of a name into a runtime record: its address and
/// length, a NUL following its bytes; the length is zero when the file is absent.
fn Lowering.fw_cfg_file(mut self, mut fx: Fx, file_name: Str) -> FwCfgFile {
    let directory = mut fx.ptr(FW_CFG_FILE_DIR)
    mut self.fw_cfg_select(mut fx, item: directory)
    let count = mut self.fw_cfg_number(mut fx, width: 4)
    var wanted_bytes = mem::Bytes.empty(self.alloc)
    mut wanted_bytes.append(file_name.as_bytes())
    mut wanted_bytes.push(0)
    let wanted_len = mut fx.ptr(u64.widen(wanted_bytes.len()))
    let literal = mut self.view_literal(mut fx, contents: wanted_bytes.view())
    let wanted = mut fx.load(PTR, addr: literal.address_value(), offset: 0)
    let dir_entry = mut fx.slot(FW_CFG_NAME, align: 8)
    let zero_value = mut fx.ptr(0)
    let size_var = mut fx.variable(PTR, initial: zero_value)
    let select_var = mut fx.variable(PTR, initial: zero_value)
    mut fx.each(zero_value, end: count, body: fn[mut self](mut fx1: Fx, file_index: clif::Value) {
        let file_size = mut self.fw_cfg_number(mut fx1, width: 4)
        let file_select = mut self.fw_cfg_number(mut fx1, width: 2)
        discard mut self.fw_cfg_number(mut fx1, width: 2)
        let start = mut fx1.ptr(0)
        let end = mut fx1.ptr(FW_CFG_NAME)
        mut fx1.each(start, end, body: fn[mut self](mut fx2: Fx, index: clif::Value) {
            let read = mut self.fw_cfg_byte(mut fx2)
            let byte = mut fx2.b.ireduce(clif::Type.Int8, x: read)
            let at = mut fx2.b.iadd(dir_entry, y: index)
            mut fx2.store(byte, addr: at, offset: 0)
        })
        var args = Array[clif::Value, 3].filled(dir_entry)
        args[1] = wanted
        args[2] = wanted_len
        let compared = mut self.call_routine(mut fx1, routine: Routine.Compare, args: args.view())
        expect compared.len() > 0
        let same = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: compared[0], y: 0)
        mut fx1.if_true(same, then: fn(mut fx2: Fx) {
            mut fx2.b.def_var(size_var, val: file_size)
            mut fx2.b.def_var(select_var, val: file_select)
        })
    })
    let size = mut fx.b.use_var(size_var)
    let select = mut fx.b.use_var(select_var)
    let room = mut fx.b.iadd_imm_s(size, y: 1)
    let record = mut self.record_alloc(mut fx, size: room)
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
    mut fx.if_true(missing, then: fn[mut self](mut fx1: Fx) {
        system_unavailable(mut self, fx: mut fx1)
    })
    let exists = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: size, y: 0)
    mut fx.if_true(exists, then: fn[mut self](mut fx1: Fx) {
        mut self.fw_cfg_select(mut fx1, item: select)
        let start = mut fx1.ptr(0)
        mut fx1.each(start, end: size, body: fn[mut self](mut fx2: Fx, index: clif::Value) {
            let read = mut self.fw_cfg_byte(mut fx2)
            let byte = mut fx2.b.ireduce(clif::Type.Int8, x: read)
            let at = mut fx2.b.iadd(record, y: index)
            mut fx2.store(byte, addr: at, offset: 0)
        })
    })
    return FwCfgFile(address: record, len: size)
} Lowering.fw_cfg_file

/// Selects the configuration device's item of a 16-bit selector.
fn Lowering.fw_cfg_select(mut self, mut fx: Fx, item: clif::Value) {
    if self.ck.db().target.arch() == Some(workspace::Arch.Aarch64) {
        let masked = mut fx.b.band_imm_s(item, y: 0xFF)
        let low = mut fx.b.ishl_imm_s(masked, y: 8)
        let high = mut fx.b.ushr_imm_s(item, y: 8)
        let swapped = mut fx.b.bor(low, y: high)
        let at = mut fx.ptr(FW_CFG_MMIO_SELECTOR)
        mut self.mmio_write(mut fx, width: 2, address: at, value: swapped)
        return
    }
    let selector = mut fx.ptr(FW_CFG_SELECTOR)
    mut self.port_out(mut fx, width: 2, port: selector, value: item)
} Lowering.fw_cfg_select

/// The next byte of the selected item, zero-extended.
fn Lowering.fw_cfg_byte(mut self, mut fx: Fx) -> clif::Value {
    if self.ck.db().target.arch() == Some(workspace::Arch.Aarch64) {
        let data = mut fx.ptr(FW_CFG_MMIO_DATA)
        return mut self.mmio_read(mut fx, width: 1, address: data)
    }
    let data = mut fx.ptr(FW_CFG_DATA)
    return mut self.port_in(mut fx, width: 1, port: data)
} Lowering.fw_cfg_byte

/// A big-endian number of `width` bytes read from the configuration device.
fn Lowering.fw_cfg_number(mut self, mut fx: Fx, width: u64) -> clif::Value {
    var value = mut fx.ptr(0)
    for _ in 0..<width {
        let byte = mut self.fw_cfg_byte(mut fx)
        let shifted = mut fx.b.ishl_imm_s(value, y: 8)
        value = mut fx.b.bor(shifted, y: byte)
    }
    return value
} Lowering.fw_cfg_number
