//! Trap reports: the trap routine walks the frame pointers from the trapping operation, finds each return address in the line tables, and writes at most 15 lines: the kind and location, the source line, the operands, and one line per caller outside std, innermost first. A report is written into a record on the trap routine's stack: its length, then its bytes. The scalar and text routines, and the glue writing values of other types, append to it.

/// The most bytes a report holds.
const REPORT_REPORT: u64 = 4_096

/// The most frames a walk reads.
const REPORT_FRAMES: u64 = 64

/// The most lines a report holds.
const REPORT_LINES: u64 = 15

fn report_define(mut lo: Lowering, mut fx: Fx, routine: Routine) {
    match routine {
        Routine.WriteErr => {
            let params = mut fx.entry()
            expect params.len() > 1
            write_stream(mut lo, mut fx, fd: 2, text: params[0], len: params[1])
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.TrapRaise => report_raise(mut lo, mut fx)
        Routine.ReportScalar => {
            let params = mut fx.entry()
            expect params.len() > 2
            let report = ReportReport(out: params[0])
            report.scalar(mut fx, mut lo, bits: params[1], how: params[2])
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.ReportText => {
            let params = mut fx.entry()
            expect params.len() > 3
            let report = ReportReport(out: params[0])
            report.literal(mut fx, mut lo, start: params[1], len: params[2], bytes: params[3])
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.OverflowRaise => {
            discard mut fx.entry()
            raise_kind(mut lo, mut fx, kind: "trap.stack-overflow")
        }
        Routine.Reacquired => {
            let params = mut fx.entry()
            expect params.len() > 0
            halt(mut lo, mut fx, cause: "lock-reacquired", location: params[0], operand: None)
        }
        else => {
            expect false
        }
    }
} report_define

/// The signature of a glue writing a value in a report: the report and the value's address.
fn writer_signature(alloc: mem::Alloc) -> clif::Signature {
    var signature = clif::Signature.new(CALL_CONV, alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    return signature
} writer_signature

/// A report being written: the address of its record.
struct ReportReport derives Copy {
    out: clif::Value
} ReportReport

/// Appends a byte range, unless the report has no room left for all of it.
fn ReportReport.bytes(self, mut fx: Fx, mut lo: Lowering, text: clif::Value, len: clif::Value) {
    let at = mut fx.load(PTR, addr: self.out, offset: 0)
    let room = mut fx.ptr(REPORT_REPORT)
    let end = mut fx.b.iadd(at, y: len)
    let fits = mut fx.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: end, y: room)
    let out = self.out
    mut fx.if_true(fits, then: fn[mut lo](mut fx1: Fx) {
        let bytes = mut fx1.b.iadd_imm_s(out, y: 8)
        let target = mut fx1.b.iadd(bytes, y: at)
        discard mut lo.call_routine(mut fx1, routine: Routine.Copy, args: fx1.list3(target, b: text, c: len).view())
        mut fx1.store(end, addr: out, offset: 0)
    })
} ReportReport.bytes

fn ReportReport.text(self, mut fx: Fx, mut lo: Lowering, text: Str) {
    let id = mut lo.bytes_data(text.as_bytes())
    let global = mut lo.data_ref(mut fx, id)
    let address = mut fx.b.symbol_value(PTR, global_value: global)
    let len = mut fx.ptr(u64.widen(text.byte_len()))
    self.bytes(mut fx, mut lo, text: address, len)
} ReportReport.text

/// Appends one byte, the low byte of `value`.
fn ReportReport.byte(self, mut fx: Fx, mut lo: Lowering, value: clif::Value) {
    let slot = mut fx.slot(1, align: 1)
    let byte = if fx.b.value_type(value) == clif::Type.Int8 {
        value
    } else {
        mut fx.b.ireduce(clif::Type.Int8, x: value)
    }
    mut fx.store(byte, addr: slot, offset: 0)
    let one = mut fx.ptr(1)
    self.bytes(mut fx, mut lo, text: slot, len: one)
} ReportReport.byte

/// Whether the report has no room left.
fn ReportReport.full(self, mut fx: Fx) -> clif::Value {
    let at = mut fx.load(PTR, addr: self.out, offset: 0)
    return mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: at, y: i64.fit(REPORT_REPORT))
} ReportReport.full

/// Writes an unsigned number in decimal.
fn ReportReport.decimal(self, mut fx: Fx, mut lo: Lowering, value: clif::Value) {
    let digits = mut fx.slot(24, align: 8)
    let end = mut fx.ptr(24)
    let state = mut fx.repeat(fx.list2(value, b: end).view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() > 1
        let rest = current[0]
        let at = current[1]
        let ten = mut fx1.ptr(10)
        let digit = mut fx1.b.urem(rest, y: ten)
        let quotient = mut fx1.b.udiv(rest, y: ten)
        let before = mut fx1.b.iadd_imm_s(at, y: -1)
        let code = mut fx1.b.iadd_imm_s(digit, y: i64.widen(b'0'))
        let ascii = mut fx1.b.ireduce(clif::Type.Int8, x: code)
        let place = mut fx1.b.iadd(digits, y: before)
        mut fx1.store(ascii, addr: place, offset: 0)
        let more = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: quotient, y: 0)
        return Pass(again: more, next: fx1.list2(quotient, b: before))
    })
    let start = mut fx.b.iadd(digits, y: state[1])
    let len = mut fx.b.isub(end, y: state[1])
    self.bytes(mut fx, mut lo, text: start, len)
} ReportReport.decimal

/// Writes a number in uppercase hexadecimal digits: without leading zeros, or with exactly
/// `width` digits.
fn ReportReport.hex(self, mut fx: Fx, mut lo: Lowering, value: clif::Value, width: Option[u64]) {
    let digits = mut fx.slot(16, align: 8)
    let end = mut fx.ptr(16)
    let state = mut fx.repeat(fx.list2(value, b: end).view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() > 1
        let rest = current[0]
        let at = current[1]
        let nibble = mut fx1.b.band_imm_s(rest, y: 0xF)
        let letter = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: nibble, y: 10)
        let digit = mut fx1.b.iadd_imm_s(nibble, y: i64.widen(b'0'))
        let upper = mut fx1.b.iadd_imm_s(nibble, y: i64.widen(b'A') - 10)
        let code = mut fx1.b.select(letter, x: upper, y: digit)
        let ascii = mut fx1.b.ireduce(clif::Type.Int8, x: code)
        let before = mut fx1.b.iadd_imm_s(at, y: -1)
        let place = mut fx1.b.iadd(digits, y: before)
        mut fx1.store(ascii, addr: place, offset: 0)
        let shifted = mut fx1.b.ushr_imm_s(rest, y: 4)
        let more = match width {
            Some(count) => mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThan, x: before, y: 16 - i64.fit(count))
            None => mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: shifted, y: 0)
        }
        return Pass(again: more, next: fx1.list2(shifted, b: before))
    })
    let start = mut fx.b.iadd(digits, y: state[1])
    let len = mut fx.b.isub(end, y: state[1])
    self.bytes(mut fx, mut lo, text: start, len)
} ReportReport.hex

/// Writes a code point of a char or text literal whose quote is `quote`: `\` before the quote
/// and `\`, a char from U+0020 to U+007E as itself, any other as `\u{H}`.
fn ReportReport.code_point(self, mut fx: Fx, mut lo: Lowering, scalar: clif::Value, quote: u8) {
    let is_quote = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: scalar, y: i64.widen(quote))
    let is_slash = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: scalar, y: i64.widen(b'\\'))
    let escaped = mut fx.b.bor(is_quote, y: is_slash)
    mut fx.if_true(escaped, then: fn[mut lo](mut fx1: Fx) {
        self.text(mut fx1, mut lo, text: "\\")
    })
    let low = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: scalar, y: 0x20)
    let high = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThanOrEqual, x: scalar, y: 0x7E)
    let printable = mut fx.b.band(low, y: high)
    mut fx.if_true(printable, then: fn[mut lo](mut fx1: Fx) {
        self.byte(mut fx1, mut lo, value: scalar)
    })
    let unicode = mut fx.b.bxor_imm_s(printable, y: 1)
    mut fx.if_true(unicode, then: fn[mut lo](mut fx1: Fx) {
        self.text(mut fx1, mut lo, text: "\\u{")
        let wide = body_widen(mut fx1, value: scalar)
        self.hex(mut fx1, mut lo, value: wide, width: None)
        self.text(mut fx1, mut lo, text: "}")
    })
} ReportReport.code_point

/// Writes a char as a char literal.
fn ReportReport.char_literal(self, mut fx: Fx, mut lo: Lowering, scalar: clif::Value) {
    self.text(mut fx, mut lo, text: "'")
    self.code_point(mut fx, mut lo, scalar, quote: b'\'')
    self.text(mut fx, mut lo, text: "'")
} ReportReport.char_literal

/// Writes the UTF-8 text of a byte range as a text literal, or its bytes as a byte-string
/// literal when `bytes` is not 0, a byte outside U+0020 to U+007E then written `\xHH`; stops
/// once the report is full.
fn ReportReport.literal(self, mut fx: Fx, mut lo: Lowering, start: clif::Value, len: clif::Value, bytes: clif::Value) {
    let raw = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: bytes, y: 0)
    mut fx.if_true(raw, then: fn[mut lo](mut fx1: Fx) {
        self.text(mut fx1, mut lo, text: "b")
    })
    self.text(mut fx, mut lo, text: "\"")
    let any = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: len, y: 0)
    mut fx.if_true(any, then: fn[mut lo](mut fx1: Fx) {
        let zero = mut fx1.ptr(0)
        discard mut fx1.repeat(fx1.list1(zero).view(), body: fn[mut lo](mut fx2: Fx, state: Slice[clif::Value]) -> Pass {
            expect state.len() > 0
            let at = state[0]
            let place = mut fx2.b.iadd(start, y: at)
            let lead_byte = mut fx2.load(clif::Type.Int8, addr: place, offset: 0)
            let lead = mut fx2.b.uextend(PTR, x: lead_byte)
            let step = mut fx2.choose_in(mut lo, condition: raw, results: fx2.types1(PTR).view(), then: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let low = mut fx3.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: lead, y: 0x20)
                let high = mut fx3.b.icmp_imm_s(clif::IntCC.UnsignedLessThanOrEqual, x: lead, y: 0x7E)
                let printable = mut fx3.b.band(low, y: high)
                discard mut fx3.choose_in(mut lo3, condition: printable, results: mem::List[clif::Type].empty(fx3.alloc).view(), then: fn(mut lo4: Lowering, mut fx4: Fx) -> mem::List[clif::Value] {
                    self.code_point(mut fx4, lo: mut lo4, scalar: lead, quote: b'"')
                    return mem::List[clif::Value].empty(fx4.alloc)
                }, otherwise: fn(mut lo4: Lowering, mut fx4: Fx) -> mem::List[clif::Value] {
                    self.text(mut fx4, lo: mut lo4, text: "\\x")
                    self.hex(mut fx4, lo: mut lo4, value: lead, width: Some(2))
                    return mem::List[clif::Value].empty(fx4.alloc)
                })
                let one = mut fx3.ptr(1)
                return fx3.list1(one)
            }, otherwise: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let decoded = decode_utf8(mut fx3, place, head: lead)
                self.code_point(mut fx3, lo: mut lo3, scalar: decoded.point, quote: b'"')
                return fx3.list1(decoded.len)
            })
            let next = mut fx2.b.iadd(at, y: step[0])
            let inside = mut fx2.b.icmp(clif::IntCC.UnsignedLessThan, x: next, y: len)
            let full = self.full(mut fx2)
            let room = mut fx2.b.bxor_imm_s(full, y: 1)
            let more = mut fx2.b.band(inside, y: room)
            return Pass(again: more, next: fx2.list1(next))
        })
    })
    self.text(mut fx, mut lo, text: "\"")
} ReportReport.literal

/// Writes a float as `Render` writes it, from its bit pattern.
fn ReportReport.float(self, mut fx: Fx, mut lo: Lowering, bits: clif::Value, single: bool) {
    var value = bits
    if single {
        let narrow = mut fx.b.ireduce(clif::Type.Int32, x: bits)
        value = mut fx.b.bitcast(clif::Type.Float32, flags: clif::MemFlags.new(), x: narrow)
    } else {
        value = mut fx.b.bitcast(clif::Type.Float64, flags: clif::MemFlags.new(), x: bits)
    }
    let buffer = mut fx.slot(40, align: 8)
    let name = if single {
        "f32_text"
    } else {
        "f64_text"
    }
    var held = mem::List[Held].empty(fx.alloc)
    mut held.push(Held.Scalar(value))
    mut held.push(Held.Address(buffer))
    let called = mut lo.platform_call(mut fx, name, args: held.view())
    let len = called.result.scalar_value()
    self.bytes(mut fx, mut lo, text: buffer, len)
} ReportReport.float

/// Writes a scalar's bits as its writing says: a number or `bool` as `Render` writes it, a
/// char as a char literal, or `_`.
fn ReportReport.scalar(self, mut fx: Fx, mut lo: Lowering, bits: clif::Value, how: clif::Value) {
    let unsigned = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: how, y: i64.fit(Written.Unsigned.number()))
    mut fx.if_true(unsigned, then: fn[mut lo](mut fx1: Fx) {
        self.decimal(mut fx1, mut lo, value: bits)
    })
    let signed = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: how, y: i64.fit(Written.Signed.number()))
    mut fx.if_true(signed, then: fn[mut lo](mut fx1: Fx) {
        let negative = mut fx1.b.icmp_imm_s(clif::IntCC.SignedLessThan, x: bits, y: 0)
        mut fx1.if_true(negative, then: fn[mut lo](mut fx2: Fx) {
            self.text(mut fx2, mut lo, text: "-")
        })
        let flipped = mut fx1.b.ineg(bits)
        let magnitude = mut fx1.b.select(negative, x: flipped, y: bits)
        self.decimal(mut fx1, mut lo, value: magnitude)
    })
    let boolean = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: how, y: i64.fit(Written.Bool.number()))
    let truth = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: bits, y: 0)
    let true_bool = mut fx.b.band(boolean, y: truth)
    mut fx.if_true(true_bool, then: fn[mut lo](mut fx1: Fx) {
        self.text(mut fx1, mut lo, text: "true")
    })
    let false_bool = mut fx.b.bxor(boolean, y: true_bool)
    mut fx.if_true(false_bool, then: fn[mut lo](mut fx1: Fx) {
        self.text(mut fx1, mut lo, text: "false")
    })
    let character = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: how, y: i64.fit(Written.Char.number()))
    mut fx.if_true(character, then: fn[mut lo](mut fx1: Fx) {
        self.char_literal(mut fx1, mut lo, scalar: bits)
    })
    // The code of a machine target holds no float operation, so no float reaches a report.
    if not lo.machine() {
        let single = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: how, y: i64.fit(Written.Float32.number()))
        mut fx.if_true(single, then: fn[mut lo](mut fx1: Fx) {
            self.float(mut fx1, mut lo, bits, single: true)
        })
        let double = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: how, y: i64.fit(Written.Float64.number()))
        mut fx.if_true(double, then: fn[mut lo](mut fx1: Fx) {
            self.float(mut fx1, mut lo, bits, single: false)
        })
    }
    let hidden = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: how, y: i64.fit(Written.Hidden.number()))
    mut fx.if_true(hidden, then: fn[mut lo](mut fx1: Fx) {
        self.text(mut fx1, mut lo, text: "_")
    })
} ReportReport.scalar

/// Writes the caller line of a location record.
fn ReportReport.caller_line(self, mut fx: Fx, mut lo: Lowering, location: clif::Value) {
    self.text(mut fx, mut lo, text: "    called from ")
    self.location_text(mut fx, mut lo, location, field: 0)
    self.text(mut fx, mut lo, text: ":")
    let line_word = mut fx.load(clif::Type.Int32, addr: location, offset: 24)
    let line = mut fx.b.uextend(PTR, x: line_word)
    self.decimal(mut fx, mut lo, value: line)
    self.text(mut fx, mut lo, text: " in ")
    self.location_text(mut fx, mut lo, location, field: 8)
    self.text(mut fx, mut lo, text: "\n")
} ReportReport.caller_line

/// Writes where a location record lies: ` at ` its path and line, ` in ` its item, then its
/// source line, indented on a line of its own.
fn ReportReport.located(self, mut fx: Fx, mut lo: Lowering, location: clif::Value) {
    self.text(mut fx, mut lo, text: " at ")
    self.location_text(mut fx, mut lo, location, field: 0)
    self.text(mut fx, mut lo, text: ":")
    let line_word = mut fx.load(clif::Type.Int32, addr: location, offset: 24)
    let line = mut fx.b.uextend(PTR, x: line_word)
    self.decimal(mut fx, mut lo, value: line)
    self.text(mut fx, mut lo, text: " in ")
    self.location_text(mut fx, mut lo, location, field: 8)
    self.text(mut fx, mut lo, text: "\n    ")
    self.location_text(mut fx, mut lo, location, field: 16)
    self.text(mut fx, mut lo, text: "\n")
} ReportReport.located

/// Writes the text a location record holds at `field` (path, item or line).
fn ReportReport.location_text(self, mut fx: Fx, mut lo: Lowering, location: clif::Value, field: u64)
    requires field <= 16
{
    let tables = line_tables(mut lo, mut fx)
    let strings = mut fx.load(PTR, addr: tables, offset: 24)
    let offset_word = mut fx.load(clif::Type.Int32, addr: location, offset: field)
    let offset = mut fx.b.uextend(PTR, x: offset_word)
    let len_word = mut fx.load(clif::Type.Int32, addr: location, offset: field + 4)
    let len = mut fx.b.uextend(PTR, x: len_word)
    let start = mut fx.b.iadd(strings, y: offset)
    self.bytes(mut fx, mut lo, text: start, len)
} ReportReport.location_text

/// The code point of a UTF-8 sequence and the sequence's length.
struct Utf8Point derives Copy {
    point: clif::Value
    len: clif::Value
} Utf8Point

/// The code point of the valid UTF-8 sequence whose first byte, `head`, is at `place`, and the
/// sequence's length.
fn decode_utf8(mut fx: Fx, place: clif::Value, head: clif::Value) -> Utf8Point {
    let two = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: head, y: 0xC0)
    let three = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: head, y: 0xE0)
    let four = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: head, y: 0xF0)
    var len = mut fx.ptr(1)
    let longer_than = fx.list3(two, b: three, c: four)
    for longer in longer_than {
        let wide = body_widen(mut fx, value: longer)
        len = mut fx.b.iadd(len, y: wide)
    }
    let length = len
    let points = mut fx.choose(two, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let three_bits = mut fx1.ptr(0x0F)
        let two_bits = mut fx1.ptr(0x1F)
        let short_lead = mut fx1.b.select(three, x: three_bits, y: two_bits)
        let four_bits = mut fx1.ptr(0x07)
        let lead = mut fx1.b.select(four, x: four_bits, y: short_lead)
        var point = mut fx1.b.band(head, y: lead)
        for at in 1u64..<4 {
            let inside = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThan, x: length, y: i64.fit(at))
            let so_far = point
            let joined = mut fx1.choose(inside, results: fx1.types1(PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
                let byte_word = mut fx2.load(clif::Type.Int8, addr: place, offset: at)
                let byte = mut fx2.b.uextend(PTR, x: byte_word)
                let low_bits = mut fx2.b.band_imm_s(byte, y: 0x3F)
                let shifted = mut fx2.b.ishl_imm_s(so_far, y: 6)
                let combined = mut fx2.b.bor(shifted, y: low_bits)
                return fx2.list1(combined)
            }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
                return fx2.list1(so_far)
            })
            point = joined[0]
        }
        return fx1.list1(point)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(head)
    })
    return Utf8Point(point: points[0], len: length)
} decode_utf8

/// The address of the line tables' header.
fn line_tables(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let id = mut lo.lines.table(mut lo.module)
    let global = mut lo.data_ref(mut fx, id)
    return mut fx.b.symbol_value(PTR, global_value: global)
} line_tables

/// The location record of a code address and whether its function's frames are left out.
struct CodeLocation derives Copy {
    location: clif::Value
    hidden: clif::Value
} CodeLocation

/// The location record of a code address and whether its function's frames are left out, or
/// a zero location for an address no lowered function holds.
fn lookup(mut lo: Lowering, mut fx: Fx, address: clif::Value) -> CodeLocation {
    let tables = line_tables(mut lo, mut fx)
    let functions = mut fx.load(PTR, addr: tables, offset: 0)
    let entries = mut fx.load(PTR, addr: tables, offset: 8)
    let locations = mut fx.load(PTR, addr: tables, offset: 16)
    let count_word = mut fx.load(clif::Type.Int32, addr: tables, offset: 32)
    let count = mut fx.b.uextend(PTR, x: count_word)
    let zero = mut fx.ptr(0)
    let found = mut fx.repeat(fx.list3(zero, b: zero, c: zero).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 2
        let index = state[0]
        let location = state[1]
        let hidden = state[2]
        let record_offset = mut fx1.b.imul_imm_s(index, y: i64.fit(FUNCTION_RECORD))
        let record = mut fx1.b.iadd(functions, y: record_offset)
        let start = mut fx1.load(PTR, addr: record, offset: 0)
        let size_word = mut fx1.load(clif::Type.Int32, addr: record, offset: 8)
        let size = mut fx1.b.uextend(PTR, x: size_word)
        let offset = mut fx1.b.isub(address, y: start)
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: offset, y: size)
        let result = mut fx1.choose(inside, results: fx1.types3(PTR, b: PTR, c: clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let first_word = mut fx2.load(clif::Type.Int32, addr: record, offset: 12)
            let first_entry = mut fx2.b.uextend(PTR, x: first_word)
            let entries_word = mut fx2.load(clif::Type.Int32, addr: record, offset: 16)
            let entries_count = mut fx2.b.uextend(PTR, x: entries_word)
            let flags = mut fx2.load(clif::Type.Int32, addr: record, offset: 20)
            let hidden_flag = mut fx2.b.band_imm_s(flags, y: i64.widen(LINES_HIDDEN))
            let hidden_word = mut fx2.b.uextend(PTR, x: hidden_flag)
            let pc = mut fx2.b.iadd_imm_s(offset, y: -1)
            let none = mut fx2.ptr(0)
            let best = mut fx2.repeat(fx2.list2(none, b: none).view(), body: fn(mut fx3: Fx, scan: Slice[clif::Value]) -> Pass {
                expect scan.len() > 1
                let at = scan[0]
                let best_so_far = scan[1]
                let entry_index = mut fx3.b.iadd(first_entry, y: at)
                let entry_offset = mut fx3.b.imul_imm_s(entry_index, y: i64.fit(LINES_ENTRY_RECORD))
                let entry = mut fx3.b.iadd(entries, y: entry_offset)
                let code_word = mut fx3.load(clif::Type.Int32, addr: entry, offset: 0)
                let code = mut fx3.b.uextend(PTR, x: code_word)
                let number_word = mut fx3.load(clif::Type.Int32, addr: entry, offset: 4)
                let number = mut fx3.b.uextend(PTR, x: number_word)
                let covers = mut fx3.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: code, y: pc)
                let chosen = mut fx3.b.select(covers, x: number, y: best_so_far)
                let next = mut fx3.b.iadd_imm_s(at, y: 1)
                let more = mut fx3.b.icmp(clif::IntCC.UnsignedLessThan, x: next, y: entries_count)
                return Pass(again: more, next: fx3.list2(next, b: chosen))
            })
            let found_location = report_location_record(mut fx2, locations, number: best[1])
            let stop = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list3(found_location, b: hidden_word, c: stop)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let go = mut fx2.int(clif::Type.Int8, value: 1)
            return fx2.list3(location, b: hidden, c: go)
        })
        let next = mut fx1.b.iadd_imm_s(index, y: 1)
        let more_functions = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: next, y: count)
        let again = mut fx1.b.band(result[2], y: more_functions)
        return Pass(again: again, next: fx1.list3(next, b: result[0], c: result[1]))
    })
    return CodeLocation(location: found[1], hidden: found[2])
} lookup

/// The start of the lowered function holding a code address, and its flags.
struct CodeFunction derives Copy {
    start: clif::Value
    flags: clif::Value
} CodeFunction

/// The start of the lowered function holding a code address and its flags, or zeros for an
/// address outside lowered code.
fn function_at(mut lo: Lowering, mut fx: Fx, address: clif::Value) -> CodeFunction {
    let tables = line_tables(mut lo, mut fx)
    let functions = mut fx.load(PTR, addr: tables, offset: 0)
    let count_word = mut fx.load(clif::Type.Int32, addr: tables, offset: 32)
    let count = mut fx.b.uextend(PTR, x: count_word)
    let zero = mut fx.ptr(0)
    let found = mut fx.repeat(fx.list3(zero, b: zero, c: zero).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 2
        let index = state[0]
        let found_start = state[1]
        let found_flags = state[2]
        let offset = mut fx1.b.imul_imm_s(index, y: i64.fit(FUNCTION_RECORD))
        let record = mut fx1.b.iadd(functions, y: offset)
        let start = mut fx1.load(PTR, addr: record, offset: 0)
        let size_word = mut fx1.load(clif::Type.Int32, addr: record, offset: 8)
        let size = mut fx1.b.uextend(PTR, x: size_word)
        let from_start = mut fx1.b.isub(address, y: start)
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: from_start, y: size)
        let flags_word = mut fx1.load(clif::Type.Int32, addr: record, offset: 20)
        let flags = mut fx1.b.uextend(PTR, x: flags_word)
        let start_now = mut fx1.b.select(inside, x: start, y: found_start)
        let flags_now = mut fx1.b.select(inside, x: flags, y: found_flags)
        let next = mut fx1.b.iadd_imm_s(index, y: 1)
        let more = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: next, y: count)
        let missing = mut fx1.b.bxor_imm_s(inside, y: 1)
        let again = mut fx1.b.band(more, y: missing)
        return Pass(again: again, next: fx1.list3(next, b: start_now, c: flags_now))
    })
    return CodeFunction(start: found[1], flags: found[2])
} function_at

/// The address of the location record numbered `number`, or zero for number 0.
fn report_location_record(mut fx: Fx, locations: clif::Value, number: clif::Value) -> clif::Value {
    let has = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: number, y: 0)
    let index = mut fx.b.iadd_imm_s(number, y: -1)
    let offset = mut fx.b.imul_imm_s(index, y: i64.fit(LOCATION_RECORD))
    let location = mut fx.b.iadd(locations, y: offset)
    let zero = mut fx.ptr(0)
    return mut fx.b.select(has, x: location, y: zero)
} report_location_record

/// The address of the slot of frame `index` among the frames a walk recorded.
fn frame_slot(mut fx: Fx, frames: clif::Value, index: clif::Value) -> clif::Value {
    let offset = mut fx.b.imul_imm_s(index, y: 16)
    return mut fx.b.iadd(frames, y: offset)
} frame_slot

/// A recorded frame's location record, and whether its line is shown: its location is known and
/// its function's frames are not left out.
struct ShownFrame derives Copy {
    location: clif::Value
    shown: clif::Value
} ShownFrame

/// The location record of recorded frame `index`, and whether its line is shown.
fn shown_frame(mut fx: Fx, frames: clif::Value, index: clif::Value) -> ShownFrame {
    let slot = frame_slot(mut fx, frames, index)
    let location = mut fx.load(PTR, addr: slot, offset: 0)
    let hidden = mut fx.load(PTR, addr: slot, offset: 8)
    let visible = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: hidden, y: 0)
    let known = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: location, y: 0)
    let shown = mut fx.b.band(visible, y: known)
    return ShownFrame(location: location, shown: shown)
} shown_frame

/// `TrapRaise(kind, operands, count, caller)`: writes the report of a trap of the running task,
/// the location numbered `caller` its first caller line when not 0, and its replay token in a
/// test image, and ends the process domain with status 70.
fn report_raise(mut lo: Lowering, mut fx: Fx)
    waive length "one routine writing the report's lines in order, as the Rust writes them"
{
    let params = mut fx.entry()
    expect params.len() > 3
    let kind = params[0]
    let operands = params[1]
    let count = params[2]
    let caller = params[3]
    let frames = mut fx.slot(REPORT_FRAMES * 16, align: 8)
    let frame_pointer = mut fx.b.get_frame_pointer(PTR)
    let zero = mut fx.ptr(0)
    let walk = mut fx.repeat(fx.list5(frame_pointer, b: zero, c: zero, d: zero, e: zero).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 4
        let frame = state[0]
        let at = state[1]
        let beyond = state[2]
        let beyond_known = state[3]
        let any_shown = state[4]
        let return_address = mut fx1.load(PTR, addr: frame, offset: 8)
        let looked_up = lookup(mut lo, fx: mut fx1, address: return_address)
        let room = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: at, y: i64.fit(REPORT_FRAMES))
        mut fx1.if_true(room, then: fn(mut fx2: Fx) {
            let slot_offset = mut fx2.b.imul_imm_s(at, y: 16)
            let slot = mut fx2.b.iadd(frames, y: slot_offset)
            mut fx2.store(looked_up.location, addr: slot, offset: 0)
            mut fx2.store(looked_up.hidden, addr: slot, offset: 8)
        })
        let known = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: looked_up.location, y: 0)
        let visible = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: looked_up.hidden, y: 0)
        let shown = mut fx1.b.band(visible, y: known)
        let full = mut fx1.b.bxor_imm_s(room, y: 1)
        let counted = mut fx1.b.band(shown, y: full)
        let counted_word = mut fx1.b.uextend(PTR, x: counted)
        let beyond_now = mut fx1.b.iadd(beyond, y: counted_word)
        let counted_known = mut fx1.b.band(known, y: full)
        let counted_known_word = mut fx1.b.uextend(PTR, x: counted_known)
        let beyond_known_now = mut fx1.b.iadd(beyond_known, y: counted_known_word)
        let shown_word = mut fx1.b.uextend(PTR, x: shown)
        let any_shown_now = mut fx1.b.bor(any_shown, y: shown_word)
        let stored = mut fx1.b.uextend(PTR, x: room)
        let at_now = mut fx1.b.iadd(at, y: stored)
        let caller_frame = mut fx1.load(PTR, addr: frame, offset: 0)
        let has_caller = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: caller_frame, y: 0)
        let more = mut fx1.b.band(known, y: has_caller)
        return Pass(again: more, next: fx1.list5(caller_frame, b: at_now, c: beyond_now, d: beyond_known_now, e: any_shown_now))
    })
    let beyond_shown = walk[2]
    let beyond_known = walk[3]
    let walked = walk[1]
    let any_shown = walk[4]
    let all_std = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: any_shown, y: 0)
    let beyond = mut fx.b.select(all_std, x: beyond_known, y: beyond_shown)
    mut fx.if_true(all_std, then: fn(mut fx1: Fx) {
        let first_frame = mut fx1.ptr(0)
        mut fx1.each(first_frame, end: walked, body: fn(mut fx2: Fx, index: clif::Value) {
            let slot = frame_slot(mut fx2, frames, index)
            let cleared = mut fx2.ptr(0)
            mut fx2.store(cleared, addr: slot, offset: 8)
        })
    })
    let visible = mut fx.repeat(fx.list1(zero).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 0
        let index = state[0]
        let slot = frame_slot(mut fx1, frames, index)
        let location = mut fx1.load(PTR, addr: slot, offset: 0)
        let hidden_word = mut fx1.load(PTR, addr: slot, offset: 8)
        let hidden = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: hidden_word, y: 0)
        let unknown = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: location, y: 0)
        let skip = mut fx1.b.bor(hidden, y: unknown)
        let next = mut fx1.b.iadd_imm_s(index, y: 1)
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: next, y: walked)
        let again = mut fx1.b.band(skip, y: inside)
        let chosen = mut fx1.b.select(again, x: next, y: index)
        return Pass(again: again, next: fx1.list1(chosen))
    })
    let first_visible = visible[0]
    let out = mut fx.slot(8 + REPORT_REPORT, align: 8)
    mut fx.store(zero, addr: out, offset: 0)
    let report = ReportReport(out: out)
    let kinds = mut lo.kind_names(mut fx)
    let kind_offset = mut fx.b.imul_imm_s(kind, y: 16)
    let kind_record = mut fx.b.iadd(kinds, y: kind_offset)
    let kind_text = mut fx.load(PTR, addr: kind_record, offset: 0)
    let kind_len = mut fx.load(PTR, addr: kind_record, offset: 8)
    report.bytes(mut fx, mut lo, text: kind_text, len: kind_len)
    let slot = frame_slot(mut fx, frames, index: first_visible)
    let location = mut fx.load(PTR, addr: slot, offset: 0)
    report.located(mut fx, mut lo, location)
    let own = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: first_visible, y: 0)
    let shown = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: count, y: 0)
    let show = mut fx.b.band(own, y: shown)
    let lines = mut fx.b.declare_var(PTR)
    let two = mut fx.ptr(2)
    mut fx.b.def_var(lines, val: two)
    mut fx.if_true(show, then: fn[mut lo](mut fx1: Fx) {
        report.text(mut fx1, mut lo, text: "    ")
        let first_operand = mut fx1.ptr(0)
        mut fx1.each(first_operand, end: count, body: fn[mut lo](mut fx2: Fx, index: clif::Value) {
            write_operand(mut lo, fx: mut fx2, report, operands, index)
        })
        report.text(mut fx1, mut lo, text: "\n")
        let three = mut fx1.ptr(3)
        mut fx1.b.def_var(lines, val: three)
    })
    let named = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: caller, y: 0)
    mut fx.if_true(named, then: fn[mut lo](mut fx1: Fx) {
        let tables = line_tables(mut lo, fx: mut fx1)
        let locations = mut fx1.load(PTR, addr: tables, offset: 16)
        let caller_location_record = report_location_record(mut fx1, locations, number: caller)
        report.caller_line(mut fx1, mut lo, location: caller_location_record)
        let written = mut fx1.b.use_var(lines)
        let next = mut fx1.b.iadd_imm_s(written, y: 1)
        mut fx1.b.def_var(lines, val: next)
    })
    let start = mut fx.b.iadd_imm_s(first_visible, y: 1)
    let callers = mut fx.b.declare_var(PTR)
    mut fx.b.def_var(callers, val: beyond)
    mut fx.each(start, end: walked, body: fn(mut fx1: Fx, index: clif::Value) {
        let frame = shown_frame(mut fx1, frames, index)
        let shown_word = mut fx1.b.uextend(PTR, x: frame.shown)
        let counted = mut fx1.b.use_var(callers)
        let more = mut fx1.b.iadd(counted, y: shown_word)
        mut fx1.b.def_var(callers, val: more)
    })
    let caller_count = mut fx.b.use_var(callers)
    let written = mut fx.b.use_var(lines)
    let replayed = lo.seeded()
    let line_budget = if replayed {
        REPORT_LINES - 1
    } else {
        REPORT_LINES
    }
    let budget = mut fx.ptr(line_budget)
    let left = mut fx.b.isub(budget, y: written)
    let elided = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: caller_count, y: left)
    let fewer = mut fx.b.iadd_imm_s(left, y: -1)
    let limit = mut fx.b.select(elided, x: fewer, y: left)
    let written_callers = mut fx.b.declare_var(PTR)
    let none = mut fx.ptr(0)
    mut fx.b.def_var(written_callers, val: none)
    mut fx.each(start, end: walked, body: fn[mut lo](mut fx1: Fx, index: clif::Value) {
        let frame = shown_frame(mut fx1, frames, index)
        let so_far = mut fx1.b.use_var(written_callers)
        let room = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: so_far, y: limit)
        let shown_here = mut fx1.b.band(frame.shown, y: room)
        mut fx1.if_true(shown_here, then: fn[mut lo](mut fx2: Fx) {
            report.caller_line(mut fx2, mut lo, location: frame.location)
            let next = mut fx2.b.iadd_imm_s(so_far, y: 1)
            mut fx2.b.def_var(written_callers, val: next)
        })
    })
    mut fx.if_true(elided, then: fn[mut lo](mut fx1: Fx) {
        report.text(mut fx1, mut lo, text: "    called from ")
        let left_out = mut fx1.b.isub(caller_count, y: limit)
        report.decimal(mut fx1, mut lo, value: left_out)
        report.text(mut fx1, mut lo, text: " more frames\n")
    })
    if replayed {
        let token = test_image_token(mut lo, mut fx)
        report.text(mut fx, mut lo, text: "    replay ")
        report.bytes(mut fx, mut lo, text: token.start, len: token.len)
        report.text(mut fx, mut lo, text: "\n")
    }
    let task = current_task(mut lo, mut fx)
    let domain = current_domain(mut lo, mut fx)
    let state_address = mut lo.state(mut fx)
    let process = mut fx.load(PTR, addr: state_address, offset: STATE_PROCESS)
    let inside = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: task, y: 0)
    let nested = mut fx.b.icmp(clif::IntCC.NotEqual, x: domain, y: process)
    let contained = mut fx.b.band(inside, y: nested)
    mut fx.if_true(contained, then: fn[mut lo](mut fx1: Fx) {
        report_abandon(mut lo, fx: mut fx1, task, domain, kind, out)
    })
    end_with(mut lo, mut fx, report)
} report_raise

/// Writes operand `index` of a trap's operand records into its report: its source text, ` = `
/// and its value, by its glue or as a scalar; `, ` before every operand but the first.
fn write_operand(mut lo: Lowering, mut fx: Fx, report: ReportReport, operands: clif::Value, index: clif::Value) {
    let not_first = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: index, y: 0)
    mut fx.if_true(not_first, then: fn[mut lo](mut fx1: Fx) {
        report.text(mut fx1, mut lo, text: ", ")
    })
    let offset = mut fx.b.imul_imm_s(index, y: i64.fit(OPERAND_RECORD))
    let record = mut fx.b.iadd(operands, y: offset)
    let source = mut fx.load(PTR, addr: record, offset: 0)
    let source_len = mut fx.load(PTR, addr: record, offset: 8)
    report.bytes(mut fx, mut lo, text: source, len: source_len)
    report.text(mut fx, mut lo, text: " = ")
    let bits = mut fx.load(PTR, addr: record, offset: 16)
    let how = mut fx.load(PTR, addr: record, offset: 24)
    let writer = mut fx.load(PTR, addr: record, offset: 32)
    let glued = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: writer, y: 0)
    let out = report.out
    discard mut fx.choose_in(mut lo, condition: glued, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let signature = mut fx1.b.import_signature(writer_signature(fx1.alloc))
        discard mut fx1.b.call_indirect(signature, callee: writer, args: fx1.list2(out, b: bits).view())
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        discard mut lo1.call_routine(mut fx1, routine: Routine.ReportScalar, args: fx1.list3(out, b: bits, c: how).view())
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} write_operand

/// Ends the process, or halts a machine's kernel, with a report written: a kernel first stops
/// its other CPUs, and on a machine target the serial port is programmed again, as code may
/// have reprogrammed it.
fn end_with(mut lo: Lowering, mut fx: Fx, report: ReportReport) {
    if lo.kernel() {
        mut lo.stop_other_cpus(mut fx)
    }
    if lo.machine() {
        mut lo.serial_init(mut fx)
    }
    let bytes = mut fx.b.iadd_imm_s(report.out, y: 8)
    let length = mut fx.load(PTR, addr: report.out, offset: 0)
    discard mut lo.call_routine(mut fx, routine: Routine.WriteErr, args: fx.list2(bytes, b: length).view())
    let status = mut fx.ptr(70)
    discard mut lo.call_routine(mut fx, routine: Routine.Exit, args: fx.list1(status).view())
    mut fx.b.trap(clif::TrapCode(user: 1))
} end_with

/// The location record of the call of the running function, from its return address.
fn caller_location(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let frame = mut fx.b.get_frame_pointer(PTR)
    let address = mut fx.load(PTR, addr: frame, offset: 8)
    return location_at(mut lo, mut fx, address)
} caller_location

/// The location record of a code address, zero for an address no lowered function holds.
fn location_at(mut lo: Lowering, mut fx: Fx, address: clif::Value) -> clif::Value {
    let found = lookup(mut lo, mut fx, address)
    return found.location
} location_at

/// An operand a halt report writes: its name and its value.
view struct HaltOperand {
    name: Str
    value: clif::Value
} HaltOperand

/// Halts the kernel for a cause at a location record: writes the halt report, which has the
/// form of a trap report with `halt` and the cause in place of the trap kind and, given an
/// operand, its line, then ends the machine with status 70.
fn halt(mut lo: Lowering, mut fx: Fx, cause: Str, location: clif::Value, operand: Option[HaltOperand]) {
    let out = mut fx.slot(8 + REPORT_REPORT, align: 8)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: out, offset: 0)
    let report = ReportReport(out: out)
    report.text(mut fx, mut lo, text: "halt ")
    report.text(mut fx, mut lo, text: cause)
    let known = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: location, y: 0)
    discard mut fx.choose_in(mut lo, condition: known, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        report.located(mut fx1, lo: mut lo1, location)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        report.text(mut fx1, lo: mut lo1, text: "\n")
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    match operand {
        Some(given) => {
            report.text(mut fx, mut lo, text: "    ")
            report.text(mut fx, mut lo, text: given.name)
            report.text(mut fx, mut lo, text: " = ")
            report.decimal(mut fx, mut lo, value: given.value)
            report.text(mut fx, mut lo, text: "\n")
        }
        None => {}
    }
    end_with(mut lo, mut fx, report)
} halt

/// Abandons the `sys::Domain` body domain of a trapping task: the first trap of the domain
/// writes its report into the domain's trap record and wakes the task waiting for the domain,
/// which settles it; the trapping task releases the locks its thread holds for it and stops.
fn report_abandon(mut lo: Lowering, mut fx: Fx, task: clif::Value, domain: clif::Value, kind: clif::Value, out: clif::Value) {
    let flag = mut fx.offset(domain, offset: DOMAIN_ABANDONED)
    let zero = mut fx.ptr(0)
    let one = mut fx.ptr(1)
    let seen = mut fx.b.atomic_cas(clif::MemFlags.owned(), p: flag, e: zero, x: one)
    let first_trap = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: seen, y: 0)
    mut fx.if_true(first_trap, then: fn[mut lo](mut fx1: Fx) {
        let record = mut fx1.load(PTR, addr: domain, offset: DOMAIN_TRAP)
        mut fx1.store(kind, addr: record, offset: TRAP_RECORD_KIND)
        let len = mut fx1.load(PTR, addr: out, offset: 0)
        mut fx1.store(len, addr: record, offset: TRAP_RECORD_LEN)
        let target = mut fx1.offset(record, offset: TRAP_RECORD_BYTES)
        let bytes = mut fx1.b.iadd_imm_s(out, y: 8)
        discard mut lo.call_routine(mut fx1, routine: Routine.Copy, args: fx1.list3(target, b: bytes, c: len).view())
        let lock = mut fx1.offset(domain, offset: DOMAIN_LOCK)
        discard mut lo.call_routine(mut fx1, routine: Routine.Lock, args: fx1.list1(lock).view())
        let waiter = mut fx1.load(PTR, addr: domain, offset: DOMAIN_WAITER)
        discard mut lo.call_routine(mut fx1, routine: Routine.Unlock, args: fx1.list1(lock).view())
        discard mut lo.call_routine(mut fx1, routine: Routine.Wake, args: fx1.list1(waiter).view())
    })
    locks_release_held(mut lo, mut fx)
    stop_running(mut lo, mut fx, record: task)
} report_abandon

/// Traps with a kind and no operands, from code lowering writes itself.
fn raise_kind(mut lo: Lowering, mut fx: Fx, kind: Str) {
    let number = mut fx.ptr(u64.fit(kind_number(kind)))
    let zero = mut fx.ptr(0)
    discard mut lo.call_routine(mut fx, routine: Routine.TrapRaise, args: fx.list4(number, b: zero, c: zero, d: zero).view())
    mut fx.b.trap(clif::TrapCode(user: 1))
} raise_kind

/// The address of the table of trap kind names: each the address and length of its text.
fn Lowering.kind_names(mut self, mut fx: Fx) -> clif::Value {
    var names = text::String.empty(self.alloc)
    var record = mem::Bytes.empty(self.alloc)
    var relocations = mem::List[Relocation].empty(self.alloc)
    var at: u64 = 0
    var index: u32 = 0
    let kinds = TRAP_KINDS.as_bytes()
    var start: usize = 0
    for position in 0..=kinds.len() {
        if position < kinds.len() and kinds[position] != b' ' {
            continue
        }
        let Some(kind) = TRAP_KINDS.slice_bytes(start, end: position) else {
            break
        }
        mut names.append(kind)
        mut relocations.push(Relocation(offset: index * 16, addend: at))
        object::append_u64(mut record, value: 0)
        object::append_u64(mut record, value: u64.widen(kind.byte_len()))
        at += u64.widen(kind.byte_len())
        index += 1
        start = position + 1
    }
    let strings = mut self.bytes_data(names.as_str().as_bytes())
    let id = mut self.relocated_data("kinds", contents: take record, relocations: relocations.view(), target: strings)
    let global = mut self.data_ref(mut fx, id)
    return mut fx.b.symbol_value(PTR, global_value: global)
} Lowering.kind_names
