pub open struct Signal[T: Send] {
} Signal

pub fn Signal.empty() -> Signal[T] limits pure, notrap, terminates

pub fn Signal.post(self, t: IrqsDisabled, take value: T) limits notrap, terminates, noalloc

pub fn Signal.wait(self) -> T fails task::Cancelled uses wait

test empty_signal_holds_no_value for Signal.empty {
    let signal = Signal[u32].empty()
    let outcome = try await task::within(testing::world().clock, ms: 10, body: fn() -> u32 fails task::Cancelled uses wait {
        return try await signal.wait()
    })
    expect outcome == None
} empty_signal_holds_no_value

test post_replaces_a_stored_value for Signal.post {
    let signal = Signal[u32].empty()
    without_irqs(fn(t: IrqsDisabled) {
        signal.post(t, value: 1)
        signal.post(t, value: 2)
    })
    let value = try await signal.wait()
    expect value == 2
} post_replaces_a_stored_value

test wait_takes_the_stored_value for Signal.wait {
    let world = testing::world()
    let signal = Signal[u32].empty()
    without_irqs(fn(t: IrqsDisabled) => signal.post(t, value: 4))
    let value = try await signal.wait()
    expect value == 4
    let again = try await task::within(world.clock, ms: 10, body: fn() -> u32 fails task::Cancelled uses wait {
        return try await signal.wait()
    })
    expect again == None
} wait_takes_the_stored_value

pub open struct SpinLock[T: Send] {
} SpinLock

pub fn SpinLock.of(take value: T) -> SpinLock[T] limits notrap, terminates, noalloc
    example without_irqs(fn(t: IrqsDisabled) => SpinLock.of(5u64).with(t, body: fn(mut held: u64) => held)) == 5

pub fn SpinLock.with[R: Any](self, t: IrqsDisabled, body: fn(mut value: T) -> R limits notrap, terminates, noalloc) -> R limits notrap, terminates, noalloc

test with_keeps_changes_for_the_next_holder for SpinLock.with {
    let lock = SpinLock.of(5u64)
    let value = without_irqs(fn(t: IrqsDisabled) -> u64 {
        lock.with(t, body: fn(mut held: u64) {
            held = held.wrapping_add(1)
        })
        return lock.with(t, body: fn(mut held: u64) => held)
    })
    expect value == 6
} with_keeps_changes_for_the_next_holder

