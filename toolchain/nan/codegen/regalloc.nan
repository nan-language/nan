//! Register allocation: a linear scan over the live intervals that keeps each virtual register in one physical register, or in one spill slot, for all its life, spilling the interval whose accesses weigh least, an access in a loop weighing more; a register a call clobbers holds an interval across calls when saving it to a slot before each and loading it after weighs less.

/// Where register allocation puts each virtual register, and what the frame must hold for it.
struct Allocation {
    /// Each virtual register's physical register, `NO_REG` when it lives in a spill slot.
    regs: mem::List[machinst::Reg]
    /// The slot of each virtual register spilled or saved across calls, `NONE` for the others.
    slots: mem::List[u32]
    /// The registers saved before a call and loaded after it, in the order of the calls.
    saves: mem::List[Save]
    slot_count: u32
    /// The callee-saved registers the code changes.
    saved: machinst::RegSet
} Allocation

/// A register a call at an instruction index clobbers that holds a virtual register's value
/// across the call.
struct Save derives Copy, Eq {
    at: u32
    reg: machinst::Reg
    vreg: u32
} Save

/// The state of the scan: the virtual register holding each physical register, and per physical
/// register the first of its fixed ranges not yet behind the scan; the weight of each virtual
/// register's accesses and of each instruction's position, and whether each virtual register is
/// saved across the calls in its interval.
struct Scan {
    allocatable: machinst::RegSet
    holders: Array[u32, REG_COUNT]
    cursors: Array[u32, REG_COUNT]
    regs: mem::List[machinst::Reg]
    spilled: mem::List[u32]
    weights: mem::List[u64]
    factors: mem::List[u64]
    saved: mem::List[bool]
} Scan

fn allocate[I: machinst::MachInst and Copy](code: VCode[I], alloc: mem::Alloc) -> Allocation {
    let live = Liveness.of(code, alloc)
    let count = usize.widen(code.vreg_count())
    let factors = position_factors(code, alloc)
    var scan = Scan(allocatable: code.allocatable(), holders: Array[u32, REG_COUNT].filled(NONE), cursors: Array[u32, REG_COUNT].filled(0), regs: filled(count, value: NO_REG, alloc), spilled: mem::List[u32].empty(alloc), weights: access_weights(code, factors: factors.view(), alloc), factors: take factors, saved: filled(count, value: false, alloc))
    for index in 0..<REG_COUNT {
        scan.cursors[index] = live.fixed_at[index]
    }
    var order = mem::List[u32].empty(alloc)
    expect live.starts.len() == count
    for vreg in 0..<count {
        if live.starts[vreg] != NONE {
            mut order.push(u32.fit(vreg))
        }
    }
    mut order.sort_by(fn(left: u32, right: u32) -> core::Ordering {
        let left_start = live.start_of(left)
        let right_start = live.start_of(right)
        if left_start != right_start {
            return left_start.cmp(right_start)
        }
        return left.cmp(right)
    })
    for vreg in order {
        mut scan.place(code, live, vreg)
    }
    return take scan.finish(code, live, alloc)
} allocate

/// Gives a virtual register a free register, its hint's first; or, when none is free, a register
/// only calls clobber in its interval, saved across them, when that weighs less than spilling;
/// or else the register of the interval whose accesses weigh least, spilling that interval or
/// this one, the one ending last among equal weights.
fn Scan.place[I: machinst::MachInst and Copy](mut self, code: VCode[I], live: Liveness, vreg: u32) {
    let at = usize.widen(vreg)
    let start = live.start_of(vreg)
    let end = live.end_of(vreg)
    for index in 0..<REG_COUNT {
        let holder = self.holders[index]
        if holder != NONE and live.end_of(holder) < start {
            self.holders[index] = NONE
        }
    }
    expect at < code.floats.len() and at < code.hints.len()
    let float = code.floats[at]
    let preferred = self.preferred(code, vreg)
    if preferred != NO_REG and self.allocatable.contains(preferred) and I.is_float(preferred) == float and mut self.is_free(live, reg: preferred, start, end) {
        mut self.assign(vreg, reg: preferred)
        return
    }
    for index in 0u32..<I.class_size(float) {
        let reg = I.class_reg(float, index: index)
        if mut self.is_free(live, reg, start, end) {
            mut self.assign(vreg, reg)
            return
        }
    }
    var victim = NO_REG
    var lightest = self.weight(vreg)
    var furthest = end
    var across = NO_REG
    var cheapest = lightest
    for index in 0u32..<I.class_size(float) {
        let reg = I.class_reg(float, index: index)
        if self.holders[usize.widen(reg.index)] != NONE {
            continue
        }
        match mut self.save_cost(live, reg, start, end) {
            Some(cost) => {
                if cost < cheapest {
                    across = reg
                    cheapest = cost
                }
            }
            None => {}
        }
    }
    if across != NO_REG {
        expect at < self.saved.len()
        self.saved[at] = true
        mut self.assign(vreg, reg: across)
        return
    }
    for index in 0u32..<I.class_size(float) {
        let reg = I.class_reg(float, index: index)
        let holder = self.holders[usize.widen(reg.index)]
        if holder == NONE {
            continue
        }
        let weight = self.weight(holder)
        let lighter = weight < lightest or (weight == lightest and live.end_of(holder) > furthest)
        if lighter and mut self.is_clear(live, reg, start, end) {
            victim = reg
            lightest = weight
            furthest = live.end_of(holder)
        }
    }
    if victim == NO_REG {
        mut self.spilled.push(vreg)
        return
    }
    expect victim.is_physical()
    let evicted = self.holders[usize.widen(victim.index)]
    expect usize.widen(evicted) < self.regs.len() and usize.widen(evicted) < self.saved.len()
    self.regs[usize.widen(evicted)] = NO_REG
    self.saved[usize.widen(evicted)] = false
    mut self.spilled.push(evicted)
    mut self.assign(vreg, reg: victim)
} Scan.place

fn Scan.weight(self, vreg: u32) -> u64 {
    let at = usize.widen(vreg)
    expect at < self.weights.len()
    return self.weights[at]
} Scan.weight

/// The deepest loop nesting whose accesses weigh more.
const LOOP_DEPTH: u32 = 4

/// The weight of an access at each instruction index: 1, times 8 for each loop holding it, a loop
/// being the blocks from a jump's target to the jump in emission order.
fn position_factors[I: machinst::MachInst and Copy](code: VCode[I], alloc: mem::Alloc) -> mem::List[u64] {
    let count = code.blocks.len()
    var opened = filled(count + 1, value: 0u32, alloc)
    var closed = filled(count + 1, value: 0u32, alloc)
    for index in 0..<count {
        for succ in code.block_succs(code.blocks[index]) {
            let target = usize.widen(succ)
            if target <= index {
                expect target < opened.len() and index + 1 < closed.len()
                opened[target] += 1
                closed[index + 1] += 1
            }
        }
    }
    var factors = filled(code.insts.len(), value: 1u64, alloc)
    var depth: u32 = 0
    for index in 0..<count {
        expect index < opened.len() and index < closed.len()
        depth = depth.saturating_add(opened[index]).saturating_sub(closed[index])
        var factor: u64 = 1
        var nesting: u32 = 0
        while nesting < depth and nesting < LOOP_DEPTH {
            factor *= 8
            nesting += 1
        }
        let block = code.blocks[index]
        expect code.holds(block)
        for at in block.begin..<block.end {
            expect usize.widen(at) < factors.len()
            factors[usize.widen(at)] = factor
        }
    }
    return factors
} position_factors

/// The weight of each virtual register's accesses, each weighing its instruction's factor.
fn access_weights[I: machinst::MachInst and Copy](code: VCode[I], factors: Slice[u64], alloc: mem::Alloc) -> mem::List[u64] {
    var weights = filled(code.floats.len(), value: 0u64, alloc)
    for block in code.blocks {
        expect code.holds(block)
        for at in block.begin..<block.end {
            expect usize.widen(at) < factors.len()
            let factor = factors[usize.widen(at)]
            discard code.insts[usize.widen(at)].inst.map_regs(fn[mut weights](reg: machinst::Reg, role: machinst::Role) -> machinst::Reg {
                if reg.is_virtual() {
                    let held = usize.widen(reg.vreg())
                    expect held < weights.len()
                    weights[held] = weights[held].saturating_add(factor)
                }
                return reg
            })
        }
        let jump = usize.widen(block.end - 1)
        expect jump < factors.len()
        for arg in code.block_args(block) {
            if arg.is_virtual() {
                let held = usize.widen(arg.vreg())
                expect held < weights.len()
                weights[held] = weights[held].saturating_add(factors[jump])
            }
        }
    }
    return weights
} access_weights

/// The register a virtual register's hint names, when it names one yet.
fn Scan.preferred[I: machinst::MachInst and Copy](self, code: VCode[I], vreg: u32) -> machinst::Reg
    requires usize.widen(vreg) < code.hints.len()
{
    let hint = code.hints[usize.widen(vreg)]
    if hint == NO_REG or not hint.is_virtual() {
        return hint
    }
    let at = usize.widen(hint.vreg())
    expect at < self.regs.len()
    return self.regs[at]
} Scan.preferred

fn Scan.assign(mut self, vreg: u32, reg: machinst::Reg)
    requires reg.is_physical()
{
    expect usize.widen(vreg) < self.regs.len()
    self.regs[usize.widen(vreg)] = reg
    self.holders[usize.widen(reg.index)] = vreg
} Scan.assign

/// Whether no interval holds a register and no fixed range of it meets `start ..= end`.
fn Scan.is_free(mut self, live: Liveness, reg: machinst::Reg, start: u32, end: u32) -> bool
    requires reg.is_physical()
{
    return self.holders[usize.widen(reg.index)] == NONE and mut self.is_clear(live, reg, start, end)
} Scan.is_free

/// The weight of saving a register across the calls clobbering it in `start ..= end`, a store and
/// a load at each; none when another fixed range meets them.
fn Scan.save_cost(mut self, live: Liveness, reg: machinst::Reg, start: u32, end: u32) -> Option[u64]
    requires reg.is_physical()
{
    discard mut self.is_clear(live, reg, start, end)
    let at = usize.widen(reg.index)
    let limit = live.fixed_at[at + 1]
    expect usize.widen(limit) <= live.fixed.len()
    var cost: u64 = 0
    var index = self.cursors[at]
    while index < limit and live.fixed[usize.widen(index)].start <= end {
        let range = live.fixed[usize.widen(index)]
        if not range.call {
            return None
        }
        let call_at = usize.widen(range.start / 2)
        expect call_at < self.factors.len()
        cost = cost.saturating_add(2 * self.factors[call_at])
        index += 1
    }
    return Some(cost)
} Scan.save_cost

/// Whether no fixed range of a register meets `start ..= end`, the ranges ending before `start`
/// passed for good.
fn Scan.is_clear(mut self, live: Liveness, reg: machinst::Reg, start: u32, end: u32) -> bool
    requires reg.is_physical()
{
    let at = usize.widen(reg.index)
    let limit = live.fixed_at[at + 1]
    expect usize.widen(limit) <= live.fixed.len()
    while self.cursors[at] < limit and live.fixed[usize.widen(self.cursors[at])].end < start {
        self.cursors[at] = self.cursors[at] + 1
    }
    let cursor = self.cursors[at]
    expect cursor <= limit
    return cursor == limit or live.fixed[usize.widen(cursor)].start > end
} Scan.is_clear

/// The allocation: spill slots shared by spilled intervals that do not overlap, and the
/// callee-saved registers the code changes. No vector is spilled or saved: the functions holding
/// vectors make no call and hold fewer at once than allocation hands out registers.
fn Scan.finish[I: machinst::MachInst and Copy](take self, code: VCode[I], live: Liveness, alloc: mem::Alloc) -> Allocation {
    let Scan(allocatable: _, holders: _, cursors: _, regs: regs, spilled: spilled, weights: _, factors: _, saved: across) = self
    var by_start = spilled
    for vreg in 0..<across.len() {
        if across[vreg] {
            mut by_start.push(u32.fit(vreg))
        }
    }
    mut by_start.sort_by(fn(left: u32, right: u32) -> core::Ordering {
        let left_start = live.start_of(left)
        let right_start = live.start_of(right)
        if left_start != right_start {
            return left_start.cmp(right_start)
        }
        return left.cmp(right)
    })
    var slots = filled(regs.len(), value: NONE, alloc)
    var slot_ends = mem::List[u32].empty(alloc)
    for vreg in by_start {
        expect not code.is_vector(machinst::Reg.virtual_number(vreg))
        let start = live.start_of(vreg)
        let at = usize.widen(vreg)
        expect at < slots.len()
        match slot_ends.position(fn(slot_end: u32) => slot_end < start) {
            Some(index) => {
                slot_ends[index] = live.end_of(vreg)
                slots[at] = u32.fit(index)
            }
            None => {
                slots[at] = u32.fit(slot_ends.len())
                mut slot_ends.push(live.end_of(vreg))
            }
        }
    }
    let callee_saved = I.callee_saved()
    var saved = machinst::RegSet.empty()
    for reg in regs {
        if callee_saved.contains(reg) {
            saved = saved.plus(reg)
        }
    }
    for vinst in code.insts {
        saved = saved.union(vinst.inst.clobbers().intersect(callee_saved))
    }
    let saves = saves_of(code, live, regs: regs.view(), across: across.view(), alloc)
    return Allocation(regs: take regs, slots: take slots, saves: take saves, slot_count: u32.fit(slot_ends.len()), saved: saved)
} Scan.finish

/// The saves across calls: for each call, in order, each virtual register saved across the calls
/// of its interval whose register the call clobbers.
fn saves_of[I: machinst::MachInst and Copy](code: VCode[I], live: Liveness, regs: Slice[machinst::Reg], across: Slice[bool], alloc: mem::Alloc) -> mem::List[Save] {
    var saves = mem::List[Save].empty(alloc)
    var held = mem::List[u32].empty(alloc)
    for vreg in 0..<across.len() {
        if across[vreg] {
            mut held.push(u32.fit(vreg))
        }
    }
    if held.len() == 0 {
        return saves
    }
    for at in 0..<code.insts.len() {
        let inst = code.insts[at].inst
        if not inst.is_call() {
            continue
        }
        let clobbers = inst.clobbers()
        let position = u32.fit((2 * at) + 1)
        for vreg in held {
            expect usize.widen(vreg) < regs.len()
            let reg = regs[usize.widen(vreg)]
            if live.start_of(vreg) <= position and position <= live.end_of(vreg) and clobbers.contains(reg) {
                mut saves.push(Save(at: u32.fit(at), reg: reg, vreg: vreg))
            }
        }
    }
    return saves
} saves_of
