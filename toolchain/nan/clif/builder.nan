//! The function builder: Cranelift's, with its construction of SSA form from variables.

/// Builds a function's blocks and instructions in the current block, giving each use of a
/// variable the SSA value that reaches it.
pkg struct Builder {
    pkg func: Function
    /// The source location of the instructions built next.
    srcloc: SourceLoc
    /// The block instructions are built in.
    position: Option[Block]
    /// How far each block is filled, by block index.
    status: mem::List[BlockStatus]
    /// The type of each variable declared, by variable index.
    variables: mem::List[Type]
    ssa: SsaBuilder
    alloc: mem::Alloc
} Builder

/// How far a block is filled: no instruction yet, some but no terminator, or a terminator.
enum BlockStatus derives Copy, Eq {
    Empty
    Partial
    Filled
} BlockStatus

/// The two halves of a 128-bit value.
pkg struct Halves derives Copy, Eq {
    pkg low: Value
    pkg high: Value
} Halves

/// The result of an arithmetic operation checking overflow, and whether it overflowed.
pkg struct Overflowed derives Copy, Eq {
    pkg value: Value
    pkg flag: Value
} Overflowed

pkg fn Builder.new(take func: Function, alloc: mem::Alloc) -> Builder {
    return Builder(
        func: take func,
        srcloc: DEFAULT_LOC,
        position: None,
        status: mem::List[BlockStatus].empty(alloc),
        variables: mem::List[Type].empty(alloc),
        ssa: SsaBuilder.empty(alloc),
        alloc: alloc,
    )
} Builder.new

/// The function built, once every block is filled and sealed.
pkg fn Builder.finalize(take self) -> Function {
    return self.func
} Builder.finalize

pkg fn Builder.current_block(self) -> Option[Block] {
    return self.position
} Builder.current_block

/// Sets the source location of the instructions built next.
pkg fn Builder.set_srcloc(mut self, loc: SourceLoc) {
    self.srcloc = loc
} Builder.set_srcloc

pkg fn Builder.create_block(mut self) -> Block {
    let block = mut self.func.make_block()
    mut self.ssa.declare_block(block)
    mut self.status.push(BlockStatus.Empty)
    return block
} Builder.create_block

pkg fn Builder.set_cold_block(mut self, block: Block) {
    mut self.func.laid.set_cold(block)
} Builder.set_cold_block

pkg fn Builder.switch_to_block(mut self, block: Block) {
    self.position = Some(block)
} Builder.switch_to_block

/// Declares that every predecessor of a block is known.
pkg fn Builder.seal_block(mut self, block: Block) {
    mut self.ssa.seal_block(block, func: mut self.func)
    mut self.handle_ssa_side_effects()
} Builder.seal_block

pkg fn Builder.seal_all_blocks(mut self) {
    mut self.ssa.seal_all_blocks(mut self.func)
    mut self.handle_ssa_side_effects()
} Builder.seal_all_blocks

pkg fn Builder.declare_var(mut self, ty: Type) -> Variable {
    let variable = Variable(index: u32.fit(self.variables.len()))
    mut self.variables.push(ty)
    return variable
} Builder.declare_var

pkg fn Builder.use_var(mut self, variable: Variable) -> Value {
    mut self.ensure_inserted_block()
    let Some(block) = self.position else {
        expect false
        return Value(index: 0)
    }
    expect usize.widen(variable.index) < self.variables.len()
    let ty = self.variables[usize.widen(variable.index)]
    let value = mut self.ssa.use_var(mut self.func, variable, ty, block)
    mut self.handle_ssa_side_effects()
    return value
} Builder.use_var

pkg fn Builder.def_var(mut self, variable: Variable, val: Value) {
    expect usize.widen(variable.index) < self.variables.len()
    expect self.variables[usize.widen(variable.index)] == self.func.dfg.value_type(val)
    let Some(block) = self.position else {
        expect false
        return
    }
    mut self.ssa.def_var(variable, value: val, block)
} Builder.def_var

pkg fn Builder.create_sized_stack_slot(mut self, data: StackSlotData) -> StackSlot {
    return mut self.func.create_sized_stack_slot(data)
} Builder.create_sized_stack_slot

pkg fn Builder.import_signature(mut self, take signature: Signature) -> SigRef {
    return mut self.func.import_signature(take signature)
} Builder.import_signature

/// Declares a function the function calls or takes the address of, numbering its name among the
/// names the function refers to.
pkg fn Builder.import_function(mut self, data: ExtFuncData) -> FuncRef {
    discard mut self.func.declare_imported_user_function(data.name)
    return mut self.func.import_function(data)
} Builder.import_function

/// Declares a symbol whose address the function takes, numbering its name among the names the
/// function refers to.
pkg fn Builder.create_global_value(mut self, data: GlobalValueData) -> GlobalValue {
    discard mut self.func.declare_imported_user_function(data.name)
    return mut self.func.create_global_value(data)
} Builder.create_global_value

pkg fn Builder.append_block_params_for_function_params(mut self, block: Block) {
    for param in self.func.signature.params {
        discard mut self.func.dfg.append_block_param(block, ty: param.value_type)
    }
} Builder.append_block_params_for_function_params

pkg fn Builder.append_block_param(mut self, block: Block, ty: Type) -> Value {
    return mut self.func.dfg.append_block_param(block, ty)
} Builder.append_block_param

pkg fn Builder.block_params(self, block: Block, alloc: mem::Alloc) -> mem::List[Value] {
    return self.func.block_params(block, alloc)
} Builder.block_params

pkg fn Builder.inst_results(self, inst: Inst, alloc: mem::Alloc) -> mem::List[Value] {
    return self.func.dfg.inst_results(inst, alloc)
} Builder.inst_results

pkg fn Builder.value_type(self, value: Value) -> Type {
    return self.func.dfg.value_type(value)
} Builder.value_type

/// Whether the current block ends in a terminator.
pkg fn Builder.is_filled(self) -> bool {
    let Some(block) = self.position else {
        return false
    }
    let Some(inst) = self.func.laid.last_inst(block) else {
        return false
    }
    return self.func.inst_data(inst).opcode().is_terminator()
} Builder.is_filled

/// Inserts the current block in the layout when no instruction was added to it yet.
fn Builder.ensure_inserted_block(mut self) {
    let Some(block) = self.position else {
        expect false
        return
    }
    if self.is_pristine(block) {
        if not self.func.laid.is_block_inserted(block) {
            mut self.func.laid.append_block(block)
        }
        expect usize.widen(block.index) < self.status.len()
        self.status[usize.widen(block.index)] = BlockStatus.Partial
    }
} Builder.ensure_inserted_block

fn Builder.is_pristine(self, block: Block) -> bool {
    expect usize.widen(block.index) < self.status.len()
    return self.status[usize.widen(block.index)] == BlockStatus.Empty
} Builder.is_pristine

/// Marks the blocks the SSA construction added instructions to as no longer empty.
fn Builder.handle_ssa_side_effects(mut self) {
    for block in self.ssa.side_effects {
        if self.is_pristine(block) {
            expect usize.widen(block.index) < self.status.len()
            self.status[usize.widen(block.index)] = BlockStatus.Partial
        }
    }
    mut self.ssa.side_effects.truncate(0)
} Builder.handle_ssa_side_effects

/// Builds an instruction at the end of the current block, which enters the layout with its first
/// instruction and is filled by a terminator.
fn Builder.build(mut self, take data: InstructionData, ctrl_typevar: Option[Type]) -> Inst {
    mut self.ensure_inserted_block()
    let Some(block) = self.position else {
        expect false
        return Inst(index: 0)
    }
    let opcode = data.opcode()
    let inst = mut self.func.dfg.make_inst(take data)
    discard mut self.func.dfg.make_inst_results(inst, ctrl_typevar)
    mut self.func.laid.append_inst(inst, block)
    if not self.srcloc.is_default() {
        mut self.func.set_srcloc(inst, srcloc: self.srcloc)
    }
    if opcode.is_terminator() {
        expect usize.widen(block.index) < self.status.len()
        self.status[usize.widen(block.index)] = BlockStatus.Filled
    }
    return inst
} Builder.build

/// Builds an instruction other than a branch at the end of the current block, as another
/// function holds it with its operands replaced.
pkg fn Builder.copy(mut self, take data: InstructionData, ctrl_typevar: Option[Type]) -> Inst {
    expect not data.opcode().is_branch()
    return mut self.build(take data, ctrl_typevar)
} Builder.copy

/// Builds an instruction and gives its first result.
fn Builder.build_value(mut self, take data: InstructionData, ctrl_typevar: Option[Type]) -> Value {
    let inst = mut self.build(take data, ctrl_typevar)
    return self.func.dfg.first_result(inst)
} Builder.build_value

fn Builder.unary(mut self, opcode: Opcode, ctrl_typevar: Type, arg: Value) -> Value {
    return mut self.build_value(InstructionData.Unary(opcode: opcode, arg: arg), ctrl_typevar: Some(ctrl_typevar))
} Builder.unary

fn Builder.binary(mut self, opcode: Opcode, x: Value, y: Value) -> Value {
    let ctrl_typevar = self.value_type(x)
    return mut self.build_value(InstructionData.Binary(opcode: opcode, x: x, y: y), ctrl_typevar: Some(ctrl_typevar))
} Builder.binary

/// An `iconst` of `imm` in `controlling_type`, an `i64` one extended when that is `i128`.
fn Builder.build_imm_const(mut self, controlling_type: Type, imm: i64, signed: bool) -> Value {
    if controlling_type != Type.Int128 {
        let masked = mask_to_width(imm, bits: controlling_type.bits())
        return mut self.build_value(InstructionData.UnaryImm(opcode: Opcode.Iconst, imm: masked), ctrl_typevar: Some(controlling_type))
    }
    let low = mut self.build_value(InstructionData.UnaryImm(opcode: Opcode.Iconst, imm: imm), ctrl_typevar: Some(Type.Int64))
    let opcode = match signed {
        true => Opcode.Sextend
        false => Opcode.Uextend
    }
    return mut self.unary(opcode, ctrl_typevar: controlling_type, arg: low)
} Builder.build_imm_const

/// An immediate cut to the low `bits` bits, as an instruction of a type that wide keeps it.
fn mask_to_width(imm: i64, bits: u32) -> i64
    requires bits > 0
{
    if bits >= 64 {
        return imm
    }
    let mask = 0xFFFF_FFFF_FFFF_FFFFu64 >> (64 - bits)
    return i64.from_bits(imm.to_bits() & mask)
} mask_to_width

/// An operation with an immediate of the type of `x`, sign-extended: Cranelift's `_imm_s`
/// instruction builders.
fn Builder.binary_imm(mut self, opcode: Opcode, x: Value, y: i64) -> Value {
    let ty = self.value_type(x)
    let imm = mut self.build_imm_const(ty, imm: y, signed: true)
    return mut self.binary(opcode, x, y: imm)
} Builder.binary_imm

fn Builder.overflowing(mut self, opcode: Opcode, x: Value, y: Value) -> Overflowed {
    let value = mut self.binary(opcode, x, y)
    expect value.index < 0xFFFF_FFFF
    return Overflowed(value: value, flag: Value(index: value.index + 1))
} Builder.overflowing

/// Records a branch as a predecessor of its target.
fn Builder.declare_successor(mut self, dest_block: Block, jump_inst: Inst) {
    mut self.ssa.declare_block_predecessor(dest_block, inst: jump_inst)
} Builder.declare_successor

/// The arguments a branch passes to a block.
fn Builder.block_call(self, block: Block, args: Slice[Value]) -> BlockCall {
    return BlockCall(block: block, args: self.value_list(args))
} Builder.block_call

fn Builder.value_list(self, args: Slice[Value]) -> mem::List[Value] {
    var values = mem::List[Value].empty(self.alloc)
    for arg in args {
        mut values.push(arg)
    }
    return values
} Builder.value_list

pkg fn Builder.iconst(mut self, ty: Type, imm: i64) -> Value {
    let masked = mask_to_width(imm, bits: ty.bits())
    return mut self.build_value(InstructionData.UnaryImm(opcode: Opcode.Iconst, imm: masked), ctrl_typevar: Some(ty))
} Builder.iconst

pkg fn Builder.f32const(mut self, bits: u32) -> Value {
    return mut self.build_value(InstructionData.UnaryIeee32(opcode: Opcode.F32const, bits: bits), ctrl_typevar: None)
} Builder.f32const

pkg fn Builder.f64const(mut self, bits: u64) -> Value {
    return mut self.build_value(InstructionData.UnaryIeee64(opcode: Opcode.F64const, bits: bits), ctrl_typevar: None)
} Builder.f64const

pkg fn Builder.iadd(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Iadd, x, y)
} Builder.iadd

pkg fn Builder.iadd_imm_s(mut self, x: Value, y: i64) -> Value {
    return mut self.binary_imm(Opcode.Iadd, x, y)
} Builder.iadd_imm_s

pkg fn Builder.isub(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Isub, x, y)
} Builder.isub

pkg fn Builder.imul(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Imul, x, y)
} Builder.imul

pkg fn Builder.imul_imm_s(mut self, x: Value, y: i64) -> Value {
    return mut self.binary_imm(Opcode.Imul, x, y)
} Builder.imul_imm_s

pkg fn Builder.ineg(mut self, x: Value) -> Value {
    let ty = self.value_type(x)
    return mut self.unary(Opcode.Ineg, ctrl_typevar: ty, arg: x)
} Builder.ineg

pkg fn Builder.udiv(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Udiv, x, y)
} Builder.udiv

pkg fn Builder.sdiv(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Sdiv, x, y)
} Builder.sdiv

pkg fn Builder.urem(mut self, x: Value, y: Value) -> Value {
    return mut self.binary(Opcode.Urem, x, y)
} Builder.urem

pkg fn Builder.srem(mut self, x: Value, y: Value) -> Value {
