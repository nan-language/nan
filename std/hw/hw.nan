} SavedContext

pub open struct Resumable {
} Resumable

pub fn SavedContext.resumable(self) -> Resumable

pub fn switch_to(take guard: SpinGuard[RunQueue], take from: SavedContext, to: Resumable) -> SpinGuard[RunQueue]

pub open struct PerCpu[T: Send] {
} PerCpu

pub fn PerCpu.of(init: fn(cpu: u32) -> T, alloc: mem::Alloc) -> PerCpu[T]

pub fn PerCpu.with[R: Any](self, t: IrqsDisabled, body: fn(mut value: T) -> R limits notrap, terminates, noalloc) -> R limits notrap, terminates, noalloc

test of_initialises_the_value_of_cpu_zero for PerCpu.of {
    let values = PerCpu.of(fn(cpu: u32) => u64.widen(cpu) + 10, alloc: testing::world().alloc)
    let value = without_irqs(fn(t: IrqsDisabled) => values.with(t, body: fn(mut held: u64) => held))
    expect value == 10
} of_initialises_the_value_of_cpu_zero

test with_keeps_changes_for_the_same_cpu for PerCpu.with {
    let values = PerCpu.of(fn(cpu: u32) => 0u64, alloc: testing::world().alloc)
    let value = without_irqs(fn(t: IrqsDisabled) -> u64 {
        values.with(t, body: fn(mut held: u64) {
            held = held.wrapping_add(3)
        })
        return values.with(t, body: fn(mut held: u64) => held)
    })
    expect value == 3
} with_keeps_changes_for_the_same_cpu

