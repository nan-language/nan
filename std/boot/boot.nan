    pub start: u64
    pub blocks: u64
    pub signature: PartitionSignature
} Partition

pub closed enum PartitionSignature derives Copy, Eq {
    Gpt(Guid)
    Mbr(u32)
    Unsigned
} PartitionSignature

pub closed struct MemoryRange derives Copy, Eq {
    pub base: u64
    pub byte_len: u64
    pub kind: u32
    pub attributes: u64
} MemoryRange

/// The address of the PVH-layout start information the image started with, zero when it has
/// none.
pkg fn start_info() -> u64

/// The address of the flattened device tree the image started with, zero when it has none.
pkg fn tree_address() -> u64

/// The address of the ACPI root system description pointer the platform gives, zero when none.
pkg fn rsdp_address() -> u64

/// The address of the system table the firmware entered the image with, zero when it has no
/// firmware.
pkg fn system_table_address() -> u64

/// The address of the table the firmware's configuration table lists under a GUID, zero when
/// it lists none or the image has no firmware.
fn configured(guid: Guid) -> u64 {
    let table = system_table_address()
    if table == 0 {
        return 0
    }
    let entries = u64_at(table + CONFIGURATION_TABLE)
    for index in 0..<u64_at(table + CONFIGURATION_COUNT) {
        let entry = entries + index * CONFIGURATION_ENTRY
        if same_guid(entry, guid) {
            return u64_at(entry + 16)
        }
    }
    return 0
} configured

/// Whether the GUID the firmware laid out at an address is `guid`.
fn same_guid(at: u64, guid: Guid) -> bool {
    var tail: u64 = 0
    for index in 8u64..<16 {
        tail = (tail << 8) | u64.widen(byte_at(at + index))
    }
    let head = u32_at(at + 4)
    return u32_at(at) == guid.data1 and head == ((u32.widen(guid.data3) << 16) | u32.widen(guid.data2)) and tail == guid.data4
} same_guid

/// The byte at a physical address.
fn byte_at(address: u64) -> u8 {
    return trusted "the platform's tables lie in memory the running root maps, which nothing writes" { hw::Ptr[u8].of_addr(usize.widen(address)).read() }
} byte_at

/// The little-endian 32-bit and 64-bit numbers at a physical address, and the big-endian 32-bit
/// one.
fn u32_at(address: u64) -> u32 {
    var value: u32 = 0
    for index in 0u64..<4 {
        value = value | (u32.widen(byte_at(address + index)) << u32.fit(index * 8))
    }
    return value
} u32_at

fn u64_at(address: u64) -> u64 {
    return u64.widen(u32_at(address)) | (u64.widen(u32_at(address + 4)) << 32)
} u64_at

fn u32_be_at(address: u64) -> u32 {
    var value: u32 = 0
    for index in 0u64..<4 {
        value = (value << 8) | u32.widen(byte_at(address + index))
    }
    return value
} u32_be_at

/// The NUL-terminated text at a physical address, its NUL left out; empty at address zero.
fn text_at(address: u64, alloc: mem::Alloc) -> mem::Bytes {
    var text = mem::Bytes.empty(alloc)
    if address == 0 {
        return text
    }
    var at = address
    loop {
        let byte = byte_at(at)
        if byte == 0 {
            return text
        }
        mut text.push(byte)
        at += 1
    }
} text_at

/// The `len` bytes at a physical address.
fn copied(address: u64, len: u64, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.zeroed(usize.widen(len), alloc)
    copy_into(address, to: mut bytes.view_mut())
    return bytes
} copied

/// The `len` bytes at a physical address, failing with `OutOfMemory` when `alloc` cannot hold
/// them.
fn drawn(address: u64, len: u64, alloc: mem::Alloc) -> mem::Bytes fails ServiceError {
    let Ok(bytes) = attempt mem::Bytes.try_zeroed(usize.widen(len), alloc) else {
        fail ServiceError.OutOfMemory
    }
    var filled = bytes
    copy_into(address, to: mut filled.view_mut())
    return filled
} drawn

/// Fills `to` with the bytes at a physical address.
fn copy_into(address: u64, mut to: SliceMut[u8]) {
    let len = to.len()
    let target = hw::Ptr.of_view_mut(mut to)
    trusted "the platform's tables lie in memory the running root maps, and `to` holds `len` bytes" {
        hw::Ptr[u8].of_addr(usize.widen(address)).copy(target, count: len)
    }
} copy_into

/// The SMBIOS 3.0 entry point at an address followed by the structure table it names, of its
/// stated maximum size.
fn smbios(entry: u64, alloc: mem::Alloc) -> mem::Bytes fails ServiceError {
    let entry_len = u64.widen(byte_at(entry + SMBIOS_ENTRY_LENGTH))
    let table_len = u64.widen(u32_at(entry + SMBIOS_TABLE_SIZE))
    var bytes = try drawn(entry, len: entry_len, alloc)
    let table = try drawn(u64_at(entry + SMBIOS_TABLE), len: table_len, alloc)
    let Ok(_) = attempt mut bytes.try_append(table.view()) else {
        fail ServiceError.OutOfMemory
    }
    return bytes
} smbios

/// The address of the ACPI table with a signature, zero when the platform gives none: the DSDT
/// and the FACS through the FADT's 64-bit address, or its 32-bit one when that is zero, any
/// other the root table lists.
fn acpi_table_address(signature: Array[u8, 4]) -> u64 {
    let wanted = signature.view().u32_le(0)
    if wanted != DSDT and wanted != FACS {
        return listed_table(wanted)
    }
    let facp = listed_table(FADT)
    if facp == 0 {
        return 0
    }
    var wide = FADT_X_FACS
    var narrow = FADT_FACS
    if wanted == DSDT {
        wide = FADT_X_DSDT
        narrow = FADT_DSDT
    }
    let length = u64.widen(u32_at(facp + 4))
    if length >= wide + 8 {
        let address = u64_at(facp + wide)
        if address != 0 {
            return address
        }
    }
    return u64.widen(u32_at(facp + narrow))
} acpi_table_address

/// The address of the table with a signature that the XSDT, or the RSDT for an RSDP of revision
/// 0 or without an XSDT, lists; zero when none.
fn listed_table(signature: u32) -> u64 {
    let rsdp = rsdp_address()
    if rsdp == 0 {
        return 0
    }
    var root = u64.widen(u32_at(rsdp + RSDP_RSDT))
    var width: u64 = 4
    if byte_at(rsdp + RSDP_REVISION) >= 2 and u64_at(rsdp + RSDP_XSDT) != 0 {
        root = u64_at(rsdp + RSDP_XSDT)
        width = 8
    }
    let end = root + u64.widen(u32_at(root + 4))
    var at = root + HEADER_BYTES
    while at + width <= end {
        var table = u64.widen(u32_at(at))
        if width == 8 {
            table = u64_at(at)
        }
        if table != 0 and u32_at(table) == signature {
            return table
        }
        at += width
    }
    return 0
} listed_table

/// The value of the `bootargs` property of the device tree's `/chosen` node, empty when it has
/// none.
fn boot_arguments(tree: u64, alloc: mem::Alloc) -> mem::Bytes {
    if u32_be_at(tree) != TREE_MAGIC {
        return mem::Bytes.empty(alloc)
    }
    let strings = tree + u64.widen(u32_be_at(tree + TREE_STRINGS))
    var at = tree + u64.widen(u32_be_at(tree + TREE_STRUCTURE))
    var depth: u32 = 0
    var chosen = false
    loop {
        let token = u32_be_at(at)
        at += 4
        if token == BEGIN_NODE {
            depth += 1
            chosen = depth == 2 and named(at, text: "chosen")
            at = past_name(at)
        } else if token == END_NODE {
            depth -= 1
            chosen = false
        } else if token == PROPERTY {
            let len = u64.widen(u32_be_at(at))
            let name = strings + u64.widen(u32_be_at(at + 4))
            if chosen and named(name, text: "bootargs") {
                return text_at(at + 8, alloc)
            }
            at += 8 + (len + 3) / 4 * 4
        } else if token == TREE_END {
            return mem::Bytes.empty(alloc)
        }
    }
} boot_arguments

/// Whether the NUL-terminated name at an address is `text`, or `text` followed by `@` and a unit
/// address.
fn named(address: u64, text: Str) -> bool {
    var at = address
    for byte in text.as_bytes() {
        if byte_at(at) != byte {
            return false
        }
        at += 1
    }
    let next = byte_at(at)
    return next == 0 or next == b'@'
} named

/// The address past a node's NUL-terminated name, padded to a word.
fn past_name(address: u64) -> u64 {
    var at = address
    while byte_at(at) != 0 {
        at += 1
    }
    return (at + 4) / 4 * 4
} past_name
