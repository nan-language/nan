{
    var lanes = if_false.lanes
    for index in 0..<8usize {
        let chosen = mask.lanes[index]
        lanes[index] = (if_true.lanes[index] & chosen) | (if_false.lanes[index] & ~chosen)
    }
    return U16x8(lanes: lanes)
