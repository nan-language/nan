//! The root grant of the nanos targets, its capability table, and the jobs and component instances of nanos bundles in a kernel's shared space.

pub closed struct World {
    pub alloc: mem::Alloc
    pub exec: task::Executor
    pub clock: sys::Clock
    pub random: sys::Random
    pub log: sys::Log
    pub stdio: sys::Stdio
    pub fs: sys::Fs
    pub net: sys::Net
    pub caps: Caps
} World

pub open struct Caps derives Send {
    held: mem::List[Held]
    alloc: mem::Alloc
} Caps

pub closed enum CapError derives Copy, Eq, Render {
    Missing
} CapError

pub open struct Cap[C: sys::Capability and Copy] {
} Cap

pub fn Caps.empty(alloc: mem::Alloc) -> Caps {
    return Caps(held: mem::List[Held].empty(alloc), alloc: alloc)
} Caps.empty

pub fn Cap.put(mut caps: Caps, key: Str, capability: C) {
    var at: usize = 0
    while at < caps.held.len() {
        if caps.held[at].key.as_str() == key {
            discard mut caps.held.remove(at)
        } else {
            at += 1
        }
    }
    mut caps.held.push(Held(key: text::String.of(key, alloc: caps.alloc), tag: Cap[C].tag(), handle: Cap[C].handle(capability)))
} Cap.put

pub fn Cap.get(caps: Caps, key: Str) -> C fails CapError {
    let wanted = Cap[C].tag()
    for held in caps.held {
        if held.key.as_str() == key and held.tag == wanted {
            return Cap[C].of_handle(held.handle)
        }
    }
    fail CapError.Missing
} Cap.get

/// How a job or a component instance ended: the encoding of a job's result, of a host-compatible
/// entry's exit status as a `u8` or of an instance's last state, the rendering of a job's failure
/// or of the failure building an instance's Env, the trap that abandoned its domain, or an input
/// or checkpoint its entry does not decode.
pub closed enum Ended {
    Returned(mem::Bytes)
    Failed(text::String)
    Trapped(sys::Trap)
    Undecodable
} Ended

pub closed enum RunError derives Render {
    NoJob
    Cancelled(task::Cancelled) from
} RunError

/// The input of a host-compatible entry: its arguments and environment.
pub closed struct HostInput derives Encode {
    pub args: mem::List[mem::Bytes]
    pub environment: mem::Map[mem::Bytes, mem::Bytes]
} HostInput

pub fn run(bundle: sys::load::Bundle, take world: World, take input: mem::Bytes, exec: task::Executor, alloc: mem::Alloc) -> Ended fails RunError uses wait {
    let Some(job) = bundle.job() else {
        fail RunError.NoJob
    }
    let outcome = try await sys::Domain.run_sized(fn[take world, take input]() -> Ended fails task::Cancelled uses wait limits stack 4_096 {
        return try await call(job, take world, take input)
    }, stack: job.stack() + CALL_STACK, exec, alloc)
    match outcome {
        Ok(ended) => return ended
        Err(trap) => return Ended.Trapped(take trap)
    }
} run

/// The stack of a job's task beyond the one its entry needs, for the call of the entry.
const CALL_STACK: usize = 4_096

/// The bytes a job's failure renders into.
const RENDERED: usize = 1_024

/// Calls a job or component entry, which owns `world` and `input` from then on.
fn call[I: Send](job: sys::load::Job, take world: World, take input: I) -> Ended fails task::Cancelled uses wait

/// The Env of a component a kernel holds, built from the world the kernel grants its instance.
pub interface Environment {
    fn build(take world: World) -> Self fails CapError
} Environment

/// A component instance a kernel holds: the senders of its holder's requests to the task of its
/// domain and of the encoded calls of its inboxes, the receiver of how it ended, the abandoner
/// running its domain, and the waits for answers of its domain.
pub open linear struct Instance {
    requests: task::Sender[Asked]
    calls: task::Sender[Called]
    outcome: task::Receiver[Ended]
    domain: mem::Shared[sys::Abandoner]
    waits: task::Cown[Waits]
    alloc: mem::Alloc
} Instance

/// The inbox of an instance, carrying encoded calls to it.
pub open struct Inbox {
    calls: task::Sender[Called]
    waits: task::Cown[Waits]
} Inbox

pub closed enum InstanceError derives Render {
    Ended
    Cancelled(task::Cancelled) from
} InstanceError

pub fn hold[T, E](bundle: sys::load::Bundle, component: Str, take world: World, take checkpoint: Option[mem::Bytes], exec: task::Executor, alloc: mem::Alloc, body: fn(take instance: Instance) -> T fails E uses wait limits stack 65_536) -> Option[T] fails E uses wait {
    let Some(job) = bundle.component(component) else {
        return None
    }
    var given = Some(Given(world: take world, checkpoint: take checkpoint))
    var result: Option[T] = None
    try await task::scope(exec, body: fn[mut given, mut result](s: task::Scope) fails E uses wait {
        let Some(Given(world: granted, checkpoint: from)) = mut given.extract() else {
            return
        }
        let Opened(instance: instance, launch: launch, ending: ending, last: last) = opened(s, checkpoint: take from, alloc)
        let running = instance.domain.share()
        discard s.spawn(fn[take granted, take launch, take running, take ending, take last]() fails task::Cancelled uses wait limits stack 16_384 {
            let ran = attempt await running.contents().run_sized(fn[take granted, take launch]() -> Ended fails task::Cancelled uses wait limits stack 4_096 {
                return try await call(job, world: take granted, input: take launch)
            }, stack: job.stack() + CALL_STACK, exec, alloc)
            let ended = match ran {
                Ok(Ok(given_back)) => given_back
                Ok(Err(trap)) => Ended.Trapped(take trap)
                Err(cancelled) => failed(cancelled, alloc)
            }
            discard attempt await ending.send(Routed.Ended)
            discard attempt await last.send(take ended)
        })
        result = Some(try await body(take instance))
    })
    return result
} hold

pub fn Instance.inbox(self) -> Inbox {
    return Inbox(calls: self.calls.split(), waits: self.waits.share())
} Instance.inbox

pub fn Instance.step(mut self) -> bool fails InstanceError uses wait {
    return try await self.flag(Request.Step)
} Instance.step

pub fn Instance.incoming(self) fails InstanceError uses wait {
    discard try await self.waiting(ready: false)
} Instance.incoming

pub fn Instance.ready(self) -> bool fails InstanceError uses wait {
    return try await self.waiting(ready: true)
} Instance.ready

pub fn Instance.start_keyed(mut self) -> usize fails InstanceError uses wait {
    let Answer.Started(count) = try await self.ask(Request.StartKeyed) else {
        fail InstanceError.Ended
    }
    return count
} Instance.start_keyed

pub fn Instance.idle(self) -> bool fails InstanceError uses wait {
    return try await self.flag(Request.Idle)
} Instance.idle

pub fn Instance.checkpoint(self) -> mem::Bytes fails InstanceError uses wait {
    let Answer.Checkpointed(bytes) = try await self.ask(Request.Checkpoint) else {
        fail InstanceError.Ended
    }
    return bytes
} Instance.checkpoint

pub fn Instance.resumed(mut self, reason: sys::ResumeReason) fails InstanceError uses wait {
    discard try await self.ask(Request.Resumed(reason))
} Instance.resumed

pub fn Instance.pressure(mut self, level: u8) fails InstanceError uses wait {
    discard try await self.ask(Request.Pressure(level))
} Instance.pressure

pub fn Instance.health(mut self) -> sys::HealthReply fails InstanceError uses wait {
    let Answer.Health(reply) = try await self.ask(Request.Health) else {
        fail InstanceError.Ended
    }
    return reply
} Instance.health

pub fn Instance.suspend(mut self) fails InstanceError uses wait {
    discard try await self.ask(Request.Suspend)
} Instance.suspend

pub fn Instance.wake(mut self) fails InstanceError uses wait {
    discard try await self.ask(Request.Wake)
} Instance.wake

pub fn Instance.end(take self) -> Ended fails task::Cancelled uses wait {
    let Instance(requests: requests, calls: calls, outcome: outcome, domain: _, waits: _, alloc: alloc) = self
    discard requests
    discard calls
    var last: Option[Ended] = None
    try await take outcome.drain(visit: fn[mut last](take ended: Ended) {
        last = Some(take ended)
    })
    let Some(ended) = last else {
        return Ended.Failed(text::String.empty(alloc))
    }
    return ended
} Instance.end

pub fn Instance.abandon(take self) {
    let Instance(requests: _, calls: _, outcome: _, domain: domain, waits: _, alloc: _) = self
    domain.contents().trigger()
} Instance.abandon

pub fn Inbox.call(self, hash: sys::ProtocolHash, take request: sys::Encoded, alloc: mem::Alloc) -> sys::Encoded fails sys::CallError[Never] uses wait {
    let Some(awaited) = try await awaiting(self.waits, alloc) else {
        fail sys::CallError.Closed(task::SendError.Closed)
    }
    let Awaited(id: id, answers: receiver) = awaited
    try await self.calls.send(Called(id: id, hash: hash, request: take request, alloc: alloc))
    var answers = receiver
    let Some(Answer.Served(served)) = try await mut answers.receive() else {
        fail sys::CallError.Closed(task::SendError.Closed)
    }
    match served {
        Ok(reply) => return reply
        Err(failure) => fail failure
    }
} Inbox.call

/// The encoded calls an instance's inboxes may hold before its task takes them.
const QUEUED_CALLS: usize = 16

/// What `hold` gives the task of an instance's domain.
struct Given {
    world: World
    checkpoint: Option[mem::Bytes]
} Given

/// A new instance and what the task of its domain receives, with the senders through which the
/// kernel's task running that domain tells that the domain has ended and how.
linear struct Opened {
    instance: Instance
    launch: Launch
    ending: task::Sender[Routed]
    last: task::Sender[Ended]
} Opened

/// Opens an instance that resumes from `checkpoint`, routing the answers of its domain on a task
/// of `s` until the domain has ended.
fn opened(s: task::Scope, take checkpoint: Option[mem::Bytes], alloc: mem::Alloc) -> Opened {
    let task::Channel(sender: requests, receiver: asked) = task::Channel[Asked].bounded(1, alloc)
    let task::Channel(sender: inbox, receiver: called) = task::Channel[Called].bounded(QUEUED_CALLS, alloc)
    let task::Channel(sender: answering, receiver: answered) = task::Channel[Routed].bounded(QUEUED_CALLS, alloc)
    let task::Channel(sender: last, receiver: outcome) = task::Channel[Ended].bounded(1, alloc)
    let waits = task::Cown.of(Waits(next: 0, open: true, waiting: mem::Map[u64, task::Sender[Answer]].empty(alloc)), alloc)
    let routing = waits.share()
    discard s.spawn(fn[take answered, take routing]() fails task::Cancelled uses wait limits stack 16_384 {
        try await routed(take answered, waits: routing, alloc)
    })
    let instance = Instance(requests: take requests, calls: take inbox, outcome: take outcome, domain: mem::Shared.of(sys::Abandoner.new(), alloc), waits: take waits, alloc: alloc)
    let ending = answering.split()
    let launch = Launch(checkpoint: take checkpoint, requests: take asked, calls: take called, answers: take answering)
    return Opened(instance: take instance, launch: take launch, ending: take ending, last: take last)
} opened

/// What the task of an instance's domain receives beside its world: the checkpoint it resumes
/// from, none to start, its holder's requests, the encoded calls of its inboxes and the sender of
/// its answers to both.
struct Launch {
    checkpoint: Option[mem::Bytes]
    requests: task::Receiver[Asked]
    calls: task::Receiver[Called]
    answers: task::Sender[Routed]
} Launch

/// A request of an instance's holder, and the number of its wait.
struct Asked {
    id: u64
    request: Request
} Asked

/// A stepper operation an instance's holder asks for, a wait with the receiver whose sender the
/// holder releases to end it.
enum Request {
    Step
    Incoming(task::Receiver[u8])
    Ready(task::Receiver[u8])
    StartKeyed
    Idle
    Checkpoint
    Resumed(sys::ResumeReason)
    Pressure(u8)
    Health
    Suspend
    Wake
} Request

enum Answer {
    Done
    Flag(bool)
    Started(usize)
    Checkpointed(mem::Bytes)
    Health(sys::HealthReply)
    Served(Result[sys::Encoded, sys::CallError[Never]])
} Answer

/// An encoded call an inbox carries: the number of its wait, its protocol hash, its encoding and
/// the allocator its reply is drawn through.
struct Called {
    id: u64
    hash: sys::ProtocolHash
    request: sys::Encoded
    alloc: mem::Alloc
} Called

/// What an instance's domain sends its kernel: an answer to the wait of a number, or, from the
/// kernel's task running the domain, that the domain has ended.
enum Routed {
    Answered(Replied)
    Ended
} Routed

struct Replied {
    id: u64
    answer: Answer
} Replied

/// The waits for answers of an instance's domain: the number of the next, whether the domain can
/// still answer, and the sender of each wait's answer by its number. A request a domain takes
/// never carries a sender, since the settlement of an abandoned domain releases none of the
/// values its channels buffer.
struct Waits {
    next: u64
    open: bool
    waiting: mem::Map[u64, task::Sender[Answer]]
} Waits

/// A wait for an answer of an instance's domain: its number and the receiver of the answer.
struct Awaited {
    id: u64
    answers: task::Receiver[Answer]
} Awaited

/// Registers a wait for an answer of an instance's domain, none once the domain has ended.
fn awaiting(waits: task::Cown[Waits], alloc: mem::Alloc) -> Option[Awaited] fails task::Cancelled uses wait {
    let task::Channel(sender: sender, receiver: receiver) = task::Channel[Answer].bounded(1, alloc)
    var id: Option[u64] = None
    await when mut waits {
        if waits.open {
            id = Some(waits.next)
            discard mut waits.waiting.insert(waits.next, value: take sender)
            waits.next += 1
        }
    }
    let Some(number) = id else {
        return None
    }
    return Some(Awaited(id: number, answers: take receiver))
} awaiting

/// Gives each answer of an instance's domain to its wait until the domain has ended, then ends
/// every wait left.
fn routed(take answered: task::Receiver[Routed], waits: task::Cown[Waits], alloc: mem::Alloc) fails task::Cancelled uses wait {
    var receiver = answered
    loop {
        let Some(Routed.Answered(Replied(id: id, answer: answer))) = try await mut receiver.receive() else {
            break
        }
        let waiting = await when mut waits => mut waits.waiting.remove(id)
        let Some(sender) = waiting else {
            continue
        }
        discard attempt await sender.send(take answer)
    }
    await when mut waits {
        waits.open = false
        waits.waiting = mem::Map[u64, task::Sender[Answer]].empty(alloc)
    }
} routed

/// Has the instance's task carry out a request, failing with `Ended` once the instance has ended.
fn Instance.ask(self, take request: Request) -> Answer fails InstanceError uses wait {
    let Some(awaited) = try await awaiting(self.waits, alloc: self.alloc) else {
        fail InstanceError.Ended
    }
    let Awaited(id: id, answers: receiver) = awaited
    match attempt await self.requests.send(Asked(id: id, request: take request)) {
        Ok(_) => {}
        Err(task::SendError.Closed) => fail InstanceError.Ended
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
    var answers = receiver
    let Some(answer) = try await mut answers.receive() else {
        fail InstanceError.Ended
    }
    return answer
} Instance.ask

fn Instance.flag(self, take request: Request) -> bool fails InstanceError uses wait {
    let Answer.Flag(flag) = try await self.ask(take request) else {
        fail InstanceError.Ended
    }
    return flag
} Instance.flag

/// Waits as `incoming` does, or as `ready` does when `ready`; the instance's task ends its wait
/// once this call releases the sender of `stop`, as it does when cancelled.
fn Instance.waiting(self, ready: bool) -> bool fails InstanceError uses wait {
    let stop = task::Channel[u8].bounded(1, alloc: self.alloc)
    if ready {
        return try await self.flag(Request.Ready(take stop.receiver))
    }
    return try await self.flag(Request.Incoming(take stop.receiver))
} Instance.waiting

/// Runs a typed entry function on the encoding of its input.
fn typed[I: Encode, O: Encode, E: Render](take world: World, take input: mem::Bytes, main: fn(take world: World, take input: I) -> O fails E uses wait) -> Ended {
    let alloc = world.alloc
    let Ok(decoded) = attempt mem::wire::Codec[I].decode(Untrusted.of(input.view()), alloc) else {
        return Ended.Undecodable
    }
    match attempt await main(take world, input: take decoded) {
        Ok(output) => return returned(output, alloc)
        Err(failure) => return failed(failure, alloc)
    }
} typed

/// Runs a host entry function returning an exit status on the encoding of a `HostInput`.
fn hosted[E: Render](take world: World, take input: mem::Bytes, main: fn(take world: host::World) -> u8 fails E uses wait) -> Ended {
    let alloc = world.alloc
    let Some(host) = host_of(take world, take input) else {
        return Ended.Undecodable
    }
    match attempt await main(take host) {
        Ok(status) => return returned(status, alloc)
        Err(failure) => return failed(failure, alloc)
    }
} hosted

/// Runs a host entry function returning nothing on the encoding of a `HostInput`.
fn hosted_unit[E: Render](take world: World, take input: mem::Bytes, main: fn(take world: host::World) fails E uses wait) -> Ended {
    let alloc = world.alloc
    let Some(host) = host_of(take world, take input) else {
        return Ended.Undecodable
    }
    match attempt await main(take host) {
        Ok(_) => return returned(0u8, alloc)
        Err(failure) => return failed(failure, alloc)
    }
} hosted_unit

/// The task of the instances of a component of state S serving P.
struct Hosted[S: sys::Component[Env, P] and Encode, Env: Environment and Send, P: sys::Protocol and Send] {
} Hosted

/// Runs a component instance for the kernel holding it: decodes its checkpoint, builds its Env from
/// `world`, starts it or resumes it from the checkpoint, serves its inboxes and carries out its
/// holder's requests until the holder releases it, then ends it, giving the encoding of its last
/// state. It never fails.
fn Hosted.run(take world: World, take launch: Launch) -> Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let exec = world.exec
    let Launch(checkpoint: checkpoint, requests: requests, calls: calls, answers: answers) = launch
    var restored: Option[S] = None
    match checkpoint {
        Some(bytes) => {
            let Ok(state) = attempt mem::wire::Codec[S].decode(Untrusted.of(bytes.view()), alloc) else {
                return Ended.Undecodable
            }
            restored = Some(take state)
        }
        None => {}
    }
    let env = match attempt Env.build(take world) {
        Ok(built) => built
        Err(failure) => return failed(failure, alloc)
    }
    let started = match restored {
        Some(state) => attempt sys::Stepper[S, Env, P].resume(take state, take env, exec, alloc)
        None => attempt sys::Stepper[S, Env, P].start(take env, exec, alloc)
    }
    var stepper = match started {
        Ok(stepper) => stepper
        Err(cancelled) => return failed(cancelled, alloc)
    }
    discard attempt await serving(mut stepper, take requests, take calls, answers, exec, alloc)
    match attempt await take stepper.end() {
        Ok(stopped) => return returned(stopped.state, alloc)
        Err(cancelled) => return failed(cancelled, alloc)
    }
} Hosted.run

/// Serves the encoded calls `calls` carries, each on a task of its own, while carrying out the
/// requests `requests` carries, until every sender of `requests` is released, sending each answer
/// through `answers`.
fn serving[S: sys::Component[Env, P] and Encode, Env: Environment and Send, P: sys::Protocol and Send](mut stepper: sys::Stepper[S, Env, P], take requests: task::Receiver[Asked], take calls: task::Receiver[Called], answers: task::Sender[Routed], exec: task::Executor, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var asked = requests
    var waiting = Some(take calls)
    let out = stepper.outbox()
    try await task::scope(exec, body: fn[mut stepper, mut asked, mut waiting](s: task::Scope) fails task::Cancelled uses wait {
        let Some(inbox) = mut waiting.extract() else {
            return
        }
        let replies = answers.split()
        discard s.spawn(fn[take inbox, take replies]() fails task::Cancelled uses wait {
            try await dispatched(out, calls: take inbox, answers: replies, exec)
        })
        loop {
            let Some(next) = try await mut asked.receive() else {
                break
            }
            let Asked(id: id, request: request) = next
            let Some(given) = try await carried(mut stepper, take request, exec, alloc) else {
                continue
            }
            discard attempt await answers.send(Routed.Answered(Replied(id: id, answer: take given)))
        }
        s.cancel()
    })
} serving

/// Serves each encoded call `calls` carries through `out` on a task of its own, sending its reply
/// through `answers`, until every sender of `calls` is released.
fn dispatched[P: sys::Protocol and Send](out: sys::Outbox[P], take calls: task::Receiver[Called], answers: task::Sender[Routed], exec: task::Executor) fails task::Cancelled uses wait {
    var receiver = calls
    try await task::scope(exec, body: fn[mut receiver](s: task::Scope) fails task::Cancelled uses wait {
        loop {
            let Some(called) = try await mut receiver.receive() else {
                return
            }
            let replies = answers.split()
            discard s.spawn(fn[take called, take replies]() fails task::Cancelled uses wait {
                let Called(id: id, hash: hash, request: request, alloc: alloc) = called
                let served = attempt await sys::Wire[P].serve(out, hash, raw: Untrusted.of(request.bytes.view()), handles: request.handles.view(), alloc)
                discard attempt await replies.send(Routed.Answered(Replied(id: id, answer: Answer.Served(take served))))
            })
        }
    })
} dispatched

/// Carries out a request of an instance's holder on its stepper, giving the answer, none when the
/// holder ended the wait it asked for.
fn carried[S: sys::Component[Env, P] and Encode, Env: Environment and Send, P: sys::Protocol and Send](mut stepper: sys::Stepper[S, Env, P], take request: Request, exec: task::Executor, alloc: mem::Alloc) -> Option[Answer] fails task::Cancelled uses wait {
    match request {
        Request.Step => return Some(Answer.Flag(mut stepper.step()))
        Request.Incoming(stop) => return try await waited(stepper, take stop, ready: false, exec)
        Request.Ready(stop) => return try await waited(stepper, take stop, ready: true, exec)
        Request.StartKeyed => return Some(Answer.Started(mut stepper.start_keyed()))
        Request.Idle => return Some(Answer.Flag(stepper.idle()))
        Request.Checkpoint => return Some(Answer.Checkpointed(encoded(stepper.state(), alloc)))
        Request.Resumed(reason) => mut stepper.resumed(reason)
        Request.Pressure(level) => mut stepper.pressure(level)
        Request.Health => return Some(Answer.Health(mut stepper.health()))
        Request.Suspend => mut stepper.suspend()
        Request.Wake => mut stepper.wake()
    }
    return Some(Answer.Done)
} carried

enum Waited {
    Released
    Cancelled(task::Cancelled) from
} Waited

/// Waits as `stepper.incoming()` does, or as `stepper.ready()` does when `ready`, giving whether a
/// message waits, none once every sender of `stop` is released first.
fn waited[S, Env: Any, P: Any](stepper: sys::Stepper[S, Env, P], take stop: task::Receiver[u8], ready: bool, exec: task::Executor) -> Option[Answer] fails task::Cancelled uses wait {
    var waits = true
    var watched = Some(take stop)
    let outcome = attempt await task::scope(exec, body: fn[mut waits, mut watched](s: task::Scope) fails Waited uses wait {
        let Some(watching) = mut watched.extract() else {
            return
        }
        discard s.spawn(fn[take watching]() fails Waited uses wait {
            var released = watching
            discard try await mut released.receive()
            fail Waited.Released
        })
        if ready {
            waits = try await stepper.ready()
        } else {
            try await stepper.incoming()
        }
        s.cancel()
    })
    match outcome {
        Ok(_) => return Some(Answer.Flag(waits))
        Err(Waited.Released) => return None
        Err(Waited.Cancelled(cancelled)) => fail cancelled
    }
} waited

/// The `host::World` of a host-compatible entry: the capabilities of `world`, the wall clock its
/// table holds under `wall` or one denying every read, and the arguments and environment the
/// encoding of a `HostInput` gives; none when `input` does not decode.
fn host_of(take world: World, take input: mem::Bytes) -> Option[host::World] {
    let Ok(given) = attempt mem::wire::Codec[HostInput].decode(Untrusted.of(input.view()), alloc: world.alloc) else {
        return None
    }
    let wall = match attempt Cap[sys::WallClock].get(world.caps, key: "wall") {
        Ok(clock) => clock
        Err(_) => sys::WallClock.denied()
    }
    let HostInput(args: args, environment: environment) = given
    return Some(host_world(world.fs, net: world.net, clock: world.clock, wall: wall, random: world.random, log: world.log, stdio: world.stdio, alloc: world.alloc, exec: world.exec, args: Untrusted.of(take args), environment: Untrusted.of(take environment)))
} host_of

/// The `host::World` holding these capabilities, arguments and environment.
fn host_world(fs: sys::Fs, net: sys::Net, clock: sys::Clock, wall: sys::WallClock, random: sys::Random, log: sys::Log, stdio: sys::Stdio, alloc: mem::Alloc, exec: task::Executor, take args: Untrusted[mem::List[mem::Bytes]], take environment: Untrusted[mem::Map[mem::Bytes, mem::Bytes]]) -> host::World

fn returned[O: Encode](output: O, alloc: mem::Alloc) -> Ended {
    return Ended.Returned(encoded(output, alloc))
} returned

fn encoded[T: Encode](value: T, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return bytes
} encoded

fn failed[E: Render](failure: E, alloc: mem::Alloc) -> Ended {
    var buffer = Array[u8, RENDERED].filled(0)
    let len = render_into(failure, into: mut buffer.view_mut())
    let Some(bytes) = buffer.view().prefix(len) else {
        return Ended.Failed(text::String.empty(alloc))
    }
    match attempt text::String.try_from_utf8(bytes, alloc) {
        Ok(text) => return Ended.Failed(take text)
        Err(_) => return Ended.Failed(text::String.empty(alloc))
    }
} failed

/// Renders a value into `into` within a budget of its length, giving the bytes written.
fn render_into[T: Render](value: T, mut into: SliceMut[u8]) -> usize

/// A capability a table holds: its key, the tag of its type and its handle.
struct Held {
    key: text::String
    tag: u64
    handle: u64
} Held

/// The tag of the capability type, the same in every closure the same toolchain lowers.
fn Cap.tag() -> u64 limits pure, notrap, terminates

/// The handle of a capability.
fn Cap.handle(capability: C) -> u64 limits pure, notrap, terminates

/// The capability whose handle a table holds under the type's tag.
fn Cap.of_handle(word: u64) -> C limits pure, notrap, terminates


/// The nanos world of a test's world, its table empty.
fn tested(world: host::World) -> World {
    return World(alloc: world.alloc, exec: world.exec, clock: world.clock, random: world.random, log: world.log, stdio: world.stdio, fs: world.fs, net: world.net, caps: Caps.empty(world.alloc))
} tested

enum Odd derives Render {
    Odd
    Cancelled(task::Cancelled) from
} Odd

fn halved(take world: World, take input: u32) -> u32 fails Odd {
    if input % 2 == 1 {
        fail Odd.Odd
    }
    return input / 2
} halved

enum Walled derives Render {
    Revoked(sys::Revoked) from
    Cancelled(task::Cancelled) from
} Walled

fn walled(take world: host::World) -> u8 fails Walled {
    discard try world.wall.now_ns()
    return 1
} walled

fn printed(take world: host::World) fails Walled {
    discard try world.clock.elapsed_ns()
} printed

test typed_jobs_return_decode_and_fail for typed {
    let world = testing::world()
    let even = typed(tested(world), input: encoded(42u32, alloc: world.alloc), main: halved)
    let odd = typed(tested(world), input: encoded(7u32, alloc: world.alloc), main: halved)
    let undecodable = typed(tested(world), input: mem::Bytes.empty(world.alloc), main: halved)
    let half = match even {
        Ended.Returned(bytes) => attempt mem::wire::Codec[u32].decode(Untrusted.of(bytes.view()), alloc: world.alloc) == Ok(21)
        else => false
    }
    let failure = match odd {
        Ended.Failed(text) => text.as_str() == "Odd.Odd"
        else => false
    }
    let refused = match undecodable {
        Ended.Undecodable => true
        else => false
    }
    expect half
    expect failure
    expect refused
} typed_jobs_return_decode_and_fail

test host_jobs_get_a_denied_wall_clock for hosted {
    let world = testing::world()
    var args = mem::List[mem::Bytes].empty(world.alloc)
    mut args.push(mem::Bytes.empty(world.alloc))
    mut args.push(mem::Bytes.empty(world.alloc))
    let input = HostInput(args: take args, environment: mem::Map[mem::Bytes, mem::Bytes].empty(world.alloc))
    let denied = hosted(tested(world), input: encoded(input, alloc: world.alloc), main: walled)
    let ended = hosted_unit(tested(world), input: encoded(input, alloc: world.alloc), main: printed)
    let failure = match denied {
        Ended.Failed(text) => text.as_str() == "Walled.Revoked(Revoked.Stale)"
        else => false
    }
    let status = match ended {
        Ended.Returned(bytes) => attempt mem::wire::Codec[u8].decode(Untrusted.of(bytes.view()), alloc: world.alloc) == Ok(0)
        else => false
    }
    expect failure
    expect status
} host_jobs_get_a_denied_wall_clock

test lookups_match_key_and_type for Cap.get {
    let world = testing::world()
    var caps = Caps.empty(world.alloc)
    mut Cap[sys::Clock].put(mut caps, key: "clock", capability: world.clock)
    mut Cap[sys::Log].put(mut caps, key: "log", capability: world.log)
    let found = attempt Cap[sys::Clock].get(caps, key: "clock")
    let other_type = attempt Cap[sys::Log].get(caps, key: "clock")
    let other_key = attempt Cap[sys::Clock].get(caps, key: "log")
    expect found.is_ok() and other_type.is_err() and other_key.is_err()
} lookups_match_key_and_type

test put_replaces_a_key for Cap.put {
    let world = testing::world()
    var caps = Caps.empty(world.alloc)
    mut Cap[sys::Log].put(mut caps, key: "out", capability: world.log)
    mut Cap[sys::Clock].put(mut caps, key: "out", capability: world.clock)
    let replaced = attempt Cap[sys::Log].get(caps, key: "out")
    let kept = attempt Cap[sys::Clock].get(caps, key: "out")
    expect replaced.is_err() and kept.is_ok()
} put_replaces_a_key

test empty_table_holds_nothing for Caps.empty {
    let world = testing::world()
    let caps = Caps.empty(world.alloc)
    let found = attempt Cap[sys::Clock].get(caps, key: "clock")
    expect found.is_err()
} empty_table_holds_nothing

enum Over derives Render, Encode {
    Over
} Over

protocol Counted {
    pub fn add(amount: u32) -> u64 fails Over limits pure
} Counted

struct CountedEnv {
} CountedEnv

impl CountedEnv: Environment

fn CountedEnv.build(take world: World) -> CountedEnv = CountedEnv()

struct Count derives Encode {
    total: u64
} Count

impl Count: sys::Component[CountedEnv, Counted]

fn Count.start(mut env: CountedEnv) -> Count = Count(total: 0)

fn Count.add(mut self, take amount: u32, mut env: CountedEnv, mut cx: sys::Cx[Counted]) -> u64 fails Over {
    if amount > 100 {
        fail Over.Over
    }
    self.total += u64.widen(amount)
    return self.total
} Count.add

test instances_answer_calls_and_end_with_their_state for Hosted.run {
    let world = testing::world()
    var total: u64 = 0
    var ended = Ended.Undecodable
    try await task::scope(world.exec, body: fn[mut total, mut ended](s: task::Scope) fails InstanceError uses wait {
        let Opened(instance: opening, launch: launch, ending: ending, last: last) = opened(s, checkpoint: None, alloc: world.alloc)
        let granted = tested(world)
        discard s.spawn(fn[take granted, take launch, take ending, take last]() fails task::Cancelled uses wait {
            let given = try await Hosted[Count, CountedEnv, Counted].run(take granted, take launch)
            discard attempt await ending.send(Routed.Ended)
            discard attempt await last.send(take given)
        })
        var instance = opening
        defer take instance.abandon()
        var request = sys::Encoded.empty(world.alloc)
        let added = sys::Wire[Counted].add(mut request, amount: 5)
        let caller = instance.inbox()
        let answered = s.spawn(fn[take caller, take request]() -> Result[sys::Encoded, sys::CallError[Never]] fails task::Cancelled uses wait {
            return attempt await caller.call(sys::Wire[Counted].hash(), take request, alloc: world.alloc)
        })
        try await instance.incoming()
        let stepped = try await mut instance.step()
        expect stepped
        let Ok(reply) = try await take answered.join() else {
            expect false
            return
        }
        let Ok(sum) = attempt added.decode(Untrusted.of(reply.bytes.view()), handles: reply.handles.view(), alloc: world.alloc) else {
            expect false
            return
        }
        total = sum
        undefer instance
        ended = try await take instance.end()
    })
    expect total == 5
    let Ended.Returned(state) = ended else {
        expect false
        return
    }
    let Ok(last) = attempt mem::wire::Codec[Count].decode(Untrusted.of(state.view()), alloc: world.alloc) else {
        expect false
        return
    }
    expect last.total == 5
} instances_answer_calls_and_end_with_their_state

test requests_a_domain_never_takes_end_with_it for Instance.ask {
    let world = testing::world()
    var stepped: Option[Result[bool, InstanceError]] = None
    var called: Option[Result[sys::Encoded, sys::CallError[Never]]] = None
    var ended = Ended.Undecodable
    try await task::scope(world.exec, body: fn[mut stepped, mut called, mut ended](s: task::Scope) fails task::Cancelled uses wait {
        let Opened(instance: opening, launch: launch, ending: ending, last: last) = opened(s, checkpoint: None, alloc: world.alloc)
        discard s.spawn(fn[take ending, take last]() fails task::Cancelled uses wait {
            discard attempt await ending.send(Routed.Ended)
            discard attempt await last.send(Ended.Undecodable)
        })
        var instance = opening
        stepped = Some(attempt await mut instance.step())
        let inbox = instance.inbox()
        called = Some(attempt await inbox.call(sys::Wire[Counted].hash(), request: sys::Encoded.empty(world.alloc), alloc: world.alloc))
        ended = try await take instance.end()
        discard launch
    })
    let Some(Err(InstanceError.Ended)) = stepped else {
        expect false
        return
    }
    let Some(Err(sys::CallError.Closed(task::SendError.Closed))) = called else {
        expect false
        return
    }
    let Ended.Undecodable = ended else {
        expect false
        return
    }
} requests_a_domain_never_takes_end_with_it
