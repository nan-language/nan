//! Structural properties: linear, view, Copy, Send, Inert and AnyBits of every type, computed from structure for structs and enums and read from the owning chapters' tables for base types; with capability types, interior mutability and state tokens.

struct Props derives Copy, Eq, Default {
    is_linear: bool
    view: bool
    copy: bool
    send: bool
    inert: bool
    any_bits: bool
} Props

/// The properties of a number.
const NUMBER_PROPS: Props = Props(is_linear: false, view: false, copy: true, send: true, inert: true, any_bits: true)

pkg enum Property derives Copy, Eq {
    Linear
    View
    Copy
    Send
    Inert
    AnyBits
} Property

/// How a base type has a property.
enum Rule derives Copy {
    No
    Yes
    /// Exactly when its first type argument has it.
    First
    /// Exactly when every type argument has it, brands excepted.
    All
    /// When at least one type argument has it.
    Some
} Rule

/// The six properties of a base type, in the order linear, view, Copy, Send, Inert, AnyBits.
fn property_rules(
    linear_rule: Rule,
    view: Rule,
    copy: Rule,
    send: Rule,
    inert: Rule,
    any_bits: Rule,
    ) -> Array[Rule, 6] {
    var written = Array[Rule, 6].filled(linear_rule)
    written[1] = view
    written[2] = copy
    written[3] = send
    written[4] = inert
    written[5] = any_bits
    return written
} property_rules

const AFFINE_SEND: Array[Rule, 6] = property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.Yes, inert: Rule.No, any_bits: Rule.No)

const COPY_SEND: Array[Rule, 6] = property_rules(Rule.No, view: Rule.No, copy: Rule.Yes, send: Rule.Yes, inert: Rule.No, any_bits: Rule.No)

const LINEAR_SEND: Array[Rule, 6] = property_rules(Rule.Yes, view: Rule.No, copy: Rule.No, send: Rule.Yes, inert: Rule.No, any_bits: Rule.No)

const LINEAR_ONLY: Array[Rule, 6] = property_rules(Rule.Yes, view: Rule.No, copy: Rule.No, send: Rule.No, inert: Rule.No, any_bits: Rule.No)

const VIEW_ONLY: Array[Rule, 6] = property_rules(Rule.No, view: Rule.Yes, copy: Rule.No, send: Rule.No, inert: Rule.No, any_bits: Rule.No)

const SEND_INERT_AS: Array[Rule, 6] = property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.First, inert: Rule.First, any_bits: Rule.No)

const VIEW_SEND_INERT_AS: Array[Rule, 6] = property_rules(Rule.No, view: Rule.Yes, copy: Rule.No, send: Rule.First, inert: Rule.First, any_bits: Rule.No)

/// The properties of the base types, by canonical path; none for another path.
fn base_type_facts(path: Str) -> Option[Array[Rule, 6]] {
    return match path {
        "core::Array" => Some(property_rules(Rule.First, view: Rule.First, copy: Rule.First, send: Rule.First, inert: Rule.First, any_bits: Rule.First))
        "core::Option" or "core::Result" => Some(property_rules(Rule.Some, view: Rule.Some, copy: Rule.All, send: Rule.All, inert: Rule.All, any_bits: Rule.No))
        "core::Untrusted" => Some(property_rules(Rule.First, view: Rule.First, copy: Rule.First, send: Rule.First, inert: Rule.First, any_bits: Rule.No))
        "core::Secret" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.Yes, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "core::Slice" or "core::SliceMut" => Some(VIEW_SEND_INERT_AS)
        "core::Str" => Some(property_rules(Rule.No, view: Rule.Yes, copy: Rule.No, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "core::SliceCursor" or "core::SliceCursorMut" => Some(VIEW_SEND_INERT_AS)
        "core::ArrayCursor" => Some(property_rules(Rule.First, view: Rule.First, copy: Rule.No, send: Rule.First, inert: Rule.First, any_bits: Rule.No))
        "core::CharCursor" => Some(property_rules(Rule.No, view: Rule.Yes, copy: Rule.No, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "core::atomic::AtomicU8" or "core::atomic::AtomicU16" or "core::atomic::AtomicU32" => Some(AFFINE_SEND)
        "core::atomic::AtomicU64" or "core::atomic::AtomicUsize" or "core::atomic::AtomicBool" => Some(AFFINE_SEND)
        "mem::Alloc" or "mem::Heap" => Some(COPY_SEND)
        "mem::Budget" => Some(LINEAR_SEND)
        "mem::Id" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.Yes, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.Yes))
        "mem::Handle" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.Yes, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "mem::Arena" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.First, inert: Rule.No, any_bits: Rule.No))
        "mem::OnceMap" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.All, inert: Rule.No, any_bits: Rule.No))
        "mem::List" or "mem::ListCursor" => Some(property_rules(Rule.First, view: Rule.No, copy: Rule.No, send: Rule.First, inert: Rule.First, any_bits: Rule.No))
        "mem::Pool" or "mem::Shared" => Some(SEND_INERT_AS)
        "mem::Map" or "mem::HashMap" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.All, inert: Rule.All, any_bits: Rule.No))
        "mem::Set" => Some(SEND_INERT_AS)
        "mem::MapIntoCursor" or "mem::HashMapIntoCursor" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.All, inert: Rule.All, any_bits: Rule.No))
        "mem::SetIntoCursor" or "mem::BoundedCursor" => Some(SEND_INERT_AS)
        "mem::Bytes" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "mem::Bounded" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.First, send: Rule.First, inert: Rule.First, any_bits: Rule.No))
        "mem::Entry" => Some(property_rules(Rule.No, view: Rule.Yes, copy: Rule.No, send: Rule.All, inert: Rule.All, any_bits: Rule.No))
        "mem::ArenaCursor" or "mem::PoolCursor" => Some(VIEW_SEND_INERT_AS)
        "mem::MapCursor" or "mem::MapCursorMut" or "mem::HashMapCursor" or "mem::HashMapCursorMut" => Some(property_rules(Rule.No, view: Rule.Yes, copy: Rule.No, send: Rule.All, inert: Rule.All, any_bits: Rule.No))
        "mem::SetCursor" => Some(VIEW_SEND_INERT_AS)
        "mem::Box" => Some(property_rules(Rule.First, view: Rule.No, copy: Rule.No, send: Rule.First, inert: Rule.First, any_bits: Rule.No))
        "text::String" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "text::Fixed" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.Yes, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "text::Interner" => Some(AFFINE_SEND)
        "task::Scope" => Some(property_rules(Rule.No, view: Rule.Yes, copy: Rule.No, send: Rule.Yes, inert: Rule.No, any_bits: Rule.No))
        "task::Join" => Some(property_rules(Rule.First, view: Rule.No, copy: Rule.No, send: Rule.No, inert: Rule.No, any_bits: Rule.No))
        "task::Cown" or "task::Sender" => Some(AFFINE_SEND)
        "task::Receiver" => Some(property_rules(Rule.First, view: Rule.No, copy: Rule.No, send: Rule.Yes, inert: Rule.No, any_bits: Rule.No))
        "task::Executor" => Some(COPY_SEND)
        "sys::Fs" or "sys::Net" or "sys::Clock" or "sys::WallClock" or "sys::Random" or "sys::Log" or "sys::Stdio" => Some(COPY_SEND)
        "sys::fs::File" or "sys::net::Listener" => Some(AFFINE_SEND)
        "sys::net::Conn" or "sys::Revoker" or "sys::Minter" => Some(LINEAR_SEND)
        "sys::Cx" => Some(VIEW_ONLY)
        "sys::Outbox" => Some(COPY_SEND)
        "sys::Abandoner" => Some(AFFINE_SEND)
        "sys::Stepper" => Some(LINEAR_ONLY)
        "hw::Ptr" or "hw::UserAddr" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.Yes, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.Yes))
        "hw::Register" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.Yes, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "hw::Mmio" or "hw::Ports" or "hw::Dma" or "hw::DmaShared" or "hw::Ring0" or "hw::PageTableRoot" or "hw::IdtInstalled" => Some(LINEAR_SEND)
        "hw::Idt" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.Yes, inert: Rule.Yes, any_bits: Rule.No))
        "hw::IrqContext" or "hw::SavedContext" or "hw::SpinGuard" => Some(LINEAR_ONLY)
        "hw::TrapFrame" or "hw::Anchor" => Some(property_rules(Rule.No, view: Rule.No, copy: Rule.No, send: Rule.No, inert: Rule.No, any_bits: Rule.No))
        "hw::Region" or "hw::PhysFrame" or "hw::IrqShared" => Some(LINEAR_SEND)
        "hw::Signal" or "hw::SpinLock" or "hw::PerCpu" or "hw::RunQueue" => Some(AFFINE_SEND)
        "hw::Resumable" => Some(COPY_SEND)
        "boot::Machine" or "boot::Kernel" => Some(LINEAR_ONLY)
        "boot::Services" => Some(VIEW_ONLY)
        else => None
    }
} base_type_facts

/// The primitive capabilities, by canonical path.
const PRIMITIVE_CAPABILITIES: Str = "mem::Alloc mem::Budget mem::Heap task::Executor sys::Fs sys::Net sys::Clock sys::WallClock sys::Random sys::Log sys::Stdio sys::fs::File sys::net::Listener sys::net::Conn sys::Revoker sys::Minter boot::Machine boot::Kernel boot::Services hw::Mmio hw::Ports hw::Dma hw::DmaShared hw::Ring0 hw::PageTableRoot hw::Region hw::PhysFrame hw::IrqShared"

/// The base types with interior mutability, by canonical path.
const INTERIOR_TYPES: Str = "task::Cown core::atomic::AtomicU8 core::atomic::AtomicU16 core::atomic::AtomicU32 core::atomic::AtomicU64 core::atomic::AtomicUsize core::atomic::AtomicBool mem::Arena mem::OnceMap text::Interner hw::SpinLock hw::IrqShared hw::PerCpu hw::Signal sys::Abandoner"

/// The std types whose type parameters other than the first are brands, affecting no property.
const BRANDED_TYPES: Str = "mem::Pool mem::Handle mem::PoolCursor"

fn Props.has(self, property: Property) -> bool {
    return match property {
        Property.Linear => self.is_linear
        Property.View => self.view
        Property.Copy => self.copy
        Property.Send => self.send
        Property.Inert => self.inert
        Property.AnyBits => self.any_bits
    }
} Props.has

/// The position of a property in the facts of a base type.
fn Property.index(self) -> usize
    ensures result < 6
{
    return match self {
        Property.Linear => 0
        Property.View => 1
        Property.Copy => 2
        Property.Send => 3
        Property.Inert => 4
        Property.AnyBits => 5
    }
} Property.index

/// The facts of a base type, when the item is one.
fn Checker.base_facts(self, item: ty::ItemId) -> Option[Array[Rule, 6]] {
    let db = self.db()
    if not db.is_std(item) {
        return None
    }
    return base_type_facts(db.canonical_text(item))
} Checker.base_facts

/// Whether an item is a base type, whose properties its owning chapter gives.
pkg fn Checker.is_base_type(self, item: ty::ItemId) -> bool {
    return self.base_facts(item).is_some()
} Checker.is_base_type

/// Whether a type item is a primitive capability: one std lists, or a capability kind.
fn Checker.is_primitive_capability(self, item: ty::ItemId) -> bool {
    let db = self.db()
    return (db.is_std(item) and is_listed(PRIMITIVE_CAPABILITIES, word: db.canonical_text(item))) or self.is_kind(item)
} Checker.is_primitive_capability

/// The properties of a type, as code of the item `from` sees them.
fn Checker.props(self, ty: ty::Ty) -> Props {
    let types = self.types()
    return match types.kind(ty) {
        ty::TyKind.Scalar(scalar) => match scalar {
            ty::Scalar.Bool or ty::Scalar.Char => Props(is_linear: false, view: false, copy: true, send: true, inert: true, any_bits: false)
            else => NUMBER_PROPS
        }
        ty::TyKind.Unit => NUMBER_PROPS
        ty::TyKind.Never => Props(is_linear: false, view: false, copy: true, send: true, inert: true, any_bits: false)
        ty::TyKind.Error => Props(is_linear: false, view: false, copy: true, send: true, inert: true, any_bits: true)
        ty::TyKind.Fn(id) => fn_props(types.fn_of(id))
        ty::TyKind.Dyn(_) => Props(is_linear: false, view: true, copy: false, send: false, inert: false, any_bits: false)
        ty::TyKind.Registers(_) => Props(is_linear: false, view: false, copy: false, send: false, inert: false, any_bits: false)
        ty::TyKind.Param(param) => self.param_props(param)
        ty::TyKind.Item(item: item, args: args) => self.item_props(item, args: types.arg_list(args))
    }
} Checker.props

pkg fn Checker.has(self, ty: ty::Ty, property: Property) -> bool {
    return self.props(ty).has(property)
} Checker.has

fn Checker.item_props(self, item: ty::ItemId, args: Slice[ty::Arg]) -> Props {
    let db = self.db()
    var type_args = mem::List[ty::Ty].empty(self.alloc())
    for arg in args {
        match arg {
            ty::Arg.Ty(arg_ty) => mut type_args.push(arg_ty)
            ty::Arg.Const(_) => {}
        }
    }
    match self.base_facts(item) {
        Some(facts) => {
            var count = type_args.len()
            if is_listed(BRANDED_TYPES, word: db.canonical_text(item)) and count > 1 {
                count = 1
            }
            let Some(considered) = type_args.view().prefix(count) else {
                expect false
                return NUMBER_PROPS
            }
            let is_linear = self.applies(facts[0], property: Property.Linear, considered)
            let view = self.applies(facts[1], property: Property.View, considered)
            let copy = self.applies(facts[2], property: Property.Copy, considered)
            let send = self.applies(facts[3], property: Property.Send, considered)
            let inert = self.applies(facts[4], property: Property.Inert, considered)
            let any_bits = self.applies(facts[5], property: Property.AnyBits, considered)
            return Props(is_linear: is_linear, view: view, copy: copy, send: send, inert: inert, any_bits: any_bits)
        }
        None => {}
    }
    let node = db.ast(item)
    match node.kind {
        ast::ItemKind.Layout(layout_item) => {
            var props = NUMBER_PROPS
            props.any_bits = layout_item.tags.is_none() and self.layout_fields_any_bits(item, layout_item)
            return props
        }
        else => {}
    }
    let definition = self.definition_props(item)
    var is_linear = node.has_modifier(ast::TypeModifier.Linear)
    if not is_linear {
        for arg_ty in type_args {
            if self.has(arg_ty, property: Property.Linear) {
                is_linear = true
                break
            }
        }
    }
    let view = node.has_modifier(ast::TypeModifier.View)
    let copy = not is_linear and not view and self.dependent_holds(item, definition, property: Property.Copy, type_args: type_args.view())
    let send = self.dependent_holds(item, definition, property: Property.Send, type_args: type_args.view())
    let inert = self.dependent_holds(item, definition, property: Property.Inert, type_args: type_args.view())
    let any_bits = self.dependent_holds(item, definition, property: Property.AnyBits, type_args: type_args.view())
    return Props(is_linear: is_linear, view: view, copy: copy, send: send, inert: inert, any_bits: any_bits)
} Checker.item_props

/// Whether a base type's rule gives it a property, from the type arguments considered.
fn Checker.applies(self, rule: Rule, property: Property, considered: Slice[ty::Ty]) -> bool {
    match rule {
        Rule.No => return false
        Rule.Yes => return true
        Rule.First => return considered.len() > 0 and self.has(considered[0], property)
        Rule.All => {
            for arg_ty in considered {
                if not self.has(arg_ty, property) {
                    return false
                }
            }
            return true
        }
        Rule.Some => {
            for arg_ty in considered {
                if self.has(arg_ty, property) {
                    return true
                }
            }
            return false
        }
    }
} Checker.applies

/// Whether every typed field of a layout is AnyBits.
fn Checker.layout_fields_any_bits(self, item: ty::ItemId, layout_item: ast::LayoutItem) -> bool {
    let sig = self.sig(item)
    let SigKind.Layout(fields: fields, tags: _, bits: _) = sig.contents().kind else {
        return false
    }
    for index in 0..<layout_item.fields.len() {
        if index >= fields.len() {
            break
        }
        let ast::LayoutFieldKind.Typed(ty: _, at: _) = layout_item.fields[index].kind else {
            continue
        }
        if not self.has(fields[index].ty, property: Property.AnyBits) {
            return false
        }
    }
    return true
} Checker.layout_fields_any_bits

/// Whether a struct or enum instantiation has a property its definition has: each type
/// argument at a parameter the property depends on has it.
fn Checker.dependent_holds(self, item: ty::ItemId, definition: Props, property: Property, type_args: Slice[ty::Ty]) -> bool {
    if not definition.has(property) {
        return false
    }
    for index in self.dependent_params(item, property) {
        if index < type_args.len() and not self.has(type_args[index], property) {
            return false
        }
    }
    return true
} Checker.dependent_holds

/// The properties of a struct or enum at its definition, each type parameter assumed to have
/// each property.
fn Checker.definition_props(self, item: ty::ItemId) -> Props {
    let state = self.state.contents()
    let db = self.db()
    db.note(item)
    let key = DefinitionKey(item: item, consumer: self.consumer_view(item))
    match state.definitions.get(key) {
        Some(known) => return known
        None => {}
    }
    let deciding = self.underway.contents().deciding
    match deciding.reread(key) {
        Some(Some(provisional)) => return provisional
        Some(None) => return self.assumed_props(item)
        None => {}
    }
    let opened = deciding.start(key, alloc: self.alloc())
    let props = self.about(Some(item), compute: fn() => self.compute_definition_props(item))
    if deciding.finish(opened, props, alloc: self.alloc()) {
        discard state.definitions.insert(key, value: props)
    }
    return props
} Checker.definition_props

/// The definitions whose properties are being decided, as Tarjan's search over their
/// constituents. Properties decided through a constituent that reaches a definition still being
/// decided hold only until that one's are decided, and are decided again when next read.
struct Deciding {
    /// The numbers of the decisions under way, outermost first.
    open: cell::Swap[mem::List[u32]]
    /// Each decision, by number.
    decisions: mem::Arena[PropsDecision]
    /// The properties decided while a definition they read is still being decided.
    provisional: cell::Swap[mem::List[ProvisionalProps]]
} Deciding

/// A decision: its definition, and the lowest number of a decision it read, as Tarjan's low
/// link.
struct PropsDecision {
    key: DefinitionKey
    low: core::atomic::AtomicU32
} PropsDecision

/// Properties decided provisionally, with the number of their decision.
struct ProvisionalProps derives Copy {
    number: u32
    props: Props
} ProvisionalProps

fn Deciding.empty(alloc: mem::Alloc) -> Deciding {
    return Deciding(open: cell::Swap.of(mem::List[u32].empty(alloc), alloc), decisions: mem::Arena[PropsDecision].empty(alloc), provisional: cell::Swap.of(mem::List[ProvisionalProps].empty(alloc), alloc))
} Deciding.empty

/// Records that the innermost decision read the decision numbered `number`.
fn Deciding.read(self, number: u32) {
    let open = self.open.get()
    let count = open.len()
    if count == 0 {
        return
    }
    let innermost = self.decisions.at(mem::Id[PropsDecision].of(open[count - 1]))
    if number < innermost.low.load() {
        innermost.low.store(number)
    }
} Deciding.read

/// For a definition being decided, none; for one decided provisionally, its properties.
fn Deciding.reread(self, key: DefinitionKey) -> Option[Option[Props]] {
    for number in self.open.get() {
        if self.decisions.at(mem::Id[PropsDecision].of(number)).key == key {
            self.read(number)
            return Some(None)
        }
    }
    for decided in self.provisional.get() {
        if self.decisions.at(mem::Id[PropsDecision].of(decided.number)).key == key {
            self.read(decided.number)
            return Some(Some(decided.props))
        }
    }
    return None
} Deciding.reread

/// Starts deciding a definition.
fn Deciding.start(self, key: DefinitionKey, alloc: mem::Alloc) -> OpenedDecision {
    let started = self.decisions.push(PropsDecision(key: key, low: core::atomic::AtomicU32.of(0)))
    let number = started.index()
    self.decisions.at(started).low.store(number)
    var open = mem::List[u32].empty(alloc)
    for held in self.open.get() {
        mut open.push(held)
    }
    mut open.push(number)
    return OpenedDecision(number: number, outer: self.open.replace(take open))
} Deciding.start

/// Ends the innermost decision with its properties, giving whether they are decided: no
/// definition it read is still being decided. The properties decided provisionally through
/// one decided so are dropped.
fn Deciding.finish(self, opened: OpenedDecision, props: Props, alloc: mem::Alloc) -> bool {
    self.open.restore(opened.outer)
    let low = self.decisions.at(mem::Id[PropsDecision].of(opened.number)).low.load()
    self.read(low)
    let decided = low == opened.number
    var kept = mem::List[ProvisionalProps].empty(alloc)
    for held in self.provisional.get() {
        if not decided or held.number < opened.number {
            mut kept.push(held)
        }
    }
    if not decided {
        mut kept.push(ProvisionalProps(number: opened.number, props: props))
    }
    discard self.provisional.replace(take kept)
    return decided
} Deciding.finish

/// A decision under way: its number, and the token restoring the decisions under way before it.
struct OpenedDecision derives Copy {
    number: u32
    outer: u32
} OpenedDecision

/// The properties a struct or enum is taken to have while its definition is being decided,
/// through a constituent that reaches it again: those computed from constituents hold.
fn Checker.assumed_props(self, item: ty::ItemId) -> Props {
    let node = self.db().ast(item)
    let is_linear = node.has_modifier(ast::TypeModifier.Linear)
    let view = node.has_modifier(ast::TypeModifier.View)
    return Props(is_linear: is_linear, view: view, copy: false, send: true, inert: true, any_bits: not is_linear and not view)
} Checker.assumed_props

fn Checker.compute_definition_props(self, item: ty::ItemId) -> Props {
    if self.is_kind(item) {
        return Props(is_linear: false, view: false, copy: true, send: true, inert: false, any_bits: false)
    }
    let db = self.db()
    let node = db.ast(item)
    let constituents = self.constituents(item)
    let is_linear = node.has_modifier(ast::TypeModifier.Linear)
    let view = node.has_modifier(ast::TypeModifier.View)
    var has_predicate = false
    match node.kind {
        ast::ItemKind.Struct(structure) => {
            for member in structure.members {
                let predicate = match member {
                    ast::StructMember.Field(field) => field.where_clause.is_some()
                    ast::StructMember.Invariant(_) => true
                }
                if predicate {
                    has_predicate = true
                    break
                }
            }
        }
        else => {}
    }
    let is_enum = match node.kind {
        ast::ItemKind.Enum(_) or ast::ItemKind.Protocol(_) => true
        else => false
    }
    let foreign_open = not db.is_std(item) and node.is_open() and self.consumer_view(item)
    let copy = self.derived_by(item, name: "Copy") and not is_linear and not view
    let send = self.promised(item, constituents: constituents.view(), foreign_open, property: Property.Send, name: "Send")
    let inert = self.promised(item, constituents: constituents.view(), foreign_open, property: Property.Inert, name: "Inert")
    let any_bits = (not foreign_open and not is_linear and not view and not has_predicate and not is_enum and self.constituents_all(item, constituents: constituents.view(), property: Property.AnyBits)) or (foreign_open and self.derived_by(item, name: "AnyBits"))
    return Props(is_linear: is_linear, view: view, copy: copy, send: send, inert: inert, any_bits: any_bits)
} Checker.compute_definition_props

/// Whether a struct's or enum's `derives` clause names an interface.
fn Checker.derived_by(self, item: ty::ItemId, name: Str) -> bool {
    let Some(entries) = self.derive_entries(item) else {
        return false
    }
    for entry in entries {
        if entry.text.as_str() == name {
            return true
        }
    }
    return false
} Checker.derived_by

/// Whether a struct or enum has a promise property: by its derive when it is a foreign open
/// type, otherwise when its constituents have it.
fn Checker.promised(
    self,
    item: ty::ItemId,
    constituents: Slice[ty::Ty],
    foreign_open: bool,
    property: Property,
    name: Str,
    ) -> bool {
    if foreign_open {
        return self.derived_by(item, name)
    }
    return self.constituents_all(item, constituents, property)
} Checker.promised

/// Whether every constituent of a struct or enum has a property, its own type parameters
/// counting as having it.
fn Checker.constituents_all(self, item: ty::ItemId, constituents: Slice[ty::Ty], property: Property) -> bool {
    let types = self.types()
    for constituent in constituents {
        let own = match types.kind(constituent) {
            ty::TyKind.Param(param) => param.owner == item
            else => false
        }
        if not own and not self.has(constituent, property) {
            return false
        }
    }
    return true
} Checker.constituents_all

/// Whether the code being checked sees an open type only as a consumer. Every check runs from
/// the workspace, so a type of another package of the workspace is seen as one.
fn Checker.consumer_view(self, item: ty::ItemId) -> bool {
    let Some(package_id) = self.current_package() else {
        return false
    }
    return package_id != self.db().package_of(item)
} Checker.consumer_view

/// The constituent types of a struct or enum but a flexible struct's kept fields, which
/// derived `Render` and `Encode` pass over.
pkg fn Checker.declared_constituents(self, item: ty::ItemId) -> mem::List[ty::Ty] {
    let sig = self.sig(item)
    let SigKind.Struct(fields: fields) = sig.contents().kind else {
        return self.constituents(item)
    }
    var found = mem::List[ty::Ty].empty(self.alloc())
    for field in fields {
        if not field.is_kept() {
            mut found.push(field.ty)
        }
    }
    return found
} Checker.declared_constituents

/// The field and payload types of a struct or enum, over its own type parameters.
pkg fn Checker.constituents(self, item: ty::ItemId) -> mem::List[ty::Ty] {
    var found = mem::List[ty::Ty].empty(self.alloc())
    let sig = self.sig(item)
    match sig.contents().kind {
        SigKind.Struct(fields: fields) => {
            for field in fields {
                mut found.push(field.ty)
            }
        }
        SigKind.Enum(variants: variants) or SigKind.Protocol(operations: _, variants: variants, summary: _) => {
            for variant in variants {
                match variant.payload {
                    Payload.None => {}
                    Payload.Single(payload_ty) => mut found.push(payload_ty)
                    Payload.Labelled(labelled) => {
                        for field in labelled {
                            mut found.push(field.ty)
                        }
                    }
                }
            }
        }
        SigKind.Layout(fields: fields, tags: _, bits: _) => {
            for field in fields {
                mut found.push(field.ty)
            }
        }
        else => {}
    }
    return found
} Checker.constituents

/// The indexes of the type parameters of a struct or enum that a property depends on: those
/// occurring at a dependent position of a constituent.
fn Checker.dependent_params(self, item: ty::ItemId, property: Property) -> mem::List[usize] {
    var seen = mem::List[ty::ItemId].empty(self.alloc())
    return self.dependent_params_from(item, property, mut seen)
} Checker.dependent_params

/// The dependent parameters of a struct or enum, those of the items in `seen`, being decided
/// through a constituent reaching them again, counted as none, as are those of an item
/// without parameters.
fn Checker.dependent_params_from(self, item: ty::ItemId, property: Property, mut seen: mem::List[ty::ItemId]) -> mem::List[usize] {
    let alloc = self.alloc()
    var found = mem::List[usize].empty(alloc)
    if seen.position(fn(value: ty::ItemId) => value == item).is_some() or self.shapes(item).contents().len() == 0 {
        return found
    }
    mut seen.push(item)
    for constituent in self.constituents(item) {
        self.collect_dependent(constituent, owner: item, property, mut found, mut seen)
    }
    discard mut seen.pop()
    mut found.sort_by(fn(left: usize, right: usize) => left.cmp(right))
    var distinct = mem::List[usize].empty(alloc)
    for index in found {
        let count = distinct.len()
        if count == 0 or distinct[count - 1] != index {
            mut distinct.push(index)
        }
    }
    return distinct
} Checker.dependent_params_from

fn Checker.collect_dependent(
    self,
    ty: ty::Ty,
    owner: ty::ItemId,
    property: Property,
    mut found: mem::List[usize],
    mut seen: mem::List[ty::ItemId],
    ) {
    let types = self.types()
    match types.kind(ty) {
        ty::TyKind.Param(param) => {
            if param.owner == owner and not param.is_self() {
                mut found.push(usize.widen(param.index))
            }
        }
        ty::TyKind.Item(item: item, args: args) => {
            let listed = types.arg_list(args)
            var follows = mem::List[usize].empty(self.alloc())
            match self.base_facts(item) {
                Some(facts) => {
                    match facts[property.index()] {
                        Rule.First => mut follows.push(0)
                        Rule.All or Rule.Some => {
                            for index in 0..<listed.len() {
                                mut follows.push(index)
                            }
                        }
                        else => {}
                    }
                }
                None => {
                    follows = self.dependent_params_from(item, property, mut seen)
                }
            }
            for index in follows {
                if index < listed.len() {
                    match listed[index] {
                        ty::Arg.Ty(arg_ty) => self.collect_dependent(arg_ty, owner, property, mut found, mut seen)
                        ty::Arg.Const(_) => {}
                    }
                }
            }
        }
        else => {}
    }
} Checker.collect_dependent

fn Checker.param_props(self, param: ty::Param) -> Props {
    let db = self.db()
    let alloc = self.alloc()
    var names = mem::List[text::String].empty(alloc)
    for bound in self.param_bounds(param) {
        mut names.push(db.canonical(bound.item))
    }
    let copy = holds_text(names.view(), text: "core::Copy")
    let any = holds_text(names.view(), text: "core::Any") or param.is_self()
    let send = holds_text(names.view(), text: "core::Send")
    let any_bits = holds_text(names.view(), text: "core::AnyBits")
    let view = self.accepts_views(param) and not copy and not send and not any_bits
    return Props(is_linear: any and not copy, view: view, copy: copy, send: send, inert: holds_text(names.view(), text: "core::Inert"), any_bits: any_bits)
} Checker.param_props

/// The bounds of a generic parameter in scope.
fn Checker.param_bounds(self, param: ty::Param) -> mem::List[ty::Bound] {
    let alloc = self.alloc()
    match defined_bounds(self.underway.contents().scope.get().view(), param, alloc) {
        Some(bounds) => return bounds
        None => {}
    }
    let held = self.sig(param.owner)
    let sig = held.contents()
    match defined_bounds(sig.generics.view(), param, alloc) {
        Some(bounds) => return bounds
        None => {}
    }
    match sig.kind {
        SigKind.Interface(methods: methods) => {
            for method in methods {
                match defined_bounds(method.sig.generics.view(), param, alloc) {
                    Some(bounds) => return bounds
                    None => {}
                }
            }
        }
        SigKind.Fn(function) => {
            match defined_bounds(function.generics.view(), param, alloc) {
                Some(bounds) => return bounds
                None => {}
            }
        }
        else => {}
    }
    return mem::List[ty::Bound].empty(alloc)
} Checker.param_bounds

/// The bounds of a parameter among generic parameter definitions, when one defines it.
fn defined_bounds(defs: Slice[GenericDef], param: ty::Param, alloc: mem::Alloc) -> Option[mem::List[ty::Bound]] {
    for def in defs {
        if def.param == param {
            var bounds = mem::List[ty::Bound].empty(alloc)
            for bound in def.bounds {
                mut bounds.push(bound)
            }
            return Some(take bounds)
        }
    }
    return None
} defined_bounds

/// Whether a type parameter accepts view arguments: `Self` or an interface's parameter, a
/// parameter of a `view` struct or enum or of a core type taking any argument.
fn Checker.accepts_views(self, param: ty::Param) -> bool {
    if param.is_self() {
        return true
    }
    let db = self.db()
    let owner = db.ast(param.owner)
    return match owner.kind {
        ast::ItemKind.Interface(_) => param.index < 256
        ast::ItemKind.Struct(_) or ast::ItemKind.Enum(_) => owner.has_modifier(ast::TypeModifier.View) or (db.is_std(param.owner) and is_listed("core::Array core::ArrayCursor core::Option core::Result core::Untrusted core::Slice core::SliceMut", word: db.canonical_text(param.owner)))
        else => false
    }
} Checker.accepts_views

/// Whether a type has interior mutability: it is or contains a base type with it; kept for
/// the reads it is asked under.
pkg fn Checker.has_interior(self, ty: ty::Ty) -> bool {
    let asked = self.asked(ty)
    let state = self.state.contents()
    match state.interior.get(asked) {
        Some(known) => return known
        None => {}
    }
    let interior = self.contains(ty, test_item: fn(ck: Checker, item: ty::ItemId) => ck.is_interior_type(item))
    return state.interior.insert(asked, value: interior)
} Checker.has_interior

/// Whether an item is a std type with interior mutability.
fn Checker.is_interior_type(self, item: ty::ItemId) -> bool {
    let db = self.db()
    if not db.is_std(item) {
        return false
    }
    let path = db.canonical_text(item)
    let state = self.state.contents()
    return match state.interior_types.get(item) {
        Some(known) => known
        None => state.interior_types.insert(item, value: is_listed(INTERIOR_TYPES, word: path))
    }
} Checker.is_interior_type

/// Whether a type is a capability type: a primitive capability, or one holding one among its
/// constituents or at an argument Inert depends on.
pkg fn Checker.is_capability(self, ty: ty::Ty) -> bool {
    return self.contains(ty, test_item: fn(ck: Checker, item: ty::ItemId) => ck.is_primitive_capability(item))
} Checker.is_capability

/// Whether a type is or contains, through its constituents and type arguments, an item the
/// test accepts.
fn Checker.contains(self, ty: ty::Ty, test_item: fn(ck: Checker, item: ty::ItemId) -> bool) -> bool {
    var seen = mem::List[ty::ItemId].empty(self.alloc())
    return self.contains_from(ty, test_item, mut seen)
} Checker.contains

fn Checker.contains_from(self, ty: ty::Ty, test_item: fn(ck: Checker, item: ty::ItemId) -> bool, mut seen: mem::List[ty::ItemId]) -> bool {
    let types = self.types()
    let ty::TyKind.Item(item: item, args: args) = types.kind(ty) else {
        return false
    }
    if test_item(self, item) {
        return true
    }
    for arg in types.arg_list(args) {
        let ty::Arg.Ty(arg_ty) = arg else {
            continue
        }
        if self.contains_from(arg_ty, test_item, mut seen) {
            return true
        }
    }
    if seen.position(fn(value: ty::ItemId) => value == item).is_some() or self.db().is_std(item) {
        return false
    }
    mut seen.push(item)
    for constituent in self.constituents(item) {
        if self.contains_from(constituent, test_item, mut seen) {
            return true
        }
    }
    return false
} Checker.contains_from

/// Whether a type is a state token: a struct declared `view` without fields.
fn Checker.is_state_token(self, ty: ty::Ty) -> bool {
    let ty::TyKind.Item(item: item, args: _) = self.types().kind(ty) else {
        return false
    }
    return self.is_token_item(item)
} Checker.is_state_token

/// Whether an item is a state token's struct: declared `view` without fields.
fn Checker.is_token_item(self, item: ty::ItemId) -> bool {
    let node = self.db().ast(item)
    let ast::ItemKind.Struct(structure) = node.kind else {
        return false
    }
    for member in structure.members {
        match member {
            ast::StructMember.Field(_) => return false
            ast::StructMember.Invariant(_) => {}
        }
    }
    return node.has_modifier(ast::TypeModifier.View) and not self.is_base_type(item)
} Checker.is_token_item

/// Whether a type is or contains a state token.
fn Checker.holds_token(self, ty: ty::Ty) -> bool {
    return self.is_state_token(ty) or self.contains(ty, test_item: fn(ck: Checker, item: ty::ItemId) => ck.is_token_item(item))
} Checker.holds_token

fn fn_props(fn_ty: ty::FnTy) -> Props {
    return match fn_ty.kind {
        ast::FnKind.Task => Props(is_linear: true, view: false, copy: false, send: true, inert: false, any_bits: false)
        else => Props(is_linear: false, view: false, copy: true, send: false, inert: true, any_bits: false)
    }
} fn_props
