//! Divides a hundred by its input, failing on one.

pub closed enum CrashError derives Render {
    One
    Cancelled(task::Cancelled) from
} CrashError

fn main(take world: nanos::World, take input: u32) -> u32 fails CrashError uses wait limits stack 65_536 {
    if input == 1 {
        fail CrashError.One
    }
    return 100 / input
} main
