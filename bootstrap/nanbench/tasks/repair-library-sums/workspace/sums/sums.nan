//! Sums of the readings in a range.

/// The sum of the readings above `floor` and below 1,000.
pub fn total_above(readings: Slice[u32], floor: u32) -> u64 {
    let mut total: u64 = 0
    for reading in readings {
        if reading > floor && reading < 1_000 {
            total += u64.widen(reading)
        }
    }
    total
} total_above
