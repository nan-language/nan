//! Indexes past the end of an array with an index known only at run time, so the kernel halts with the trap's report.

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    take k.anchor(0u8, run: fn(exec: task::Executor) limits stack 16_384 {
        let array = Array[u8, 2].filled(0u8)
        let index = usize.widen(hw::cpu_count())
        discard array[index]
    })
} main
