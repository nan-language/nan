//! Greeters 7, tripling, and 9, adding nine.

contribute greeting::greeters tripling = greeting::Greeter(id: 7, answer: triple)

contribute greeting::greeters adding = greeting::Greeter(id: 9, answer: add_nine)

fn triple(value: u32) -> u32 {
    return value * 3
} triple

fn add_nine(value: u32) -> u32 {
    return value + 9
} add_nine
