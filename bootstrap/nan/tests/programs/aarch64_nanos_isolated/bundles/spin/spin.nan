//! Steps a float series from its input three million times, giving its integer part.

fn main(take world: nanos::World, take input: u32) -> u64 fails task::Cancelled uses wait limits stack 65_536 {
    var value = f64.widen(input)
    for _ in 0u32..<3_000_000 {
        value = value * 0.999_999 + 1.0
    }
    return u64.saturate(value)
} main
