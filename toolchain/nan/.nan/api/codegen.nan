accepted "example magic_of(10) == Magic(multiplier: 0xCCCC_CCCC_CCCC_CCCD, add: false, shift: 3)"
accepted "example magic_of(125) == Magic(multiplier: 0x0624_DD2F_1A9F_BE77, add: true, shift: 7)"
accepted "example magic_of(625) == Magic(multiplier: 0x346D_C5D6_3886_594B, add: false, shift: 7)"
