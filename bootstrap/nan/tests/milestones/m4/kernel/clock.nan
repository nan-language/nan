//! The kernel's clocks: a sleep, a deadline ending a wait no one ends, and the wall clock.

/// The nanoseconds from the Unix epoch to the start of 2020.
const YEAR_2020: u64 = 1_577_836_800_000_000_000

/// Sleeps 2 ms on the kernel's clock, then waits on a signal no one posts under a 1 ms deadline,
/// and reports both once the clock shows the sleep and the deadline ends the wait; then reports
/// that the wall clock reads a time after 2020.
fn keep_time(console: hw::IrqShared[Console], clock: sys::Clock, wall: Option[sys::WallClock], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let silent = mem::Shared.of(hw::Signal[u8].empty(), alloc)
    let Ok(begun) = attempt clock.elapsed_ns() else {
        return
    }
    try await clock.sleep_ns(2_000_000)
    let Ok(slept) = attempt clock.elapsed_ns() else {
        return
    }
    let waited = try await task::within_ns(clock, ns: 1_000_000, body: fn() -> u8 fails task::Cancelled uses wait {
        return try await silent.contents().wait()
    })
    if slept.saturating_sub(begun) >= 2_000_000 and waited == None {
        say(console, text: "clock: slept 2 ms and a deadline ended a wait\n")
    }
    let Some(reader) = wall else {
        return
    }
    let Ok(now) = attempt reader.now_ns() else {
        return
    }
    if now > YEAR_2020 {
        say(console, text: "clock: the wall clock reads a time after 2020\n")
    }
} keep_time
