//! Answers what its typed input asks: an average of readings with floats and lanes, in its own task and in tasks it starts, reported through its world's log, random source and standard output, its file system written, read, listed and moved, and its space's own calls reading a file; a hundred divided by a number, failing for one and reading kernel memory for two; kernel memory read in a domain of its own, then again outside it; the sum of the numbers up to a depth, one call deeper per number, on a stack without a bound; the integer part of a float series stepped three million times from a start; the pages of a number of mebibytes it holds at once, three times over; or, over the channels of its link, a line it reads and answers reversed after saying it is ready.

pub closed struct Readings derives Encode {
    pub values: mem::List[u32]
} Readings

pub closed struct Summary derives Encode {
    pub mean_milli: u64
    pub lanes: u64
    pub entropy: u64
} Summary

pub closed enum Ask derives Encode {
    Average(Readings)
    Divide(u32)
    Sum(u64)
    Spin(u32)
    Hold(u32)
    Echo
    Probe
} Ask

pub closed enum Answer derives Encode {
    Summary(Summary)
    Number(u64)
} Answer

pub closed enum TypedError derives Render {
    One
    Empty
    Revoked(sys::Revoked) from
    Stdio(sys::StdioError) from
    Fs(sys::fs::FsError) from
    Missing(nanos::CapError) from
    Cancelled(task::Cancelled) from
} TypedError

/// Kernel memory outside the image, which an isolated space does not map.
const KERNEL_PROBE: usize = 0x5000_0000

fn main(take world: nanos::World, take input: Ask) -> Answer fails TypedError uses wait {
    match input {
        Ask.Average(readings) => return try await averaged(take world, input: take readings)
        Ask.Divide(divisor) => return Answer.Number(try divided(divisor))
        Ask.Sum(depth) => return Answer.Number(sum(depth))
        Ask.Spin(start) => return Answer.Number(spun(start))
        Ask.Hold(mebibytes) => return Answer.Number(held(mebibytes, alloc: world.alloc))
        Ask.Echo => return Answer.Number(try await echoed(take world))
        Ask.Probe => return Answer.Number(try await probed(world))
    }
} main

fn averaged(take world: nanos::World, take input: Readings) -> Answer fails TypedError uses wait {
    if input.values.len() == 0 {
        fail TypedError.Empty
    }
    var total: f64 = 0.0
    for value in input.values {
        total += f64.widen(value)
    }
    let mean = total / f64.fit(input.values.len())
    let lanes = core::simd::F32x4.splat(1.5).mul(core::simd::F32x4.of(Array[f32, 4].filled(2.0))).sum()
    let clock = world.clock
    let log = world.log
    try await task::scope(world.exec, body: fn(s: task::Scope) fails task::Cancelled uses wait {
        let quarters = s.spawn(fn() -> f64 fails task::Cancelled uses wait limits stack 16_384 {
            return try await series(clock, step: 0.25, count: 20)
        })
        let halves = s.spawn(fn() -> f64 fails task::Cancelled uses wait limits stack 16_384 {
            return try await series(clock, step: 0.5, count: 20)
        })
        let quartered = try await take quarters.join()
        let halved = try await take halves.join()
        log.info("series", value: u64.saturate((quartered + halved) * 100.0))
    })
    var bytes = Array[u8, 8].filled(0)
    try world.random.fill(mut bytes.view_mut())
    world.log.info("mean", value: u64.fit(mean))
    try await filed(world)
    try await world.stdio.write_out(b"averaged\n")
    return Answer.Summary(Summary(mean_milli: u64.saturate(mean * 1000.0), lanes: u64.fit(lanes), entropy: bytes.view().u64_le(0)))
} averaged

/// Writes, reads, lists, moves and removes files through the world's file system, then reads a
/// file, tells a kind, writes a line and writes and reads an open file through the space's own
/// calls, and reads its clock.
fn filed(world: nanos::World) fails TypedError uses wait {
    try await world.fs.write_all("notes/day", data: b"hi")
    let read = try await world.fs.read_all("notes/day", alloc: world.alloc)
    world.log.info("read", value: read.byte_len())
    let listed = try await world.fs.list("", alloc: world.alloc)
    world.log.info("listed", value: listed.len())
    world.log.info("kind", value: try await world.fs.kind("notes"))
    try await world.fs.create_dir("logs")
    try await world.fs.rename("notes/day", to: "logs/day")
    let removed = attempt await world.fs.remove("missing")
    world.log.info("removed", value: removed.is_err())
    let calls = trusted "the job runs in an isolated space" { nanos::SpaceCalls.of_space() }
    let direct = try calls.read_all("notes/day", alloc: world.alloc)
    world.log.info("called read", value: direct.len())
    world.log.info("called kind", value: try calls.kind(""))
    try calls.write_out(b"called\n")
    let created = try calls.create("logs/raw")
    world.log.info("called wrote", value: try calls.write(created, data: b"raw"))
    calls.release(created)
    let opened = try calls.open("logs/raw")
    var part = Array[u8, 3].filled(0)
    world.log.info("called part", value: try calls.read(opened, buf: mut part.view_mut()))
    world.log.info("called length", value: try calls.byte_len(opened))
    calls.release(opened)
    world.log.info("called clock", value: calls.now_ns() > 0)
} filed

/// The sum of `count` steps of a float series, pausing between steps so that other tasks run.
fn series(clock: sys::Clock, step: f64, count: u32) -> f64 fails task::Cancelled uses wait {
    var total: f64 = 0.0
    for _ in 0..<count {
        total += step
        try await clock.sleep_ns(10_000)
    }
    return total
} series

fn divided(divisor: u32) -> u64 fails TypedError {
    if divisor == 1 {
        fail TypedError.One
    }
    if divisor == 2 {
        return probe()
    }
    return u64.widen(100 / divisor)
} divided

/// Reads kernel memory in a domain of its own, logging the kind of the trap ending it, then again.
fn probed(world: nanos::World) -> u64 fails TypedError uses wait {
    let contained = try await sys::Domain.run(fn() -> u64 {
        return probe()
    }, exec: world.exec, alloc: world.alloc)
    match contained {
        Ok(_) => {}
        Err(trap) => world.log.info("contained", value: trap.kind())
    }
    return probe()
} probed

fn probe() -> u64 {
    return trusted "the read faults, an isolated space mapping no kernel memory" { hw::Ptr[u64].of_addr(KERNEL_PROBE).read() }
} probe

fn sum(n: u64) -> u64 {
    if n == 0 {
        return 0
    }
    return n.wrapping_add(sum(n - 1))
} sum

fn spun(start: u32) -> u64 {
    var value = f64.widen(start)
    for _ in 0u32..<3_000_000 {
        value = value * 0.999_999 + 1.0
    }
    return u64.saturate(value)
} spun

/// The pages of `mebibytes` mebibytes, held at once and each written, in each of three rounds.
fn held(mebibytes: u32, alloc: mem::Alloc) -> u64 {
    var pages: u64 = 0
    for _ in 0u32..<3 {
        var bytes = mem::Bytes.zeroed(usize.widen(mebibytes) * 1_048_576, alloc)
        var at: usize = 0
        while at < bytes.len() {
            bytes[at] = 1
            pages += 1
            at += 4_096
        }
    }
    return pages / 3
} held

/// Says on the channel `answer` that it is ready, reads a line from the channel `ask` and writes
/// it reversed on `answer`, giving the nanoseconds the read waited.
fn echoed(take world: nanos::World) -> u64 fails TypedError uses wait {
    let ask = try nanos::Cap[sys::Stdio].get(world.caps, key: "ask")
    let answer = try nanos::Cap[sys::Stdio].get(world.caps, key: "answer")
    try await answer.write_out(b"ready")
    let started = try world.clock.elapsed_ns()
    var line = Untrusted.of(mem::Bytes.zeroed(16, alloc: world.alloc))
    let count = try await ask.read_in(mut line.view_mut())
    let waited = try world.clock.elapsed_ns() - started
    let Some(read) = line.view().prefix(count) else {
        fail TypedError.Empty
    }
    try await answer.write_out(reversed(read, alloc: world.alloc).view())
    return waited
} echoed

/// The bytes of a line, last first.
validator fn reversed(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes {
    let bytes = raw.inspect()
    var out = mem::Bytes.empty(alloc)
    var at = bytes.len()
    while at > 0 {
        at -= 1
        mut out.push(bytes[at])
    }
    return out
} reversed
