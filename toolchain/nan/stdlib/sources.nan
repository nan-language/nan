    \\struct Probe derives Encode {
    \\    handled: u64
    \\} Probe
    \\
    \\struct ProbeEnv {
    \\    clock: Clock
    \\} ProbeEnv
    \\
    \\enum ProbeMessage {
    \\    Count
    \\    Echo
    \\    Delay
    \\    DelayNs
    \\    Spawn(u64)
    \\    Stop
    \\} ProbeMessage
    \\
    \\impl Probe: Component[ProbeEnv, ProbeMessage]
    \\
    \\struct Tally {
    \\} Tally
    \\
    \\impl Tally: Kind[core::atomic::AtomicU64, u64]
    \\
    \\fn tallies(start: u64, alloc: mem::Alloc) -> Minter[Tally, core::atomic::AtomicU64, u64] {
    \\    return Minter.of(core::atomic::AtomicU64.of(start), alloc)
    \\} tallies
    \\
    \\fn tally_record(state: core::atomic::AtomicU64, record: u64) -> u64 = record
    \\
    \\fn tally_count(state: core::atomic::AtomicU64, record: u64) -> u64 {
    \\    discard state.fetch_add(record)
    \\    return state.load()
    \\} tally_count
    \\
    \\fn Probe.start(mut env: ProbeEnv) -> Probe = Probe(handled: 0)
    \\
    \\fn Probe.on(mut self, take message: ProbeMessage, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) {
    \\    match message {
    \\        ProbeMessage.Count => {
    \\            self.handled += 1
    \\        }
    \\        ProbeMessage.Echo => mut cx.send(ProbeMessage.Count)
    \\        ProbeMessage.Delay => mut cx.after(ms: 10, send: ProbeMessage.Count)
    \\        ProbeMessage.DelayNs => mut cx.after_ns(ns: 1_500, send: ProbeMessage.Count)
    \\        ProbeMessage.Spawn(ms) => {
    \\            let clock = env.clock
    \\            mut cx.spawn(key: 1, run: fn(out: Outbox[ProbeMessage]) fails task::Cancelled uses wait {
    \\                try await clock.sleep(ms)
    \\                discard attempt await out.post(ProbeMessage.Count)
    \\            })
    \\        }
    \\        ProbeMessage.Stop => mut cx.cancel(key: 1)
    \\    }
    \\} Probe.on
