//! The std source files the toolchain carries, generated from the std directory.

/// A std source file the toolchain carries.
pkg enum StdFile derives Copy, Eq {
    BarePlatformBarePlatform
    BarePlatformPackage
    BootBoot
    BootPackage
    CoreAtomicAtomic
    CoreCore
    CoreCryptoCrypto
    CoreCryptoTests
    CoreEncode
    CoreFloats
    CoreGenerate
    CoreNumbers
    CorePackage
    CoreRender
    CoreSecret
    CoreSequences
    CoreText
    CoreUntrusted
    HostHost
    HostPackage
    HostPlatformFiles
    HostPlatformHostPlatform
    HostPlatformNetwork
    HostPlatformPackage
    HostPlatformStreams
    HostPlatformSystem
    HwHw
    HwPackage
    HwSimSim
    MemMem
    MemPackage
    MemWireWire
    SysFsFs
    SysNetNet
    SysPackage
    SysSimSim
    SysSys
    TaskPackage
    TaskTask
    TestingPackage
    TestingTesting
    TextConstructionConstruction
    TextJsonJson
    TextPackage
    TextText
    TextUtf8Utf8
    UefiPlatformConsole
    UefiPlatformFiles
    UefiPlatformFirmware
    UefiPlatformHandoff
    UefiPlatformMemory
    UefiPlatformPackage
    UefiPlatformTpm
    UefiPlatformUefiPlatform
    UefiPlatformVariables
} StdFile

/// Every std source file, in byte order of path.
pkg fn StdFile.all(alloc: mem::Alloc) -> mem::List[StdFile] {
    var files = mem::List[StdFile].empty(alloc)
    mut files.push(StdFile.BarePlatformBarePlatform)
    mut files.push(StdFile.BarePlatformPackage)
    mut files.push(StdFile.BootBoot)
    mut files.push(StdFile.BootPackage)
    mut files.push(StdFile.CoreAtomicAtomic)
    mut files.push(StdFile.CoreCore)
    mut files.push(StdFile.CoreCryptoCrypto)
    mut files.push(StdFile.CoreCryptoTests)
    mut files.push(StdFile.CoreEncode)
    mut files.push(StdFile.CoreFloats)
    mut files.push(StdFile.CoreGenerate)
    mut files.push(StdFile.CoreNumbers)
    mut files.push(StdFile.CorePackage)
    mut files.push(StdFile.CoreRender)
    mut files.push(StdFile.CoreSecret)
    mut files.push(StdFile.CoreSequences)
    mut files.push(StdFile.CoreText)
    mut files.push(StdFile.CoreUntrusted)
    mut files.push(StdFile.HostHost)
    mut files.push(StdFile.HostPackage)
    mut files.push(StdFile.HostPlatformFiles)
    mut files.push(StdFile.HostPlatformHostPlatform)
    mut files.push(StdFile.HostPlatformNetwork)
    mut files.push(StdFile.HostPlatformPackage)
    mut files.push(StdFile.HostPlatformStreams)
    mut files.push(StdFile.HostPlatformSystem)
    mut files.push(StdFile.HwHw)
    mut files.push(StdFile.HwPackage)
    mut files.push(StdFile.HwSimSim)
    mut files.push(StdFile.MemMem)
    mut files.push(StdFile.MemPackage)
    mut files.push(StdFile.MemWireWire)
    mut files.push(StdFile.SysFsFs)
    mut files.push(StdFile.SysNetNet)
    mut files.push(StdFile.SysPackage)
    mut files.push(StdFile.SysSimSim)
    mut files.push(StdFile.SysSys)
    mut files.push(StdFile.TaskPackage)
    mut files.push(StdFile.TaskTask)
    mut files.push(StdFile.TestingPackage)
    mut files.push(StdFile.TestingTesting)
    mut files.push(StdFile.TextConstructionConstruction)
    mut files.push(StdFile.TextJsonJson)
    mut files.push(StdFile.TextPackage)
    mut files.push(StdFile.TextText)
    mut files.push(StdFile.TextUtf8Utf8)
    mut files.push(StdFile.UefiPlatformConsole)
    mut files.push(StdFile.UefiPlatformFiles)
    mut files.push(StdFile.UefiPlatformFirmware)
    mut files.push(StdFile.UefiPlatformHandoff)
    mut files.push(StdFile.UefiPlatformMemory)
    mut files.push(StdFile.UefiPlatformPackage)
    mut files.push(StdFile.UefiPlatformTpm)
    mut files.push(StdFile.UefiPlatformUefiPlatform)
    mut files.push(StdFile.UefiPlatformVariables)
    return files
} StdFile.all

/// The file's path relative to the std directory.
pkg proj fn StdFile.path(self) -> Str {
    return match self {
        StdFile.BarePlatformBarePlatform => "bare_platform/bare_platform.nan"
        StdFile.BarePlatformPackage => "bare_platform/package.nan"
        StdFile.BootBoot => "boot/boot.nan"
        StdFile.BootPackage => "boot/package.nan"
        StdFile.CoreAtomicAtomic => "core/atomic/atomic.nan"
        StdFile.CoreCore => "core/core.nan"
        StdFile.CoreCryptoCrypto => "core/crypto/crypto.nan"
        StdFile.CoreCryptoTests => "core/crypto/tests.nan"
        StdFile.CoreEncode => "core/encode.nan"
        StdFile.CoreFloats => "core/floats.nan"
        StdFile.CoreGenerate => "core/generate.nan"
        StdFile.CoreNumbers => "core/numbers.nan"
        StdFile.CorePackage => "core/package.nan"
        StdFile.CoreRender => "core/render.nan"
        StdFile.CoreSecret => "core/secret.nan"
        StdFile.CoreSequences => "core/sequences.nan"
        StdFile.CoreText => "core/text.nan"
        StdFile.CoreUntrusted => "core/untrusted.nan"
        StdFile.HostHost => "host/host.nan"
        StdFile.HostPackage => "host/package.nan"
        StdFile.HostPlatformFiles => "host_platform/files.nan"
        StdFile.HostPlatformHostPlatform => "host_platform/host_platform.nan"
        StdFile.HostPlatformNetwork => "host_platform/network.nan"
        StdFile.HostPlatformPackage => "host_platform/package.nan"
        StdFile.HostPlatformStreams => "host_platform/streams.nan"
        StdFile.HostPlatformSystem => "host_platform/system.nan"
        StdFile.HwHw => "hw/hw.nan"
        StdFile.HwPackage => "hw/package.nan"
        StdFile.HwSimSim => "hw/sim/sim.nan"
        StdFile.MemMem => "mem/mem.nan"
        StdFile.MemPackage => "mem/package.nan"
        StdFile.MemWireWire => "mem/wire/wire.nan"
        StdFile.SysFsFs => "sys/fs/fs.nan"
        StdFile.SysNetNet => "sys/net/net.nan"
        StdFile.SysPackage => "sys/package.nan"
        StdFile.SysSimSim => "sys/sim/sim.nan"
        StdFile.SysSys => "sys/sys.nan"
        StdFile.TaskPackage => "task/package.nan"
        StdFile.TaskTask => "task/task.nan"
        StdFile.TestingPackage => "testing/package.nan"
        StdFile.TestingTesting => "testing/testing.nan"
        StdFile.TextConstructionConstruction => "text/construction/construction.nan"
        StdFile.TextJsonJson => "text/json/json.nan"
        StdFile.TextPackage => "text/package.nan"
        StdFile.TextText => "text/text.nan"
        StdFile.TextUtf8Utf8 => "text/utf8/utf8.nan"
        StdFile.UefiPlatformConsole => "uefi_platform/console.nan"
        StdFile.UefiPlatformFiles => "uefi_platform/files.nan"
        StdFile.UefiPlatformFirmware => "uefi_platform/firmware.nan"
        StdFile.UefiPlatformHandoff => "uefi_platform/handoff.nan"
        StdFile.UefiPlatformMemory => "uefi_platform/memory.nan"
        StdFile.UefiPlatformPackage => "uefi_platform/package.nan"
        StdFile.UefiPlatformTpm => "uefi_platform/tpm.nan"
        StdFile.UefiPlatformUefiPlatform => "uefi_platform/uefi_platform.nan"
        StdFile.UefiPlatformVariables => "uefi_platform/variables.nan"
    }
} StdFile.path

/// The file's contents.
pkg proj fn StdFile.text(self) -> Str {
    return match self {
        StdFile.BarePlatformBarePlatform => TEXT_BARE_PLATFORM_BARE_PLATFORM
        StdFile.BarePlatformPackage => TEXT_BARE_PLATFORM_PACKAGE
        StdFile.BootBoot => TEXT_BOOT_BOOT
        StdFile.BootPackage => TEXT_BOOT_PACKAGE
        StdFile.CoreAtomicAtomic => TEXT_CORE_ATOMIC_ATOMIC
        StdFile.CoreCore => TEXT_CORE_CORE
        StdFile.CoreCryptoCrypto => TEXT_CORE_CRYPTO_CRYPTO
        StdFile.CoreCryptoTests => TEXT_CORE_CRYPTO_TESTS
        StdFile.CoreEncode => TEXT_CORE_ENCODE
        StdFile.CoreFloats => TEXT_CORE_FLOATS
        StdFile.CoreGenerate => TEXT_CORE_GENERATE
        StdFile.CoreNumbers => TEXT_CORE_NUMBERS
        StdFile.CorePackage => TEXT_CORE_PACKAGE
        StdFile.CoreRender => TEXT_CORE_RENDER
        StdFile.CoreSecret => TEXT_CORE_SECRET
        StdFile.CoreSequences => TEXT_CORE_SEQUENCES
        StdFile.CoreText => TEXT_CORE_TEXT
        StdFile.CoreUntrusted => TEXT_CORE_UNTRUSTED
        StdFile.HostHost => TEXT_HOST_HOST
        StdFile.HostPackage => TEXT_HOST_PACKAGE
        StdFile.HostPlatformFiles => TEXT_HOST_PLATFORM_FILES
        StdFile.HostPlatformHostPlatform => TEXT_HOST_PLATFORM_HOST_PLATFORM
        StdFile.HostPlatformNetwork => TEXT_HOST_PLATFORM_NETWORK
        StdFile.HostPlatformPackage => TEXT_HOST_PLATFORM_PACKAGE
        StdFile.HostPlatformStreams => TEXT_HOST_PLATFORM_STREAMS
        StdFile.HostPlatformSystem => TEXT_HOST_PLATFORM_SYSTEM
        StdFile.HwHw => TEXT_HW_HW
        StdFile.HwPackage => TEXT_HW_PACKAGE
        StdFile.HwSimSim => TEXT_HW_SIM_SIM
        StdFile.MemMem => TEXT_MEM_MEM
        StdFile.MemPackage => TEXT_MEM_PACKAGE
        StdFile.MemWireWire => TEXT_MEM_WIRE_WIRE
        StdFile.SysFsFs => TEXT_SYS_FS_FS
        StdFile.SysNetNet => TEXT_SYS_NET_NET
        StdFile.SysPackage => TEXT_SYS_PACKAGE
        StdFile.SysSimSim => TEXT_SYS_SIM_SIM
        StdFile.SysSys => TEXT_SYS_SYS
        StdFile.TaskPackage => TEXT_TASK_PACKAGE
        StdFile.TaskTask => TEXT_TASK_TASK
        StdFile.TestingPackage => TEXT_TESTING_PACKAGE
        StdFile.TestingTesting => TEXT_TESTING_TESTING
        StdFile.TextConstructionConstruction => TEXT_TEXT_CONSTRUCTION_CONSTRUCTION
        StdFile.TextJsonJson => TEXT_TEXT_JSON_JSON
        StdFile.TextPackage => TEXT_TEXT_PACKAGE
        StdFile.TextText => TEXT_TEXT_TEXT
        StdFile.TextUtf8Utf8 => TEXT_TEXT_UTF8_UTF8
        StdFile.UefiPlatformConsole => TEXT_UEFI_PLATFORM_CONSOLE
        StdFile.UefiPlatformFiles => TEXT_UEFI_PLATFORM_FILES
        StdFile.UefiPlatformFirmware => TEXT_UEFI_PLATFORM_FIRMWARE
        StdFile.UefiPlatformHandoff => TEXT_UEFI_PLATFORM_HANDOFF
        StdFile.UefiPlatformMemory => TEXT_UEFI_PLATFORM_MEMORY
        StdFile.UefiPlatformPackage => TEXT_UEFI_PLATFORM_PACKAGE
        StdFile.UefiPlatformTpm => TEXT_UEFI_PLATFORM_TPM
        StdFile.UefiPlatformUefiPlatform => TEXT_UEFI_PLATFORM_UEFI_PLATFORM
        StdFile.UefiPlatformVariables => TEXT_UEFI_PLATFORM_VARIABLES
    }
} StdFile.text

const TEXT_BARE_PLATFORM_BARE_PLATFORM: Str =
    \\//! The bare entry landing fn, which mints the kernel root grant, and kernel task preemption.
    \\
    \\/// The bare entry landing fn, which mints the kernel root grant. What the seam records stands
    \\/// behind that grant: the PVH start information on x86_64, and the device tree and a start
    \\/// information on AArch64.
    \\pub landing fn enter(start: usize) -> boot::Kernel limits stack 4_096 {
    \\    discard start
    \\    return hw::mint_root()
    \\} enter
    \\
    \\/// Makes the preempted task ready again and switches its CPU to the next ready task, returning
    \\/// once a later switch resumes it.
    \\landing fn preempted() limits stack 1_024 {
    \\    yield_task()
    \\} preempted
    \\
    \\/// Switches the CPU from the running kernel task, ready again, to its next ready task.
    \\pkg fn yield_task()
    \\
    \\contribute hw::preempt preempt = hw::PreemptEntry(slot: Unit, handler: preempted)
    \\

const TEXT_BARE_PLATFORM_PACKAGE: Str =
    \\//! The platform of the bare targets: the kernel root grant from the start information.
    \\
    \\package bare_platform {
    \\    language 1
    \\    targets aarch64-bare, x86_64-bare
    \\    allow priv in bare_platform
    \\} bare_platform
    \\

const TEXT_BOOT_BOOT: Str =
    \\//! The UEFI and bare root grants, firmware services and the start information.
    \\
    \\/// The offset in a start information of its command line's address.
    \\const INFO_COMMAND_LINE: u64 = 24
    \\
    \\/// The header of an ACPI table: its size; the offsets in the RSDP of its revision, its RSDT's
    \\/// address and its XSDT's address; and the offsets in the FADT of the 32-bit and 64-bit
    \\/// addresses of the FACS and the DSDT.
    \\const HEADER_BYTES: u64 = 36
    \\
    \\const RSDP_REVISION: u64 = 15
    \\
    \\const RSDP_RSDT: u64 = 16
    \\
    \\const RSDP_XSDT: u64 = 24
    \\
    \\const FADT_FACS: u64 = 36
    \\
    \\const FADT_DSDT: u64 = 40
    \\
    \\const FADT_X_FACS: u64 = 132
    \\
    \\const FADT_X_DSDT: u64 = 140
    \\
    \\/// The signatures of the DSDT, the FACS and the FADT, as little-endian words.
    \\const DSDT: u32 = 0x5444_5344
    \\
    \\const FACS: u32 = 0x5343_4146
    \\
    \\const FADT: u32 = 0x5043_4146
    \\
    \\/// The flattened device tree's header words, big-endian: its magic, its size and the offsets of
    \\/// its structure and strings blocks; the structure block's tokens.
    \\const TREE_MAGIC: u32 = 0xD00D_FEED
    \\
    \\const TREE_SIZE: u64 = 4
    \\
    \\const TREE_STRUCTURE: u64 = 8
    \\
    \\const TREE_STRINGS: u64 = 12
    \\
    \\const BEGIN_NODE: u32 = 1
    \\
    \\const END_NODE: u32 = 2
    \\
    \\const PROPERTY: u32 = 3
    \\
    \\const TREE_END: u32 = 9
    \\
    \\/// The offsets in the system table of its configuration table's entry count and address, and an
    \\/// entry's size: a GUID, then the table's address.
    \\const CONFIGURATION_COUNT: u64 = 104
    \\
    \\const CONFIGURATION_TABLE: u64 = 112
    \\
    \\const CONFIGURATION_ENTRY: u64 = 24
    \\
    \\/// The offset in an ACPI 2.0 RSDP of its length; the offsets in the SMBIOS 3.0 entry point of
    \\/// its length and of its structure table's maximum size and address.
    \\const RSDP_LENGTH: u64 = 20
    \\
    \\const SMBIOS_ENTRY_LENGTH: u64 = 6
    \\
    \\const SMBIOS_TABLE_SIZE: u64 = 12
    \\
    \\const SMBIOS_TABLE: u64 = 16
    \\
    \\pub open linear struct Machine {
    \\} Machine
    \\
    \\pub open linear struct Kernel {
    \\} Kernel
    \\
    \\pub fn Kernel.alloc(self) -> mem::Alloc
    \\
    \\pub fn Kernel.clock(self) -> sys::Clock
    \\
    \\pub fn Kernel.wall_clock(self) -> Option[sys::WallClock]
    \\
    \\pub fn Kernel.regions(mut self) -> mem::List[hw::Region]
    \\
    \\pub fn Kernel.ring0(mut self) -> Option[hw::Ring0]
    \\
    \\pub fn Kernel.anchor[S: Any and Send](take self, take state: S, take run: task fn(exec: task::Executor) fails task::Cancelled uses wait) -> Never
    \\
    \\pub fn Kernel.modules(mut self) -> mem::List[Module]
    \\
    \\pub fn Kernel.command_line(self, alloc: mem::Alloc) -> Untrusted[mem::Bytes] {
    \\    let info = start_info()
    \\    if info != 0 {
    \\        return Untrusted.of(text_at(u64_at(info + INFO_COMMAND_LINE), alloc))
    \\    }
    \\    let tree = tree_address()
    \\    if tree != 0 {
    \\        return Untrusted.of(boot_arguments(tree, alloc))
    \\    }
    \\    return Untrusted.of(mem::Bytes.empty(alloc))
    \\} Kernel.command_line
    \\
    \\pub fn Kernel.acpi_table(self, signature: Array[u8, 4], alloc: mem::Alloc) -> Option[Untrusted[mem::Bytes]] {
    \\    let table = acpi_table_address(signature)
    \\    if table == 0 {
    \\        return None
    \\    }
    \\    return Some(Untrusted.of(copied(table, len: u64.widen(u32_at(table + 4)), alloc)))
    \\} Kernel.acpi_table
    \\
    \\pub fn Kernel.device_tree(self, alloc: mem::Alloc) -> Option[Untrusted[mem::Bytes]] {
    \\    let tree = tree_address()
    \\    if tree == 0 {
    \\        return None
    \\    }
    \\    return Some(Untrusted.of(copied(tree, len: u64.widen(u32_be_at(tree + TREE_SIZE)), alloc)))
    \\} Kernel.device_tree
    \\
    \\pub open linear struct Module {
    \\    region: hw::Region
    \\    name_at: u64
    \\} Module
    \\
    \\pub fn Module.name(self, alloc: mem::Alloc) -> Untrusted[mem::Bytes] {
    \\    return Untrusted.of(text_at(self.name_at, alloc))
    \\} Module.name
    \\
    \\pub proj fn Module.contents(self) -> Untrusted[Slice[u8]]
    \\
    \\pub fn Module.into_region(take self) -> hw::Region {
    \\    let Module(region: region, name_at: _) = self
    \\    return region
    \\} Module.into_region
    \\
    \\pub fn Machine.alloc(self) -> mem::Alloc
    \\
    \\pub fn Machine.ring0(mut self) -> Option[hw::Ring0]
    \\
    \\pub fn Machine.with_services[T: Any, E](mut self, body: fn(services: Services) -> T fails E) -> T fails E
    \\
    \\pub fn Machine.exit_services(take self) -> Kernel
    \\
    \\pub fn Machine.enter(take self, take image: Image) -> Never
    \\
    \\pub closed linear struct Image {
    \\    pub entry: u64
    \\    pub segments: mem::List[hw::Region]
    \\    pub modules: mem::List[ModuleSource]
    \\    pub command_line: mem::Bytes
    \\} Image
    \\
    \\pub closed struct ModuleSource {
    \\    pub name: mem::Bytes
    \\    pub contents: Untrusted[mem::Bytes]
    \\} ModuleSource
    \\
    \\pub open view struct Services {
    \\} Services
    \\
    \\pub fn Services.write_console(self, text: Str) fails ServiceError
    \\
    \\pub fn Services.read_key(self, timeout_ms: u64) -> Option[Key] fails ServiceError
    \\
    \\pub fn Services.read_file(self, path: Str, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails ServiceError
    \\
    \\pub fn Services.write_file(self, path: Str, data: Slice[u8]) fails ServiceError
    \\
    \\pub fn Services.delete_file(self, path: Str) fails ServiceError
    \\
    \\pub fn Services.list_directory(self, path: Str, alloc: mem::Alloc) -> mem::List[DirectoryEntry] fails ServiceError
    \\
    \\pub fn Services.boot_device(self, alloc: mem::Alloc) -> BootDevice fails ServiceError
    \\
    \\pub fn Services.get_variable(self, name: Str, vendor: Guid, alloc: mem::Alloc) -> Variable fails ServiceError
    \\
    \\pub fn Services.set_variable(self, name: Str, vendor: Guid, attributes: VariableAttributes, data: Slice[u8]) fails ServiceError
    \\
    \\pub fn Services.measure(self, pcr: u32, event_type: u32, data: Slice[u8], event: Slice[u8]) fails ServiceError
    \\
    \\pub fn Services.event_log(self, alloc: mem::Alloc) -> EventLog fails ServiceError
    \\
    \\pub fn Services.submit_tpm(self, command: Slice[u8], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails ServiceError
    \\
    \\pub fn Services.random(self, mut buf: SliceMut[u8]) fails ServiceError
    \\
    \\pub fn Services.memory_map(self, alloc: mem::Alloc) -> mem::List[MemoryRange] fails ServiceError
    \\
    \\pub fn Services.allocate(self, base: u64, byte_len: u64) -> hw::Region fails ServiceError
    \\
    \\pub fn Services.free(self, take region: hw::Region) fails ServiceError
    \\
    \\pub fn Services.config_table(self, table: ConfigTable, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails ServiceError {
    \\    let guid = match table {
    \\        ConfigTable.Acpi => Guid(data1: 0x8868_E871, data2: 0xE4F1, data3: 0x11D3, data4: 0xBC22_0080_C73C_8881)
    \\        ConfigTable.Smbios => Guid(data1: 0xF2FD_1544, data2: 0x9794, data3: 0x4A2C, data4: 0x992E_E5BB_CF20_E394)
    \\        ConfigTable.DeviceTree => Guid(data1: 0xB1B6_21D5, data2: 0xF19C, data3: 0x41A5, data4: 0x830B_D915_2C69_AAE0)
    \\    }
    \\    let address = configured(guid)
    \\    if address == 0 {
    \\        fail ServiceError.NotFound
    \\    }
    \\    let bytes = match table {
    \\        ConfigTable.Acpi => try drawn(address, len: u64.widen(u32_at(address + RSDP_LENGTH)), alloc)
    \\        ConfigTable.Smbios => try smbios(address, alloc)
    \\        ConfigTable.DeviceTree => try drawn(address, len: u64.widen(u32_be_at(address + TREE_SIZE)), alloc)
    \\    }
    \\    return Untrusted.of(take bytes)
    \\} Services.config_table
    \\
    \\pub fn Services.acpi_table(self, signature: Array[u8, 4], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails ServiceError {
    \\    let table = acpi_table_address(signature)
    \\    if table == 0 {
    \\        fail ServiceError.NotFound
    \\    }
    \\    return Untrusted.of(try drawn(table, len: u64.widen(u32_at(table + 4)), alloc))
    \\} Services.acpi_table
    \\
    \\pub open enum ServiceError derives Render {
    \\    NotFound
    \\    DeviceError
    \\    OutOfMemory
    \\    Denied
    \\    Unsupported
    \\    Invalid
    \\} ServiceError
    \\
    \\pub closed struct Key derives Copy, Eq {
    \\    pub text: Option[char]
    \\    pub scan: u16
    \\} Key
    \\
    \\pub closed struct Guid derives Copy, Eq {
    \\    pub data1: u32
    \\    pub data2: u16
    \\    pub data3: u16
    \\    pub data4: u64
    \\} Guid
    \\
    \\pub layout VariableAttributes: u32 le {
    \\    non_volatile: bit 0
    \\    boot_service_access: bit 1
    \\    runtime_access: bit 2
    \\    reserved: rest
    \\} VariableAttributes
    \\
    \\pub closed struct Variable {
    \\    pub attributes: VariableAttributes
    \\    pub data: Untrusted[mem::Bytes]
    \\} Variable
    \\
    \\pub closed struct EventLog {
    \\    pub bytes: Untrusted[mem::Bytes]
    \\    pub truncated: bool
    \\} EventLog
    \\
    \\pub closed enum ConfigTable derives Copy, Eq {
    \\    Acpi
    \\    Smbios
    \\    DeviceTree
    \\} ConfigTable
    \\
    \\pub closed struct DirectoryEntry {
    \\    pub name: Untrusted[mem::Bytes]
    \\    pub byte_len: u64
    \\    pub directory: bool
    \\} DirectoryEntry
    \\
    \\pub closed struct BootDevice {
    \\    pub file: Untrusted[mem::Bytes]
    \\    pub partition: Option[Partition]
    \\} BootDevice
    \\
    \\pub closed struct Partition derives Copy, Eq {
    \\    pub number: u32
    \\    pub start: u64
    \\    pub blocks: u64
    \\    pub signature: PartitionSignature
    \\} Partition
    \\
    \\pub closed enum PartitionSignature derives Copy, Eq {
    \\    Gpt(Guid)
    \\    Mbr(u32)
    \\    Unsigned
    \\} PartitionSignature
    \\
    \\pub closed struct MemoryRange derives Copy, Eq {
    \\    pub base: u64
    \\    pub byte_len: u64
    \\    pub kind: u32
    \\    pub attributes: u64
    \\} MemoryRange
    \\
    \\/// The address of the PVH-layout start information the image started with, zero when it has
    \\/// none.
    \\pkg fn start_info() -> u64
    \\
    \\/// The address of the flattened device tree the image started with, zero when it has none.
    \\pkg fn tree_address() -> u64
    \\
    \\/// The address of the ACPI root system description pointer the platform gives, zero when none.
    \\pkg fn rsdp_address() -> u64
    \\
    \\/// The address of the system table the firmware entered the image with, zero when it has no
    \\/// firmware.
    \\pkg fn system_table_address() -> u64
    \\
    \\/// The address of the table the firmware's configuration table lists under a GUID, zero when
    \\/// it lists none or the image has no firmware.
    \\fn configured(guid: Guid) -> u64 {
    \\    let table = system_table_address()
    \\    if table == 0 {
    \\        return 0
    \\    }
    \\    let entries = u64_at(table + CONFIGURATION_TABLE)
    \\    for index in 0..<u64_at(table + CONFIGURATION_COUNT) {
    \\        let entry = entries + index * CONFIGURATION_ENTRY
    \\        if same_guid(entry, guid) {
    \\            return u64_at(entry + 16)
    \\        }
    \\    }
    \\    return 0
    \\} configured
    \\
    \\/// Whether the GUID the firmware laid out at an address is `guid`.
    \\fn same_guid(at: u64, guid: Guid) -> bool {
    \\    var tail: u64 = 0
    \\    for index in 8u64..<16 {
    \\        tail = (tail << 8) | u64.widen(byte_at(at + index))
    \\    }
    \\    let head = u32_at(at + 4)
    \\    return u32_at(at) == guid.data1 and head == ((u32.widen(guid.data3) << 16) | u32.widen(guid.data2)) and tail == guid.data4
    \\} same_guid
    \\
    \\/// The byte at a physical address.
    \\fn byte_at(address: u64) -> u8 {
    \\    return trusted "the platform's tables lie in memory the running root maps, which nothing writes" { hw::Ptr[u8].of_addr(usize.widen(address)).read() }
    \\} byte_at
    \\
    \\/// The little-endian 32-bit and 64-bit numbers at a physical address, and the big-endian 32-bit
    \\/// one.
    \\fn u32_at(address: u64) -> u32 {
    \\    var value: u32 = 0
    \\    for index in 0u64..<4 {
    \\        value = value | (u32.widen(byte_at(address + index)) << u32.fit(index * 8))
    \\    }
    \\    return value
    \\} u32_at
    \\
    \\fn u64_at(address: u64) -> u64 {
    \\    return u64.widen(u32_at(address)) | (u64.widen(u32_at(address + 4)) << 32)
    \\} u64_at
    \\
    \\fn u32_be_at(address: u64) -> u32 {
    \\    var value: u32 = 0
    \\    for index in 0u64..<4 {
    \\        value = (value << 8) | u32.widen(byte_at(address + index))
    \\    }
    \\    return value
    \\} u32_be_at
    \\
    \\/// The NUL-terminated text at a physical address, its NUL left out; empty at address zero.
    \\fn text_at(address: u64, alloc: mem::Alloc) -> mem::Bytes {
    \\    var text = mem::Bytes.empty(alloc)
    \\    if address == 0 {
    \\        return text
    \\    }
    \\    var at = address
    \\    loop {
    \\        let byte = byte_at(at)
    \\        if byte == 0 {
    \\            return text
    \\        }
    \\        mut text.push(byte)
    \\        at += 1
    \\    }
    \\} text_at
    \\
    \\/// The `len` bytes at a physical address.
    \\fn copied(address: u64, len: u64, alloc: mem::Alloc) -> mem::Bytes {
    \\    var bytes = mem::Bytes.zeroed(usize.widen(len), alloc)
    \\    copy_into(address, to: mut bytes.view_mut())
    \\    return bytes
    \\} copied
    \\
    \\/// The `len` bytes at a physical address, failing with `OutOfMemory` when `alloc` cannot hold
    \\/// them.
    \\fn drawn(address: u64, len: u64, alloc: mem::Alloc) -> mem::Bytes fails ServiceError {
    \\    let Ok(bytes) = attempt mem::Bytes.try_zeroed(usize.widen(len), alloc) else {
    \\        fail ServiceError.OutOfMemory
    \\    }
    \\    var filled = bytes
    \\    copy_into(address, to: mut filled.view_mut())
    \\    return filled
    \\} drawn
    \\
    \\/// Fills `to` with the bytes at a physical address.
    \\fn copy_into(address: u64, mut to: SliceMut[u8]) {
    \\    let len = to.len()
    \\    let target = hw::Ptr.of_view_mut(mut to)
    \\    trusted "the platform's tables lie in memory the running root maps, and `to` holds `len` bytes" {
    \\        hw::Ptr[u8].of_addr(usize.widen(address)).copy(target, count: len)
    \\    }
    \\} copy_into
    \\
    \\/// The SMBIOS 3.0 entry point at an address followed by the structure table it names, of its
    \\/// stated maximum size.
    \\fn smbios(entry: u64, alloc: mem::Alloc) -> mem::Bytes fails ServiceError {
    \\    let entry_len = u64.widen(byte_at(entry + SMBIOS_ENTRY_LENGTH))
    \\    let table_len = u64.widen(u32_at(entry + SMBIOS_TABLE_SIZE))
    \\    var bytes = try drawn(entry, len: entry_len, alloc)
    \\    let table = try drawn(u64_at(entry + SMBIOS_TABLE), len: table_len, alloc)
    \\    let Ok(_) = attempt mut bytes.try_append(table.view()) else {
    \\        fail ServiceError.OutOfMemory
    \\    }
    \\    return bytes
    \\} smbios
    \\
    \\/// The address of the ACPI table with a signature, zero when the platform gives none: the DSDT
    \\/// and the FACS through the FADT's 64-bit address, or its 32-bit one when that is zero, any
    \\/// other the root table lists.
    \\fn acpi_table_address(signature: Array[u8, 4]) -> u64 {
    \\    let wanted = signature.view().u32_le(0)
    \\    if wanted != DSDT and wanted != FACS {
    \\        return listed_table(wanted)
    \\    }
    \\    let facp = listed_table(FADT)
    \\    if facp == 0 {
    \\        return 0
    \\    }
    \\    var wide = FADT_X_FACS
    \\    var narrow = FADT_FACS
    \\    if wanted == DSDT {
    \\        wide = FADT_X_DSDT
    \\        narrow = FADT_DSDT
    \\    }
    \\    let length = u64.widen(u32_at(facp + 4))
    \\    if length >= wide + 8 {
    \\        let address = u64_at(facp + wide)
    \\        if address != 0 {
    \\            return address
    \\        }
    \\    }
    \\    return u64.widen(u32_at(facp + narrow))
    \\} acpi_table_address
    \\
    \\/// The address of the table with a signature that the XSDT, or the RSDT for an RSDP of revision
    \\/// 0 or without an XSDT, lists; zero when none.
    \\fn listed_table(signature: u32) -> u64 {
    \\    let rsdp = rsdp_address()
    \\    if rsdp == 0 {
    \\        return 0
    \\    }
    \\    var root = u64.widen(u32_at(rsdp + RSDP_RSDT))
    \\    var width: u64 = 4
    \\    if byte_at(rsdp + RSDP_REVISION) >= 2 and u64_at(rsdp + RSDP_XSDT) != 0 {
    \\        root = u64_at(rsdp + RSDP_XSDT)
    \\        width = 8
    \\    }
    \\    let end = root + u64.widen(u32_at(root + 4))
    \\    var at = root + HEADER_BYTES
    \\    while at + width <= end {
    \\        var table = u64.widen(u32_at(at))
    \\        if width == 8 {
    \\            table = u64_at(at)
    \\        }
    \\        if table != 0 and u32_at(table) == signature {
    \\            return table
    \\        }
    \\        at += width
    \\    }
    \\    return 0
    \\} listed_table
    \\
    \\/// The value of the `bootargs` property of the device tree's `/chosen` node, empty when it has
    \\/// none.
    \\fn boot_arguments(tree: u64, alloc: mem::Alloc) -> mem::Bytes {
    \\    if u32_be_at(tree) != TREE_MAGIC {
    \\        return mem::Bytes.empty(alloc)
    \\    }
    \\    let strings = tree + u64.widen(u32_be_at(tree + TREE_STRINGS))
    \\    var at = tree + u64.widen(u32_be_at(tree + TREE_STRUCTURE))
    \\    var depth: u32 = 0
    \\    var chosen = false
    \\    loop {
    \\        let token = u32_be_at(at)
    \\        at += 4
    \\        if token == BEGIN_NODE {
    \\            depth += 1
    \\            chosen = depth == 2 and named(at, text: "chosen")
    \\            at = past_name(at)
    \\        } else if token == END_NODE {
    \\            depth -= 1
    \\            chosen = false
    \\        } else if token == PROPERTY {
    \\            let len = u64.widen(u32_be_at(at))
    \\            let name = strings + u64.widen(u32_be_at(at + 4))
    \\            if chosen and named(name, text: "bootargs") {
    \\                return text_at(at + 8, alloc)
    \\            }
    \\            at += 8 + (len + 3) / 4 * 4
    \\        } else if token == TREE_END {
    \\            return mem::Bytes.empty(alloc)
    \\        }
    \\    }
    \\} boot_arguments
    \\
    \\/// Whether the NUL-terminated name at an address is `text`, or `text` followed by `@` and a unit
    \\/// address.
    \\fn named(address: u64, text: Str) -> bool {
    \\    var at = address
    \\    for byte in text.as_bytes() {
    \\        if byte_at(at) != byte {
    \\            return false
    \\        }
    \\        at += 1
    \\    }
    \\    let next = byte_at(at)
    \\    return next == 0 or next == b'@'
    \\} named
    \\
    \\/// The address past a node's NUL-terminated name, padded to a word.
    \\fn past_name(address: u64) -> u64 {
    \\    var at = address
    \\    while byte_at(at) != 0 {
    \\        at += 1
    \\    }
    \\    return (at + 4) / 4 * 4
    \\} past_name
    \\

const TEXT_BOOT_PACKAGE: Str =
    \\//! The UEFI and bare root grants and firmware services.
    \\
    \\package boot {
    \\    language 1
    \\    targets any
    \\} boot
    \\

const TEXT_CORE_ATOMIC_ATOMIC: Str =
    \\//! Atomic scalars shared between tasks.
    \\
    \\pub open struct AtomicU8 {
    \\} AtomicU8
    \\
    \\pub fn AtomicU8.of(value: u8) -> AtomicU8 limits notrap, terminates, noalloc
    \\    example AtomicU8.of(4).load() == 4
    \\
    \\pub fn AtomicU8.load(self) -> u8 limits notrap, terminates, noalloc
    \\    example AtomicU8.of(4).load() == 4
    \\
    \\pub fn AtomicU8.store(self, value: u8) limits notrap, terminates, noalloc
    \\
    \\pub fn AtomicU8.swap(self, value: u8) -> u8 limits notrap, terminates, noalloc
    \\    example AtomicU8.of(4).swap(5) == 4
    \\
    \\pub fn AtomicU8.compare_swap(self, expected: u8, replacement: u8) -> Result[u8, u8] limits notrap, terminates, noalloc
    \\    example AtomicU8.of(4).compare_swap(4, replacement: 5) == Ok(4)
    \\
    \\pub fn AtomicU8.fetch_add(self, amount: u8) -> Option[u8] limits notrap, terminates, noalloc
    \\    example AtomicU8.of(~0u8).fetch_add(1) == None
    \\
    \\pub fn AtomicU8.fetch_sub(self, amount: u8) -> Option[u8] limits notrap, terminates, noalloc
    \\    example AtomicU8.of(4).fetch_sub(1) == Some(4)
    \\
    \\pub fn AtomicU8.fetch_and(self, mask: u8) -> u8 limits notrap, terminates, noalloc
    \\    example AtomicU8.of(6).fetch_and(3) == 6
    \\
    \\pub fn AtomicU8.fetch_or(self, mask: u8) -> u8 limits notrap, terminates, noalloc
