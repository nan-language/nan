/// The offsets within `AARCH64_VBAR_SEAM` of the common seam's calls of the dispatcher and of the
/// preemption glue.
const AARCH64_SEAM_DISPATCH: u32 = 0x874

const AARCH64_SEAM_PREEMPT: u32 = 0x900

/// The size of the vector table, to which the seam's symbol, loaded into `VBAR_EL1`, is aligned.
const AARCH64_VBAR_BYTES: u64 = 2_048

/// The offsets in the frame the seam saves, after the thirty-one general registers: the
/// interrupted return address, the saved processor state, the interrupted stack pointer, the
/// exception's syndrome and the fault address.
const AARCH64_FRAME_ELR: u64 = 0xF8

const AARCH64_FRAME_SPSR: u64 = 0x100

const AARCH64_FRAME_SP: u64 = 0x108

const AARCH64_FRAME_ESR: u64 = 0x110

const AARCH64_FRAME_FAR: u64 = 0x118

/// The IRQ mask bit of the saved processor state.
const AARCH64_IRQ_MASKED: i64 = 0x80

/// The exception vectors: a synchronous exception other than an instruction or data abort, an
/// instruction or data abort, and an SError interrupt.
const AARCH64_SYNC_VECTOR: i64 = 0

const AARCH64_ABORT_VECTOR: i64 = 1

const AARCH64_SERROR_VECTOR: i64 = 2

/// The kinds of exception the seam passes for an IRQ, an FIQ and an SError interrupt.
const AARCH64_KIND_IRQ: i64 = 1

const AARCH64_KIND_FIQ: i64 = 2

const AARCH64_KIND_SERROR: i64 = 3

/// The position of a syndrome's exception class, and the class's bits that set the classes of
/// instruction and data aborts, from a lower or the current EL, apart from every other class,
/// with their value for those four.
const AARCH64_CLASS_SHIFT: i64 = 26

const AARCH64_ABORT_CLASS_BITS: i64 = 0x3A

const AARCH64_ABORT_CLASS: i64 = 0x20

/// The virtual timer's private interrupt; the interrupt controller reports a spurious interrupt
/// with one of the `AARCH64_SPECIAL` identifiers from `AARCH64_SPURIOUS`.
const AARCH64_TIMER_INTID: i64 = 27

const AARCH64_SPURIOUS: i64 = 1020

const AARCH64_SPECIAL: i64 = 4

/// The GICv3 the descriptor names: its distributor, and the first CPU's redistributor, each
/// CPU's a stride after the previous one with its frame of software-generated and private
/// interrupts a page after its control frame.
const GICD: u64 = 0x0800_0000

const GICR: u64 = 0x080A_0000

const GICR_STRIDE: u64 = 0x2_0000

const GICR_SGI: u64 = 0x1_0000

/// The distributor's registers the kernel programs: its control register, set to affinity
/// routing with both groups enabled; its group, set-enable and clear-enable registers, whose
/// word `n` covers interrupts `32n` to `32n + 31`, words one to seven the shared peripheral
/// interrupts a vector names; and its routing registers, a doubleword per interrupt.
const GICD_CTLR: u64 = 0x0

const GICD_ARE_GROUPS: u64 = (1u64 << 4) | 0x3

const GICD_IGROUPR: u64 = 0x080

const GICD_ISENABLER: u64 = 0x100

const GICD_ICENABLER: u64 = 0x180

const GICD_IROUTER: u64 = 0x6000

const GICD_SPI_WORDS: u64 = 8

/// The redistributor's wake register with its processor-asleep and children-asleep bits, and the
/// group and set-enable registers of its software-generated and private interrupts.
const GICR_WAKER: u64 = 0x14

const GICR_WAKER_ASLEEP: u64 = 1u64 << 1

const GICR_WAKER_CHILDREN: u64 = 1u64 << 2

const GICR_IGROUPR0: u64 = 0x80

const GICR_ISENABLER0: u64 = 0x100

/// The software-generated interrupt a halting CPU stops the others with, alone in group 0, which
/// the interrupt controller delivers as a fast interrupt; and the `ICC_SGI0R_EL1` value sending
/// it to every CPU but the writer, its routing-mode bit selecting all other CPUs.
const STOP_INTID: u64 = 0

const STOP_SGI: u64 = (1u64 << 40) | (STOP_INTID << 24)

/// The software-generated interrupt the `SendSignal` stub sends, which the dispatcher receives
/// as the CPU signal's vector.
const SIGNAL_INTID: i64 = 1

/// The system-register encodings the `ReadSysReg` and `WriteSysReg` stubs hold to reach the GIC
/// CPU interface, the vector base and the virtual timer, as the `mrs` and `msr` instructions
/// encode them.
const ICC_SRE_EL1: u16 = 0x4665

const ICC_PMR_EL1: u16 = 0x4230

const ICC_IGRPEN0_EL1: u16 = 0x4666

const ICC_IGRPEN1_EL1: u16 = 0x4667

const ICC_IAR1_EL1: u16 = 0x4660

const ICC_IAR0_EL1: u16 = 0x4640

const ICC_EOIR1_EL1: u16 = 0x4661

const ICC_EOIR0_EL1: u16 = 0x4641

const ICC_SGI0R_EL1: u16 = 0x465F

const VBAR_EL1: u16 = 0x4600

const CNTV_TVAL_EL0: u16 = 0x5F18

const CNTV_CTL_EL0: u16 = 0x5F19

const CNTFRQ_EL0: u16 = 0x5F00

const CNTVCT_EL0: u16 = 0x5F02

/// What the dispatcher knows of the AArch64 vectors.
fn aarch64_vectors() -> Vectors = Vectors(stop: None, timer: AARCH64_TIMER_INTID, spurious: None, abort_mask: 1u64 << u32.fit(AARCH64_SERROR_VECTOR), page_fault: AARCH64_ABORT_VECTOR, installable_end: Some(256), lpis: true)

/// The layout of the frame the AArch64 vector seam saves.
fn aarch64_frame() -> SavedFrame = SavedFrame(code: AARCH64_FRAME_ESR, ip: AARCH64_FRAME_ELR, state: AARCH64_FRAME_SPSR, sp: AARCH64_FRAME_SP)

/// Reads a GIC CPU-interface, vector-base, timer or counter system register through the
/// `ReadSysReg` stub.
fn Lowering.read_sysreg(mut self, mut fx: Fx, register: u16) -> clif::Value {
    let results = mut self.call_stub(mut fx, stub: Stub.ReadSysReg(register), args: mem::List[clif::Value].empty(fx.alloc).view())
    expect results.len() > 0
    return results[0]
} Lowering.read_sysreg

/// Writes one through the `WriteSysReg` stub.
fn Lowering.write_sysreg(mut self, mut fx: Fx, register: u16, value: clif::Value) {
    discard mut self.call_stub(mut fx, stub: Stub.WriteSysReg(register), args: Array[clif::Value, 1].filled(value).view())
} Lowering.write_sysreg

/// Sets up the GICv3 for a kernel's executor and gives the glue each CPU runs to take
/// interrupts. The distributor routes with affinity, puts every shared peripheral interrupt in
/// group 1 and enables each that a contribution binds, routed to the boot CPU, and the ITS is
/// set up; the glue enables the private interrupts on each CPU.
fn Lowering.aarch64_interrupt_setup(mut self, mut fx: Fx) -> object::FuncId {
    let ctlr = mut fx.ptr(GICD + GICD_CTLR)
    let groups = mut fx.ptr(GICD_ARE_GROUPS)
    mut self.mmio_write(mut fx, width: 4, address: ctlr, value: groups)
    let ones = mut fx.ptr(0xFFFF_FFFF)
    var word: u64 = 1
    while word < GICD_SPI_WORDS {
        let group = mut fx.ptr(GICD + GICD_IGROUPR + 4 * word)
        mut self.mmio_write(mut fx, width: 4, address: group, value: ones)
        word = word + 1
    }
    let bound = mut self.bound_vectors()
    var private: u64 = 0
    for bound_entry in bound {
        if bound_entry.vector >= 16 and bound_entry.vector < 32 {
            private = private | (1u64 << u32.fit(bound_entry.vector))
        } else if bound_entry.vector >= 32 and bound_entry.vector != SIGNAL_VECTOR {
            let vector = mut fx.ptr(u64.fit(bound_entry.vector))
            let boot = mut fx.ptr(0)
            mut self.aarch64_route(mut fx, vector, cpu: boot)
        }
    }
    mut self.its_setup(mut fx)
    let dispatch = mut self.dispatcher(bound.view())
    let preempt = mut self.preempt_glue()
    let vbar = mut self.aarch64_vector_seam(dispatch, preempt)
    return mut self.aarch64_cpu_prepare(vbar, private)
} Lowering.aarch64_interrupt_setup

/// Enables a shared peripheral interrupt routed to CPU `cpu`, for a contribution's binding or an
/// installed device.
fn Lowering.aarch64_route(mut self, mut fx: Fx, vector: clif::Value, cpu: clif::Value) {
    let affinity = mut self.hardware_id(mut fx, index: cpu)
    let shifted = mut fx.b.ishl_imm_s(vector, y: 3)
    let route = mut fx.b.iadd_imm_s(shifted, y: i64.fit(GICD + GICD_IROUTER))
    mut self.mmio_write(mut fx, width: 8, address: route, value: affinity)
    mut self.gic_spi_bit(mut fx, register: GICD_ISENABLER, vector)
} Lowering.aarch64_route

/// Disables a shared peripheral interrupt, once no installed device is left on it.
fn Lowering.aarch64_disable(mut self, mut fx: Fx, vector: clif::Value) {
    mut self.gic_spi_bit(mut fx, register: GICD_ICENABLER, vector)
} Lowering.aarch64_disable

/// Writes the bit of a shared peripheral interrupt alone to its word of one of the
/// distributor's set-enable or clear-enable registers, which leave the other bits as they are.
fn Lowering.gic_spi_bit(mut self, mut fx: Fx, register: u64, vector: clif::Value)
    requires register < 0x1000
{
    let shifted = mut fx.b.ushr_imm_s(vector, y: 5)
    let word = mut fx.b.ishl_imm_s(shifted, y: 2)
    let at = mut fx.b.iadd_imm_s(word, y: i64.fit(GICD + register))
    let position = mut fx.b.band_imm_s(vector, y: 31)
    let one = mut fx.ptr(1)
    let bit = mut fx.b.ishl(one, y: position)
    mut self.mmio_write(mut fx, width: 4, address: at, value: bit)
} Lowering.gic_spi_bit

/// Emits the vector table and common seam, its symbol aligned so `VBAR_EL1` may name it, with
/// the common seam's calls relocated to the dispatcher and the preemption glue. Gives the
/// table's symbol.
fn Lowering.aarch64_vector_seam(mut self, dispatch: object::FuncId, preempt: object::FuncId) -> object::FuncId {
    let seam = mut self.module.declare_function("_NSvbar", linkage: object::Linkage.Local, signature: clif::Signature.new(CALL_CONV, alloc: self.alloc))
    var relocs = mem::List[object::ModuleReloc].empty(self.alloc)
    mut relocs.push(object::ModuleReloc(offset: AARCH64_SEAM_DISPATCH, kind: machinst::RelocKind.Arm64Call, target: object::RelocTarget.Function(dispatch), addend: 0))
    mut relocs.push(object::ModuleReloc(offset: AARCH64_SEAM_PREEMPT, kind: machinst::RelocKind.Arm64Call, target: object::RelocTarget.Function(preempt), addend: 0))
    mut self.module.define_function_bytes(seam, align: AARCH64_VBAR_BYTES, bytes: AARCH64_VBAR_SEAM, relocs: relocs.view())
    return seam
} Lowering.aarch64_vector_seam

/// The glue each CPU runs to take interrupts: it draws its interrupt stack, makes it the stack
/// exceptions switch to while its own code continues on `SP_EL0`, and loads the vector table into
/// `VBAR_EL1`. It then wakes its redistributor, puts the stop interrupt in group 0 and its other
/// software-generated and private interrupts in group 1, enables the stop interrupt, the CPU
/// signal's, the timer's and the private interrupts in `private`, enables its LPIs when the ITS
/// is set up, enables its GIC CPU interface at the lowest priority, unmasks fast interrupts, and
/// starts and enables its virtual timer.
/// Maskable interrupts stay disabled until the executor enables them.
fn Lowering.aarch64_cpu_prepare(mut self, vbar: object::FuncId, private: u64) -> object::FuncId {
    let signature = clif::Signature.new(CALL_CONV, alloc: self.alloc)
    let id = mut self.module.declare_function("_NScpu_prepare", linkage: object::Linkage.Local, signature)
    let sizes = mut self.interrupt_stack_sizes()
    mut self.define(id, take signature, flags: LINES_HIDDEN, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        discard mut fx1.entry()
        let sizes_address = mut lo1.data_address(mut fx1, id: sizes)
        let size = mut fx1.load(PTR, addr: sizes_address, offset: 0)
        let stack_base = mut lo1.interrupt_stack(mut fx1, size)
        let top = mut fx1.b.iadd(stack_base, y: size)
        discard mut lo1.call_stub(mut fx1, stub: Stub.InterruptStack, args: Array[clif::Value, 1].filled(top).view())
        let table_ref = mut lo1.func_ref(mut fx1, id: vbar)
        let table = mut fx1.b.func_addr(PTR, func_ref: table_ref)
        mut lo1.write_sysreg(mut fx1, register: VBAR_EL1, value: table)
        let index = mut lo1.running_index(mut fx1)
        let stride = mut fx1.b.imul_imm_s(index, y: i64.fit(GICR_STRIDE))
        let base = mut fx1.b.iadd_imm_s(stride, y: i64.fit(GICR))
        let sgi = mut fx1.b.iadd_imm_s(base, y: i64.fit(GICR_SGI))
        let waker = mut fx1.b.iadd_imm_s(base, y: i64.fit(GICR_WAKER))
        let state = mut lo1.mmio_read(mut fx1, width: 4, address: waker)
        let awake = mut fx1.b.band_imm_s(state, y: i64.from_bits(~GICR_WAKER_ASLEEP))
        mut lo1.mmio_write(mut fx1, width: 4, address: waker, value: awake)
        discard mut fx1.repeat(mem::List[clif::Value].empty(fx1.alloc).view(), body: fn[mut lo1](mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            let poll = mut lo1.mmio_read(mut fx2, width: 4, address: waker)
            let children = mut fx2.b.band_imm_s(poll, y: i64.fit(GICR_WAKER_CHILDREN))
            let asleep = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: children, y: 0)
            mut fx2.if_true(asleep, then: fn[mut lo1](mut fx3: Fx) {
                discard mut lo1.call_stub(mut fx3, stub: Stub.Pause, args: mem::List[clif::Value].empty(fx3.alloc).view())
            })
            return Pass(again: asleep, next: mem::List[clif::Value].empty(fx2.alloc))
        })
        let group = mut fx1.b.iadd_imm_s(sgi, y: i64.fit(GICR_IGROUPR0))
        let ones = mut fx1.ptr(0xFFFF_FFFF & ~(1u64 << u32.fit(STOP_INTID)))
        mut lo1.mmio_write(mut fx1, width: 4, address: group, value: ones)
        let enable = mut fx1.b.iadd_imm_s(sgi, y: i64.fit(GICR_ISENABLER0))
        let bits = mut fx1.ptr((1u64 << u32.fit(STOP_INTID)) | (1u64 << u32.fit(SIGNAL_INTID)) | (1u64 << u32.fit(AARCH64_TIMER_INTID)) | private)
        mut lo1.mmio_write(mut fx1, width: 4, address: enable, value: bits)
        mut lo1.its_cpu(mut fx1, base)
        let sre = mut lo1.read_sysreg(mut fx1, register: ICC_SRE_EL1)
        let sre_set = mut fx1.b.bor_imm_s(sre, y: 1)
        mut lo1.write_sysreg(mut fx1, register: ICC_SRE_EL1, value: sre_set)
        let pmr = mut fx1.ptr(0xFF)
        mut lo1.write_sysreg(mut fx1, register: ICC_PMR_EL1, value: pmr)
        let one = mut fx1.ptr(1)
        mut lo1.write_sysreg(mut fx1, register: ICC_IGRPEN1_EL1, value: one)
        mut lo1.write_sysreg(mut fx1, register: ICC_IGRPEN0_EL1, value: one)
        discard mut lo1.call_stub(mut fx1, stub: Stub.FiqOn, args: mem::List[clif::Value].empty(fx1.alloc).view())
        mut lo1.start_timer(mut fx1)
        let enabled = mut fx1.ptr(1)
        mut lo1.write_sysreg(mut fx1, register: CNTV_CTL_EL0, value: enabled)
        mut fx1.b.ret(mem::List[clif::Value].empty(fx1.alloc).view())
    })
    return id
} Lowering.aarch64_cpu_prepare

/// The ticks the virtual counter counts in a millisecond.
fn Lowering.aarch64_timer_rate(mut self, mut fx: Fx) -> clif::Value {
    let frequency = mut self.read_sysreg(mut fx, register: CNTFRQ_EL0)
    let thousand = mut fx.ptr(1_000)
    return mut fx.b.udiv(frequency, y: thousand)
} Lowering.aarch64_timer_rate

/// Sets the virtual timer to fire once `ticks` of the virtual counter have passed.
fn Lowering.aarch64_set_timer(mut self, mut fx: Fx, ticks: clif::Value) {
    mut self.write_sysreg(mut fx, register: CNTV_TVAL_EL0, value: ticks)
} Lowering.aarch64_set_timer

/// The vector of what the seam took, from the kind of exception it passes: for an IRQ the
/// interrupt the controller signals, which this acknowledges, an LPI's identifier included, or
/// the CPU signal's vector for its software-generated interrupt; for a synchronous exception the
/// abort vector or the other one as its syndrome's class gives, and the SError vector for an
/// SError interrupt. A fast interrupt is the stop a halting CPU sends, which stops this one; a
/// spurious IRQ returns from the dispatcher at once.
fn Lowering.aarch64_vector(mut self, mut fx: Fx, kind: clif::Value, saved: clif::Value) -> clif::Value {
    let fiq = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: AARCH64_KIND_FIQ)
    mut fx.if_true(fiq, then: fn[mut self](mut fx1: Fx) {
        let intid = mut self.read_sysreg(mut fx1, register: ICC_IAR0_EL1)
        mut self.write_sysreg(mut fx1, register: ICC_EOIR0_EL1, value: intid)
        mut self.stop_cpu(mut fx1)
    })
    let irq = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: AARCH64_KIND_IRQ)
    let found = mut fx.choose_in(mut self, condition: irq, results: Array[clif::Type, 1].filled(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let intid = mut lo1.read_sysreg(mut fx1, register: ICC_IAR1_EL1)
        let special = mut fx1.b.iadd_imm_s(intid, y: -AARCH64_SPURIOUS)
        let spurious = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: special, y: AARCH64_SPECIAL)
        mut fx1.if_true(spurious, then: fn(mut fx2: Fx) {
            let zero_value = mut fx2.ptr(0)
            mut fx2.b.ret(Array[clif::Value, 1].filled(zero_value).view())
        })
        let signal = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: intid, y: SIGNAL_INTID)
        let signalled = mut fx1.ptr(u64.fit(SIGNAL_VECTOR))
        return fx1.list1(mut fx1.b.select(signal, x: signalled, y: intid))
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let syndrome = mut fx1.load(PTR, addr: saved, offset: AARCH64_FRAME_ESR)
        let class = mut fx1.b.ushr_imm_s(syndrome, y: AARCH64_CLASS_SHIFT)
        let class_bits = mut fx1.b.band_imm_s(class, y: AARCH64_ABORT_CLASS_BITS)
        let abort = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: class_bits, y: AARCH64_ABORT_CLASS)
        let aborted = mut fx1.ptr(u64.fit(AARCH64_ABORT_VECTOR))
        let other = mut fx1.ptr(u64.fit(AARCH64_SYNC_VECTOR))
        let synchronous = mut fx1.b.select(abort, x: aborted, y: other)
        let serror = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: AARCH64_KIND_SERROR)
        let error_vector = mut fx1.ptr(u64.fit(AARCH64_SERROR_VECTOR))
        let vector = mut fx1.b.select(serror, x: error_vector, y: synchronous)
        return fx1.list1(vector)
    })
    return found[0]
} Lowering.aarch64_vector

/// Writes the GIC CPU interface's end-of-interrupt register for the interrupt the running CPU
/// serves, the CPU signal's being its software-generated interrupt.
fn Lowering.aarch64_eoi(mut self, mut fx: Fx) {
    let record = mut self.running_cpu(mut fx)
    let vector = mut fx.load(PTR, addr: record, offset: CPU_VECTOR)
    let signal = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: vector, y: SIGNAL_VECTOR)
    let generated = mut fx.ptr(u64.fit(SIGNAL_INTID))
    let intid = mut fx.b.select(signal, x: generated, y: vector)
    mut self.write_sysreg(mut fx, register: ICC_EOIR1_EL1, value: intid)
} Lowering.aarch64_eoi

/// Sends every other CPU the stop interrupt.
fn Lowering.aarch64_send_stop(mut self, mut fx: Fx) {
    let sgi = mut fx.ptr(STOP_SGI)
    mut self.write_sysreg(mut fx, register: ICC_SGI0R_EL1, value: sgi)
} Lowering.aarch64_send_stop
