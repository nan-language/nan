//! Conversions of the converter's eight channels.

pub layout Control: u32 le {
    start: bit 0
    channel: bit 1..=3
    reserved: rest
} Control

pub layout Status: u32 le {
    done: bit 0
    overrun: bit 1
    reserved: rest
} Status

pub layout Sample: u32 le {
    value: bit 0..=11
    channel: bit 12..=14
    reserved: rest
} Sample

pub registers AdcRegs {
    control: Control at 0x0 write
    status: Status at 0x4 write_one_clear
    data: Sample at 0x8 read
} AdcRegs

pub closed enum AdcError derives Eq, Render {
    NoChannel(u8)
    Timeout
    Overrun
    WrongChannel(u8)
} AdcError

/// Where the board decodes the converter's registers.
const ADC_BASE: u64 = 0xFED4_0000

/// The highest channel and the status reads a conversion gets before it times out.
const LAST_CHANNEL: u8 = 7

const POLLS: u32 = 100

/// The converter's registers.
pub fn map_adc() -> hw::Mmio[AdcRegs] {
    return trusted "the board decodes ADC_BASE to the converter alone and nothing else maps it" { hw::Mmio[AdcRegs].map(phys: ADC_BASE) }
} map_adc

/// Converts `channel` and gives the sample's value.
pub fn sample(mut regs: hw::Mmio[AdcRegs], channel: u8) -> u16 fails AdcError {
    if channel > LAST_CHANNEL {
        fail AdcError.NoChannel(channel)
    }
    mut regs.write(AdcRegs.control, value: Control(start: true, channel: channel, reserved: 0))
    for _ in 0..<POLLS {
        let status = mut regs.read(AdcRegs.status)
        if status.done {
            mut regs.write(AdcRegs.status, value: Status(done: true, overrun: status.overrun, reserved: 0))
            if status.overrun {
                fail AdcError.Overrun
            }
            let converted = mut regs.read(AdcRegs.data)
            if converted.channel != channel {
                fail AdcError.WrongChannel(converted.channel)
            }
            return converted.value
        }
    }
    fail AdcError.Timeout
} sample
