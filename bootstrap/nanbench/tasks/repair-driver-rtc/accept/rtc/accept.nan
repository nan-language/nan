//! Acceptance tests of the clock driver.

/// A status A value with `updating` as given.
fn status_a(updating: bool) -> u8 {
    if updating {
        return 0xA6
    }
    return 0x26
} status_a

test a_settled_clock_gives_its_time for read_time {
    let block = hw::sim::Registers[CmosPorts].of(testing::world().alloc)
    block.queue(CmosPorts.data, value: status_a(true))
    block.queue(CmosPorts.data, value: status_a(true))
    block.queue(CmosPorts.data, value: status_a(false))
    block.queue(CmosPorts.data, value: 0x06)
    block.queue(CmosPorts.data, value: 5)
    block.queue(CmosPorts.data, value: 30)
    block.queue(CmosPorts.data, value: 23)
    var ports = block.ports()
    let shown = read_time(mut ports)
    take ports.unmap()
    expect shown == Some(Time(hours: 23, minutes: 30, seconds: 5))
    expect block.last_written(CmosPorts.index) == Some(0x04)
} a_settled_clock_gives_its_time

test twelve_hour_decimal_times_are_converted for read_time {
    let block = hw::sim::Registers[CmosPorts].of(testing::world().alloc)
    for hours in 0..<3u32 {
        block.queue(CmosPorts.data, value: status_a(false))
        block.queue(CmosPorts.data, value: 0x00)
        block.queue(CmosPorts.data, value: 0x59)
        block.queue(CmosPorts.data, value: 0x07)
        if hours == 0 {
            block.queue(CmosPorts.data, value: 0x92)
        } else if hours == 1 {
            block.queue(CmosPorts.data, value: 0x12)
        } else {
            block.queue(CmosPorts.data, value: 0x81)
        }
    }
    var ports = block.ports()
    let noon = read_time(mut ports)
    let midnight = read_time(mut ports)
    let afternoon = read_time(mut ports)
    take ports.unmap()
    expect noon == Some(Time(hours: 12, minutes: 7, seconds: 59))
    expect midnight == Some(Time(hours: 0, minutes: 7, seconds: 59))
    expect afternoon == Some(Time(hours: 13, minutes: 7, seconds: 59))
} twelve_hour_decimal_times_are_converted

test a_clock_stuck_updating_gives_no_time for read_time {
    let block = hw::sim::Registers[CmosPorts].of(testing::world().alloc)
    for _ in 0..<999u32 {
        block.queue(CmosPorts.data, value: status_a(true))
    }
    block.queue(CmosPorts.data, value: status_a(false))
    block.queue(CmosPorts.data, value: 0x06)
    block.queue(CmosPorts.data, value: 1)
    block.queue(CmosPorts.data, value: 2)
    block.queue(CmosPorts.data, value: 3)
    var ports = block.ports()
    let in_time = read_time(mut ports)
    take ports.unmap()
    expect in_time == Some(Time(hours: 3, minutes: 2, seconds: 1))
    let stuck_block = hw::sim::Registers[CmosPorts].of(testing::world().alloc)
    for _ in 0..<1_000u32 {
        stuck_block.queue(CmosPorts.data, value: status_a(true))
    }
    stuck_block.queue(CmosPorts.data, value: status_a(false))
    var stuck_ports = stuck_block.ports()
    let too_late = read_time(mut stuck_ports)
    take stuck_ports.unmap()
    expect too_late == None
    expect stuck_block.last_written(CmosPorts.index) == Some(0x0A)
} a_clock_stuck_updating_gives_no_time

test decimal_bytes_convert_both_ways for bcd_of {
    expect bcd_of(59) == 0x59
    expect bcd_of(7) == 0x07
    expect from_bcd(0x99) == 99
} decimal_bytes_convert_both_ways

test the_day_counts_every_second for Time.seconds_of_day {
    expect Time(hours: 23, minutes: 59, seconds: 59).seconds_of_day() == 86_399
    expect Time(hours: 0, minutes: 1, seconds: 2).seconds_of_day() == 62
} the_day_counts_every_second
