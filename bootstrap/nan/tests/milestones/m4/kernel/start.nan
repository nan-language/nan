//! What the kernel started with: its command line and its modules.

/// A line giving the kernel's command line, then a line giving each module's name and size.
fn started(line: Untrusted[mem::Bytes], modules: Slice[boot::Module], alloc: mem::Alloc) -> mem::Bytes {
    var report = mem::Bytes.empty(alloc)
    mut report.append(b"kernel: command line ")
    shown(line.view(), out: mut report)
    mut report.push(b'\n')
    for module in modules {
        mut report.append(b"kernel: module ")
        let name = module.name(alloc)
        shown(name.view(), out: mut report)
        mut report.append(b" of ")
        decimal(u64.widen(module.contents().byte_len()), out: mut report)
        mut report.append(b" bytes\n")
    }
    return report
} started

/// Appends the printable ASCII bytes of untrusted text, each other byte as `?`.
validator fn shown(text: Untrusted[Slice[u8]], mut out: mem::Bytes) {
    for byte in text.inspect() {
        if byte >= 0x20 and byte < 0x7F {
            mut out.push(byte)
        } else {
            mut out.push(b'?')
        }
    }
} shown

/// Appends a number in decimal.
fn decimal(value: u64, mut out: mem::Bytes) {
    var digits = Array[u8, 20].filled(b'0')
    var rest = value
    var leading: usize = 19
    for position in 0usize..<20 {
        let at = 19 - position
        digits[at] = b'0' + u8.fit(rest % 10)
        rest = rest / 10
        if digits[at] != b'0' {
            leading = at
        }
    }
    let Some(parts) = digits.view().split_at(leading) else {
        return
    }
    mut out.append(parts.tail)
} decimal
