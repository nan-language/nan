//! Acceptance tests of the tally.

/// The line a total failed on, 0 when it failed otherwise or did not fail.
fn bad_line_of(outcome: Result[u64, TotalError]) -> u32 {
    return match outcome {
        Err(TotalError.BadLine(line)) => line
        else => 0
    }
} bad_line_of

/// Whether a total failed for overflowing.
fn is_overflow(outcome: Result[u64, TotalError]) -> bool {
    return match outcome {
        Err(TotalError.Overflow) => true
        else => false
    }
} is_overflow

/// Whether a total failed for its file missing.
fn is_not_found(outcome: Result[u64, TotalError]) -> bool {
    return match outcome {
        Err(TotalError.Fs(sys::fs::FsError.NotFound)) => true
        else => false
    }
} is_not_found

test totals_add_every_line for total_file {
    let world = testing::world()
    try await world.fs.write_all("ledger.txt", data: b"12\n30\n")
    let ledger_total = try await total_file(world.fs, path: "ledger.txt", alloc: world.alloc)
    expect ledger_total == 42
    try await world.fs.write_all("sparse.txt", data: b"7\n\n008")
    let sparse_total = try await total_file(world.fs, path: "sparse.txt", alloc: world.alloc)
    expect sparse_total == 15
    try await world.fs.write_all("empty.txt", data: b"")
    let empty_total = try await total_file(world.fs, path: "empty.txt", alloc: world.alloc)
    expect empty_total == 0
} totals_add_every_line

test malformed_lines_are_numbered for total_file {
    let world = testing::world()
    try await world.fs.write_all("typo.txt", data: b"5\n\n1x\n")
    let typo_outcome = attempt await total_file(world.fs, path: "typo.txt", alloc: world.alloc)
    expect bad_line_of(typo_outcome) == 3
    try await world.fs.write_all("signed.txt", data: b"-4\n")
    let signed_outcome = attempt await total_file(world.fs, path: "signed.txt", alloc: world.alloc)
    expect bad_line_of(signed_outcome) == 1
} malformed_lines_are_numbered

test totals_beyond_u64_overflow for total_file {
    let world = testing::world()
    try await world.fs.write_all("full.txt", data: b"18446744073709551615\n0\n")
    let full_total = try await total_file(world.fs, path: "full.txt", alloc: world.alloc)
    expect full_total == 18_446_744_073_709_551_615
    try await world.fs.write_all("over.txt", data: b"18446744073709551615\n1\n")
    let over_outcome = attempt await total_file(world.fs, path: "over.txt", alloc: world.alloc)
    expect is_overflow(over_outcome)
    try await world.fs.write_all("huge.txt", data: b"18446744073709551616")
    let huge_outcome = attempt await total_file(world.fs, path: "huge.txt", alloc: world.alloc)
    expect is_overflow(huge_outcome)
} totals_beyond_u64_overflow

test a_missing_ledger_fails for total_file {
    let world = testing::world()
    let absent_outcome = attempt await total_file(world.fs, path: "absent.txt", alloc: world.alloc)
    expect is_not_found(absent_outcome)
} a_missing_ledger_fails

test the_total_is_saved_as_one_line for save_total {
    let world = testing::world()
    try await save_total(world.fs, path: "total.txt", total: 1_234_567, alloc: world.alloc)
    let saved = try await world.fs.read_all("total.txt", alloc: world.alloc)
    expect testing::same(saved.view(), expected: Untrusted.of(b"total=1234567\n"))
} the_total_is_saved_as_one_line
