//! The simple case folding of Unicode 18.0.0: the mappings of its CaseFolding.txt of status C or S.

/// The runs of chars that fold to another char, in ascending order. A run folds each char from
/// `low` up to `high`, or every other one when `alternate`, to `to` plus its offset from `low`.
const RUNS: Array[Run, 219] = folding_runs()

struct Run derives Copy {
    low: u32
    high: u32
    to: u32
    alternate: bool
} Run

fn folding_runs() -> Array[Run, 219]
    waive length "one line per run of the folding table"
{
