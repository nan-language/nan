//! Machine targets: the program entry seams of the UEFI and bare targets, which Cranelift cannot express, and the boot glue the seams call. Each seam is fixed machine code the implementation emits, with relocations the image writer resolves into the image's own addresses.

/// The program entry seam's symbol, which the image writer enters.
pkg const MACHINE_ENTRY: Str = "_NSentry"

/// The least boot stack a machine image reserves, the stack UEFI guarantees an application's
/// calls into the firmware.
const MACHINE_BOOT_STACK: u64 = 128 * 1024

/// A seam frame: the most stack a vector seam uses for the state it saves.
const SEAM_FRAME: u64 = 4_096

/// The `x86_64-bare` entry seam's machine code, which the PVH boot protocol enters in 32-bit
/// protected mode: it loads the descriptor table and the entry root, enables SSE, switches to
/// long mode, sets the boot stack and calls the boot glue with the start-information pointer.
/// Its relocations, applied by the image writer, patch the addresses of the descriptor table's
/// pseudo-descriptor, of the entry root and of the 64-bit code the far jump enters, the boot
/// stack top and the call.
const BARE_SEAM: Slice[u8] = b"\xfa\xfc\x0f\x01\x15\x00\x00\x00\x00\xb8\x00\x00\x00\x00\x0f\x22\xd8\x0f\x20\xe0\x0d\x20\x06\x00\x00\x0f\x22\xe0\xb9\x80\x00\x00\xc0\x0f\x32\x0d\x00\x01\x00\x00\x0f\x30\x0f\x20\xc0\x83\xe0\xfb\x0d\x03\x00\x00\x80\x0f\x22\xc0\xea\x00\x00\x00\x00\x08\x00\x66\xb8\x10\x00\x8e\xd8\x8e\xc0\x8e\xd0\x31\xc0\x8e\xe0\x8e\xe8\x48\xbc\x00\x00\x00\x00\x00\x00\x00\x00\x89\xdf\x31\xf6\xe8\x00\x00\x00\x00\xf4\xeb\xfd"

/// The offset within `BARE_SEAM` of the 64-bit code the far jump enters.
const BARE_LONG_MODE: i64 = 0x3f

/// The memory the entry root's own tables map at its physical addresses: the first 4 GiB.
const MACHINE_MAPPED: u64 = 1 << 32

/// The bits of a page-table entry: present, writable, a large page, and caching disabled.
const MACHINE_PRESENT: u64 = 0x1

const MACHINE_WRITABLE: u64 = 0x2

const MACHINE_LARGE: u64 = 0x80

const UNCACHED: u64 = 0x18

/// The bytes a 2 MiB page maps, and the first address the entry root maps uncached: the last
/// gigabyte below 4 GiB, where the memory-mapped devices lie.
const LARGE_PAGE: u64 = 2u64 * 1024 * 1024

const DEVICES: u64 = 3 << 30

/// The bytes a 1 GiB block descriptor maps, the first of which holds the `virt` board's devices.
const AARCH64_BLOCK: u64 = 1 << 30

/// The bits of an AArch64 descriptor: a valid descriptor, a table rather than a block, the access
/// flag, inner-shareable, and the memory-attribute indices into `MAIR_EL1` of device memory and of
/// normal write-back memory, as the entry seam programs them.
const A64_VALID: u64 = 0x1

const A64_TABLE: u64 = 0x2

const A64_ACCESS: u64 = 0x400

const A64_INNER: u64 = 0x300

const A64_ATTR_DEVICE: u64 = 0 << 2

const A64_ATTR_NORMAL: u64 = 2 << 2

/// The `x86_64-uefi` entry seam's machine code: already in long mode, it sets the boot stack and
/// calls the boot glue with the image handle and system table the firmware passed.
const UEFI_SEAM: Slice[u8] = b"\x48\xbc\x00\x00\x00\x00\x00\x00\x00\x00\x48\x89\xcf\x48\x89\xd6\xe8\x00\x00\x00\x00\xf4\xeb\xfd"

/// The `aarch64-bare` entry seam's machine code, entered at EL1 with the MMU off: it enables
/// floating point and Advanced SIMD, loads the entry root, the memory attributes and the
/// translation control, which walks the entry root for the low addresses and no table for the
/// high ones, its physical address size the processor's up to 48 bits, turns the MMU and caches
/// on, sets the boot stack, and calls the boot glue with the `x0` and `x1` it entered with, `x0`
/// becoming `0x4000_0000` when both are zero. Its literal pool, after the code, holds the entry
/// root's address, the memory attributes, the translation control without its physical address
/// size, the boot stack's top and the boot glue's address; the image writer patches the first,
/// fourth and fifth.
const AARCH64_BARE_SEAM: Slice[u8] = b"\x49\x10\x38\xd5\x29\x05\x6c\xb2\x49\x10\x18\xd5\xdf\x3f\x03\xd5\xc9\x03\x00\x58\x09\x20\x18\xd5\xc9\x03\x00\x58\x09\xa2\x18\xd5\xc9\x03\x00\x58\x0a\x07\x38\xd5\x4a\x0d\x40\x92\x5f\x15\x00\xf1\xab\x00\x80\xd2\x4a\x91\x8b\x9a\x29\x81\x0a\xaa\x49\x20\x18\xd5\x1f\x87\x08\xd5\x9f\x37\x03\xd5\xdf\x3f\x03\xd5\x09\x10\x38\xd5\xaa\x00\x82\xd2\x29\x01\x0a\xaa\x09\x10\x18\xd5\xdf\x3f\x03\xd5\x09\x02\x00\x58\x3f\x01\x00\x91\x60\x00\x00\xb5\x41\x00\x00\xb5\x00\x00\xa8\xd2\xa9\x01\x00\x58\x20\x01\x3f\xd6\x7f\x20\x03\xd5\xff\xff\xff\x17\x1f\x20\x03\xd5\x00\x00\x00\x00\x00\x00\x00\x00\x00\x44\xff\x00\x00\x00\x00\x00\x10\x35\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

/// The offsets within `AARCH64_BARE_SEAM` of the literal-pool entries the image writer patches:
/// the entry root's address, the boot stack's top and the boot glue's address.
const AARCH64_SEAM_ROOT: u32 = 0x88

const AARCH64_SEAM_STACK: u32 = 0xa0

const AARCH64_SEAM_BOOT: u32 = 0xa8

/// The `aarch64-uefi` entry seam's machine code: the firmware calls it in the Procedure Call
/// Standard with the image handle in `x0` and the system table in `x1`, under the MMU it set up; it
/// enables floating point and Advanced SIMD, sets the boot stack, and calls the boot glue with the
/// two values. Its literal pool holds the boot stack's top and the boot glue's address.
const AARCH64_UEFI_SEAM: Slice[u8] = b"\x49\x10\x38\xd5\x29\x05\x6c\xb2\x49\x10\x18\xd5\xdf\x3f\x03\xd5\xc9\x00\x00\x58\x3f\x01\x00\x91\xc9\x00\x00\x58\x20\x01\x3f\xd6\x7f\x20\x03\xd5\xff\xff\xff\x17\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

/// The offsets within `AARCH64_UEFI_SEAM` of the boot stack's top and the boot glue's address.
const AARCH64_UEFI_STACK: u32 = 0x28

const AARCH64_UEFI_BOOT: u32 = 0x30

/// The AArch64 secondary entry seam's machine code, which `PSCI CPU_ON` enters at EL1 with the
/// MMU off, the start record's address in `x0`. It enables floating point and Advanced SIMD,
/// installs the entry root and turns the MMU and caches on as the boot seam does, sets the stack the
/// record names, and calls the record's glue with the record's CPU record. The record holds the
/// entry root, the stack's top, the glue's address and the CPU record, which it reads before the
/// MMU is on, from identity-mapped memory.
const AARCH64_SECONDARY_SEAM: Slice[u8] = b"\x49\x10\x38\xd5\x29\x05\x6c\xb2\x49\x10\x18\xd5\xdf\x3f\x03\xd5\x09\x00\x40\xf9\x09\x20\x18\xd5\x09\x80\x88\xd2\xe9\x1f\xa0\xf2\x09\xa2\x18\xd5\x09\xa2\x86\xd2\x09\x10\xa0\xf2\x0a\x07\x38\xd5\x4a\x0d\x40\x92\x5f\x15\x00\xf1\xab\x00\x80\xd2\x4a\x91\x8b\x9a\x29\x81\x0a\xaa\x49\x20\x18\xd5\x1f\x87\x08\xd5\x9f\x37\x03\xd5\xdf\x3f\x03\xd5\x09\x10\x38\xd5\xaa\x00\x82\xd2\x29\x01\x0a\xaa\x09\x10\x18\xd5\xdf\x3f\x03\xd5\x09\x04\x40\xf9\x3f\x01\x00\x91\x0a\x08\x40\xf9\x00\x0c\x40\xf9\x40\x01\x3f\xd6\x7f\x20\x03\xd5\xff\xff\xff\x17"

/// The offsets of a secondary start record's fields: the entry root, the stack's top, the glue's
/// address and the CPU record, as `AARCH64_SECONDARY_SEAM` reads them.
const SECONDARY_ROOT: u64 = 0

const SECONDARY_STACK: u64 = 8

const SECONDARY_GLUE: u64 = 16

const SECONDARY_CPU: u64 = 24

const SECONDARY_SIZE: u64 = 32

/// The addresses an image spans: its first address and its last address plus one.
struct Extent derives Copy {
    start: clif::Value
    end: clif::Value
} Extent

/// The boot stack a final build's image reserves: the larger of its entry function's and its
/// entry landing fn's `stack N` and a seam frame, at least `MACHINE_BOOT_STACK`, in 16-byte units so
/// that its top is aligned.
fn Lowering.boot_stack(self, program: Program) -> u64 {
    var own: u64 = 0
    var items = Array[ty::ItemId, 2].filled(program.entry)
    items[1] = program.landing_fn
    for item in items {
        let Some(sig) = self.ck.fn_sig(item) else {
            continue
        }
        let Some(stack_limit) = sig.limit_set.stack else {
            continue
        }
        if stack_limit > own {
            own = stack_limit
        }
    }
    var framed = own + SEAM_FRAME
    if framed < MACHINE_BOOT_STACK {
        framed = MACHINE_BOOT_STACK
    }
    return next_multiple_of(framed, multiple: 16)
} Lowering.boot_stack

/// Switches task stacks: saves the running stack's execution to the context at `store`, restores
/// the one at `load` and resumes it with `payload`. The x86-64 code generator lowers the switch;
/// on AArch64, which it cannot, a compiler stub does, keeping the floating-point registers host
/// code keeps across calls.
fn Lowering.switch_stacks(mut self, mut fx: Fx, store: clif::Value, load: clif::Value, payload: clif::Value) {
    if self.ck.db().target.arch() == Some(workspace::Arch.Aarch64) {
        var args = Array[clif::Value, 3].filled(store)
        args[1] = load
        args[2] = payload
        var stub = Stub.Switch
        if self.machine() {
            stub = Stub.MachineSwitch
        }
        discard mut self.call_stub(mut fx, stub, args: args.view())
        return
    }
    discard mut fx.b.stack_switch(store, load_context_ptr: load, in_payload0: payload)
} Lowering.switch_stacks

/// Emits the program entry seam of the target, which calls `boot` on a boot stack of
/// `stack_bytes` bytes.
fn Lowering.entry_seam(mut self, boot: object::FuncId, stack_bytes: u64) {
    match self.ck.db().target {
        workspace::Target.X64Bare => mut self.bare_entry_seam(boot, stack_bytes)
        workspace::Target.Aarch64Bare => mut self.aarch64_bare_entry_seam(boot, stack_bytes)
        workspace::Target.Aarch64Uefi => mut self.aarch64_uefi_entry_seam(boot, stack_bytes)
        else => mut self.uefi_entry_seam(boot, stack_bytes)
    }
} Lowering.entry_seam

/// Reserves an `x86_64-bare` image's boot stack of `stack_bytes` bytes, defines its
/// descriptor table, and emits the program entry seam, which calls `boot`.
fn Lowering.bare_entry_seam(mut self, boot: object::FuncId, stack_bytes: u64) {
    let root = mut self.entry_root()
    let stack_data = mut self.reserved_data("_NSboot_stack", size: stack_bytes, align: 16)
    let gdtr = mut self.define_gdt()
    let seam = mut self.module.declare_function(MACHINE_ENTRY, linkage: object::Linkage.Export, signature: clif::Signature.new(CALL_CONV, alloc: self.alloc))
    var relocs = mem::List[object::ModuleReloc].empty(self.alloc)
    mut relocs.push(machine_abs4(0x05, data: gdtr, addend: 0))
    mut relocs.push(machine_abs4(0x0a, data: root, addend: 0))
    mut relocs.push(object::ModuleReloc(offset: 0x39, kind: machinst::RelocKind.Absolute4, target: object::RelocTarget.Function(seam), addend: BARE_LONG_MODE))
    mut relocs.push(object::ModuleReloc(offset: 0x51, kind: machinst::RelocKind.Absolute8, target: object::RelocTarget.Data(stack_data), addend: i64.fit(stack_bytes)))
    mut relocs.push(object::ModuleReloc(offset: 0x5e, kind: machinst::RelocKind.Relative4, target: object::RelocTarget.Function(boot), addend: -4))
    mut self.module.define_function_bytes(seam, align: 16, bytes: BARE_SEAM, relocs: relocs.view())
} Lowering.bare_entry_seam

/// Reserves an `x86_64-uefi` image's boot stack of `stack_bytes` bytes and emits the program
/// entry seam. The firmware enters it in long mode under `"win64"` with the image handle and
/// system table, which it passes to `boot`.
fn Lowering.uefi_entry_seam(mut self, boot: object::FuncId, stack_bytes: u64) {
    let stack_data = mut self.reserved_data("_NSboot_stack", size: stack_bytes, align: 16)
    let seam = mut self.module.declare_function(MACHINE_ENTRY, linkage: object::Linkage.Export, signature: clif::Signature.new(CALL_CONV, alloc: self.alloc))
    var relocs = mem::List[object::ModuleReloc].empty(self.alloc)
    mut relocs.push(object::ModuleReloc(offset: 0x02, kind: machinst::RelocKind.Absolute8, target: object::RelocTarget.Data(stack_data), addend: i64.fit(stack_bytes)))
    mut relocs.push(object::ModuleReloc(offset: 0x11, kind: machinst::RelocKind.Relative4, target: object::RelocTarget.Function(boot), addend: -4))
    mut self.module.define_function_bytes(seam, align: 16, bytes: UEFI_SEAM, relocs: relocs.view())
} Lowering.uefi_entry_seam

/// Reserves an `aarch64-bare` image's boot stack and emits the program entry seam, which the
/// platform enters with the MMU off and which calls `boot` with the device tree's address and
/// zero.
fn Lowering.aarch64_bare_entry_seam(mut self, boot: object::FuncId, stack_bytes: u64) {
    let root = mut self.aarch64_entry_root()
    let stack_data = mut self.reserved_data("_NSboot_stack", size: stack_bytes, align: 16)
    let seam = mut self.module.declare_function(MACHINE_ENTRY, linkage: object::Linkage.Export, signature: clif::Signature.new(CALL_CONV, alloc: self.alloc))
    var relocs = mem::List[object::ModuleReloc].empty(self.alloc)
    mut relocs.push(object::ModuleReloc(offset: AARCH64_SEAM_ROOT, kind: machinst::RelocKind.Absolute8, target: object::RelocTarget.Data(root), addend: 0))
    mut relocs.push(object::ModuleReloc(offset: AARCH64_SEAM_STACK, kind: machinst::RelocKind.Absolute8, target: object::RelocTarget.Data(stack_data), addend: i64.fit(stack_bytes)))
    mut relocs.push(object::ModuleReloc(offset: AARCH64_SEAM_BOOT, kind: machinst::RelocKind.Absolute8, target: object::RelocTarget.Function(boot), addend: 0))
    mut self.module.define_function_bytes(seam, align: 16, bytes: AARCH64_BARE_SEAM, relocs: relocs.view())
} Lowering.aarch64_bare_entry_seam

/// Reserves an `aarch64-uefi` image's boot stack and emits the program entry seam, which the
/// firmware calls with the image handle and system table and which calls `boot`.
fn Lowering.aarch64_uefi_entry_seam(mut self, boot: object::FuncId, stack_bytes: u64) {
    let stack_data = mut self.reserved_data("_NSboot_stack", size: stack_bytes, align: 16)
    let seam = mut self.module.declare_function(MACHINE_ENTRY, linkage: object::Linkage.Export, signature: clif::Signature.new(CALL_CONV, alloc: self.alloc))
    var relocs = mem::List[object::ModuleReloc].empty(self.alloc)
    mut relocs.push(object::ModuleReloc(offset: AARCH64_UEFI_STACK, kind: machinst::RelocKind.Absolute8, target: object::RelocTarget.Data(stack_data), addend: i64.fit(stack_bytes)))
    mut relocs.push(object::ModuleReloc(offset: AARCH64_UEFI_BOOT, kind: machinst::RelocKind.Absolute8, target: object::RelocTarget.Function(boot), addend: 0))
    mut self.module.define_function_bytes(seam, align: 16, bytes: AARCH64_UEFI_SEAM, relocs: relocs.view())
} Lowering.aarch64_uefi_entry_seam

/// Emits the AArch64 secondary entry seam, which `PSCI CPU_ON` enters, and gives its symbol
/// so the starting of the other CPUs may name its address. It reads everything from the start
/// record passed in `x0`, so it needs no relocations.
fn Lowering.aarch64_secondary_seam(mut self) -> object::FuncId {
    let seam = mut self.module.declare_function("_NSsecondary", linkage: object::Linkage.Local, signature: clif::Signature.new(CALL_CONV, alloc: self.alloc))
    mut self.module.define_function_bytes(seam, align: 16, bytes: AARCH64_SECONDARY_SEAM, relocs: mem::List[object::ModuleReloc].empty(self.alloc).view())
    return seam
} Lowering.aarch64_secondary_seam

/// The address of a machine image's single secondary start record, which the boot CPU fills before
/// it starts each other CPU.
fn Lowering.secondary_record(mut self, mut fx: Fx) -> clif::Value {
    return mut self.reserved(mut fx, data_name: "_NSsecondary_record", size: SECONDARY_SIZE, align: 16)
} Lowering.secondary_record

/// The boot glue a final build's entry seam calls with the two values the platform entered
/// the image with: it records them, sets up the runtime, mints the root grant through the
/// entry landing fn, which takes as many of the values as it has parameters, and calls the
/// entry function with it.
fn Lowering.boot_glue(mut self, program: Program) -> object::FuncId {
    var signature = clif::Signature.new(CALL_CONV, alloc: self.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    let id = mut self.module.declare_function("_NSboot", linkage: object::Linkage.Local, signature)
    let landing_instance = Instance.Nir(item: program.landing_fn, role: nir::Role.Body, index: 0, args: ty::Args.none())
    let main = Instance.Nir(item: program.entry, role: self.entry_role(program.entry), index: 0, args: ty::Args.none())
    mut self.define(id, take signature, flags: LINES_HIDDEN | LINES_CRITICAL, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        let param_values = mut fx1.entry()
        mut lo1.start_boot(mut fx1, params: param_values.view())
        let landing_abi = mut lo1.abi(landing_instance)
        var args = mem::List[Held].empty(fx1.alloc)
        for value in param_values {
            if args.len() == landing_abi.params.len() {
                break
            }
            mut args.push(Held.Scalar(value))
        }
        let landing_id = mut lo1.instance(landing_instance.copy(lo1.alloc))
        let minted = mut lo1.invoke(mut fx1, invoked: Invoked.Direct(landing_id), abi: landing_abi, args: args.view())
        let main_abi = mut lo1.abi(main)
        let main_id = mut lo1.instance(main.copy(lo1.alloc))
        discard mut lo1.invoke(mut fx1, invoked: Invoked.Direct(main_id), abi: main_abi, args: Array[Held, 1].filled(minted.result).view())
        mut fx1.b.trap(clif::TrapCode(user: 1))
    })
    return id
} Lowering.boot_glue

/// The entry root, whose page tables the image holds mapping the first 4 GiB writable at their
/// physical addresses, which the entry seam or `exit_services` installs, in the format of the
/// target's architecture.
fn Lowering.entry_root(mut self) -> object::DataId {
    if self.ck.db().target.arch() == Some(workspace::Arch.Aarch64) {
        return mut self.aarch64_entry_root()
    }
    return mut self.x64_entry_root()
} Lowering.entry_root

/// The x86_64 entry root: a top-level table, a page-directory-pointer table and four page
/// directories of 2 MiB pages mapping the first 4 GiB writable at their physical addresses, the
/// last gigabyte uncached.
fn Lowering.x64_entry_root(mut self) -> object::DataId {
    let root_name = "_NSentry_root"
    match self.reservations.get(text::String.of(root_name, alloc: self.alloc)) {
        Some(reserved) => return reserved
        None => {}
    }
    let id = mut self.module.declare_data(root_name, linkage: object::Linkage.Local, writable: true, tls: false)
    var table_bytes = mem::Bytes.zeroed(2 * 4_096, alloc: self.alloc)
    for page in 0..<(MACHINE_MAPPED / LARGE_PAGE) {
        let address = page * LARGE_PAGE
        var cached: u64 = 0
        if address >= DEVICES {
            cached = UNCACHED
        }
        let page_entry = address | MACHINE_LARGE | MACHINE_WRITABLE | MACHINE_PRESENT | cached
        object::append_u64(mut table_bytes, value: page_entry)
    }
    var description = object::DataDescription.new(self.alloc)
    mut description.define(take table_bytes)
    mut description.set_align(4_096)
    let own = mut description.import_data(id)
    let table = MACHINE_WRITABLE | MACHINE_PRESENT
    expect table < 4_096
    mut description.write_data_addr(0, data: own, addend: i64.fit(4_096 + table))
    for directory in 0..<4u64 {
        let entry_offset = 4_096 + 8 * directory
        let target = 2u64 * 4_096 + 4_096 * directory + table
        mut description.write_data_addr(u32.fit(entry_offset), data: own, addend: i64.fit(target))
    }
    mut self.module.define_data(id, take description)
    discard mut self.reservations.insert(text::String.of(root_name, alloc: self.alloc), value: id)
    return id
} Lowering.x64_entry_root

/// The AArch64 entry root, a 4 KiB-granule level-0 table pointing at a level-1 table of four
/// 1 GiB block descriptors mapping the first 4 GiB: the first gigabyte, which holds the `virt`
/// board's devices, as device memory, and the rest as normal write-back inner-shareable memory,
/// at their physical addresses. Its attribute indices are those the `aarch64-bare` entry seam
/// programs into `MAIR_EL1`.
fn Lowering.aarch64_entry_root(mut self) -> object::DataId {
    let root_name = "_NSentry_root"
    match self.reservations.get(text::String.of(root_name, alloc: self.alloc)) {
        Some(reserved) => return reserved
        None => {}
    }
    let id = mut self.module.declare_data(root_name, linkage: object::Linkage.Local, writable: true, tls: false)
    // The level-0 table is zeroed; the level-1 table follows it a page later.
    var table_bytes = mem::Bytes.zeroed(2 * 4_096, alloc: self.alloc)
    for gigabyte in 0..<(MACHINE_MAPPED / AARCH64_BLOCK) {
        let address = gigabyte * AARCH64_BLOCK
        let memory = if address < AARCH64_BLOCK {
            A64_VALID | A64_ACCESS | A64_ATTR_DEVICE
        } else {
            A64_VALID | A64_ACCESS | A64_INNER | A64_ATTR_NORMAL
        }
        let block_entry = address | memory
        let at = usize.widen(4_096 + 8 * gigabyte)
        var writable = mut table_bytes.view_mut()
        mut writable.write_u64_le(at, value: block_entry)
    }
    var description = object::DataDescription.new(self.alloc)
    mut description.define(take table_bytes)
    mut description.set_align(4_096)
    let own = mut description.import_data(id)
    mut description.write_data_addr(0, data: own, addend: i64.fit(4_096 + A64_VALID + A64_TABLE))
    mut self.module.define_data(id, take description)
    discard mut self.reservations.insert(text::String.of(root_name, alloc: self.alloc), value: id)
    return id
} Lowering.aarch64_entry_root

/// The start of a boot glue: records the two values the platform entered the image with, then
/// sets up the runtime, ending with status 71 when it cannot start.
fn Lowering.start_boot(mut self, mut fx: Fx, params: Slice[clif::Value]) {
    expect params.len() > 1
    mut self.check_level(mut fx)
    let state_address = mut self.state(mut fx)
    mut fx.store(params[0], addr: state_address, offset: STATE_PLATFORM)
    mut fx.store(params[1], addr: state_address, offset: STATE_PLATFORM_TABLE)
    system_start(mut self, mut fx)
} Lowering.start_boot

/// The image's first address and last address plus one, which the image writer records.
fn Lowering.image_extent(mut self, mut fx: Fx) -> Extent {
    if self.reservations.get(text::String.of(image::IMAGE_EXTENT, alloc: self.alloc)).is_none() {
        let extent_id = mut self.module.declare_data(image::IMAGE_EXTENT, linkage: object::Linkage.Local, writable: true, tls: false)
        var description = object::DataDescription.new(self.alloc)
        mut description.define(mem::Bytes.zeroed(16, alloc: self.alloc))
        mut description.set_align(8)
        mut self.module.define_data(extent_id, take description)
        discard mut self.reservations.insert(text::String.of(image::IMAGE_EXTENT, alloc: self.alloc), value: extent_id)
    }
    let id = self.reservations.at(text::String.of(image::IMAGE_EXTENT, alloc: self.alloc))
    let extent = mut self.data_address(mut fx, id)
    let start = mut fx.load(PTR, addr: extent, offset: 0)
    let end = mut fx.load(PTR, addr: extent, offset: 8)
    return Extent(start: start, end: end)
} Lowering.image_extent

/// The descriptor table's pseudo-descriptor, which `lgdt` loads: a null descriptor, a 64-bit
/// privilege-0 code segment and a data segment, then a limit and the table's base address.
fn Lowering.define_gdt(mut self) -> object::DataId {
    let table = mut self.module.declare_data("_NSgdt", linkage: object::Linkage.Local, writable: false, tls: false)
    var table_bytes = mem::Bytes.empty(self.alloc)
    object::append_u64(mut table_bytes, value: 0)
    object::append_u64(mut table_bytes, value: 0x0020_9A00_0000_0000)
    object::append_u64(mut table_bytes, value: 0x0000_9200_0000_0000)
    var table_description = object::DataDescription.new(self.alloc)
    mut table_description.define(take table_bytes)
    mut table_description.set_align(8)
    mut self.module.define_data(table, description: take table_description)
    let gdtr = mut self.module.declare_data("_NSgdtr", linkage: object::Linkage.Local, writable: false, tls: false)
    var gdtr_bytes = mem::Bytes.empty(self.alloc)
    object::append_u16(mut gdtr_bytes, value: 23)
    object::append_u64(mut gdtr_bytes, value: 0)
    var gdtr_description = object::DataDescription.new(self.alloc)
    mut gdtr_description.define(take gdtr_bytes)
    mut gdtr_description.set_align(8)
    let reference = mut gdtr_description.import_data(table)
    mut gdtr_description.write_data_addr(2, data: reference, addend: 0)
    mut self.module.define_data(gdtr, description: take gdtr_description)
    return gdtr
} Lowering.define_gdt

/// An absolute 4-byte relocation of a data object's address plus `addend` at `offset`.
fn machine_abs4(offset: u32, data: object::DataId, addend: i64) -> object::ModuleReloc {
    return object::ModuleReloc(offset: offset, kind: machinst::RelocKind.Absolute4, target: object::RelocTarget.Data(data), addend: addend)
} machine_abs4

/// A size or alignment, 1 when it is 0.
fn at_least_one(value: u64) -> u64 {
    if value == 0 {
        return 1
    }
    return value
} at_least_one
