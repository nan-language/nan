//! Acceptance tests of the dialer's retries.

/// Whether a dial gave up, abandoning a connection it made.
fn gave_up(take outcome: Result[sys::net::Conn, ConnectError]) -> bool {
    var refused = false
    match outcome {
        Ok(conn) => take conn.abandon()
        Err(ConnectError.GaveUp) => {
            refused = true
        }
        Err(ConnectError.Net(_)) => {}
        Err(ConnectError.Cancelled(_)) => {}
    }
    return refused
} gave_up

test refusals_pause_twice_as_long_each_time for connect_with_backoff {
    let world = testing::world()
    let outcome = attempt await connect_with_backoff(world.net, clock: world.clock, port: 4_201, attempts: 4)
    let refused = gave_up(take outcome)
    let ended_ms = try world.clock.elapsed_ms()
    expect refused
    expect ended_ms == 700
} refusals_pause_twice_as_long_each_time

test pauses_stop_growing_at_the_longest for connect_with_backoff {
    let world = testing::world()
    let outcome = attempt await connect_with_backoff(world.net, clock: world.clock, port: 4_202, attempts: 8)
    let refused = gave_up(take outcome)
    let ended_ms = try world.clock.elapsed_ms()
    expect refused
    expect ended_ms == 6_300
} pauses_stop_growing_at_the_longest

test no_attempts_give_up_at_once for connect_with_backoff {
    let world = testing::world()
    let outcome = attempt await connect_with_backoff(world.net, clock: world.clock, port: 4_203, attempts: 0)
    let refused = gave_up(take outcome)
    let ended_ms = try world.clock.elapsed_ms()
    expect refused
    expect ended_ms == 0
} no_attempts_give_up_at_once

test a_late_listener_is_reached for connect_with_backoff {
    let world = testing::world()
    let net = world.net
    let clock = world.clock
    try await task::scope(world.exec, body: fn(s: task::Scope) fails ConnectError uses wait {
        discard s.spawn(fn() fails sys::net::NetError uses wait {
            try await clock.sleep(250)
            var listener = try await net.listen(4_204)
            let server = try await mut listener.accept()
            take server.abandon()
        })
        let conn = try await connect_with_backoff(net, clock, port: 4_204, attempts: 5)
        take conn.abandon()
    })
    let connected_ms = try clock.elapsed_ms()
    expect connected_ms == 300
} a_late_listener_is_reached
