#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

ifeq ($(DEB_HOST_ARCH),amd64)
image := nan-v$(DEB_VERSION_UPSTREAM)-x86_64-linux
cross := gcc-aarch64-linux-gnu
else
image := nan-v$(DEB_VERSION_UPSTREAM)-aarch64-linux
cross := gcc-x86-64-linux-gnu
endif

%:
	dh $@

override_dh_auto_install:
	install -Dm755 $(image) debian/nan/usr/bin/nan

override_dh_strip override_dh_dwz:

override_dh_gencontrol:
	dh_gencontrol -- -Vnan:CrossCompiler=$(cross)
