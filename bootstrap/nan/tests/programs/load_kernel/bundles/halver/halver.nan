//! Scaler 5, halving through floats, and a job logging and giving back its input.

contribute greeting::scalers halving = greeting::Scaler(id: 5, scale: halve)

fn halve(value: u32) -> u32 {
    return u32.fit(f64.widen(value) * 0.5)
} halve

fn main(take world: nanos::World, take input: u32) -> u32 fails task::Cancelled uses wait {
    world.log.info("halver", value: input)
    return input
} main
