//! An AArch64 bare kernel holding component instances of a nanos bundle.

package aarch64_nanos_components {
    language 1
    targets aarch64-bare
    entry main
    dep refusals "./refusals"
    allow capability in aarch64_nanos_components
    allow device in aarch64_nanos_components
    allow trusted in aarch64_nanos_components
    allow validate in aarch64_nanos_components
} aarch64_nanos_components
