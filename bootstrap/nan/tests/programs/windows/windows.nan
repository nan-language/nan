//! A Windows program's files, standard streams, sleeps, deadline, random bytes, loopback connection and contained traps.

fn ratio(total: u32, items: u32) -> u32 {
    return total / items
} ratio

fn spin(seed: u64) -> u64 {
    var value = seed
    while value != 1 {
        value = value.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) | 2
    }
    return value
} spin

fn depth(level: u64) -> u64 {
    if level == 0 {
        return 0
    }
    return depth(level + 1) + 1
} depth

fn files(world: host::World) fails sys::fs::FsError uses wait {
    let fs = world.fs
    try await fs.write_all("notes/day", data: b"hello")
    let read = try await fs.read_all("notes/day", alloc: world.alloc)
    world.log.info("read bytes", value: read.byte_len())
    try await fs.remove("notes/day")
    match attempt await fs.read_all("notes/day", alloc: world.alloc) {
        Ok(_) => world.log.info("read after removal", value: true)
        Err(error) => world.log.info("read after removal failed", value: error)
    }
} files

fn streams(world: host::World) fails sys::StdioError uses wait {
    var buf = Untrusted.of(Array[u8, 8].filled(0))
    let count = try await world.stdio.read_in(mut buf.view_mut())
    world.log.info("input read", value: count)
    try await world.stdio.write_out(b"output written\n")
} streams

fn timing(world: host::World) fails task::Cancelled uses wait {
    let clock = world.clock
    try await clock.sleep(20)
    let outcome = try await task::within(clock, ms: 20, body: fn() -> u32 fails task::Cancelled uses wait {
        try await clock.sleep(5_000)
        return 1
    })
    world.log.info("deadline expired", value: outcome.is_none())
    var drawn = Array[u8, 32].filled(0)
    discard attempt world.random.fill(mut drawn.view_mut())
    var any = false
    for byte in drawn {
        any = any or byte != 0
    }
    world.log.info("random drawn", value: any)
} timing

fn connection(world: host::World) fails sys::net::NetError uses wait {
    let net = world.net
    var listener = try await net.listen(4_501)
    var client = try await net.connect("localhost", port: 4_501)
    defer take client.abandon()
    var server = try await mut listener.accept()
    defer take server.abandon()
    discard try await mut client.write(b"ping")
    var buf = Untrusted.of(Array[u8, 4].filled(0))
    let count = try await mut server.read(mut buf.view_mut())
    world.log.info("received", value: count)
} connection

fn traps(world: host::World) fails task::Cancelled uses wait {
    let exec = world.exec
    let stopped = try await sys::Domain.run(fn() fails task::Cancelled uses wait {
        try await task::scope(exec, body: fn(s: task::Scope) {
            discard s.spawn(fn() -> u64 {
                return spin(3)
            })
            discard ratio(10, items: 0)
        })
    }, exec, alloc: world.alloc)
    match stopped {
        Ok(_) => world.log.info("stops returned", value: true)
        Err(trap) => world.log.info("stops kind", value: trap.kind())
    }
    let overflowed = try await sys::Domain.run(fn() -> u64 {
        return depth(1)
    }, exec, alloc: world.alloc)
    match overflowed {
        Ok(_) => world.log.info("overflow returned", value: true)
        Err(trap) => world.log.info("overflow kind", value: trap.kind())
    }
} traps

fn main(take world: host::World) -> u8 fails task::Cancelled uses wait {
    match attempt await files(world) {
        Ok(_) => {}
        Err(error) => world.log.info("files failed", value: error)
    }
    match attempt await streams(world) {
        Ok(_) => {}
        Err(error) => world.log.info("streams failed", value: error)
    }
    try await timing(world)
    match attempt await connection(world) {
        Ok(_) => {}
        Err(error) => world.log.info("connection failed", value: error)
    }
    try await traps(world)
    return 3
} main
