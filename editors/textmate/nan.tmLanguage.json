{
  "name": "NaN",
  "scopeName": "source.nan",
  "fileTypes": ["nan"],
  "patterns": [
    { "include": "#rejected" },
    { "include": "#indentation" },
    { "include": "#trailing-whitespace" },
    { "include": "#line-start" },
    { "include": "#comment" },
    { "include": "#literals" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#identifier" },
    { "include": "#punctuation" },
    { "include": "#unexpected" }
  ],
  "repository": {
    "rejected": {
      "match": "[\\x{0}-\\x{9}\\x{B}-\\x{1F}\\x{7F}-\\x{A0}\\x{AD}\\x{34F}\\x{61C}\\x{115F}\\x{1160}\\x{1680}\\x{17B4}\\x{17B5}\\x{180B}-\\x{180F}\\x{2000}-\\x{200F}\\x{2028}-\\x{202F}\\x{205F}-\\x{206F}\\x{3000}\\x{3164}\\x{FE00}-\\x{FE0F}\\x{FEFF}\\x{FFA0}\\x{FFF0}-\\x{FFFB}\\x{1BCA0}-\\x{1BCA3}\\x{1D173}-\\x{1D17A}\\x{E0000}-\\x{E0FFF}]",
      "name": "invalid.illegal.rejected-code-point.nan"
    },
    "indentation": {
      "match": "^(?:    )*+ {1,3}(?! |$)",
      "name": "invalid.illegal.indentation.nan"
    },
    "trailing-whitespace": {
      "match": " +$",
      "name": "invalid.illegal.trailing-whitespace.nan"
    },
    "line-start": {
      "patterns": [
        {
          "begin": "^ *+(//[/!])",
          "end": "$",
          "beginCaptures": { "1": { "name": "comment.line.documentation.nan punctuation.definition.comment.nan" } },
          "contentName": "comment.line.documentation.nan",
          "patterns": [{ "include": "#rejected" }, { "include": "#trailing-whitespace" }]
        },
        {
          "begin": "^ *+(\\\\\\\\)",
          "end": "$",
          "beginCaptures": { "1": { "name": "string.unquoted.text-line.nan punctuation.definition.string.begin.nan" } },
          "contentName": "string.unquoted.text-line.nan",
          "patterns": [{ "include": "#rejected" }, { "include": "#trailing-whitespace" }, { "include": "#text-escapes" }]
        },
        {
          "match": "(?://[/!]|\\\\\\\\).*",
          "name": "invalid.illegal.not-at-line-start.nan"
        }
      ]
    },
    "comment": {
      "begin": "//",
      "end": "$",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.nan" } },
      "name": "comment.line.double-slash.nan",
      "patterns": [{ "include": "#rejected" }, { "include": "#trailing-whitespace" }]
    },
    "literals": {
      "patterns": [
        {
          "begin": "b\"(?=(?:[^\"\\\\]|\\\\.)*\")",
          "end": "\"",
          "name": "string.quoted.double.bytes.nan",
          "patterns": [{ "include": "#rejected" }, { "include": "#non-ascii-byte" }, { "include": "#bytes-escapes" }]
        },
        {
          "begin": "b'(?=(?:[^'\\\\]|\\\\(?:x[0-9A-Fa-f]{2}|u\\{[^}']*\\}|.))')",
          "end": "'",
          "name": "string.quoted.single.byte.nan",
          "patterns": [{ "include": "#rejected" }, { "include": "#non-ascii-byte" }, { "include": "#bytes-escapes" }]
        },
        {
          "begin": "\"(?=(?:[^\"\\\\]|\\\\.)*\")",
          "end": "\"",
          "name": "string.quoted.double.nan",
          "patterns": [{ "include": "#rejected" }, { "include": "#text-escapes" }]
        },
        {
          "begin": "'(?=(?:[^'\\\\]|\\\\(?:x[0-9A-Fa-f]{2}|u\\{[^}']*\\}|.))')",
          "end": "'",
          "name": "string.quoted.single.char.nan",
          "patterns": [{ "include": "#rejected" }, { "include": "#text-escapes" }]
        },
        {
          "match": "b?'(?:[^'\\\\]|\\\\.)*'",
          "name": "invalid.illegal.char-literal-size.nan"
        },
        {
          "match": "b?[\"'].*",
          "name": "invalid.illegal.unterminated-literal.nan"
        }
      ]
    },
    "escape": {
      "match": "\\\\[\\\\\"'nrt0]",
      "name": "constant.character.escape.nan"
    },
    "text-escapes": {
      "patterns": [
        { "include": "#escape" },
        {
          "match": "\\\\(?:x[0-7][0-9A-Fa-f]|u\\{(?=[0-9A-Fa-f]{1,6}\\})0*(?:[0-9A-Fa-f]{0,3}|[1-9A-CEFa-cef][0-9A-Fa-f]{3}|[Dd][0-7][0-9A-Fa-f]{2}|[1-9A-Fa-f][0-9A-Fa-f]{4}|10[0-9A-Fa-f]{4})\\})",
          "name": "constant.character.escape.nan"
        },
        { "include": "#invalid-escape" }
      ]
    },
    "bytes-escapes": {
      "patterns": [
        { "include": "#escape" },
        { "match": "\\\\x[0-9A-Fa-f]{2}", "name": "constant.character.escape.nan" },
        { "include": "#invalid-escape" }
      ]
    },
    "invalid-escape": {
      "match": "\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|.)?",
      "name": "invalid.illegal.escape.nan"
    },
    "non-ascii-byte": {
      "match": "[^\\x{0}-\\x{7F}]",
      "name": "invalid.illegal.non-ascii-byte.nan"
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?:0|[1-9](?:_?[0-9])*)\\.[0-9](?:_?[0-9])*(?:f32|f64)?(?![A-Za-z0-9_]|\\.[0-9])",
          "name": "constant.numeric.float.nan"
        },
        {
          "match": "(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0b[01](?:_?[01])*|0|[1-9](?:_?[0-9])*)(?:[ui](?:8|16|32|64|size))?(?![A-Za-z0-9_]|\\.[0-9])",
          "name": "constant.numeric.integer.nan"
        },
        {
          "match": "[0-9](?:[A-Za-z0-9_]|\\.[0-9])*",
          "name": "invalid.illegal.numeric.nan"
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "match": "(?:true|false)(?![A-Za-z0-9_])", "name": "constant.language.boolean.nan" },
        { "match": "(?:self)(?![A-Za-z0-9_])", "name": "variable.language.self.nan" },
        { "match": "(?:_)(?![A-Za-z0-9_])", "name": "variable.language.wildcard.nan" },
        { "match": "(?:and|or|not)(?![A-Za-z0-9_])", "name": "keyword.operator.logical.nan" },
        {
          "match": "(?:attempt|await|break|continue|defer|discard|else|fail|first|for|if|in|loop|match|return|try|undefer|when|while)(?![A-Za-z0-9_])",
          "name": "keyword.control.nan"
        },
        {
          "match": "(?:const|contribute|enum|fn|impl|interface|layout|let|package|registers|registry|retired|struct|test|var)(?![A-Za-z0-9_])",
          "name": "storage.type.nan"
        },
        {
          "match": "(?:derives|fails|foreign|interrupt|landing|limits|linear|mut|pkg|proj|pub|take|trusted|uses|validator|where)(?![A-Za-z0-9_])",
          "name": "storage.modifier.nan"
        },
        {
          "match": "(?:assert|assume|dbg|decreases|ensures|expect|invariant|requires|todo|waive)(?![A-Za-z0-9_])",
          "name": "keyword.other.nan"
        }
      ]
    },
    "identifier": {
      "match": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "punctuation": {
      "patterns": [
        { "match": "<<=|>>=", "name": "keyword.operator.assignment.compound.nan" },
        { "match": "\\.\\.[<=]", "name": "keyword.operator.range.nan" },
        { "match": "&&|\\|\\||\\.\\.|--", "name": "invalid.illegal.foreign.nan" },
        { "match": "::", "name": "punctuation.separator.namespace.nan" },
        { "match": "->|=>", "name": "keyword.operator.arrow.nan" },
        { "match": "[-+*/%&|^]=", "name": "keyword.operator.assignment.compound.nan" },
        { "match": "<<|>>", "name": "keyword.operator.bitwise.shift.nan" },
        { "match": "[=!<>]=", "name": "keyword.operator.comparison.nan" },
        { "match": "[!?;]", "name": "invalid.illegal.foreign.nan" },
        { "match": "[()]", "name": "punctuation.section.parens.nan" },
        { "match": "[\\[\\]]", "name": "punctuation.section.brackets.nan" },
        { "match": "[{}]", "name": "punctuation.section.braces.nan" },
        { "match": ",", "name": "punctuation.separator.comma.nan" },
        { "match": ":", "name": "punctuation.separator.colon.nan" },
        { "match": "\\.", "name": "punctuation.accessor.nan" },
        { "match": "=", "name": "keyword.operator.assignment.nan" },
        { "match": "[-+*/%]", "name": "keyword.operator.arithmetic.nan" },
        { "match": "[&|^~]", "name": "keyword.operator.bitwise.nan" },
        { "match": "[<>]", "name": "keyword.operator.comparison.nan" }
      ]
    },
    "unexpected": {
      "patterns": [
        { "match": "[^\\x{0}-\\x{7F}]", "name": "invalid.illegal.non-ascii.nan" },
        { "match": "[@#$`\\\\]", "name": "invalid.illegal.unexpected-character.nan" }
      ]
    }
  }
}
