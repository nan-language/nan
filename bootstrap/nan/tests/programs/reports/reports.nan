//! Each case traps in a domain of its own, and its report is logged.

struct Point derives Eq {
    x: i32
    y: i32
} Point

enum Shape derives Eq {
    Dot(Point)
    Box(low: Point, high: Point)
    Empty
} Shape

struct Span {
    start: u32
    end: u32 where start <= end
} Span

layout Flags: u8 {
    mode: bit 0..=2
    rest: rest
} Flags

fn split_trunc(total: i32, parts: i32) -> i32 {
    return total.div_trunc(parts - 1)
} split_trunc

fn split_floor(total: i32, parts: i32) -> i32 {
    return total.div_floor(parts)
} split_floor

fn shift_arith(value: i64, amount: u32) -> i64 {
    return value.shr_arith(amount * 8)
} shift_arith

fn named(name: Str) -> u32 {
    expect name == "b\"q\u{E9}\n"
    return 0
} named

fn pick_option(value: Option[u32], other: Option[u32]) -> u32 {
    expect value == other
    return 0
} pick_option

fn same(left: Shape, right: Shape) -> u32 {
    expect left == right
    return 0
} same

fn viewed(view: Slice[u8]) -> u32 {
    expect view == b"x"
    return 0
} viewed

fn total_array(values: Array[u8, 3]) -> u32
    requires values != Array[u8, 3].filled(7)
{
    return 0
} total_array

fn pick_slot(values: Array[u32, 4], slot: usize) -> u32
    requires slot < 4
{
    return values[slot]
} pick_slot

fn outer(slot: usize) -> u32 {
    return pick_slot(Array[u32, 4].filled(1), slot: slot + 4)
} outer

fn half(value: u32) -> u32
    ensures result < 10
{
    return value / 2
} half

fn make(start: u32, end: u32) -> u32 {
    let span = Span(start: start, end: end)
    return span.end
} make

fn store(mode: u8) -> u8 {
    var flags = Flags(mode: 1, rest: 0)
    flags.mode = mode + 1
    return flags.mode
} store

fn build_flags(mode: u8) -> u8 {
    let flags = Flags(rest: 0, mode: mode * 2)
    return flags.mode
} build_flags

fn pick_char(letter: char, ratio: f64) -> u32 {
    expect ratio > 0.25
    expect letter == 'q'
    return 0
} pick_char

fn add(a: u8, b: u8) -> u8 {
    let total = a + b
    let more = total + (b * 2)
    return more
} add

fn bump(start: u8, step: u8) -> u8 {
    var x = start
    x += step * 1
    return x
} bump

fn flip(value: i32) -> i32 {
    return -value
} flip

fn third(values: Slice[u8], at: usize) -> u8 {
    return values[at + 1]
} third

fn third_at(values: Slice[u8], at: usize) -> u8 {
    return values.at(at + 1)
} third_at

fn narrow(raw: u32) -> u8 {
    return u8.fit(raw + 1)
} narrow

fn move_left(value: u32, amount: u32) -> u32 {
    return value << (amount * 2)
} move_left

fn down(level: u32, zero: u32) -> u32 {
    if level == 0 {
        return 10 / zero
    }
    return down(level - 1, zero: zero) + 1
} down

fn report[T: Send](world: host::World, take outcome: Result[T, sys::Trap]) {
    match outcome {
        Ok(_) => world.log.info("returned", value: true)
        Err(trap) => world.log.info("trap", value: trap)
    }
} report

fn main(take world: host::World) fails task::Cancelled uses wait {
    let exec = world.exec
    let alloc = world.alloc
    report(world, outcome: try await sys::Domain.run(fn() -> i32 {
        return split_trunc(-7, parts: 1)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> i32 {
        return split_floor(-2147483647 - 1, parts: -1)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> i64 {
        return shift_arith(-9, amount: 8)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return named("a\"\\\u{E9}\t")
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return pick_option(Some(4), other: None)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return same(Shape.Box(low: Point(x: -1, y: 2), high: Point(x: 3, y: 4)), right: Shape.Dot(Point(x: 0, y: 0)))
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return viewed(b"x\ny\xFF")
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return total_array(Array[u8, 3].filled(7))
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return outer(3)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return half(40)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return make(5, end: 3)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u8 {
        return store(7)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u8 {
        return build_flags(5)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return pick_char('\u{2060}', ratio: 0.5)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u8 {
        return add(100, b: 70)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u8 {
        return bump(200, step: 100)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> i32 {
        return flip(-2147483647 - 1)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u8 {
        return third(b"ab", at: 1)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u8 {
        return third_at(b"ab", at: 1)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u8 {
        return narrow(300)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return move_left(1, amount: 20)
    }, exec, alloc))
    report(world, outcome: try await sys::Domain.run(fn() -> u32 {
        return down(30, zero: 0)
    }, exec, alloc))
} main
