//! Reads, writes and closes on descriptors: standard streams, files and connections.

foreign fn close(fd: i32) -> i32 convention "sysv"

/// Reads at most `len` bytes at `address` from a descriptor at its position: the count, 0 at
/// the end, or a negative error number.
pkg fn read_at(fd: i32, address: u64, len: usize) -> i32 fails task::Cancelled uses wait {
    loop {
        let count = try await submit(operation(OP_READ, fd, address, len: u32.saturate(len), offset: ~0))
        if count != -EINTR and count != -EAGAIN {
            return count
        }
    }
} read_at

/// Writes a prefix of `data` to a descriptor at its position: the count written, at least 1
/// when `data` is not empty, or a negative error number.
pkg fn write_some(fd: i32, data: Slice[u8]) -> i32 fails task::Cancelled uses wait {
    loop {
        let count = try await submit(operation(OP_WRITE, fd, address: address_of(data), len: u32.saturate(data.len()), offset: ~0))
        if count != -EINTR and count != -EAGAIN {
            return count
        }
    }
} write_some

/// Closes a descriptor.
pkg fn release(fd: i32) {
    discard close(fd)
} release

pkg fn stdio_read(fd: i32, address: u64, len: usize) -> usize fails sys::StdioError uses wait {
    let count = try await read_at(fd, address, len)
    if count < 0 {
        fail sys::StdioError.Closed
    }
    return usize.fit(count)
} stdio_read

pkg fn stdio_write(fd: i32, data: Slice[u8]) fails sys::StdioError uses wait {
    var done: usize = 0
    while done < data.len() {
        let Some(parts) = data.split_at(done) else {
            return
        }
        let count = try await write_some(fd, data: parts.tail)
        if count <= 0 {
            fail sys::StdioError.Closed
        }
        done += usize.fit(count)
    }
} stdio_write
