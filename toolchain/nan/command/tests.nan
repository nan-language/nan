//! The tests of the `nan` command line.

test the_primer_writes_each_link_as_its_text_outside_code for printed {
    let alloc = testing::world().alloc
    var section = mem::List[text::String].empty(alloc)
    mut section.push(text::String.of("A static `Slice[u8]`; the [escapes](01-lexical.md#text-literals), [`nan verify`](31-trust.md#release-gate) and `fn Type.name[G](params)`.", alloc))
    mut section.push(text::String.of("```nan", alloc))
    mut section.push(text::String.of("let body = fn[mut conn]() {}", alloc))
    mut section.push(text::String.of("```", alloc))
    let lines = printed(section.view(), alloc)
    expect lines.len() == 4
    expect lines[0].as_str() == "A static `Slice[u8]`; the escapes, `nan verify` and `fn Type.name[G](params)`."
    expect lines[1].as_str() == "```nan"
    expect lines[2].as_str() == "let body = fn[mut conn]() {}"
    expect lines[3].as_str() == "```"
} the_primer_writes_each_link_as_its_text_outside_code

test an_internal_error_names_its_invariant_by_each_line_of_its_description for invariant_lines {
    let alloc = testing::world().alloc
    let lines = invariant_lines("trap.expect at nan/check/check.nan:3 in nan::check::f\n    expect a < b\n    a = 2, b = 1\n", alloc)
    expect lines.len() == 3
    expect lines[0].as_str() == "invariant trap.expect at nan/check/check.nan:3 in nan::check::f"
    expect lines[1].as_str() == "        expect a < b"
    expect lines[2].as_str() == "        a = 2, b = 1"
} an_internal_error_names_its_invariant_by_each_line_of_its_description
