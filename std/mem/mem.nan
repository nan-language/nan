test reserved_inserts_draw_nothing for Pool.reserve {
    let budget = testing::world().alloc.split(65_536)
    var numbers = Pool[u8, Unit].empty(budget.alloc())
    mut numbers.reserve(1)
    take budget.close()
    let handle = try mut numbers.try_insert(4)
    expect numbers[handle] == 4
} reserved_inserts_draw_nothing

test try_reserved_inserts_draw_nothing for Pool.try_reserve {
    let budget = testing::world().alloc.split(65_536)
    var numbers = Pool[u8, Unit].empty(budget.alloc())
    let reserved = attempt mut numbers.try_reserve(1)
    take budget.close()
    expect reserved.is_ok()
    let handle = try mut numbers.try_insert(4)
    expect numbers[handle] == 4
} try_reserved_inserts_draw_nothing

