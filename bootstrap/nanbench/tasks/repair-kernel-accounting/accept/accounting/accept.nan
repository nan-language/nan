//! Acceptance tests of the tick accounting.

/// The current CPU's counts.
fn counts_of(per_cpu: hw::PerCpu[CpuTicks]) -> CpuTicks {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> CpuTicks limits notrap {
        return per_cpu.with(t, body: fn(mut mine: CpuTicks) -> CpuTicks limits notrap, terminates, noalloc {
            return CpuTicks(ticks: mine.ticks, idle: mine.idle)
        })
    })
} counts_of

test ticks_are_counted_on_the_current_cpu for count_tick {
    let per_cpu = hw::PerCpu.of(fn(cpu: u32) => CpuTicks(ticks: 0, idle: 0), alloc: testing::world().alloc)
    let last = hw::without_irqs(fn(t: hw::IrqsDisabled) -> u32 limits notrap {
        discard count_tick(per_cpu, t, idle: false)
        discard count_tick(per_cpu, t, idle: true)
        return count_tick(per_cpu, t, idle: false)
    })
    let counts = counts_of(per_cpu)
    expect last == 3
    expect counts.ticks == 3
    expect counts.idle == 1
    expect busy_percent(counts) == 66
} ticks_are_counted_on_the_current_cpu

test tick_counts_wrap for count_tick {
    let per_cpu = hw::PerCpu.of(fn(cpu: u32) => CpuTicks(ticks: 4_294_967_295, idle: 4_294_967_295), alloc: testing::world().alloc)
    let wrapped = hw::without_irqs(fn(t: hw::IrqsDisabled) -> u32 limits notrap {
        return count_tick(per_cpu, t, idle: true)
    })
    let counts = counts_of(per_cpu)
    expect wrapped == 0
    expect counts.idle == 0
} tick_counts_wrap

test busy_shares_round_down for busy_percent {
    expect busy_percent(CpuTicks(ticks: 0, idle: 0)) == 0
    expect busy_percent(CpuTicks(ticks: 3, idle: 1)) == 66
    expect busy_percent(CpuTicks(ticks: 4_000_000_000, idle: 0)) == 100
    expect busy_percent(CpuTicks(ticks: 4_000_000_000, idle: 1_000_000_000)) == 75
    expect busy_percent(CpuTicks(ticks: 5, idle: 7)) == 0
} busy_shares_round_down
