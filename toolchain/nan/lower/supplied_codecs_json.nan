//! The `text::json` format's writing and reading of each kind; a reading gives its values and the code of its failure, zero for none.

const BASE64: Slice[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

/// A number's text: its first byte's address, its end, whether it has a fraction or an
/// exponent, and the code of its failure.
struct NumberReading derives Copy {
    start: clif::Value
    end: clif::Value
    fractional: clif::Value
    failed: clif::Value
} NumberReading

/// A variant's key: its length, whether a payload follows, and the code of its failure.
struct VariantReading derives Copy {
    len: clif::Value
    payload: clif::Value
    failed: clif::Value
} VariantReading

fn json_code(mut fx: Fx, code: i64) -> clif::Value {
    return mut fx.int(clif::Type.Int32, value: code)
} json_code

fn succeeded(mut fx: Fx, failed: clif::Value) -> clif::Value {
    return mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: failed, y: 0)
} succeeded

/// Writes an integer in decimal, with `-` before a negative signed one.
fn put_integer(mut lo: Lowering, mut fx: Fx, state: clif::Value, value: clif::Value, signed: bool) {
    var magnitude = value
    if signed {
        let negative = mut fx.b.icmp_imm_s(clif::IntCC.SignedLessThan, x: value, y: 0)
        mut fx.if_true(negative, then: fn[mut lo](mut fx1: Fx) {
            put_literal(mut lo, fx: mut fx1, state, bytes: b"-")
        })
        let flipped = mut fx.b.ineg(value)
        magnitude = mut fx.b.select(negative, x: flipped, y: value)
    }
    let digits = mut fx.slot(20, align: 1)
    let end = mut fx.ptr(20)
    let initial = fx.list2(magnitude, b: end)
    let ended = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 2
        let remaining = current[0]
        let position = current[1]
        let ten = mut fx1.ptr(10)
        let remainder = mut fx1.b.urem(remaining, y: ten)
        let ascii = mut fx1.b.iadd_imm_s(remainder, y: i64.widen(b'0'))
        let digit = mut fx1.b.ireduce(clif::Type.Int8, x: ascii)
        let at = mut fx1.b.iadd_imm_s(position, y: -1)
        let address = mut fx1.b.iadd(digits, y: at)
        mut fx1.store(digit, addr: address, offset: 0)
        let rest = mut fx1.b.udiv(remaining, y: ten)
        let more = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: rest, y: 0)
        return Pass(again: more, next: fx1.list2(rest, b: at))
    })
    expect ended.len() == 2
    let head = ended[1]
    let start = mut fx.b.iadd(digits, y: head)
    let count = mut fx.b.isub(end, y: head)
    put_bytes(mut lo, mut fx, state, start, count)
} put_integer

/// Writes a float as its rendering, `NaN`, `inf` and `-inf` as JSON strings.
fn put_float(mut lo: Lowering, mut fx: Fx, state: clif::Value, scalar: ty::Scalar, value: clif::Value) {
    let buffer = mut fx.slot(40, align: 8)
    var name = "f64_text"
    if scalar == ty::Scalar.Float32 {
        name = "f32_text"
    }
    var args = mem::List[Held].empty(lo.alloc)
    mut args.push(Held.Scalar(value))
    mut args.push(Held.Address(buffer))
    let called = mut lo.platform_call(mut fx, name, args: args.view())
    let len = called.result.scalar_value()
    let lead = mut fx.load(clif::Type.Int8, addr: buffer, offset: 0)
    let second = mut fx.load(clif::Type.Int8, addr: buffer, offset: 1)
    let nan = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'N'))
    let inf = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'i'))
    let minus = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'-'))
    let then_inf = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: second, y: i64.widen(b'i'))
    let minus_inf = mut fx.b.band(minus, y: then_inf)
    let nan_or_inf = mut fx.b.bor(nan, y: inf)
    let special = mut fx.b.bor(nan_or_inf, y: minus_inf)
    mut fx.if_true(special, then: fn[mut lo](mut fx1: Fx) {
        put_literal(mut lo, fx: mut fx1, state, bytes: b"\"")
    })
    put_bytes(mut lo, mut fx, state, start: buffer, count: len)
    mut fx.if_true(special, then: fn[mut lo](mut fx1: Fx) {
        put_literal(mut lo, fx: mut fx1, state, bytes: b"\"")
    })
} put_float

/// Writes text as a JSON string, escaping as JSON encoding states.
fn put_string(mut lo: Lowering, mut fx: Fx, state: clif::Value, start: clif::Value, len: clif::Value) {
    put_literal(mut lo, mut fx, state, bytes: b"\"")
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: len, body: fn[mut lo](mut fx1: Fx, index: clif::Value) {
        let at = mut fx1.b.iadd(start, y: index)
        let loaded = mut fx1.load(clif::Type.Int8, addr: at, offset: 0)
        let byte = mut fx1.b.uextend(clif::Type.Int64, x: loaded)
        let unhandled = mut fx1.int(clif::Type.Int8, value: 0)
        let after_quote = put_escape(mut lo, fx: mut fx1, state, byte, raw: b'"', escaped: b"\\\"", handled: unhandled)
        let after_backslash = put_escape(mut lo, fx: mut fx1, state, byte, raw: b'\\', escaped: b"\\\\", handled: after_quote)
        let after_newline = put_escape(mut lo, fx: mut fx1, state, byte, raw: b'\n', escaped: b"\\n", handled: after_backslash)
        let after_return = put_escape(mut lo, fx: mut fx1, state, byte, raw: b'\r', escaped: b"\\r", handled: after_newline)
        let after_tab = put_escape(mut lo, fx: mut fx1, state, byte, raw: b'\t', escaped: b"\\t", handled: after_return)
        let after_backspace = put_escape(mut lo, fx: mut fx1, state, byte, raw: 8, escaped: b"\\b", handled: after_tab)
        let handled = put_escape(mut lo, fx: mut fx1, state, byte, raw: 12, escaped: b"\\f", handled: after_backspace)
        let control = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: byte, y: 0x20)
        let unescaped = mut fx1.b.bxor_imm_s(handled, y: 1)
        let unicode = mut fx1.b.band(unescaped, y: control)
        mut fx1.if_true(unicode, then: fn[mut lo](mut fx2: Fx) {
            put_literal(mut lo, fx: mut fx2, state, bytes: b"\\u00")
            put_hex_digit(mut fx2, state, byte, shift: 4)
            put_hex_digit(mut fx2, state, byte, shift: 0)
        })
        let special = mut fx1.b.bor(handled, y: control)
        let plain = mut fx1.b.bxor_imm_s(special, y: 1)
        mut fx1.if_true(plain, then: fn(mut fx2: Fx) {
            put_byte(mut fx2, state, byte)
        })
    })
    put_literal(mut lo, mut fx, state, bytes: b"\"")
} put_string

/// Writes `escaped` when `byte` is `raw`: whether a byte was handled, `handled` or this test.
fn put_escape(mut lo: Lowering, mut fx: Fx, state: clif::Value, byte: clif::Value, raw: u8, escaped: Slice[u8], handled: clif::Value) -> clif::Value {
    let this = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(raw))
    mut fx.if_true(this, then: fn[mut lo](mut fx1: Fx) {
        put_literal(mut lo, fx: mut fx1, state, bytes: escaped)
    })
    return mut fx.b.bor(handled, y: this)
} put_escape

/// Writes the lowercase hexadecimal digit of a byte's bits from `shift` on.
fn put_hex_digit(mut fx: Fx, state: clif::Value, byte: clif::Value, shift: i64) {
    let shifted = mut fx.b.ushr_imm_s(byte, y: shift)
    let nibble = mut fx.b.band_imm_s(shifted, y: 0xF)
    let letter = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: nibble, y: 10)
    let digit = mut fx.b.iadd_imm_s(nibble, y: i64.widen(b'0'))
    let lower = mut fx.b.iadd_imm_s(nibble, y: i64.widen(b'a') - 10)
    let hex = mut fx.b.select(letter, x: lower, y: digit)
    put_byte(mut fx, state, byte: hex)
} put_hex_digit

/// Writes a literal text as a JSON string.
fn put_literal_string(mut lo: Lowering, mut fx: Fx, state: clif::Value, bytes: Slice[u8]) {
    var quoted = mem::Bytes.empty(lo.alloc)
    mut quoted.push(b'"')
    for byte in bytes {
        match byte {
            b'"' => mut quoted.append(b"\\\"")
            b'\\' => mut quoted.append(b"\\\\")
            b'\n' => mut quoted.append(b"\\n")
            b'\r' => mut quoted.append(b"\\r")
            b'\t' => mut quoted.append(b"\\t")
            8 => mut quoted.append(b"\\b")
            12 => mut quoted.append(b"\\f")
            else => {
                if byte < 0x20 {
                    mut quoted.append(b"\\u00")
                    mut quoted.push(hex_letter(byte >> 4))
                    mut quoted.push(hex_letter(byte & 0xF))
                } else {
                    mut quoted.push(byte)
                }
            }
        }
    }
    mut quoted.push(b'"')
    put_literal(mut lo, mut fx, state, bytes: quoted.view())
} put_literal_string

/// The lowercase hexadecimal digit of a nibble.
fn hex_letter(nibble: u8) -> u8
    requires nibble < 16
{
    if nibble < 10 {
        return b'0' + nibble
    }
    return b'a' + nibble - 10
} hex_letter

/// Writes bytes as a JSON string of their base64 with padding.
fn put_base64(mut lo: Lowering, mut fx: Fx, state: clif::Value, start: clif::Value, len: clif::Value) {
    put_literal(mut lo, mut fx, state, bytes: b"\"")
    let alphabet_view = mut lo.view_literal(mut fx, contents: BASE64)
    let alphabet = mut fx.load(PTR, addr: alphabet_view.address_value(), offset: 0)
    let three = mut fx.ptr(3)
    let padded = mut fx.b.iadd_imm_s(len, y: 2)
    let groups = mut fx.b.udiv(padded, y: three)
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: groups, body: fn[mut lo](mut fx1: Fx, group: clif::Value) {
        let group_start = mut fx1.b.imul_imm_s(group, y: 3)
        var bits = mut fx1.ptr(0)
        for index in 0..<3i64 {
            let byte = base64_input(mut fx1, start, len, group_start, index)
            let shifted = mut fx1.b.ishl_imm_s(byte, y: 16 - 8 * index)
            bits = mut fx1.b.bor(bits, y: shifted)
        }
        let present = mut fx1.b.isub(len, y: group_start)
        for index in 0..<4i64 {
            let written = mut fx1.b.icmp_imm_s(clif::IntCC.SignedLessThanOrEqual, x: present, y: index - 1)
            let nothing = mem::List[clif::Type].empty(fx1.alloc)
            discard mut fx1.choose_in(mut lo, condition: written, results: nothing.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
                put_literal(mut lo2, fx: mut fx2, state, bytes: b"=")
                return mem::List[clif::Value].empty(fx2.alloc)
            }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
                expect index >= 0 and index < 4
                let sextet_bits = mut fx2.b.ushr_imm_s(bits, y: 18 - 6 * index)
                let sextet = mut fx2.b.band_imm_s(sextet_bits, y: 0x3F)
                let at = mut fx2.b.iadd(alphabet, y: sextet)
                let letter = mut fx2.load(clif::Type.Int8, addr: at, offset: 0)
                put_byte(mut fx2, state, byte: letter)
                return mem::List[clif::Value].empty(fx2.alloc)
            })
        }
    })
    put_literal(mut lo, mut fx, state, bytes: b"\"")
} put_base64

/// The byte at `index` of a base64 group from `group_start`, zero past the input's `len`.
fn base64_input(mut fx: Fx, start: clif::Value, len: clif::Value, group_start: clif::Value, index: i64) -> clif::Value {
    let at = mut fx.b.iadd_imm_s(group_start, y: index)
    let inside = mut fx.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: len)
    let address = mut fx.b.iadd(start, y: at)
    let results = fx.types1(clif::Type.Int64)
    let chosen = mut fx.choose(inside, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let loaded = mut fx1.load(clif::Type.Int8, addr: address, offset: 0)
        let byte = mut fx1.b.uextend(clif::Type.Int64, x: loaded)
        return fx1.list1(byte)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.ptr(0)
        return fx1.list1(zero)
    })
    expect chosen.len() == 1
    return chosen[0]
} base64_input

/// Passes over whitespace.
fn space(mut fx: Fx, state: clif::Value) {
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let initial = mem::List[clif::Value].empty(fx.alloc)
    discard mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        let pos = mut fx1.load(PTR, addr: state, offset: READER_POS)
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: pos, y: end)
        let results = fx1.types1(clif::Type.Int8)
        let blanks = mut fx1.choose(inside, results: results.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let byte = mut fx2.load(clif::Type.Int8, addr: pos, offset: 0)
            var blank = mut fx2.int(clif::Type.Int8, value: 0)
            for character in b" \t\n\r" {
                let this = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(character))
                blank = mut fx2.b.bor(blank, y: this)
            }
            return fx2.list1(blank)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(no)
        })
        expect blanks.len() == 1
        let blank = blanks[0]
        mut fx1.if_true(blank, then: fn(mut fx2: Fx) {
            let next = mut fx2.b.iadd_imm_s(pos, y: 1)
            mut fx2.store(next, addr: state, offset: READER_POS)
        })
        return Pass(again: blank, next: mem::List[clif::Value].empty(fx1.alloc))
    })
} space

/// The next byte after whitespace, not passed over: `Truncated` at the end of the input.
fn peek(mut fx: Fx, state: clif::Value) -> Reading {
    space(mut fx, state)
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let inside = mut fx.b.icmp(clif::IntCC.UnsignedLessThan, x: pos, y: end)
    let results = fx.types2(clif::Type.Int64, b: clif::Type.Int32)
    let parts = mut fx.choose(inside, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let loaded = mut fx1.load(clif::Type.Int8, addr: pos, offset: 0)
        let byte = mut fx1.b.uextend(clif::Type.Int64, x: loaded)
        let none = json_code(mut fx1, code: 0)
        return fx1.list2(byte, b: none)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.ptr(0)
        let truncated = json_code(mut fx1, code: FAILURE_TRUNCATED)
        return fx1.list2(zero, b: truncated)
    })
    expect parts.len() == 2
    return Reading(value: parts[0], failed: parts[1])
} peek

/// Passes over a byte after whitespace: `Malformed` for another byte.
fn expect_code(mut lo: Lowering, mut fx: Fx, state: clif::Value, expected: u8) -> clif::Value {
    let peeked = peek(mut fx, state)
    let byte = peeked.value
    let failed = peeked.failed
    let ok = succeeded(mut fx, failed)
    let results = fx.types1(clif::Type.Int32)
    let chosen = mut fx.choose(ok, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let same = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(expected))
        mut fx1.if_true(same, then: fn(mut fx2: Fx) {
            let pos = mut fx2.load(PTR, addr: state, offset: READER_POS)
            let next = mut fx2.b.iadd_imm_s(pos, y: 1)
            mut fx2.store(next, addr: state, offset: READER_POS)
        })
        let malformed = json_code(mut fx1, code: FAILURE_MALFORMED)
        let none = json_code(mut fx1, code: 0)
        let code = mut fx1.b.select(same, x: none, y: malformed)
        return fx1.list1(code)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(failed)
    })
    expect chosen.len() == 1
    return chosen[0]
} expect_code

/// Whether a literal word follows after whitespace, passing over it when it does.
fn json_literal(mut lo: Lowering, mut fx: Fx, state: clif::Value, word: Slice[u8]) -> clif::Value {
    space(mut fx, state)
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let left = mut fx.b.isub(end, y: pos)
    let width = u64.widen(word.len())
    let room = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: left, y: i64.fit(width))
    let results = fx.types1(clif::Type.Int8)
    let chosen = mut fx.choose(room, results: results.view(), then: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let viewed = mut lo.view_literal(mut fx1, contents: word)
        let expected = mut fx1.load(PTR, addr: viewed.address_value(), offset: 0)
        let len = mut fx1.ptr(width)
        let compare_args = fx1.list3(pos, b: expected, c: len)
        let orders = mut lo.call_routine(mut fx1, routine: Routine.Compare, args: compare_args.view())
        expect orders.len() == 1
        let same = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: orders[0], y: 0)
        return fx1.list1(same)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(no)
    })
    expect chosen.len() == 1
    let found = chosen[0]
    mut fx.if_true(found, then: fn(mut fx1: Fx) {
        let next = mut fx1.b.iadd_imm_s(pos, y: i64.fit(width))
        mut fx1.store(next, addr: state, offset: READER_POS)
    })
    return found
} json_literal

/// A bool: `true` or `false`, `Malformed` for anything else.
fn json_read_bool(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> Reading {
    let truth = json_literal(mut lo, mut fx, state, word: b"true")
    let results = fx.types1(clif::Type.Int8)
    let falsities = mut fx.choose(truth, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(no)
    }, otherwise: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let falsity = json_literal(mut lo, fx: mut fx1, state, word: b"false")
        return fx1.list1(falsity)
    })
    expect falsities.len() == 1
    let either = mut fx.b.bor(truth, y: falsities[0])
    let malformed = json_code(mut fx, code: FAILURE_MALFORMED)
    let none = json_code(mut fx, code: 0)
    let code = mut fx.b.select(either, x: none, y: malformed)
    return Reading(value: truth, failed: code)
} json_read_bool

/// A number checked against the RFC 8259 grammar: its first byte's address, its end, and
/// whether it has a fraction or an exponent.
fn json_number(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> NumberReading {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.JsonNumber, take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        number_glue(mut fx1)
    })
    let found = mut fx.slot(24, align: 8)
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list2(state, b: found)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() == 1
    let failed = results[0]
    let start = mut fx.load(PTR, addr: found, offset: 0)
    let end = mut fx.load(PTR, addr: found, offset: 8)
    let fractional = mut fx.load(clif::Type.Int8, addr: found, offset: 16)
    return NumberReading(start: start, end: end, fractional: fractional, failed: failed)
} json_number

/// The body of the function reading a JSON number's text: receives the reader and the record
/// its first byte's address, end and whether it has a fraction or an exponent go to, and gives
/// the code of its failure.
fn number_glue(mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() == 2
    let state = params[0]
    let found = params[1]
    space(mut fx, state)
    let start = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let lead_sign = number_byte_at(mut fx, end, at: start)
    let minus = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead_sign, y: i64.widen(b'-'))
    let after_sign = mut fx.b.iadd_imm_s(start, y: 1)
    let integral = mut fx.b.select(minus, x: after_sign, y: start)
    let lead = number_byte_at(mut fx, end, at: integral)
    let zero_lead = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'0'))
    let lead_digit = number_is_digit(mut fx, byte: lead)
    let not_digit = mut fx.b.bxor_imm_s(lead_digit, y: 1)
    mut fx.if_true(not_digit, then: fn(mut fx1: Fx) {
        number_malformed(mut fx1)
    })
    let after_lead = mut fx.b.iadd_imm_s(integral, y: 1)
    let integral_end = number_digits(mut fx, end, from: after_lead)
    let at = mut fx.b.select(zero_lead, x: after_lead, y: integral_end)
    let point_byte = number_byte_at(mut fx, end, at)
    let point = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: point_byte, y: i64.widen(b'.'))
    let after_fraction = number_fraction(mut fx, end, point, at)
    let exponent_byte = number_byte_at(mut fx, end, at: after_fraction)
    let lower_e = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: exponent_byte, y: i64.widen(b'e'))
    let upper_e = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: exponent_byte, y: i64.widen(b'E'))
    let exponent = mut fx.b.bor(lower_e, y: upper_e)
    let after_exponent = number_exponent(mut fx, end, exponent, at: after_fraction)
    mut fx.store(after_exponent, addr: state, offset: READER_POS)
    let fractional = mut fx.b.bor(point, y: exponent)
    mut fx.store(start, addr: found, offset: 0)
    mut fx.store(after_exponent, addr: found, offset: 8)
    mut fx.store(fractional, addr: found, offset: 16)
    let none = json_code(mut fx, code: 0)
    let returned = fx.list1(none)
    mut fx.b.ret(returned.view())
} number_glue

/// The end of a number's fraction when `point` holds, `at` its point; `at` otherwise.
fn number_fraction(mut fx: Fx, end: clif::Value, point: clif::Value, at: clif::Value) -> clif::Value {
    let results = fx.types1(clif::Type.Int64)
    let chosen = mut fx.choose(point, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let from = mut fx1.b.iadd_imm_s(at, y: 1)
        let to = number_digits(mut fx1, end, from)
        let none = mut fx1.b.icmp(clif::IntCC.Equal, x: to, y: from)
        mut fx1.if_true(none, then: fn(mut fx2: Fx) {
            number_malformed(mut fx2)
        })
        return fx1.list1(to)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(at)
    })
    expect chosen.len() == 1
    return chosen[0]
} number_fraction

/// The end of a number's exponent when `exponent` holds, `at` its `e`; `at` otherwise.
fn number_exponent(mut fx: Fx, end: clif::Value, exponent: clif::Value, at: clif::Value) -> clif::Value {
    let results = fx.types1(clif::Type.Int64)
    let chosen = mut fx.choose(exponent, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let after_e = mut fx1.b.iadd_imm_s(at, y: 1)
        let sign = number_byte_at(mut fx1, end, at: after_e)
        let plus = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: sign, y: i64.widen(b'+'))
        let negative = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: sign, y: i64.widen(b'-'))
        let signed = mut fx1.b.bor(plus, y: negative)
        let after = mut fx1.b.iadd_imm_s(after_e, y: 1)
        let from = mut fx1.b.select(signed, x: after, y: after_e)
        let to = number_digits(mut fx1, end, from)
        let none = mut fx1.b.icmp(clif::IntCC.Equal, x: to, y: from)
        mut fx1.if_true(none, then: fn(mut fx2: Fx) {
            number_malformed(mut fx2)
        })
        return fx1.list1(to)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(at)
    })
    expect chosen.len() == 1
    return chosen[0]
} number_exponent

/// The byte at `at`, -1 at the input's `end` or past it.
fn number_byte_at(mut fx: Fx, end: clif::Value, at: clif::Value) -> clif::Value {
    let inside = mut fx.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: end)
    let results = fx.types1(clif::Type.Int64)
    let chosen = mut fx.choose(inside, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let loaded = mut fx1.load(clif::Type.Int8, addr: at, offset: 0)
        let byte = mut fx1.b.uextend(clif::Type.Int64, x: loaded)
        return fx1.list1(byte)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let none = mut fx1.int(clif::Type.Int64, value: -1)
        return fx1.list1(none)
    })
    expect chosen.len() == 1
    return chosen[0]
} number_byte_at

/// Whether a byte is a decimal digit.
fn number_is_digit(mut fx: Fx, byte: clif::Value) -> clif::Value {
    let low = mut fx.b.icmp_imm_s(clif::IntCC.SignedGreaterThanOrEqual, x: byte, y: i64.widen(b'0'))
    let high = mut fx.b.icmp_imm_s(clif::IntCC.SignedLessThanOrEqual, x: byte, y: i64.widen(b'9'))
    return mut fx.b.band(low, y: high)
} number_is_digit

/// The address past the digits from `from`.
fn number_digits(mut fx: Fx, end: clif::Value, from: clif::Value) -> clif::Value {
    let initial = fx.list1(from)
    let ended = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 1
        let at = current[0]
        let byte = number_byte_at(mut fx1, end, at)
        let digit = number_is_digit(mut fx1, byte)
        let next = mut fx1.b.iadd_imm_s(at, y: 1)
        let advanced = mut fx1.b.select(digit, x: next, y: at)
        return Pass(again: digit, next: fx1.list1(advanced))
    })
    expect ended.len() == 1
    return ended[0]
} number_digits

/// Returns `Malformed` from the function reading a number's text.
fn number_malformed(mut fx: Fx) {
    let code = json_code(mut fx, code: FAILURE_MALFORMED)
    let returned = fx.list1(code)
    mut fx.b.ret(returned.view())
} number_malformed

/// An integer without fraction or exponent, `-0` being 0, in 64 bits: `OutOfRange` outside
/// `u64`, or `i64` when signed.
fn json_read_integer(mut lo: Lowering, mut fx: Fx, state: clif::Value, signed: bool) -> Reading {
    let read = json_number(mut lo, mut fx, state)
    let ok = succeeded(mut fx, failed: read.failed)
    let results = fx.types2(clif::Type.Int64, b: clif::Type.Int32)
    let parts = mut fx.choose(ok, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return integer_value(mut fx1, read, signed)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.ptr(0)
        return fx1.list2(zero, b: read.failed)
    })
    expect parts.len() == 2
    return Reading(value: parts[0], failed: parts[1])
} json_read_integer

/// The value of a number's text read without failure, and the code of its failure.
fn integer_value(mut fx: Fx, read: NumberReading, signed: bool) -> mem::List[clif::Value] {
    let lead = mut fx.load(clif::Type.Int8, addr: read.start, offset: 0)
    let negative = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'-'))
    let after = mut fx.b.iadd_imm_s(read.start, y: 1)
    let from = mut fx.b.select(negative, x: after, y: read.start)
    let zero = mut fx.ptr(0)
    let no = mut fx.int(clif::Type.Int8, value: 0)
    let initial = fx.list3(from, b: zero, c: no)
    let accumulated = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 3
        let at = current[0]
        let value = current[1]
        let overflowed = current[2]
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: read.end)
        let results = fx1.types3(clif::Type.Int64, b: clif::Type.Int64, c: clif::Type.Int8)
        let next = mut fx1.choose(inside, results: results.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return integer_digit(mut fx2, at, value, overflowed)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list3(at, b: value, c: overflowed)
        })
        return Pass(again: inside, next: take next)
    })
    expect accumulated.len() == 3
    let magnitude = accumulated[1]
    let overflowed = accumulated[2]
    var out_of_range = overflowed
    if signed {
        let most_negative = mut fx.int(clif::Type.Int64, value: i64.from_bits(0x8000_0000_0000_0000))
        let most_positive = mut fx.int(clif::Type.Int64, value: 0x7FFF_FFFF_FFFF_FFFF)
        let limit = mut fx.b.select(negative, x: most_negative, y: most_positive)
        let beyond = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: magnitude, y: limit)
        out_of_range = mut fx.b.bor(overflowed, y: beyond)
    } else {
        let nonzero = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: magnitude, y: 0)
        let below = mut fx.b.band(negative, y: nonzero)
        out_of_range = mut fx.b.bor(overflowed, y: below)
    }
    let negated = mut fx.b.ineg(magnitude)
    var value = magnitude
    if signed {
        value = mut fx.b.select(negative, x: negated, y: magnitude)
    }
    let malformed = json_code(mut fx, code: FAILURE_MALFORMED)
    let range = json_code(mut fx, code: FAILURE_OUT_OF_RANGE)
    let none = json_code(mut fx, code: 0)
    let checked = mut fx.b.select(out_of_range, x: range, y: none)
    let code = mut fx.b.select(read.fractional, x: malformed, y: checked)
    return fx.list2(value, b: code)
} integer_value

/// One more digit of a number's text at `at` accumulated into `value`: the next address, the
/// value and whether it overflowed.
fn integer_digit(mut fx: Fx, at: clif::Value, value: clif::Value, overflowed: clif::Value) -> mem::List[clif::Value] {
    let byte = mut fx.load(clif::Type.Int8, addr: at, offset: 0)
    let widened = mut fx.b.uextend(clif::Type.Int64, x: byte)
    let digit = mut fx.b.iadd_imm_s(widened, y: -i64.widen(b'0'))
    let ten = mut fx.ptr(10)
    let scaled = mut fx.b.umul_overflow(value, y: ten)
    let sum = mut fx.b.uadd_overflow(scaled.value, y: digit)
    let over = mut fx.b.bor(scaled.flag, y: sum.flag)
    let now_overflowed = mut fx.b.bor(overflowed, y: over)
    let next = mut fx.b.iadd_imm_s(at, y: 1)
    return fx.list3(next, b: sum.value, c: now_overflowed)
} integer_digit

/// A float: any number rounded to f64, or one of the strings `NaN`, `inf` and `-inf`.
fn json_read_float(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> Reading {
    let peeked = peek(mut fx, state)
    let ok = succeeded(mut fx, failed: peeked.failed)
    let quoted = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: peeked.value, y: i64.widen(b'"'))
    let results = fx.types2(clif::Type.Float64, b: clif::Type.Int32)
    let parts = mut fx.choose_in(mut lo, condition: ok, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let read_types = fx1.types2(clif::Type.Float64, b: clif::Type.Int32)
        return mut fx1.choose_in(mut lo1, condition: quoted, results: read_types.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return float_word(mut lo2, fx: mut fx2, state)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return float_number(mut lo2, fx: mut fx2, state)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.b.f64const(0)
        return fx1.list2(zero, b: peeked.failed)
    })
    expect parts.len() == 2
    return Reading(value: parts[0], failed: parts[1])
} json_read_float

/// A float written as one of the strings `NaN`, `inf` and `-inf`, and the code of the failure.
fn float_word(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> mem::List[clif::Value] {
    let buffer = mut fx.slot(8, align: 1)
    let capacity = mut fx.ptr(8)
    let read = json_string(mut lo, mut fx, state, buffer, capacity)
    let unknown = mut fx.b.f64const(0)
    let none_known = mut fx.int(clif::Type.Int8, value: 0)
    let not_a_number = float_word_match(mut lo, mut fx, buffer, len: read.value, word: b"NaN", bits: 0x7FF8_0000_0000_0000, value: unknown, known: none_known)
    let infinite = float_word_match(mut lo, mut fx, buffer, len: read.value, word: b"inf", bits: 0x7FF0_0000_0000_0000, value: not_a_number.value, known: not_a_number.known)
    let matched = float_word_match(mut lo, mut fx, buffer, len: read.value, word: b"-inf", bits: 0xFFF0_0000_0000_0000, value: infinite.value, known: infinite.known)
    let ok = succeeded(mut fx, failed: read.failed)
    let malformed = json_code(mut fx, code: FAILURE_MALFORMED)
    let none = json_code(mut fx, code: 0)
    let checked = mut fx.b.select(matched.known, x: none, y: malformed)
    let code = mut fx.b.select(ok, x: checked, y: read.failed)
    return fx.list2(matched.value, b: code)
} float_word

/// A float word matched so far: its value and whether one matched.
struct FloatWord derives Copy {
    value: clif::Value
    known: clif::Value
} FloatWord

/// The float word in `buffer` matched against `word`, whose value has the bits given.
fn float_word_match(mut lo: Lowering, mut fx: Fx, buffer: clif::Value, len: clif::Value, word: Slice[u8], bits: u64, value: clif::Value, known: clif::Value) -> FloatWord {
    let same = bytes_equal(mut lo, mut fx, start: buffer, len, literal: word)
    let constant = mut fx.b.f64const(bits)
    let chosen = mut fx.b.select(same, x: constant, y: value)
    let now_known = mut fx.b.bor(known, y: same)
    return FloatWord(value: chosen, known: now_known)
} float_word_match

/// A float written as a number, rounded to f64, and the code of the failure.
fn float_number(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> mem::List[clif::Value] {
    let read = json_number(mut lo, mut fx, state)
    let ok = succeeded(mut fx, failed: read.failed)
    let results = fx.types2(clif::Type.Float64, b: clif::Type.Int32)
    return mut fx.choose_in(mut lo, condition: ok, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let len = mut fx1.b.isub(read.end, y: read.start)
        let size = mut fx1.b.iadd_imm_s(len, y: 1)
        let text = mut lo1.record_alloc(mut fx1, size)
        let missing = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: text, y: 0)
        let parsed_types = fx1.types2(clif::Type.Float64, b: clif::Type.Int32)
        return mut fx1.choose_in(mut lo1, condition: missing, results: parsed_types.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let zero = mut fx2.b.f64const(0)
            let out_of_memory = json_code(mut fx2, code: FAILURE_OUT_OF_MEMORY)
            return fx2.list2(zero, b: out_of_memory)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let copy_args = fx2.list3(text, b: read.start, c: len)
            discard mut lo2.call_routine(mut fx2, routine: Routine.Copy, args: copy_args.view())
            let none = mut fx2.ptr(0)
            let strtod_args = fx2.list2(text, b: none)
            let returned = fx2.types1(clif::Type.Float64)
            let values = mut lo2.call_libc(mut fx2, name: "strtod", args: strtod_args.view(), returns: returned.view())
            mut lo2.record_free(mut fx2, address: text)
            let ok_code = json_code(mut fx2, code: 0)
            expect values.len() == 1
            return fx2.list2(values[0], b: ok_code)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.b.f64const(0)
        return fx1.list2(zero, b: read.failed)
    })
} float_number

/// A char: a JSON string of exactly one char, its scalar value in 64 bits.
fn read_char(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> Reading {
    let buffer = mut fx.slot(8, align: 1)
    let capacity = mut fx.ptr(8)
    let read = json_string(mut lo, mut fx, state, buffer, capacity)
    return one_char(mut fx, buffer, len: read.value, failed: read.failed)
} read_char

/// The scalar value of text read into `buffer` with the code `failed`, which must be exactly
/// one char: the code, `Malformed` when it is not.
fn one_char(mut fx: Fx, buffer: clif::Value, len: clif::Value, failed: clif::Value) -> Reading {
    let loaded = mut fx.load(clif::Type.Int8, addr: buffer, offset: 0)
    let lead = mut fx.b.uextend(clif::Type.Int64, x: loaded)
    let two = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: lead, y: 0xC0)
    let three = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: lead, y: 0xE0)
    let four = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: lead, y: 0xF0)
    let flags = fx.list3(two, b: three, c: four)
    var width = mut fx.ptr(1)
    for flag in flags {
        let step = mut fx.b.uextend(clif::Type.Int64, x: flag)
        width = mut fx.b.iadd(width, y: step)
    }
    let single = mut fx.b.icmp(clif::IntCC.Equal, x: len, y: width)
    var scalar = mut fx.b.band_imm_s(lead, y: 0x7F)
    for index in 0..<flags.len() {
        var mask: i64 = 0x07
        if index == 0 {
            mask = 0x1F
        } else if index == 1 {
            mask = 0x0F
        }
        let masked = mut fx.b.band_imm_s(lead, y: mask)
        scalar = mut fx.b.select(flags[index], x: masked, y: scalar)
    }
    for index in 1..<4u64 {
        let inside = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThan, x: width, y: i64.fit(index))
        let at = mut fx.offset(buffer, offset: index)
        let byte = mut fx.load(clif::Type.Int8, addr: at, offset: 0)
        let widened = mut fx.b.uextend(clif::Type.Int64, x: byte)
        let bits = mut fx.b.band_imm_s(widened, y: 0x3F)
        let shifted = mut fx.b.ishl_imm_s(scalar, y: 6)
        let joined = mut fx.b.bor(shifted, y: bits)
        scalar = mut fx.b.select(inside, x: joined, y: scalar)
    }
    let ok = succeeded(mut fx, failed)
    let malformed = json_code(mut fx, code: FAILURE_MALFORMED)
    let none = json_code(mut fx, code: 0)
    let checked = mut fx.b.select(single, x: none, y: malformed)
    let code = mut fx.b.select(ok, x: checked, y: failed)
    return Reading(value: scalar, failed: code)
} one_char

/// A JSON string, its escapes resolved: at most `capacity` of its bytes written to `buffer`
/// unless it is zero, and its whole length.
fn json_string(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value) -> Reading {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int64))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.JsonString, take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        string_glue(mut lo1, fx: mut fx1)
    })
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list3(state, b: buffer, c: capacity)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() == 2
    return Reading(value: results[0], failed: results[1])
} json_string

/// The body of the function reading a JSON string: receives the reader, the buffer and its
/// capacity, and gives the string's whole length and the code of its failure.
fn string_glue(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() == 3
    let state = params[0]
    let buffer = params[1]
    let capacity = params[2]
    let opened = expect_code(mut lo, mut fx, state, expected: b'"')
    let zero = mut fx.ptr(0)
    let failed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: opened, y: 0)
    mut fx.if_true(failed, then: fn(mut fx1: Fx) {
        let returned = fx1.list2(zero, b: opened)
        mut fx1.b.ret(returned.view())
    })
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let initial = fx.list1(zero)
    discard mut fx.repeat(initial.view(), body: fn[mut lo](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 1
        return string_pass(mut lo, fx: mut fx1, state, buffer, capacity, end, len: current[0])
    })
    let none = mut fx.ptr(0)
    let truncated = json_code(mut fx, code: FAILURE_TRUNCATED)
    let returned = fx.list2(none, b: truncated)
    mut fx.b.ret(returned.view())
} string_glue

/// Returns the length read so far and the code of a failure from the function reading a JSON
/// string.
fn string_give_up(mut fx: Fx, len: clif::Value, code: i64) {
    let failure_code = json_code(mut fx, code)
    let returned = fx.list2(len, b: failure_code)
    mut fx.b.ret(returned.view())
} string_give_up

/// Writes `count` bytes from `from` to the string's buffer as far as its capacity allows: the
/// length read so far, `len`, plus `count`.
fn string_emit(mut lo: Lowering, mut fx: Fx, buffer: clif::Value, capacity: clif::Value, len: clif::Value, from: clif::Value, count: clif::Value) -> clif::Value {
    let writing = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: buffer, y: 0)
    let room = mut fx.b.icmp(clif::IntCC.UnsignedLessThan, x: len, y: capacity)
    let copying = mut fx.b.band(writing, y: room)
    mut fx.if_true(copying, then: fn[mut lo](mut fx1: Fx) {
        let left = mut fx1.b.isub(capacity, y: len)
        let kept = mut fx1.b.umin(left, y: count)
        let at = mut fx1.b.iadd(buffer, y: len)
        let copy_args = fx1.list3(at, b: from, c: kept)
        discard mut lo.call_routine(mut fx1, routine: Routine.Copy, args: copy_args.view())
    })
    return mut fx.b.iadd(len, y: count)
} string_emit

/// A pass of the loop reading a JSON string: a segment of plain bytes, then an escape, the
/// function returning at the closing quote.
fn string_pass(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value, end: clif::Value, len: clif::Value) -> Pass {
    let segment = mut fx.load(PTR, addr: state, offset: READER_POS)
    let stop = string_segment_end(mut fx, end, segment)
    let truncated = mut fx.b.icmp(clif::IntCC.Equal, x: stop, y: end)
    mut fx.if_true(truncated, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len, code: FAILURE_TRUNCATED)
    })
    let count = mut fx.b.isub(stop, y: segment)
    let valid = utf8_valid(mut lo, mut fx, start: segment, len: count)
    let invalid = mut fx.b.bxor_imm_s(valid, y: 1)
    mut fx.if_true(invalid, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len, code: FAILURE_INVALID_TEXT)
    })
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: count, body: fn(mut fx1: Fx, index: clif::Value) {
        let at = mut fx1.b.iadd(segment, y: index)
        let byte = mut fx1.load(clif::Type.Int8, addr: at, offset: 0)
        let control = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: byte, y: 0x20)
        mut fx1.if_true(control, then: fn(mut fx2: Fx) {
            string_give_up(mut fx2, len, code: FAILURE_MALFORMED)
        })
    })
    let emitted = string_emit(mut lo, mut fx, buffer, capacity, len, from: segment, count)
    let byte = mut fx.load(clif::Type.Int8, addr: stop, offset: 0)
    let after = mut fx.b.iadd_imm_s(stop, y: 1)
    mut fx.store(after, addr: state, offset: READER_POS)
    let closed = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'"'))
    mut fx.if_true(closed, then: fn(mut fx1: Fx) {
        let none = json_code(mut fx1, code: 0)
        let returned = fx1.list2(emitted, b: none)
        mut fx1.b.ret(returned.view())
    })
    let at_end = mut fx.b.icmp(clif::IntCC.Equal, x: after, y: end)
    mut fx.if_true(at_end, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: emitted, code: FAILURE_TRUNCATED)
    })
    let escape_byte = mut fx.load(clif::Type.Int8, addr: after, offset: 0)
    let escape = mut fx.b.uextend(clif::Type.Int64, x: escape_byte)
    let past = mut fx.b.iadd_imm_s(after, y: 1)
    mut fx.store(past, addr: state, offset: READER_POS)
    let char_buffer = mut fx.slot(4, align: 1)
    let scalar = string_escape(mut fx, state, end, len: emitted, escape)
    let unknown = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: scalar, y: -1)
    mut fx.if_true(unknown, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: emitted, code: FAILURE_MALFORMED)
    })
    let narrow = mut fx.b.ireduce(clif::Type.Int32, x: scalar)
    let char_count = encode_utf8(mut fx, c: narrow, buffer: char_buffer)
    let extended = string_emit(mut lo, mut fx, buffer, capacity, len: emitted, from: char_buffer, count: char_count)
    let again = mut fx.int(clif::Type.Int8, value: 1)
    return Pass(again: again, next: fx.list1(extended))
} string_pass

/// The address of the first quote or backslash from `segment`, or the input's `end`.
fn string_segment_end(mut fx: Fx, end: clif::Value, segment: clif::Value) -> clif::Value {
    let initial = fx.list1(segment)
    let stopped = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 1
        let at = current[0]
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: end)
        let results = fx1.types1(clif::Type.Int8)
        let plains = mut fx1.choose(inside, results: results.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let byte = mut fx2.load(clif::Type.Int8, addr: at, offset: 0)
            let quote = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'"'))
            let escape = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'\\'))
            let special = mut fx2.b.bor(quote, y: escape)
            let plain = mut fx2.b.bxor_imm_s(special, y: 1)
            return fx2.list1(plain)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(no)
        })
        expect plains.len() == 1
        let plain = plains[0]
        let next = mut fx1.b.iadd_imm_s(at, y: 1)
        let advanced = mut fx1.b.select(plain, x: next, y: at)
        return Pass(again: plain, next: fx1.list1(advanced))
    })
    expect stopped.len() == 1
    return stopped[0]
} string_segment_end

/// The scalar value an escape stands for, -1 for none: the letters JSON names, or `\u` and
/// four hexadecimal digits, a leading surrogate's pair joined.
fn string_escape(mut fx: Fx, state: clif::Value, end: clif::Value, len: clif::Value, escape: clif::Value) -> clif::Value {
    var scalar = mut fx.int(clif::Type.Int64, value: -1)
    scalar = escape_letter(mut fx, escape, letter: b'"', meaning: b'"', scalar)
    scalar = escape_letter(mut fx, escape, letter: b'\\', meaning: b'\\', scalar)
    scalar = escape_letter(mut fx, escape, letter: b'/', meaning: b'/', scalar)
    scalar = escape_letter(mut fx, escape, letter: b'b', meaning: 8, scalar)
    scalar = escape_letter(mut fx, escape, letter: b'f', meaning: 12, scalar)
    scalar = escape_letter(mut fx, escape, letter: b'n', meaning: b'\n', scalar)
    scalar = escape_letter(mut fx, escape, letter: b'r', meaning: b'\r', scalar)
    scalar = escape_letter(mut fx, escape, letter: b't', meaning: b'\t', scalar)
    let unicode = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: escape, y: i64.widen(b'u'))
    let results = fx.types1(clif::Type.Int64)
    let named = scalar
    let chosen = mut fx.choose(unicode, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let high = hex4(mut fx1, state, len, give_up: string_give_up)
        let leading = json_in_range(mut fx1, value: high, low: 0xD800, high: 0xDBFF)
        let trailing = json_in_range(mut fx1, value: high, low: 0xDC00, high: 0xDFFF)
        mut fx1.if_true(trailing, then: fn(mut fx2: Fx) {
            string_give_up(mut fx2, len, code: FAILURE_INVALID_TEXT)
        })
        let pair_types = fx1.types1(clif::Type.Int64)
        let joined = mut fx1.choose(leading, results: pair_types.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let paired = string_surrogates(mut fx2, state, end, len, high)
            return fx2.list1(paired)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(high)
        })
        expect joined.len() == 1
        return fx1.list1(joined[0])
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(named)
    })
    expect chosen.len() == 1
    return chosen[0]
} string_escape

/// `scalar`, or `meaning` when the escape is `letter`.
fn escape_letter(mut fx: Fx, escape: clif::Value, letter: u8, meaning: u8, scalar: clif::Value) -> clif::Value {
    let this = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: escape, y: i64.widen(letter))
    let meant = mut fx.int(clif::Type.Int64, value: i64.widen(meaning))
    return mut fx.b.select(this, x: meant, y: scalar)
} escape_letter

/// The scalar value a leading surrogate `high` and the `\u` escape of its trailing one stand
/// for.
fn string_surrogates(mut fx: Fx, state: clif::Value, end: clif::Value, len: clif::Value, high: clif::Value) -> clif::Value {
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let left = mut fx.b.isub(end, y: pos)
    let short = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: left, y: 2)
    mut fx.if_true(short, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len, code: FAILURE_TRUNCATED)
    })
    let lead = mut fx.load(clif::Type.Int8, addr: pos, offset: 0)
    let second = mut fx.load(clif::Type.Int8, addr: pos, offset: 1)
    let slash = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'\\'))
    let u = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: second, y: i64.widen(b'u'))
    let paired = mut fx.b.band(slash, y: u)
    let unpaired = mut fx.b.bxor_imm_s(paired, y: 1)
    mut fx.if_true(unpaired, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len, code: FAILURE_INVALID_TEXT)
    })
    let next = mut fx.b.iadd_imm_s(pos, y: 2)
    mut fx.store(next, addr: state, offset: READER_POS)
    let low = hex4(mut fx, state, len, give_up: string_give_up)
    let low_ok = json_in_range(mut fx, value: low, low: 0xDC00, high: 0xDFFF)
    let bad = mut fx.b.bxor_imm_s(low_ok, y: 1)
    mut fx.if_true(bad, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len, code: FAILURE_INVALID_TEXT)
    })
    let high_offset = mut fx.b.iadd_imm_s(high, y: -0xD800)
    let high_bits = mut fx.b.ishl_imm_s(high_offset, y: 10)
    let low_bits = mut fx.b.iadd_imm_s(low, y: -0xDC00)
    let joined = mut fx.b.iadd(high_bits, y: low_bits)
    return mut fx.b.iadd_imm_s(joined, y: 0x1_0000)
} string_surrogates

fn json_in_range(mut fx: Fx, value: clif::Value, low: i64, high: i64) -> clif::Value {
    let above = mut fx.b.icmp_imm_s(clif::IntCC.SignedGreaterThanOrEqual, x: value, y: low)
    let below = mut fx.b.icmp_imm_s(clif::IntCC.SignedLessThanOrEqual, x: value, y: high)
    return mut fx.b.band(above, y: below)
} json_in_range

/// Four hexadecimal digits after `\u`, giving up with `Truncated` or `Malformed`.
fn hex4(mut fx: Fx, state: clif::Value, len: clif::Value, give_up: fn(mut fx: Fx, len: clif::Value, code: i64)) -> clif::Value {
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let left = mut fx.b.isub(end, y: pos)
    let short = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: left, y: 4)
    mut fx.if_true(short, then: fn(mut fx1: Fx) {
        give_up(mut fx1, len, code: FAILURE_TRUNCATED)
    })
    var value = mut fx.ptr(0)
    for index in 0..<4u64 {
        let at = mut fx.offset(pos, offset: index)
        let loaded = mut fx.load(clif::Type.Int8, addr: at, offset: 0)
        let byte = mut fx.b.uextend(clif::Type.Int64, x: loaded)
        let digit = json_in_range(mut fx, value: byte, low: i64.widen(b'0'), high: i64.widen(b'9'))
        let lower = json_in_range(mut fx, value: byte, low: i64.widen(b'a'), high: i64.widen(b'f'))
        let upper = json_in_range(mut fx, value: byte, low: i64.widen(b'A'), high: i64.widen(b'F'))
        let digit_or_lower = mut fx.b.bor(digit, y: lower)
        let hex = mut fx.b.bor(digit_or_lower, y: upper)
        let not_hex = mut fx.b.bxor_imm_s(hex, y: 1)
        mut fx.if_true(not_hex, then: fn(mut fx1: Fx) {
            give_up(mut fx1, len, code: FAILURE_MALFORMED)
        })
        let from_digit = mut fx.b.iadd_imm_s(byte, y: -i64.widen(b'0'))
        let from_lower = mut fx.b.iadd_imm_s(byte, y: 10 - i64.widen(b'a'))
        let from_upper = mut fx.b.iadd_imm_s(byte, y: 10 - i64.widen(b'A'))
        let lower_or_digit = mut fx.b.select(lower, x: from_lower, y: from_digit)
        let nibble = mut fx.b.select(upper, x: from_upper, y: lower_or_digit)
        let shifted = mut fx.b.ishl_imm_s(value, y: 4)
        value = mut fx.b.bor(shifted, y: nibble)
    }
    let next = mut fx.b.iadd_imm_s(pos, y: 4)
    mut fx.store(next, addr: state, offset: READER_POS)
    return value
} hex4

/// The length of the JSON string that follows, its escapes resolved, the reader staying put.
fn measure_string(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> Reading {
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let none = mut fx.ptr(0)
    let read = json_string(mut lo, mut fx, state, buffer: none, capacity: none)
    let ok = succeeded(mut fx, failed: read.failed)
    mut fx.if_true(ok, then: fn(mut fx1: Fx) {
        mut fx1.store(pos, addr: state, offset: READER_POS)
    })
    return read
} measure_string

/// Writes the JSON string that follows, measured before as `len` bytes, to `destination`.
fn write_string(mut lo: Lowering, mut fx: Fx, state: clif::Value, destination: clif::Value, len: clif::Value) {
    discard json_string(mut lo, mut fx, state, buffer: destination, capacity: len)
} write_string

/// A record member's key, at most `capacity` bytes of it written to `buffer`, then its colon.
fn json_read_key(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value) -> Reading {
    let read = json_string(mut lo, mut fx, state, buffer, capacity)
    let ok = succeeded(mut fx, failed: read.failed)
    let results = fx.types1(clif::Type.Int32)
    let chosen = mut fx.choose(ok, results: results.view(), then: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let colon = expect_code(mut lo, fx: mut fx1, state, expected: b':')
        return fx1.list1(colon)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(read.failed)
    })
    expect chosen.len() == 1
    return Reading(value: read.value, failed: chosen[0])
} json_read_key

/// A variant's key, at most `capacity` bytes of it written to `buffer`, and whether a payload
/// follows: a string alone, or an object whose one member is the key.
fn read_variant(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value) -> VariantReading {
    let peeked = peek(mut fx, state)
    let ok = succeeded(mut fx, failed: peeked.failed)
    let quoted = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: peeked.value, y: i64.widen(b'"'))
    let results = fx.types3(clif::Type.Int64, b: clif::Type.Int8, c: clif::Type.Int32)
    let parts = mut fx.choose_in(mut lo, condition: ok, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let read_types = fx1.types3(clif::Type.Int64, b: clif::Type.Int8, c: clif::Type.Int32)
        return mut fx1.choose_in(mut lo1, condition: quoted, results: read_types.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let read = json_string(mut lo2, fx: mut fx2, state, buffer, capacity)
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list3(read.value, b: no, c: read.failed)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return variant_object(mut lo2, fx: mut fx2, state, buffer, capacity)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.ptr(0)
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list3(zero, b: no, c: peeked.failed)
    })
    expect parts.len() == 3
    return VariantReading(len: parts[0], payload: parts[1], failed: parts[2])
} read_variant

/// A variant written as an object whose one member is its key: the key's length, that a payload
/// follows, and the code of the failure.
fn variant_object(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value) -> mem::List[clif::Value] {
    let opened = expect_code(mut lo, mut fx, state, expected: b'{')
    let ok = succeeded(mut fx, failed: opened)
    let results = fx.types3(clif::Type.Int64, b: clif::Type.Int8, c: clif::Type.Int32)
    return mut fx.choose_in(mut lo, condition: ok, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let read = json_read_key(mut lo1, fx: mut fx1, state, buffer, capacity)
        let yes = mut fx1.int(clif::Type.Int8, value: 1)
        return fx1.list3(read.value, b: yes, c: read.failed)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.ptr(0)
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list3(zero, b: no, c: opened)
    })
} variant_object

/// Whether the element at `index` of an array or object follows: none once the closing byte
/// comes, which is passed over; a comma before each element after the first.
fn json_element_follows(mut lo: Lowering, mut fx: Fx, state: clif::Value, index: clif::Value, close: u8) -> Reading {
    let peeked = peek(mut fx, state)
    let ok = succeeded(mut fx, failed: peeked.failed)
    let results = fx.types2(clif::Type.Int8, b: clif::Type.Int32)
    let parts = mut fx.choose_in(mut lo, condition: ok, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let closing = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: peeked.value, y: i64.widen(close))
        let read_types = fx1.types2(clif::Type.Int8, b: clif::Type.Int32)
        return mut fx1.choose_in(mut lo1, condition: closing, results: read_types.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let pos = mut fx2.load(PTR, addr: state, offset: READER_POS)
            let next = mut fx2.b.iadd_imm_s(pos, y: 1)
            mut fx2.store(next, addr: state, offset: READER_POS)
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            let none = json_code(mut fx2, code: 0)
            return fx2.list2(no, b: none)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return element_comma(mut lo2, fx: mut fx2, state, index)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list2(no, b: peeked.failed)
    })
    expect parts.len() == 2
    return Reading(value: parts[0], failed: parts[1])
} json_element_follows

/// An element that follows: its comma passed over when it is not the first, and the code of
/// the failure.
fn element_comma(mut lo: Lowering, mut fx: Fx, state: clif::Value, index: clif::Value) -> mem::List[clif::Value] {
    let later = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: index, y: 0)
    let results = fx.types1(clif::Type.Int32)
    let failed = mut fx.choose_in(mut lo, condition: later, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let comma = expect_code(mut lo1, fx: mut fx1, state, expected: b',')
        return fx1.list1(comma)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let none = json_code(mut fx1, code: 0)
        return fx1.list1(none)
    })
    let yes = mut fx.int(clif::Type.Int8, value: 1)
    expect failed.len() == 1
    return fx.list2(yes, b: failed[0])
} element_comma

/// Passes over any JSON value, nested no deeper than decoding reads.
fn skip_value(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> clif::Value {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.JsonSkip, take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        skip_glue(mut lo1, fx: mut fx1)
    })
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list1(state)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() == 1
    return results[0]
} skip_value

/// The body of the function passing over a JSON value: receives the reader and gives the code
/// of its failure.
fn skip_glue(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() == 1
    let state = params[0]
    let peeked = peek(mut fx, state)
    skip_stop(mut fx, failed: peeked.failed)
    let none = json_code(mut fx, code: 0)
    let quote = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: peeked.value, y: i64.widen(b'"'))
    mut fx.if_true(quote, then: fn[mut lo](mut fx1: Fx) {
        let zero = mut fx1.ptr(0)
        let read = json_string(mut lo, fx: mut fx1, state, buffer: zero, capacity: zero)
        let returned = fx1.list1(read.failed)
        mut fx1.b.ret(returned.view())
    })
    skip_nested(mut lo, mut fx, state, byte: peeked.value, opening: b'{', close: b'}', none)
    skip_nested(mut lo, mut fx, state, byte: peeked.value, opening: b'[', close: b']', none)
    skip_word(mut lo, mut fx, state, word: b"true", none)
    skip_word(mut lo, mut fx, state, word: b"false", none)
    skip_word(mut lo, mut fx, state, word: b"null", none)
    let number = json_number(mut lo, mut fx, state)
    let returned = fx.list1(number.failed)
    mut fx.b.ret(returned.view())
} skip_glue

/// Returns a nonzero failure code from the function passing over a JSON value.
fn skip_stop(mut fx: Fx, failed: clif::Value) {
    let bad = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: failed, y: 0)
    mut fx.if_true(bad, then: fn(mut fx1: Fx) {
        let returned = fx1.list1(failed)
        mut fx1.b.ret(returned.view())
    })
} skip_stop

/// Passes over an object or array when `byte` opens one, then returns `none`.
fn skip_nested(mut lo: Lowering, mut fx: Fx, state: clif::Value, byte: clif::Value, opening: u8, close: u8, none: clif::Value) {
    let this = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(opening))
    mut fx.if_true(this, then: fn[mut lo](mut fx1: Fx) {
        nest(mut fx1, reader_state: state)
        let pos = mut fx1.load(PTR, addr: state, offset: READER_POS)
        let next = mut fx1.b.iadd_imm_s(pos, y: 1)
        mut fx1.store(next, addr: state, offset: READER_POS)
        let zero = mut fx1.ptr(0)
        let initial = fx1.list1(zero)
        discard mut fx1.repeat(initial.view(), body: fn[mut lo](mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() == 1
            return skip_member(mut lo, fx: mut fx2, state, index: current[0], opening, close)
        })
        unnest(mut fx1, reader_state: state)
        let returned = fx1.list1(none)
        mut fx1.b.ret(returned.view())
    })
} skip_nested

/// A pass of the loop passing over an object's members or an array's elements.
fn skip_member(mut lo: Lowering, mut fx: Fx, state: clif::Value, index: clif::Value, opening: u8, close: u8) -> Pass {
    let read = json_element_follows(mut lo, mut fx, state, index, close)
    skip_stop(mut fx, failed: read.failed)
    mut fx.if_true(read.value, then: fn[mut lo](mut fx1: Fx) {
        if opening == b'{' {
            let zero = mut fx1.ptr(0)
            let key = json_read_key(mut lo, fx: mut fx1, state, buffer: zero, capacity: zero)
            skip_stop(mut fx1, failed: key.failed)
        }
        let failed = skip_value(mut lo, fx: mut fx1, state)
        skip_stop(mut fx1, failed)
    })
    let next = mut fx.b.iadd_imm_s(index, y: 1)
    return Pass(again: read.value, next: fx.list1(next))
} skip_member

/// Returns `none` when a literal word follows.
fn skip_word(mut lo: Lowering, mut fx: Fx, state: clif::Value, word: Slice[u8], none: clif::Value) {
    let found = json_literal(mut lo, mut fx, state, word)
    mut fx.if_true(found, then: fn(mut fx1: Fx) {
        let returned = fx1.list1(none)
        mut fx1.b.ret(returned.view())
    })
} skip_word

/// Bytes: a JSON string of their base64 exactly as encoding writes it, `Malformed` for any
/// other, read into bytes drawn through the allocator at `target`, which holds empty bytes.
fn read_base64(mut lo: Lowering, mut fx: Fx, state: clif::Value, target: clif::Value) -> clif::Value {
    let measured = measure_string(mut lo, mut fx, state)
    let ok = succeeded(mut fx, failed: measured.failed)
    let results = fx.types1(clif::Type.Int32)
    let chosen = mut fx.choose_in(mut lo, condition: ok, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let one = mut fx1.ptr(1)
        let size = mut fx1.b.umax(measured.value, y: one)
        let text = mut lo1.record_alloc(mut fx1, size)
        let missing = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: text, y: 0)
        let decoded_types = fx1.types1(clif::Type.Int32)
        return mut fx1.choose_in(mut lo1, condition: missing, results: decoded_types.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let out_of_memory = json_code(mut fx2, code: FAILURE_OUT_OF_MEMORY)
            return fx2.list1(out_of_memory)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let failed = base64_decoded(mut lo2, fx: mut fx2, state, text, len: measured.value, target)
            return fx2.list1(failed)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(measured.failed)
    })
    expect chosen.len() == 1
    return chosen[0]
} read_base64

/// The string's text written to the runtime record `text` and decoded from base64 into the
/// bytes at `target`: the code of the failure.
fn base64_decoded(mut lo: Lowering, mut fx: Fx, state: clif::Value, text: clif::Value, len: clif::Value, target: clif::Value) -> clif::Value {
    write_string(mut lo, mut fx, state, destination: text, len)
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.Base64, take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        let params = mut fx1.entry()
        expect params.len() == 3
        let failed = decode_base64(mut lo1, fx: mut fx1, text: params[0], len: params[1], target: params[2])
        let returned = fx1.list1(failed)
        mut fx1.b.ret(returned.view())
    })
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list3(text, b: len, c: target)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    mut lo.record_free(mut fx, address: text)
    expect results.len() == 1
    return results[0]
} base64_decoded

/// The body of a function decoding base64 text with padding into the bytes at `target`:
/// `Malformed`, leaving them empty, unless the text is exactly what encoding writes: whole
/// groups, padding only ending the last, no bits set past the bytes it holds.
fn decode_base64(mut lo: Lowering, mut fx: Fx, text: clif::Value, len: clif::Value, target: clif::Value) -> clif::Value {
    let ragged_bits = mut fx.b.band_imm_s(len, y: 3)
    let ragged = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: ragged_bits, y: 0)
    mut fx.if_true(ragged, then: fn(mut fx1: Fx) {
        base64_malformed(mut fx1)
    })
    let groups = mut fx.b.ushr_imm_s(len, y: 2)
    let nonempty = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: len, y: 0)
    let results = fx.types1(clif::Type.Int64)
    let paddings = mut fx.choose(nonempty, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let counted = base64_padding(mut fx1, text, len)
        return fx1.list1(counted)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let none = mut fx1.ptr(0)
        return fx1.list1(none)
    })
    expect paddings.len() == 1
    let last_padding = paddings[0]
    let whole = mut fx.b.imul_imm_s(groups, y: 3)
    let size = mut fx.b.isub(whole, y: last_padding)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: size, y: 0)
    mut fx.if_true(present, then: fn[mut lo](mut fx1: Fx) {
        let drawn = vector_resize(mut lo, fx: mut fx1, address: target, capacity: size, element: CODECS_BYTE)
        let failed = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: drawn, y: 0)
        mut fx1.if_true(failed, then: fn(mut fx2: Fx) {
            let out_of_memory = json_code(mut fx2, code: FAILURE_OUT_OF_MEMORY)
            let returned = fx2.list1(out_of_memory)
            mut fx2.b.ret(returned.view())
        })
    })
    let data = mut fx.load(PTR, addr: target, offset: VECTOR_DATA)
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: groups, body: fn[mut lo](mut fx1: Fx, group: clif::Value) {
        base64_group(mut lo, fx: mut fx1, text, target, data, groups, last_padding, zero, group)
    })
    mut fx.store(size, addr: target, offset: VECTOR_LEN)
    return json_code(mut fx, code: 0)
} decode_base64

/// The padding ending base64 text: one or two `=`.
fn base64_padding(mut fx: Fx, text: clif::Value, len: clif::Value) -> clif::Value {
    let end = mut fx.b.iadd(text, y: len)
    let last_at = mut fx.b.iadd_imm_s(end, y: -1)
    let before_at = mut fx.b.iadd_imm_s(end, y: -2)
    let last_byte = mut fx.load(clif::Type.Int8, addr: last_at, offset: 0)
    let before_byte = mut fx.load(clif::Type.Int8, addr: before_at, offset: 0)
    let last = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: last_byte, y: i64.widen(b'='))
    let before = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: before_byte, y: i64.widen(b'='))
    let both = mut fx.b.band(last, y: before)
    let count = mut fx.b.uextend(clif::Type.Int64, x: last)
    let extra = mut fx.b.uextend(clif::Type.Int64, x: both)
    return mut fx.b.iadd(count, y: extra)
} base64_padding

/// Returns `Malformed` from the function decoding base64.
fn base64_malformed(mut fx: Fx) {
    let failed = json_code(mut fx, code: FAILURE_MALFORMED)
    let returned = fx.list1(failed)
    mut fx.b.ret(returned.view())
} base64_malformed

/// Frees the bytes decoded so far, leaving them empty, and returns `Malformed`.
fn base64_undo(mut lo: Lowering, mut fx: Fx, target: clif::Value) {
    free_storage(mut lo, mut fx, address: target)
    let empty = mut fx.ptr(1)
    mut fx.store(empty, addr: target, offset: VECTOR_DATA)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: target, offset: VECTOR_CAPACITY)
    base64_malformed(mut fx)
} base64_undo

/// The sextet a base64 character stands for, -1 for none.
fn sextet_of(mut fx: Fx, byte: clif::Value) -> clif::Value {
    let upper = json_in_range(mut fx, value: byte, low: i64.widen(b'A'), high: i64.widen(b'Z'))
    let lower = json_in_range(mut fx, value: byte, low: i64.widen(b'a'), high: i64.widen(b'z'))
    let digit = json_in_range(mut fx, value: byte, low: i64.widen(b'0'), high: i64.widen(b'9'))
    let plus = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'+'))
    let slash = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'/'))
    var value = mut fx.int(clif::Type.Int64, value: -1)
    value = sextet_range(mut fx, byte, flag: upper, base: i64.widen(b'A'), value)
    value = sextet_range(mut fx, byte, flag: lower, base: i64.widen(b'a') - 26, value)
    value = sextet_range(mut fx, byte, flag: digit, base: i64.widen(b'0') - 52, value)
    let plus_value = mut fx.int(clif::Type.Int64, value: 62)
    let slash_value = mut fx.int(clif::Type.Int64, value: 63)
    let with_plus = mut fx.b.select(plus, x: plus_value, y: value)
    return mut fx.b.select(slash, x: slash_value, y: with_plus)
} sextet_of

/// `value`, or the byte less `base` when `flag` holds.
fn sextet_range(mut fx: Fx, byte: clif::Value, flag: clif::Value, base: i64, value: clif::Value) -> clif::Value
    requires base > -256 and base < 256
{
    let decoded = mut fx.b.iadd_imm_s(byte, y: -base)
    return mut fx.b.select(flag, x: decoded, y: value)
} sextet_range

/// Decodes the base64 group at `group` into its bytes, giving up on what encoding never writes.
fn base64_group(mut lo: Lowering, mut fx: Fx, text: clif::Value, target: clif::Value, data: clif::Value, groups: clif::Value, last_padding: clif::Value, zero: clif::Value, group: clif::Value) {
    let at = mut fx.b.ishl_imm_s(group, y: 2)
    let chars = mut fx.b.iadd(text, y: at)
    let after_group = mut fx.b.iadd_imm_s(group, y: 1)
    let final_group = mut fx.b.icmp(clif::IntCC.Equal, x: after_group, y: groups)
    let padding = mut fx.b.select(final_group, x: last_padding, y: zero)
    var bits = mut fx.ptr(0)
    for index in 0..<4u64 {
        let loaded = mut fx.load(clif::Type.Int8, addr: chars, offset: index)
        let byte = mut fx.b.uextend(clif::Type.Int64, x: loaded)
        let padded = mut fx.b.icmp_imm_s(clif::IntCC.SignedGreaterThanOrEqual, x: padding, y: 4 - i64.fit(index))
        let sextet = sextet_of(mut fx, byte)
        let invalid = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: sextet, y: -1)
        let unpadded = mut fx.b.bxor_imm_s(padded, y: 1)
        let wrong = mut fx.b.band(unpadded, y: invalid)
        mut fx.if_true(wrong, then: fn[mut lo](mut fx1: Fx) {
            base64_undo(mut lo, fx: mut fx1, target)
        })
        let kept = mut fx.b.select(padded, x: zero, y: sextet)
        let shifted = mut fx.b.ishl_imm_s(kept, y: 18 - 6 * i64.fit(index))
        bits = mut fx.b.bor(bits, y: shifted)
    }
    let one_pad = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: padding, y: 1)
    let two_pad = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: padding, y: 2)
    let low_eight = mut fx.b.band_imm_s(bits, y: 0xFF)
    let low_sixteen = mut fx.b.band_imm_s(bits, y: 0xFFFF)
    let stray_eight = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: low_eight, y: 0)
    let stray_one = mut fx.b.band(one_pad, y: stray_eight)
    let stray_sixteen = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: low_sixteen, y: 0)
    let stray_two = mut fx.b.band(two_pad, y: stray_sixteen)
    let stray = mut fx.b.bor(stray_one, y: stray_two)
    mut fx.if_true(stray, then: fn[mut lo](mut fx1: Fx) {
        base64_undo(mut lo, fx: mut fx1, target)
    })
    let out = mut fx.b.imul_imm_s(group, y: 3)
    for index in 0..<3u64 {
        let room = mut fx.b.icmp_imm_s(clif::IntCC.SignedLessThan, x: padding, y: 3 - i64.fit(index))
        mut fx.if_true(room, then: fn(mut fx1: Fx) {
            expect index < 3
            let shifted = mut fx1.b.ushr_imm_s(bits, y: 16 - 8 * i64.fit(index))
            let byte = mut fx1.b.ireduce(clif::Type.Int8, x: shifted)
            let at_out = mut fx1.b.iadd(data, y: out)
            mut fx1.store(byte, addr: at_out, offset: index)
        })
    }
} base64_group
