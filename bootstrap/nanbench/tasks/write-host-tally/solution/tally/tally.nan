//! Entry of the tally, the ledger's parsing and the saved total.

pub closed enum TotalError derives Render {
    BadLine(u32)
    Overflow
    Fs(sys::fs::FsError) from
    Cancelled(task::Cancelled) from
} TotalError

fn main(take world: host::World) fails TotalError uses wait {
    let total = try await total_file(world.fs, path: "ledger.txt", alloc: world.alloc)
    try await save_total(world.fs, path: "total.txt", total, alloc: world.alloc)
} main

/// The sum of the amounts the file at `path` holds, one decimal amount per line.
pub fn total_file(fs: sys::Fs, path: Str, alloc: mem::Alloc) -> u64 fails TotalError uses wait {
    let contents = try await fs.read_all(path, alloc)
    return try sum_lines(contents.view())
} total_file

/// Writes `total=<total>` and a line feed to the file at `path`.
pub fn save_total(fs: sys::Fs, path: Str, total: u64, alloc: mem::Alloc) fails TotalError uses wait {
    var line = text::String.empty(alloc)
    mut line.write(text::fmt("total={total}\n", total), budget: 64)
    try await fs.write_all(path, data: line.as_bytes())
} save_total

/// The sum of the decimal amounts on the lines of `raw`, empty lines skipped.
validator fn sum_lines(raw: Untrusted[Slice[u8]]) -> u64 fails TotalError {
    var total: u64 = 0
    var amount: u64 = 0
    var line: u32 = 1
    for byte in raw.inspect() {
        if byte == b'\n' {
            let Some(sum) = total.checked_add(amount) else {
                fail TotalError.Overflow
            }
            total = sum
            amount = 0
            line = line.saturating_add(1)
            continue
        }
        if byte < b'0' or byte > b'9' {
            fail TotalError.BadLine(line)
        }
        let Some(scaled) = amount.checked_mul(10) else {
            fail TotalError.Overflow
        }
        let Some(next) = scaled.checked_add(u64.widen(byte - b'0')) else {
            fail TotalError.Overflow
        }
        amount = next
    }
    let Some(sum) = total.checked_add(amount) else {
        fail TotalError.Overflow
    }
    return sum
} sum_lines
