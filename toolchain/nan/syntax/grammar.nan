        38 => Some(Punct.Gt)
        39 => Some(Punct.Ge)
        40 => Some(Punct.DotDotLt)
        41 => Some(Punct.DotDotEq)
        else => None
    }
} Punct.from_index

/// The foreign spellings, which are tokens no syntactic rule accepts, in the order the grammar lists them.
pkg enum Foreign derives Copy, Eq {
    AmpAmp
    PipePipe
    Bang
    Question
    Semi
    DotDot
    MinusMinus
} Foreign

/// The token as source spells it.
pkg proj fn Foreign.spelling(self) -> Str {
    return match self {
        Foreign.AmpAmp => "&&"
        Foreign.PipePipe => "||"
        Foreign.Bang => "!"
        Foreign.Question => "?"
        Foreign.Semi => ";"
        Foreign.DotDot => ".."
        Foreign.MinusMinus => "--"
    }
} Foreign.spelling

/// The position of the spelling in the order the grammar lists them.
fn Foreign.index(self) -> usize {
    return match self {
        Foreign.AmpAmp => 0
        Foreign.PipePipe => 1
        Foreign.Bang => 2
        Foreign.Question => 3
        Foreign.Semi => 4
        Foreign.DotDot => 5
        Foreign.MinusMinus => 6
    }
} Foreign.index

fn Foreign.from_index(index: usize) -> Option[Foreign] {
    return match index {
        0 => Some(Foreign.AmpAmp)
        1 => Some(Foreign.PipePipe)
        2 => Some(Foreign.Bang)
        3 => Some(Foreign.Question)
        4 => Some(Foreign.Semi)
        5 => Some(Foreign.DotDot)
        6 => Some(Foreign.MinusMinus)
        else => None
    }
} Foreign.from_index

