//! Files written, read back and removed through the file system capability on the host.

fn main(take world: host::World) fails task::Cancelled uses wait {
    let fs = world.fs
    let wrote = attempt await fs.write_all("notes/day", data: b"hello")
    world.log.info("wrote", value: wrote.is_ok())
    match attempt await fs.read_all("notes/day", alloc: world.alloc) {
        Ok(read) => world.log.info("read bytes", value: read.byte_len())
        Err(error) => world.log.info("read failed", value: error)
    }
    let removed = attempt await fs.remove("notes/day")
    world.log.info("removed", value: removed.is_ok())
    match attempt await fs.read_all("notes/day", alloc: world.alloc) {
        Ok(_) => world.log.info("read after removal", value: true)
        Err(error) => world.log.info("read after removal failed", value: error)
    }
} main
