//! Summaries and trends of readings in tenths of a degree.

pub closed enum Trend derives Eq, Render {
    Rising
    Falling
    Steady
} Trend

pub closed struct Summary derives Eq, Render {
    pub low: i32
    pub high: i32
    pub mean: i32
} Summary

/// The lowest and highest reading and the mean rounded toward zero; none without readings.
pub fn summarize(readings: Slice[i32]) -> Option[Summary] {
    if readings.is_empty() {
        return None
    }
    var low = readings[0]
    var high = readings[0]
    var total: i64 = 0
    for reading in readings {
        if reading < low {
            low = reading
        }
        if reading > high {
            high = reading
        }
        total += i64.widen(reading)
    }
    let count = i64.fit(readings.len())
    return Some(Summary(low: low, high: high, mean: i32.fit(total.div_trunc(count))))
} summarize

/// The trend from one reading to the next, steady while they differ by at most `tolerance`.
pub fn trend(before: i32, after: i32, tolerance: i32) -> Trend {
    let change = i64.widen(after) - i64.widen(before)
    if change > i64.widen(tolerance) {
        return Trend.Rising
    }
    if change < -i64.widen(tolerance) {
        return Trend.Falling
    }
    return Trend.Steady
} trend

/// The number of readings at or below zero.
pub fn frost_count(readings: Slice[i32]) -> u32 {
    var count: u32 = 0
    for reading in readings {
        if reading <= 0 {
            count += 1
        }
    }
    return count
} frost_count

/// The number of rises between consecutive readings.
pub fn rises(readings: Slice[i32], tolerance: i32) -> u32 {
    var count: u32 = 0
    for at in 1..<readings.len() {
        if trend(readings[at - 1], after: readings[at], tolerance) == Trend.Rising {
            count += 1
        }
    }
    return count
} rises
