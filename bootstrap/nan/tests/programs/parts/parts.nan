//! Each line shows a value reached through a part or written through one.

pub closed struct Sum {
    pub total: u64
} Sum

impl Sum: core::Hasher

pub fn Sum.write(mut self, bytes: Slice[u8]) limits pure, notrap, terminates {
    for byte in bytes {
        self.total = self.total.wrapping_add(u64.widen(byte))
    }
} Sum.write

pub closed struct Pair derives Copy, Eq, Hash {
    pub left: u8
    pub right: u16
} Pair

pub interface Scaled[U: Copy] {
    fn unit(self, base: U) -> u64
    fn times[T: Copy](self, base: U, count: u64, tag: T) -> u64 {
        return self.unit(base).saturating_mul(count)
    } times
} Scaled

pub closed struct Meter derives Copy {
    pub size: u64
} Meter

impl Meter: Scaled[u8]

pub fn Meter.unit(self, base: u8) -> u64 = self.size.saturating_add(u64.widen(base))

pub closed view struct Shout {
    pub text: Str
} Shout

impl Shout: Render

pub fn Shout.render(self, mut out: core::Renderer) limits pure, terminates {
    mut out.write(self.text)
    if out.remaining() > 2 {
        mut out.write("!")
    }
} Shout.render

pub closed struct Shelf {
    pub books: mem::List[text::String]
    pub spare: text::String
} Shelf

/// The book at `index`, or the spare one past the last.
pub proj fn Shelf.book(self, index: usize) -> text::String {
    return match index < self.books.len() {
        true => self.books[index]
        false => self.spare
    }
} Shelf.book

/// The book at `index`, none past the last.
pub proj fn Shelf.found(self, index: usize) -> Option[text::String] {
    return if index < self.books.len() {
        Some(self.books[index])
    } else {
        None
    }
} Shelf.found

/// The lengths of books that branches yielding parts choose, bound by `let` and by `var` and read
/// in place as an argument, as the digits of one number.
fn chosen_lengths(shelf: Shelf, last: bool) -> usize {
    let chosen = match last {
        true => shelf.books[shelf.books.len() - 1]
        false => shelf.book(0)
    }
    var other = if last {
        shelf.book(9)
    } else {
        shelf.books[1]
    }
    let read = length_of(if last {
        shelf.books[0]
    } else {
        shelf.book(9)
    })
    return chosen.byte_len() * 100 + other.byte_len() * 10 + read
} chosen_lengths

fn length_of(book: text::String) -> usize = book.byte_len()

/// The number of books, counted through a binding of a field of a read parameter and through
/// the parameter.
fn shelved(shelf: Shelf) -> usize {
    let books = shelf.books
    return books.len() + shelf.books.len()
} shelved

/// The length of a book wrapped in `Some` and read in place as an argument.
fn wrapped_length(shelf: Shelf) -> usize = length_or_zero(Some(shelf.book(1)))

fn length_or_zero(book: Option[text::String]) -> usize {
    return match book {
        Some(found) => found.byte_len()
        None => 0
    }
} length_or_zero

fn port_of(ports: mem::Map[text::String, u16], name: Str) -> Option[u16] {
    return ports.get_by(fn(key: text::String) => key.as_str().cmp(name))
} port_of

/// Whether the two pointers made from each of these places agree: a box's contents, a `var` and
/// an element of a `var` array.
fn pointers_agree(alloc: mem::Alloc) -> bool {
    let boxed = mem::Heap.of(alloc).boxed(7u64)
    var count: u64 = 1
    var levels = Array[u8, 3].filled(2)
    count += 1
    levels[0] = 3
    let boxes = hw::Ptr.of(boxed.contents()).addr() == hw::Ptr.of(boxed.contents()).addr()
    let counts = hw::Ptr.of(count).addr() == hw::Ptr.of(count).addr()
    let elements = hw::Ptr.of(levels[1]).addr() == hw::Ptr.of(levels[1]).addr()
    return boxes and counts and elements
} pointers_agree

fn main(take world: host::World) fails task::Cancelled uses wait {
    var levels = Array[u8, 3].filled(2)
    for level in mut levels {
        level = 7
    }
    world.log.info("levels", value: levels[2])
    var buffers = mem::Map[u8, mem::Bytes].empty(world.alloc)
    discard mut buffers.insert(1, value: mem::Bytes.empty(world.alloc))
    world.log.info("contains", value: buffers.contains(1))
    match mut buffers.get_mut(1) {
        Some(found) => {
            var buffer = found
            mut buffer.push(9)
        }
        None => {
        }
    }
    world.log.info("grown", value: buffers.at(1).len())
    var ports = mem::Map[text::String, u16].empty(world.alloc)
    discard mut ports.insert(text::String.of("http", alloc: world.alloc), value: 80)
    world.log.info("port", value: port_of(ports, name: "http"))
    var sum = Sum(total: 0)
    Pair(left: 1, right: 2).hash(mut sum)
    core::TotalF64(value: -0.0).hash(mut sum)
    world.log.info("hashed", value: sum.total)
    world.log.info("scaled", value: Meter(size: 2).times(1, count: 3, tag: true))
    var out = text::String.empty(world.alloc)
    mut out.write(text::fmt("{shout}", shout: Shout(text: "hey")), budget: 64)
    world.log.info("rendered", value: out)
    world.log.info("pointers agree", value: pointers_agree(world.alloc))
    var books = mem::List[text::String].empty(world.alloc)
    mut books.push(text::String.of("dune", alloc: world.alloc))
    mut books.push(text::String.of("middlemarch", alloc: world.alloc))
    let shelf = Shelf(books: take books, spare: text::String.of("atlas", alloc: world.alloc))
    world.log.info("book", value: shelf.book(1))
    world.log.info("spare", value: shelf.book(7))
    world.log.info("found", value: shelf.found(0))
    world.log.info("missing", value: shelf.found(5))
    world.log.info("chosen last", value: chosen_lengths(shelf, last: true))
    world.log.info("chosen first", value: chosen_lengths(shelf, last: false))
    world.log.info("shelved", value: shelved(shelf))
    world.log.info("shelved again", value: shelved(shelf))
    world.log.info("wrapped", value: wrapped_length(shelf))
} main
