    \\        signal.post(t, value: 2)
    \\    })
    \\    let value = try await signal.wait()
    \\    expect value == 2
    \\} post_replaces_a_stored_value
    \\
    \\test wait_takes_the_stored_value for Signal.wait {
    \\    let world = testing::world()
    \\    let signal = Signal[u32].empty()
    \\    without_irqs(fn(t: IrqsDisabled) => signal.post(t, value: 4))
    \\    let value = try await signal.wait()
    \\    expect value == 4
    \\    let again = try await task::within(world.clock, ms: 10, body: fn() -> u32 fails task::Cancelled uses wait {
    \\        return try await signal.wait()
    \\    })
    \\    expect again == None
    \\} wait_takes_the_stored_value
    \\
    \\pub open struct SpinLock[T: Send] {
    \\} SpinLock
    \\
    \\pub fn SpinLock.of(take value: T) -> SpinLock[T] limits notrap, terminates, noalloc
    \\    example without_irqs(fn(t: IrqsDisabled) => SpinLock.of(5u64).with(t, body: fn(mut held: u64) => held)) == 5
    \\
    \\pub fn SpinLock.with[R: Any](self, t: IrqsDisabled, body: fn(mut value: T) -> R limits notrap, terminates, noalloc) -> R limits notrap, terminates, noalloc
    \\
    \\test with_keeps_changes_for_the_next_holder for SpinLock.with {
    \\    let lock = SpinLock.of(5u64)
    \\    let value = without_irqs(fn(t: IrqsDisabled) -> u64 {
    \\        lock.with(t, body: fn(mut held: u64) {
    \\            held = held.wrapping_add(1)
    \\        })
    \\        return lock.with(t, body: fn(mut held: u64) => held)
    \\    })
    \\    expect value == 6
    \\} with_keeps_changes_for_the_next_holder
    \\
    \\pub open linear struct SpinGuard[T] {
    \\} SpinGuard
    \\
    \\pub proj fn SpinGuard.contents_mut(mut self) -> T
    \\
    \\pub open linear struct IrqShared[T: Any and Send] {
    \\} IrqShared
    \\
    \\pub fn IrqShared.install(take dev: T, vector: u8, on_irq: interrupt fn(mut dev: T, take irq: IrqContext) -> IrqExit) -> IrqShared[T]
    \\    requires vector >= 32
    \\
    \\pub fn IrqShared.install_on(take dev: T, cpu: u32, vector: u8, on_irq: interrupt fn(mut dev: T, take irq: IrqContext) -> IrqExit) -> IrqShared[T]
    \\    requires vector >= 32
    \\
    \\pub fn IrqShared.install_msi(take dev: T, cpu: u32, source: u32, on_irq: interrupt fn(mut dev: T, take irq: IrqContext) -> IrqExit) -> Result[IrqShared[T], MsiRefusal[T]]
    \\
    \\pub fn IrqShared.message(self) -> Option[MsiMessage]
    \\
    \\pub fn IrqShared.with[R: Any](self, t: IrqsDisabled, body: fn(mut dev: T) -> R limits notrap, terminates, noalloc) -> R limits notrap, terminates, noalloc
    \\
    \\pub fn IrqShared.uninstall(take self) -> T
    \\
    \\pub closed struct MsiMessage derives Copy, Eq {
    \\    pub address: u64
    \\    pub data: u32
    \\} MsiMessage
    \\
    \\pub closed enum MsiError derives Copy, Eq, Render {
    \\    Exhausted
    \\    Unreachable
    \\    Unsupported
    \\} MsiError
    \\
    \\pub closed struct MsiRefusal[T: Any and Send] {
    \\    pub dev: T
    \\    pub error: MsiError
    \\} MsiRefusal
    \\
    \\interrupt fn count_interrupt(mut count: u64, take irq: IrqContext) -> IrqExit limits stack 256 {
    \\    count = count.wrapping_add(1)
    \\    take irq.complete()
    \\    return IrqExit.Resume
    \\} count_interrupt
    \\
    \\test install_keeps_the_device for IrqShared.install {
    \\    let shared = IrqShared.install(5u64, vector: 0x30, on_irq: count_interrupt)
    \\    let device = take shared.uninstall()
    \\    expect device == 5
    \\} install_keeps_the_device
    \\
    \\test with_reaches_the_installed_device for IrqShared.with {
    \\    let shared = IrqShared.install(5u64, vector: 0x30, on_irq: count_interrupt)
    \\    let value = without_irqs(fn(t: IrqsDisabled) => shared.with(t, body: fn(mut count: u64) => count))
    \\    expect value == 5
    \\    discard take shared.uninstall()
    \\} with_reaches_the_installed_device
    \\
    \\test uninstall_returns_the_changed_device for IrqShared.uninstall {
    \\    let shared = IrqShared.install(5u64, vector: 0x30, on_irq: count_interrupt)
    \\    without_irqs(fn(t: IrqsDisabled) {
    \\        shared.with(t, body: fn(mut count: u64) {
    \\            count = count.wrapping_add(2)
    \\        })
    \\    })
    \\    let device = take shared.uninstall()
    \\    expect device == 7
    \\} uninstall_returns_the_changed_device
    \\
    \\test install_on_keeps_the_device for IrqShared.install_on {
    \\    let shared = IrqShared.install_on(5u64, cpu: 0, vector: 0x30, on_irq: count_interrupt)
    \\    let message = shared.message()
    \\    expect message == None
    \\    let device = take shared.uninstall()
    \\    expect device == 5
    \\} install_on_keeps_the_device
    \\
    \\test install_msi_refuses_on_the_host for IrqShared.install_msi {
    \\    let refusal = match IrqShared.install_msi(5u64, cpu: 0, source: 0, on_irq: count_interrupt) {
    \\        Ok(shared) => {
    \\            discard take shared.uninstall()
    \\            expect false
    \\            return
    \\        }
    \\        Err(refusal) => refusal
    \\    }
    \\    expect refusal.dev == 5 and refusal.error == MsiError.Unsupported
    \\} install_msi_refuses_on_the_host
    \\
    \\test message_is_none_without_an_msi for IrqShared.message {
    \\    let shared = IrqShared.install(5u64, vector: 0x30, on_irq: count_interrupt)
    \\    let message = shared.message()
    \\    expect message == None
    \\    discard take shared.uninstall()
    \\} message_is_none_without_an_msi
    \\
