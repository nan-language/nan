test cancelled_keyed_task_posts_nothing for Cx.cancel {
    let world = testing::world()
    let clock = world.clock
    let last = try await host::Runner[Probe].run(ProbeEnv(clock: clock, counted: 0), exec: world.exec, alloc: world.alloc, body: fn(inbox: Outbox[ProbeMessage]) fails task::SendError uses wait {
