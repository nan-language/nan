//! Divides a hundred by its input, failing on one and reading kernel memory on two.

pub closed enum CrashError derives Render {
    One
    Cancelled(task::Cancelled) from
} CrashError

/// Kernel memory outside the image, which an isolated space does not map.
const KERNEL_PROBE: usize = 0x5000_0000

fn main(take world: nanos::World, take input: u32) -> u32 fails CrashError uses wait limits stack 65_536 {
    if input == 1 {
        fail CrashError.One
    }
    if input == 2 {
        return u32.truncate(trusted "the read faults, an isolated space mapping no kernel memory" { hw::Ptr[u64].of_addr(KERNEL_PROBE).read() })
    }
    return 100 / input
} main
