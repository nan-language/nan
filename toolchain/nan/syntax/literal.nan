//! The values literals denote.

/// The value of a `TEXT` token, its escapes replaced. The lexer has checked every escape.
pkg fn text_value(token: Str, alloc: mem::Alloc) -> text::String {
    var value = text::String.empty(alloc)
    expect token.byte_len() >= 2
    let Some(contents) = token.slice_bytes(1, end: token.byte_len() - 1) else {
        expect false
        return value
    }
    var chars = contents.cursor()
    loop {
        let Some(c) = mut chars.next() else {
            return value
        }
        if c != '\\' {
            mut value.push(c)
            continue
        }
        let Some(escaped) = mut chars.next() else {
            expect false
            return value
        }
        match escaped {
            'n' => mut value.push('\n')
            'r' => mut value.push('\r')
            't' => mut value.push('\t')
            '0' => mut value.push('\0')
            'x' => {
                var written = text::String.empty(alloc)
                for _ in 0..<2usize {
                    let Some(digit) = mut chars.next() else {
                        break
                    }
                    mut written.push(digit)
                }
                let Some(byte) = hex_value(written.as_bytes()) else {
                    expect false
                    return value
                }
                expect byte <= 0xFF
                let Some(denoted) = char.checked_from_bits(byte) else {
                    expect false
                    return value
                }
                mut value.push(denoted)
            }
            'u' => {
                discard mut chars.next()
                var written = text::String.empty(alloc)
                loop {
                    let Some(digit) = mut chars.next() else {
                        break
                    }
                    if digit == '}' {
                        break
                    }
                    mut written.push(digit)
                }
                let Some(scalar) = hex_value(written.as_bytes()) else {
                    expect false
                    return value
                }
                let Some(denoted) = char.checked_from_bits(scalar) else {
                    expect false
                    return value
                }
                mut value.push(denoted)
            }
            else => mut value.push(escaped)
        }
    }
} text_value

test escapes_stand_for_the_characters_they_denote for text_value {
    let alloc = testing::world().alloc
    let escaped = text_value("\"caf\\u{E9} \\\"q\\\" \\x41\\t\\\\\"", alloc)
    expect escaped.as_str() == "caf\u{E9} \"q\" A\t\\"
    let empty = text_value("\"\"", alloc)
    expect empty.as_str() == ""
} escapes_stand_for_the_characters_they_denote
