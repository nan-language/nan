//! Reads records of floats from JSON and construction text and writes each back as JSON.

registers Uart {
    data: u8 at 0x0 write
} Uart

pub closed struct Reading derives Encode {
    pub wide: f64
    pub narrow: f32
} Reading

fn say(text: Slice[u8]) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in text {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say

fn written(decoded: Result[Reading, core::DecodeError], alloc: mem::Alloc) {
    let Ok(reading) = decoded else {
        say(text: b"malformed\n")
        return
    }
    var out = text::String.empty(alloc)
    text::json::Codec[Reading].encode(reading, out: mut out)
    say(text: out.as_bytes())
    say(text: b"\n")
} written

fn json(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) {
    written(decoded: attempt text::json::Codec[Reading].decode(raw, alloc), alloc)
} json

fn construction(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) {
    written(decoded: attempt text::construction::Codec[Reading].decode(raw, alloc), alloc)
} construction

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    json(raw: Untrusted.of(b"{\"wide\": 0.1, \"narrow\": 0.1}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": 1E+2, \"narrow\": -2.5e-3}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": 0.000012345, \"narrow\": 1e16}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": 5e-324, \"narrow\": 1e-46}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": 2.4703282292062328e-324, \"narrow\": 1.4e-45}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": 1.7976931348623157e308, \"narrow\": 3.4028235e38}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": 1e400, \"narrow\": \"NaN\"}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": \"-inf\", \"narrow\": 123456789}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": 9007199254740993, \"narrow\": 16777217}"), alloc)
    json(raw: Untrusted.of(b"{\"wide\": 1_0, \"narrow\": 1}"), alloc)
    construction(raw: Untrusted.of(b"Reading(wide: 1_000.000_5, narrow: 1e-5)"), alloc)
    construction(raw: Untrusted.of(b"Reading(wide: -0.0, narrow: inf)"), alloc)
    construction(raw: Untrusted.of(b"Reading(wide: NaN, narrow: -inf)"), alloc)
    construction(raw: Untrusted.of(b"Reading(wide: 123456789012345678901234567890e-40, narrow: 0.3)"), alloc)
    take k.anchor(0u8, run: fn(exec: task::Executor) limits stack 16_384 {
    })
} main
