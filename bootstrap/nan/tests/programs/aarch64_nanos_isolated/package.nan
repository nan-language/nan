//! An AArch64 bare kernel running jobs of nanos bundles in isolated spaces.

package aarch64_nanos_isolated {
    language 1
    targets aarch64-bare
    entry main
    allow capability in aarch64_nanos_isolated
    allow device in aarch64_nanos_isolated
    allow trusted in aarch64_nanos_isolated
    allow validate in aarch64_nanos_isolated
} aarch64_nanos_isolated
