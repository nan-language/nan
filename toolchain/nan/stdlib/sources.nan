    \\    let later = mut cursor.next()
    \\    expect earlier == Some(1)
    \\    expect later == None
    \\} set_cursor_next_ends_with_none
    \\
    \\test set_into_cursor_next_ends_with_none for SetIntoCursor.next {
    \\    var seen = Set[u8].empty(testing::world().alloc)
    \\    discard mut seen.insert(1)
    \\    var cursor = take seen.into_cursor()
    \\    let earlier = mut cursor.next()
    \\    let later = mut cursor.next()
