    \\    let count: u32 = 12_345
    \\    var line = Fixed[4].empty()
    \\    let written = attempt mut line.try_write(Dyn[Render].view(count), budget: 64)
    \\    expect written.is_ok()
    \\    expect line.as_str() == "1..."
    \\} fixed_try_write_never_fails
    \\
    \\test intern_numbers_distinct_texts for Interner.intern {
    \\    let names = Interner.empty(testing::world().alloc)
    \\    let port = names.intern("port")
    \\    let host = names.intern("host")
    \\    expect port == Symbol(index: 0)
    \\    expect host == Symbol(index: 1)
    \\    let again = names.intern("port")
    \\    expect again == port
    \\} intern_numbers_distinct_texts
    \\
    \\test lookup_finds_interned_text for Interner.lookup {
    \\    let names = Interner.empty(testing::world().alloc)
    \\    let port = names.intern("port")
    \\    let found = names.lookup("port")
    \\    expect found == Some(port)
    \\} lookup_finds_interned_text
    \\
    \\test resolved_text_outlives_later_interning for Interner.resolve {
    \\    let names = Interner.empty(testing::world().alloc)
    \\    let port = names.resolve(names.intern("port"))
    \\    discard names.intern("host")
    \\    expect port == "port"
    \\} resolved_text_outlives_later_interning
    \\
    \\test len_counts_distinct_texts for Interner.len {
    \\    let names = Interner.empty(testing::world().alloc)
    \\    discard names.intern("port")
    \\    discard names.intern("host")
    \\    discard names.intern("port")
    \\    let count = names.len()
    \\    expect count == 2
    \\} len_counts_distinct_texts
    \\

const TEXT_TEXT_UTF8_UTF8: Str =
    \\//! Conversion between bytes and text.
    \\
    \\pub closed enum Utf8Error derives Eq, Render {
    \\    Invalid(at: usize)
    \\    OutOfMemory(mem::OutOfMemory) from
    \\} Utf8Error
    \\
    \\pub fn valid_prefix(bytes: Slice[u8]) -> usize limits pure, notrap, terminates
    \\    ensures result <= bytes.len()
    \\    example valid_prefix(b"ok\\xFF") == 2
    \\    example valid_prefix(b"\\xC3\\xA9") == 2
    \\{
    \\    var next: usize = 0
    \\    for at in 0..<bytes.len() {
    \\        if at == next {
    \\            let Some(c) = char_at(bytes, at) else {
    \\                return at
    \\            }
    \\            next = at.saturating_add(c.utf8_len())
    \\        }
    \\    }
    \\    return bytes.len()
    \\} valid_prefix
    \\
    \\pub fn is_valid(bytes: Slice[u8]) -> bool limits pure, notrap, terminates
    \\    ensures result == (valid_prefix(bytes) == bytes.len())
    \\    example not is_valid(b"\\xC3")
    \\{
    \\    return valid_prefix(bytes) == bytes.len()
    \\} is_valid
    \\
    \\pub fn char_at(bytes: Slice[u8], at: usize) -> Option[char] limits pure, notrap, terminates
    \\    example char_at(b"\\xC3\\xA9", at: 0) == Some('é')
    \\    example char_at(b"\\xC3\\xA9", at: 1) == None
    \\    example char_at(b"\\xED\\xA0\\x80", at: 0) == None
    \\{
    \\    let Some(parts) = bytes.split_at(at) else {
    \\        return None
    \\    }
    \\    let rest = parts.tail
    \\    if rest.len() == 0 {
    \\        return None
    \\    }
    \\    let lead = u32.widen(rest[0])
    \\    if lead < 0x80 {
    \\        return char.checked_from_bits(lead)
    \\    }
    \\    if lead < 0xC2 or lead > 0xF4 {
    \\        return None
    \\    }
    \\    if lead < 0xE0 {
    \\        if rest.len() < 2 {
    \\            return None
    \\        }
    \\        if not is_continuation(rest[1]) {
    \\            return None
    \\        }
    \\        return char.checked_from_bits(((lead & 0x1F) << 6) | low_bits(rest[1]))
    \\    }
    \\    if lead < 0xF0 {
    \\        if rest.len() < 3 {
    \\            return None
    \\        }
    \\        if not is_continuation(rest[1]) or not is_continuation(rest[2]) {
    \\            return None
    \\        }
    \\        let value = ((lead & 0x0F) << 12) | (low_bits(rest[1]) << 6) | low_bits(rest[2])
    \\        if value < 0x800 {
    \\            return None
    \\        }
    \\        return char.checked_from_bits(value)
    \\    }
    \\    if rest.len() < 4 {
    \\        return None
    \\    }
    \\    if not is_continuation(rest[1]) or not is_continuation(rest[2]) {
    \\        return None
    \\    }
    \\    if not is_continuation(rest[3]) {
    \\        return None
    \\    }
    \\    let high = ((lead & 0x07) << 18) | (low_bits(rest[1]) << 12)
    \\    let value = high | (low_bits(rest[2]) << 6) | low_bits(rest[3])
    \\    if value < 0x1_0000 {
    \\        return None
    \\    }
    \\    return char.checked_from_bits(value)
    \\} char_at
    \\
    \\fn is_continuation(byte: u8) -> bool limits pure, notrap, terminates {
    \\    return (byte & 0xC0) == 0x80
    \\} is_continuation
    \\
    \\fn low_bits(byte: u8) -> u32 limits pure, notrap, terminates {
    \\    return u32.widen(byte & 0x3F)
    \\} low_bits
    \\
    \\pub fn write_char(c: char, mut out: SliceMut[u8]) -> usize limits pure, notrap, terminates
    \\    requires out.len() >= c.utf8_len()
    \\    ensures result == c.utf8_len()
    \\{
    \\    let encoded = encoding(c)
    \\    let count = c.utf8_len()
    \\    let Some(source) = encoded.view().prefix(count) else {
    \\        return count
    \\    }
    \\    let Some(head) = mut out.prefix_mut(count) else {
    \\        return count
    \\    }
    \\    var target = head
    \\    mut target.copy_from(source)
    \\    return count
    \\} write_char
    \\
    \\fn encoding(c: char) -> Array[u8, 4] limits pure, notrap, terminates {
    \\    var bytes = Array[u8, 4].filled(0)
    \\    let value = c.to_bits()
    \\    match c.utf8_len() {
    \\        1 => {
    \\            bytes[0] = u8.truncate(value)
    \\        }
    \\        2 => {
    \\            bytes[0] = 0xC0 | u8.truncate(value >> 6)
    \\            bytes[1] = continuation(value)
    \\        }
    \\        3 => {
    \\            bytes[0] = 0xE0 | u8.truncate(value >> 12)
    \\            bytes[1] = continuation(value >> 6)
    \\            bytes[2] = continuation(value)
    \\        }
    \\        else => {
    \\            bytes[0] = 0xF0 | u8.truncate(value >> 18)
    \\            bytes[1] = continuation(value >> 12)
    \\            bytes[2] = continuation(value >> 6)
    \\            bytes[3] = continuation(value)
    \\        }
    \\    }
    \\    return bytes
    \\} encoding
    \\
    \\fn continuation(bits: u32) -> u8 limits pure, notrap, terminates {
    \\    return 0x80 | u8.truncate(bits & 0x3F)
    \\} continuation
    \\
    \\test write_char_encodes_two_bytes for write_char {
    \\    var bytes = Array[u8, 4].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    let count = write_char('é', out: mut view)
    \\    expect count == 2
    \\    expect bytes[0] == 0xC3
    \\    expect bytes[1] == 0xA9
    \\} write_char_encodes_two_bytes
    \\

const TEXT_UEFI_PLATFORM_CONSOLE: Str =
    \\//! The firmware's console: text output and key input with a timeout.
    \\
    \\/// The offset in the text output protocol of `OutputString`, and in the text input protocol of
    \\/// `ReadKeyStroke` and of its key event.
    \\const STRING_OUTPUT: u64 = 8
    \\
    \\const READ_KEY_STROKE: u64 = 8
    \\
    \\const WAIT_FOR_KEY: u64 = 16
    \\
    \\/// The type of a timer event, a timer's relative mode, and the 100 ns units of a millisecond.
    \\const TIMER_EVENT: u64 = 0x8000_0000
    \\
    \\const RELATIVE: u64 = 2
    \\
    \\const UNITS_PER_MS: u64 = 10_000
    \\
    \\pkg fn write_console(text: Str) fails boot::ServiceError {
    \\    let output = word(system_table() + CONSOLE_OUT)
    \\    let output_string = word(output + STRING_OUTPUT)
    \\    var units = Array[u16, 256].filled(0)
    \\    var at: usize = 0
    \\    for c in text {
    \\        if at + 3 > NAME_LIMIT {
    \\            units[at] = 0
    \\            try success(call(output_string, a: output, b: src_units(units.view()), c: 0, d: 0, e: 0))
    \\            at = 0
    \\        }
    \\        let point = c.to_bits()
    \\        if point == 0x0A {
    \\            units[at] = 0x0D
    \\            at += 1
    \\        }
    \\        if point >= 0x1_0000 {
    \\            let offset = point - 0x1_0000
    \\            units[at] = u16.fit(0xD800 + (offset >> 10))
    \\            units[at + 1] = u16.fit(0xDC00 + (offset & 0x3FF))
    \\            at += 2
    \\        } else {
    \\            units[at] = u16.fit(point)
    \\            at += 1
    \\        }
    \\    }
    \\    units[at] = 0
    \\    try success(call(output_string, a: output, b: src_units(units.view()), c: 0, d: 0, e: 0))
    \\} write_console
    \\
    \\pkg fn read_key(timeout_ms: u64) -> Option[boot::Key] fails boot::ServiceError {
    \\    let input = word(system_table() + CONSOLE_IN)
    \\    var timer = Array[u64, 1].filled(0)
    \\    try success(call(boot_service(CREATE_EVENT), a: TIMER_EVENT, b: 0, c: 0, d: 0, e: dst_words(mut timer.view_mut())))
    \\    let ticks = timeout_ms.saturating_mul(UNITS_PER_MS)
    \\    var events = Array[u64, 2].filled(word(input + WAIT_FOR_KEY))
    \\    events[1] = timer[0]
    \\    var waited = call(boot_service(SET_TIMER), a: timer[0], b: RELATIVE, c: ticks, d: 0, e: 0)
    \\    var index = Array[u64, 1].filled(1)
    \\    if (waited & ERROR) == 0 {
    \\        waited = call(boot_service(WAIT_FOR_EVENT), a: 2, b: dst_words(mut events.view_mut()), c: dst_words(mut index.view_mut()), d: 0, e: 0)
    \\    }
    \\    discard call(boot_service(CLOSE_EVENT), a: timer[0], b: 0, c: 0, d: 0, e: 0)
    \\    try success(waited)
    \\    if index[0] != 0 {
    \\        return None
    \\    }
    \\    var key = Array[u16, 2].filled(0)
    \\    let status = call(word(input + READ_KEY_STROKE), a: input, b: dst_units(mut key.view_mut()), c: 0, d: 0, e: 0)
    \\    if status == NOT_READY {
    \\        return None
    \\    }
    \\    try success(status)
    \\    var text: Option[char] = None
    \\    if key[1] != 0 {
    \\        text = char.checked_from_bits(u32.widen(key[1]))
    \\    }
    \\    return Some(boot::Key(text: text, scan: key[0]))
    \\} read_key
    \\

const TEXT_UEFI_PLATFORM_FILES: Str =
    \\//! Files of the volume the image was loaded from, and the device path naming that image.
    \\
    \\/// The offsets in the loaded image protocol of its device handle and file path; in the simple
    \\/// file system protocol of `OpenVolume`; and in the file protocol of its functions.
    \\const DEVICE_HANDLE: u64 = 24
    \\
    \\const FILE_PATH: u64 = 32
    \\
    \\const OPEN_VOLUME: u64 = 8
    \\
    \\const FILE_OPEN: u64 = 8
    \\
    \\const FILE_CLOSE: u64 = 16
    \\
    \\const FILE_DELETE: u64 = 24
    \\
    \\const FILE_READ: u64 = 32
    \\
    \\const FILE_WRITE: u64 = 40
    \\
    \\const FILE_GET_POSITION: u64 = 48
    \\
    \\const FILE_SET_POSITION: u64 = 56
    \\
    \\const FILE_GET_INFO: u64 = 64
    \\
    \\const FILE_SET_INFO: u64 = 72
    \\
    \\const FILE_FLUSH: u64 = 80
    \\
    \\/// The modes opening a file for reading, for writing and creating it.
    \\const MODE_READ: u64 = 1
    \\
    \\const MODE_WRITE: u64 = 2
    \\
    \\const MODE_CREATE: u64 = 0x8000_0000_0000_0000
    \\
    \\/// The position past a file's end, and the words of a file information record: the bytes it
    \\/// takes, then the file's size, its attributes and where its name starts; a directory's
    \\/// attribute.
    \\const END_OF_FILE: u64 = 0xFFFF_FFFF_FFFF_FFFF
    \\
    \\const INFO_WORDS: usize = 128
    \\
    \\const INFO_FILE_SIZE: usize = 1
    \\
    \\const INFO_ATTRIBUTE: usize = 9
    \\
    \\const INFO_NAME: u64 = 80
    \\
    \\const DIRECTORY: u64 = 0x10
    \\
    \\/// The device path node types and subtypes the platform reads: a media node, a hard drive and
    \\/// a file path among them, and the end node; the offsets in a hard drive node of its partition
    \\/// number, start, size, signature and signature type.
    \\const MEDIA: u8 = 4
    \\
    \\const HARD_DRIVE: u8 = 1
    \\
    \\const FILE_PATH_NODE: u8 = 4
    \\
    \\const END_NODE: u8 = 0x7F
    \\
    \\const DRIVE_NUMBER: u64 = 4
    \\
    \\const DRIVE_START: u64 = 8
    \\
    \\const DRIVE_SIZE: u64 = 16
    \\
    \\const DRIVE_SIGNATURE: u64 = 24
    \\
    \\const DRIVE_SIGNATURE_TYPE: u64 = 41
    \\
    \\/// The GUIDs of the simple file system protocol, of file information and of the device path
    \\/// protocol.
    \\const SIMPLE_FILE_SYSTEM: boot::Guid = boot::Guid(data1: 0x964E_5B22, data2: 0x6459, data3: 0x11D2, data4: 0x8E39_00A0_C969_723B)
    \\
    \\const FILE_INFO: boot::Guid = boot::Guid(data1: 0x0957_6E92, data2: 0x6D3F, data3: 0x11D2, data4: 0x8E39_00A0_C969_723B)
    \\
    \\const DEVICE_PATH: boot::Guid = boot::Guid(data1: 0x0957_6E91, data2: 0x6D3F, data3: 0x11D2, data4: 0x8E39_00A0_C969_723B)
    \\
    \\/// The root directory of the volume the image was loaded from.
    \\fn root() -> u64 fails boot::ServiceError {
    \\    let image = try loaded_image()
    \\    let device = word(image + DEVICE_HANDLE)
    \\    let volume = try on_handle(device, guid: SIMPLE_FILE_SYSTEM)
    \\    var found = Array[u64, 1].filled(0)
    \\    try success(call(word(volume + OPEN_VOLUME), a: volume, b: dst_words(mut found.view_mut()), c: 0, d: 0, e: 0))
    \\    return found[0]
    \\} root
    \\
    \\/// Opens the file `path` names from the root directory in a mode; the root itself for an empty
    \\/// path.
    \\fn open(path: Str, mode: u64) -> u64 fails boot::ServiceError {
    \\    let volume = try root()
    \\    if path.is_empty() {
    \\        return volume
    \\    }
    \\    var units = Array[u16, 256].filled(0)
    \\    let named = attempt wide(path, path: true, mut units)
    \\    var found = Array[u64, 1].filled(0)
    \\    var status = INVALID_PARAMETER
    \\    if named.is_ok() {
    \\        status = call(word(volume + FILE_OPEN), a: volume, b: dst_words(mut found.view_mut()), c: src_units(units.view()), d: mode, e: 0)
    \\    }
    \\    close(volume)
    \\    try success(status)
    \\    return found[0]
    \\} open
    \\
    \\fn close(file: u64) {
    \\    discard call(word(file + FILE_CLOSE), a: file, b: 0, c: 0, d: 0, e: 0)
    \\} close
    \\
    \\/// The information record of an open file.
    \\fn information(file: u64) -> Array[u64, 128] fails boot::ServiceError {
    \\    let kind = guid_bits(FILE_INFO)
    \\    var record = Array[u64, 128].filled(0)
    \\    var size = Array[u64, 1].filled(u64.widen(INFO_WORDS) * 8)
    \\    try success(call(word(file + FILE_GET_INFO), a: file, b: src(kind.view()), c: dst_words(mut size.view_mut()), d: dst_words(mut record.view_mut()), e: 0))
    \\    return record
    \\} information
    \\
    \\pkg fn read_file(path: Str, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails boot::ServiceError {
    \\    let file = try open(path, mode: MODE_READ)
    \\    defer close(file)
    \\    var position = Array[u64, 1].filled(0)
    \\    try success(call(word(file + FILE_SET_POSITION), a: file, b: END_OF_FILE, c: 0, d: 0, e: 0))
    \\    try success(call(word(file + FILE_GET_POSITION), a: file, b: dst_words(mut position.view_mut()), c: 0, d: 0, e: 0))
    \\    try success(call(word(file + FILE_SET_POSITION), a: file, b: 0, c: 0, d: 0, e: 0))
    \\    let size = position[0]
    \\    var bytes = try zeroed(size, alloc)
    \\    let start = dst(mut bytes.view_mut())
    \\    var filled: u64 = 0
    \\    while filled < size {
    \\        var count = Array[u64, 1].filled(size - filled)
    \\        try success(call(word(file + FILE_READ), a: file, b: dst_words(mut count.view_mut()), c: start + filled, d: 0, e: 0))
    \\        if count[0] == 0 or count[0] > size - filled {
    \\            break
    \\        }
    \\        filled += count[0]
    \\    }
    \\    mut bytes.truncate(usize.widen(filled))
    \\    return Untrusted.of(take bytes)
    \\} read_file
    \\
    \\pkg fn write_file(path: Str, data: Slice[u8]) fails boot::ServiceError {
    \\    let file = try open(path, mode: MODE_READ | MODE_WRITE | MODE_CREATE)
    \\    defer close(file)
    \\    var record = try information(file)
    \\    if record[INFO_FILE_SIZE] != 0 {
    \\        record[INFO_FILE_SIZE] = 0
    \\        let kind = guid_bits(FILE_INFO)
    \\        try success(call(word(file + FILE_SET_INFO), a: file, b: src(kind.view()), c: record[0], d: dst_words(mut record.view_mut()), e: 0))
    \\    }
    \\    var written: usize = 0
    \\    while written < data.len() {
    \\        let Some(parts) = data.split_at(written) else {
    \\            break
    \\        }
    \\        var count = Array[u64, 1].filled(u64.widen(parts.tail.len()))
    \\        try success(call(word(file + FILE_WRITE), a: file, b: dst_words(mut count.view_mut()), c: src(parts.tail), d: 0, e: 0))
    \\        if count[0] == 0 or count[0] > u64.widen(parts.tail.len()) {
    \\            fail boot::ServiceError.DeviceError
    \\        }
    \\        written += usize.widen(count[0])
    \\    }
    \\    try success(call(word(file + FILE_FLUSH), a: file, b: 0, c: 0, d: 0, e: 0))
    \\} write_file
    \\
    \\pkg fn delete_file(path: Str) fails boot::ServiceError {
    \\    let file = try open(path, mode: MODE_READ | MODE_WRITE)
    \\    let status = call(word(file + FILE_DELETE), a: file, b: 0, c: 0, d: 0, e: 0)
    \\    if status != 0 {
    \\        try success(status)
    \\        fail boot::ServiceError.DeviceError
    \\    }
    \\} delete_file
    \\
    \\pkg fn list_directory(path: Str, alloc: mem::Alloc) -> mem::List[boot::DirectoryEntry] fails boot::ServiceError {
    \\    let folder = try open(path, mode: MODE_READ)
    \\    defer close(folder)
    \\    let own = try information(folder)
    \\    if (own[INFO_ATTRIBUTE] & DIRECTORY) == 0 {
    \\        fail boot::ServiceError.Invalid
    \\    }
    \\    var entries = mem::List[boot::DirectoryEntry].empty(alloc)
    \\    loop {
    \\        var record = Array[u64, 128].filled(0)
    \\        var size = Array[u64, 1].filled(u64.widen(INFO_WORDS) * 8)
    \\        let at = dst_words(mut record.view_mut())
    \\        try success(call(word(folder + FILE_READ), a: folder, b: dst_words(mut size.view_mut()), c: at, d: 0, e: 0))
    \\        if size[0] <= INFO_NAME {
    \\            return entries
    \\        }
    \\        var name = mem::Bytes.empty(alloc)
    \\        try narrow(at + INFO_NAME, limit: (size[0] - INFO_NAME) / 2, path: false, out: mut name)
    \\        let dots = name.view() == b"." or name.view() == b".."
    \\        if not dots {
    \\            let entry = boot::DirectoryEntry(name: Untrusted.of(take name), byte_len: record[INFO_FILE_SIZE], directory: (record[INFO_ATTRIBUTE] & DIRECTORY) != 0)
    \\            let Ok(_) = attempt mut entries.try_push(take entry) else {
    \\                fail boot::ServiceError.OutOfMemory
    \\            }
    \\        }
    \\    }
    \\} list_directory
    \\
    \\pkg fn boot_device(alloc: mem::Alloc) -> boot::BootDevice fails boot::ServiceError {
    \\    let image = try loaded_image()
    \\    var file = mem::Bytes.empty(alloc)
    \\    var node = word(image + FILE_PATH)
    \\    while node != 0 and byte_at(node) != END_NODE {
    \\        let len = bytes_at(node + 2, count: 2)
    \\        if len < 4 {
    \\            break
    \\        }
    \\        if byte_at(node) == MEDIA and byte_at(node + 1) == FILE_PATH_NODE {
    \\            if file.len() > 0 {
    \\                try grown(mut file, bytes: b"/")
    \\            }
    \\            try narrow(node + 4, limit: (len - 4) / 2, path: true, out: mut file)
    \\        }
    \\        node += len
    \\    }
    \\    let device = word(image + DEVICE_HANDLE)
    \\    let partition = match attempt on_handle(device, guid: DEVICE_PATH) {
    \\        Ok(path) => drive(path)
    \\        Err(_) => None
    \\    }
    \\    return boot::BootDevice(file: Untrusted.of(take file), partition: partition)
    \\} boot_device
    \\
    \\/// The partition the hard drive node of a device path names, if it has one.
    \\fn drive(path: u64) -> Option[boot::Partition] {
    \\    var node = path
    \\    while byte_at(node) != END_NODE {
    \\        let len = bytes_at(node + 2, count: 2)
    \\        if len < 4 {
    \\            return None
    \\        }
    \\        if byte_at(node) == MEDIA and byte_at(node + 1) == HARD_DRIVE {
    \\            let signature = match byte_at(node + DRIVE_SIGNATURE_TYPE) {
    \\                1 => boot::PartitionSignature.Mbr(u32.fit(bytes_at(node + DRIVE_SIGNATURE, count: 4)))
    \\                2 => boot::PartitionSignature.Gpt(guid_at(node + DRIVE_SIGNATURE))
    \\                else => boot::PartitionSignature.Unsigned
    \\            }
    \\            return Some(boot::Partition(number: u32.fit(bytes_at(node + DRIVE_NUMBER, count: 4)), start: bytes_at(node + DRIVE_START, count: 8), blocks: bytes_at(node + DRIVE_SIZE, count: 8), signature: signature))
    \\        }
    \\        node += len
    \\    }
    \\    return None
    \\} drive
    \\

const TEXT_UEFI_PLATFORM_FIRMWARE: Str =
    \\//! Calls into the firmware: its tables, protocols, statuses, GUIDs and UTF-16 texts.
    \\
    \\/// The offsets in the system table of its console input and output protocols, its runtime
    \\/// services and its boot services.
    \\const CONSOLE_IN: u64 = 48
    \\
    \\const CONSOLE_OUT: u64 = 64
    \\
    \\const RUNTIME_SERVICES: u64 = 88
    \\
    \\const BOOT_SERVICES: u64 = 96
    \\
    \\/// The offsets in the boot services of the functions the platform calls.
    \\const ALLOCATE_PAGES: u64 = 40
    \\
    \\const FREE_PAGES: u64 = 48
    \\
    \\const GET_MEMORY_MAP: u64 = 56
    \\
    \\const CREATE_EVENT: u64 = 80
    \\
    \\const SET_TIMER: u64 = 88
    \\
    \\const WAIT_FOR_EVENT: u64 = 96
    \\
    \\const CLOSE_EVENT: u64 = 112
    \\
    \\const HANDLE_PROTOCOL: u64 = 152
    \\
    \\const EXIT_BOOT_SERVICES: u64 = 232
    \\
    \\const LOCATE_PROTOCOL: u64 = 320
    \\
    \\/// The offsets in the runtime services of `GetVariable` and `SetVariable`.
    \\const VARIABLE_GET: u64 = 72
    \\
    \\const VARIABLE_SET: u64 = 88
    \\
    \\/// The bit marking an error status, and the error statuses the platform tells apart.
    \\const ERROR: u64 = 0x8000_0000_0000_0000
    \\
    \\const INVALID_PARAMETER: u64 = 0x8000_0000_0000_0002
    \\
    \\const UNSUPPORTED: u64 = 0x8000_0000_0000_0003
    \\
    \\const BAD_BUFFER_SIZE: u64 = 0x8000_0000_0000_0004
    \\
    \\const BUFFER_TOO_SMALL: u64 = 0x8000_0000_0000_0005
    \\
    \\const NOT_READY: u64 = 0x8000_0000_0000_0006
    \\
    \\const WRITE_PROTECTED: u64 = 0x8000_0000_0000_0008
    \\
    \\const OUT_OF_RESOURCES: u64 = 0x8000_0000_0000_0009
    \\
    \\const NOT_FOUND: u64 = 0x8000_0000_0000_000E
    \\
    \\const ACCESS_DENIED: u64 = 0x8000_0000_0000_000F
    \\
    \\const SECURITY_VIOLATION: u64 = 0x8000_0000_0000_001A
    \\
    \\/// The most UTF-16 code units of a path or variable name, its NUL excluded.
    \\const NAME_LIMIT: usize = 255
    \\
    \\/// A GUID as the firmware lays it out.
    \\layout EfiGuid: bytes 16 le {
    \\    data1: u32 at 0
    \\    data2: u16 at 4
    \\    data3: u16 at 6
    \\    data4: GuidTail at 8
    \\} EfiGuid
    \\
    \\/// The last 8 bytes of a GUID, in the order its text writes them.
    \\layout GuidTail: bytes 8 be {
    \\    value: u64 at 0
    \\} GuidTail
    \\
    \\/// Calls the firmware function at an address with five arguments, under the firmware's
    \\/// calling convention on the boot stack, and gives its result; a function taking fewer
    \\/// arguments ignores the others.
    \\pkg fn call(function: u64, a: u64, b: u64, c: u64, d: u64, e: u64) -> u64
    \\
    \\/// The system table and the image handle the firmware entered the image with.
    \\pkg fn system_table() -> u64
    \\
    \\pkg fn image_handle() -> u64
    \\
    \\/// The word at an address of the firmware's tables.
    \\fn word(at: u64) -> u64 {
    \\    return trusted "the firmware's tables lie in memory it maps, aligned, and change only through its calls" { hw::Ptr[u64].of_addr(usize.widen(at)).read() }
    \\} word
    \\
    \\/// The byte at an address the firmware wrote.
    \\fn byte_at(at: u64) -> u8 {
    \\    return trusted "the firmware wrote that byte" { hw::Ptr[u8].of_addr(usize.widen(at)).read() }
    \\} byte_at
    \\
    \\/// The function at an offset of the boot services and of the runtime services.
    \\fn boot_service(offset: u64) -> u64 {
    \\    return word(word(system_table() + BOOT_SERVICES) + offset)
    \\} boot_service
    \\
    \\fn runtime_service(offset: u64) -> u64 {
    \\    return word(word(system_table() + RUNTIME_SERVICES) + offset)
    \\} runtime_service
    \\
    \\/// The address of the first element of a view the firmware reads.
    \\fn src(items: Slice[u8]) -> u64 = u64.widen(hw::Ptr.of_view(items).addr())
    \\
    \\fn src_units(items: Slice[u16]) -> u64 = u64.widen(hw::Ptr.of_view(items).addr())
    \\
    \\/// The address of the first element of a view the firmware writes.
    \\fn dst(mut items: SliceMut[u8]) -> u64 = u64.widen(hw::Ptr.of_view_mut(mut items).addr())
    \\
    \\fn dst_words(mut items: SliceMut[u64]) -> u64 = u64.widen(hw::Ptr.of_view_mut(mut items).addr())
    \\
    \\fn dst_units(mut items: SliceMut[u16]) -> u64 = u64.widen(hw::Ptr.of_view_mut(mut items).addr())
    \\
    \\/// Fails with the error a status names when it is an error: `NotFound` for `EFI_NOT_FOUND`,
    \\/// `OutOfMemory` for `EFI_OUT_OF_RESOURCES`, `Denied` for `EFI_ACCESS_DENIED`,
    \\/// `EFI_WRITE_PROTECTED` and `EFI_SECURITY_VIOLATION`, `Unsupported` for `EFI_UNSUPPORTED`,
    \\/// `Invalid` for `EFI_INVALID_PARAMETER` and `EFI_BAD_BUFFER_SIZE`, and `DeviceError` for any
    \\/// other.
    \\fn success(status: u64) fails boot::ServiceError {
    \\    if (status & ERROR) == 0 {
    \\        return
    \\    }
    \\    fail failure(status)
    \\} success
    \\
    \\fn failure(status: u64) -> boot::ServiceError {
    \\    return match status {
    \\        NOT_FOUND => boot::ServiceError.NotFound
    \\        OUT_OF_RESOURCES => boot::ServiceError.OutOfMemory
    \\        ACCESS_DENIED or WRITE_PROTECTED or SECURITY_VIOLATION => boot::ServiceError.Denied
    \\        UNSUPPORTED => boot::ServiceError.Unsupported
    \\        INVALID_PARAMETER or BAD_BUFFER_SIZE => boot::ServiceError.Invalid
    \\        else => boot::ServiceError.DeviceError
    \\    }
    \\} failure
    \\
    \\/// A GUID in the firmware's layout.
    \\fn guid_bits(guid: boot::Guid) -> Array[u8, 16] {
    \\    return EfiGuid(data1: guid.data1, data2: guid.data2, data3: guid.data3, data4: GuidTail(value: guid.data4)).to_bits()
    \\} guid_bits
    \\
    \\/// The GUID the firmware laid out at an address.
    \\fn guid_at(at: u64) -> boot::Guid {
    \\    var tail: u64 = 0
    \\    for index in 8u64..<16 {
    \\        tail = (tail << 8) | u64.widen(byte_at(at + index))
    \\    }
    \\    return boot::Guid(data1: u32.fit(bytes_at(at, count: 4)), data2: u16.fit(bytes_at(at + 4, count: 2)), data3: u16.fit(bytes_at(at + 6, count: 2)), data4: tail)
    \\} guid_at
    \\
    \\/// The interface of the one protocol with a GUID the firmware locates, failing with
    \\/// `Unsupported` when it has none.
    \\fn protocol(guid: boot::Guid) -> u64 fails boot::ServiceError {
    \\    let bits = guid_bits(guid)
    \\    var found = Array[u64, 1].filled(0)
    \\    let status = call(boot_service(LOCATE_PROTOCOL), a: src(bits.view()), b: 0, c: dst_words(mut found.view_mut()), d: 0, e: 0)
    \\    if status == NOT_FOUND {
    \\        fail boot::ServiceError.Unsupported
    \\    }
    \\    try success(status)
    \\    return found[0]
    \\} protocol
    \\
    \\/// The interface of a protocol with a GUID on a handle.
    \\fn on_handle(handle: u64, guid: boot::Guid) -> u64 fails boot::ServiceError {
    \\    let bits = guid_bits(guid)
    \\    var found = Array[u64, 1].filled(0)
    \\    let status = call(boot_service(HANDLE_PROTOCOL), a: handle, b: src(bits.view()), c: dst_words(mut found.view_mut()), d: 0, e: 0)
    \\    try success(status)
    \\    return found[0]
    \\} on_handle
    \\
    \\/// The loaded image protocol of the image.
    \\fn loaded_image() -> u64 fails boot::ServiceError {
    \\    return try on_handle(image_handle(), guid: boot::Guid(data1: 0x5B1B_31A1, data2: 0x9562, data3: 0x11D2, data4: 0x8E3F_00A0_C969_723B))
    \\} loaded_image
    \\
    \\/// Writes `text` into `units` as NUL-terminated UTF-16, each `/` as `\\` when `path` holds,
    \\/// failing with `Invalid` when it holds more than `NAME_LIMIT` code units.
    \\fn wide(text: Str, path: bool, mut units: Array[u16, 256]) fails boot::ServiceError {
    \\    var at: usize = 0
    \\    for c in text {
    \\        var point = c.to_bits()
    \\        if path and point == 0x2F {
    \\            point = 0x5C
    \\        }
    \\        if point >= 0x1_0000 {
    \\            if at + 2 > NAME_LIMIT {
    \\                fail boot::ServiceError.Invalid
    \\            }
    \\            let offset = point - 0x1_0000
    \\            units[at] = u16.fit(0xD800 + (offset >> 10))
    \\            units[at + 1] = u16.fit(0xDC00 + (offset & 0x3FF))
    \\            at += 2
    \\        } else {
    \\            if at + 1 > NAME_LIMIT {
    \\                fail boot::ServiceError.Invalid
    \\            }
    \\            units[at] = u16.fit(point)
    \\            at += 1
    \\        }
    \\    }
    \\    units[at] = 0
    \\} wide
    \\
    \\/// The little-endian number of `count` bytes at an address, which need not be aligned.
    \\fn bytes_at(at: u64, count: u64) -> u64 {
    \\    var value: u64 = 0
    \\    for index in 0..<count {
    \\        value = value | (u64.widen(byte_at(at + index)) << u32.fit(index * 8))
    \\    }
    \\    return value
    \\} bytes_at
    \\
    \\/// Appends the UTF-8 encoding of the UTF-16 text at an address, of at most `limit` code units
    \\/// and ending at a NUL, to `out`, each unpaired surrogate as U+FFFD; for a path, each `\\` as `/`
    \\/// with the leading ones left out. Fails with `OutOfMemory` when `out` cannot grow.
    \\fn narrow(at: u64, limit: u64, path: bool, mut out: mem::Bytes) fails boot::ServiceError {
    \\    var next = at
    \\    let end = at + limit * 2
    \\    while next < end {
    \\        let unit = u32.fit(bytes_at(next, count: 2))
    \\        if unit == 0 {
    \\            return
    \\        }
    \\        next += 2
    \\        var point = unit
    \\        if unit >= 0xD800 and unit < 0xDC00 and next < end {
    \\            let low = u32.fit(bytes_at(next, count: 2))
    \\            if low >= 0xDC00 and low < 0xE000 {
    \\                point = 0x1_0000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
    \\                next += 2
    \\            }
    \\        }
    \\        if path and point == 0x5C {
    \\            point = 0x2F
    \\        }
    \\        if not (path and point == 0x2F and out.len() == 0) {
    \\            try push_char(point, mut out)
    \\        }
    \\    }
    \\} narrow
    \\
    \\/// Appends the UTF-8 encoding of a code point to `out`, U+FFFD for a surrogate.
    \\fn push_char(point: u32, mut out: mem::Bytes) fails boot::ServiceError {
    \\    let Some(c) = char.checked_from_bits(point) else {
    \\        try grown(mut out, bytes: "\\u{FFFD}".as_bytes())
    \\        return
    \\    }
    \\    var encoded = Array[u8, 4].filled(0)
    \\    let len = c.utf8_len()
    \\    var rest = point
    \\    for index in 0..<len {
    \\        let at = len - 1 - index
    \\        encoded[at] = u8.fit(0x80 | (rest & 0x3F))
    \\        rest = rest >> 6
    \\    }
    \\    let lead = match len {
    \\        1 => 0u8
    \\        2 => 0xC0u8
    \\        3 => 0xE0u8
    \\        else => 0xF0u8
    \\    }
    \\    if len > 1 {
    \\        encoded[0] = (encoded[0] & 0x3F) | lead
    \\    } else {
    \\        encoded[0] = u8.fit(point)
    \\    }
    \\    let Some(bytes) = encoded.view().prefix(len) else {
    \\        return
    \\    }
    \\    try grown(mut out, bytes)
    \\} push_char
    \\
    \\/// Appends bytes to `out`, failing with `OutOfMemory` when it cannot grow.
    \\fn grown(mut out: mem::Bytes, bytes: Slice[u8]) fails boot::ServiceError {
    \\    let Ok(_) = attempt mut out.try_append(bytes) else {
    \\        fail boot::ServiceError.OutOfMemory
    \\    }
    \\} grown
    \\
    \\/// The `len` bytes at an address, drawn through `alloc`, failing with `OutOfMemory` when it
    \\/// cannot hold them.
    \\fn drawn(at: u64, len: u64, alloc: mem::Alloc) -> mem::Bytes fails boot::ServiceError {
    \\    var bytes = try zeroed(len, alloc)
    \\    let count = bytes.len()
    \\    let to = hw::Ptr.of_view_mut(mut bytes.view_mut())
    \\    trusted "the firmware gave `len` bytes at `at`, and `to` holds as many" {
    \\        hw::Ptr[u8].of_addr(usize.widen(at)).copy(to, count)
    \\    }
    \\    return bytes
    \\} drawn
    \\
    \\/// `len` zero bytes drawn through `alloc`, failing with `OutOfMemory` when it cannot hold them.
    \\fn zeroed(len: u64, alloc: mem::Alloc) -> mem::Bytes fails boot::ServiceError {
    \\    let Ok(bytes) = attempt mem::Bytes.try_zeroed(usize.widen(len), alloc) else {
    \\        fail boot::ServiceError.OutOfMemory
    \\    }
    \\    return bytes
    \\} zeroed
    \\

const TEXT_UEFI_PLATFORM_HANDOFF: Str =
    \\//! The hand-off to a loaded bare image: its start information, the end of boot services, the jump.
    \\
    \\/// The start information's magic number and version, its size, and the offsets of its module
    \\/// count, module list, command line, RSDP, memory map and memory map entry count.
    \\const START_MAGIC: u32 = 0x336E_C578
    \\
    \\const START_VERSION: u32 = 1
    \\
    \\const INFO_BYTES: u64 = 64
    \\
    \\const INFO_MODULES: u64 = 12
    \\
    \\const INFO_MODULE_LIST: u64 = 16
    \\
    \\const INFO_COMMAND_LINE: u64 = 24
    \\
    \\const INFO_RSDP: u64 = 32
    \\
    \\const INFO_MAP: u64 = 40
    \\
    \\const INFO_MAP_ENTRIES: u64 = 48
    \\
    \\/// The bytes of a module list entry and of a memory map entry, and the entries of slack the map
    \\/// holds for those the firmware's map gains before boot services end.
    \\const MODULE_BYTES: u64 = 32
    \\
    \\const ENTRY_BYTES: u64 = 24
    \\
    \\const MAP_SLACK: u64 = 64
    \\
    \\/// The allocation type of pages below a highest address, the highest address of the hand-off
    \\/// pages, and their memory type.
    \\const ALLOCATE_MAX_ADDRESS: u64 = 1
    \\
    \\const HIGHEST: u64 = 0xFFFF_FFFF
    \\
    \\const HANDOFF_DATA: u64 = 2
    \\
    \\/// The start information's memory types: usable, reserved, ACPI reclaimable, ACPI NVS and
    \\/// unusable.
    \\const USABLE: u32 = 1
    \\
    \\const RESERVED: u32 = 2
    \\
    \\const ACPI_RECLAIMABLE: u32 = 3
    \\
    \\const ACPI_NVS: u32 = 4
    \\
    \\const UNUSABLE: u32 = 5
    \\
    \\const ACPI_20: boot::Guid = boot::Guid(data1: 0x8868_E871, data2: 0xE4F1, data3: 0x11D3, data4: 0xBC22_0080_C73C_8881)
    \\
    \\const ACPI_10: boot::Guid = boot::Guid(data1: 0xEB9D_2D30, data2: 0x2D88, data3: 0x11D3, data4: 0x9A16_0090_273F_C14D)
    \\
    \\const DEVICE_TREE: boot::Guid = boot::Guid(data1: 0xB1B6_21D5, data2: 0xF19C, data3: 0x41A5, data4: 0x830B_D915_2C69_AAE0)
    \\
    \\/// Copies the Untrusted bytes to a physical address, without reading them otherwise.
    \\pkg fn place(contents: Untrusted[Slice[u8]], at: u64)
    \\
    \\/// Makes the data caches hold no line of a range that memory does not, on AArch64; nothing on
    \\/// x86_64, whose caches memory sees.
    \\pkg fn clean(base: u64, byte_len: u64)
    \\
    \\/// Enters a loaded bare image at `entry` by its target's boot protocol, the start information
    \\/// at `info` and the device tree at `tree`, zero for none, using the page at `trampoline`
    \\/// below 4 GiB on x86_64.
    \\pkg fn jump(entry: u64, info: u64, tree: u64, trampoline: u64) -> Never
    \\
    \\/// Traps with `trap.exhausted`.
    \\pkg fn exhausted() -> Never
    \\
    \\/// The address of the table the configuration table lists under a GUID, zero when none.
    \\fn configured(guid: boot::Guid) -> u64 {
    \\    let table = system_table()
    \\    let count = word(table + 104)
    \\    let entries = word(table + 112)
    \\    let wanted = guid_bits(guid)
    \\    for index in 0..<count {
    \\        let entry = entries + index * 24
    \\        if word(entry) == u64_le(wanted.view(), at: 0) and word(entry + 8) == u64_le(wanted.view(), at: 8) {
    \\            return word(entry + 16)
    \\        }
    \\    }
    \\    return 0
    \\} configured
    \\
    \\fn u64_le(bytes: Slice[u8], at: usize) -> u64 {
    \\    if at > bytes.len() or bytes.len() - at < 8 {
    \\        return 0
    \\    }
    \\    return bytes.u64_le(at)
    \\} u64_le
    \\
    \\/// A 32-bit number read little-endian, as its big-endian bytes give it.
    \\fn big_endian(raw: u64) -> u64 {
    \\    var value: u64 = 0
    \\    for index in 0u64..<4 {
    \\        value = (value << 8) | ((raw >> u32.fit(index * 8)) & 0xFF)
    \\    }
    \\    return value
    \\} big_endian
    \\
    \\/// The bytes of whole pages holding `bytes`.
    \\fn whole_pages(bytes: u64) -> u64 {
    \\    return (bytes + PAGE - 1) / PAGE * PAGE
    \\} whole_pages
    \\
    \\/// Writes a value at an address of the hand-off pages.
    \\fn put32(at: u64, value: u32) {
    \\    trusted "the hand-off pages are the image's, mapped and aligned for the value" { hw::Ptr[u32].of_addr(usize.widen(at)).write(value) }
    \\} put32
    \\
    \\fn put64(at: u64, value: u64) {
    \\    trusted "the hand-off pages are the image's, mapped and aligned for the value" { hw::Ptr[u64].of_addr(usize.widen(at)).write(value) }
    \\} put64
    \\
    \\/// Writes bytes and a NUL at an address of the hand-off pages, giving the address past them.
    \\fn put_text(at: u64, bytes: Slice[u8]) -> u64 {
    \\    let len = bytes.len()
    \\    trusted "the hand-off pages are the image's and hold the bytes and their NUL" {
    \\        hw::Ptr.of_view(bytes).copy(hw::Ptr[u8].of_addr(usize.widen(at)), count: len)
    \\        hw::Ptr[u8].of_addr(usize.widen(at)).offset(isize.fit(len)).write(0)
    \\    }
    \\    return at + u64.widen(len) + 1
    \\} put_text
    \\
    \\/// The start information's type of a firmware memory type: usable for conventional memory,
    \\/// boot services' code and data and the loader's, the ACPI types and unusable memory as
    \\/// themselves, reserved for any other.
    \\fn start_type(kind: u32) -> u32 {
    \\    return match kind {
    \\        1 or 2 or 3 or 4 or 7 => USABLE
    \\        8 => UNUSABLE
    \\        9 => ACPI_RECLAIMABLE
    \\        10 => ACPI_NVS
    \\        else => RESERVED
    \\    }
    \\} start_type
    \\
    \\pkg fn hand_off(alloc: mem::Alloc, take image: boot::Image) -> Never
    \\    waive length "the hand-off lays out, fills and enters in one sequence, which ends boot services in its middle"
    \\{
    \\    let boot::Image(entry: entry, segments: segments, modules: modules, command_line: command_line) = image
    \\    var rsdp = configured(ACPI_20)
    \\    if rsdp == 0 {
    \\        rsdp = configured(ACPI_10)
    \\    }
    \\    let tree = configured(DEVICE_TREE)
    \\    var tree_len: u64 = 0
    \\    if tree != 0 {
    \\        tree_len = big_endian(bytes_at(tree + 4, count: 4))
    \\    }
    \\    var map = Map(bytes: mem::Bytes.empty(alloc), size: 0, stride: 0, key: 0)
    \\    let Ok(_) = attempt read_map(mut map, alloc) else {
    \\        exhausted()
    \\    }
    \\    let capacity = map.size / map.stride + MAP_SLACK
    \\    let count = u64.widen(modules.len())
    \\    let list_at = PAGE + INFO_BYTES
    \\    let map_at = list_at + count * MODULE_BYTES
    \\    let text_at = map_at + capacity * ENTRY_BYTES
    \\    var names = u64.widen(command_line.len()) + 1
    \\    var contents: u64 = 0
    \\    for module in modules {
    \\        names += u64.widen(module.name.len()) + 1
    \\        contents += whole_pages(u64.widen(module.contents.byte_len()))
    \\    }
    \\    let contents_at = whole_pages(text_at + names)
    \\    let tree_at = contents_at + contents
    \\    let total = tree_at + whole_pages(tree_len)
    \\    var found = Array[u64, 1].filled(HIGHEST)
    \\    let allocated = call(boot_service(ALLOCATE_PAGES), a: ALLOCATE_MAX_ADDRESS, b: HANDOFF_DATA, c: total / PAGE, d: dst_words(mut found.view_mut()), e: 0)
    \\    if allocated != 0 {
    \\        exhausted()
    \\    }
    \\    let base = found[0]
    \\    let info = base + PAGE
    \\    put32(info, value: START_MAGIC)
    \\    put32(info + 4, value: START_VERSION)
    \\    put32(info + INFO_MODULES, value: u32.fit(count))
    \\    put64(info + INFO_MODULE_LIST, value: base + list_at)
    \\    put64(info + INFO_COMMAND_LINE, value: base + text_at)
    \\    put64(info + INFO_RSDP, value: rsdp)
    \\    put64(info + INFO_MAP, value: base + map_at)
    \\    var name_at = put_text(base + text_at, bytes: command_line.view())
    \\    var content_at = base + contents_at
    \\    var listed = base + list_at
    \\    for module in modules {
    \\        let len = u64.widen(module.contents.byte_len())
    \\        put64(listed, value: content_at)
    \\        put64(listed + 8, value: len)
    \\        put64(listed + 16, value: name_at)
    \\        put64(listed + 24, value: 0)
    \\        name_at = put_text(name_at, bytes: module.name.view())
    \\        place(module.contents.view(), at: content_at)
    \\        content_at += whole_pages(len)
    \\        listed += MODULE_BYTES
    \\    }
    \\    var tree_copy: u64 = 0
    \\    if tree != 0 {
    \\        tree_copy = base + tree_at
    \\        trusted "the firmware's device tree holds `tree_len` bytes, and the hand-off pages as many from `tree_copy`" {
    \\            hw::Ptr[u8].of_addr(usize.widen(tree)).copy(hw::Ptr[u8].of_addr(usize.widen(tree_copy)), count: usize.widen(tree_len))
    \\        }
    \\    }
    \\    loop {
    \\        let Ok(_) = attempt read_map(mut map, alloc) else {
    \\            exhausted()
    \\        }
    \\        if call(boot_service(EXIT_BOOT_SERVICES), a: image_handle(), b: map.key, c: 0, d: 0, e: 0) == 0 {
    \\            break
    \\        }
    \\    }
    \\    var entries: u64 = 0
    \\    for index in 0..<(map.size / map.stride) {
    \\        if entries < capacity {
    \\            let described = range(map, index)
    \\            let at = base + map_at + entries * ENTRY_BYTES
    \\            put64(at, value: described.base)
    \\            put64(at + 8, value: described.byte_len)
    \\            put32(at + 16, value: start_type(described.kind))
    \\            put32(at + 20, value: 0)
    \\            entries += 1
    \\        }
    \\    }
    \\    put32(info + INFO_MAP_ENTRIES, value: u32.fit(entries))
    \\    clean(base, byte_len: total)
    \\    for segment in segments {
    \\        clean(segment.base(), byte_len: segment.byte_len())
    \\    }
    \\    jump(entry, info, tree: tree_copy, trampoline: base)
    \\} hand_off
    \\

const TEXT_UEFI_PLATFORM_MEMORY: Str =
    \\//! The firmware's memory map and its page allocations.
    \\
    \\/// The offsets in a memory descriptor of its type, its physical start, its page count and its
    \\/// attributes, and the least size of one.
    \\const DESCRIPTOR_TYPE: usize = 0
    \\
    \\const DESCRIPTOR_START: usize = 8
    \\
    \\const DESCRIPTOR_PAGES: usize = 24
    \\
    \\const DESCRIPTOR_ATTRIBUTES: usize = 32
    \\
    \\const DESCRIPTOR_BYTES: u64 = 40
    \\
    \\/// The bytes of a page, the descriptors of slack a map buffer holds for those the firmware adds
    \\/// before the map is read into it, and the allocation type and memory type of `allocate`.
    \\const PAGE: u64 = 4_096
    \\
    \\const DESCRIPTOR_SLACK: u64 = 8
    \\
    \\const ALLOCATE_ADDRESS: u64 = 2
    \\
    \\const LOADER_DATA: u64 = 2
    \\
    \\/// A memory map the firmware gave: its descriptors, their bytes and stride, and the key ending
    \\/// boot services with it.
    \\struct Map {
    \\    bytes: mem::Bytes
    \\    size: u64
    \\    stride: u64
    \\    key: u64
    \\} Map
    \\
    \\/// The region from `base` of `byte_len` bytes.
    \\pkg fn region(base: u64, byte_len: u64) -> hw::Region
    \\
    \\/// Reads the firmware's memory map into `map`, growing its buffer while the map does not fit.
    \\fn read_map(mut map: Map, alloc: mem::Alloc) fails boot::ServiceError {
    \\    loop {
    \\        var words = Array[u64, 4].filled(0)
    \\        words[0] = u64.widen(map.bytes.len())
    \\        let at = dst_words(mut words.view_mut())
    \\        let status = call(boot_service(GET_MEMORY_MAP), a: at, b: dst(mut map.bytes.view_mut()), c: at + 8, d: at + 16, e: at + 24)
    \\        if status != BUFFER_TOO_SMALL {
    \\            try success(status)
    \\            if words[2] < DESCRIPTOR_BYTES {
    \\                fail boot::ServiceError.DeviceError
    \\            }
    \\            map.size = words[0]
    \\            map.key = words[1]
    \\            map.stride = words[2]
    \\            return
    \\        }
    \\        map.bytes = try zeroed(words[0] + DESCRIPTOR_SLACK * words[2], alloc)
    \\    }
    \\} read_map
    \\
    \\/// The descriptor at `index` of a memory map, as a range.
    \\fn range(map: Map, index: u64) -> boot::MemoryRange {
    \\    let at = usize.widen(index * map.stride)
    \\    let entry = map.bytes.view()
    \\    let pages = entry.u64_le(at + DESCRIPTOR_PAGES)
    \\    return boot::MemoryRange(base: entry.u64_le(at + DESCRIPTOR_START), byte_len: pages.saturating_mul(PAGE), kind: entry.u32_le(at + DESCRIPTOR_TYPE), attributes: entry.u64_le(at + DESCRIPTOR_ATTRIBUTES))
    \\} range
    \\
    \\pkg fn memory_map(alloc: mem::Alloc) -> mem::List[boot::MemoryRange] fails boot::ServiceError {
    \\    var map = Map(bytes: mem::Bytes.empty(alloc), size: 0, stride: 0, key: 0)
    \\    try read_map(mut map, alloc)
    \\    var ranges = mem::List[boot::MemoryRange].empty(alloc)
    \\    for index in 0..<(map.size / map.stride) {
    \\        let Ok(_) = attempt mut ranges.try_push(range(map, index)) else {
    \\            fail boot::ServiceError.OutOfMemory
    \\        }
    \\    }
    \\    return ranges
    \\} memory_map
    \\
    \\pkg fn free(base: u64, byte_len: u64) fails boot::ServiceError {
    \\    try success(call(boot_service(FREE_PAGES), a: base, b: (byte_len + PAGE - 1) / PAGE, c: 0, d: 0, e: 0))
    \\} free
    \\
    \\pkg fn allocate(base: u64, byte_len: u64) -> hw::Region fails boot::ServiceError {
    \\    if base % PAGE != 0 or byte_len == 0 or byte_len > ~0u64 - PAGE {
    \\        fail boot::ServiceError.Invalid
    \\    }
    \\    let pages = (byte_len + PAGE - 1) / PAGE
    \\    var at = Array[u64, 1].filled(base)
    \\    try success(call(boot_service(ALLOCATE_PAGES), a: ALLOCATE_ADDRESS, b: LOADER_DATA, c: pages, d: dst_words(mut at.view_mut()), e: 0))
    \\    return region(at[0], byte_len: pages * PAGE)
    \\} allocate
    \\

const TEXT_UEFI_PLATFORM_PACKAGE: Str =
    \\//! The platform of the UEFI targets: the machine root grant, firmware services and the hand-off to a bare image.
    \\
    \\package uefi_platform {
    \\    language 1
    \\    targets aarch64-uefi, x86_64-uefi
    \\    allow priv in uefi_platform
    \\} uefi_platform
    \\

const TEXT_UEFI_PLATFORM_TPM: Str =
    \\//! The TPM through the firmware's TCG2_PROTOCOL protocol, and its entropy through the RNG_PROTOCOL protocol.
    \\
    \\/// The offsets in the TCG2_PROTOCOL protocol of `GetEventLog`, `HashLogExtendEvent` and `SubmitCommand`,
    \\/// and in the RNG_PROTOCOL protocol of `GetRNG`.
    \\const GET_CAPABILITY: u64 = 0
    \\
    \\const GET_EVENT_LOG: u64 = 8
    \\
    \\const HASH_LOG_EXTEND_EVENT: u64 = 16
    \\
    \\const SUBMIT_COMMAND: u64 = 24
    \\
    \\const GET_RNG: u64 = 8
    \\
    \\/// The event log format of crypto-agile logs.
    \\const CRYPTO_AGILE: u64 = 2
    \\
    \\/// The most bytes of an event `measure` records, and the bytes heading it: the event's size,
    \\/// then its header's size, version, PCR and type.
    \\const EVENT_LIMIT: usize = 1_024
    \\
    \\const EVENT_HEAD: usize = 18
    \\
    \\/// The size of the TCG2 protocol's capability record, and the offset in it of the most bytes of
    \\/// a TPM response.
    \\const CAPABILITY_BYTES: u8 = 36
    \\
    \\const MAX_RESPONSE: u64 = 20
    \\
    \\/// The bytes of the first entry of a crypto-agile log before its event data, and of a later
    \\/// entry before its digests.
    \\const FIRST_HEAD: u64 = 32
    \\
    \\const ENTRY_HEAD: u64 = 12
    \\
    \\const TCG2_PROTOCOL: boot::Guid = boot::Guid(data1: 0x607F_766C, data2: 0x7455, data3: 0x42BE, data4: 0x930B_E4D7_6DB2_720F)
    \\
    \\const RNG_PROTOCOL: boot::Guid = boot::Guid(data1: 0x3152_BCA5, data2: 0xEADE, data3: 0x433D, data4: 0x862E_C01C_DC29_1F44)
    \\
    \\pkg fn measure(pcr: u32, event_type: u32, data: Slice[u8], event: Slice[u8]) fails boot::ServiceError {
    \\    if event.len() > EVENT_LIMIT {
    \\        fail boot::ServiceError.Invalid
    \\    }
    \\    let tcg = try protocol(TCG2_PROTOCOL)
    \\    var record = Array[u8, 1_042].filled(0)
    \\    var head = mut record.view_mut()
    \\    mut head.write_u32_le(0, value: u32.fit(EVENT_HEAD + event.len()))
    \\    mut head.write_u32_le(4, value: 14)
    \\    mut head.write_u16_le(8, value: 1)
    \\    mut head.write_u32_le(10, value: pcr)
    \\    mut head.write_u32_le(14, value: event_type)
    \\    for index in 0..<event.len() {
    \\        head[EVENT_HEAD + index] = event[index]
    \\    }
    \\    try success(call(word(tcg + HASH_LOG_EXTEND_EVENT), a: tcg, b: 0, c: src(data), d: u64.widen(data.len()), e: src(record.view())))
    \\} measure
    \\
    \\pkg fn event_log(alloc: mem::Alloc) -> boot::EventLog fails boot::ServiceError {
    \\    let tcg = try protocol(TCG2_PROTOCOL)
    \\    var found = Array[u64, 3].filled(0)
    \\    let location = dst_words(mut found.view_mut())
    \\    try success(call(word(tcg + GET_EVENT_LOG), a: tcg, b: CRYPTO_AGILE, c: location, d: location + 8, e: location + 16))
    \\    let start = found[0]
    \\    let last = found[1]
    \\    let truncated = (found[2] & 0xFF) != 0
    \\    if start == 0 {
    \\        return boot::EventLog(bytes: Untrusted.of(mem::Bytes.empty(alloc)), truncated: truncated)
    \\    }
    \\    var end = start + FIRST_HEAD + bytes_at(start + FIRST_HEAD - 4, count: 4)
    \\    if last > start {
    \\        end = try past_entry(last)
    \\    }
    \\    let bytes = try drawn(start, len: end - start, alloc)
    \\    return boot::EventLog(bytes: Untrusted.of(take bytes), truncated: truncated)
    \\} event_log
    \\
    \\/// The address past a crypto-agile entry, whose digests' sizes their algorithms fix: SHA-1,
    \\/// SHA-256, SHA-384, SHA-512 and SM3-256. Fails with `Unsupported` for another algorithm.
    \\fn past_entry(entry: u64) -> u64 fails boot::ServiceError {
    \\    let count = bytes_at(entry + 8, count: 4)
    \\    var at = entry + ENTRY_HEAD
    \\    for _ in 0..<count {
    \\        let size = match bytes_at(at, count: 2) {
    \\            0x4 => 20u64
    \\            0xB or 0x12 => 32u64
    \\            0xC => 48u64
    \\            0xD => 64u64
    \\            else => 0u64
    \\        }
    \\        if size == 0 {
    \\            fail boot::ServiceError.Unsupported
    \\        }
    \\        at += 2 + size
    \\    }
    \\    return at + 4 + bytes_at(at, count: 4)
    \\} past_entry
    \\
    \\pkg fn submit_tpm(command: Slice[u8], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails boot::ServiceError {
    \\    let tcg = try protocol(TCG2_PROTOCOL)
    \\    var capability = Array[u8, 36].filled(0)
    \\    capability[0] = CAPABILITY_BYTES
    \\    let record = dst(mut capability.view_mut())
    \\    try success(call(word(tcg + GET_CAPABILITY), a: tcg, b: record, c: 0, d: 0, e: 0))
    \\    let limit = bytes_at(record + MAX_RESPONSE, count: 2)
    \\    var response = try zeroed(limit, alloc)
    \\    try success(call(word(tcg + SUBMIT_COMMAND), a: tcg, b: u64.widen(command.len()), c: src(command), d: limit, e: dst(mut response.view_mut())))
    \\    var stated: u64 = 0
    \\    if response.len() >= 6 {
    \\        stated = u64.widen(response.view().u32_be(2))
    \\    }
    \\    if stated > limit {
    \\        stated = limit
    \\    }
    \\    mut response.truncate(usize.widen(stated))
    \\    return Untrusted.of(take response)
    \\} submit_tpm
    \\
    \\pkg fn random(mut buf: SliceMut[u8]) fails boot::ServiceError {
    \\    if buf.is_empty() {
    \\        return
    \\    }
    \\    let rng = try protocol(RNG_PROTOCOL)
    \\    let len = u64.widen(buf.len())
    \\    try success(call(word(rng + GET_RNG), a: rng, b: 0, c: len, d: dst(mut buf), e: 0))
    \\} random
    \\

const TEXT_UEFI_PLATFORM_UEFI_PLATFORM: Str =
    \\//! The UEFI entry landing fn, which mints the machine root grant, the firmware services over the firmware's calls, the hand-off to a bare image, and kernel task preemption.
    \\
    \\/// The UEFI entry landing fn: mints the machine root grant, which the image handle and system
    \\/// table the seam records stand behind.
    \\pub landing fn enter(image: hw::Ptr[u8], table: hw::Ptr[u8]) -> boot::Machine limits stack 4_096 {
    \\    discard image
    \\    discard table
    \\    return hw::mint_root()
    \\} enter
    \\
    \\/// Makes the preempted task ready again and switches its CPU to the next ready task, returning
    \\/// once a later switch resumes it.
    \\landing fn preempted() limits stack 1_024 {
    \\    yield_task()
    \\} preempted
    \\
    \\/// Switches the CPU from the running kernel task, ready again, to its next ready task.
    \\pkg fn yield_task()
    \\
    \\contribute hw::preempt preempt = hw::PreemptEntry(slot: Unit, handler: preempted)
    \\

const TEXT_UEFI_PLATFORM_VARIABLES: Str =
    \\//! The firmware's variables.
    \\
    \\pkg fn get_variable(name: Str, vendor: boot::Guid, alloc: mem::Alloc) -> boot::Variable fails boot::ServiceError {
    \\    var units = Array[u16, 256].filled(0)
    \\    try wide(name, path: false, mut units)
    \\    let kind = guid_bits(vendor)
    \\    var attributes = Array[u64, 1].filled(0)
    \\    var size = Array[u64, 1].filled(0)
    \\    var data = mem::Bytes.empty(alloc)
    \\    loop {
    \\        let status = call(runtime_service(VARIABLE_GET), a: src_units(units.view()), b: src(kind.view()), c: dst_words(mut attributes.view_mut()), d: dst_words(mut size.view_mut()), e: dst(mut data.view_mut()))
    \\        if status != BUFFER_TOO_SMALL {
    \\            try success(status)
    \\            mut data.truncate(usize.widen(size[0]))
    \\            let bits = u32.truncate(attributes[0])
    \\            return boot::Variable(attributes: boot::VariableAttributes.from_bits(bits), data: Untrusted.of(take data))
    \\        }
    \\        data = try zeroed(size[0], alloc)
    \\    }
    \\} get_variable
    \\
    \\pkg fn set_variable(name: Str, vendor: boot::Guid, attributes: boot::VariableAttributes, data: Slice[u8]) fails boot::ServiceError {
    \\    var units = Array[u16, 256].filled(0)
    \\    try wide(name, path: false, mut units)
    \\    let kind = guid_bits(vendor)
    \\    let bits = u64.widen(attributes.to_bits())
    \\    try success(call(runtime_service(VARIABLE_SET), a: src_units(units.view()), b: src(kind.view()), c: bits, d: u64.widen(data.len()), e: src(data)))
    \\} set_variable
    \\
