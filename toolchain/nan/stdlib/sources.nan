const TEXT_CORE_CRYPTO_TESTS: Str =
    \\//! Signatures against the test vectors of RFC 8032.
    \\
    \\test keys_and_signatures_match_rfc_8032 for SecretKey.sign {
    \\    expect signs(b"\\x9D\\x61\\xB1\\x9D\\xEF\\xFD\\x5A\\x60\\xBA\\x84\\x4A\\xF4\\x92\\xEC\\x2C\\xC4\\x44\\x49\\xC5\\x69\\x7B\\x32\\x69\\x19\\x70\\x3B\\xAC\\x03\\x1C\\xAE\\x7F\\x60", key: b"\\xD7\\x5A\\x98\\x01\\x82\\xB1\\x0A\\xB7\\xD5\\x4B\\xFE\\xD3\\xC9\\x64\\x07\\x3A\\x0E\\xE1\\x72\\xF3\\xDA\\xA6\\x23\\x25\\xAF\\x02\\x1A\\x68\\xF7\\x07\\x51\\x1A", message: b"", signature: b"\\xE5\\x56\\x43\\x00\\xC3\\x60\\xAC\\x72\\x90\\x86\\xE2\\xCC\\x80\\x6E\\x82\\x8A\\x84\\x87\\x7F\\x1E\\xB8\\xE5\\xD9\\x74\\xD8\\x73\\xE0\\x65\\x22\\x49\\x01\\x55\\x5F\\xB8\\x82\\x15\\x90\\xA3\\x3B\\xAC\\xC6\\x1E\\x39\\x70\\x1C\\xF9\\xB4\\x6B\\xD2\\x5B\\xF5\\xF0\\x59\\x5B\\xBE\\x24\\x65\\x51\\x41\\x43\\x8E\\x7A\\x10\\x0B")
    \\    expect signs(b"\\x4C\\xCD\\x08\\x9B\\x28\\xFF\\x96\\xDA\\x9D\\xB6\\xC3\\x46\\xEC\\x11\\x4E\\x0F\\x5B\\x8A\\x31\\x9F\\x35\\xAB\\xA6\\x24\\xDA\\x8C\\xF6\\xED\\x4F\\xB8\\xA6\\xFB", key: b"\\x3D\\x40\\x17\\xC3\\xE8\\x43\\x89\\x5A\\x92\\xB7\\x0A\\xA7\\x4D\\x1B\\x7E\\xBC\\x9C\\x98\\x2C\\xCF\\x2E\\xC4\\x96\\x8C\\xC0\\xCD\\x55\\xF1\\x2A\\xF4\\x66\\x0C", message: b"\\x72", signature: b"\\x92\\xA0\\x09\\xA9\\xF0\\xD4\\xCA\\xB8\\x72\\x0E\\x82\\x0B\\x5F\\x64\\x25\\x40\\xA2\\xB2\\x7B\\x54\\x16\\x50\\x3F\\x8F\\xB3\\x76\\x22\\x23\\xEB\\xDB\\x69\\xDA\\x08\\x5A\\xC1\\xE4\\x3E\\x15\\x99\\x6E\\x45\\x8F\\x36\\x13\\xD0\\xF1\\x1D\\x8C\\x38\\x7B\\x2E\\xAE\\xB4\\x30\\x2A\\xEE\\xB0\\x0D\\x29\\x16\\x12\\xBB\\x0C\\x00")
    \\    expect signs(b"\\xC5\\xAA\\x8D\\xF4\\x3F\\x9F\\x83\\x7B\\xED\\xB7\\x44\\x2F\\x31\\xDC\\xB7\\xB1\\x66\\xD3\\x85\\x35\\x07\\x6F\\x09\\x4B\\x85\\xCE\\x3A\\x2E\\x0B\\x44\\x58\\xF7", key: b"\\xFC\\x51\\xCD\\x8E\\x62\\x18\\xA1\\xA3\\x8D\\xA4\\x7E\\xD0\\x02\\x30\\xF0\\x58\\x08\\x16\\xED\\x13\\xBA\\x33\\x03\\xAC\\x5D\\xEB\\x91\\x15\\x48\\x90\\x80\\x25", message: b"\\xAF\\x82", signature: b"\\x62\\x91\\xD6\\x57\\xDE\\xEC\\x24\\x02\\x48\\x27\\xE6\\x9C\\x3A\\xBE\\x01\\xA3\\x0C\\xE5\\x48\\xA2\\x84\\x74\\x3A\\x44\\x5E\\x36\\x80\\xD7\\xDB\\x5A\\xC3\\xAC\\x18\\xFF\\x9B\\x53\\x8D\\x16\\xF2\\x90\\xAE\\x67\\xF7\\x60\\x98\\x4D\\xC6\\x59\\x4A\\x7C\\x15\\xE9\\x71\\x6E\\xD2\\x8D\\xC0\\x27\\xBE\\xCE\\xEA\\x1E\\xC4\\x0A")
    \\} keys_and_signatures_match_rfc_8032
    \\
    \\test seeds_give_their_rfc_8032_keys for SecretKey.of_seed {
    \\    let secret = SecretKey.of_seed(array32(b"\\x9D\\x61\\xB1\\x9D\\xEF\\xFD\\x5A\\x60\\xBA\\x84\\x4A\\xF4\\x92\\xEC\\x2C\\xC4\\x44\\x49\\xC5\\x69\\x7B\\x32\\x69\\x19\\x70\\x3B\\xAC\\x03\\x1C\\xAE\\x7F\\x60"))
    \\    expect secret.public_key().bytes == array32(b"\\xD7\\x5A\\x98\\x01\\x82\\xB1\\x0A\\xB7\\xD5\\x4B\\xFE\\xD3\\xC9\\x64\\x07\\x3A\\x0E\\xE1\\x72\\xF3\\xDA\\xA6\\x23\\x25\\xAF\\x02\\x1A\\x68\\xF7\\x07\\x51\\x1A")
    \\} seeds_give_their_rfc_8032_keys
    \\
    \\test public_keys_verify_their_secret_keys_signatures for SecretKey.public_key {
    \\    let secret = SecretKey.of_seed(array32(b"\\x4C\\xCD\\x08\\x9B\\x28\\xFF\\x96\\xDA\\x9D\\xB6\\xC3\\x46\\xEC\\x11\\x4E\\x0F\\x5B\\x8A\\x31\\x9F\\x35\\xAB\\xA6\\x24\\xDA\\x8C\\xF6\\xED\\x4F\\xB8\\xA6\\xFB"))
    \\    expect secret.public_key().verify(b"\\x72", signature: secret.sign(b"\\x72"))
    \\    expect not secret.public_key().verify(b"\\x73", signature: secret.sign(b"\\x72"))
    \\} public_keys_verify_their_secret_keys_signatures
    \\
    \\test verification_rejects_tampering_malleability_and_weak_keys for PublicKey.verify {
    \\    let key = PublicKey(bytes: array32(b"\\xD7\\x5A\\x98\\x01\\x82\\xB1\\x0A\\xB7\\xD5\\x4B\\xFE\\xD3\\xC9\\x64\\x07\\x3A\\x0E\\xE1\\x72\\xF3\\xDA\\xA6\\x23\\x25\\xAF\\x02\\x1A\\x68\\xF7\\x07\\x51\\x1A"))
    \\    let signature = Signature(bytes: array64(b"\\xE5\\x56\\x43\\x00\\xC3\\x60\\xAC\\x72\\x90\\x86\\xE2\\xCC\\x80\\x6E\\x82\\x8A\\x84\\x87\\x7F\\x1E\\xB8\\xE5\\xD9\\x74\\xD8\\x73\\xE0\\x65\\x22\\x49\\x01\\x55\\x5F\\xB8\\x82\\x15\\x90\\xA3\\x3B\\xAC\\xC6\\x1E\\x39\\x70\\x1C\\xF9\\xB4\\x6B\\xD2\\x5B\\xF5\\xF0\\x59\\x5B\\xBE\\x24\\x65\\x51\\x41\\x43\\x8E\\x7A\\x10\\x0B"))
    \\    expect key.verify(b"", signature)
    \\    expect not key.verify(b"x", signature)
    \\    var flipped = signature
    \\    flipped.bytes[0] = flipped.bytes[0] ^ 1
    \\    expect not key.verify(b"", signature: flipped)
    \\    expect not key.verify(b"", signature: Signature(bytes: array64(b"\\xE5\\x56\\x43\\x00\\xC3\\x60\\xAC\\x72\\x90\\x86\\xE2\\xCC\\x80\\x6E\\x82\\x8A\\x84\\x87\\x7F\\x1E\\xB8\\xE5\\xD9\\x74\\xD8\\x73\\xE0\\x65\\x22\\x49\\x01\\x55\\x4C\\x8C\\x78\\x72\\xAA\\x06\\x4E\\x04\\x9D\\xBB\\x30\\x13\\xFB\\xF2\\x93\\x80\\xD2\\x5B\\xF5\\xF0\\x59\\x5B\\xBE\\x24\\x65\\x51\\x41\\x43\\x8E\\x7A\\x10\\x1B")))
    \\    expect not PublicKey(bytes: array32(b"\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00")).verify(b"", signature)
    \\    expect decoded(array32(b"\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x80")).is_none()
    \\    expect decoded(array32(b"\\x05\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00")).is_some()
    \\    expect decoded(array32(b"\\xF2\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\x7F")).is_none()
    \\} verification_rejects_tampering_malleability_and_weak_keys
    \\
    \\/// Whether the key of a seed is `key` and signs `message` as `signature`, which it verifies.
    \\fn signs(seed: Slice[u8], key: Slice[u8], message: Slice[u8], signature: Slice[u8]) -> bool {
    \\    let secret = SecretKey.of_seed(array32(seed))
    \\    let signed = secret.sign(message)
    \\    return secret.public_key().bytes == array32(key) and signed.bytes == array64(signature) and secret.public_key().verify(message, signature: signed)
    \\} signs
    \\
    \\fn array32(held: Slice[u8]) -> Array[u8, 32] {
    \\    var bytes = Array[u8, 32].filled(0)
    \\    mut bytes.view_mut().copy_from(held)
    \\    return bytes
    \\} array32
    \\
    \\fn array64(held: Slice[u8]) -> Array[u8, 64] {
    \\    var bytes = Array[u8, 64].filled(0)
    \\    mut bytes.view_mut().copy_from(held)
    \\    return bytes
    \\} array64
    \\

const TEXT_CORE_ENCODE: Str =
    \\//! Converting values to and from structured data: the encode interface, encoders and decoders.
    \\
    \\pub interface Encode {
    \\    fn encode[E: Encoder](self, mut e: E) limits terminates
    \\    fn decode[D: Decoder](mut d: D, alloc: mem::Alloc) -> Self fails DecodeError limits terminates
    \\} Encode
    \\
    \\pub interface Encoder {
    \\    fn write_bool(mut self, value: bool) limits terminates
    \\    fn write_unsigned(mut self, value: u64) limits terminates
    \\    fn write_signed(mut self, value: i64) limits terminates
    \\    fn write_float(mut self, value: f64) limits terminates
    \\    fn write_char(mut self, value: char) limits terminates
    \\    fn write_text(mut self, value: Str) limits terminates
    \\    fn write_bytes(mut self, value: Slice[u8]) limits terminates
    \\    fn begin_sequence(mut self, count: usize) limits terminates
    \\    fn begin_map(mut self, count: usize) limits terminates
    \\    fn begin_record(mut self, count: usize) limits terminates
    \\    fn write_key(mut self, key: Str) limits terminates
    \\    fn begin_variant(mut self, key: Str, payload: bool) limits terminates
    \\    fn end(mut self) limits terminates
    \\} Encoder
    \\
    \\pub interface Decoder {
    \\    fn read_bool(mut self) -> bool fails DecodeError limits terminates
    \\    fn read_unsigned(mut self) -> u64 fails DecodeError limits terminates
    \\    fn read_signed(mut self) -> i64 fails DecodeError limits terminates
    \\    fn read_float(mut self) -> f64 fails DecodeError limits terminates
    \\    fn read_char(mut self) -> char fails DecodeError limits terminates
    \\    fn begin_text(mut self) -> usize fails DecodeError limits terminates
    \\    fn begin_bytes(mut self) -> usize fails DecodeError limits terminates
    \\    fn read_chunk(mut self, mut out: SliceMut[u8]) fails DecodeError limits terminates
    \\    fn begin_sequence(mut self) fails DecodeError limits terminates
    \\    fn begin_map(mut self) fails DecodeError limits terminates
    \\    fn begin_record(mut self) fails DecodeError limits terminates
    \\    fn next_follows(mut self) -> bool fails DecodeError limits terminates
    \\    fn read_key(mut self, keys: Slice[Str]) -> Option[usize] fails DecodeError limits terminates
    \\    fn read_variant(mut self, keys: Slice[Str]) -> Option[usize] fails DecodeError limits terminates
    \\    fn payload_follows(mut self) -> bool fails DecodeError limits terminates
    \\    fn skip(mut self) fails DecodeError limits terminates
    \\    fn end(mut self) fails DecodeError limits terminates
    \\} Decoder
    \\
    \\pub open enum DecodeError derives Copy, Eq, Hash, Render {
    \\    Truncated
    \\    Malformed
    \\    Trailing
    \\    TooDeep
    \\    UnknownKey
    \\    DuplicateKey
    \\    MissingField
    \\    UnknownVariant
    \\    OutOfRange
    \\    InvalidText
    \\    Invalid
    \\    OutOfMemory
    \\    UnknownSchema
    \\} DecodeError
    \\

const TEXT_CORE_FLOATS: Str =
    \\//! The decimal text of floats, in integer arithmetic over their bit patterns.
    \\
    \\/// The limbs of the naturals reading a decimal: room for the greatest, below 2^2600, that a
    \\/// decimal of 769 significant digits gives.
    \\const READ_LIMBS: usize = 88
    \\
    \\/// The limbs of the naturals writing a float's digits: room for the greatest, below 2^1140, that
    \\/// scaling an `f64` gives.
    \\const WRITE_LIMBS: usize = 40
    \\
    \\/// The significant digits of a decimal that reading keeps: a halfway point between two `f64`
    \\/// values has at most 767, so the nonzero digits past them only count as one further digit 1.
    \\const KEPT: u64 = 768
    \\
    \\const F64_INFINITY: u64 = 0x7FF0_0000_0000_0000
    \\
    \\/// A natural number over a view of 32-bit limbs, least significant first: the first `count` in
    \\/// use, the highest in use not zero.
    \\view struct Natural {
    \\    limbs: SliceMut[u32]
    \\    count: usize
    \\} Natural
    \\
    \\/// Makes the number `value`.
    \\fn Natural.set(mut self, value: u64) {
    \\    self.limbs[0] = u32.truncate(value)
    \\    self.limbs[1] = u32.truncate(value >> 32)
    \\    self.count = 2
    \\    mut self.trim()
    \\} Natural.set
    \\
    \\/// Makes the number a copy of another.
    \\fn Natural.assign(mut self, other: Natural) {
    \\    for index in 0..<other.count {
    \\        self.limbs[index] = other.limbs[index]
    \\    }
    \\    self.count = other.count
    \\} Natural.assign
    \\
    \\/// Drops the zero limbs at the high end.
    \\fn Natural.trim(mut self) {
    \\    while self.count > 0 and self.limbs[self.count - 1] == 0 {
    \\        self.count -= 1
    \\    }
    \\} Natural.trim
    \\
    \\/// The number of bits up to the highest set one.
    \\fn Natural.bits(self) -> i64 {
    \\    if self.count == 0 {
    \\        return 0
    \\    }
    \\    return i64.fit(self.count - 1) * 32 + i64.widen(32 - self.limbs[self.count - 1].leading_zeros())
    \\} Natural.bits
    \\
    \\/// Multiplies the number by a nonzero `factor` and adds `addend`.
    \\fn Natural.mul_add(mut self, factor: u32, addend: u32) {
    \\    var carry = u64.widen(addend)
    \\    for index in 0..<self.count {
    \\        let product = u64.widen(self.limbs[index]) * u64.widen(factor) + carry
    \\        self.limbs[index] = u32.truncate(product)
    \\        carry = product >> 32
    \\    }
    \\    if carry > 0 {
    \\        self.limbs[self.count] = u32.truncate(carry)
    \\        self.count += 1
    \\    }
    \\} Natural.mul_add
    \\
    \\/// Multiplies the number by 5 to the power `power`.
    \\fn Natural.mul_pow5(mut self, power: u64) {
    \\    var rest = power
    \\    while rest >= 13 {
    \\        mut self.mul_add(1_220_703_125, addend: 0)
    \\        rest -= 13
    \\    }
    \\    var factor: u32 = 1
    \\    while rest > 0 {
    \\        factor *= 5
    \\        rest -= 1
    \\    }
    \\    mut self.mul_add(factor, addend: 0)
    \\} Natural.mul_pow5
    \\
    \\/// Multiplies the number by 10 to the power `power`.
    \\fn Natural.mul_pow10(mut self, power: u64) {
    \\    mut self.mul_pow5(power)
    \\    mut self.shl(usize.widen(power))
    \\} Natural.mul_pow10
    \\
    \\/// Multiplies the number by 2 to the power `power`.
    \\fn Natural.shl(mut self, power: usize) {
    \\    let count = self.count
    \\    if count == 0 {
    \\        return
    \\    }
    \\    let whole = power / 32
    \\    let part = u32.truncate(power % 32)
    \\    if part == 0 {
    \\        var index = count
    \\        while index > 0 {
    \\            index -= 1
    \\            self.limbs[index + whole] = self.limbs[index]
    \\        }
    \\        self.count = count + whole
    \\    } else {
    \\        self.limbs[count + whole] = self.limbs[count - 1] >> (32 - part)
    \\        var index = count - 1
    \\        while index > 0 {
    \\            self.limbs[index + whole] = (self.limbs[index] << part) | (self.limbs[index - 1] >> (32 - part))
    \\            index -= 1
    \\        }
    \\        self.limbs[whole] = self.limbs[0] << part
    \\        self.count = count + whole + 1
    \\    }
    \\    for index in 0..<whole {
    \\        self.limbs[index] = 0
    \\    }
    \\    mut self.trim()
    \\} Natural.shl
    \\
    \\fn Natural.compare(self, other: Natural) -> Ordering {
    \\    if self.count != other.count {
    \\        return self.count.cmp(other.count)
    \\    }
    \\    var index = self.count
    \\    while index > 0 {
    \\        index -= 1
    \\        if self.limbs[index] != other.limbs[index] {
    \\            return self.limbs[index].cmp(other.limbs[index])
    \\        }
    \\    }
    \\    return Ordering.Equal
    \\} Natural.compare
    \\
    \\fn Natural.add(mut self, other: Natural) {
    \\    var carry: u64 = 0
    \\    var index: usize = 0
    \\    while index < self.count or index < other.count {
    \\        var sum = carry
    \\        if index < self.count {
    \\            sum += u64.widen(self.limbs[index])
    \\        }
    \\        if index < other.count {
    \\            sum += u64.widen(other.limbs[index])
    \\        }
    \\        self.limbs[index] = u32.truncate(sum)
    \\        carry = sum >> 32
    \\        index += 1
    \\    }
    \\    if carry > 0 {
    \\        self.limbs[index] = u32.truncate(carry)
    \\        index += 1
    \\    }
    \\    self.count = index
    \\} Natural.add
    \\
    \\/// Subtracts a number no greater than this one.
    \\fn Natural.subtract(mut self, other: Natural) {
    \\    var borrow: u64 = 0
    \\    for index in 0..<self.count {
    \\        var subtrahend = borrow
    \\        if index < other.count {
    \\            subtrahend += u64.widen(other.limbs[index])
    \\        }
    \\        let minuend = u64.widen(self.limbs[index])
    \\        if minuend < subtrahend {
    \\            self.limbs[index] = u32.truncate(minuend + 0x1_0000_0000 - subtrahend)
    \\            borrow = 1
    \\        } else {
    \\            self.limbs[index] = u32.truncate(minuend - subtrahend)
    \\            borrow = 0
    \\        }
    \\    }
    \\    mut self.trim()
    \\} Natural.subtract
    \\
    \\/// The integer part of a quotient, and whether no remainder follows it.
    \\struct Quotient derives Copy {
    \\    value: u64
    \\    exact: bool
    \\} Quotient
    \\
    \\/// The quotient of two naturals when below 2^56, a bit at a time, leaving the remainder in the
    \\/// dividend and the divisor times 2^56 in the divisor.
    \\fn divided(mut dividend: Natural, mut divisor: Natural) -> Quotient {
    \\    mut divisor.shl(56)
    \\    var value: u64 = 0
    \\    for _ in 0..<56u32 {
    \\        mut dividend.shl(1)
    \\        value = value << 1
    \\        if dividend.compare(divisor) != Ordering.Less {
    \\            mut dividend.subtract(divisor)
    \\            value = value | 1
    \\        }
    \\    }
    \\    return Quotient(value: value, exact: dividend.count == 0)
    \\} divided
    \\
    \\/// The significant digits of a decimal number read so far: the value of the first `count`, at
    \\/// most `KEPT`, with the next ones in `chunk`, and whether a nonzero digit past them was dropped.
    \\view struct Significant {
    \\    value: Natural
    \\    count: u64
    \\    chunk: u32
    \\    chunk_digits: u32
    \\    dropped: bool
    \\} Significant
    \\
    \\fn Significant.push(mut self, digit: u32) {
    \\    if self.count == KEPT {
    \\        if digit != 0 {
    \\            self.dropped = true
    \\        }
    \\        return
    \\    }
    \\    self.chunk = self.chunk * 10 + digit
    \\    self.chunk_digits += 1
    \\    self.count += 1
    \\    if self.chunk_digits == 9 {
    \\        mut self.value.mul_add(1_000_000_000, addend: self.chunk)
    \\        self.chunk = 0
    \\        self.chunk_digits = 0
    \\    }
    \\} Significant.push
    \\
    \\/// The value of the digits, a nonzero digit dropped counting as a further digit 1.
    \\fn Significant.finished(mut self) {
    \\    var factor: u32 = 1
    \\    for _ in 0..<self.chunk_digits {
    \\        factor *= 10
    \\    }
    \\    mut self.value.mul_add(factor, addend: self.chunk)
    \\    if self.dropped {
    \\        mut self.value.mul_add(10, addend: 1)
    \\        self.count += 1
    \\    }
    \\} Significant.finished
    \\
    \\/// The bit pattern of the `f64` nearest the value of a decimal number, ties to an even
    \\/// significand and infinity past the greatest finite value: `-` optionally, digits, optionally
    \\/// `.` and digits, then optionally `e` or `E`, `+` or `-` optionally and digits, any `_` among
    \\/// them ignored.
    \\pkg fn f64_bits_of(number: Slice[u8]) -> u64 {
    \\    var at: usize = 0
    \\    var sign: u64 = 0
    \\    if number.len() > 0 and number[0] == b'-' {
    \\        sign = 1u64 << 63
    \\        at = 1
    \\    }
    \\    var digit_limbs = Array[u32, READ_LIMBS].filled(0)
    \\    var digits = Significant(value: Natural(limbs: mut digit_limbs.view_mut(), count: 0), count: 0, chunk: 0, chunk_digits: 0, dropped: false)
    \\    var point: i64 = 0
    \\    var fraction = false
    \\    while at < number.len() and number[at] != b'e' and number[at] != b'E' {
    \\        let byte = number[at]
    \\        at += 1
    \\        if byte == b'.' {
    \\            fraction = true
    \\            continue
    \\        }
    \\        if byte == b'_' {
    \\            continue
    \\        }
    \\        let leading = digits.count == 0 and byte == b'0'
    \\        if leading and fraction {
    \\            point -= 1
    \\        }
    \\        if not leading {
    \\            if not fraction {
    \\                point += 1
    \\            }
    \\            mut digits.push(u32.widen(byte - b'0'))
    \\        }
    \\    }
    \\    if digits.count == 0 {
    \\        return sign
    \\    }
    \\    let exponent = point + exponent_of(number, at)
    \\    if exponent > 310 {
    \\        return sign | F64_INFINITY
    \\    }
    \\    if exponent < -324 {
    \\        return sign
    \\    }
    \\    mut digits.finished()
    \\    let fraction_digits = i64.fit(digits.count) - exponent
    \\    var denominator_limbs = Array[u32, READ_LIMBS].filled(0)
    \\    var denominator = Natural(limbs: mut denominator_limbs.view_mut(), count: 0)
    \\    mut denominator.set(1)
    \\    if fraction_digits < 0 {
    \\        mut digits.value.mul_pow5(u64.fit(-fraction_digits))
    \\    } else {
    \\        mut denominator.mul_pow5(u64.fit(fraction_digits))
    \\    }
    \\    let shift = 55 - digits.value.bits() + denominator.bits()
    \\    if shift >= 0 {
    \\        mut digits.value.shl(usize.fit(shift))
    \\    } else {
    \\        mut denominator.shl(usize.fit(-shift))
    \\    }
    \\    let quotient = divided(mut digits.value, divisor: mut denominator)
    \\    return sign | nearest_f64(quotient, exponent: -fraction_digits - shift)
    \\} f64_bits_of
    \\
    \\/// The exponent of a decimal number's text from `at`, where its `e` or `E` is, 0 without one, its
    \\/// magnitude capped at 10^17, past the count of digits any text holds.
    \\fn exponent_of(number: Slice[u8], at: usize) -> i64 {
    \\    if at >= number.len() {
    \\        return 0
    \\    }
    \\    var index = at + 1
    \\    var negative = false
    \\    if index < number.len() and (number[index] == b'-' or number[index] == b'+') {
    \\        negative = number[index] == b'-'
    \\        index += 1
    \\    }
    \\    var magnitude: i64 = 0
    \\    while index < number.len() {
    \\        let byte = number[index]
    \\        if byte != b'_' and magnitude < 100_000_000_000_000_000 {
    \\            magnitude = magnitude * 10 + i64.widen(byte - b'0')
    \\        }
    \\        index += 1
    \\    }
    \\    if negative {
    \\        return -magnitude
    \\    }
    \\    return magnitude
    \\} exponent_of
    \\
    \\/// The bits of the `f64` nearest `quotient × 2^exponent`, the quotient from 2^54 below 2^56.
    \\fn nearest_f64(quotient: Quotient, exponent: i64) -> u64 {
    \\    var dropped = 64 - i64.widen(quotient.value.leading_zeros()) - 53
    \\    var power = exponent + dropped
    \\    if power < -1_074 {
    \\        dropped += -1_074 - power
    \\        power = -1_074
    \\    }
    \\    if dropped > 60 {
    \\        return 0
    \\    }
    \\    let shift = u32.fit(dropped)
    \\    var significand = quotient.value >> shift
    \\    let half = (quotient.value >> (shift - 1)) & 1
    \\    let beyond = (quotient.value & ((1u64 << (shift - 1)) - 1)) != 0 or not quotient.exact
    \\    if half == 1 and (beyond or (significand & 1) == 1) {
    \\        significand += 1
    \\    }
    \\    if significand == (1u64 << 53) {
    \\        significand = 1u64 << 52
    \\        power += 1
    \\    }
    \\    if significand < (1u64 << 52) {
    \\        return significand
    \\    }
    \\    let biased = power + 1_075
    \\    if biased >= 2_047 {
    \\        return F64_INFINITY
    \\    }
    \\    return (u64.fit(biased) << 52) | (significand - (1u64 << 52))
    \\} nearest_f64
    \\
    \\/// A binary float format: the bits of its fraction field and its greatest exponent.
    \\struct Binary derives Copy {
    \\    fraction_bits: u32
    \\    max_exponent: i64
    \\} Binary
    \\
    \\/// Writes the text of the `f64` of a bit pattern and returns its length: `NaN`, `inf`, `-inf`, or
    \\/// the shortest digits that read back as the value, positional for 0 and magnitudes from 10^-5
    \\/// below 10^16, otherwise with an exponent.
    \\pkg fn f64_text(bits: u64, mut out: Array[u8, 40]) -> usize {
    \\    let magnitude = bits & 0x7FFF_FFFF_FFFF_FFFF
    \\    let positional = magnitude == 0 or (magnitude >= 0x3EE4_F8B5_88E3_68F1 and magnitude < 0x4341_C379_37E0_8000)
    \\    return float_text(Binary(fraction_bits: 52, max_exponent: 1_023), negative: (bits >> 63) == 1, magnitude, positional, mut out)
    \\} f64_text
    \\
    \\/// Writes the text of the `f32` of a bit pattern as `f64_text` does, its digits the shortest that
    \\/// read back as an `f32`.
    \\pkg fn f32_text(bits: u32, mut out: Array[u8, 40]) -> usize {
    \\    let magnitude = u64.widen(bits & 0x7FFF_FFFF)
    \\    let positional = magnitude == 0 or (magnitude >= 0x3727_C5AD and magnitude < 0x5A0E_1BCA)
    \\    return float_text(Binary(fraction_bits: 23, max_exponent: 127), negative: (bits >> 31) == 1, magnitude, positional, mut out)
    \\} f32_text
    \\
    \\fn float_text(
    \\    format: Binary,
    \\    negative: bool,
    \\    magnitude: u64,
    \\    positional: bool,
    \\    mut out: Array[u8, 40],
    \\    ) -> usize {
    \\    let infinity = u64.fit(2 * format.max_exponent + 1) << format.fraction_bits
    \\    if magnitude > infinity {
    \\        return append(mut out, at: 0, bytes: b"NaN")
    \\    }
    \\    var len: usize = 0
    \\    if negative {
    \\        len = append(mut out, at: len, bytes: b"-")
    \\    }
    \\    if magnitude == infinity {
    \\        return append(mut out, at: len, bytes: b"inf")
    \\    }
    \\    if magnitude == 0 {
    \\        return append(mut out, at: len, bytes: b"0.0")
    \\    }
    \\    let decimal = shortest(Decoded.of(format, magnitude))
    \\    if positional {
    \\        return positional_text(decimal, mut out, at: len)
    \\    }
    \\    return scientific_text(decimal, mut out, at: len)
    \\} float_text
    \\
    \\/// A positive finite float as `mant × 2^exp`, the values halfway to the floats beside it
    \\/// `(mant - minus) × 2^exp` and `(mant + plus) × 2^exp`, which read back as it when `inclusive`.
    \\struct Decoded derives Copy {
    \\    mant: u64
    \\    minus: u64
    \\    plus: u64
    \\    exp: i64
    \\    inclusive: bool
    \\} Decoded
    \\
    \\fn Decoded.of(format: Binary, magnitude: u64) -> Decoded {
    \\    let biased = magnitude >> format.fraction_bits
    \\    let fraction = magnitude & ((1u64 << format.fraction_bits) - 1)
    \\    let shift = format.max_exponent + i64.widen(format.fraction_bits)
    \\    if biased == 0 {
    \\        return Decoded(mant: fraction << 1, minus: 1, plus: 1, exp: -shift, inclusive: true)
    \\    }
    \\    let mant = fraction | (1u64 << format.fraction_bits)
    \\    if fraction == 0 {
    \\        return Decoded(mant: mant << 2, minus: 1, plus: 2, exp: i64.fit(biased) - shift - 2, inclusive: true)
    \\    }
    \\    return Decoded(mant: mant << 1, minus: 1, plus: 1, exp: i64.fit(biased) - shift - 1, inclusive: (mant & 1) == 0)
    \\} Decoded.of
    \\
    \\/// A decimal: its digits and the power of ten of the first.
    \\struct Decimal derives Copy {
    \\    digits: Array[u8, 24]
    \\    count: usize
    \\    exponent: i64
    \\} Decimal
    \\
    \\/// Whether an order of `a` against `b` puts `a` below `b`, or at most `b` when `inclusive`.
    \\fn below(order: Ordering, inclusive: bool) -> bool {
    \\    if inclusive {
    \\        return order != Ordering.Greater
    \\    }
    \\    return order == Ordering.Less
    \\} below
    \\
    \\/// Whether `mant + plus` passes `scale`, or reaches it when `inclusive`, the sum computed in
    \\/// `sum`.
    \\fn reaches(mant: Natural, plus: Natural, scale: Natural, inclusive: bool, mut sum: Natural) -> bool {
    \\    mut sum.assign(mant)
    \\    mut sum.add(plus)
    \\    return below(scale.compare(sum), inclusive)
    \\} reaches
    \\
    \\/// The shortest digits between a float's halfway values, the nearer of the last two candidates
    \\/// and the greater on a tie: the digits of Dragon4's free-format algorithm.
    \\fn shortest(decoded: Decoded) -> Decimal {
    \\    let high = decoded.mant + decoded.plus
    \\    var k = ((64 - i64.widen((high - 1).leading_zeros()) + decoded.exp) * 1_292_913_986).shr_arith(32)
    \\    var mant_limbs = Array[u32, WRITE_LIMBS].filled(0)
    \\    var mant = Natural(limbs: mut mant_limbs.view_mut(), count: 0)
    \\    mut mant.set(decoded.mant)
    \\    var minus_limbs = Array[u32, WRITE_LIMBS].filled(0)
    \\    var minus = Natural(limbs: mut minus_limbs.view_mut(), count: 0)
    \\    mut minus.set(decoded.minus)
    \\    var plus_limbs = Array[u32, WRITE_LIMBS].filled(0)
    \\    var plus = Natural(limbs: mut plus_limbs.view_mut(), count: 0)
    \\    mut plus.set(decoded.plus)
    \\    var scale_limbs = Array[u32, WRITE_LIMBS].filled(0)
    \\    var scale = Natural(limbs: mut scale_limbs.view_mut(), count: 0)
    \\    mut scale.set(1)
    \\    var scratch_limbs = Array[u32, WRITE_LIMBS].filled(0)
    \\    var scratch = Natural(limbs: mut scratch_limbs.view_mut(), count: 0)
    \\    if decoded.exp < 0 {
    \\        mut scale.shl(usize.fit(-decoded.exp))
    \\    } else {
    \\        let power = usize.fit(decoded.exp)
    \\        mut mant.shl(power)
    \\        mut minus.shl(power)
    \\        mut plus.shl(power)
    \\    }
    \\    if k >= 0 {
    \\        mut scale.mul_pow10(u64.fit(k))
    \\    } else {
    \\        let power = u64.fit(-k)
    \\        mut mant.mul_pow10(power)
    \\        mut minus.mul_pow10(power)
    \\        mut plus.mul_pow10(power)
    \\    }
    \\    if reaches(mant, plus, scale, inclusive: decoded.inclusive, sum: mut scratch) {
    \\        k += 1
    \\    } else {
    \\        mut mant.mul_add(10, addend: 0)
    \\        mut minus.mul_add(10, addend: 0)
    \\        mut plus.mul_add(10, addend: 0)
    \\    }
    \\    var decimal = Decimal(digits: Array[u8, 24].filled(b'0'), count: 0, exponent: k - 1)
    \\    var down = false
    \\    var up = false
    \\    loop {
    \\        var digit = b'0'
    \\        while mant.compare(scale) != Ordering.Less {
    \\            mut mant.subtract(scale)
    \\            digit += 1
    \\        }
    \\        decimal.digits[decimal.count] = digit
    \\        decimal.count += 1
    \\        down = below(mant.compare(minus), inclusive: decoded.inclusive)
    \\        up = reaches(mant, plus, scale, inclusive: decoded.inclusive, sum: mut scratch)
    \\        if down or up {
    \\            break
    \\        }
    \\        mut mant.mul_add(10, addend: 0)
    \\        mut minus.mul_add(10, addend: 0)
    \\        mut plus.mul_add(10, addend: 0)
    \\    }
    \\    if up {
    \\        mut scratch.assign(mant)
    \\        mut scratch.shl(1)
    \\        if not down or scratch.compare(scale) != Ordering.Less {
    \\            mut decimal.round_up()
    \\        }
    \\    }
    \\    return decimal
    \\} shortest
    \\
    \\/// Adds one to the last digit; when every digit is a nine, the digits become a one and zeros, one
    \\/// more than before, and the exponent grows.
    \\fn Decimal.round_up(mut self) {
    \\    var index = self.count
    \\    while index > 0 {
    \\        index -= 1
    \\        if self.digits[index] != b'9' {
    \\            self.digits[index] += 1
    \\            for later in (index + 1)..<self.count {
    \\                self.digits[later] = b'0'
    \\            }
    \\            return
    \\        }
    \\    }
    \\    self.digits[0] = b'1'
    \\    for later in 1..=self.count {
    \\        self.digits[later] = b'0'
    \\    }
    \\    self.count += 1
    \\    self.exponent += 1
    \\} Decimal.round_up
    \\
    \\/// Appends bytes to a text from `at` and returns its new length.
    \\fn append(mut out: Array[u8, 40], at: usize, bytes: Slice[u8]) -> usize {
    \\    var len = at
    \\    for byte in bytes {
    \\        out[len] = byte
    \\        len += 1
    \\    }
    \\    return len
    \\} append
    \\
    \\/// Writes a decimal positionally: at least one digit on each side of the point.
    \\fn positional_text(decimal: Decimal, mut out: Array[u8, 40], at: usize) -> usize {
    \\    var len = at
    \\    if decimal.exponent < 0 {
    \\        len = append(mut out, at: len, bytes: b"0.")
    \\        for _ in 1..<(-decimal.exponent) {
    \\            len = append(mut out, at: len, bytes: b"0")
    \\        }
    \\        for index in 0..<decimal.count {
    \\            out[len] = decimal.digits[index]
    \\            len += 1
    \\        }
    \\        return len
    \\    }
    \\    let whole = usize.fit(decimal.exponent) + 1
    \\    for index in 0..<whole {
    \\        if index < decimal.count {
    \\            out[len] = decimal.digits[index]
    \\        } else {
    \\            out[len] = b'0'
    \\        }
    \\        len += 1
    \\    }
    \\    len = append(mut out, at: len, bytes: b".")
    \\    if decimal.count <= whole {
    \\        return append(mut out, at: len, bytes: b"0")
    \\    }
    \\    for index in whole..<decimal.count {
    \\        out[len] = decimal.digits[index]
    \\        len += 1
    \\    }
    \\    return len
    \\} positional_text
    \\
    \\/// Writes a decimal as its first digit, `.`, the others or `0`, `e` and the exponent.
    \\fn scientific_text(decimal: Decimal, mut out: Array[u8, 40], at: usize) -> usize {
    \\    var len = at
    \\    out[len] = decimal.digits[0]
    \\    len = append(mut out, at: len + 1, bytes: b".")
    \\    if decimal.count == 1 {
    \\        len = append(mut out, at: len, bytes: b"0")
    \\    }
    \\    for index in 1..<decimal.count {
    \\        out[len] = decimal.digits[index]
    \\        len += 1
    \\    }
    \\    len = append(mut out, at: len, bytes: b"e")
    \\    var exponent = decimal.exponent
    \\    if exponent < 0 {
    \\        len = append(mut out, at: len, bytes: b"-")
    \\        exponent = -exponent
    \\    }
    \\    if exponent >= 100 {
    \\        out[len] = b'0' + u8.fit(exponent.div_trunc(100))
    \\        len += 1
    \\    }
    \\    if exponent >= 10 {
    \\        out[len] = b'0' + u8.fit(exponent.div_trunc(10).rem_trunc(10))
    \\        len += 1
    \\    }
    \\    out[len] = b'0' + u8.fit(exponent.rem_trunc(10))
    \\    return len + 1
    \\} scientific_text
    \\

const TEXT_CORE_GENERATE: Str =
    \\//! Building input values for property tests.
    \\
    \\pub interface Generate {
    \\    fn generate(mut choices: Choices, alloc: mem::Alloc) -> Self limits terminates
    \\} Generate
    \\
    \\pub open struct Choices {
    \\} Choices
    \\
    \\pub fn Choices.draw(mut self, low: u64, high: u64) -> u64 limits notrap, terminates
    \\    requires low <= high
    \\    ensures low <= result and result <= high
    \\
    \\pub fn Choices.draw_signed(mut self, low: i64, high: i64) -> i64 limits notrap, terminates
    \\    requires low <= high
    \\    ensures low <= result and result <= high
    \\
    \\struct Roll derives Copy {
    \\    face: u64
    \\    offset: i64
    \\} Roll
    \\
    \\impl Roll: Generate
    \\
    \\fn Roll.generate(mut choices: Choices, alloc: mem::Alloc) -> Roll limits terminates {
    \\    let face = mut choices.draw(1, high: 6)
    \\    let offset = mut choices.draw_signed(-3, high: 3)
    \\    return Roll(face: face, offset: offset)
    \\} Roll.generate
    \\
    \\test draws_stay_within_their_bounds for Choices.draw (roll: Roll) {
    \\    expect roll.face >= 1 and roll.face <= 6
    \\} draws_stay_within_their_bounds
    \\
    \\test signed_draws_stay_within_their_bounds for Choices.draw_signed (roll: Roll) {
    \\    expect roll.offset >= -3 and roll.offset <= 3
    \\} signed_draws_stay_within_their_bounds
    \\

const TEXT_CORE_NUMBERS: Str =
    \\//! Integer overflow alternatives, division, shifts, bit counts and wide products, and floats.
    \\
    \\pub closed struct Overflowing[T: Copy and Eq] derives Copy, Eq {
    \\    pub value: T
    \\    pub overflowed: bool
    \\} Overflowing
    \\
    \\pub closed struct WideProduct[T: Copy and Eq] derives Copy, Eq {
    \\    pub high: T
    \\    pub low: u64
    \\} WideProduct
    \\
    \\pub fn u8.wrapping_add(self, other: u8) -> u8 limits pure, notrap, terminates
    \\    example (~0u8).wrapping_add(1) == 0
    \\
    \\pub fn u8.wrapping_sub(self, other: u8) -> u8 limits pure, notrap, terminates
    \\    example 0u8.wrapping_sub(1) == (~0u8)
    \\
    \\pub fn u8.wrapping_mul(self, other: u8) -> u8 limits pure, notrap, terminates
    \\    example (~0u8).wrapping_mul(2) == (~1u8)
    \\
    \\pub fn u8.overflowing_add(self, other: u8) -> Overflowing[u8] limits pure, notrap, terminates
    \\    example (~0u8).overflowing_add(1) == Overflowing(value: 0, overflowed: true)
    \\{
    \\    let value = self.wrapping_add(other)
    \\    return Overflowing(value: value, overflowed: value < self)
    \\} u8.overflowing_add
    \\
    \\pub fn u8.checked_add(self, other: u8) -> Option[u8] limits pure, notrap, terminates
    \\    example (~0u8).checked_add(1) == None
    \\{
    \\    let sum = self.overflowing_add(other)
    \\    if sum.overflowed {
    \\        return None
    \\    }
    \\    return Some(sum.value)
    \\} u8.checked_add
    \\
    \\pub fn u8.saturating_add(self, other: u8) -> u8 limits pure, notrap, terminates
    \\    example (~0u8).saturating_add(1) == (~0u8)
    \\{
    \\    let sum = self.overflowing_add(other)
    \\    if sum.overflowed {
    \\        return ~0u8
    \\    }
    \\    return sum.value
    \\} u8.saturating_add
    \\
    \\pub fn u8.overflowing_sub(self, other: u8) -> Overflowing[u8] limits pure, notrap, terminates
    \\    example 0u8.overflowing_sub(1) == Overflowing(value: ~0u8, overflowed: true)
    \\{
    \\    return Overflowing(value: self.wrapping_sub(other), overflowed: other > self)
    \\} u8.overflowing_sub
    \\
    \\pub fn u8.checked_sub(self, other: u8) -> Option[u8] limits pure, notrap, terminates
    \\    example 0u8.checked_sub(1) == None
    \\{
    \\    if other > self {
    \\        return None
    \\    }
    \\    return Some(self - other)
    \\} u8.checked_sub
    \\
    \\pub fn u8.saturating_sub(self, other: u8) -> u8 limits pure, notrap, terminates
    \\    example 0u8.saturating_sub(1) == 0
    \\{
    \\    if other > self {
    \\        return 0
    \\    }
    \\    return self - other
    \\} u8.saturating_sub
    \\
    \\pub fn u8.overflowing_mul(self, other: u8) -> Overflowing[u8] limits pure, notrap, terminates
    \\    example (~0u8).overflowing_mul(2) == Overflowing(value: ~1u8, overflowed: true)
    \\{
    \\    let wide = u64.widen(self).wide_mul(u64.widen(other))
    \\    return Overflowing(value: u8.truncate(wide.low), overflowed: wide.low > 255)
    \\} u8.overflowing_mul
    \\
    \\pub fn u8.checked_mul(self, other: u8) -> Option[u8] limits pure, notrap, terminates
    \\    example (~0u8).checked_mul(2) == None
    \\{
    \\    let product = self.overflowing_mul(other)
    \\    if product.overflowed {
    \\        return None
    \\    }
    \\    return Some(product.value)
    \\} u8.checked_mul
    \\
    \\pub fn u8.saturating_mul(self, other: u8) -> u8 limits pure, notrap, terminates
    \\    example (~0u8).saturating_mul(2) == (~0u8)
    \\{
    \\    let product = self.overflowing_mul(other)
    \\    if product.overflowed {
    \\        return ~0u8
    \\    }
    \\    return product.value
    \\} u8.saturating_mul
    \\
    \\pub fn u8.count_ones(self) -> u32 limits pure, notrap, terminates
    \\    ensures result <= 8
    \\    example 0b1011u8.count_ones() == 3
    \\
    \\pub fn u8.leading_zeros(self) -> u32 limits pure, notrap, terminates
    \\    ensures result <= 8
    \\    example 0u8.leading_zeros() == 8
    \\
    \\pub fn u8.trailing_zeros(self) -> u32 limits pure, notrap, terminates
    \\    ensures result <= 8
    \\    example 8u8.trailing_zeros() == 3
    \\
    \\pub fn u16.wrapping_add(self, other: u16) -> u16 limits pure, notrap, terminates
    \\    example (~0u16).wrapping_add(1) == 0
    \\
    \\pub fn u16.wrapping_sub(self, other: u16) -> u16 limits pure, notrap, terminates
    \\    example 0u16.wrapping_sub(1) == (~0u16)
    \\
    \\pub fn u16.wrapping_mul(self, other: u16) -> u16 limits pure, notrap, terminates
    \\    example (~0u16).wrapping_mul(2) == (~1u16)
    \\
    \\pub fn u16.overflowing_add(self, other: u16) -> Overflowing[u16] limits pure, notrap, terminates
    \\    example (~0u16).overflowing_add(1) == Overflowing(value: 0, overflowed: true)
    \\{
    \\    let value = self.wrapping_add(other)
    \\    return Overflowing(value: value, overflowed: value < self)
    \\} u16.overflowing_add
    \\
    \\pub fn u16.checked_add(self, other: u16) -> Option[u16] limits pure, notrap, terminates
    \\    example (~0u16).checked_add(1) == None
    \\{
    \\    let sum = self.overflowing_add(other)
    \\    if sum.overflowed {
    \\        return None
    \\    }
    \\    return Some(sum.value)
    \\} u16.checked_add
    \\
    \\pub fn u16.saturating_add(self, other: u16) -> u16 limits pure, notrap, terminates
    \\    example (~0u16).saturating_add(1) == (~0u16)
    \\{
    \\    let sum = self.overflowing_add(other)
    \\    if sum.overflowed {
    \\        return ~0u16
    \\    }
    \\    return sum.value
    \\} u16.saturating_add
    \\
    \\pub fn u16.overflowing_sub(self, other: u16) -> Overflowing[u16] limits pure, notrap, terminates
    \\    example 0u16.overflowing_sub(1) == Overflowing(value: ~0u16, overflowed: true)
    \\{
    \\    return Overflowing(value: self.wrapping_sub(other), overflowed: other > self)
    \\} u16.overflowing_sub
    \\
    \\pub fn u16.checked_sub(self, other: u16) -> Option[u16] limits pure, notrap, terminates
    \\    example 0u16.checked_sub(1) == None
    \\{
    \\    if other > self {
    \\        return None
    \\    }
    \\    return Some(self - other)
    \\} u16.checked_sub
    \\
    \\pub fn u16.saturating_sub(self, other: u16) -> u16 limits pure, notrap, terminates
    \\    example 0u16.saturating_sub(1) == 0
    \\{
    \\    if other > self {
    \\        return 0
    \\    }
    \\    return self - other
    \\} u16.saturating_sub
    \\
    \\pub fn u16.overflowing_mul(self, other: u16) -> Overflowing[u16] limits pure, notrap, terminates
    \\    example (~0u16).overflowing_mul(2) == Overflowing(value: ~1u16, overflowed: true)
    \\{
    \\    let wide = u64.widen(self).wide_mul(u64.widen(other))
    \\    return Overflowing(value: u16.truncate(wide.low), overflowed: wide.low > 65_535)
    \\} u16.overflowing_mul
    \\
    \\pub fn u16.checked_mul(self, other: u16) -> Option[u16] limits pure, notrap, terminates
    \\    example (~0u16).checked_mul(2) == None
    \\{
    \\    let product = self.overflowing_mul(other)
    \\    if product.overflowed {
    \\        return None
    \\    }
    \\    return Some(product.value)
    \\} u16.checked_mul
    \\
    \\pub fn u16.saturating_mul(self, other: u16) -> u16 limits pure, notrap, terminates
    \\    example (~0u16).saturating_mul(2) == (~0u16)
    \\{
    \\    let product = self.overflowing_mul(other)
    \\    if product.overflowed {
    \\        return ~0u16
    \\    }
    \\    return product.value
    \\} u16.saturating_mul
    \\
    \\pub fn u16.count_ones(self) -> u32 limits pure, notrap, terminates
    \\    ensures result <= 16
    \\    example 0b1011u16.count_ones() == 3
    \\
    \\pub fn u16.leading_zeros(self) -> u32 limits pure, notrap, terminates
    \\    ensures result <= 16
    \\    example 0u16.leading_zeros() == 16
