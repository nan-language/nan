pub fn I64x2.bit_not(self) -> I64x2 limits pure, notrap, terminates
    example I64x2.splat(0).bit_not() == I64x2.splat(-1)
{
    var lanes = self.lanes
    for index in 0..<2usize {
        lanes[index] = ~lanes[index]
    }
    return I64x2(lanes: lanes)
} I64x2.bit_not

pub fn I64x2.shl(self, amount: u32) -> I64x2 limits pure, notrap, terminates
    requires amount < 64
    example I64x2.splat(3).shl(63) == I64x2.splat(-9223372036854775808)
{
    var lanes = self.lanes
    for index in 0..<2usize {
        lanes[index] = lanes[index].wrapping_shl(amount)
    }
    return I64x2(lanes: lanes)
} I64x2.shl

pub fn I64x2.shr(self, amount: u32) -> I64x2 limits pure, notrap, terminates
    requires amount < 64
    example I64x2.splat(-8).shr(1) == I64x2.splat(-4)
{
    var lanes = self.lanes
    for index in 0..<2usize {
        lanes[index] = lanes[index].shr_arith(amount)
    }
    return I64x2(lanes: lanes)
} I64x2.shr

pub fn I64x2.lanes_eq(self, other: I64x2) -> Mask64x2 limits pure, notrap, terminates
    example I64x2.splat(1).replace_lane(0, value: 2).lanes_eq(I64x2.splat(1)).bitmask() == 0b10
{
    var lanes = Array[u64, 2].filled(0)
    for index in 0..<2usize {
        if self.lanes[index] == other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask64x2(lanes: lanes)
} I64x2.lanes_eq

pub fn I64x2.lanes_lt(self, other: I64x2) -> Mask64x2 limits pure, notrap, terminates
    example I64x2.splat(-1).lanes_lt(I64x2.splat(0)).all()
{
    var lanes = Array[u64, 2].filled(0)
    for index in 0..<2usize {
        if self.lanes[index] < other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask64x2(lanes: lanes)
} I64x2.lanes_lt

pub fn I64x2.lanes_gt(self, other: I64x2) -> Mask64x2 limits pure, notrap, terminates
    example not I64x2.splat(1).lanes_gt(I64x2.splat(1)).any()
{
    var lanes = Array[u64, 2].filled(0)
    for index in 0..<2usize {
        if self.lanes[index] > other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask64x2(lanes: lanes)
} I64x2.lanes_gt

pub fn I64x2.select(mask: Mask64x2, if_true: I64x2, if_false: I64x2) -> I64x2 limits pure, notrap, terminates
    example I64x2.select(I64x2.splat(1).lanes_lt(I64x2.splat(2)), if_true: I64x2.splat(3), if_false: I64x2.splat(4)) == I64x2.splat(3)
{
    var lanes = if_false.lanes
    for index in 0..<2usize {
        let chosen = mask.lanes[index]
        lanes[index] = i64.from_bits((if_true.lanes[index].to_bits() & chosen) | (if_false.lanes[index].to_bits() & ~chosen))
    }
    return I64x2(lanes: lanes)
} I64x2.select

pub fn I64x2.wrapping_sum(self) -> i64 limits pure, notrap, terminates
    example I64x2.splat(3).wrapping_sum() == 6
{
    var total = self.lanes[0]
    for index in 1..<2usize {
        total = total.wrapping_add(self.lanes[index])
    }
    return total
} I64x2.wrapping_sum

pub fn I64x2.to_bytes(self) -> U8x16 limits pure, notrap, terminates
    example I64x2.splat(1).to_bytes().lane(0) == 1
{
    var bytes = Array[u8, 16].filled(0)
    for index in 0..<2usize {
        let bits = self.lanes[index].to_bits()
        bytes[8 * index] = u8.truncate(bits)
        bytes[8 * index + 1] = u8.truncate(bits >> 8)
        bytes[8 * index + 2] = u8.truncate(bits >> 16)
        bytes[8 * index + 3] = u8.truncate(bits >> 24)
        bytes[8 * index + 4] = u8.truncate(bits >> 32)
        bytes[8 * index + 5] = u8.truncate(bits >> 40)
        bytes[8 * index + 6] = u8.truncate(bits >> 48)
        bytes[8 * index + 7] = u8.truncate(bits >> 56)
    }
    return U8x16(lanes: bytes)
} I64x2.to_bytes

pub fn I64x2.from_bytes(bytes: U8x16) -> I64x2 limits pure, notrap, terminates
    example I64x2.from_bytes(U8x16.splat(0)) == I64x2.splat(0)
{
    var lanes = Array[i64, 2].filled(0)
    for index in 0..<2usize {
        lanes[index] = i64.from_bits(bytes.lanes.view().u64_le(8 * index))
    }
    return I64x2(lanes: lanes)
} I64x2.from_bytes

