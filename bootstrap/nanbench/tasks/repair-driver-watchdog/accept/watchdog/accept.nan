//! Acceptance tests of the watchdog driver.

test starting_loads_the_ticks for Watchdog.start {
    let block = hw::sim::Registers[WatchdogRegs].of(testing::world().alloc)
    let dog = Watchdog.start(block.mmio(), ticks: 50_000, prescaler: 15)
    take dog.stop()
    expect block.last_written(WatchdogRegs.reload) == Some(50_000)
} starting_loads_the_ticks

test a_started_watchdog_resets_on_expiry for Watchdog.start {
    let block = hw::sim::Registers[WatchdogRegs].of(testing::world().alloc)
    var dog = Watchdog.start(block.mmio(), ticks: 1_000, prescaler: 9)
    let started = block.last_written(WatchdogRegs.control)
    mut dog.pet()
    take dog.stop()
    expect started == Some(Control(enable: true, reset_on_expiry: true, prescaler: 9, reserved: 0))
} a_started_watchdog_resets_on_expiry

test petting_reloads_the_ticks for Watchdog.pet {
    let block = hw::sim::Registers[WatchdogRegs].of(testing::world().alloc)
    var dog = Watchdog.start(block.mmio(), ticks: 7_000, prescaler: 0)
    block.set(WatchdogRegs.reload, value: 0)
    mut dog.pet()
    let reloaded = block.last_written(WatchdogRegs.reload)
    block.set(WatchdogRegs.count, value: Counter.from_bits(0xFF00_1B57))
    let left = mut dog.remaining()
    take dog.stop()
    expect reloaded == Some(7_000)
    expect left == 6_999
} petting_reloads_the_ticks

test an_expiry_is_reported_once for Watchdog.clear_expiry {
    let block = hw::sim::Registers[WatchdogRegs].of(testing::world().alloc)
    var dog = Watchdog.start(block.mmio(), ticks: 10, prescaler: 0)
    let before_expiry = mut dog.clear_expiry()
    block.set(WatchdogRegs.status, value: Status.from_bits(0x41))
    let expired_once = mut dog.clear_expiry()
    let expired_twice = mut dog.clear_expiry()
    take dog.stop()
    expect not before_expiry
    expect expired_once
    expect not expired_twice
    expect block.last_written(WatchdogRegs.status) == Some(Status.from_bits(1))
} an_expiry_is_reported_once

test stopping_disables_the_watchdog for Watchdog.stop {
    let block = hw::sim::Registers[WatchdogRegs].of(testing::world().alloc)
    let dog = Watchdog.start(block.mmio(), ticks: 10, prescaler: 3)
    take dog.stop()
    let disabled = block.last_written(WatchdogRegs.control)
    expect disabled == Some(Control(enable: false, reset_on_expiry: false, prescaler: 0, reserved: 0))
} stopping_disables_the_watchdog
