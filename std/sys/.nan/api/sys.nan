item "sys::RunnerService"
text "pub interface RunnerService {"
text "    fn send_to("
text "        self,"
text "        port: u64,"
text "        hash: ProtocolHash,"
text "        bytes: Slice[u8],"
text "        handles: Slice[Handle],"
text "        ) fails RunnerError limits stack 4_096"
text "    fn call("
text "        self,"
text "        port: u64,"
text "        hash: ProtocolHash,"
text "        bytes: Slice[u8],"
text "        handles: Slice[Handle],"
text "        alloc: mem::Alloc,"
text "        ) -> Encoded fails RunnerError uses wait limits stack 4_096"
text "    fn reply(self, request: u64, bytes: Slice[u8], handles: Slice[Handle]) fails RunnerError limits stack 4_096"
text "    fn publish(self, summary: Slice[u8]) fails RunnerError limits stack 4_096"
text "    fn sync(self) fails RunnerError limits stack 4_096"
text "    fn capability(self, id: u64) -> Handle fails RunnerError limits stack 4_096"
text "    fn drop_capability(self, id: u64) fails RunnerError limits stack 4_096"
text "    fn resource(self, id: u64) -> Held fails RunnerError uses wait limits stack 8_192"
text "    fn take_resource(self, id: u64) -> Held fails RunnerError uses wait limits stack 8_192"
text "    fn put_resource(self, id: u64, take resource: Held) fails RunnerError uses wait limits stack 8_192"
text "} RunnerService"
