//! Texts scanned: decimal numbers, lines and white space.

/// The value of a decimal number as the toolchain's own files and the system's write it: digits,
/// after at most one `+`, not exceeding 2^64 - 1.
pub fn parse_decimal(digits: Str) -> Option[u64] {
    var written = digits.as_bytes()
    if written.len() > 1 and written[0] == b'+' {
        let Some(parts) = written.split_at(1) else {
            return None
        }
        written = parts.tail
    }
    if written.len() == 0 {
        return None
    }
    var value: u64 = 0
    for byte in written {
        if byte < b'0' or byte > b'9' {
            return None
        }
        let Some(scaled) = value.checked_mul(10) else {
            return None
        }
        let Some(next) = scaled.checked_add(u64.widen(byte - b'0')) else {
            return None
        }
        value = next
    }
    return Some(value)
} parse_decimal

/// Where a line of a text lies, its ending excluded, and where the next one starts.
pkg struct Line derives Copy {
    pkg start: usize
    pkg end: usize
    pkg next: usize
} Line

/// The line of `written` starting at `at`: up to its LF, a CR before the LF excluded, or up to
/// the end of the text.
pkg fn next_line(written: Str, at: usize) -> Line {
    let bytes = written.as_bytes()
    for index in at..<bytes.len() {
        if bytes[index] != b'\n' {
            continue
        }
        if index > at and bytes[index - 1] == b'\r' {
            return Line(start: at, end: index - 1, next: index + 1)
        }
        return Line(start: at, end: index, next: index + 1)
    }
    return Line(start: at, end: bytes.len(), next: bytes.len())
} next_line

/// Where a run of characters lies in a text.
pub closed struct Run derives Copy {
    pub start: usize
    pub end: usize
} Run

/// The bytes of a text without the white space at its ends, empty at its start when it holds
/// nothing else.
pub fn trimmed_run(written: Str) -> Run {
    var start: usize = 0
    var end: usize = 0
    var found = false
    var at: usize = 0
    for c in written {
        let width = c.utf8_len()
        expect at <= written.byte_len() and width <= written.byte_len() - at
        if not is_white_space(c) {
            if not found {
                start = at
                found = true
            }
            end = at + width
        }
        at += width
    }
    return Run(start: start, end: end)
} trimmed_run

/// Whether a character has the Unicode `White_Space` property.
pub fn is_white_space(c: char) -> bool {
    return match c {
        '\t'..='\r' or ' ' or '\u{85}' or '\u{A0}' or '\u{1680}' => true
        '\u{2000}'..='\u{200A}' or '\u{2028}' or '\u{2029}' or '\u{202F}' or '\u{205F}' or '\u{3000}' => true
        else => false
    }
} is_white_space
