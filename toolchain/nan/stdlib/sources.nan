    \\    if difference.overflowed {
    \\        return None
    \\    }
    \\    return Some(difference.value)
    \\} i64.checked_sub
    \\
    \\pub fn i64.saturating_sub(self, other: i64) -> i64 limits pure, notrap, terminates
    \\    example 0i64.saturating_sub(1) == -1
    \\{
    \\    let difference = self.overflowing_sub(other)
    \\    if not difference.overflowed {
    \\        return difference.value
    \\    }
    \\    if other < 0 {
    \\        return 9_223_372_036_854_775_807
    \\    }
    \\    return -9_223_372_036_854_775_808
    \\} i64.saturating_sub
    \\
    \\pub fn i64.overflowing_mul(self, other: i64) -> Overflowing[i64] limits pure, notrap, terminates
    \\    example (-2i64).overflowing_mul(3) == Overflowing(value: -6, overflowed: false)
    \\{
    \\    let wide = self.wide_mul(other)
    \\    let value = i64.from_bits(wide.low)
    \\    let negative = (wide.low >> 63) == 1
    \\    let overflowed = not ((wide.high == 0 and not negative) or (wide.high == -1 and negative))
    \\    return Overflowing(value: value, overflowed: overflowed)
    \\} i64.overflowing_mul
    \\
    \\pub fn i64.checked_mul(self, other: i64) -> Option[i64] limits pure, notrap, terminates
    \\    example (-2i64).checked_mul(3) == Some(-6)
    \\{
    \\    let product = self.overflowing_mul(other)
    \\    if product.overflowed {
    \\        return None
    \\    }
    \\    return Some(product.value)
    \\} i64.checked_mul
    \\
    \\pub fn i64.saturating_mul(self, other: i64) -> i64 limits pure, notrap, terminates
    \\    example (-2i64).saturating_mul(3) == -6
    \\{
    \\    let product = self.overflowing_mul(other)
    \\    if not product.overflowed {
    \\        return product.value
    \\    }
    \\    if (self < 0) == (other < 0) {
    \\        return 9_223_372_036_854_775_807
    \\    }
    \\    return -9_223_372_036_854_775_808
    \\} i64.saturating_mul
    \\
    \\pub fn i64.wrapping_neg(self) -> i64 limits pure, notrap, terminates
    \\    example (-5i64).wrapping_neg() == 5
    \\{
    \\    return 0i64.wrapping_sub(self)
    \\} i64.wrapping_neg
    \\
    \\pub fn i64.overflowing_neg(self) -> Overflowing[i64] limits pure, notrap, terminates
    \\    example (-5i64).overflowing_neg() == Overflowing(value: 5, overflowed: false)
    \\{
    \\    return Overflowing(value: self.wrapping_neg(), overflowed: self == -9_223_372_036_854_775_808)
    \\} i64.overflowing_neg
    \\
    \\pub fn i64.checked_neg(self) -> Option[i64] limits pure, notrap, terminates
    \\    example (-5i64).checked_neg() == Some(5)
    \\{
    \\    if self == -9_223_372_036_854_775_808 {
    \\        return None
    \\    }
    \\    return Some(-self)
    \\} i64.checked_neg
    \\
    \\pub fn i64.saturating_neg(self) -> i64 limits pure, notrap, terminates
    \\    example (-5i64).saturating_neg() == 5
    \\{
    \\    if self == -9_223_372_036_854_775_808 {
    \\        return 9_223_372_036_854_775_807
    \\    }
    \\    return -self
    \\} i64.saturating_neg
    \\
    \\pub fn i64.div_trunc(self, divisor: i64) -> i64 limits pure, terminates
    \\    example (-7i64).div_trunc(2) == -3
    \\
    \\pub fn i64.rem_trunc(self, divisor: i64) -> i64 limits pure, terminates
    \\    example (-7i64).rem_trunc(2) == -1
    \\
    \\pub fn i64.div_floor(self, divisor: i64) -> i64 limits pure, terminates
    \\    example (-7i64).div_floor(2) == -4
    \\{
    \\    let quotient = self.div_trunc(divisor)
    \\    let remainder = self.rem_trunc(divisor)
    \\    if remainder != 0 and (remainder < 0) != (divisor < 0) {
    \\        return quotient - 1
    \\    }
    \\    return quotient
    \\} i64.div_floor
    \\
    \\pub fn i64.mod_floor(self, divisor: i64) -> i64 limits pure, terminates
    \\    example (-7i64).mod_floor(2) == 1
    \\{
    \\    let remainder = self.rem_trunc(divisor)
    \\    if remainder != 0 and (remainder < 0) != (divisor < 0) {
    \\        return remainder + divisor
    \\    }
    \\    return remainder
    \\} i64.mod_floor
    \\
    \\pub fn i64.shr_arith(self, amount: u32) -> i64 limits pure, terminates
