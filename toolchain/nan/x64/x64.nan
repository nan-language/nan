//! The x86-64 instruction set: its registers, numbered 0 to 15 for the general-purpose ones and 16 to 31 for the SSE ones, its instructions and their encoding.

pkg const RAX: machinst::Reg = machinst::Reg(index: 0)

pkg const RCX: machinst::Reg = machinst::Reg(index: 1)

pkg const RDX: machinst::Reg = machinst::Reg(index: 2)

pkg const RBX: machinst::Reg = machinst::Reg(index: 3)

pkg const RSP: machinst::Reg = machinst::Reg(index: 4)

pkg const RBP: machinst::Reg = machinst::Reg(index: 5)

pkg const RSI: machinst::Reg = machinst::Reg(index: 6)

pkg const RDI: machinst::Reg = machinst::Reg(index: 7)

pkg const R8: machinst::Reg = machinst::Reg(index: 8)

pkg const R9: machinst::Reg = machinst::Reg(index: 9)

pkg const R10: machinst::Reg = machinst::Reg(index: 10)

pkg const R11: machinst::Reg = machinst::Reg(index: 11)

pkg const R12: machinst::Reg = machinst::Reg(index: 12)

pkg const R13: machinst::Reg = machinst::Reg(index: 13)

pkg const R14: machinst::Reg = machinst::Reg(index: 14)

pkg const R15: machinst::Reg = machinst::Reg(index: 15)

/// An SSE register by its number.
pkg fn xmm(number: u32) -> machinst::Reg
    requires number < 16
    ensures is_xmm(result)
{
    return machinst::Reg(index: 16 + number)
} xmm

/// Whether a register is a physical SSE register.
pkg fn is_xmm(reg: machinst::Reg) -> bool = reg.index >= 16 and reg.index < 32

/// The 4-bit number of a physical register in its instruction encodings.
pkg fn hw(reg: machinst::Reg) -> u8 = u8.truncate(reg.index & 15)

/// The registers a System V call may change: every SSE register and the general-purpose
/// registers other than `rbx`, `rsp`, `rbp` and `r12` to `r15`.
pkg fn caller_saved() -> machinst::RegSet = machinst::RegSet(bits: 0xFFFF_0FC7)

/// Every register other than `rsp` and `rbp`.
pkg fn all_regs() -> machinst::RegSet = machinst::RegSet(bits: 0xFFFF_FFCF)

/// The width of an operation: 8, 16, 32 or 64 bits, or for SSE scalars 32 (`f32`) or 64 (`f64`).
pkg enum Size derives Copy, Eq {
    Byte
    Word
    Dword
    Qword
} Size

/// The width of a number of bits, 64 for any other.
pkg fn Size.of_bits(bits: u32) -> Size {
    return match bits {
        8 => Size.Byte
        16 => Size.Word
        32 => Size.Dword
        else => Size.Qword
    }
} Size.of_bits

/// A condition on the flags, numbered as the `jcc`, `setcc` and `cmovcc` encodings number it.
pkg enum Cond derives Copy, Eq {
    Overflow
    NoOverflow
    Below
    AboveOrEqual
    Equal
    NotEqual
    BelowOrEqual
    Above
    Sign
    NoSign
    Parity
    NoParity
    Less
    GreaterOrEqual
    LessOrEqual
    Greater
} Cond

pkg fn Cond.code(self) -> u8
    ensures result <= 15
{
    return match self {
        Cond.Overflow => 0
        Cond.NoOverflow => 1
        Cond.Below => 2
        Cond.AboveOrEqual => 3
        Cond.Equal => 4
        Cond.NotEqual => 5
        Cond.BelowOrEqual => 6
        Cond.Above => 7
        Cond.Sign => 8
        Cond.NoSign => 9
        Cond.Parity => 10
        Cond.NoParity => 11
        Cond.Less => 12
        Cond.GreaterOrEqual => 13
        Cond.LessOrEqual => 14
        Cond.Greater => 15
    }
} Cond.code

/// The condition holding exactly when this one does not.
pkg fn Cond.invert(self) -> Cond {
    return match self {
        Cond.Overflow => Cond.NoOverflow
        Cond.NoOverflow => Cond.Overflow
        Cond.Below => Cond.AboveOrEqual
        Cond.AboveOrEqual => Cond.Below
        Cond.Equal => Cond.NotEqual
        Cond.NotEqual => Cond.Equal
        Cond.BelowOrEqual => Cond.Above
        Cond.Above => Cond.BelowOrEqual
        Cond.Sign => Cond.NoSign
        Cond.NoSign => Cond.Sign
        Cond.Parity => Cond.NoParity
        Cond.NoParity => Cond.Parity
        Cond.Less => Cond.GreaterOrEqual
        Cond.GreaterOrEqual => Cond.Less
        Cond.LessOrEqual => Cond.Greater
        Cond.Greater => Cond.LessOrEqual
    }
} Cond.invert

/// What a RIP-relative operand addresses: a label of the code, a symbol, or the global offset
/// table entry holding a symbol's address.
pkg enum RipTarget derives Copy, Eq {
    Label(u32)
    Direct(machinst::Symbol)
    Got(machinst::Symbol)
} RipTarget

/// A memory operand: `base + index * 2^shift + disp`, or `rip + disp` from a target.
pkg enum Amode derives Copy, Eq {
    Mem(base: machinst::Reg, index: Option[machinst::Reg], shift: u8, disp: i32)
    Rip(target: RipTarget, disp: i32)
} Amode

/// `[base + disp]`.
pkg fn Amode.at(base: machinst::Reg, disp: i32) -> Amode = Amode.Mem(base: base, index: None, shift: 0, disp: disp)

/// The operand `disp` bytes further on.
pkg fn Amode.offset(self, disp: i32) -> Amode {
    return match self {
        Amode.Mem(base: base, index: index, shift: shift, disp: at) => Amode.Mem(base: base, index: index, shift: shift, disp: at.wrapping_add(disp))
        Amode.Rip(target: target, disp: at) => Amode.Rip(target: target, disp: at.wrapping_add(disp))
    }
} Amode.offset
