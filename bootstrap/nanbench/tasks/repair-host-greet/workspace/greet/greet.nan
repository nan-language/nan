//! Entry of the greeter, its argument and its greeting.

pub closed enum GreetError derives Render {
    Usage
    Stdio(sys::StdioError) from
    Cancelled(task::Cancelled) from
} GreetError

/// The longest name accepted, in bytes.
const LONGEST_NAME: usize = 32

fn main(take world: host::World) fails GreetError uses wait {
    world.log.info("arguments", value: world.args.inspect().len())
    let name = try parse_name(world.args, alloc: world.alloc)
    let line = greeting(name.as_str(), alloc: world.alloc)
    try await world.stdio.write_out(line.as_bytes())
} main

/// The value of the one argument `--name=<value>`, 1 to `LONGEST_NAME` ASCII letters.
pub validator fn parse_name(args: Untrusted[mem::List[mem::Bytes]], alloc: mem::Alloc) -> text::String fails GreetError {
    let given = args.inspect()
    if given.len() != 1 {
        fail GreetError.Usage
    }
    let Some(parts) = given[0].view().split_at(7) else {
        fail GreetError.Usage
    }
    if parts.head != b"--name=" or parts.tail.len() == 0 or parts.tail.len() > LONGEST_NAME {
        fail GreetError.Usage
    }
    var name = text::String.empty(alloc)
    for byte in parts.tail {
        let lower = byte >= b'a' and byte <= b'z'
        let upper = byte >= b'A' and byte <= b'Z'
        if not (lower or upper) {
            fail GreetError.Usage
        }
        let Some(letter) = char.checked_from_bits(u32.widen(byte)) else {
            fail GreetError.Usage
        }
        mut name.push(letter)
    }
    return name
} parse_name

/// The name with its first character in ASCII upper case.
pub fn capitalized(name: Str, alloc: mem::Alloc) -> text::String {
    var out = text::String.empty(alloc)
    if name.len() == 0 {
        return out
    }
    mut out.push(name[0].to_ascii_uppercase())
    mut out.append(name.slice_bytes(1, end: name.byte_len()))
    return out
} capitalized

/// `Hello, `, the name capitalized, `!` and a line feed.
pub fn greeting(name: Str, alloc: mem::Alloc) -> text::String {
    let shown = capitalized(name, alloc)
    var line = text::String.empty(alloc)
    mut line.write(text::fmt("Hello, {shown}!\n"), budget: 128)
    return line
} greeting
