test handled_work_carries_the_delivered_header for Stepper.deliver_headed {
    let world = testing::world()
    var stepper = try Stepper[Traced, TracedEnv, Trace].start(TracedEnv(), exec: world.exec, alloc: world.alloc)
    defer take stepper.abandon()
    mut stepper.deliver_headed(Trace.Begin, header: marked())
    discard mut stepper.start_keyed()
    while try await stepper.ready() {
        discard mut stepper.step()
    }
    undefer stepper
    let last = try await take stepper.end()
    expect last.state.marked == 3
} handled_work_carries_the_delivered_header

test plain_delivery_has_no_header for current_header {
    let world = testing::world()
    var stepper = try Stepper[Traced, TracedEnv, Trace].start(TracedEnv(), exec: world.exec, alloc: world.alloc)
    mut stepper.deliver(Trace.Sent)
    let last = try await take stepper.end()
    expect current_header() == None
    expect last.state.marked == 0
} plain_delivery_has_no_header

test bodies_and_the_tasks_they_start_carry_the_given_header for run_headed {
    let world = testing::world()
    let marked_children = task::Cown.of(0u32, alloc: world.alloc)
    let inner = try await run_headed(marked(), body: fn() -> Option[Header] fails task::Cancelled uses wait {
        try await task::scope(world.exec, body: fn(s: task::Scope) {
            discard s.spawn(fn() fails task::Cancelled uses wait {
                if current_header() == Some(marked()) {
                    await when mut marked_children {
                        marked_children += 1
                    }
                }
            })
        })
        return current_header()
    })
    let children = await when marked_children => marked_children
    expect inner == Some(marked())
    expect children == 1
    expect current_header() == None
} bodies_and_the_tasks_they_start_carry_the_given_header

test steps_take_the_intake_oldest_first for Stepper.step {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    mut stepper.deliver(ProbeMessage.Echo)
    mut stepper.deliver(ProbeMessage.Echo)
    let earliest = mut stepper.step()
    let latest = mut stepper.step()
    let none = mut stepper.step()
    let last = try await take stepper.end()
    expect earliest == Some(Handled(header: None, operation: 0)) and latest.is_some() and none.is_none()
    expect last.state.handled == 2
} steps_take_the_intake_oldest_first

test steps_give_the_header_and_operation_they_handle for Stepper.step {
    let world = testing::world()
    var stepper = try Stepper[Traced, TracedEnv, Trace].start(TracedEnv(), exec: world.exec, alloc: world.alloc)
    defer take stepper.abandon()
    mut stepper.deliver_headed(Trace.Begin, header: marked())
    let sent = mut stepper.step()
    discard mut stepper.start_keyed()
    discard try await stepper.ready()
    let posted = mut stepper.step()
    undefer stepper
    discard try await take stepper.end()
    expect sent == Some(Handled(header: Some(marked()), operation: 1))
    expect posted == Some(Handled(header: Some(marked()), operation: 2))
} steps_give_the_header_and_operation_they_handle

