//! Bridges between the jobs and instances of isolated spaces and the instances answering their calls: the kernel's side, which maps the channel a job or instance calls a port or a capability of a crossing kind through into the space of the instance answering those calls, opens, rings and closes the ends of each, carries what crosses with a call or reply between the spaces' tables and frames and admits each call through such a capability, and the runtime's side of each end, which writes the records of the calls its job or instance makes, or of the replies to the calls it serves, into the frame the end writes, reads the other end's from the frame it reads, and rings the other end only while that end waits.

/// The operations of the end of a bridge a space holds: telling its other end that it wrote or
/// read, telling its kernel it no longer reads or writes its frames, doing so because its other
/// end wrote what no end writes, carrying handles of the space's table into the other end's, and
/// claiming what crossed into the space's table for it.
const BRIDGE_RING: u64 = 0

const BRIDGE_CLOSED: u64 = 1

const BRIDGE_BREACH: u64 = 2

const BRIDGE_CARRY: u64 = 3

const BRIDGE_CLAIM: u64 = 4

/// The operations of the end of a bridge through which bytes move between spaces in frames of their
/// own: moving pages of the space to the other end, giving the length of what moved into the space
/// for it under a token, and mapping those frames into the space.
const BRIDGE_MOVE: u64 = 5

const BRIDGE_SIZE: u64 = 6

const BRIDGE_ACCEPT: u64 = 7

/// The operation of the end of a bridge serving the calls of a capability of a crossing kind:
/// having its kernel admit a call through that capability.
const BRIDGE_ADMIT: u64 = 8

/// What a space's runtime is told of the end of a bridge its job or instance holds: that an end
/// serving calls opened, that its other end wrote or read, and that it is closed, by its handle.
enum Bridging derives Copy, Encode {
    Opened(EndAt)
    Rang(u64)
    Closed(u64)
} Bridging

/// An end of a bridge: its handle, what it does, and the addresses at which its space maps the
/// frame it reads and the frame it writes.
struct EndAt derives Copy, Encode {
    handle: u64
    side: Side
    inbound: u64
    outbound: u64
} EndAt

/// What an end of a bridge does: carries the calls its job or instance makes through a port of its
/// runner capability or through a capability of a crossing kind, or serves calls, each admitted by
/// its kernel first when true.
enum Side derives Copy, Encode {
    Port(u64)
    Kind(Riding)
    Serving(bool)
} Side

/// The calls of a capability of a crossing kind an end of a bridge carries: those of the operation
/// `operation` of the capability of the entry `handle` of the space's table, as calls of the
/// protocol of `hash`.
struct Riding derives Copy, Encode {
    handle: u64
    operation: u64
    hash: sys::ProtocolHash
} Riding

/// The capability of a crossing kind through which the kernel admits each call an end of a bridge
/// serves, by `invoke` of `operation` on the call's bytes.
struct Admission derives Copy {
    capability: sys::Handle
    operation: u64
} Admission

/// The ends of bridges to open for the job or instance numbered `id`.
struct Opening {
    id: u64
    ends: mem::List[Bridged]
} Opening

/// The end of a bridge, by the handle of its entry in the table of the space mapping it, that the
/// job or instance numbered `id` holds.
struct Ringing {
    id: u64
    handle: u64
} Ringing

/// An ask to close the end of a bridge, by its handle, that the job or instance numbered `id` holds,
/// and the sender the asking task waits on until that end is closed.
struct Closing {
    id: u64
    handle: u64
    done: Option[task::Sender[u8]]
} Closing

/// The end of a bridge a space maps, and the handle of its entry in the space's table.
struct Bridged {
    handle: u64
    end: BridgeEnd
} Bridged

/// The end of a bridge: the job or instance holding it, the door of the isolation holding its other
/// end, that end's job or instance and handle, what it does, the capability admitting the calls it
/// serves, the addresses at which its space maps the frame it reads and the frame it writes, whether
/// it unmaps them once closed, and the senders of the tasks waiting for it to close.
struct BridgeEnd {
    job: u64
    peer: Doorway
    peer_job: u64
    peer_handle: u64
    side: Side
    admission: Option[Admission]
    inbound: u64
    outbound: u64
    unmaps: bool
    closing: mem::List[task::Sender[u8]]
} BridgeEnd

/// What crossed into a table for the end of a bridge whose handle is `handle`, under its token.
struct Carry {
    token: u64
    handle: u64
    carried: mem::List[Carried]
} Carry

/// A channel of a link carrying the calls of a port that a space maps: its index in the link, and
/// the addresses at which the space maps its inbound and outbound frames.
struct Ported derives Copy {
    channel: usize
    inbound: u64
    outbound: u64
} Ported

/// Maps into a space each channel of a link bridged for a job or, when `instance`, an instance, each
/// frame cleared, giving where it maps them; a channel the space has no room for is left out.
fn ports_mapped(mut space: sys::load::Space, link: Link, instance: bool, alloc: mem::Alloc) -> mem::List[Ported] {
    var ports = mem::List[Ported].empty(alloc)
    for index in 0..<link.channels.len() {
        let channel = link.channels[index]
        let Some(porting) = channel.port else {
            continue
        }
        if not porting.bridged(instance) {
            continue
        }
        wiped(channel.inbound)
        wiped(channel.outbound)
        let Ok(inbound) = attempt mut space.share(channel.inbound) else {
            continue
        }
        let Ok(outbound) = attempt mut space.share(channel.outbound) else {
            mut space.unshare(inbound)
            continue
        }
        mut ports.push(Ported(channel: index, inbound: inbound, outbound: outbound))
    }
    return ports
} ports_mapped

/// The two ends of a bridge: the end a space maps, and where the other end lies.
struct Spanning {
    near: Bridged
    far: PeerEnd
} Spanning

/// The end of a bridge another space maps: the door of its isolation, the number of the instance
/// holding it, and the handle of its entry in that space's table.
struct PeerEnd {
    door: Doorway
    id: u64
    handle: u64
} PeerEnd

/// Opens a bridge for the channel `port` of `link`, which the space of the job or instance numbered
/// `id` maps, to the instance answering the calls it carries: maps that channel into the instance's
/// space, opening the end there, and gives both ends; none, the tables taking back the ends' entries,
/// when that instance no longer runs, a table or its space has no room, or `caps` holds no
/// capability of a crossing kind under the key whose calls the channel carries.
fn bridge_opened(isolation: Isolation, id: u64, link: Link, caps: Caps, port: Ported, alloc: mem::Alloc) -> Option[Spanning] fails task::Cancelled uses wait {
    let channel = link.channels[port.channel]
    let Some(Porting(through: through, to: Some(target))) = channel.port else {
        return None
    }
    let Some(Sides(near: side, admission: admission)) = sides_of(through, table: isolation.door.contents().table, id, caps) else {
        return None
    }
    let Some(target_door) = target.door.reached() else {
        return None
    }
    let near = isolation.door.contents().table.held_by(job: id, holding: Holding.Bridge)
    let far = target_door.contents().table.held_by(job: target.id, holding: Holding.Bridge)
    if near == MOST_HELD or far == MOST_HELD {
        isolation.door.contents().table.taken(near)
        target_door.contents().table.taken(far)
        return None
    }
    let task::Channel(sender: lend, receiver: lent) = task::Channel[Lending].bounded(1, alloc)
    discard attempt await target_door.contents().asked(Ask.Lend(Borrowing(id: target.id, lend: take lend)))
    var lendings = mem::List[Lending].empty(alloc)
    discard attempt await take lent.drain(visit: fn[mut lendings](take value: Lending) {
        mut lendings.push(take value)
    })
    var mapped_far = false
    for lending in take lendings {
        let Lending(space: given, back: back) = lending
        var space = given
        var ends = mem::List[Bridged].empty(alloc)
        match attempt mut space.share(channel.outbound) {
            Ok(inbound) => match attempt mut space.share(channel.inbound) {
                Ok(outbound) => {
                    mut ends.push(Bridged(handle: far, end: BridgeEnd(job: target.id, peer: isolation.way, peer_job: id, peer_handle: near, side: Side.Serving(admission.is_some()), admission: admission, inbound: inbound, outbound: outbound, unmaps: true, closing: mem::List[task::Sender[u8]].empty(alloc))))
                    mapped_far = true
                }
                Err(_) => mut space.unshare(inbound)
            }
            Err(_) => {}
        }
        discard attempt await back.send(Lent(space: take space, frames: mem::List[u64].empty(alloc), ported: mem::List[u64].empty(alloc), ends: take ends, given: mem::List[hw::PhysFrame[4_096]].empty(alloc)))
    }
    if not mapped_far {
        isolation.door.contents().table.taken(near)
        target_door.contents().table.taken(far)
        return None
    }
    let own = BridgeEnd(job: id, peer: target.door, peer_job: target.id, peer_handle: far, side: side, admission: None, inbound: port.inbound, outbound: port.outbound, unmaps: false, closing: mem::List[task::Sender[u8]].empty(alloc))
    return Some(Spanning(near: Bridged(handle: near, end: take own), far: PeerEnd(door: target.door, id: target.id, handle: far)))
} bridge_opened

/// What the end of a bridge a job or instance calls through does, and the capability admitting each
/// call its other end serves.
struct Sides {
    near: Side
    admission: Option[Admission]
} Sides

/// The sides of a bridge carrying the calls `through` names for the job or instance numbered `id`:
/// through a port, or through the capability of a crossing kind `caps` holds under a key, by the
/// entry the space's `table` holds for it; none when `caps` holds no such capability or the table no
/// entry of it.
fn sides_of(through: Through, table: Table, id: u64, caps: Caps) -> Option[Sides] {
    let calls = match through {
        Through.Port(number) => return Some(Sides(near: Side.Port(number), admission: None))
        Through.Kind(kind) => kind
    }
    for held in caps.held {
        if held.key.as_str() != calls.key.as_str() or not held.handle.crosses() {
            continue
        }
        match table.crossed(job: id, word: handle_word(held.handle)) {
            Some(handle) => return Some(Sides(near: Side.Kind(Riding(handle: handle, operation: calls.operation, hash: calls.hash)), admission: Some(Admission(capability: held.handle, operation: calls.operation))))
            None => {}
        }
    }
    return None
} sides_of

/// Closes the end of a bridge another space maps, waiting until that space no longer maps it.
fn far_closed(far: PeerEnd, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: closed) = task::Channel[u8].bounded(1, alloc)
    try await far.door.asked(Ask.Close(Closing(id: far.id, handle: far.handle, done: Some(take done))))
    discard attempt await take closed.drain(visit: fn(take value: u8) {})
} far_closed

/// Lends the space `placing` holds, while it runs the instance `borrowing` names, to the task
/// asking, which maps the frames of a bridge into it, and opens the ends of bridges it gives back
/// with the space; without such a space the ask is dropped.
fn lent_for(take borrowing: Borrowing, mut placing: mem::List[Placed], mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Borrowing(id: id, lend: lend) = borrowing
    let Some(placed) = mut placing.pop() else {
        return
    }
    let Placed(space: made, driving: kept) = placed
    if not kept.jobs.contains(id) {
        mut placing.push(Placed(space: take made, driving: take kept))
        return
    }
    let task::Channel(sender: back, receiver: giving) = task::Channel[Lent].bounded(1, alloc)
    match lend.offer(Lending(space: take made, back: take back)) {
        Some(Lending(space: refused, back: _)) => {
            mut placing.push(Placed(space: take refused, driving: take kept))
            var strays = mem::List[Lent].empty(alloc)
            discard attempt await take giving.drain(visit: fn[mut strays](take value: Lent) {
                mut strays.push(take value)
            })
            lents_released(take strays, mut frames)
            return
        }
        None => {}
    }
    discard lend
    var given = mem::List[Lent].empty(alloc)
    discard attempt await take giving.drain(visit: fn[mut given](take value: Lent) {
        mut given.push(take value)
    })
    let Some(lent) = mut given.pop() else {
        lents_released(take given, mut frames)
        return
    }
    lents_released(take given, mut frames)
    let Lent(space: given_back, frames: _, ported: _, ends: ends, given: lending) = lent
    frames_given(take lending, mut frames)
    var space = given_back
    var held = kept
    for opening in take ends {
        mut held.bridge_opened(mut space, take opening)
    }
    mut placing.push(Placed(space: take space, driving: take held))
} lent_for

/// Applies to the space `placing` holds an ask to open the ends of bridges, to tell the end of one
/// that its other end rang, to close an end, to end an instance as breaching a channel, or to tell
/// a job or instance the result of a waiting call; without a space the ask is dropped.
fn placed_asked(take ask: Ask, mut placing: mem::List[Placed], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Some(placed) = mut placing.pop() else {
        return
    }
    let Placed(space: made, driving: kept) = placed
    var space = made
    var held = kept
    match ask {
        Ask.Open(Opening(id: id, ends: ends)) => mut held.ends_opened(id, take ends)
        Ask.Ring(Ringing(id: id, handle: handle)) => mut held.rang(id, handle)
        Ask.Close(Closing(id: id, handle: handle, done: done)) => mut held.closing(id, handle, take done)
        Ask.Breach(id) => mut held.breached(mut space, id, alloc)
        Ask.Resolve(Resolution(id: id, reply: reply)) => mut held.resolved(id, take reply)
        else => {}
    }
    discard attempt await mut held.left()
    mut placing.push(Placed(space: take space, driving: take held))
} placed_asked

/// An ask for the isolation a doorway reaches.
struct Leaving {
    door: Doorway
    ask: Ask
} Leaving

/// Serves an operation of the end of a bridge the space holds by `handle`: rings its other end;
/// closes it, taking back its entry, dropping what the door kept for it, giving back to `frames`
/// those that moved for it and unmapping the frames it maps for itself; closes it as breached by
/// its other end, whose job or instance ends; carries the handles of the space's table it names
/// into the table of the other end's space, giving the token its runtime claims them by; admits a
/// call it serves through the capability its kernel admits them through, `STALE` once that is
/// stale; or claims what crossed into the space's table for it by a token, written at `target` when
/// it fits `capacity`, giving its length either way.
fn Driven.bridge_invoked(mut self, mut space: sys::load::Space, handle: u64, operation: u64, args: Untrusted[mem::Bytes], target: u64, capacity: u64, mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let Some(bridge) = self.bridges.get(handle) else {
        return STALE
    }
    let peer = bridge.peer
    let peer_job = bridge.peer_job
    let peer_handle = bridge.peer_handle
    if operation == BRIDGE_RING {
        try await peer.asked(Ask.Ring(Ringing(id: peer_job, handle: peer_handle)))
        return 0
    }
    if operation == BRIDGE_CLOSED or operation == BRIDGE_BREACH {
        if operation == BRIDGE_BREACH {
            try await peer.asked(Ask.Breach(peer_job))
        }
        mut self.end_closed(mut space, handle)
        try await self.door.contents().carries_dropped()
        try await self.door.contents().moves_dropped(mut frames, alloc)
        return 0
    }
    if operation == BRIDGE_CARRY {
        let Ok(handles) = attempt mem::wire::Codec[mem::List[u64]].decode(args.view(), alloc) else {
            return INVALID
        }
        let Some(given) = self.door.contents().table.handed(handles, alloc) else {
            return INVALID
        }
        let Some(peer_door) = peer.reached() else {
            return INVALID
        }
        let Some(crossing) = peer_door.contents().table.admitted(job: peer_job, handles: given.view(), alloc) else {
            return INVALID
        }
        return try await peer_door.contents().carry(handle: peer_handle, take crossing)
    }
    if operation == BRIDGE_ADMIT {
        let Some(admission) = bridge.admission else {
            return INVALID
        }
        let Ok(Admitting(header: header, bytes: bytes)) = attempt mem::wire::Codec[Admitting].decode(args.view(), alloc) else {
            return INVALID
        }
        let none = mem::List[sys::Handle].empty(alloc)
        let invoked = attempt await under_header(header_of(header), body: fn() -> sys::Encoded fails sys::CrossError {
            return try admission.capability.invoke(admission.operation, args: bytes.view(), handles: none.view(), alloc)
        })
        return match invoked {
            Ok(_) => 0
            Err(sys::CrossError.Revoked(_)) => STALE
            Err(sys::CrossError.Refused) or Err(sys::CrossError.Cancelled(_)) => INVALID
        }
    }
    if operation == BRIDGE_MOVE {
        let Ok(span) = attempt mem::wire::Codec[Span].decode(args.view(), alloc) else {
            return INVALID
        }
        return try await moved_out(peer, handle: peer_handle, span, mut space, mut frames, alloc)
    }
    if operation == BRIDGE_ACCEPT {
        let Ok(accepting) = attempt mem::wire::Codec[Accepting].decode(args.view(), alloc) else {
            return INVALID
        }
        return try await self.door.contents().accepted(handle, accepting, mut space, mut frames, alloc)
    }
    let Ok(token) = attempt mem::wire::Codec[u64].decode(args.view(), alloc) else {
        return INVALID
    }
    if operation == BRIDGE_SIZE {
        return try await self.door.contents().moved_len(handle, token, alloc)
    }
    if operation != BRIDGE_CLAIM {
        return INVALID
    }
    let Some(bytes) = try await self.door.contents().claimed(handle, token, capacity, alloc) else {
        return INVALID
    }
    let len = u64.widen(bytes.len())
    if len > capacity {
        return len
    }
    return written_back(mut space, address: target, bytes, count: len)
} Driven.bridge_invoked

/// Keeps what crossed into the door's table for the end of a bridge whose handle is `handle`,
/// giving the token its runtime claims it by; once the table no longer names that end, releases
/// what crossed instead.
fn Door.carry(self, handle: u64, take crossing: mem::List[Carried]) -> u64 fails task::Cancelled uses wait {
    let token = self.tokens.fetch_add(1).value_or(0)
    let carries = self.carries.share()
    await when mut carries {
        if self.table.entry(handle).is_some() {
            mut carries.push(Carry(token: token, handle: handle, carried: take crossing))
        } else {
            self.table.crossings_released(crossing.view())
        }
    }
    return token
} Door.carry

/// Drops what the door keeps for each end of a bridge its table no longer names, releasing what
/// crossed for it.
fn Door.carries_dropped(self) fails task::Cancelled uses wait {
    let carries = self.carries.share()
    await when mut carries {
        mut carries.retain(keep: fn(carry: Carry) -> bool {
            if self.table.entry(carry.handle).is_some() {
                return true
            }
            self.table.crossings_released(carry.carried.view())
            return false
        })
    }
} Door.carries_dropped

test carries_of_ends_taken_back_are_dropped for Door.carries_dropped {
    let world = testing::world()
    let door = Door.of(Services(clock: world.clock, log: world.log, stdio: world.stdio, random: world.random, fs: world.fs), moves: None, alloc: world.alloc)
    let closed = door.table.held_by(job: 1, holding: Holding.Bridge)
    let open = door.table.held_by(job: 1, holding: Holding.Bridge)
    var logs = mem::List[sys::Handle].empty(world.alloc)
    mut logs.push(sys::Handle.of(world.log))
    let Some(early_crossing) = door.table.admitted(job: 1, handles: logs.view(), alloc: world.alloc) else {
        expect false
        return
    }
    let Some(late_crossing) = door.table.admitted(job: 1, handles: logs.view(), alloc: world.alloc) else {
        expect false
        return
    }
    let early_handle = early_crossing[0].handle()
    let late_handle = late_crossing[0].handle()
    let early = try await door.carry(handle: closed, crossing: take early_crossing)
    let live = try await door.carry(handle: open, crossing: mem::List[Carried].empty(world.alloc))
    door.table.taken(closed)
    try await door.carries_dropped()
    let late = try await door.carry(handle: closed, crossing: take late_crossing)
    let early_left = try await door.claimed(handle: closed, token: early, capacity: 4_096, alloc: world.alloc)
    let late_left = try await door.claimed(handle: closed, token: late, capacity: 4_096, alloc: world.alloc)
    let live_left = try await door.claimed(handle: open, token: live, capacity: 4_096, alloc: world.alloc)
    let entries_left = door.table.entry(early_handle).is_some() or door.table.entry(late_handle).is_some()
    expect early_left.is_none() and late_left.is_none() and live_left.is_some() and not entries_left
} carries_of_ends_taken_back_are_dropped

/// The encoding of what crossed into the door's table for the end of a bridge whose handle is
/// `handle` under `token`, which it no longer keeps once the encoding fits `capacity`; none when
/// it keeps nothing under `token` for that end.
fn Door.claimed(self, handle: u64, token: u64, capacity: u64, alloc: mem::Alloc) -> Option[mem::Bytes] fails task::Cancelled uses wait {
    let carries = self.carries.share()
    var found: Option[mem::Bytes] = None
    await when mut carries {
        for index in 0..<carries.len() {
            if carries[index].token == token and carries[index].handle == handle {
                let bytes = encoded(carries[index].carried, alloc)
                if u64.widen(bytes.len()) <= capacity {
                    discard mut carries.remove(index)
                }
                found = Some(take bytes)
                break
            }
        }
    }
    return found
} Door.claimed

/// Opens the ends of bridges for the job or instance numbered `id`, which its runtime starts from now
/// on with them; the ends are dropped once it has ended, or at once when it is no longer pending.
fn Driven.ends_opened(mut self, id: u64, take ends: mem::List[Bridged]) {
    var found: Option[usize] = None
    for index in 0..<self.pending.len() {
        if self.pending[index].id == id {
            found = Some(index)
        }
    }
    let Some(at) = found else {
        return
    }
    for opening in take ends {
        let Bridged(handle: handle, end: opened_end) = opening
        mut self.pending[at].granting.ends.push(EndAt(handle: handle, side: opened_end.side, inbound: opened_end.inbound, outbound: opened_end.outbound))
        discard mut self.bridges.insert(handle, value: take opened_end)
    }
    self.pending[at].bridging = false
} Driven.ends_opened

/// Opens the end of a bridge the space maps for an instance it runs: tells the runtime of the
/// instance holding it, and has the frames the end maps for itself unmapped once that instance
/// ends, or at once, the table taking back the end's entry, when it has.
fn Driven.bridge_opened(mut self, mut space: sys::load::Space, take opening: Bridged) {
    let Bridged(handle: handle, end: opened_end) = opening
    let Some(found) = mut self.jobs.get_mut(opened_end.job) else {
        self.door.contents().table.taken(handle)
        if opened_end.unmaps {
            mut space.unshare(opened_end.inbound)
            mut space.unshare(opened_end.outbound)
        }
        return
    }
    var running = found
    if opened_end.unmaps {
        mut running.frames.push(opened_end.inbound)
        mut running.frames.push(opened_end.outbound)
    }
    mut self.notices.push(Notice(id: opened_end.job, told: Telling.Bridge(Bridging.Opened(EndAt(handle: handle, side: opened_end.side, inbound: opened_end.inbound, outbound: opened_end.outbound)))))
    discard mut self.bridges.insert(handle, value: take opened_end)
} Driven.bridge_opened

/// Tells the runtime of the job or instance numbered `id` that the other end of the end of a bridge
/// it holds by `handle` wrote or read, unless it is told so already.
fn Driven.rang(mut self, id: u64, handle: u64) {
    let Some(bridge) = self.bridges.get(handle) else {
        return
    }
    if bridge.job != id {
        return
    }
    for notice in self.notices {
        match notice.told {
            Telling.Bridge(Bridging.Rang(queued)) => {
                if queued == handle {
                    return
                }
            }
            else => {}
        }
    }
    mut self.notices.push(Notice(id: id, told: Telling.Bridge(Bridging.Rang(handle))))
} Driven.rang

/// Tells the runtime of the job or instance numbered `id`, while it runs, the reply to a waiting
/// operation of a crossing kind's capability it called through its runner capability.
fn Driven.resolved(mut self, id: u64, take reply: PortReply) {
    let Some(found) = mut self.jobs.get_mut(id) else {
        return
    }
    var running = found
    running.calling = running.calling.saturating_sub(1)
    mut self.notices.push(Notice(id: id, told: Telling.Reply(take reply)))
} Driven.resolved

/// Has the runtime of the job or instance numbered `id` close the end of a bridge it holds by
/// `handle`, `done` held until the end is closed.
fn Driven.closing(mut self, id: u64, handle: u64, take done: Option[task::Sender[u8]]) {
    let Some(found) = mut self.bridges.get_mut(handle) else {
        return
    }
    var bridge = found
    if bridge.job != id {
        return
    }
    match done {
        Some(sender) => mut bridge.closing.push(take sender)
        None => {}
    }
    mut self.notices.push(Notice(id: id, told: Telling.Bridge(Bridging.Closed(handle))))
} Driven.closing

/// Closes the end of a bridge the space holds by `handle`, taking back its entry of the table and
/// unmapping the frames it maps for itself.
fn Driven.end_closed(mut self, mut space: sys::load::Space, handle: u64) {
    let Some(bridge) = mut self.bridges.remove(handle) else {
        return
    }
    self.door.contents().table.taken(handle)
    if not bridge.unmaps {
        return
    }
    mut space.unshare(bridge.inbound)
    mut space.unshare(bridge.outbound)
    let Some(found) = mut self.jobs.get_mut(bridge.job) else {
        return
    }
    var running = found
    mut running.frames.retain(keep: fn(address: u64) -> bool {
        return address != bridge.inbound and address != bridge.outbound
    })
} Driven.end_closed

/// Drops the ends of bridges the job or instance numbered `id` holds, whose frames are unmapped with
/// its link's, and tells the other end of each end serving calls that it is closed.
fn Driven.ends_dropped(mut self, id: u64, alloc: mem::Alloc) {
    var handles = mem::List[u64].empty(alloc)
    for entry in self.bridges {
        if entry.value().job == id {
            mut handles.push(entry.key())
        }
    }
    for handle in handles {
        let Some(bridge) = mut self.bridges.remove(handle) else {
            continue
        }
        let Side.Serving(_) = bridge.side else {
            continue
        }
        mut self.leaving.push(Leaving(door: bridge.peer, ask: Ask.Close(Closing(id: bridge.peer_job, handle: bridge.peer_handle, done: None))))
    }
} Driven.ends_dropped

/// Gives each ask the space has for other isolations to the isolation it is for.
fn Driven.left(mut self) fails task::Cancelled uses wait {
    while self.leaving.len() > 0 {
        let Leaving(door: door, ask: ask) = mut self.leaving.remove(0)
        try await door.asked(take ask)
    }
} Driven.left

/// Tells the job or instance an order names what its kernel tells it: of the end of a bridge it
/// holds, through its mailbox's sender, or the reply to a waiting call it made, to its wait.
fn told_of(order: Taken, mailboxes: task::Cown[mem::Map[u64, Mailbox]], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let record = order.record
    let Some(parts) = order.bytes.view().split_at(START_BYTES) else {
        return
    }
    let Some(body) = parts.tail.prefix(usize.widen(record.granted_len)) else {
        return
    }
    let Ok(told) = attempt mem::wire::Codec[Telling].decode(Untrusted.of(take body), alloc) else {
        return
    }
    var found: Option[Mailbox] = None
    await when mut mailboxes {
        match mailboxes.get(record.id) {
            Some(mailbox) => {
                found = Some(Mailbox(bridging: mailbox.bridging.split(), waits: mailbox.waits.share()))
            }
            None => {}
        }
    }
    let Some(Mailbox(bridging: bridging, waits: waits)) = found else {
        return
    }
    match told {
        Telling.Bridge(notice) => {
            discard attempt await bridging.send(notice)
        }
        Telling.Reply(reply) => try await port_replied(take reply, waits)
    }
} told_of

/// What the runtime tells a job or instance by its kernel's orders: the sender of what it is told
/// of the ends of its bridges, and the waits of the calls it made that wait for its kernel's reply.
struct Mailbox {
    bridging: task::Sender[Bridging]
    waits: task::Cown[PortWaits]
} Mailbox

/// The offsets in a frame of a bridge of the word its reader sets while it waits for bytes and of
/// the word its writer sets while it waits for room.
const READER_WAITS: u64 = 16

const WRITER_WAITS: u64 = 24

/// The bytes from which a call's or reply's bytes move between spaces through frames of their own,
/// and the most bytes of a record either end of a bridge writes.
const MOVED_FROM: usize = 262_144

const MOST_RECORD: usize = MOVED_FROM + 4_096

/// The bit of the number a space's runtime gives a call that reached its instance over a bridge.
const OVER_BRIDGE: u64 = 0x8000_0000_0000_0000

/// The bytes of a page, through which the bytes a record would not hold move between spaces, and
/// the most bytes that move so at once.
const PAGE_BYTES: u64 = 4_096

const MOST_MOVED: u64 = 1_073_741_824

/// A call one end of a bridge writes: the number of its wait, its protocol hash, the bytes of the
/// header of the task making it and what it carries.
struct BridgeCall derives Encode {
    id: u64
    hash: sys::ProtocolHash
    header: Option[Array[u8, 32]]
    payload: Payload
} BridgeCall

/// The arguments of the admission of a call an end of a bridge serves: the bytes of the header of
/// the task that made it, and its bytes.
struct Admitting derives Encode {
    header: Option[Array[u8, 32]]
    bytes: mem::Bytes
} Admitting

/// The reply the other end writes to the call of a number, none when the call failed, through a
/// stale capability when `revoked`.
struct BridgeReply derives Encode {
    id: u64
    reply: Option[Payload]
    revoked: bool
} BridgeReply

/// What a call or reply carries over a bridge: its bytes, the token under which its handles crossed
/// into the other end's table, 0 for none, and the token under which the frames holding its bytes
/// moved into the other end's space in their place, 0 for none.
struct Payload derives Encode {
    bytes: mem::Bytes
    carried: u64
    moved: u64
} Payload

/// The end of a bridge as the tasks of a space's runtime reach it: the handle of its entry, the
/// records queued for it, the sender nudging the task pumping it, whether it is closed, and the
/// waits of the calls an instance makes through it.
struct Pump {
    handle: u64
    queued: task::Cown[mem::List[mem::Bytes]]
    nudge: task::Sender[u8]
    closed: mem::Shared[core::atomic::AtomicBool]
    waits: task::Cown[PortWaits]
} Pump

fn Pump.share(self) -> Pump {
    return Pump(handle: self.handle, queued: self.queued.share(), nudge: self.nudge.split(), closed: self.closed.share(), waits: self.waits.share())
} Pump.share

/// Queues a record for the end to write.
fn Pump.queue(self, take record: mem::Bytes) fails task::Cancelled uses wait {
    let queued = self.queued.share()
    await when mut queued {
        mut queued.push(take record)
    }
    discard self.nudge.offer(0)
} Pump.queue

/// The records queued for the end, taken.
fn Pump.taken(self, alloc: mem::Alloc) -> mem::List[mem::Bytes] fails task::Cancelled uses wait {
    let queued = self.queued.share()
    var records = mem::List[mem::Bytes].empty(alloc)
    await when mut queued {
        while queued.len() > 0 {
            mut records.push(mut queued.remove(0))
        }
    }
    return records
} Pump.taken

/// The calls that reached an instance over bridges and await its reply, by the numbers its
/// runtime gave them, and the number of the next.
struct Routes {
    next: u64
    waiting: mem::Map[u64, Route]
} Routes

/// Where the reply to a call that reached an instance over a bridge goes: the end it came through,
/// and the number of its wait at the other end.
struct Route {
    pump: Pump
    call: u64
} Route

/// What the bridges of a job's or instance's space reach: the ends it calls ports through, by port,
/// and capabilities of crossing kinds through, by their handles, the calls an instance serves over
/// them, the sender of the replies it makes to those it postponed, the remote capability its
/// handles are minted through, and the runtime's clock and allocator.
struct Bridges {
    ports: task::Cown[mem::Map[u64, Pump]]
    kinds: task::Cown[mem::Map[u64, Ride]]
    routes: task::Cown[Routes]
    late: task::Sender[Late]
    base: Remote
    clock: sys::Clock
    alloc: mem::Alloc
} Bridges

fn Bridges.share(self) -> Bridges {
    return Bridges(ports: self.ports.share(), kinds: self.kinds.share(), routes: self.routes.share(), late: self.late.split(), base: self.base, clock: self.clock, alloc: self.alloc)
} Bridges.share

/// The end of a bridge carrying the calls of the operation `operation` of a capability of a crossing
/// kind, as calls of the protocol of `hash`.
struct Ride {
    pump: Pump
    operation: u64
    hash: sys::ProtocolHash
} Ride

fn Ride.share(self) -> Ride {
    return Ride(pump: self.pump.share(), operation: self.operation, hash: self.hash)
} Ride.share

/// A reply an instance makes to a call it postponed, which reached it over a bridge: the number its
/// runtime gave the call, and the reply.
struct Late {
    request: u64
    reply: Naming
} Late

/// An end of a bridge a job or instance holds, the pump through which the tasks of its runtime reach
/// it, and the receiver of the nudges of the task pumping it.
struct Pumping {
    at: EndAt
    pump: Pump
    nudged: task::Receiver[u8]
} Pumping

/// The pumping of the end of a bridge `at` names, which `bridges` reaches from now on by the port or
/// the capability whose calls it carries.
fn pumping_of(at: EndAt, bridges: Bridges) -> Pumping fails task::Cancelled uses wait {
    let alloc = bridges.alloc
    let task::Channel(sender: nudge, receiver: nudged) = task::Channel[u8].bounded(1, alloc)
    let pump = Pump(handle: at.handle, queued: task::Cown.of(mem::List[mem::Bytes].empty(alloc), alloc), nudge: take nudge, closed: mem::Shared.of(core::atomic::AtomicBool.of(false), alloc), waits: task::Cown.of(PortWaits(next: 0, waiting: mem::Map[u64, task::Sender[PortAnswer]].empty(alloc)), alloc))
    let ports = bridges.ports.share()
    let kinds = bridges.kinds.share()
    match at.side {
        Side.Port(port) => {
            await when mut ports {
                discard mut ports.insert(port, value: pump.share())
            }
        }
        Side.Kind(riding) => {
            await when mut kinds {
                discard mut kinds.insert(riding.handle, value: Ride(pump: pump.share(), operation: riding.operation, hash: riding.hash))
            }
        }
        Side.Serving(_) => {}
    }
    return Pumping(at: at, pump: take pump, nudged: take nudged)
} pumping_of

/// Serves the ends of the bridges of a job or instance: pumps each end in `initial` and each that
/// opens as its kernel tells, the calls it makes through a port or a capability of a crossing kind
/// passing over it, or the calls reaching an instance through `calls`, and replies to postponed
/// ones as `late` gives them; nudges an end whose other end wrote or read, and closes an end once
/// told, telling the kernel.
fn bridges_served(take initial: mem::List[Pumping], take notices: task::Receiver[Bridging], take late: task::Receiver[Late], bridges: Bridges, calls: task::Sender[Called], exec: task::Executor) fails task::Cancelled uses wait {
    let alloc = bridges.alloc
    var pumps = mem::Map[u64, Pump].empty(alloc)
    var opening = Some(take initial)
    var receiving = Some(take notices)
    var replying = Some(take late)
    try await task::scope(exec, body: fn[mut pumps, mut opening, mut receiving, mut replying](s: task::Scope) fails task::Cancelled uses wait {
        let Some(open) = mut opening.extract() else {
            return
        }
        let Some(told) = mut receiving.extract() else {
            return
        }
        let Some(answering) = mut replying.extract() else {
            return
        }
        for pumping in take open {
            discard mut pumps.insert(pumping.at.handle, value: pumping.pump.share())
            pumped_on(s, take pumping, bridges, calls)
        }
        let shared = bridges.share()
        discard s.spawn(fn[take answering, take shared]() fails task::Cancelled uses wait {
            var receiver = answering
            loop {
                let Some(Late(request: request, reply: reply)) = try await mut receiver.receive() else {
                    return
                }
                let routing = shared.routes.share()
                let found = await when mut routing => mut routing.waiting.remove(request)
                match found {
                    Some(route) => try await replied_across(take route, take reply, bridges: shared, alloc)
                    None => {}
                }
            }
        })
        var receiver = told
        loop {
            let Some(bridging) = try await mut receiver.receive() else {
                return
            }
            match bridging {
                Bridging.Opened(at) => {
                    let pumping = try await pumping_of(at, bridges)
                    discard mut pumps.insert(at.handle, value: pumping.pump.share())
                    pumped_on(s, take pumping, bridges, calls)
                }
                Bridging.Rang(handle) => {
                    match pumps.get(handle) {
                        Some(pump) => {
                            discard pump.nudge.offer(0)
                        }
                        None => {}
                    }
                }
                Bridging.Closed(handle) => {
                    match mut pumps.remove(handle) {
                        Some(pump) => {
                            pump.closed.contents().store(true)
                            discard pump.nudge.offer(0)
                        }
                        None => {}
                    }
                    var nothing = Array[u8, 1].filled(0)
                    discard invoke(handle, operation: BRIDGE_CLOSED, args: b"", result: mut nothing.view_mut())
                }
            }
        }
    })
} bridges_served

/// Pumps an end of a bridge on a task of `s`, as `end_pumped` does.
fn pumped_on(s: task::Scope, take pumping: Pumping, bridges: Bridges, calls: task::Sender[Called]) {
    let Pumping(at: at, pump: pump, nudged: nudged) = pumping
    let sharing = bridges.share()
    let inbox = calls.split()
    discard s.spawn(fn[take nudged, take pump, take sharing, take inbox]() fails task::Cancelled uses wait {
        try await end_pumped(at, take nudged, pump, bridges: sharing, calls: inbox)
    })
} pumped_on

/// Pumps the end of a bridge `at` names until it is closed or its other end breaches it: an end a
/// job or instance calls a port or a capability of a crossing kind through carries the calls
/// `Forwarder.call` or `Remote.call` queues and gives each reply to its wait, no longer carrying
/// those calls once it stops, when it fails each call still waiting; an end serving calls gives each
/// call to the instance through `calls`.
fn end_pumped(at: EndAt, take nudged: task::Receiver[u8], pump: Pump, bridges: Bridges, calls: task::Sender[Called]) fails task::Cancelled uses wait {
    let alloc = bridges.alloc
    match at.side {
        Side.Serving(admits) => {
            try await pumped(at, take nudged, pump, bridges, heard: fn(record: mem::Bytes) -> bool fails task::Cancelled uses wait {
                return try await call_heard(record, pump, bridges, calls, admits)
            })
            return
        }
        else => {}
    }
    let outcome = attempt await pumped(at, take nudged, pump, bridges, heard: fn(record: mem::Bytes) -> bool fails task::Cancelled uses wait {
        return try await reply_heard(record, pump, alloc)
    })
    let ports = bridges.ports.share()
    let kinds = bridges.kinds.share()
    match at.side {
        Side.Port(port) => {
            await when mut ports {
                discard mut ports.remove(port)
            }
        }
        Side.Kind(riding) => {
            await when mut kinds {
                discard mut kinds.remove(riding.handle)
            }
        }
        Side.Serving(_) => {}
    }
    let waits = pump.waits.share()
    await when mut waits {
        for entry in waits.waiting {
            discard entry.value().offer(PortAnswer.Unknown)
        }
        waits.waiting = mem::Map[u64, task::Sender[PortAnswer]].empty(alloc)
    }
    match outcome {
        Ok(_) => {}
        Err(cancelled) => fail cancelled
    }
} end_pumped

/// Writes the records queued for the end of a bridge `at` names into the frame it writes as that
/// frame has room, and gives `heard` each record the other end writes into the frame it reads,
/// ringing the other end when it waits for what this end read or wrote and waiting on `nudged`, at
/// most `RECHECK_NS` while the runtime's clock is live, while it can do neither; returns once the
/// end is closed, or once the other end breaches it, by counts or a record no end writes, or a
/// record `heard` refuses, which it tells the kernel.
fn pumped(at: EndAt, take nudged: task::Receiver[u8], pump: Pump, bridges: Bridges, heard: fn(record: mem::Bytes) -> bool fails task::Cancelled uses wait) fails task::Cancelled uses wait {
    let alloc = bridges.alloc
    var out = mem::Bytes.empty(alloc)
    var pending = mem::Bytes.empty(alloc)
    var waking = nudged
    loop {
        for record in try await pump.taken(alloc) {
            mut out.append(record.view())
        }
        if pump.closed.contents().load() {
            return
        }
        var moved = false
        if out.len() > 0 {
            let Some(count) = ring_filled(at.outbound, data: out.view()) else {
                breached(at.handle)
                return
            }
            if count > 0 {
                out = rest_of(out, from: count, alloc)
                moved = true
                if waits_taken(at.outbound + READER_WAITS) {
                    rang_across(at.handle)
                }
            }
        }
        let Some(count) = ring_drained(at.inbound, into: mut pending, alloc) else {
            breached(at.handle)
            return
        }
        if count > 0 {
            moved = true
            if waits_taken(at.inbound + WRITER_WAITS) {
                rang_across(at.handle)
            }
        }
        loop {
            let Some(len) = frame_len(pending) else {
                break
            }
            if len > MOST_RECORD {
                breached(at.handle)
                return
            }
            let Some(record) = frame_off(mut pending, len, alloc) else {
                break
            }
            if not try await heard(record) {
                breached(at.handle)
                return
            }
        }
        if moved or pump.closed.contents().load() {
            continue
        }
        marked_waiting(at.inbound + READER_WAITS)
        if out.len() > 0 {
            marked_waiting(at.outbound + WRITER_WAITS)
        }
        if ring_holds(at.inbound) or (out.len() > 0 and ring_has_room(at.outbound)) {
            continue
        }
        let nudge = try await task::within_ns(bridges.clock, ns: RECHECK_NS, body: fn[mut waking]() -> Option[u8] fails task::Cancelled uses wait {
            return try await mut waking.receive()
        })
        if nudge.is_none() and (attempt bridges.clock.elapsed_ns()).is_err() {
            discard try await mut waking.receive()
        }
    }
} pumped

/// The bytes of `bytes` from `from` on.
fn rest_of(bytes: mem::Bytes, from: usize, alloc: mem::Alloc) -> mem::Bytes {
    var rest = mem::Bytes.empty(alloc)
    match bytes.view().split_at(from) {
        Some(parts) => mut rest.append(parts.tail)
        None => {}
    }
    return rest
} rest_of

/// Tells the kernel that the other end of the end of a bridge whose handle is `handle` wrote what
/// no end writes, which ends the other end's job or instance and closes this end.
fn breached(handle: u64) {
    var nothing = Array[u8, 1].filled(0)
    discard invoke(handle, operation: BRIDGE_BREACH, args: b"", result: mut nothing.view_mut())
} breached

/// Rings the other end of the end of a bridge whose handle is `handle`.
fn rang_across(handle: u64) {
    var nothing = Array[u8, 1].filled(0)
    discard invoke(handle, operation: BRIDGE_RING, args: b"", result: mut nothing.view_mut())
} rang_across

/// Sets the word at `word`, telling the other end of a bridge that this end waits.
fn marked_waiting(word: u64) {
    trusted "the word lies in a frame of a bridge the kernel maps for the space" {
        discard hw::Ptr[u64].of_addr(usize.widen(word)).atomic_swap(1, order: hw::Order.SeqCst)
    }
} marked_waiting

/// Whether the other end of a bridge set the word at `word` to say it waits, clearing it.
fn waits_taken(word: u64) -> bool {
    let held = trusted "the word lies in a frame of a bridge the kernel maps for the space" { hw::Ptr[u64].of_addr(usize.widen(word)).atomic_swap(0, order: hw::Order.SeqCst) }
    return held != 0
} waits_taken

/// The count of bytes the writer of the ring of the frame at `frame` has written, and the count its
/// reader has read.
struct Counts derives Copy {
    written: u64
    read: u64
} Counts

/// The counts of the ring of the frame at `frame`, none when no reader and writer leave them.
fn counts_of(frame: u64) -> Option[Counts] {
    let written = trusted "the frame at `frame` is a frame of a bridge the kernel maps for the space" { hw::Ptr[u64].of_addr(usize.widen(frame + RING_WRITTEN)).atomic_load(hw::Order.SeqCst) }
    let read = trusted "the frame at `frame` is a frame of a bridge the kernel maps for the space" { hw::Ptr[u64].of_addr(usize.widen(frame + RING_READ)).atomic_load(hw::Order.SeqCst) }
    if written < read or written - read > RING_BYTES {
        return None
    }
    return Some(Counts(written: written, read: read))
} counts_of

/// Whether the ring of the frame at `frame` holds bytes its reader has not read.
fn ring_holds(frame: u64) -> bool {
    return match counts_of(frame) {
        Some(counts) => counts.written > counts.read
        None => true
    }
} ring_holds

/// Whether the ring of the frame at `frame` has room for its writer.
fn ring_has_room(frame: u64) -> bool {
    return match counts_of(frame) {
        Some(counts) => counts.written - counts.read < RING_BYTES
        None => true
    }
} ring_has_room

/// Appends to `into` the bytes of the ring of the frame at `frame` its writer has written and this
/// end has not read, giving their count; none when its counts are ones no reader and writer leave.
fn ring_drained(frame: u64, mut into: mem::Bytes, alloc: mem::Alloc) -> Option[u64] {
    let Some(counts) = counts_of(frame) else {
        return None
    }
    let count = counts.written - counts.read
    if count == 0 {
        return Some(0)
    }
    var room = mem::Bytes.zeroed(usize.widen(count), alloc)
    let to = hw::Ptr.of_view_mut(mut room.view_mut())
    each_piece(at: counts.read, count, body: fn(offset: u64, from: u64, len: u64) {
        trusted "the frame at `frame` is a frame of a bridge the kernel maps for the space, and `room` holds `count` bytes" {
            hw::Ptr[u8].of_addr(usize.widen(frame + RING_DATA + offset)).copy(to.offset(isize.fit(from)), count: usize.widen(len))
        }
    })
    mut into.append(room.view())
    trusted "the frame at `frame` is a frame of a bridge the kernel maps for the space" {
        hw::Ptr[u64].of_addr(usize.widen(frame + RING_READ)).atomic_store(counts.written, order: hw::Order.SeqCst)
    }
    return Some(count)
} ring_drained

/// Writes into the ring of the frame at `frame` as many bytes of `data` as it has room for, giving
/// their count; none when its counts are ones no reader and writer leave.
fn ring_filled(frame: u64, data: Slice[u8]) -> Option[usize] {
    let Some(counts) = counts_of(frame) else {
        return None
    }
    var count = RING_BYTES - (counts.written - counts.read)
    if u64.widen(data.len()) < count {
        count = u64.widen(data.len())
    }
    if count == 0 {
        return Some(0)
    }
    each_piece(at: counts.written, count, body: fn(offset: u64, from: u64, len: u64) {
        trusted "the frame at `frame` is a frame of a bridge the kernel maps for the space, and `data` holds `count` bytes" {
            hw::Ptr.of_view(data).offset(isize.fit(from)).copy(hw::Ptr[u8].of_addr(usize.widen(frame + RING_DATA + offset)), count: usize.widen(len))
        }
    })
    trusted "the frame at `frame` is a frame of a bridge the kernel maps for the space" {
        hw::Ptr[u64].of_addr(usize.widen(frame + RING_WRITTEN)).atomic_store(counts.written + count, order: hw::Order.SeqCst)
    }
    return Some(usize.widen(count))
} ring_filled

/// Carries the handles of the space's table that `handles` names into the table of the other end
/// of the end of a bridge whose handle is `handle`, giving the token they crossed under, 0 for
/// none; fails with `RunnerError.Unknown` when one cannot cross.
fn carried_across(handle: u64, handles: mem::List[u64], alloc: mem::Alloc) -> u64 fails sys::RunnerError {
    if handles.len() == 0 {
        return 0
    }
    var nothing = Array[u8, 1].filled(0)
    let token = invoke(handle, operation: BRIDGE_CARRY, args: encoded(handles, alloc).view(), result: mut nothing.view_mut())
    if token >= FAILURES {
        fail sys::RunnerError.Unknown
    }
    return token
} carried_across

/// What crossed into the space's table under `token` for the end of a bridge whose handle is
/// `handle`, nothing for 0; none when the kernel keeps nothing for it under `token`.
fn claimed(handle: u64, token: u64, alloc: mem::Alloc) -> Option[mem::List[Carried]] {
    if token == 0 {
        return Some(mem::List[Carried].empty(alloc))
    }
    var capacity: usize = CARRIED_BYTES
    loop {
        var bytes = mem::Bytes.zeroed(capacity, alloc)
        let len = invoke(handle, operation: BRIDGE_CLAIM, args: encoded(token, alloc).view(), result: mut bytes.view_mut())
        if len >= FAILURES {
            return None
        }
        if len > u64.widen(capacity) {
            capacity = usize.widen(len)
            continue
        }
        let Some(written) = bytes.view().prefix(usize.widen(len)) else {
            return None
        }
        return match attempt mem::wire::Codec[mem::List[Carried]].decode(Untrusted.of(take written), alloc) {
            Ok(crossing) => Some(take crossing)
            Err(_) => None
        }
    }
} claimed

/// Calls through the end of a bridge `pump`, carrying the handles `sent` names across, and gives
/// the reply, its handles minted through `base`.
fn called_across(pump: Pump, base: Remote, hash: sys::ProtocolHash, take sent: Naming, alloc: mem::Alloc) -> sys::Encoded fails sys::RunnerError uses wait {
    let Naming(bytes: bytes, handles: handles) = sent
    let token = try carried_across(pump.handle, handles, alloc)
    let Waiting(id: id, answers: answers) = try await wait_added(pump.waits, alloc)
    let record = framed(BridgeCall(id: id, hash: hash, header: header_bytes(sys::current_header()), payload: try payload_of(pump.handle, take bytes, crossed: token, alloc)), alloc)
    try await pump.queue(take record)
    var receiver = answers
    let Some(answered) = try await mut receiver.receive() else {
        fail sys::RunnerError.Unknown
    }
    return try reply_minted(take answered, base, alloc)
} called_across

/// Calls the operation of a capability of a crossing kind that the end of a bridge `ride` carries,
/// `args` its bytes, and gives the reply, its handles minted through `base`; fails with
/// `CrossError.Revoked` once the capability admitting it at the other end is stale, and with
/// `Refused` once that capability refuses it, its bytes cannot move or it fails.
fn rode_across(ride: Ride, base: Remote, take args: mem::Bytes, alloc: mem::Alloc) -> sys::Encoded fails sys::CrossError uses wait {
    let Ok(payload) = attempt payload_of(ride.pump.handle, bytes: take args, crossed: 0, alloc) else {
        fail sys::CrossError.Refused
    }
    let Waiting(id: id, answers: answers) = try await wait_added(ride.pump.waits, alloc)
    try await ride.pump.queue(framed(BridgeCall(id: id, hash: ride.hash, header: header_bytes(sys::current_header()), payload: take payload), alloc))
    var receiver = answers
    let answered = try await mut receiver.receive()
    return try crossed_reply(take answered, base, alloc)
} rode_across

/// Gives the reply a record of the end of a bridge holds to the wait of its number, its handles
/// claimed; false for a record no serving end writes.
fn reply_heard(record: mem::Bytes, pump: Pump, alloc: mem::Alloc) -> bool fails task::Cancelled uses wait {
    let Ok(BridgeReply(id: id, reply: reply, revoked: revoked)) = attempt mem::wire::Codec[BridgeReply].decode(Untrusted.of(record.view()), alloc) else {
        return false
    }
    var answer = PortAnswer.Unknown
    if revoked {
        answer = PortAnswer.Revoked
    }
    match reply {
        Some(payload) => {
            let Some(crossing) = claimed(pump.handle, token: payload.carried, alloc) else {
                return false
            }
            let Some(bytes) = payload_bytes(pump.handle, take payload, alloc) else {
                return false
            }
            answer = PortAnswer.Replied(Carrying(bytes: take bytes, handles: take crossing))
        }
        None => {}
    }
    try await port_replied(PortReply(id: id, answer: take answer), waits: pump.waits)
    return true
} reply_heard

/// Gives the instance the call a record of the end of a bridge holds, numbered with `OVER_BRIDGE` set,
/// its handles claimed and minted through the remote capability of `bridges`, keeping where its
/// reply goes; when `admits`, has the kernel admit it first, replying with a failure to one it does
/// not admit; false for a record no calling end writes, which carries handles when `admits`.
fn call_heard(record: mem::Bytes, pump: Pump, bridges: Bridges, calls: task::Sender[Called], admits: bool) -> bool fails task::Cancelled uses wait {
    let alloc = bridges.alloc
    let Ok(BridgeCall(id: caller, hash: hash, header: header, payload: payload)) = attempt mem::wire::Codec[BridgeCall].decode(Untrusted.of(record.view()), alloc) else {
        return false
    }
    if admits and payload.carried != 0 {
        return false
    }
    let Some(crossing) = claimed(pump.handle, token: payload.carried, alloc) else {
        return false
    }
    let Some(bytes) = payload_bytes(pump.handle, take payload, alloc) else {
        return false
    }
    var encoding = sys::Encoded.empty(alloc)
    mut encoding.bytes.append(bytes.view())
    if admits {
        var nothing = Array[u8, 1].filled(0)
        let admitting = encoded(Admitting(header: header, bytes: take bytes), alloc)
        let admission = invoke(pump.handle, operation: BRIDGE_ADMIT, args: admitting.view(), result: mut nothing.view_mut())
        if admission != 0 {
            try await pump.queue(framed(BridgeReply(id: caller, reply: None, revoked: admission == STALE), alloc))
            return true
        }
    }
    for crossed in crossing {
        match minted_for(bridges.base, crossed) {
            Some(handle) => mut encoding.handles.push(handle)
            None => {}
        }
    }
    let routes = bridges.routes.share()
    var id: u64 = 0
    await when mut routes {
        id = OVER_BRIDGE | routes.next
        routes.next += 1
        discard mut routes.waiting.insert(id, value: Route(pump: pump.share(), call: caller))
    }
    discard attempt await calls.send(Called(id: id, hash: hash, request: id, header: header_of(header), encoding: take encoding, alloc: alloc))
    return true
} call_heard

/// Writes the answer of an instance to the call numbered `id`, which reached it over a bridge, to
/// the end it came through: a reply with its handles carried across, a failure as none; a postponed
/// call waits for the reply `Forwarder.reply` makes.
fn answered_across(id: u64, take answer: Answer, bridges: Bridges) fails task::Cancelled uses wait {
    let alloc = bridges.alloc
    let routes = bridges.routes.share()
    let found = await when mut routes => mut routes.waiting.remove(id)
    let Some(route) = found else {
        return
    }
    match answer {
        Answer.Served(Ok(Some(reply))) => {
            match attempt naming(bridges.base, bytes: reply.bytes.view(), handles: reply.handles.view(), alloc) {
                Ok(named) => try await replied_across(take route, reply: take named, bridges, alloc)
                Err(_) => try await route.pump.queue(framed(BridgeReply(id: route.call, reply: None, revoked: false), alloc))
            }
        }
        Answer.Served(Ok(None)) => {
            await when mut routes {
                discard mut routes.waiting.insert(id, value: take route)
            }
        }
        else => try await route.pump.queue(framed(BridgeReply(id: route.call, reply: None, revoked: false), alloc))
    }
} answered_across

/// Writes a reply over the bridge `route` names, its handles carried across, or a failure when one
/// cannot cross or the reply is longer than a record.
fn replied_across(take route: Route, take reply: Naming, bridges: Bridges, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Naming(bytes: bytes, handles: handles) = reply
    let payload = match attempt carried_across(route.pump.handle, handles, alloc) {
        Ok(token) => match attempt payload_of(route.pump.handle, take bytes, crossed: token, alloc) {
            Ok(carrying) => Some(take carrying)
            Err(_) => None
        }
        Err(_) => None
    }
    try await route.pump.queue(framed(BridgeReply(id: route.call, reply: take payload, revoked: false), alloc))
} replied_across

/// What carries `bytes` over the end of a bridge whose handle is `handle`, with the handles that
/// crossed under `crossed`: the bytes themselves while a record holds them, and otherwise the token
/// under which the frames holding them moved to the other end; fails with `RunnerError.Unknown`
/// when the kernel moves none.
fn payload_of(handle: u64, take bytes: mem::Bytes, crossed: u64, alloc: mem::Alloc) -> Payload fails sys::RunnerError {
    if bytes.len() < MOVED_FROM {
        return Payload(bytes: take bytes, carried: crossed, moved: 0)
    }
    let token = try pages_moved(handle, operation: BRIDGE_MOVE, bytes: bytes.view(), alloc)
    return Payload(bytes: mem::Bytes.empty(alloc), carried: crossed, moved: token)
} payload_of

/// Copies `bytes` into pages of their own and moves those pages out of the space through the
/// operation `operation` of the capability of the space's table whose handle is `handle`, giving
/// the token they moved under; fails with `RunnerError.Unknown` when the kernel moves none.
fn pages_moved(handle: u64, operation: u64, bytes: Slice[u8], alloc: mem::Alloc) -> u64 fails sys::RunnerError {
    let len = u64.widen(bytes.len())
    var pages = mem::Bytes.zeroed(usize.widen(paged(len) + PAGE_BYTES), alloc)
    let start = u64.widen(hw::Ptr.of_view(pages.view()).addr())
    let offset = (PAGE_BYTES - start % PAGE_BYTES) % PAGE_BYTES
    let Some(parts) = mut pages.view_mut().split_at_mut(usize.widen(offset)) else {
        fail sys::RunnerError.Unknown
    }
    var tail = parts.tail
    let Some(held) = mut tail.prefix_mut(bytes.len()) else {
        fail sys::RunnerError.Unknown
    }
    var into = held
    mut into.copy_from(bytes)
    var nothing = Array[u8, 1].filled(0)
    let token = invoke(handle, operation, args: encoded(Span(address: start + offset, len: len), alloc).view(), result: mut nothing.view_mut())
    if token >= FAILURES {
        fail sys::RunnerError.Unknown
    }
    return token
} pages_moved

/// The bytes a payload carries over the end of a bridge whose handle is `handle`: its own, or those
/// of the frames that moved into the space for it, which the space maps in place of pages of its
/// own; none when nothing moved under its token.
fn payload_bytes(handle: u64, take payload: Payload, alloc: mem::Alloc) -> Option[mem::Bytes] {
    let Payload(bytes: bytes, carried: _, moved: token) = payload
    if token == 0 {
        return Some(take bytes)
    }
    var nothing = Array[u8, 1].filled(0)
    let len = invoke(handle, operation: BRIDGE_SIZE, args: encoded(token, alloc).view(), result: mut nothing.view_mut())
    if len >= FAILURES or len > MOST_MOVED {
        return None
    }
    var pages = mem::Bytes.zeroed(usize.widen(paged(len) + PAGE_BYTES), alloc)
    let start = u64.widen(hw::Ptr.of_view(pages.view()).addr())
    let offset = (PAGE_BYTES - start % PAGE_BYTES) % PAGE_BYTES
    if invoke(handle, operation: BRIDGE_ACCEPT, args: encoded(Accepting(token: token, address: start + offset), alloc).view(), result: mut nothing.view_mut()) != len {
        return None
    }
    let Some(parts) = pages.view().split_at(usize.widen(offset)) else {
        return None
    }
    let Some(moved) = parts.tail.prefix(usize.widen(len)) else {
        return None
    }
    var given = mem::Bytes.empty(alloc)
    mut given.append(moved)
    return Some(take given)
} payload_bytes

/// The bytes of the whole pages that hold `len` bytes.
fn paged(len: u64) -> u64 {
    return (len + PAGE_BYTES - 1) / PAGE_BYTES * PAGE_BYTES
} paged

/// Pages of a space the end of a bridge moves to its other end: where they start, and the bytes
/// they hold.
struct Span derives Copy, Encode {
    address: u64
    len: u64
} Span

/// Where a space maps the frames that moved for the end of a bridge under `token`.
struct Accepting derives Copy, Encode {
    token: u64
    address: u64
} Accepting

/// What the task keeping the frames moving into an isolation's space, or to its kernel, is given:
/// frames that moved, an ask for the length of what moved under a token, an ask for those frames,
/// or an ask for the frames that moved for what its table no longer names.
linear enum Moving {
    Parked(Parking)
    Sized(Sizing)
    Claimed(Claiming)
    Dropped(Dropping)
} Moving

/// Frames that moved, and the sender through which they are given back when the table of the
/// isolation they moved to no longer names what they moved for.
linear struct Parking {
    moved: Moved
    refused: task::Sender[Moved]
} Parking

/// Frames that moved into an isolation's space for the end of a bridge whose handle is `handle`, or
/// to its kernel through the runner capability whose handle it is, under `token`, holding `len`
/// bytes.
linear struct Moved {
    token: u64
    handle: u64
    len: u64
    frames: mem::List[hw::PhysFrame[4_096]]
} Moved

/// An ask for the length of what moved under `token` for the end of a bridge whose handle is
/// `handle`, answered through `reply`.
struct Sizing {
    token: u64
    handle: u64
    reply: task::Sender[u64]
} Sizing

/// An ask for the frames that moved under `token` for the end of a bridge whose handle is
/// `handle`, given through `reply`.
struct Claiming {
    token: u64
    handle: u64
    reply: task::Sender[Moved]
} Claiming

/// An ask for the frames that moved for the ends of bridges and the runner capabilities an
/// isolation's table no longer names, given through `reply`.
struct Dropping {
    reply: task::Sender[mem::List[Moved]]
} Dropping

/// Keeps the frames moving into an isolation's space, or to its kernel, until the end of a bridge
/// or the runner capability they moved for claims them, refusing those moving for one the
/// isolation's `table` no longer names and giving up, when asked, those kept for one it no longer
/// names, and gives every frame left once no sender of `moving` is left.
fn moves_kept(take moving: task::Receiver[Moving], table: Table, alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] fails task::Cancelled uses wait {
    var parked = mem::List[Moved].empty(alloc)
    discard attempt await take moving.drain(visit: fn[mut parked](take message: Moving) {
        match message {
            Moving.Parked(Parking(moved: moved, refused: refused)) => {
                if table.entry(moved.handle).is_some() {
                    mut parked.push(take moved)
                } else {
                    match refused.offer(take moved) {
                        Some(kept) => mut parked.push(take kept)
                        None => {}
                    }
                }
            }
            Moving.Sized(Sizing(token: token, handle: handle, reply: reply)) => {
                for moved in parked {
                    if moved.token == token and moved.handle == handle {
                        discard reply.offer(moved.len)
                    }
                }
            }
            Moving.Claimed(Claiming(token: token, handle: handle, reply: reply)) => {
                for index in 0..<parked.len() {
                    if parked[index].token == token and parked[index].handle == handle {
                        let given = mut parked.remove(index)
                        match reply.offer(take given) {
                            Some(refused) => mut parked.push(take refused)
                            None => {}
                        }
                        break
                    }
                }
            }
            Moving.Dropped(Dropping(reply: reply)) => {
                var dropped = mem::List[Moved].empty(alloc)
                var index: usize = 0
                while index < parked.len() {
                    if table.entry(parked[index].handle).is_some() {
                        index += 1
                    } else {
                        mut dropped.push(mut parked.remove(index))
                    }
                }
                match reply.offer(take dropped) {
                    Some(refused) => {
                        for moved in take refused {
                            mut parked.push(take moved)
                        }
                    }
                    None => {}
                }
            }
        }
    })
    var left = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    for moved in take parked {
        let Moved(token: _, handle: _, len: _, frames: held) = moved
        for frame in take held {
            mut left.push(take frame)
        }
    }
    return left
} moves_kept

/// Gives back to `frames` the frames a message for the task keeping moving frames holds.
fn moving_released(take moving: Moving, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    match moving {
        Moving.Parked(Parking(moved: moved, refused: _)) => moved_released(take moved, mut frames)
        Moving.Sized(_) => {}
        Moving.Claimed(_) => {}
        Moving.Dropped(_) => {}
    }
} moving_released

/// Gives back to `frames` the frames that moved.
fn moved_released(take moved: Moved, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    let Moved(token: _, handle: _, len: _, frames: held) = moved
    for frame in take held {
        mut frames.push(take frame)
    }
} moved_released

/// A sender of the task keeping the frames moving into the space of a door's isolation, none once
/// that isolation takes no more.
fn Door.mover(self) -> Option[task::Sender[Moving]] fails task::Cancelled uses wait {
    let moves = self.moves.share()
    var mover: Option[task::Sender[Moving]] = None
    await when mut moves {
        match moves {
            Some(sender) => {
                mover = Some(sender.split())
            }
            None => {}
        }
    }
    return mover
} Door.mover

/// Takes no more frames moving into the space of a door's isolation.
fn Door.moves_ended(self) fails task::Cancelled uses wait {
    let moves = self.moves.share()
    await when mut moves {
        moves = None
    }
} Door.moves_ended

/// Moves the pages `span` names out of `space` to the isolation `peer` reaches, for the end of a
/// bridge or the runner capability whose handle is `handle` there, giving the token they moved
/// under; gives `INVALID`, the frames it took going to `frames`, when `space` does not map each of
/// those pages, that isolation takes no more or its table no longer names that end or capability.
fn moved_out(peer: Doorway, handle: u64, span: Span, mut space: sys::load::Space, mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    if span.len == 0 or span.len > MOST_MOVED or span.address % PAGE_BYTES != 0 {
        return INVALID
    }
    let len = paged(span.len)
    var taken = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    let Ok(_) = attempt mut space.give_back(span.address, len, frames: mut taken) else {
        for frame in take taken {
            mut frames.push(take frame)
        }
        return INVALID
    }
    if u64.widen(taken.len()) * PAGE_BYTES == len {
        match peer.reached() {
            Some(peer_door) => return try await peer_door.contents().moved_in(handle, len: span.len, moved: take taken, mut frames, alloc)
            None => {}
        }
    }
    for frame in take taken {
        mut frames.push(take frame)
    }
    return INVALID
} moved_out

/// Keeps `moved`, the frames holding `len` bytes that moved into the space of a door's isolation,
/// or to its kernel, for the end of a bridge or the runner capability whose handle is `handle`,
/// giving the token they moved under; gives `INVALID`, `moved` going to `frames`, when the
/// isolation takes no more or its table no longer names that end or capability.
fn Door.moved_in(self, handle: u64, len: u64, take moved: mem::List[hw::PhysFrame[4_096]], mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let token = self.tokens.fetch_add(1).value_or(0)
    let mover = match attempt await self.mover() {
        Ok(sender) => sender
        Err(_) => None
    }
    let Some(sender) = mover else {
        for frame in take moved {
            mut frames.push(take frame)
        }
        return INVALID
    }
    let task::Channel(sender: refusing, receiver: refusals) = task::Channel[Moved].bounded(1, alloc)
    var refused = false
    match sender.offer(Moving.Parked(Parking(moved: Moved(token: token, handle: handle, len: len, frames: take moved), refused: take refusing))) {
        Some(unsent) => {
            moving_released(take unsent, mut frames)
            refused = true
        }
        None => {}
    }
    try await take refusals.drain(visit: fn[mut frames, mut refused](take given: Moved) {
        moved_released(take given, mut frames)
        refused = true
    })
    if refused {
        return INVALID
    }
    return token
} Door.moved_in

/// Gives back to `frames` the frames that moved into the space of a door's isolation, or to its
/// kernel, for each end of a bridge or runner capability its table no longer names.
fn Door.moves_dropped(self, mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Some(mover) = try await self.mover() else {
        return
    }
    let task::Channel(sender: reply, receiver: replies) = task::Channel[mem::List[Moved]].bounded(1, alloc)
    discard attempt await mover.send(Moving.Dropped(Dropping(reply: take reply)))
    discard attempt await take replies.drain(visit: fn[mut frames](take dropped: mem::List[Moved]) {
        for moved in take dropped {
            moved_released(take moved, mut frames)
        }
    })
} Door.moves_dropped

/// The length of what moved into the space of a door's isolation under `token` for the end of a
/// bridge whose handle is `handle`, `INVALID` when nothing did.
fn Door.moved_len(self, handle: u64, token: u64, alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let Some(mover) = try await self.mover() else {
        return INVALID
    }
    let task::Channel(sender: reply, receiver: replies) = task::Channel[u64].bounded(1, alloc)
    discard attempt await mover.send(Moving.Sized(Sizing(token: token, handle: handle, reply: take reply)))
    var receiver = replies
    return match try await mut receiver.receive() {
        Some(len) => len
        None => INVALID
    }
} Door.moved_len

/// Maps into `space` at the address `accepting` gives, in place of the pages it maps there, the
/// frames that moved into it under its token for the end of a bridge whose handle is `handle`,
/// giving the length of what moved; `INVALID` when nothing did or the space cannot map them there,
/// which gives them to `frames`.
fn Door.accepted(self, handle: u64, accepting: Accepting, mut space: sys::load::Space, mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let claims = try await self.moves_claimed(handle, token: accepting.token, alloc)
    var len = INVALID
    for moved in take claims {
        let Moved(token: _, handle: _, len: held, frames: given) = moved
        match attempt mut space.adopt(accepting.address, moved: take given, mut frames) {
            Ok(_) => {
                len = held
            }
            Err(_) => {}
        }
    }
    return len
} Door.accepted

/// What moved into the space of a door's isolation, or to its kernel, under `token` for the end of
/// a bridge or the runner capability whose handle is `handle`, claimed from the task keeping it;
/// empty when nothing did.
fn Door.moves_claimed(self, handle: u64, token: u64, alloc: mem::Alloc) -> mem::List[Moved] fails task::Cancelled uses wait {
    let Some(mover) = try await self.mover() else {
        return mem::List[Moved].empty(alloc)
    }
    let task::Channel(sender: reply, receiver: replies) = task::Channel[Moved].bounded(1, alloc)
    discard attempt await mover.send(Moving.Claimed(Claiming(token: token, handle: handle, reply: take reply)))
    var claims = mem::List[Moved].empty(alloc)
    discard attempt await take replies.drain(visit: fn[mut claims](take moved: Moved) {
        mut claims.push(take moved)
    })
    return claims
} Door.moves_claimed
