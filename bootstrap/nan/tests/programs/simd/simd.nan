    var stored_i32 = Array[i32, 5].filled(0)
    a_i32.store(mut stored_i32.view_mut(), at: 1)
    say(log, label: "i32 load", value: hashed(bytes_i32(core::simd::I32x4.load(stored_i32.view(), at: 1).wrapping_add(b_i32))))
} report_i32

fn report_u64(log: sys::Log) {
    let a_u64 = lanes_u64(seed: 64, extremes: true)
    let b_u64 = lanes_u64(seed: 448, extremes: false)
    say(log, label: "u64 splat", value: hashed(bytes_u64(core::simd::U64x2.splat(b_u64.lane(1)))))
    say(log, label: "u64 add", value: hashed(bytes_u64(a_u64.wrapping_add(b_u64))))
    say(log, label: "u64 sub", value: hashed(bytes_u64(a_u64.wrapping_sub(b_u64))))
    say(log, label: "u64 mul", value: hashed(bytes_u64(a_u64.wrapping_mul(b_u64))))
    say(log, label: "u64 and", value: hashed(bytes_u64(a_u64.bit_and(b_u64))))
    say(log, label: "u64 or", value: hashed(bytes_u64(a_u64.bit_or(b_u64))))
    say(log, label: "u64 xor", value: hashed(bytes_u64(a_u64.bit_xor(b_u64))))
    say(log, label: "u64 not", value: hashed(bytes_u64(a_u64.bit_not())))
    say(log, label: "u64 shl", value: hashed(bytes_u64(a_u64.shl(61))))
    say(log, label: "u64 shr", value: hashed(bytes_u64(a_u64.shr(33))))
    say(log, label: "u64 eq", value: mask_u64(a_u64.lanes_eq(a_u64.replace_lane(1, value: b_u64.lane(1)))))
    say(log, label: "u64 lt", value: mask_u64(a_u64.lanes_lt(b_u64)))
    say(log, label: "u64 gt", value: mask_u64(a_u64.lanes_gt(b_u64)))
    say(log, label: "u64 mask ops", value: mask_u64(a_u64.lanes_lt(b_u64).bit_xor(a_u64.lanes_gt(b_u64)).bit_or(a_u64.lanes_eq(b_u64).bit_not()).bit_and(a_u64.lanes_eq(a_u64))))
    say(log, label: "u64 select", value: hashed(bytes_u64(core::simd::U64x2.select(a_u64.lanes_lt(b_u64), if_true: a_u64, if_false: b_u64))))
    say(log, label: "u64 sum", value: a_u64.wrapping_sum())
    var stored_u64 = Array[u64, 3].filled(0)
    a_u64.store(mut stored_u64.view_mut(), at: 1)
    say(log, label: "u64 load", value: hashed(bytes_u64(core::simd::U64x2.load(stored_u64.view(), at: 1).wrapping_add(b_u64))))
} report_u64

fn report_i64(log: sys::Log) {
    let a_i64 = lanes_i64(seed: 65, extremes: true)
    let b_i64 = lanes_i64(seed: 451, extremes: false)
    say(log, label: "i64 splat", value: hashed(bytes_i64(core::simd::I64x2.splat(b_i64.lane(1)))))
    say(log, label: "i64 add", value: hashed(bytes_i64(a_i64.wrapping_add(b_i64))))
    say(log, label: "i64 sub", value: hashed(bytes_i64(a_i64.wrapping_sub(b_i64))))
    say(log, label: "i64 mul", value: hashed(bytes_i64(a_i64.wrapping_mul(b_i64))))
    say(log, label: "i64 and", value: hashed(bytes_i64(a_i64.bit_and(b_i64))))
    say(log, label: "i64 or", value: hashed(bytes_i64(a_i64.bit_or(b_i64))))
    say(log, label: "i64 xor", value: hashed(bytes_i64(a_i64.bit_xor(b_i64))))
    say(log, label: "i64 not", value: hashed(bytes_i64(a_i64.bit_not())))
    say(log, label: "i64 shl", value: hashed(bytes_i64(a_i64.shl(61))))
    say(log, label: "i64 shr", value: hashed(bytes_i64(a_i64.shr(33))))
    say(log, label: "i64 eq", value: mask_i64(a_i64.lanes_eq(a_i64.replace_lane(1, value: b_i64.lane(1)))))
    say(log, label: "i64 lt", value: mask_i64(a_i64.lanes_lt(b_i64)))
    say(log, label: "i64 gt", value: mask_i64(a_i64.lanes_gt(b_i64)))
    say(log, label: "i64 mask ops", value: mask_i64(a_i64.lanes_lt(b_i64).bit_xor(a_i64.lanes_gt(b_i64)).bit_or(a_i64.lanes_eq(b_i64).bit_not()).bit_and(a_i64.lanes_eq(a_i64))))
    say(log, label: "i64 select", value: hashed(bytes_i64(core::simd::I64x2.select(a_i64.lanes_lt(b_i64), if_true: a_i64, if_false: b_i64))))
    say(log, label: "i64 sum", value: a_i64.wrapping_sum().to_bits())
    var stored_i64 = Array[i64, 3].filled(0)
    a_i64.store(mut stored_i64.view_mut(), at: 1)
    say(log, label: "i64 load", value: hashed(bytes_i64(core::simd::I64x2.load(stored_i64.view(), at: 1).wrapping_add(b_i64))))
} report_i64

fn report_f32(log: sys::Log) {
    let a_i32 = lanes_i32(seed: 33, extremes: true)
    let small = core::simd::F32x4.splat(1.5).replace_lane(1, value: -0.0).replace_lane(2, value: 0.0 / 0.0).replace_lane(3, value: 3_000_000_000.0)
    let large = core::simd::F32x4.splat(-2.25).replace_lane(1, value: 0.0).replace_lane(2, value: 1.0).replace_lane(3, value: 1.0 / 0.0)
    say(log, label: "f32 add", value: hashed(small.add(large).to_bytes()))
    say(log, label: "f32 sub", value: hashed(small.sub(large).to_bytes()))
    say(log, label: "f32 mul", value: hashed(small.mul(large).to_bytes()))
    say(log, label: "f32 div", value: hashed(small.div(large).to_bytes()))
    say(log, label: "f32 sqrt", value: hashed(small.sqrt().to_bytes()))
    say(log, label: "f32 min", value: hashed(small.min(large).to_bytes()))
    say(log, label: "f32 max", value: hashed(small.max(large).to_bytes()))
    say(log, label: "f32 eq", value: mask_u32(small.lanes_eq(small)))
    say(log, label: "f32 lt", value: mask_u32(small.lanes_lt(large)))
    say(log, label: "f32 gt", value: mask_u32(small.lanes_gt(large)))
    say(log, label: "f32 select", value: hashed(core::simd::F32x4.select(small.lanes_gt(large), if_true: small, if_false: large).to_bytes()))
    say(log, label: "f32 sum", value: u64.widen(core::simd::F32x4.splat(1.0).replace_lane(0, value: 100_000_000.0).replace_lane(2, value: -100_000_000.0).sum().to_bits()))
    say(log, label: "f32 to i32", value: hashed(small.to_i32x4().to_bytes()))
    say(log, label: "f32 from i32", value: hashed(core::simd::F32x4.from_i32x4(a_i32).to_bytes()))
    let halves = core::simd::F16x8.narrow(small, high: large)
    say(log, label: "f16 narrow", value: hashed(halves.to_bytes()))
    say(log, label: "f16 widen", value: hashed(halves.widen_low().to_bytes()) ^ hashed(halves.widen_high().to_bytes()))
    var floats = Array[f32, 5].filled(0.5)
    large.store(mut floats.view_mut(), at: 1)
    say(log, label: "f32 load", value: hashed(core::simd::F32x4.load(floats.view(), at: 1).add(small).to_bytes()))
} report_f32

fn report_dot(log: sys::Log) {
    let a_i8 = lanes_i8(seed: 9, extremes: true)
    let b_i8 = lanes_i8(seed: 59, extremes: false)
    let a_i32 = lanes_i32(seed: 33, extremes: true)
    say(log, label: "i8 dot", value: hashed(a_i8.dot(b_i8, acc: a_i32).to_bytes()))
} report_dot

fn say(log: sys::Log, label: Str, value: u64) {
    log.info(label, value: value)
} say

fn main(take world: host::World) fails task::Cancelled uses wait {
    report_u8(world.log)
    report_i8(world.log)
    report_u16(world.log)
    report_i16(world.log)
    report_u32(world.log)
    report_i32(world.log)
    report_u64(world.log)
    report_i64(world.log)
    report_f32(world.log)
    report_dot(world.log)
} main
