    \\test send_without_a_receiver_fails_closed for Sender.send {
    \\    let world = testing::world()
    \\    let channel = Channel[u32].bounded(1, alloc: world.alloc)
    \\    let sender = channel.sender
    \\    discard channel.receiver
    \\    let outcome = attempt await sender.send(5)
    \\    let closed = match outcome {
    \\        Err(SendError.Closed) => true
    \\        else => false
    \\    }
    \\    expect closed
    \\} send_without_a_receiver_fails_closed
    \\
    \\test receive_ends_once_every_sender_is_released for Receiver.receive {
    \\    let world = testing::world()
    \\    let channel = Channel[u32].bounded(1, alloc: world.alloc)
    \\    let sender = channel.sender
    \\    var receiver = channel.receiver
    \\    try await sender.send(3)
    \\    discard sender
    \\    let value = try await mut receiver.receive()
    \\    let end = try await mut receiver.receive()
    \\    expect value == Some(3)
    \\    expect end == None
    \\} receive_ends_once_every_sender_is_released
    \\
    \\test drain_visits_values_oldest_first for Receiver.drain {
    \\    let world = testing::world()
    \\    let channel = Channel[u32].bounded(2, alloc: world.alloc)
    \\    let sender = channel.sender
    \\    let receiver = channel.receiver
    \\    try await sender.send(1)
    \\    try await sender.send(2)
    \\    discard sender
    \\    var digits: u32 = 0
    \\    try await take receiver.drain(visit: fn[mut digits](take value: u32) {
    \\        digits = digits * 10 + value
    \\    })
    \\    expect digits == 12
    \\} drain_visits_values_oldest_first
    \\

const TEXT_TESTING_PACKAGE: Str =
    \\//! The simulated world and structural comparison.
    \\
    \\package testing {
    \\    language 1
    \\    targets any
    \\} testing
    \\

const TEXT_TESTING_TESTING: Str =
    \\//! The simulated world and structural comparison.
    \\
    \\pub fn world() -> host::World
    \\    example mem::Bytes.zeroed(3, alloc: world().alloc).len() == 3
    \\
    \\pub fn same[T: Any](actual: T, expected: T) -> bool limits pure, notrap, terminates
    \\    example same(Some(3u8), expected: Some(3))
    \\    example not same(b"ab", expected: b"ac")
    \\

const TEXT_TEXT_CONSTRUCTION_CONSTRUCTION: Str =
    \\//! The construction text that derived `Render` writes.
    \\
    \\pub open struct Codec[T: Encode] {
    \\} Codec
    \\
    \\pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    \\    example attempt Codec[Option[i16]].decode(Untrusted.of(b" Some(-1_200) "), alloc: testing::world().alloc) == Ok(Some(-1_200))
    \\    example attempt Codec[mem::List[u8]].decode(Untrusted.of(b"[1, 2,]"), alloc: testing::world().alloc) == Err(core::DecodeError.Malformed)
    \\    example attempt Codec[char].decode(Untrusted.of(b"'\\\\u{D800}'"), alloc: testing::world().alloc) == Err(core::DecodeError.InvalidText)
    \\
    \\test decode_reads_text_literals for Codec.decode {
    \\    let escaped = attempt Codec[text::Fixed[4]].decode(Untrusted.of(b"\\"a\\\\\\"\\\\u{E9}\\""), alloc: testing::world().alloc)
    \\    let byte = attempt Codec[text::Fixed[4]].decode(Untrusted.of(b"\\"\\\\x41\\""), alloc: testing::world().alloc)
    \\    expect escaped == Ok(text::Fixed[4].of("a\\"é"))
    \\    expect byte == Ok(text::Fixed[4].of("A"))
    \\} decode_reads_text_literals
    \\

const TEXT_TEXT_JSON_JSON: Str =
    \\//! The JSON format.
    \\
    \\pub open struct Codec[T: Encode] {
    \\} Codec
    \\
    \\pub fn Codec.encode(value: T, mut out: text::String)
    \\
    \\pub fn Codec.try_encode(value: T, mut out: text::String) fails mem::OutOfMemory
    \\
    \\pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    \\    example attempt Codec[u32].decode(Untrusted.of(b" 42 "), alloc: testing::world().alloc) == Ok(42)
    \\    example attempt Codec[u32].decode(Untrusted.of(b"null"), alloc: testing::world().alloc) == Err(core::DecodeError.Malformed)
    \\
    \\test encode_writes_compact_json for Codec.encode {
    \\    var out = text::String.empty(testing::world().alloc)
    \\    Codec[Option[u8]].encode(Some(3), mut out)
    \\    expect out.as_str() == "{\\"Some\\":3}"
    \\} encode_writes_compact_json
    \\
    \\test try_encode_fails_without_memory for Codec.try_encode {
    \\    let budget = testing::world().alloc.split(0)
    \\    var out = text::String.empty(budget.alloc())
    \\    let encoded = attempt Codec[bool].try_encode(true, mut out)
    \\    take budget.close()
    \\    expect encoded == Err(mem::OutOfMemory.Exhausted)
    \\    expect out.is_empty()
    \\} try_encode_fails_without_memory
    \\

const TEXT_TEXT_PACKAGE: Str =
