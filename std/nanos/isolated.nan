//! Jobs in isolated spaces: the kernel's side, which places the jobs and instances its tasks ask for in one space, runs that space in user mode while it runs any and serves its system calls through the space's table of handles, running the test images it asks for in spaces of their own; and the first task of the space's runtime, which starts each job and instance its kernel orders in a domain of its own, on a world whose log, standard streams, random source, link's channels and capabilities of crossing kinds reach the kernel through those calls, and abandons each its kernel orders abandoned.

/// The system calls of an isolated space: waiting until a deadline of the kernel's clock, drawing
/// and releasing pages of its boot area, reading that clock, invoking an operation of a capability
/// the kernel serves, ending the space, and naming the routine its kernel resumes its thread in at
/// an exception.
const CALL_WAIT: u64 = 1

const CALL_DRAW: u64 = 2

const CALL_RELEASE: u64 = 3

const CALL_NOW: u64 = 5

const CALL_INVOKE: u64 = 6

const CALL_END: u64 = 11

const CALL_FAULT: u64 = 12

/// The roles of an `hw::UserState` register, as `register` takes them: the arguments of a system
/// call from 0, its number and its result, and the fourth argument of a call.
const ROLE_NUMBER: u64 = 6

const ROLE_RESULT: u64 = 7

const ROLE_FOURTH: u64 = 8

/// A call's results from `FAILURES` up are failures: an invalid call, a stale capability, a file
/// operation failing with a missing entry, a refusal, an invalid path or a full device, and a
/// closed standard stream.
const FAILURES: u64 = 0xFFFF_FFFF_FFFF_F000

const INVALID: u64 = 0xFFFF_FFFF_FFFF_FFFF

const STALE: u64 = 0xFFFF_FFFF_FFFF_FFFE

const MISSING_FILE: u64 = 0xFFFF_FFFF_FFFF_FFFD

const REFUSAL: u64 = 0xFFFF_FFFF_FFFF_FFFC

const BAD_PATH: u64 = 0xFFFF_FFFF_FFFF_FFFB

const FULL_DEVICE: u64 = 0xFFFF_FFFF_FFFF_FFFA

const CLOSED_STREAM: u64 = 0xFFFF_FFFF_FFFF_FFF9

/// The operations of the capabilities the kernel serves a job's space.
const LOG_LINE: u64 = 0

const READ_IN: u64 = 0

const WRITE_OUT: u64 = 1

const WRITE_ERR: u64 = 2

const FILL: u64 = 0

const TEST_RUN: u64 = 0

/// The operations of the file system the kernel serves a job's space: those of `sys::FsService`
/// but `read_all` and `write_all`, which the space makes of the others.
const FS_OPEN: u64 = 0

const FS_CREATE: u64 = 1

const FS_READ: u64 = 2

const FS_WRITE: u64 = 3

const FS_BYTE_LEN: u64 = 4

const FS_RELEASE: u64 = 5

const FS_REMOVE: u64 = 6

const FS_CREATE_DIR: u64 = 7

const FS_RENAME: u64 = 8

const FS_KIND: u64 = 9

const FS_LIST: u64 = 10

/// The operations of the runner capability the kernel serves an instance's space; a call through a
/// port, which waits for its reply, crosses the link instead.
const RUN_SEND_TO: u64 = 0

const RUN_REPLY: u64 = 1

const RUN_PUBLISH: u64 = 2

const RUN_SYNC: u64 = 3

const RUN_CAPABILITY: u64 = 4

const RUN_DROP: u64 = 5

/// The operations of the runner capability moving to the kernel the pages holding the encoding of a
/// message too long for the first channel of the space's link, and sending the kernel the message
/// that channel would carry of a waiting operation a job calls.
const RUN_MOVE: u64 = 6

const RUN_UP: u64 = 7

/// The most bytes the encoding of what crosses into a space's table takes.
const CARRIED_BYTES: usize = 128

/// The most bytes of the result a crossing kind's operation gives through `invoke`.
const CROSSED_BYTES: usize = 4_096

/// The bytes of a test image's start record: where the texts naming its run lie and their length.
const TEST_START_BYTES: usize = 16

/// The nanoseconds of the kernel's clock a test run may take, and the statuses a run ends with
/// when it takes more and when its thread faults on a page it cannot draw.
const TEST_NS: u64 = 10_000_000_000

const TIMED_OUT: u64 = 124

const CRASHED: u64 = 70

/// How an `CALL_END` call says the job ended: returned, failed, trapped, given an input it does not
/// decode or cancelled.
const ENDS_RETURNED: u64 = 0

const ENDS_FAILED: u64 = 1

const ENDS_TRAPPED: u64 = 2

const ENDS_UNDECODABLE: u64 = 3

const ENDS_CANCELLED: u64 = 4

/// The numbers of the trap kinds of an index out of range, of exhausted memory, of an exception and
/// of an abandoned domain.
const BOUNDS: u64 = 0

const EXHAUSTED: u64 = 6

const EXCEPTION: u64 = 15

const ABANDONED: u64 = 16

/// The most bytes the kernel copies out of a space for one call.
const MOST_BYTES: u64 = 1_048_576

/// The most bytes of a trap report.
const REPORT_BYTES: usize = 4_096

/// The report of the trap ending an instance whose space wrote what no end of its link's first
/// channel or of a bridge writes.
const BREACH_REPORT: Str = "trap.bounds writing what no end of a channel writes\n"

/// The bytes of a start record and of the record of a port.
const START_BYTES: usize = 104

const PORT_BYTES: usize = 40

/// The most entries a space's table holds at once.
const MOST_HELD: u64 = 256

/// The handles of a space's table are below `HANDLE_BOUND`: a slot whose next handle would not be
/// holds no entry again.
const HANDLE_BOUND: u64 = 0x0100_0000_0000_0000

pub closed enum IsolatedError derives Render {
    NoJob
    NoChannel
    Unplaced(sys::load::LoadError) from
    Cancelled(task::Cancelled) from
} IsolatedError

/// What the kernel serves a job or instance of an isolated space, or the space itself: the
/// capabilities a world's log, standard streams, random source and file system reach.
pub closed struct Services derives Copy {
    pub log: sys::Log
    pub stdio: sys::Stdio
    pub random: sys::Random
    pub fs: sys::Fs
} Services

/// An isolated space that jobs and instances join as tasks ask: what the tasks of every isolation
/// reach of it and the capability through which they reach it, whether its own tasks may ask no
/// more, and the executor and allocator of its kernel's tasks.
pub open struct Isolation derives Send {
    door: mem::Shared[Door]
    way: Doorway
    closed: core::atomic::AtomicBool
    exec: task::Executor
    alloc: mem::Alloc
} Isolation

/// What the tasks of every isolation reach of one: its table of handles, what they ask of the
/// task running its space, the signal waking that task, the number of the next job or instance,
/// what crossed into its table through bridges for its runtime to claim, the sender of the frames
/// moving into its space through them, or to its kernel through runner capabilities, while it takes
/// any, and the next token of what crosses.
struct Door {
    table: Table
    asks: task::Cown[Asks]
    woken: hw::Signal[u64]
    next: core::atomic::AtomicU64
    carries: task::Cown[mem::List[Carry]]
    moves: task::Cown[Option[task::Sender[Moving]]]
    tokens: core::atomic::AtomicU64
} Door

/// The door of an isolation whose own capabilities are those of `services`, `moves` sending to the
/// task keeping the frames moving into its space while it takes any.
fn Door.of(services: Services, take moves: Option[task::Sender[Moving]], alloc: mem::Alloc) -> Door {
    return Door(table: Table.of(services, alloc), asks: task::Cown.of(Asks(open: true, list: mem::List[Ask].empty(alloc)), alloc), woken: hw::Signal[u64].empty(), next: core::atomic::AtomicU64.of(1), carries: task::Cown.of(mem::List[Carry].empty(alloc), alloc), moves: task::Cown.of(take moves, alloc), tokens: core::atomic::AtomicU64.of(1))
} Door.of

/// Where an instance runs in an isolated space: the capability reaching the door of its isolation,
/// and its number there.
struct Placement derives Copy {
    door: Doorway
    id: u64
} Placement

/// A capability reaching the door of an isolation while the isolation runs, its record unused.
struct Doorway {
} Doorway

impl Doorway: sys::Kind[mem::Shared[Door], u64]

/// The door a doorway reaches, none once its isolation has returned.
fn Doorway.reached(self) -> Option[mem::Shared[Door]] {
    return sys::reach(self, body: fn(door: mem::Shared[Door], record: u64) => door.share())
} Doorway.reached

/// Gives `ask` to the task running the space of the isolation a doorway reaches, as `Door.asked`
/// does; once that isolation has returned, `ask` is dropped.
fn Doorway.asked(self, take ask: Ask) fails task::Cancelled uses wait {
    let Some(door) = self.reached() else {
        return
    }
    try await door.contents().asked(take ask)
} Doorway.asked

/// What tasks ask of the task running an isolation's space, and whether it still takes asks.
struct Asks {
    open: bool
    list: mem::List[Ask]
} Asks

/// What a task asks of the task running an isolation's space: to place a job or instance; to lend
/// its space, while it runs the instance of a number, to map the frames of a bridge to it; to open
/// the ends of bridges for the instance of a number, which starts once they are open; that the end
/// of a bridge be told its other end wrote or read; to close the end of a bridge; to end the
/// instance of a number as breaching its link's first channel or a bridge; to give what moved
/// to the kernel through the runner capability of an instance; and to tell the runtime of the job
/// or instance of a number the result of a waiting operation of a crossing kind's capability it
/// called through its runner capability.
enum Ask {
    Join(Joining)
    Lend(Borrowing)
    Open(Opening)
    Ring(Ringing)
    Close(Closing)
    Breach(u64)
    Read(Reading)
    Resolve(Resolution)
} Ask

/// The result of a waiting operation of a crossing kind's capability that the job or instance
/// numbered `id` called through its runner capability.
struct Resolution {
    id: u64
    reply: PortReply
} Resolution

/// An ask to lend a space to map the frames of a bridge to the instance numbered `id`.
struct Borrowing {
    id: u64
    lend: task::Sender[Lending]
} Borrowing

/// An ask for the bytes that moved to the kernel under `token` through the runner capability whose
/// handle is `handle`, given through `reply`.
struct Reading {
    handle: u64
    token: u64
    reply: task::Sender[mem::Bytes]
} Reading

/// The record from which a space's runtime starts a job or instance, or abandons one: what it
/// orders, the number of the job or instance, its entry, where its input lies and its length, the
/// address of its link's doorbell, where the records of its link's channels lie and their count,
/// 1 when it is the instance of a component entry that the link's first channel carries, 0 for a
/// job, the handle of its runner capability, and where the encoding of what crossed into the
/// space's table for its world lies and its length.
struct Start derives Copy {
    order: u64
    id: u64
    job: sys::load::Job
    input: u64
    input_len: u64
    bell: u64
    ports: u64
    port_count: u64
    held: u64
    runner: u64
    granted: u64
    granted_len: u64
} Start

/// A capability a space holds by the handle naming its entry in the space's table.
enum Holding derives Copy {
    Log(sys::Log)
    Stdio(sys::Stdio)
    Random(sys::Random)
    Fs(sys::Fs)
    Tests
    Orders
    Channel(usize)
    Runner
    Kind(sys::Handle)
    Bridge
} Holding

/// An entry of a space's table: the number of the job or instance it was added for, 0 for the
/// space's own, and the capability it holds.
struct Entry derives Copy {
    job: u64
    holding: Holding
} Entry

/// A space's table of handles: `MOST_HELD` slots, the slot of a handle being its remainder by
/// `MOST_HELD`.
struct Table {
    slots: hw::SpinLock[mem::List[Slot]]
} Table

/// A slot of a space's table: the handle naming its entry, which advances by `MOST_HELD` each time
/// its entry is taken back, so that every earlier handle of the slot is stale, and that entry, none
/// while the slot is free.
struct Slot derives Copy {
    handle: u64
    entry: Option[Entry]
} Slot

/// A capability the kernel adds to a space's table for its runtime to receive: its type, and its
/// handle.
enum Carried derives Copy, Encode {
    Log(u64)
    Stdio(u64)
    Random(u64)
    Kind(Crossed)
} Carried

/// A capability of a crossing kind the kernel adds to a space's table: its handle, and the handle
/// hash of its kind.
struct Crossed derives Copy, Encode {
    handle: u64
    hash: Array[u8, 33]
} Crossed

/// A capability of a job's or instance's world as it crosses into the space's table: its key, and
/// what crossed.
struct Granted derives Encode {
    key: text::String
    carried: Carried
} Granted

/// What crossed into the space's table for a job's or instance's world: the handles of its log,
/// standard streams, random source and file system, its capabilities, and the ends of the bridges it
/// calls through.
struct Granting derives Encode {
    log: u64
    stdio: u64
    random: u64
    fs: u64
    caps: mem::List[Granted]
    ends: mem::List[EndAt]
} Granting

/// The allocator, executor and clock of a space's runtime.
struct Base {
    alloc: mem::Alloc
    exec: task::Executor
    clock: sys::Clock
} Base

/// A capability the kernel serves a space, its record the handle that the space's calls name.
struct Remote {
} Remote

impl Remote: sys::Kind[Spaced, u64]

impl Remote: sys::LogService

impl Remote: sys::StdioService

impl Remote: sys::RandomService

impl Remote: sys::FsService

impl Remote: sys::Crossing

/// The arguments of a log line.
struct LogLine derives Encode {
    level: u8
    message: text::String
    value: text::String
} LogLine

/// An entry of a directory a space lists: its name, and its kind's number.
struct Listed derives Encode {
    name: text::String
    kind: u8
} Listed

/// The arguments of a test run: the paths of the test image and of the file taking its output, and
/// the texts naming the run.
struct TestRun derives Encode {
    image: text::String
    output: text::String
    texts: mem::List[text::String]
} TestRun

/// The arguments of a call handed to the runner capability through a port.
struct Sending derives Encode {
    port: u64
    hash: sys::ProtocolHash
    call: Naming
} Sending

/// The arguments of a reply to a request the runner capability holds pending.
struct Replying derives Encode {
    request: u64
    reply: Naming
} Replying

pub fn isolate[E](cpu: hw::Ring0, tenant: u64, clock: sys::Clock, services: Services, mut frames: mem::List[hw::PhysFrame[4_096]], mut extended: Option[hw::ExtendedState], exec: task::Executor, alloc: mem::Alloc, body: fn(space: Isolation) fails E uses wait limits stack 131_072) fails E uses wait {
    let task::Channel(sender: moves, receiver: moving) = task::Channel[Moving].bounded(QUEUED_CALLS, alloc)
    let shared = mem::Shared.of(Door.of(services, moves: Some(take moves), alloc), alloc)
    let doors = sys::Minter[Doorway, mem::Shared[Door], u64].of(shared.share(), alloc)
    defer take doors.close()
    let isolation = Isolation(door: take shared, way: doors.mint(0), closed: core::atomic::AtomicBool.of(false), exec: exec, alloc: alloc)
    var arriving = Some(take moving)
    let scoped = attempt await task::scope(exec, body: fn[mut frames, mut extended, mut arriving](s: task::Scope) fails E uses wait {
        let Some(moved_in) = mut arriving.extract() else {
            return
        }
        let keeping = s.spawn(fn[take moved_in]() -> mem::List[hw::PhysFrame[4_096]] fails task::Cancelled uses wait {
            return try await moves_kept(take moved_in, alloc)
        })
        let driving = s.spawn(fn[mut frames, mut extended]() fails task::Cancelled uses wait {
            try await driven(cpu, tenant, clock, services, isolation, mut frames, mut extended)
        })
        let outcome = attempt await body(isolation)
        isolation.closed.store(true)
        isolation.wake(WOKE_ORDERS)
        discard attempt await take driving.join()
        discard attempt await isolation.door.contents().moves_ended()
        match attempt await take keeping.join() {
            Ok(left) => {
                for frame in take left {
                    mut frames.push(take frame)
                }
            }
            Err(_) => {}
        }
        match outcome {
            Ok(_) => {}
            Err(failure) => fail failure
        }
    })
    match arriving {
        Some(unkept) => {
            discard attempt await take unkept.drain(visit: fn[mut frames](take parked: Moving) {
                moving_released(take parked, mut frames)
            })
        }
        None => {}
    }
    match scoped {
        Ok(_) => {}
        Err(failure) => fail failure
    }
} isolate

pub fn run_isolated(space: Isolation, job: sys::load::Isolated, link: Link, services: Services, caps: Caps, take input: mem::Bytes, alloc: mem::Alloc) -> Ended fails IsolatedError uses wait {
    if job.job().is_none() {
        fail IsolatedError.NoJob
    }
    let halted = mem::Shared.of(core::atomic::AtomicBool.of(false), alloc)
    let Joined(outcome: outcome, cancelled: cancelled) = try await joined(space, id: space.number(), job, component: None, link, services, caps, take input, runner: sys::Runner.denied(), halted, alloc)
    match cancelled {
        Some(cancellation) => fail IsolatedError.Cancelled(take cancellation)
        None => {}
    }
    match outcome {
        Ok(how) => return how
        Err(error) => fail IsolatedError.Unplaced(error)
    }
} run_isolated

/// The number of the next job or instance to join the space; 0, which names none, once numbers
/// run out.
fn Isolation.number(self) -> u64 {
    return self.door.contents().next.fetch_add(1).value_or(0)
} Isolation.number

/// Wakes the task running the space of an isolation.
fn Isolation.wake(self, why: u64) {
    self.door.contents().wake(why)
} Isolation.wake

/// Wakes the task running the space of the isolation of a door.
fn Door.wake(self, why: u64) {
    hw::without_irqs(fn(t: hw::IrqsDisabled) {
        self.woken.post(t, value: why)
    })
} Door.wake

/// Gives `ask` to the task running the space of the isolation of a door, waking it; once the
/// isolation takes no more, `ask` is dropped.
fn Door.asked(self, take ask: Ask) fails task::Cancelled uses wait {
    let asks = self.asks.share()
    var queued = false
    await when mut asks {
        if asks.open {
            mut asks.list.push(take ask)
            queued = true
        }
    }
    if queued {
        self.wake(WOKE_ORDERS)
    }
} Door.asked

/// What a `CALL_WAIT` call gives: that a doorbell rang, and that the kernel has orders for the
/// runtime.
const WOKE_RUNG: u64 = 1

const WOKE_ORDERS: u64 = 2

/// The operation of the orders handle, which takes the kernel's next order, and the orders it
/// gives: starting a job or instance, abandoning one, and telling one of the end of a bridge it
/// holds or of the reply to a waiting call it made.
const TAKE: u64 = 0

const ORDER_START: u64 = 0

const ORDER_ABANDON: u64 = 1

const ORDER_NOTICE: u64 = 2

/// The handles of a space's table holding the standard streams and file system of its services,
/// its test runs and its kernel's orders.
const STDIO_HANDLE: u64 = 1

const FS_HANDLE: u64 = 3

const TESTS_HANDLE: u64 = 4

const ORDERS_HANDLE: u64 = 5

/// A job or instance a task asks its isolation to place: its number, its bundle, the name of its
/// component entry, none for a job, its input, the runner it acts through, the services and the
/// capabilities of its world, the keys of its link's channels but those carrying the calls of
/// ports, whether it starts only once the ends of its bridges are open, whether its holder abandoned
/// it, and the senders through which the task running the space lends it the space to map its link,
/// tells it through which of its channels the space moved bytes and what the space sent through its
/// runner capability, and tells it how it ended or why it could not be placed.
struct Joining {
    id: u64
    bundle: sys::load::Isolated
    component: Option[text::String]
    input: mem::Bytes
    runner: sys::Runner
    services: Services
    caps: Caps
    keys: mem::List[text::String]
    bridged: bool
    halted: mem::Shared[core::atomic::AtomicBool]
    lend: task::Sender[Lending]
    notices: task::Sender[Notified]
    ended: task::Sender[Outcome]
} Joining

/// A space lent to a task to map its link's frames, and the sender giving it back.
linear struct Lending {
    space: sys::load::Space
    back: task::Sender[Lent]
} Lending

/// A space given back with the addresses at which it maps a link's frames: its doorbell, then each
/// channel's inbound and outbound frames but those of ports, none when it could not map them all;
/// the addresses at which it maps the channels of ports; and the ends of bridges it maps.
linear struct Lent {
    space: sys::load::Space
    frames: mem::List[u64]
    ported: mem::List[u64]
    ends: mem::List[Bridged]
} Lent

/// How a job or instance its space ran ended: as it says, or with a trap; or why it could not be
/// placed.
enum Outcome {
    Ended(Ended)
    Trapped(Trapping)
    Unplaced(sys::load::LoadError)
} Outcome

/// A trap ending a job or instance: the number of its kind, and its report, empty to locate the
/// call ending it.
struct Trapping {
    kind: u64
    report: text::String
} Trapping

/// How a job or instance a task asked to place ended, or why it could not be placed, and the
/// cancellation that had its task abandon it.
struct Joined {
    outcome: Result[Ended, sys::load::LoadError]
    cancelled: Option[task::Cancelled]
} Joined

/// Has the space of `isolation` run the entry of `job`, its component entry `component`'s or its
/// job's, as the job or instance numbered `id`, on `input` with `link`, a world reaching `services`
/// and the capabilities of `caps` that cross into the space, acting through `runner`, bridging each
/// channel of `link` that carries the calls of a port to the instance answering them, and gives how
/// it ended once no space maps `link`'s frames, or why it could not be placed, the table then taking
/// back every entry added for it and the door dropping what it kept for its ends. While it runs, it
/// is watched as `run_watched` watches it; once `halted` holds true, or this call is cancelled, the
/// space abandons it.
fn joined(isolation: Isolation, id: u64, job: sys::load::Isolated, take component: Option[text::String], link: Link, services: Services, caps: Caps, take input: mem::Bytes, runner: sys::Runner, halted: mem::Shared[core::atomic::AtomicBool], alloc: mem::Alloc) -> Joined fails task::Cancelled uses wait {
    if id == 0 {
        return Joined(outcome: Err(sys::load::LoadError.Unplaceable), cancelled: None)
    }
    let task::Channel(sender: lend, receiver: lent) = task::Channel[Lending].bounded(1, alloc)
    let task::Channel(sender: notices, receiver: noticed) = task::Channel[Notified].bounded(QUEUED_CALLS, alloc)
    let task::Channel(sender: ended, receiver: ending) = task::Channel[Outcome].bounded(1, alloc)
    let task::Channel(sender: stop, receiver: stopping) = task::Channel[u8].bounded(1, alloc)
    let instance = component.is_some()
    var keys = mem::List[text::String].empty(alloc)
    var keyed = mem::List[usize].empty(alloc)
    var porting_out = false
    for index in 0..<link.channels.len() {
        let channel = link.channels[index]
        match channel.port {
            Some(porting) => {
                porting_out = porting_out or porting.bridged(instance)
            }
            None => {
                mut keys.push(text::String.of(channel.key.as_str(), alloc))
                mut keyed.push(index)
            }
        }
    }
    var granted = Caps.empty(alloc)
    for held in caps.held {
        mut granted.held.push(Held(key: text::String.of(held.key.as_str(), alloc), handle: held.handle))
    }
    let joining = Joining(id: id, bundle: job.share(), component: take component, input: take input, runner: runner, services: services, caps: take granted, keys: take keys, bridged: porting_out, halted: halted.share(), lend: take lend, notices: take notices, ended: take ended)
    discard attempt await isolation.door.contents().asked(Ask.Join(take joining))
    var lendings = mem::List[Lending].empty(alloc)
    discard attempt await take lent.drain(visit: fn[mut lendings](take value: Lending) {
        mut lendings.push(take value)
    })
    var ports = mem::List[Ported].empty(alloc)
    for lending in take lendings {
        let Lending(space: given, back: back) = lending
        var space = given
        let frames = mapped(mut space, link, alloc)
        if porting_out {
            ports = ports_mapped(mut space, link, instance, alloc)
        }
        var addresses = mem::List[u64].empty(alloc)
        for port in ports {
            mut addresses.push(port.inbound)
            mut addresses.push(port.outbound)
        }
        discard attempt await back.send(Lent(space: take space, frames: take frames, ported: take addresses, ends: mem::List[Bridged].empty(alloc)))
    }
    var remote = mem::List[PeerEnd].empty(alloc)
    if porting_out {
        var ends = mem::List[Bridged].empty(alloc)
        for port in ports {
            match attempt await bridge_opened(isolation, id, link, caps, port, alloc) {
                Ok(Some(Spanning(near: near, far: far))) => {
                    mut ends.push(take near)
                    mut remote.push(take far)
                }
                else => {}
            }
        }
        discard attempt await isolation.door.contents().asked(Ask.Open(Opening(id: id, ends: take ends)))
    }
    let ran = attempt await run_watched(isolation, id, link, keyed, halted, receivers: Receivers(noticed: take noticed, stopping: take stopping, ending: take ending), take stop, alloc)
    for far in remote {
        discard attempt await far_closed(far, alloc)
    }
    match ran {
        Ok(done) => {
            isolation.door.contents().table.taken_back(id)
            try await isolation.door.contents().carries_dropped()
            return done
        }
        Err(cancellation) => fail cancellation
    }
} joined

/// Waits until the job or instance numbered `id` that `receivers` hears of has ended, and gives how
/// it ended: while it runs, each ring of `link` wakes the task running the space, the channels the
/// space moved bytes through, whose indices in `link` `keyed` gives, are heard from, and each
/// waiting operation of a capability of a crossing kind its space sends through its runner
/// capability is called on a task of its own; once `halted` holds true, or this call is cancelled,
/// the space abandons it, and once it has ended, `stop` tells so.
fn run_watched(isolation: Isolation, id: u64, link: Link, keyed: mem::List[usize], halted: mem::Shared[core::atomic::AtomicBool], take receivers: Receivers, take stop: task::Sender[u8], alloc: mem::Alloc) -> Joined fails task::Cancelled uses wait {
    var outcome: Result[Ended, sys::load::LoadError] = Err(sys::load::LoadError.Unplaceable)
    var cancelled: Option[task::Cancelled] = None
    var receiving = Some(take receivers)
    try await task::scope(isolation.exec, body: fn[mut outcome, mut cancelled, mut receiving](s: task::Scope) fails task::Cancelled uses wait {
        let Some(Receivers(noticed: heard, stopping: watched, ending: told)) = mut receiving.extract() else {
            return
        }
        discard s.spawn(fn() fails task::Cancelled uses wait {
            loop {
                discard try await link.rung.wait()
                isolation.wake(WOKE_RUNG)
            }
        })
        discard s.spawn(fn[take heard]() fails task::Cancelled uses wait {
            var hearing = heard
            try await task::scope(isolation.exec, body: fn[mut hearing](calls: task::Scope) fails task::Cancelled uses wait {
                loop {
                    match try await mut hearing.receive() {
                        Some(Notified.Moved(channel)) => {
                            if channel < keyed.len() {
                                link.heard_from(keyed[channel])
                            }
                        }
                        Some(Notified.Sent(bytes)) => {
                            discard calls.spawn(fn[take bytes]() fails task::Cancelled uses wait {
                                try await sent_heard(isolation, id, take bytes, alloc)
                            })
                        }
                        None => return
                    }
                }
            })
        })
        let watching = s.spawn(fn[take watched]() -> Option[task::Cancelled] fails task::Cancelled uses wait {
            var held = watched
            match attempt await mut held.receive() {
                Ok(_) => return None
                Err(cancellation) => {
                    halted.contents().store(true)
                    isolation.wake(WOKE_ORDERS)
                    return Some(take cancellation)
                }
            }
        })
        try await take told.drain(visit: fn[mut outcome](take result: Outcome) {
            outcome = match result {
                Outcome.Ended(how) => Ok(take how)
                Outcome.Trapped(Trapping(kind: kind, report: report)) => Ok(Ended.Trapped(trap_of(kind, report: report.as_str(), alloc)))
                Outcome.Unplaced(error) => Err(error)
            }
        })
        discard stop.offer(0)
        cancelled = try await take watching.join()
        s.cancel()
    })
    return Joined(outcome: take outcome, cancelled: take cancelled)
} run_watched

/// The receivers through which a job's or instance's task hears which of its link's channels the
/// space moved bytes through and what its space sent through its runner capability, that it is no
/// longer cancellable, and how it ended.
struct Receivers {
    noticed: task::Receiver[Notified]
    stopping: task::Receiver[u8]
    ending: task::Receiver[Outcome]
} Receivers

/// What the task running a space tells the task of one of its jobs or instances: that the space
/// moved bytes through the channel of an index of its link, or the encoding of a message the space
/// sent through its runner capability.
enum Notified {
    Moved(usize)
    Sent(mem::Bytes)
} Notified

/// Calls the waiting operation of a capability of a crossing kind that the space of `isolation`
/// sent, `bytes` encoding it, for the job or instance numbered `id`, as one sent up the first channel
/// of an instance's link, and has the space's runtime told its result; once the space sends what
/// does not encode such a call, has the job or instance ended as breaching what it writes.
fn sent_heard(isolation: Isolation, id: u64, take bytes: mem::Bytes, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let door = isolation.door.contents()
    let Heard.Up(Up.Awaited(asked)) = try await moved_heard(isolation, heard: up_of(bytes, alloc), table: door.table, job: id, alloc) else {
        try await door.asked(Ask.Breach(id))
        return
    }
    let Awaiting(id: wait, handle: handle, operation: operation, args: args) = asked
    let answer = try await kind_answer(handle, operation, args: args.view(), table: door.table, job: id, alloc)
    try await door.asked(Ask.Resolve(Resolution(id: id, reply: PortReply(id: wait, answer: take answer))))
} sent_heard

/// Maps a link's doorbell, then the inbound and outbound frames of each of its channels but those of
/// ports, into a space,
/// giving their addresses there, or none, mapping nothing, when the space has too few pages for
/// user frames left.
fn mapped(mut space: sys::load::Space, link: Link, alloc: mem::Alloc) -> mem::List[u64] {
    var addresses = mem::List[u64].empty(alloc)
    var whole = shared_into(mut space, frame: link.bell, mut addresses)
    for channel in link.channels {
        if channel.port.is_none() {
            whole = whole and shared_into(mut space, frame: channel.inbound, mut addresses) and shared_into(mut space, frame: channel.outbound, mut addresses)
        }
    }
    if whole {
        return addresses
    }
    for address in addresses {
        mut space.unshare(address)
    }
    return mem::List[u64].empty(alloc)
} mapped

/// Maps a user frame into a space, adding its address there to `addresses`; false when the space
/// has no page for it left.
fn shared_into(mut space: sys::load::Space, frame: hw::UserFrame, mut addresses: mem::List[u64]) -> bool {
    match attempt mut space.share(frame) {
        Ok(address) => {
            mut addresses.push(address)
            return true
        }
        Err(_) => return false
    }
} shared_into

/// A job or instance its space runs: its entry, the runner it acts through, what crossed into the
/// space's table for each capability that runner holds by number, the addresses at which the space
/// maps its link's frames and the frames of the bridges it holds, whether its holder abandoned it,
/// whether it breached a channel and whether the space's runtime was ordered to abandon it, and the
/// senders telling its task through which of its channels the space moved bytes and what the space
/// sent through its runner capability, and how it ended.
struct Running {
    job: sys::load::Job
    runner: sys::Runner
    ids: mem::Map[u64, Carried]
    frames: mem::List[u64]
    halted: mem::Shared[core::atomic::AtomicBool]
    breached: bool
    abandoning: bool
    notices: task::Sender[Notified]
    ended: task::Sender[Outcome]
} Running

/// A job or instance placed in its space that the space's runtime has not taken yet: its number,
/// entry and input, whether it is an instance, the addresses of its link's frames, the keys and
/// handles of its link's channels, the handle of its runner capability, what crossed into the
/// space's table for its world, and whether it waits for the ends of its bridges to open.
struct Pending {
    id: u64
    job: sys::load::Job
    input: mem::Bytes
    held: bool
    frames: mem::List[u64]
    keys: mem::List[text::String]
    channels: mem::List[u64]
    runner: u64
    granting: Granting
    bridging: bool
} Pending

/// What the task running an isolation's space keeps of it: the door of the isolation, the state of
/// its thread, the routine its runtime named to be resumed in at an exception, whether the thread
/// waits for the answer to a `CALL_WAIT` call and whether that call woke by a ring, the jobs and
/// instances it runs by number, those its runtime has not taken, those its runtime is ordered to
/// abandon, what its runtime is told of the ends of bridges its instances hold, those ends by their
/// handles, the asks it has for other isolations, and the files they opened.
struct Driven {
    door: mem::Shared[Door]
    state: hw::UserState
    fault_routine: u64
    waiting: Option[u64]
    jobs: mem::Map[u64, Running]
    pending: mem::List[Pending]
    abandons: mem::List[u64]
    notices: mem::List[Notice]
    bridges: mem::Map[u64, BridgeEnd]
    leaving: mem::List[Leaving]
    files: Files
} Driven

/// What the runtime of a space is told for the job or instance numbered `id`.
struct Notice {
    id: u64
    told: Telling
} Notice

/// What the runtime of a space is told for a job or instance: of the end of a bridge the instance
/// holds, or the result of a waiting operation of a crossing kind's capability it called through its
/// runner capability.
enum Telling derives Encode {
    Bridge(Bridging)
    Reply(PortReply)
} Telling

/// What is kept of a space of the isolation of `door` that has just been made, its thread starting
/// its runtime.
fn Driven.of(space: sys::load::Space, door: mem::Shared[Door], alloc: mem::Alloc) -> Driven {
    var state = hw::UserState(regs: Array[Untrusted[u64], 31].filled(Untrusted.of(0)), sp: Untrusted.of(space.stack()), ip: Untrusted.of(space.start()), flags: Untrusted.of(0))
    state.regs[register(1)] = Untrusted.of(space.boot_area())
    return Driven(door: door.share(), state: state, fault_routine: 0, waiting: None, jobs: mem::Map[u64, Running].empty(alloc), pending: mem::List[Pending].empty(alloc), abandons: mem::List[u64].empty(alloc), notices: mem::List[Notice].empty(alloc), bridges: mem::Map[u64, BridgeEnd].empty(alloc), leaving: mem::List[Leaving].empty(alloc), files: Files(open: mem::Map[u64, sys::fs::File].empty(alloc), next: 0))
} Driven.of

/// A space running jobs or instances, and what the task running it keeps of it.
linear struct Placed {
    space: sys::load::Space
    driving: Driven
} Placed

/// A space of the isolation of `door` that has just been made, its thread starting its runtime.
fn placed_of(take space: sys::load::Space, door: mem::Shared[Door], alloc: mem::Alloc) -> Placed {
    let driving = Driven.of(space, door, alloc)
    return Placed(space: take space, driving: take driving)
} placed_of

/// Runs the space of `isolation` for `tenant` on `cpu`, with the extended state `extended` holds,
/// while it runs jobs or instances, placing each that a task asks to join it: makes the space from
/// `frames` for the first, maps the bundle of each into it, and gives its frames back to `frames`
/// once the last has ended; returns once `isolation` is closed and the space runs none.
fn driven(cpu: hw::Ring0, tenant: u64, clock: sys::Clock, services: Services, isolation: Isolation, mut frames: mem::List[hw::PhysFrame[4_096]], mut extended: Option[hw::ExtendedState]) fails task::Cancelled uses wait {
    let alloc = isolation.alloc
    var placing = mem::List[Placed].empty(alloc)
    loop {
        discard attempt await asks_served(cpu, tenant, isolation, mut placing, mut frames)
        let Some(placed) = mut placing.pop() else {
            if isolation.closed.load() {
                spaces_released(take placing, mut frames)
                discard attempt await forgotten(isolation)
                return
            }
            match attempt await isolation.door.contents().woken.wait() {
                Ok(_) => {}
                Err(cancelled) => {
                    spaces_released(take placing, mut frames)
                    discard attempt await forgotten(isolation)
                    fail cancelled
                }
            }
            continue
        }
        let Placed(space: made, driving: kept) = placed
        var running = made
        var held = kept
        if mut held.halts(mut running, alloc) {
            mut held.ended_all(mut running, kind: ABANDONED, report: "", alloc)
            discard attempt await mut held.left()
            take running.release(mut frames)
            continue
        }
        if held.jobs.len() == 0 {
            take running.release(mut frames)
            continue
        }
        match held.waiting {
            Some(woke) => {
                held.state.regs[register(ROLE_RESULT)] = Untrusted.of(woke | held.orders())
                held.waiting = None
            }
            None => {}
        }
        match attempt await mut held.served(cpu, tenant, clock, services, isolation, space: mut running, mut frames, mut extended) {
            Ok(_) => {
                discard attempt await mut held.left()
                kept_placed(take running, driving: take held, mut placing, mut frames)
            }
            Err(cancelled) => {
                mut held.ended_all(mut running, kind: ABANDONED, report: "", alloc)
                discard attempt await mut held.left()
                take running.release(mut frames)
                spaces_released(take placing, mut frames)
                discard attempt await forgotten(isolation)
                fail cancelled
            }
        }
    }
} driven

/// Serves what the tasks of every isolation ask of the task running the space of `isolation`,
/// which `placing` holds while it runs jobs or instances, drawing from and giving back to `frames`.
fn asks_served(cpu: hw::Ring0, tenant: u64, isolation: Isolation, mut placing: mem::List[Placed], mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let alloc = isolation.alloc
    let asked = match attempt await asks_taken(isolation) {
        Ok(taken) => taken
        Err(_) => mem::List[Ask].empty(alloc)
    }
    for ask in take asked {
        match ask {
            Ask.Join(joining) => {
                discard attempt await admitted(cpu, tenant, isolation, take joining, mut placing, mut frames)
            }
            Ask.Lend(borrowing) => {
                discard attempt await lent_for(take borrowing, mut placing, mut frames, alloc)
            }
            Ask.Open(opening) => {
                discard attempt await placed_asked(Ask.Open(take opening), mut placing, alloc)
            }
            Ask.Ring(ringing) => {
                discard attempt await placed_asked(Ask.Ring(take ringing), mut placing, alloc)
            }
            Ask.Close(closing) => {
                discard attempt await placed_asked(Ask.Close(take closing), mut placing, alloc)
            }
            Ask.Breach(id) => {
                discard attempt await placed_asked(Ask.Breach(id), mut placing, alloc)
            }
            Ask.Resolve(resolution) => {
                discard attempt await placed_asked(Ask.Resolve(take resolution), mut placing, alloc)
            }
            Ask.Read(reading) => {
                discard attempt await isolation.door.contents().read(take reading, mut frames, alloc)
            }
        }
    }
} asks_served

/// Gives back to `frames` the frames of each space of a list.
fn spaces_released(take placing: mem::List[Placed], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    for placed in take placing {
        let Placed(space: space, driving: _) = placed
        take space.release(mut frames)
    }
} spaces_released

/// Keeps in `placing` a space while it runs jobs or instances, giving its frames back to `frames`
/// otherwise.
fn kept_placed(take running: sys::load::Space, take driving: Driven, mut placing: mem::List[Placed], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    if driving.jobs.len() == 0 {
        take running.release(mut frames)
        return
    }
    mut placing.push(Placed(space: take running, driving: take driving))
} kept_placed

/// Takes no more asks of an isolation that no space will run, and drops each it has not taken, so
/// that each asking task hears that its job or instance could not be placed or its ask was not
/// served.
fn forgotten(isolation: Isolation) fails task::Cancelled uses wait {
    let asks = isolation.door.contents().asks.share()
    var unserved = mem::List[Ask].empty(isolation.alloc)
    await when mut asks {
        asks.open = false
        while asks.list.len() > 0 {
            mut unserved.push(mut asks.list.remove(0))
        }
    }
    discard unserved
} forgotten

/// What the tasks of every isolation ask of the task running the space of `isolation`.
fn asks_taken(isolation: Isolation) -> mem::List[Ask] fails task::Cancelled uses wait {
    let asks = isolation.door.contents().asks.share()
    var taken = mem::List[Ask].empty(isolation.alloc)
    await when mut asks {
        while asks.list.len() > 0 {
            mut taken.push(mut asks.list.remove(0))
        }
    }
    return taken
} asks_taken

/// Places the job or instance `joining` asks for in the space `placing` holds, making a space when
/// it holds none: maps its bundle, adds each capability of its world that crosses to the table,
/// lends the space to its task to map and bridge its link, adds its link's channels, its runner and
/// its world's services to the table, and queues its start; or tells its task why it could not be
/// placed. `placing` keeps the space while it runs jobs or instances, its frames given back to
/// `frames` otherwise.
fn admitted(cpu: hw::Ring0, tenant: u64, isolation: Isolation, take joining: Joining, mut placing: mem::List[Placed], mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let alloc = isolation.alloc
    let Joining(id: id, bundle: bundle, component: component, input: input, runner: runner, services: services, caps: caps, keys: keys, bridged: holding_back, halted: halted, lend: lend, notices: notices, ended: ended) = joining
    let placed = match mut placing.pop() {
        Some(held) => held
        None => match attempt bundle.space(cpu, data: 0, tenant, mut frames, alloc) {
            Ok(fresh) => placed_of(take fresh, door: isolation.door, alloc)
            Err(error) => {
                discard ended.offer(Outcome.Unplaced(error))
                return
            }
        }
    }
    let Placed(space: made, driving: kept) = placed
    var running = made
    var held = kept
    let instance = component.is_some()
    let entry = match attempt bundle.join(mut running, mut frames, alloc) {
        Ok(view) => match component {
            Some(name) => view.component(name.as_str())
            None => view.job()
        }
        Err(_) => None
    }
    let Some(job) = entry else {
        discard ended.offer(Outcome.Unplaced(sys::load::LoadError.Unplaceable))
        kept_placed(take running, driving: take held, mut placing, mut frames)
        return
    }
    let table = isolation.door.contents().table
    var crossed = mem::List[Granted].empty(alloc)
    for grant in caps.held {
        let one = Array[sys::Handle, 1].filled(grant.handle)
        match table.admitted(job: id, handles: one.view(), alloc) {
            Some(crossing) => mut crossed.push(Granted(key: text::String.of(grant.key.as_str(), alloc), carried: crossing[0]))
            None => {}
        }
    }
    let task::Channel(sender: back, receiver: giving) = task::Channel[Lent].bounded(1, alloc)
    discard attempt await lend.send(Lending(space: take running, back: take back))
    discard lend
    var given = mem::List[Lent].empty(alloc)
    discard attempt await take giving.drain(visit: fn[mut given](take value: Lent) {
        mut given.push(take value)
    })
    let Some(lent) = mut given.pop() else {
        discard ended.offer(Outcome.Unplaced(sys::load::LoadError.Unplaceable))
        lents_released(take given, mut frames)
        return
    }
    lents_released(take given, mut frames)
    let Lent(space: returned_space, frames: addresses, ported: ports, ends: _) = lent
    if addresses.len() != 1 + 2 * keys.len() {
        discard ended.offer(Outcome.Unplaced(sys::load::LoadError.Unplaceable))
        kept_placed(take returned_space, driving: take held, mut placing, mut frames)
        return
    }
    var channels = mem::List[u64].empty(alloc)
    for index in 0..<keys.len() {
        mut channels.push(table.held_by(job: id, holding: Holding.Channel(index)))
    }
    let acting = table.held_by(job: id, holding: Holding.Runner)
    let granted = Granting(log: table.held_by(job: id, holding: Holding.Log(services.log)), stdio: table.held_by(job: id, holding: Holding.Stdio(services.stdio)), random: table.held_by(job: id, holding: Holding.Random(services.random)), fs: table.held_by(job: id, holding: Holding.Fs(services.fs)), caps: take crossed, ends: mem::List[EndAt].empty(alloc))
    var unmapping = mem::List[u64].empty(alloc)
    for address in addresses {
        mut unmapping.push(address)
    }
    for address in ports {
        mut unmapping.push(address)
    }
    discard mut held.jobs.insert(id, value: Running(job: job, runner: runner, ids: mem::Map[u64, Carried].empty(alloc), frames: take unmapping, halted: take halted, breached: false, abandoning: false, notices: take notices, ended: take ended))
    mut held.pending.push(Pending(id: id, job: job, input: take input, held: instance, frames: take addresses, keys: take keys, channels: take channels, runner: acting, granting: take granted, bridging: holding_back))
    mut placing.push(Placed(space: take returned_space, driving: take held))
} admitted

/// Gives back to `frames` the frames of each space a list of spaces given back holds.
fn lents_released(take lents: mem::List[Lent], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    for lent in take lents {
        let Lent(space: space, frames: _, ported: _, ends: _) = lent
        take space.release(mut frames)
    }
} lents_released

/// Whether every job and instance the space runs was abandoned by its holder; otherwise has each
/// its holder abandoned abandoned.
fn Driven.halts(mut self, mut space: sys::load::Space, alloc: mem::Alloc) -> bool {
    var every = self.jobs.len() > 0
    var halted = mem::List[u64].empty(alloc)
    for entry in mut self.jobs {
        var running = mut entry.value_mut()
        if not running.halted.contents().load() {
            every = false
        } else if not running.abandoning {
            running.abandoning = true
            mut halted.push(entry.key())
        }
    }
    if every {
        return true
    }
    for id in halted {
        mut self.abandoned(mut space, id, alloc)
    }
    return false
} Driven.halts

/// Has the instance numbered `id` abandoned as breaching its link's first channel or a bridge.
fn Driven.breached(mut self, mut space: sys::load::Space, id: u64, alloc: mem::Alloc) {
    let Some(found) = mut self.jobs.get_mut(id) else {
        return
    }
    var running = found
    running.breached = true
    if running.abandoning {
        return
    }
    running.abandoning = true
    mut self.abandoned(mut space, id, alloc)
} Driven.breached

/// Has the job or instance numbered `id` abandoned: ends it at once when its runtime has not
/// started it, and orders its runtime to abandon it otherwise.
fn Driven.abandoned(mut self, mut space: sys::load::Space, id: u64, alloc: mem::Alloc) {
    var unstarted = false
    mut self.pending.retain(keep: fn[mut unstarted](start: Pending) -> bool {
        if start.id == id {
            unstarted = true
            return false
        }
        return true
    })
    if not unstarted {
        mut self.abandons.push(id)
        return
    }
    mut self.job_ended(mut space, id, otherwise: Outcome.Ended(Ended.Abandoned), alloc)
} Driven.abandoned

/// `WOKE_ORDERS` when the kernel has orders for the space's runtime, 0 otherwise.
fn Driven.orders(self) -> u64 {
    if self.abandons.len() > 0 or self.startable().is_some() or self.noticeable().is_some() {
        return WOKE_ORDERS
    }
    return 0
} Driven.orders

/// The position in `pending` of the first job or instance the space's runtime may start: one whose
/// bridges' ends are open.
fn Driven.startable(self) -> Option[usize] {
    for index in 0..<self.pending.len() {
        if not self.pending[index].bridging {
            return Some(index)
        }
    }
    return None
} Driven.startable

/// The position in `pending` of the first instance that starts once the ends of its bridges are open.
fn Driven.startable_once_bridged(self) -> Option[usize] {
    for index in 0..<self.pending.len() {
        if self.pending[index].bridging {
            return Some(index)
        }
    }
    return None
} Driven.startable_once_bridged

/// The position in `notices` of the first notice for an instance the space's runtime has started.
fn Driven.noticeable(self) -> Option[usize] {
    for index in 0..<self.notices.len() {
        let id = self.notices[index].id
        var started = true
        for start in self.pending {
            if start.id == id {
                started = false
            }
        }
        if started {
            return Some(index)
        }
    }
    return None
} Driven.noticeable

/// Ends every job and instance the space runs as `Driven.job_ended` does, each `Trapped` with a
/// trap of the kind `kind` numbers whose report is `report` unless its holder abandoned it or it
/// breached a channel.
fn Driven.ended_all(mut self, mut space: sys::load::Space, kind: u64, report: Str, alloc: mem::Alloc) {
    var ids = mem::List[u64].empty(alloc)
    for entry in self.jobs {
        mut ids.push(entry.key())
    }
    for id in ids {
        mut self.job_ended(mut space, id, otherwise: Outcome.Trapped(Trapping(kind: kind, report: text::String.of(report, alloc))), alloc)
    }
    self.pending = mem::List[Pending].empty(alloc)
    self.abandons = mem::List[u64].empty(alloc)
} Driven.ended_all

/// Ends the job or instance numbered `id`, unmapping its link's frames and those of its bridges'
/// ends, taking back the entries of the space's table added for it and closing those ends:
/// `Abandoned` once its holder abandoned it, `Trapped` with a trap of `trap.bounds` whose report is
/// `BREACH_REPORT` once it breached a channel, and as `otherwise` says otherwise.
fn Driven.job_ended(mut self, mut space: sys::load::Space, id: u64, take otherwise: Outcome, alloc: mem::Alloc) {
    let Some(running) = mut self.jobs.remove(id) else {
        return
    }
    for address in running.frames {
        mut space.unshare(address)
    }
    self.door.contents().table.taken_back(id)
    mut self.ends_dropped(id, alloc)
    mut self.notices.retain(keep: fn(notice: Notice) -> bool {
        return notice.id != id
    })
    var how = otherwise
    if running.halted.contents().load() {
        how = Outcome.Ended(Ended.Abandoned)
    } else if running.breached {
        how = Outcome.Trapped(Trapping(kind: BOUNDS, report: text::String.of(BREACH_REPORT, alloc)))
    }
    discard running.ended.offer(take how)
} Driven.job_ended

/// Runs the space's thread until its next exit and serves it, drawing from `frames` the pages it
/// draws: a fault on a page of the boot area it does not map draws that page, and another exception
/// resumes the thread in the fault routine its runtime named, which it names again once it runs, or
/// ends every job and instance as a trap of `trap.exception` while it names none.
fn Driven.served(mut self, cpu: hw::Ring0, tenant: u64, clock: sys::Clock, services: Services, isolation: Isolation, mut space: sys::load::Space, mut frames: mem::List[hw::PhysFrame[4_096]], mut extended: Option[hw::ExtendedState]) fails task::Cancelled uses wait {
    let alloc = isolation.alloc
    match space.run(cpu, state: mut self.state, mut extended) {
        hw::UserExit.Interrupted => {}
        hw::UserExit.Fault(fault) => {
            match attempt mut space.draw(fault.address, len: 1, mut frames) {
                Ok(1) => {}
                Err(sys::load::DrawError.Exhausted) => mut self.ended_all(mut space, kind: EXHAUSTED, report: "", alloc)
                else => {
                    if self.fault_routine == 0 {
                        mut self.ended_all(mut space, kind: EXCEPTION, report: "", alloc)
                        return
                    }
                    faulted(mut self.state, fault, routine: self.fault_routine)
                    self.fault_routine = 0
                }
            }
        }
        hw::UserExit.Syscall => {
            let number = user_word(self.state.regs[register(ROLE_NUMBER)])
            var answer = INVALID
            if number == CALL_END {
                mut self.ended_by(mut space, alloc)
                answer = 0
            } else if number == CALL_WAIT {
                let deadline = user_word(self.state.regs[register(0)])
                if self.orders() != 0 {
                    answer = WOKE_ORDERS
                } else if deadline == 0 and self.startable_once_bridged().is_none() {
                    mut self.ended_all(mut space, kind: ABANDONED, report: "", alloc)
                    return
                } else {
                    self.waiting = Some(try await slept_until(clock, deadline, rang: isolation.door.contents().woken))
                    return
                }
            } else if number == CALL_DRAW {
                answer = match attempt mut space.draw(user_word(self.state.regs[register(0)]), len: user_word(self.state.regs[register(1)]), mut frames) {
                    Ok(_) => 0
                    Err(_) => INVALID
                }
            } else if number == CALL_RELEASE {
                answer = match attempt mut space.give_back(user_word(self.state.regs[register(0)]), len: user_word(self.state.regs[register(1)]), mut frames) {
                    Ok(_) => 0
                    Err(_) => INVALID
                }
            } else if number == CALL_NOW {
                answer = match attempt clock.elapsed_ns() {
                    Ok(ns) => ns
                    Err(_) => INVALID
                }
            } else if number == CALL_INVOKE {
                answer = try await mut self.invoked(cpu, tenant, clock, services, isolation, mut space, mut frames)
            } else if number == CALL_FAULT {
                self.fault_routine = user_word(self.state.regs[register(0)])
                answer = 0
            }
            self.state.regs[register(ROLE_RESULT)] = Untrusted.of(answer)
        }
    }
} Driven.served

/// Ends the job or instance whose number a `CALL_END` call gives as `Driven.job_ended` does, as
/// the call says; a call naming none ends every job and instance as a trap of the kind it names,
/// with its report, or of `trap.abandoned`.
fn Driven.ended_by(mut self, mut space: sys::load::Space, alloc: mem::Alloc) {
    let id = user_word(self.state.regs[register(4)])
    if self.jobs.contains(id) {
        let how = ended_of(space, state: self.state, alloc)
        mut self.job_ended(mut space, id, otherwise: take how, alloc)
        return
    }
    if id != 0 {
        return
    }
    var kind = ABANDONED
    var report = text::String.empty(alloc)
    if user_word(self.state.regs[register(0)]) == ENDS_TRAPPED {
        kind = user_word(self.state.regs[register(1)])
        report = match attempt copied(space, state: self.state, at: 2, alloc) {
            Ok(bytes) => text_of(bytes.view(), alloc)
            Err(_) => text::String.empty(alloc)
        }
    }
    mut self.ended_all(mut space, kind, report: report.as_str(), alloc)
} Driven.ended_by

/// Serves an `CALL_INVOKE` call: the handle of an entry of the space's table, the operation, the
/// address and length of its arguments and the address and capacity of its result, at most
/// `MOST_BYTES` but for an order; an entry added for a job or instance that has ended is stale. A
/// test run's space draws from `frames` and stops once every job and instance of this space is
/// abandoned.
fn Driven.invoked(mut self, cpu: hw::Ring0, tenant: u64, clock: sys::Clock, services: Services, isolation: Isolation, mut space: sys::load::Space, mut frames: mem::List[hw::PhysFrame[4_096]]) -> u64 fails task::Cancelled uses wait {
    let alloc = isolation.alloc
    let state = self.state
    let handle = user_word(state.regs[register(0)])
    let operation = user_word(state.regs[register(1)])
    let target = user_word(state.regs[register(4)])
    let capacity = user_word(state.regs[register(5)])
    let Ok(args) = attempt copied(space, state, at: 2, alloc) else {
        return INVALID
    }
    if capacity > MOST_BYTES and handle != ORDERS_HANDLE {
        return INVALID
    }
    let Some(entry) = isolation.door.contents().table.entry(handle) else {
        return STALE
    }
    if entry.job != 0 and not self.jobs.contains(entry.job) {
        return STALE
    }
    match entry.holding {
        Holding.Log(log) => {
            if operation == LOG_LINE {
                return logged(log, args, alloc)
            }
        }
        Holding.Stdio(stdio) => return try await streamed(mut space, stdio, operation, args, target, capacity, alloc)
        Holding.Random(random) => {
            if operation == FILL {
                var bytes = mem::Bytes.zeroed(usize.widen(capacity), alloc)
                let Ok(_) = attempt random.fill(mut bytes.view_mut()) else {
                    return STALE
                }
                return written_back(mut space, address: target, bytes: bytes, count: capacity)
            }
        }
        Holding.Fs(fs) => return try await filed(mut space, fs, operation, args, target, capacity, files: mut self.files, alloc)
        Holding.Tests => {
            if operation == TEST_RUN {
                let jobs = self.jobs
                return try await test_served(cpu, clock, services, tenant, args, halted: fn() => every_halted(jobs), mut frames, alloc)
            }
        }
        Holding.Orders => {
            if operation == TAKE {
                return mut self.order_taken(mut space, target, capacity, alloc)
            }
        }
        Holding.Channel(index) => {
            if operation == NOTIFY {
                match self.jobs.get(entry.job) {
                    Some(running) => {
                        discard attempt await running.notices.send(Notified.Moved(index))
                    }
                    None => {}
                }
                return 0
            }
        }
        Holding.Runner => return try await mut self.runner_invoked(isolation, mut space, handle, job: entry.job, operation, args, target, capacity, mut frames)
        Holding.Kind(capability) => return kind_invoked(mut space, capability, operation, args, target, capacity, alloc)
        Holding.Bridge => return try await mut self.bridge_invoked(mut space, handle, operation, args, target, capacity, mut frames, alloc)
    }
    return INVALID
} Driven.invoked

/// Serves an operation of the runner capability the space holds by `handle` for the job or instance
/// numbered `job`: moves out the pages holding a message, tells the job's or instance's task a
/// message its space sends, or has its runner serve the operation.
fn Driven.runner_invoked(mut self, isolation: Isolation, mut space: sys::load::Space, handle: u64, job: u64, operation: u64, args: Untrusted[mem::Bytes], target: u64, capacity: u64, mut frames: mem::List[hw::PhysFrame[4_096]]) -> u64 fails task::Cancelled uses wait {
    let alloc = isolation.alloc
    if operation == RUN_MOVE {
        let Ok(span) = attempt mem::wire::Codec[Span].decode(args.view(), alloc) else {
            return INVALID
        }
        return try await moved_out(isolation.way, handle, span, mut space, mut frames, alloc)
    }
    let Some(found) = mut self.jobs.get_mut(job) else {
        return STALE
    }
    var running = found
    if operation == RUN_UP {
        discard attempt await running.notices.send(Notified.Sent(bytes_of(args.view(), alloc)))
        return 0
    }
    return runner_served(mut space, runner: running.runner, job, operation, args, target, capacity, table: isolation.door.contents().table, ids: mut running.ids, alloc)
} Driven.runner_invoked

/// Serves an operation of the capability of a crossing kind a space holds through
/// `sys::Handle.invoke`: writes its result at `target` when it fits `capacity`, giving its length,
/// and gives `INVALID`, losing it, otherwise.
fn kind_invoked(mut space: sys::load::Space, capability: sys::Handle, operation: u64, args: Untrusted[mem::Bytes], target: u64, capacity: u64, alloc: mem::Alloc) -> u64 {
    let result = match attempt capability.invoke(operation, args: bytes_of(args.view(), alloc).view(), alloc) {
        Ok(bytes) => bytes
        Err(sys::CrossError.Revoked(_)) => return STALE
        Err(sys::CrossError.Refused) or Err(sys::CrossError.Cancelled(_)) => return INVALID
    }
    let len = u64.widen(result.len())
    if len > capacity {
        return INVALID
    }
    return written_back(mut space, address: target, bytes: result, count: len)
} kind_invoked

/// Whether every job and instance of a map was abandoned by its holder.
fn every_halted(jobs: mem::Map[u64, Running]) -> bool {
    for entry in jobs {
        if not entry.value().halted.contents().load() {
            return false
        }
    }
    return true
} every_halted

/// Serves the taking of the kernel's next order: writes at `target` the record ordering the space's
/// runtime to abandon a job or instance, to start one with its link's records, their keys and its
/// input after it, or telling one what its kernel tells it, with what it is told after it,
/// and gives its length, which is past `capacity` when the order does not fit, then writing
/// nothing; `INVALID` when there is no order.
fn Driven.order_taken(mut self, mut space: sys::load::Space, target: u64, capacity: u64, alloc: mem::Alloc) -> u64 {
    if self.abandons.len() > 0 {
        let id = self.abandons[0]
        let Some(running) = self.jobs.get(id) else {
            discard mut self.abandons.remove(0)
            return INVALID
        }
        let record = Start(order: ORDER_ABANDON, id: id, job: running.job, input: 0, input_len: 0, bell: 0, ports: 0, port_count: 0, held: 0, runner: 0, granted: 0, granted_len: 0)
        if u64.widen(START_BYTES) > capacity {
            return u64.widen(START_BYTES)
        }
        discard mut self.abandons.remove(0)
        return written_back(mut space, address: target, bytes: record_bytes(record, count: START_BYTES, alloc), count: u64.widen(START_BYTES))
    }
    match self.startable() {
        Some(index) => {
            let bytes = self.pending[index].laid_out(at: target, alloc)
            let len = u64.widen(bytes.len())
            if len > capacity {
                return len
            }
            discard mut self.pending.remove(index)
            return written_back(mut space, address: target, bytes, count: len)
        }
        None => {}
    }
    let Some(index) = self.noticeable() else {
        return INVALID
    }
    let notice = self.notices[index]
    let Some(running) = self.jobs.get(notice.id) else {
        discard mut self.notices.remove(index)
        return INVALID
    }
    let body = encoded(notice.told, alloc)
    let record = Start(order: ORDER_NOTICE, id: notice.id, job: running.job, input: 0, input_len: 0, bell: 0, ports: 0, port_count: 0, held: 0, runner: 0, granted: target + u64.widen(START_BYTES), granted_len: u64.widen(body.len()))
    var bytes = record_bytes(record, count: START_BYTES, alloc)
    mut bytes.append(body.view())
    let len = u64.widen(bytes.len())
    if len > capacity {
        return len
    }
    discard mut self.notices.remove(index)
    return written_back(mut space, address: target, bytes, count: len)
} Driven.order_taken

/// The record starting a job or instance laid out at `at`, its link's records, their keys, its
/// input and what crossed for its world's capabilities following it.
fn Pending.laid_out(self, at: u64, alloc: mem::Alloc) -> mem::Bytes {
    let ports_at = at + u64.widen(START_BYTES)
    var keys = mem::Bytes.empty(alloc)
    var ports = mem::Bytes.empty(alloc)
    let keys_at = ports_at + u64.widen(PORT_BYTES * self.keys.len())
    for index in 0..<self.keys.len() {
        let key = self.keys[index].as_str().as_bytes()
        let port = PortRecord(handle: self.channels[index], inbound: self.frames[1 + 2 * index], outbound: self.frames[2 + 2 * index], key: keys_at + u64.widen(keys.len()), key_len: u64.widen(key.len()))
        mut ports.append(record_bytes(port, count: PORT_BYTES, alloc).view())
        mut keys.append(key)
    }
    let held: u64 = match self.held {
        true => 1
        false => 0
    }
    let input_at = keys_at + u64.widen(keys.len())
    let granted_at = input_at + u64.widen(self.input.len())
    let granted = encoded(self.granting, alloc)
    let record = Start(order: ORDER_START, id: self.id, job: self.job, input: input_at, input_len: u64.widen(self.input.len()), bell: self.frames[0], ports: ports_at, port_count: u64.widen(self.keys.len()), held: held, runner: self.runner, granted: granted_at, granted_len: u64.widen(granted.len()))
    var bytes = record_bytes(record, count: START_BYTES, alloc)
    mut bytes.append(ports.view())
    mut bytes.append(keys.view())
    mut bytes.append(self.input.view())
    mut bytes.append(granted.view())
    return bytes
} Pending.laid_out

/// A table holding the capabilities of `services`, the space's test runs and its kernel's orders
/// by their handles.
fn Table.of(services: Services, alloc: mem::Alloc) -> Table {
    var slots = mem::List[Slot].empty(alloc)
    for handle in 0u64..<MOST_HELD {
        mut slots.push(Slot(handle: handle, entry: None))
    }
    let table = Table(slots: hw::SpinLock.of(take slots))
    discard table.held_by(job: 0, holding: Holding.Log(services.log))
    discard table.held_by(job: 0, holding: Holding.Stdio(services.stdio))
    discard table.held_by(job: 0, holding: Holding.Random(services.random))
    discard table.held_by(job: 0, holding: Holding.Fs(services.fs))
    discard table.held_by(job: 0, holding: Holding.Tests)
    discard table.held_by(job: 0, holding: Holding.Orders)
    return table
} Table.of

/// The handle of a capability the table holds from now on for the job or instance numbered `job`,
/// `MOST_HELD`, which names none, while it is full.
fn Table.held_by(self, job: u64, holding: Holding) -> u64 {
    return self.add(job, holding).value_or(MOST_HELD)
} Table.held_by

/// The handle of a capability the table holds from now on for the job or instance numbered `job`,
/// none while it holds `MOST_HELD` entries.
fn Table.add(self, job: u64, holding: Holding) -> Option[u64] {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) => self.slots.with(t, body: fn(mut slots: mem::List[Slot]) -> Option[u64] {
        for index in 0..<slots.len() {
            let slot = slots[index]
            if slot.entry.is_none() and slot.handle < HANDLE_BOUND {
                slots[index] = Slot(handle: slot.handle, entry: Some(Entry(job: job, holding: holding)))
                return Some(slot.handle)
            }
        }
        return None
    }))
} Table.add

/// The entry `handle` names, none when it is stale.
fn Table.entry(self, handle: u64) -> Option[Entry] {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) => self.slots.with(t, body: fn(mut slots: mem::List[Slot]) -> Option[Entry] {
        let Some(slot) = slots.get(usize.widen(handle % MOST_HELD)) else {
            return None
        }
        if slot.handle != handle {
            return None
        }
        return slot.entry
    }))
} Table.entry

/// The handle of the entry holding for the job or instance numbered `job` the capability of a
/// crossing kind whose word is `word`, none when the table holds none.
fn Table.crossed(self, job: u64, word: u64) -> Option[u64] {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) => self.slots.with(t, body: fn(mut slots: mem::List[Slot]) -> Option[u64] {
        for slot in slots {
            let Some(Entry(job: holder, holding: Holding.Kind(capability))) = slot.entry else {
                continue
            }
            if holder == job and handle_word(capability) == word {
                return Some(slot.handle)
            }
        }
        return None
    }))
} Table.crossed

/// Takes back each entry added for the job or instance numbered `job`, every handle naming one
/// stale from now on.
fn Table.taken_back(self, job: u64) {
    hw::without_irqs(fn(t: hw::IrqsDisabled) {
        self.slots.with(t, body: fn(mut slots: mem::List[Slot]) {
            for index in 0..<slots.len() {
                let Some(slot) = slots.get(index) else {
                    return
                }
                match slot.entry {
                    Some(entry) => {
                        if entry.job == job {
                            slots[index] = slot.freed()
                        }
                    }
                    None => {}
                }
            }
        })
    })
} Table.taken_back

/// Takes back the entry `handle` names, which is stale from now on.
fn Table.taken(self, handle: u64) {
    hw::without_irqs(fn(t: hw::IrqsDisabled) {
        self.slots.with(t, body: fn(mut slots: mem::List[Slot]) {
            let index = usize.widen(handle % MOST_HELD)
            let Some(slot) = slots.get(index) else {
                return
            }
            if slot.handle == handle and slot.entry.is_some() {
                slots[index] = slot.freed()
            }
        })
    })
} Table.taken

/// The slot once its entry is taken back.
fn Slot.freed(self) -> Slot limits pure, notrap, terminates {
    return Slot(handle: self.handle.saturating_add(MOST_HELD), entry: None)
} Slot.freed

test taken_back_entries_leave_their_handles_stale for Table.taken_back {
    let world = testing::world()
    let table = Table.of(Services(log: world.log, stdio: world.stdio, random: world.random, fs: world.fs), alloc: world.alloc)
    var earlier = mem::List[u64].empty(world.alloc)
    for _ in 0u64..<MOST_HELD {
        match table.add(job: 1, holding: Holding.Runner) {
            Some(handle) => mut earlier.push(handle)
            None => {}
        }
    }
    table.taken_back(1)
    let again = table.held_by(job: 2, holding: Holding.Runner)
    var unnamed = true
    for handle in earlier {
        unnamed = unnamed and table.entry(handle).is_none() and handle != again
    }
    let named = match table.entry(again) {
        Some(entry) => entry.job == 2
        None => false
    }
    expect earlier.len() == 250 and unnamed and named
} taken_back_entries_leave_their_handles_stale

/// What a space receives of the capabilities `handles` hold, each added to the table for the job
/// or instance numbered `job`, none when no space holds one's type or the table is full.
fn Table.admitted(self, job: u64, handles: Slice[sys::Handle], alloc: mem::Alloc) -> Option[mem::List[Carried]] {
    var holdings = mem::List[Holding].empty(alloc)
    for handle in handles {
        let Some(holding) = holding_of(handle) else {
            return None
        }
        mut holdings.push(holding)
    }
    var crossing = mem::List[Carried].empty(alloc)
    for holding in holdings {
        let Some(handle) = self.add(job, holding) else {
            return None
        }
        match holding {
            Holding.Log(_) => mut crossing.push(Carried.Log(handle))
            Holding.Stdio(_) => mut crossing.push(Carried.Stdio(handle))
            Holding.Random(_) => mut crossing.push(Carried.Random(handle))
            Holding.Kind(capability) => mut crossing.push(Carried.Kind(Crossed(handle: handle, hash: handle_hash(capability))))
            else => return None
        }
    }
    return Some(take crossing)
} Table.admitted

/// Takes back the entry of each capability `crossing` holds.
fn Table.crossing_taken(self, crossing: Slice[Carried]) {
    for crossed in crossing {
        self.taken(crossed.handle())
    }
} Table.crossing_taken

/// The handle of the entry of a space's table holding a capability the kernel added to it.
fn Carried.handle(self) -> u64 limits pure, notrap, terminates {
    return match self {
        Carried.Log(handle) or Carried.Stdio(handle) or Carried.Random(handle) => handle
        Carried.Kind(crossed) => crossed.handle
    }
} Carried.handle

/// The entry of a space's table holding the capability `handle` holds, none for a type no space
/// holds: a log, standard streams, a random source or a crossing kind's.
fn holding_of(handle: sys::Handle) -> Option[Holding] {
    match sys::CapabilityId[sys::Log](id: 0).of_handle(handle) {
        Some(log) => return Some(Holding.Log(log))
        None => {}
    }
    match sys::CapabilityId[sys::Stdio](id: 0).of_handle(handle) {
        Some(stdio) => return Some(Holding.Stdio(stdio))
        None => {}
    }
    match sys::CapabilityId[sys::Random](id: 0).of_handle(handle) {
        Some(random) => return Some(Holding.Random(random))
        None => {}
    }
    if handle.crosses() {
        return Some(Holding.Kind(handle))
    }
    return None
} holding_of

/// The handles of the capabilities of the entries of the table that `handles`, which a space sends,
/// name; none when one names no entry or a channel's.
fn Table.handed(self, handles: mem::List[u64], alloc: mem::Alloc) -> Option[mem::List[sys::Handle]] {
    var given = mem::List[sys::Handle].empty(alloc)
    for handle in handles {
        let Some(entry) = self.entry(handle) else {
            return None
        }
        match entry.holding {
            Holding.Log(log) => mut given.push(sys::Handle.of(log))
            Holding.Stdio(stdio) => mut given.push(sys::Handle.of(stdio))
            Holding.Random(random) => mut given.push(sys::Handle.of(random))
            Holding.Kind(capability) => mut given.push(capability)
            else => return None
        }
    }
    return Some(take given)
} Table.handed

/// The `count` bytes of a record.
fn record_bytes[T: Copy](record: T, count: usize, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.zeroed(count, alloc)
    trusted "the record is `count` bytes, all initialised" {
        hw::Ptr[u8].cast(hw::Ptr.of(record)).copy(hw::Ptr.of_view_mut(mut bytes.view_mut()), count: count)
    }
    return bytes
} record_bytes

/// Resumes a thread that faulted with `fault` in the routine at `routine`, as if the faulting
/// instruction called it with the fault's vector, code and address and that instruction's
/// address, on its stack at least 16 bytes below where it faulted, aligned to 16 bytes.
fn faulted(mut state: hw::UserState, fault: hw::UserFault, routine: u64) {
    state.regs[register(0)] = Untrusted.of(u64.widen(fault.vector))
    state.regs[register(1)] = Untrusted.of(fault.code)
    state.regs[register(2)] = Untrusted.of(fault.address)
    state.regs[register(ROLE_FOURTH)] = state.ip
    state.sp = Untrusted.of((user_word(state.sp) & 0xFFFF_FFFF_FFFF_FFF0).wrapping_sub(16))
    state.ip = Untrusted.of(routine)
} faulted

/// Waits until a deadline of the clock, or for good for the deadline 0, or until `rang` is posted,
/// giving `WOKE_RUNG` when it was and 0 otherwise.
fn slept_until(clock: sys::Clock, deadline: u64, rang: hw::Signal[u64]) -> u64 fails task::Cancelled uses wait {
    if deadline == 0 {
        discard try await rang.wait()
        return WOKE_RUNG
    }
    let elapsed = match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => deadline
    }
    if deadline <= elapsed {
        return 0
    }
    let woken = try await task::within_ns(clock, ns: deadline - elapsed, body: fn() -> u64 fails task::Cancelled uses wait {
        return try await rang.wait()
    })
    return match woken {
        Some(_) => WOKE_RUNG
        None => 0
    }
} slept_until

/// How the job or instance of a `CALL_END` call ended, a trap's report being the space's text.
fn ended_of(space: sys::load::Space, state: hw::UserState, alloc: mem::Alloc) -> Outcome {
    let how = user_word(state.regs[register(0)])
    let detail = user_word(state.regs[register(1)])
    if how == ENDS_TRAPPED {
        let report = match attempt copied(space, state, at: 2, alloc) {
            Ok(bytes) => text_of(bytes.view(), alloc)
            Err(_) => text::String.empty(alloc)
        }
        return Outcome.Trapped(Trapping(kind: detail, report: take report))
    }
    if how == ENDS_UNDECODABLE {
        return Outcome.Ended(Ended.Undecodable)
    }
    if how == ENDS_CANCELLED {
        return Outcome.Ended(Ended.Cancelled)
    }
    let Ok(bytes) = attempt spanned(space, state, at: 2, alloc) else {
        return Outcome.Trapped(Trapping(kind: EXCEPTION, report: text::String.empty(alloc)))
    }
    match how {
        ENDS_RETURNED => return Outcome.Ended(Ended.Returned(bytes_of(bytes.view(), alloc)))
        ENDS_FAILED => return Outcome.Ended(Ended.Failed(text_of(bytes.view(), alloc)))
        else => return Outcome.Trapped(Trapping(kind: ABANDONED, report: text::String.empty(alloc)))
    }
} ended_of

/// The bytes the address and length of a call's arguments from `at` name in the space, at most
/// `MOST_BYTES`.
fn copied(space: sys::load::Space, state: hw::UserState, at: usize, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails hw::UserAddrError {
    if user_word(state.regs[register(u64.widen(at) + 1)]) > MOST_BYTES {
        fail hw::UserAddrError.OutsideUser
    }
    return try spanned(space, state, at, alloc)
} copied

/// The bytes the address and length of a call's arguments from `at` name in the space.
fn spanned(space: sys::load::Space, state: hw::UserState, at: usize, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails hw::UserAddrError {
    let len = user_word(state.regs[register(u64.widen(at) + 1)])
    if len == 0 {
        return Untrusted.of(mem::Bytes.empty(alloc))
    }
    return try space.read(user_word(state.regs[register(u64.widen(at))]), len, alloc)
} spanned

/// Serves an operation of the runner capability of the instance numbered `job` through `runner`,
/// the handles crossing through `table`; `ids` keeps what crossed into the table for each
/// capability `runner` holds by number until it is dropped.
fn runner_served(mut space: sys::load::Space, runner: sys::Runner, job: u64, operation: u64, args: Untrusted[mem::Bytes], target: u64, capacity: u64, table: Table, mut ids: mem::Map[u64, Carried], alloc: mem::Alloc) -> u64 {
    if operation == RUN_SEND_TO {
        let Ok(Sending(port: port, hash: hash, call: Naming(bytes: bytes, handles: handles))) = attempt mem::wire::Codec[Sending].decode(args.view(), alloc) else {
            return INVALID
        }
        let Some(handed) = table.handed(handles, alloc) else {
            return INVALID
        }
        return outcome_of(attempt runner.send_to(port, hash, bytes: bytes.view(), handles: handed.view()))
    }
    if operation == RUN_REPLY {
        let Ok(Replying(request: request, reply: Naming(bytes: bytes, handles: handles))) = attempt mem::wire::Codec[Replying].decode(args.view(), alloc) else {
            return INVALID
        }
        let Some(handed) = table.handed(handles, alloc) else {
            return INVALID
        }
        return outcome_of(attempt runner.reply(request, bytes: bytes.view(), handles: handed.view()))
    }
    if operation == RUN_PUBLISH {
        let Ok(summary) = attempt mem::wire::Codec[mem::Bytes].decode(args.view(), alloc) else {
            return INVALID
        }
        return outcome_of(attempt runner.publish(summary.view()))
    }
    if operation == RUN_SYNC {
        return outcome_of(attempt runner.sync())
    }
    let Ok(id) = attempt mem::wire::Codec[u64].decode(args.view(), alloc) else {
        return INVALID
    }
    if operation == RUN_DROP {
        discard mut ids.remove(id)
        return outcome_of(attempt runner.drop_capability(id))
    }
    if operation != RUN_CAPABILITY {
        return INVALID
    }
    let handle = match attempt runner.capability(id) {
        Ok(given) => given
        Err(failure) => return outcome_of(Err(take failure))
    }
    let Some(crossed) = kept_for(id, handle, job, table, mut ids, alloc) else {
        return INVALID
    }
    let bytes = encoded(crossed, alloc)
    if u64.widen(bytes.len()) > capacity {
        return INVALID
    }
    return written_back(mut space, address: target, bytes, count: u64.widen(bytes.len()))
} runner_served

/// What crossed into the table for the capability the runner of the instance numbered `job` holds
/// by the number `id`: what `ids` keeps for `id`, or, added to `ids`, the capability `handle` holds
/// crossing; none when it cannot cross.
fn kept_for(id: u64, handle: sys::Handle, job: u64, table: Table, mut ids: mem::Map[u64, Carried], alloc: mem::Alloc) -> Option[Carried] {
    match ids.get(id) {
        Some(kept) => return Some(kept)
        None => {}
    }
    let held = Array[sys::Handle, 1].filled(handle)
    let Some(crossing) = table.admitted(job, handles: held.view(), alloc) else {
        return None
    }
    discard mut ids.insert(id, value: crossing[0])
    return Some(crossing[0])
} kept_for

/// The result of a call of the runner capability: 0, or `STALE` for a stale runner and `INVALID`
/// for another failure.
fn outcome_of(outcome: Result[Unit, sys::RunnerError]) -> u64 {
    match outcome {
        Ok(_) => return 0
        Err(sys::RunnerError.Revoked(_)) => return STALE
        Err(sys::RunnerError.Unknown) or Err(sys::RunnerError.Cancelled(_)) => return INVALID
    }
} outcome_of

/// Serves a test run: runs the test image at the path its arguments name in the file system of
/// `services` alone in a space of its own for `tenant`, on the texts they give, writing what it
/// writes to its standard output into a file made at the output path they name, and gives the
/// status it ends with.
fn test_served(cpu: hw::Ring0, clock: sys::Clock, services: Services, tenant: u64, args: Untrusted[mem::Bytes], halted: fn() -> bool, mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let Ok(asked) = attempt mem::wire::Codec[TestRun].decode(args.view(), alloc) else {
        return INVALID
    }
    let read = attempt await services.fs.read_all(asked.image.as_str(), alloc)
    let Ok(image) = read else {
        return failed_with(read)
    }
    let Ok(alone) = attempt sys::load::Isolated.of_test(bytes_of(image.view(), alloc).view(), alloc) else {
        return INVALID
    }
    let made = attempt await services.fs.create(asked.output.as_str())
    let Ok(output) = made else {
        return failed_with(made)
    }
    var texts = mem::Bytes.empty(alloc)
    for text in asked.texts {
        mut texts.append(text.as_bytes())
        mut texts.push(0)
    }
    let Some(frame) = mut frames.pop() else {
        return INVALID
    }
    var extended = Some(hw::ExtendedState.of(take frame))
    var file = output
    let ran = attempt await test_space(cpu, image: alone, tenant, texts: texts.view(), output: mut file, clock: clock, halted, mut extended, mut frames, alloc)
    match extended {
        Some(owned) => mut frames.push(take owned.into_frame())
        None => {}
    }
    match ran {
        Ok(status) => return status
        Err(cancelled) => fail cancelled
    }
} test_served

/// Runs a space of a test image for `tenant` on `texts` until it ends, writing what it writes to
/// its standard output into `output`, and gives the status it ends with: the one it gives,
/// `TIMED_OUT` once it has run for `TEST_NS` or `halted` gives true, and `CRASHED` when its thread
/// faults on a page it cannot draw or on another exception.
fn test_space(cpu: hw::Ring0, image: sys::load::Isolated, tenant: u64, texts: Slice[u8], mut output: sys::fs::File, clock: sys::Clock, halted: fn() -> bool, mut extended: Option[hw::ExtendedState], mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let Ok(made) = attempt image.space(cpu, data: u64.widen(TEST_START_BYTES + texts.len() + 1), tenant, mut frames, alloc) else {
        return INVALID
    }
    var space = made
    let start = space.data()
    var record = mem::Bytes.zeroed(TEST_START_BYTES, alloc)
    mut record.view_mut().write_u64_le(0, value: start + u64.widen(TEST_START_BYTES))
    mut record.view_mut().write_u64_le(8, value: u64.widen(texts.len()))
    discard attempt mut space.write(start, bytes: record.view())
    discard attempt mut space.write(start + u64.widen(TEST_START_BYTES), bytes: texts)
    var state = hw::UserState(regs: Array[Untrusted[u64], 31].filled(Untrusted.of(0)), sp: Untrusted.of(space.stack()), ip: Untrusted.of(space.start()), flags: Untrusted.of(0))
    state.regs[register(0)] = Untrusted.of(start)
    state.regs[register(1)] = Untrusted.of(space.boot_area())
    let began = elapsed_of(clock)
    var status = TIMED_OUT
    loop {
        if halted() or elapsed_of(clock).saturating_sub(began) > TEST_NS {
            break
        }
        match space.run(cpu, mut state, mut extended) {
            hw::UserExit.Interrupted => {}
            hw::UserExit.Fault(fault) => {
                let Ok(1) = attempt mut space.draw(fault.address, len: 1, mut frames) else {
                    status = CRASHED
                    break
                }
            }
            hw::UserExit.Syscall => {
                let number = user_word(state.regs[register(ROLE_NUMBER)])
                if number == CALL_END {
                    status = user_word(state.regs[register(0)]) % 256
                    break
                }
                var answer = INVALID
                if number == CALL_DRAW {
                    answer = match attempt mut space.draw(user_word(state.regs[register(0)]), len: user_word(state.regs[register(1)]), mut frames) {
                        Ok(_) => 0
                        Err(_) => INVALID
                    }
                } else if number == CALL_RELEASE {
                    answer = match attempt mut space.give_back(user_word(state.regs[register(0)]), len: user_word(state.regs[register(1)]), mut frames) {
                        Ok(_) => 0
                        Err(_) => INVALID
                    }
                } else if number == CALL_INVOKE {
                    match attempt await test_output(space, state, mut output, alloc) {
                        Ok(given) => {
                            answer = given
                        }
                        Err(cancelled) => {
                            take space.release(mut frames)
                            fail cancelled
                        }
                    }
                }
                state.regs[register(ROLE_RESULT)] = Untrusted.of(answer)
            }
        }
    }
    take space.release(mut frames)
    return status
} test_space

/// Serves a test image's `CALL_INVOKE` call: a write to its standard output goes into `output`, one
/// to its standard error nowhere, and any other call fails.
fn test_output(space: sys::load::Space, state: hw::UserState, mut output: sys::fs::File, alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let operation = user_word(state.regs[register(1)])
    if operation == WRITE_ERR {
        return 0
    }
    if operation != WRITE_OUT {
        return INVALID
    }
    let Ok(written) = attempt copied(space, state, at: 2, alloc) else {
        return INVALID
    }
    try await written_out(mut output, data: bytes_of(written.view(), alloc).view())
    return 0
} test_output

/// The nanoseconds of a clock, 0 once it is revoked.
fn elapsed_of(clock: sys::Clock) -> u64 {
    return match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} elapsed_of

/// Writes all of `data` to a file, as far as the file takes it.
fn written_out(mut output: sys::fs::File, data: Slice[u8]) fails task::Cancelled uses wait {
    var done: usize = 0
    while done < data.len() {
        let Some(parts) = data.split_at(done) else {
            return
        }
        let Ok(count) = attempt await mut output.write(parts.tail) else {
            return
        }
        if count == 0 {
            return
        }
        done += count
    }
} written_out

/// Serves an operation of the standard streams a space holds: its result's address and capacity
/// are `target` and `capacity`.
fn streamed(mut space: sys::load::Space, stdio: sys::Stdio, operation: u64, args: Untrusted[mem::Bytes], target: u64, capacity: u64, alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    if operation == READ_IN {
        var buffer = Untrusted.of(mem::Bytes.zeroed(usize.widen(capacity), alloc))
        let count = match attempt await stdio.read_in(mut buffer.view_mut()) {
            Ok(count) => count
            Err(error) => return stream_failure(error)
        }
        let Some(read) = buffer.view().prefix(count) else {
            return INVALID
        }
        return written_back(mut space, address: target, bytes: bytes_of(read, alloc), count: u64.widen(count))
    }
    if operation == WRITE_OUT or operation == WRITE_ERR {
        let data = bytes_of(args.view(), alloc)
        let sent = match operation == WRITE_OUT {
            true => attempt await stdio.write_out(data.view())
            false => attempt await stdio.write_err(data.view())
        }
        return match sent {
            Ok(_) => 0
            Err(error) => stream_failure(error)
        }
    }
    return INVALID
} streamed

/// The result naming a standard stream's failure.
fn stream_failure(error: sys::StdioError) -> u64 {
    return match error {
        sys::StdioError.Revoked(_) => STALE
        else => CLOSED_STREAM
    }
} stream_failure

/// The files a space opened, by number, and the number of the next one.
struct Files {
    open: mem::Map[u64, sys::fs::File]
    next: u64
} Files

/// Serves an operation of the file system a space holds, opening and releasing its files in
/// `files`: its result's address and capacity are `target` and `capacity`.
fn filed(mut space: sys::load::Space, fs: sys::Fs, operation: u64, args: Untrusted[mem::Bytes], target: u64, capacity: u64, mut files: Files, alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    if operation == FS_READ or operation == FS_WRITE or operation == FS_BYTE_LEN or operation == FS_RELEASE {
        return try await file_served(mut space, operation, args, target, capacity, mut files, alloc)
    }
    if operation == FS_RENAME {
        let Some(paths) = numbered(args, alloc) else {
            return INVALID
        }
        let Some(parts) = paths.rest.view().split_at(usize.widen(paths.number)) else {
            return INVALID
        }
        let Ok(from) = attempt text::String.try_from_utf8(parts.head, alloc) else {
            return BAD_PATH
        }
        let Ok(to) = attempt text::String.try_from_utf8(parts.tail, alloc) else {
            return BAD_PATH
        }
        return completed(attempt await fs.rename(from.as_str(), to: to.as_str()))
    }
    let Ok(path) = attempt text::String.try_from_utf8(bytes_of(args.view(), alloc).view(), alloc) else {
        return BAD_PATH
    }
    if operation == FS_OPEN or operation == FS_CREATE {
        let made = match operation == FS_OPEN {
            true => attempt await fs.open(path.as_str())
            false => attempt await fs.create(path.as_str())
        }
        let Ok(file) = made else {
            return failed_with(made)
        }
        let number = files.next
        files.next += 1
        discard mut files.open.insert(number, value: take file)
        return number
    }
    if operation == FS_REMOVE {
        return completed(attempt await fs.remove(path.as_str()))
    }
    if operation == FS_CREATE_DIR {
        return completed(attempt await fs.create_dir(path.as_str()))
    }
    if operation == FS_KIND {
        return match attempt await fs.kind(path.as_str()) {
            Ok(sys::fs::Kind.File) => 0
            Ok(sys::fs::Kind.Directory) => 1
            Ok(sys::fs::Kind.Other) => 2
            Err(error) => file_failure(error)
        }
    }
    if operation == FS_LIST {
        return try await listed_back(mut space, fs, path: path.as_str(), target, capacity, alloc)
    }
    return INVALID
} filed

/// Serves a read, write, length or release of a file a space opened, by its number in `files`.
fn file_served(mut space: sys::load::Space, operation: u64, args: Untrusted[mem::Bytes], target: u64, capacity: u64, mut files: Files, alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let Some(given) = numbered(args, alloc) else {
        return INVALID
    }
    let number = given.number
    if operation == FS_WRITE {
        let Some(found) = mut files.open.get_mut(number) else {
            return STALE
        }
        var file = found
        return match attempt await mut file.write(given.rest.view()) {
            Ok(count) => u64.widen(count)
            Err(error) => file_failure(error)
        }
    }
    if operation == FS_RELEASE {
        discard mut files.open.remove(number)
        return 0
    }
    let Some(found) = mut files.open.get_mut(number) else {
        return STALE
    }
    var file = found
    if operation == FS_BYTE_LEN {
        return match attempt await file.byte_len() {
            Ok(len) => len
            Err(error) => file_failure(error)
        }
    }
    var buffer = Untrusted.of(mem::Bytes.zeroed(usize.widen(capacity), alloc))
    return match attempt await mut file.read(mut buffer.view_mut()) {
        Ok(count) => match buffer.view().prefix(count) {
            Some(read) => written_back(mut space, address: target, bytes: bytes_of(read, alloc), count: u64.widen(count))
            None => INVALID
        }
        Err(error) => file_failure(error)
    }
} file_served

/// Serves a listing: the encoding of the entries of the directory at `path` written back when
/// it fits `capacity`, giving its length either way.
fn listed_back(mut space: sys::load::Space, fs: sys::Fs, path: Str, target: u64, capacity: u64, alloc: mem::Alloc) -> u64 fails task::Cancelled uses wait {
    let found = attempt await fs.list(path, alloc)
    let Ok(entries) = found else {
        return failed_with(found)
    }
    var listed = mem::List[Listed].empty(alloc)
    for entry in take entries {
        let kind: u8 = match entry.kind {
            sys::fs::Kind.File => 0
            sys::fs::Kind.Directory => 1
            sys::fs::Kind.Other => 2
        }
        mut listed.push(Listed(name: take entry.name, kind: kind))
    }
    let bytes = encoded(listed, alloc)
    let len = u64.widen(bytes.len())
    if len > capacity {
        return len
    }
    return written_back(mut space, address: target, bytes: bytes, count: len)
} listed_back

/// The result naming the failure of an outcome that failed, `INVALID` for one that did not.
fn failed_with[T](outcome: Result[T, sys::fs::FsError]) -> u64 {
    return match outcome {
        Ok(_) => INVALID
        Err(error) => file_failure(error)
    }
} failed_with

/// The result of a file operation's outcome: 0, or the failure it gives.
fn completed(outcome: Result[Unit, sys::fs::FsError]) -> u64 {
    return match outcome {
        Ok(_) => 0
        Err(error) => file_failure(error)
    }
} completed

/// The result naming a file operation's failure.
fn file_failure(error: sys::fs::FsError) -> u64 {
    return match error {
        sys::fs::FsError.NotFound => MISSING_FILE
        sys::fs::FsError.InvalidPath => BAD_PATH
        sys::fs::FsError.NoSpace => FULL_DEVICE
        sys::fs::FsError.Revoked(_) => STALE
        else => REFUSAL
    }
} file_failure

/// A space's arguments that start with a word: the word, least significant byte first, and the
/// bytes after it.
struct Numbered {
    number: u64
    rest: mem::Bytes
} Numbered

/// A space's arguments split after the word they start with; none for fewer than 8 bytes.
fn numbered(args: Untrusted[mem::Bytes], alloc: mem::Alloc) -> Option[Numbered] {
    let Some(parts) = args.view().split_at(8) else {
        return None
    }
    return Some(Numbered(number: leading_word(parts.head), rest: bytes_of(parts.tail, alloc)))
} numbered

/// The word of 8 bytes a space gives, least significant byte first.
validator fn leading_word(raw: Untrusted[Slice[u8]]) -> u64 {
    return raw.inspect().u64_le(0)
} leading_word

/// Logs a line whose arguments a call encodes, giving 0, or `INVALID` for arguments that do not
/// decode.
fn logged(log: sys::Log, args: Untrusted[mem::Bytes], alloc: mem::Alloc) -> u64 {
    let Ok(line) = attempt mem::wire::Codec[LogLine].decode(args.view(), alloc) else {
        return INVALID
    }
    match line.level {
        0 => log.info(line.message.as_str(), value: line.value.as_str())
        1 => log.warn(line.message.as_str(), value: line.value.as_str())
        else => log.error(line.message.as_str(), value: line.value.as_str())
    }
    return 0
} logged

/// Writes a call's result bytes at its address, giving `count`, or `INVALID` where the space
/// cannot take them.
fn written_back(mut space: sys::load::Space, address: u64, bytes: mem::Bytes, count: u64) -> u64 {
    return match attempt mut space.write(address, bytes: bytes.view()) {
        Ok(_) => count
        Err(_) => INVALID
    }
} written_back

validator fn user_word(raw: Untrusted[u64]) -> u64 {
    return raw.inspect()
} user_word

/// A space's bytes, which the kernel gives on as they are, as it gives a shared job's.
validator fn bytes_of(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(raw.inspect())
    return bytes
} bytes_of

/// A space's text, empty when it is not UTF-8.
validator fn text_of(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> text::String {
    return match attempt text::String.try_from_utf8(raw.inspect(), alloc) {
        Ok(text) => text
        Err(_) => text::String.empty(alloc)
    }
} text_of

/// The index in an `hw::UserState`'s registers of a system call's register of a role.
fn register(role: u64) -> usize limits pure, notrap, terminates

/// A trap of the kind its number names, `trap.abandoned` for a number naming none, drawn through
/// `alloc`, whose report is `report`, or locates the call when `report` is empty or longer than a
/// report.
fn trap_of(kind: u64, report: Str, alloc: mem::Alloc) -> sys::Trap

/// The first task of a space's runtime: takes each order of its kernel, waiting for its kernel to
/// have orders, starting each job or instance it orders on a task of its own, in a domain of its own
/// run, abandoning the domain of each it orders abandoned, and telling each what its kernel tells
/// it.
pkg fn isolated() fails task::Cancelled uses wait limits stack 16_384 {
    let granted = space_base()
    let alloc = granted.alloc
    let domains = task::Cown.of(mem::Map[u64, mem::Shared[sys::Abandoner]].empty(alloc), alloc)
    let mailboxes = task::Cown.of(mem::Map[u64, Mailbox].empty(alloc), alloc)
    try await task::scope(granted.exec, body: fn(s: task::Scope) fails task::Cancelled uses wait {
        loop {
            let Some(order) = taken_order(alloc) else {
                try await wait_orders()
                continue
            }
            let record = order.record
            if record.order == ORDER_ABANDON {
                let found = await when mut domains => mut domains.remove(record.id)
                match found {
                    Some(domain) => domain.contents().trigger()
                    None => {}
                }
                continue
            }
            if record.order == ORDER_NOTICE {
                try await told_of(order, mailboxes, alloc)
                continue
            }
            let domain = mem::Shared.of(sys::Abandoner.new(), alloc)
            let held = domain.share()
            await when mut domains {
                discard mut domains.insert(record.id, value: take held)
            }
            let task::Channel(sender: posting, receiver: posted) = task::Channel[Bridging].bounded(QUEUED_CALLS, alloc)
            let waits = task::Cown.of(PortWaits(next: 0, waiting: mem::Map[u64, task::Sender[PortAnswer]].empty(alloc)), alloc)
            let replied = waits.share()
            await when mut mailboxes {
                discard mut mailboxes.insert(record.id, value: Mailbox(bridging: take posting, waits: take replied))
            }
            let forgetting = domains.share()
            let unposting = mailboxes.share()
            discard s.spawn(fn[take order, take domain, take forgetting, take posted, take waits, take unposting]() fails task::Cancelled uses wait limits stack 16_384 {
                try await begun(order, domain, granted, notices: take posted, waits)
                await when mut forgetting {
                    discard mut forgetting.remove(record.id)
                }
                await when mut unposting {
                    discard mut unposting.remove(record.id)
                }
            })
        }
    })
} isolated

/// An order of a space's kernel: its record, and the bytes holding it with what follows it.
struct Taken {
    record: Start
    bytes: mem::Bytes
} Taken

/// The kernel's next order, drawn through `alloc`; none when it has none.
fn taken_order(alloc: mem::Alloc) -> Option[Taken] {
    var capacity: usize = 4_096
    loop {
        var bytes = mem::Bytes.zeroed(capacity, alloc)
        let len = invoke(ORDERS_HANDLE, operation: TAKE, args: b"", result: mut bytes.view_mut())
        if len >= FAILURES or len < u64.widen(START_BYTES) {
            return None
        }
        if len > u64.widen(capacity) {
            capacity = usize.widen(len)
            continue
        }
        let record = trusted "the kernel writes the order's record at the start of `bytes`" { hw::Ptr[Start].cast(hw::Ptr.of_view(bytes.view())).read() }
        return Some(Taken(record: record, bytes: take bytes))
    }
} taken_order

/// Runs the job or instance an order starts, in a domain run of `domain`, on a world whose log,
/// standard streams, random source and file system the kernel serves, with the capabilities that
/// crossed for it and its link's channels in its table, holding the instance of a component entry
/// for the kernel over its link's first channel, serving the ends of the bridges it starts with and
/// those `notices` tells of and answering its waiting calls through `waits`, and ends it with the
/// kernel as it ended.
fn begun(order: Taken, domain: mem::Shared[sys::Abandoner], granted: Base, take notices: task::Receiver[Bridging], waits: task::Cown[PortWaits]) fails task::Cancelled uses wait {
    let record = order.record
    let alloc = granted.alloc
    var input = mem::Bytes.empty(alloc)
    let from = usize.widen(record.input).wrapping_sub(hw::Ptr.of_view(order.bytes.view()).addr())
    match order.bytes.view().split_at(from) {
        Some(parts) => match parts.tail.prefix(usize.widen(record.input_len)) {
            Some(given) => mut input.append(given)
            None => {}
        }
        None => {}
    }
    var list = mem::List[PortRecord].empty(alloc)
    for index in 0u64..<record.port_count {
        mut list.push(port_at(record, index))
    }
    let task::Channel(sender: up, receiver: outgoing) = task::Channel[mem::Bytes].bounded(QUEUED_CALLS, alloc)
    let kinds = task::Cown.of(mem::Map[u64, Ride].empty(alloc), alloc)
    let remotes = sys::Minter[Remote, Spaced, u64].of(Spaced(alloc: alloc, minted: mem::OnceMap[u64, sys::Handle].empty(0, alloc), handles: mem::OnceMap[u64, u64].empty(0, alloc), up: up.split(), waits: waits.share(), kinds: kinds.share(), runner: record.runner), alloc)
    let base = remotes.mint(MOST_HELD)
    let task::Channel(sender: late, receiver: postponed) = task::Channel[Late].bounded(QUEUED_CALLS, alloc)
    let bridges = Bridges(ports: task::Cown.of(mem::Map[u64, Pump].empty(alloc), alloc), kinds: take kinds, routes: task::Cown.of(Routes(next: 0, waiting: mem::Map[u64, Route].empty(alloc)), alloc), late: take late, base: base, clock: granted.clock, alloc: alloc)
    let ports = sys::Minter[Port, Ports, u64].of(Ports(bell: record.bell, list: take list), alloc)
    var ends = mem::List[EndAt].empty(alloc)
    let world = attempt remote_world(granted, record, base, ports, channels_from: record.held, mut ends)
    let job = record.job
    let id = record.id
    match world {
        Ok(given) => {
            var initial = mem::List[Pumping].empty(alloc)
            for at in ends {
                match attempt await pumping_of(at, bridges) {
                    Ok(pumping) => mut initial.push(take pumping)
                    Err(_) => {}
                }
            }
            let told = Told(initial: take initial, notices: take notices, postponed: take postponed)
            let outcome = match record.held {
                0 => attempt await served_job(job, runner: record.runner, domain, world: take given, take input, take outgoing, bridges, take told)
                else => attempt await served_instance(job, port: ports.mint(0), base, runner: record.runner, domain, world: take given, take input, up, take outgoing, waits, bridges, take told)
            }
            take remotes.close()
            take ports.close()
            match outcome {
                Ok(Ok(how)) => end_with(how, job: id, alloc)
                Ok(Err(trap)) => end_trapped(trap, job: id, alloc)
                Err(_) => end(ENDS_TRAPPED, detail: ABANDONED, bytes: b"", job: id)
            }
        }
        Err(_) => {
            take remotes.close()
            take ports.close()
            end(ENDS_TRAPPED, detail: ABANDONED, bytes: b"", job: id)
        }
    }
} begun

/// Runs the job `job` in a domain run of `domain` on `world` and `input`, sending its kernel through
/// the runner capability of the space's table whose handle is `runner` each message `outgoing`
/// carries, which an instance's link's first channel would carry, and serving the ends of `bridges`
/// `told` opens and tells of; gives how the domain ended.
fn served_job(job: sys::load::Job, runner: u64, domain: mem::Shared[sys::Abandoner], take world: World, take input: mem::Bytes, take outgoing: task::Receiver[mem::Bytes], bridges: Bridges, take told: Told) -> Result[Ended, sys::Trap] fails task::Cancelled uses wait {
    let alloc = world.alloc
    let exec = world.exec
    var given = Some(Launched(world: take world, input: take input, outgoing: take outgoing))
    var telling = Some(take told)
    var outcome: Result[Ended, sys::Trap] = Ok(Ended.Cancelled)
    try await task::scope(exec, body: fn[mut given, mut telling, mut outcome](s: task::Scope) fails task::Cancelled uses wait {
        let Some(Launched(world: granted, input: fed, outgoing: sending)) = mut given.extract() else {
            return
        }
        let Some(Told(initial: open, notices: noticing, postponed: replying)) = mut telling.extract() else {
            return
        }
        let unserved = task::Channel[Called].bounded(1, alloc).sender
        discard s.spawn(fn[take open, take noticing, take replying, take unserved]() fails task::Cancelled uses wait {
            try await bridges_served(initial: take open, notices: take noticing, late: take replying, bridges, calls: unserved, exec)
        })
        discard s.spawn(fn[take sending]() fails task::Cancelled uses wait {
            var receiver = sending
            loop {
                let Some(frame) = try await mut receiver.receive() else {
                    return
                }
                let Some(parts) = frame.view().split_at(FRAME_HEAD) else {
                    continue
                }
                var nothing = mem::Bytes.empty(alloc)
                discard invoke(runner, operation: RUN_UP, args: parts.tail, result: mut nothing.view_mut())
            }
        })
        outcome = try await domain.contents().run_sized(fn[take granted, take fed]() -> Ended fails task::Cancelled uses wait limits stack 4_096 {
            return try await call(job, world: take granted, input: take fed)
        }, stack: job.stack() + CALL_STACK, exec, alloc)
        s.cancel()
    })
    return outcome
} served_job

/// What a job of a space owns: its world, its input and the receiver of the messages to send its
/// kernel.
struct Launched {
    world: World
    input: mem::Bytes
    outgoing: task::Receiver[mem::Bytes]
} Launched

/// The world of a job or instance of a space: its runtime's allocator, executor and clock, its log,
/// standard streams, random source and file system served by the kernel through the handles that
/// crossed for it, its random source stale from the start when the kernel's is stale, its network
/// denied, and its table holding each capability that crossed for it under its key, then each
/// channel of its link from the index `channels_from` as a standard stream under the channel's key.
fn remote_world(granted: Base, record: Start, base: Remote, ports: sys::Minter[Port, Ports, u64], channels_from: u64, mut ends: mem::List[EndAt]) -> World fails sys::Revoked {
    var given = mem::Bytes.zeroed(usize.widen(record.granted_len), alloc: granted.alloc)
    trusted "the kernel writes what crossed for the world, `granted_len` bytes, at `granted`" {
        hw::Ptr[u8].of_addr(usize.widen(record.granted)).copy(hw::Ptr.of_view_mut(mut given.view_mut()), count: usize.widen(record.granted_len))
    }
    let Ok(grants) = attempt mem::wire::Codec[Granting].decode(Untrusted.of(given.view()), alloc: granted.alloc) else {
        fail sys::Revoked.Stale
    }
    for at in grants.ends {
        mut ends.push(at)
    }
    let logs = try Cap[sys::Log].held(base, handle: grants.log, serve: served_log)
    let streams = try Cap[sys::Stdio].held(base, handle: grants.stdio, serve: served_stdio)
    let source = try random_held(base, handle: grants.random, alloc: granted.alloc)
    let files = try Cap[sys::Fs].held(base, handle: grants.fs, serve: served_fs)
    var caps = Caps.empty(granted.alloc)
    for grant in grants.caps {
        match minted_for(base, crossed: grant.carried) {
            Some(handle) => mut caps.held.push(Held(key: text::String.of(grant.key.as_str(), alloc: granted.alloc), handle: handle))
            None => {}
        }
    }
    for index in channels_from..<record.port_count {
        let port = port_at(record, index)
        var key = mem::Bytes.zeroed(usize.widen(port.key_len), alloc: granted.alloc)
        trusted "the kernel writes each channel's key of `key_len` bytes at `key`" {
            hw::Ptr[u8].of_addr(usize.widen(port.key)).copy(hw::Ptr.of_view_mut(mut key.view_mut()), count: usize.widen(port.key_len))
        }
        let channel = try sys::Stdio.served(ports.mint(index))
        let named = match attempt text::String.try_from_utf8(key.view(), alloc: granted.alloc) {
            Ok(text) => text
            Err(_) => text::String.empty(granted.alloc)
        }
        Cap[sys::Stdio].put(mut caps, key: named.as_str(), capability: channel)
    }
    return World(alloc: granted.alloc, exec: granted.exec, clock: granted.clock, random: source, log: logs, stdio: streams, fs: files, net: sys::Net.denied(), caps: take caps)
} remote_world

/// The random source the runtime holds for the handle `handle` of the space's table, stale from the
/// start when the kernel's random source is stale.
fn random_held(base: Remote, handle: u64, alloc: mem::Alloc) -> sys::Random fails sys::Revoked {
    let source = try Cap[sys::Random].held(base, handle, serve: served_random)
    var nothing = mem::Bytes.empty(alloc)
    if invoke(handle, operation: FILL, args: b"", result: mut nothing.view_mut()) != STALE {
        return source
    }
    let revoker = try sys::revocable(source)
    let denied = revoker.capability()
    take revoker.revoke()
    return denied
} random_held

/// The record of a channel of the space's link, by its index.
fn port_at(record: Start, index: u64) -> PortRecord {
    return trusted "the kernel writes the records of the link's channels at `ports`" { hw::Ptr[PortRecord].of_addr(usize.widen(record.ports + index * u64.widen(PORT_BYTES))).read() }
} port_at

/// Tells the kernel how the job or instance numbered `job` ended.
fn end_with(how: Ended, job: u64, alloc: mem::Alloc) {
    match how {
        Ended.Returned(bytes) => end(ENDS_RETURNED, detail: 0, bytes: bytes.view(), job)
        Ended.Failed(text) => end(ENDS_FAILED, detail: 0, bytes: text.as_str().as_bytes(), job)
        Ended.Cancelled => end(ENDS_CANCELLED, detail: 0, bytes: b"", job)
        Ended.Abandoned => end(ENDS_TRAPPED, detail: ABANDONED, bytes: b"", job)
        Ended.Trapped(trap) => end_trapped(trap, job, alloc)
        Ended.Undecodable => end(ENDS_UNDECODABLE, detail: 0, bytes: b"", job)
    }
} end_with

/// Tells the kernel that a trap ended the job or instance numbered `job`, giving its kind and its
/// report.
fn end_trapped(trap: sys::Trap, job: u64, alloc: mem::Alloc) {
    var report = mem::Bytes.zeroed(REPORT_BYTES, alloc)
    let len = render_into(trap, into: mut report.view_mut())
    mut report.truncate(len)
    end(ENDS_TRAPPED, detail: trap_number(trap), bytes: report.view(), job)
} end_trapped

/// What the capabilities a space's runtime holds by the kernel's handles share: the runtime's
/// allocator, the handle of the capability minted for each handle of the space's table, that handle
/// by the minted capability's word, the sender of the frames an instance's space sends up, the
/// waits of its calls that wait for the kernel's reply, the ends of bridges carrying the calls of
/// capabilities of crossing kinds by their handles, and the handle of its runner capability.
struct Spaced {
    alloc: mem::Alloc
    minted: mem::OnceMap[u64, sys::Handle]
    handles: mem::OnceMap[u64, u64]
    up: task::Sender[mem::Bytes]
    waits: task::Cown[PortWaits]
    kinds: task::Cown[mem::Map[u64, Ride]]
    runner: u64
} Spaced

/// The handle the runtime holds for the handle `handle` of the space's table, minted through `mint`
/// from a remote capability deriving from `base` the first time.
fn held_for(base: Remote, handle: u64, mint: fn(remote: Remote) -> sys::Handle fails sys::Revoked) -> sys::Handle fails sys::Revoked {
    match sys::reach(base, body: fn(state: Spaced, record: u64) => state.minted.get(handle)) {
        Some(Some(minted)) => return minted
        Some(None) => {}
        None => fail sys::Revoked.Stale
    }
    let minted = try mint(try sys::derive(base, narrow: fn(state: Spaced, record: u64) => handle))
    let kept = sys::reach(base, body: fn(state: Spaced, record: u64) -> sys::Handle {
        discard state.handles.insert(handle_word(minted), value: handle)
        return state.minted.insert(handle, value: minted)
    })
    let Some(stored) = kept else {
        fail sys::Revoked.Stale
    }
    return stored
} held_for

/// The capability the runtime holds for the handle `handle` of the space's table, served through
/// `serve` on a remote capability deriving from `base` the first time.
fn Cap.held(base: Remote, handle: u64, serve: fn(remote: Remote) -> C fails sys::Revoked) -> C fails sys::Revoked {
    let held = try held_for(base, handle, mint: fn(remote: Remote) -> sys::Handle fails sys::Revoked {
        return sys::Handle.of(try serve(remote))
    })
    let Some(capability) = sys::CapabilityId[C](id: 0).of_handle(held) else {
        fail sys::Revoked.Stale
    }
    return capability
} Cap.held

fn served_log(remote: Remote) -> sys::Log fails sys::Revoked {
    return try sys::Log.served(remote)
} served_log

fn served_stdio(remote: Remote) -> sys::Stdio fails sys::Revoked {
    return try sys::Stdio.served(remote)
} served_stdio

fn served_random(remote: Remote) -> sys::Random fails sys::Revoked {
    return try sys::Random.served(remote)
} served_random

fn served_fs(remote: Remote) -> sys::Fs fails sys::Revoked {
    return try sys::Fs.served(remote)
} served_fs

/// The handle of the capability the runtime holds for what the kernel carried into the space's
/// table, none once `base` is stale.
fn minted_for(base: Remote, crossed: Carried) -> Option[sys::Handle] {
    match crossed {
        Carried.Log(handle) => {
            let Ok(log) = attempt Cap[sys::Log].held(base, handle, serve: served_log) else {
                return None
            }
            return Some(sys::Handle.of(log))
        }
        Carried.Stdio(handle) => {
            let Ok(stdio) = attempt Cap[sys::Stdio].held(base, handle, serve: served_stdio) else {
                return None
            }
            return Some(sys::Handle.of(stdio))
        }
        Carried.Random(handle) => {
            let Ok(random) = attempt Cap[sys::Random].held(base, handle, serve: served_random) else {
                return None
            }
            return Some(sys::Handle.of(random))
        }
        Carried.Kind(Crossed(handle: handle, hash: hash)) => {
            let minting = attempt held_for(base, handle, mint: fn(remote: Remote) -> sys::Handle fails sys::Revoked {
                return try crossing_handle(remote, hash)
            })
            return match minting {
                Ok(minted) => Some(minted)
                Err(_) => None
            }
        }
    }
} minted_for

/// The handles of the space's table for which the runtime minted the capabilities `minted` holds,
/// none when it minted none of one.
fn handles_named(base: Remote, minted: Slice[sys::Handle], alloc: mem::Alloc) -> Option[mem::List[u64]] {
    var indices = mem::List[u64].empty(alloc)
    for handle in minted {
        let Some(index) = handle_named(base, minted: handle) else {
            return None
        }
        mut indices.push(index)
    }
    return Some(take indices)
} handles_named

/// The handle of the space's table for which the runtime minted the capability `minted` holds,
/// none when it minted none.
fn handle_named(base: Remote, minted: sys::Handle) -> Option[u64] {
    let word = handle_word(minted)
    return sys::reach(base, body: fn(state: Spaced, record: u64) => state.handles.get(word)).value_or(None)
} handle_named

/// The allocator and handle a remote capability's record names, none for a stale one.
fn reached(remote: Remote) -> Option[Reach] {
    return sys::reach(remote, body: fn(state: Spaced, handle: u64) => Reach(alloc: state.alloc, handle: handle))
} reached

/// What reaching a remote capability gives.
struct Reach derives Copy {
    alloc: mem::Alloc
    handle: u64
} Reach

fn Remote.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
    let Some(reach) = reached(self) else {
        return
    }
    let rank: u8 = match level {
        sys::LogLevel.Info => 0
        sys::LogLevel.Warn => 1
        sys::LogLevel.Error => 2
    }
    let line = LogLine(level: rank, message: text::String.of(message, alloc: reach.alloc), value: text::String.of(value, alloc: reach.alloc))
    var nothing = mem::Bytes.empty(reach.alloc)
    discard invoke(reach.handle, operation: LOG_LINE, args: encoded(line, alloc: reach.alloc).view(), result: mut nothing.view_mut())
} Remote.log

fn Remote.read_in(self, mut buf: SliceMut[u8]) -> usize fails sys::StdioError limits stack 4_096 {
    let Some(reach) = reached(self) else {
        fail sys::StdioError.Revoked(sys::Revoked.Stale)
    }
    return try streamed_in(reach.handle, mut buf)
} Remote.read_in

fn Remote.write_out(self, data: Slice[u8]) fails sys::StdioError limits stack 4_096 {
    try wrote(self, operation: WRITE_OUT, data)
} Remote.write_out

fn Remote.write_err(self, data: Slice[u8]) fails sys::StdioError limits stack 4_096 {
    try wrote(self, operation: WRITE_ERR, data)
} Remote.write_err

/// Writes bytes to a remote standard stream.
fn wrote(remote: Remote, operation: u64, data: Slice[u8]) fails sys::StdioError {
    let Some(reach) = reached(remote) else {
        fail sys::StdioError.Revoked(sys::Revoked.Stale)
    }
    try streamed_out(reach.handle, operation, data)
} wrote

/// Reads from the standard input of the standard streams at `handle`.
fn streamed_in(handle: u64, mut buf: SliceMut[u8]) -> usize fails sys::StdioError {
    let read = invoke(handle, operation: READ_IN, args: b"", result: mut buf)
    if read >= FAILURES {
        fail stream_error(read)
    }
    return usize.widen(read)
} streamed_in

/// Writes bytes to the standard output or error, as `operation` names, of the standard streams
/// at `handle`, at most a call's chunk at a time.
fn streamed_out(handle: u64, operation: u64, data: Slice[u8]) fails sys::StdioError {
    var done: usize = 0
    while done < data.len() {
        let Some(parts) = data.split_at(done) else {
            return
        }
        let Some(chunk) = parts.tail.prefix(parts.tail.len().min(FILE_CHUNK)) else {
            return
        }
        var nothing = Array[u8, 1].filled(0)
        let answer = invoke(handle, operation, args: chunk, result: mut nothing.view_mut())
        if answer >= FAILURES {
            fail stream_error(answer)
        }
        done += chunk.len()
    }
} streamed_out

/// The failure of a standard stream that a call's failure names: a stale stream's, or a closed
/// one's for every other.
fn stream_error(answer: u64) -> sys::StdioError {
    return match answer {
        STALE => sys::StdioError.Revoked(sys::Revoked.Stale)
        else => sys::StdioError.Closed
    }
} stream_error

fn Remote.invoke(self, operation: u64, args: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes fails sys::CrossError limits stack 4_096 {
    let Some(reach) = reached(self) else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    var result = mem::Bytes.zeroed(CROSSED_BYTES, alloc)
    let given = invoke(reach.handle, operation, args: bytes_of(args, alloc).view(), result: mut result.view_mut())
    if given == STALE {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    if given >= FAILURES or given > u64.widen(CROSSED_BYTES) {
        fail sys::CrossError.Refused
    }
    mut result.truncate(usize.widen(given))
    return result
} Remote.invoke

fn Remote.call(self, operation: u64, args: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes fails sys::CrossError uses wait limits stack 4_096 {
    let Some(uplink) = sys::reach(self, body: fn(state: Spaced, handle: u64) => Uplink(up: state.up.split(), waits: state.waits.share(), kinds: state.kinds.share(), runner: state.runner, handle: handle)) else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    let Uplink(up: up, waits: waits, kinds: kinds, runner: runner, handle: handle) = uplink
    let given = bytes_of(args, alloc)
    if u64.widen(given.len()) <= MOST_BYTES {
        var ride: Option[Ride] = None
        await when mut kinds {
            match kinds.get(handle) {
                Some(found) => {
                    if found.operation == operation {
                        ride = Some(found.share())
                    }
                }
                None => {}
            }
        }
        match ride {
            Some(across) => return try await rode_across(across, args: take given, alloc)
            None => {}
        }
    }
    let Waiting(id: id, answers: answers) = try await wait_added(waits, alloc)
    let frame = up_framed(Up.Awaited(Awaiting(id: id, handle: handle, operation: operation, args: take given)), runner, alloc)
    let answered = try await answer_awaited(up, waits, id, take frame, take answers)
    match answered {
        Some(PortAnswer.Replied(Carrying(bytes: bytes, handles: _))) => return bytes
        Some(PortAnswer.Revoked) => fail sys::CrossError.Revoked(sys::Revoked.Stale)
        else => fail sys::CrossError.Refused
    }
} Remote.call

/// What reaching a remote capability gives for an operation that waits for the kernel's reply: the
/// sender of the frames the space sends up, the waits for the kernel's replies, the ends of bridges
/// carrying the calls of capabilities of crossing kinds, the handle of the runner capability and the
/// capability's own.
struct Uplink {
    up: task::Sender[mem::Bytes]
    waits: task::Cown[PortWaits]
    kinds: task::Cown[mem::Map[u64, Ride]]
    runner: u64
    handle: u64
} Uplink

pub open struct SpaceCalls derives Copy {
} SpaceCalls

pub fn SpaceCalls.of_space() -> SpaceCalls {
    return SpaceCalls()
} SpaceCalls.of_space

pub fn SpaceCalls.open(self, path: Str) -> u64 fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    return try space_path_call(FS_HANDLE, operation: FS_OPEN, path, scratch: mut scratch.view_mut())
} SpaceCalls.open

pub fn SpaceCalls.create(self, path: Str) -> u64 fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    return try space_path_call(FS_HANDLE, operation: FS_CREATE, path, scratch: mut scratch.view_mut())
} SpaceCalls.create

pub fn SpaceCalls.read(self, file: u64, mut buf: SliceMut[u8]) -> usize fails sys::fs::FsError {
    var scratch = Array[u8, 8].filled(0)
    return try space_read(FS_HANDLE, file, mut buf, scratch: mut scratch.view_mut())
} SpaceCalls.read

pub fn SpaceCalls.write(self, file: u64, data: Slice[u8]) -> usize fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    return try space_write(FS_HANDLE, file, data, scratch: mut scratch.view_mut())
} SpaceCalls.write

pub fn SpaceCalls.byte_len(self, file: u64) -> u64 fails sys::fs::FsError {
    var scratch = Array[u8, 8].filled(0)
    return try space_numbered_call(FS_HANDLE, operation: FS_BYTE_LEN, file, scratch: mut scratch.view_mut())
} SpaceCalls.byte_len

pub fn SpaceCalls.release(self, file: u64) {
    var scratch = Array[u8, 8].filled(0)
    discard attempt space_numbered_call(FS_HANDLE, operation: FS_RELEASE, file, scratch: mut scratch.view_mut())
} SpaceCalls.release

pub fn SpaceCalls.now_ns(self) -> u64 {
    return now()
} SpaceCalls.now_ns

pub fn SpaceCalls.read_all(self, path: Str, alloc: mem::Alloc) -> mem::Bytes fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    return try space_read_all(FS_HANDLE, path, alloc, scratch: mut scratch.view_mut())
} SpaceCalls.read_all

pub fn SpaceCalls.write_all(self, path: Str, data: Slice[u8]) fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    try space_write_all(FS_HANDLE, path, data, scratch: mut scratch.view_mut())
} SpaceCalls.write_all

pub fn SpaceCalls.remove(self, path: Str) fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    discard try space_path_call(FS_HANDLE, operation: FS_REMOVE, path, scratch: mut scratch.view_mut())
} SpaceCalls.remove

pub fn SpaceCalls.create_dir(self, path: Str) fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    discard try space_path_call(FS_HANDLE, operation: FS_CREATE_DIR, path, scratch: mut scratch.view_mut())
} SpaceCalls.create_dir

pub fn SpaceCalls.rename(self, from: Str, to: Str) fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    try space_rename(FS_HANDLE, from, to, scratch: mut scratch.view_mut())
} SpaceCalls.rename

pub fn SpaceCalls.kind(self, path: Str) -> sys::fs::Kind fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    return kind_of(try space_path_call(FS_HANDLE, operation: FS_KIND, path, scratch: mut scratch.view_mut()))
} SpaceCalls.kind

pub fn SpaceCalls.list(self, path: Str, alloc: mem::Alloc) -> mem::List[sys::fs::Entry] fails sys::fs::FsError {
    var scratch = Array[u8, SCRATCH_BYTES].filled(0)
    return try space_list(FS_HANDLE, path, alloc, scratch: mut scratch.view_mut())
} SpaceCalls.list

pub fn SpaceCalls.run_test(self, image: Str, output: Str, texts: Slice[text::String], alloc: mem::Alloc) -> u8 fails sys::fs::FsError {
    var given = mem::List[text::String].empty(alloc)
    for text in texts {
        mut given.push(text::String.of(text.as_str(), alloc))
    }
    let args = encoded(TestRun(image: text::String.of(image, alloc), output: text::String.of(output, alloc), texts: take given), alloc)
    var nothing = Array[u8, 1].filled(0)
    return u8.truncate(try space_call(TESTS_HANDLE, operation: TEST_RUN, args: args.view(), result: mut nothing.view_mut()))
} SpaceCalls.run_test

pub fn SpaceCalls.read_in(self, mut buf: SliceMut[u8]) -> usize fails sys::StdioError {
    return try streamed_in(STDIO_HANDLE, mut buf)
} SpaceCalls.read_in

pub fn SpaceCalls.write_out(self, data: Slice[u8]) fails sys::StdioError {
    try streamed_out(STDIO_HANDLE, operation: WRITE_OUT, data)
} SpaceCalls.write_out

pub fn SpaceCalls.write_err(self, data: Slice[u8]) fails sys::StdioError {
    try streamed_out(STDIO_HANDLE, operation: WRITE_ERR, data)
} SpaceCalls.write_err

fn Remote.open(self, path: Str) -> u64 fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(path.byte_len(), alloc: reach.alloc)
    return try space_path_call(reach.handle, operation: FS_OPEN, path, scratch: mut scratch.view_mut())
} Remote.open

fn Remote.create(self, path: Str) -> u64 fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(path.byte_len(), alloc: reach.alloc)
    return try space_path_call(reach.handle, operation: FS_CREATE, path, scratch: mut scratch.view_mut())
} Remote.create

fn Remote.read_all(self, path: Str, alloc: mem::Alloc) -> mem::Bytes fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(path.byte_len().max(8), alloc: reach.alloc)
    return try space_read_all(reach.handle, path, alloc, scratch: mut scratch.view_mut())
} Remote.read_all

fn Remote.write_all(self, path: Str, data: Slice[u8]) fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(path.byte_len().max(data.len().min(FILE_CHUNK) + 8), alloc: reach.alloc)
    try space_write_all(reach.handle, path, data, scratch: mut scratch.view_mut())
} Remote.write_all

fn Remote.remove(self, path: Str) fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(path.byte_len(), alloc: reach.alloc)
    discard try space_path_call(reach.handle, operation: FS_REMOVE, path, scratch: mut scratch.view_mut())
} Remote.remove

fn Remote.read(self, file: u64, mut buf: SliceMut[u8]) -> usize fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(8, alloc: reach.alloc)
    return try space_read(reach.handle, file, mut buf, scratch: mut scratch.view_mut())
} Remote.read

fn Remote.write(self, file: u64, data: Slice[u8]) -> usize fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(data.len().min(FILE_CHUNK) + 8, alloc: reach.alloc)
    return try space_write(reach.handle, file, data, scratch: mut scratch.view_mut())
} Remote.write

fn Remote.byte_len(self, file: u64) -> u64 fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(8, alloc: reach.alloc)
    return try space_numbered_call(reach.handle, operation: FS_BYTE_LEN, file, scratch: mut scratch.view_mut())
} Remote.byte_len

fn Remote.release(self, file: u64) limits stack 4_096 {
    let Some(reach) = reached(self) else {
        return
    }
    var scratch = mem::Bytes.zeroed(8, alloc: reach.alloc)
    discard attempt space_numbered_call(reach.handle, operation: FS_RELEASE, file, scratch: mut scratch.view_mut())
} Remote.release

fn Remote.create_dir(self, path: Str) fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(path.byte_len(), alloc: reach.alloc)
    discard try space_path_call(reach.handle, operation: FS_CREATE_DIR, path, scratch: mut scratch.view_mut())
} Remote.create_dir

fn Remote.rename(self, from: Str, to: Str) fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(8 + from.byte_len() + to.byte_len(), alloc: reach.alloc)
    try space_rename(reach.handle, from, to, scratch: mut scratch.view_mut())
} Remote.rename

fn Remote.kind(self, path: Str) -> sys::fs::Kind fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(path.byte_len(), alloc: reach.alloc)
    return kind_of(try space_path_call(reach.handle, operation: FS_KIND, path, scratch: mut scratch.view_mut()))
} Remote.kind

fn Remote.list(self, path: Str, alloc: mem::Alloc) -> mem::List[sys::fs::Entry] fails sys::fs::FsError limits stack 4_096 {
    let reach = try file_reach(self)
    var scratch = mem::Bytes.zeroed(path.byte_len(), alloc: reach.alloc)
    return try space_list(reach.handle, path, alloc, scratch: mut scratch.view_mut())
} Remote.list

/// What reaching a remote file system gives, failing as a revoked one when it is stale.
fn file_reach(remote: Remote) -> Reach fails sys::fs::FsError {
    let Some(reach) = reached(remote) else {
        fail sys::fs::FsError.Revoked(sys::Revoked.Stale)
    }
    return reach
} file_reach

/// The bytes a call carries at most: its arguments, or its result.
const FILE_CHUNK: usize = 524_288

/// The bytes of the buffer a space's own calls write their arguments into.
const SCRATCH_BYTES: usize = 65_536

/// Makes a file operation's call on the file system at `handle`, giving its result or failing
/// with the failure it names.
fn space_call(handle: u64, operation: u64, args: Slice[u8], mut result: SliceMut[u8]) -> u64 fails sys::fs::FsError {
    let answer = invoke(handle, operation, args, mut result)
    if answer < FAILURES {
        return answer
    }
    fail match answer {
        MISSING_FILE => sys::fs::FsError.NotFound
        BAD_PATH => sys::fs::FsError.InvalidPath
        FULL_DEVICE => sys::fs::FsError.NoSpace
        STALE => sys::fs::FsError.Revoked(sys::Revoked.Stale)
        else => sys::fs::FsError.Denied
    }
} space_call

/// Writes `bytes` into `scratch` after its first `skip` bytes, giving where they end; fails with
/// `InvalidPath` when they do not fit.
fn staged(bytes: Slice[u8], skip: usize, mut scratch: SliceMut[u8]) -> usize fails sys::fs::FsError {
    let stop = skip + bytes.len()
    let Some(held) = mut scratch.prefix_mut(stop) else {
        fail sys::fs::FsError.InvalidPath
    }
    var head = held
    let Some(parts) = mut head.split_at_mut(skip) else {
        fail sys::fs::FsError.InvalidPath
    }
    var tail = parts.tail
    mut tail.copy_from(bytes)
    return stop
} staged

/// Makes a file operation's call whose arguments are the first `stop` bytes of `scratch` and
/// whose result is a number.
fn staged_call(handle: u64, operation: u64, stop: usize, scratch: Slice[u8]) -> u64 fails sys::fs::FsError {
    let Some(args) = scratch.prefix(stop) else {
        fail sys::fs::FsError.InvalidPath
    }
    var nothing = Array[u8, 1].filled(0)
    return try space_call(handle, operation, args, result: mut nothing.view_mut())
} staged_call

/// Makes a file operation's call whose arguments are a path.
fn space_path_call(handle: u64, operation: u64, path: Str, mut scratch: SliceMut[u8]) -> u64 fails sys::fs::FsError {
    let stop = try staged(path.as_bytes(), skip: 0, mut scratch)
    return try staged_call(handle, operation, stop, scratch: scratch.view())
} space_path_call

/// Makes a file operation's call whose arguments are the number of an open file.
fn space_numbered_call(handle: u64, operation: u64, file: u64, mut scratch: SliceMut[u8]) -> u64 fails sys::fs::FsError {
    mut scratch.write_u64_le(0, value: file)
    return try staged_call(handle, operation, stop: 8, scratch: scratch.view())
} space_numbered_call

/// Reads into `buf` from an open file of the file system at `handle`, at most a call's chunk.
fn space_read(handle: u64, file: u64, mut buf: SliceMut[u8], mut scratch: SliceMut[u8]) -> usize fails sys::fs::FsError {
    mut scratch.write_u64_le(0, value: file)
    let Some(args) = scratch.view().prefix(8) else {
        fail sys::fs::FsError.Denied
    }
    let room = buf.len().min(FILE_CHUNK)
    let Some(parts) = mut buf.split_at_mut(room) else {
        fail sys::fs::FsError.Denied
    }
    var head = parts.head
    let count = try space_call(handle, operation: FS_READ, args, result: mut head)
    return usize.widen(count.min(u64.widen(room)))
} space_read

/// Writes a prefix of `data` to an open file of the file system at `handle`, as much as a call
/// and `scratch` carry, giving its length.
fn space_write(handle: u64, file: u64, data: Slice[u8], mut scratch: SliceMut[u8]) -> usize fails sys::fs::FsError {
    mut scratch.write_u64_le(0, value: file)
    let room = data.len().min(FILE_CHUNK).min(scratch.len() - 8)
    let Some(parts) = data.split_at(room) else {
        fail sys::fs::FsError.Denied
    }
    let stop = try staged(parts.head, skip: 8, mut scratch)
    let count = try staged_call(handle, operation: FS_WRITE, stop, scratch: scratch.view())
    return usize.widen(count.min(u64.widen(room)))
} space_write

/// The contents of a file of the file system at `handle`, drawn through `alloc`.
fn space_read_all(handle: u64, path: Str, alloc: mem::Alloc, mut scratch: SliceMut[u8]) -> mem::Bytes fails sys::fs::FsError {
    let file = try space_path_call(handle, operation: FS_OPEN, path, mut scratch)
    let read = attempt space_contents(handle, file, alloc, mut scratch)
    discard attempt space_numbered_call(handle, operation: FS_RELEASE, file, mut scratch)
    return match read {
        Ok(contents) => contents
        Err(error) => fail error
    }
} space_read_all

/// The rest of an open file of the file system at `handle`, drawn through `alloc`.
fn space_contents(handle: u64, file: u64, alloc: mem::Alloc, mut scratch: SliceMut[u8]) -> mem::Bytes fails sys::fs::FsError {
    let len = try space_numbered_call(handle, operation: FS_BYTE_LEN, file, mut scratch)
    var contents = mem::Bytes.empty(alloc)
    var chunk = mem::Bytes.zeroed(usize.widen(len).min(FILE_CHUNK).max(4_096), alloc)
    loop {
        let count = try space_read(handle, file, buf: mut chunk.view_mut(), mut scratch)
        if count == 0 {
            return contents
        }
        let Some(read) = chunk.view().prefix(count) else {
            return contents
        }
        mut contents.append(read)
    }
} space_contents

/// Replaces the contents of a file of the file system at `handle` with `data`.
fn space_write_all(handle: u64, path: Str, data: Slice[u8], mut scratch: SliceMut[u8]) fails sys::fs::FsError {
    let file = try space_path_call(handle, operation: FS_CREATE, path, mut scratch)
    var done: usize = 0
    while done < data.len() {
        let Some(parts) = data.split_at(done) else {
            break
        }
        let written = attempt space_write(handle, file, data: parts.tail, mut scratch)
        let Ok(count) = written else {
            discard attempt space_numbered_call(handle, operation: FS_RELEASE, file, mut scratch)
            match written {
                Ok(_) => return
                Err(error) => fail error
            }
        }
        if count == 0 {
            discard attempt space_numbered_call(handle, operation: FS_RELEASE, file, mut scratch)
            fail sys::fs::FsError.NoSpace
        }
        done += count
    }
    discard attempt space_numbered_call(handle, operation: FS_RELEASE, file, mut scratch)
} space_write_all

/// Moves an entry of the file system at `handle`: the length of `from`, then `from` and `to`.
fn space_rename(handle: u64, from: Str, to: Str, mut scratch: SliceMut[u8]) fails sys::fs::FsError {
    mut scratch.write_u64_le(0, value: u64.widen(from.byte_len()))
    let middle = try staged(from.as_bytes(), skip: 8, mut scratch)
    let stop = try staged(to.as_bytes(), skip: middle, mut scratch)
    discard try staged_call(handle, operation: FS_RENAME, stop, scratch: scratch.view())
} space_rename

/// The kind a number names.
fn kind_of(number: u64) -> sys::fs::Kind {
    return match number {
        0 => sys::fs::Kind.File
        1 => sys::fs::Kind.Directory
        else => sys::fs::Kind.Other
    }
} kind_of

/// The entries of a directory of the file system at `handle`, drawn through `alloc`.
fn space_list(handle: u64, path: Str, alloc: mem::Alloc, mut scratch: SliceMut[u8]) -> mem::List[sys::fs::Entry] fails sys::fs::FsError {
    let stop = try staged(path.as_bytes(), skip: 0, mut scratch)
    let Some(args) = scratch.view().prefix(stop) else {
        fail sys::fs::FsError.InvalidPath
    }
    var capacity: usize = 4_096
    loop {
        var buffer = mem::Bytes.zeroed(capacity, alloc)
        let needed = usize.widen(try space_call(handle, operation: FS_LIST, args, result: mut buffer.view_mut()))
        if needed > capacity {
            if needed > FILE_CHUNK * 2 {
                fail sys::fs::FsError.Denied
            }
            capacity = needed
            continue
        }
        let Some(written) = buffer.view().prefix(needed) else {
            fail sys::fs::FsError.Denied
        }
        let Ok(listed) = attempt mem::wire::Codec[mem::List[Listed]].decode(Untrusted.of(take written), alloc) else {
            fail sys::fs::FsError.Denied
        }
        var entries = mem::List[sys::fs::Entry].empty(alloc)
        for entry in take listed {
            mut entries.push(sys::fs::Entry(name: take entry.name, kind: kind_of(u64.widen(entry.kind))))
        }
        return entries
    }
} space_list

/// Fills `buf` from the random source at the remote's handle a call's chunk at a time, calling
/// once even for an empty `buf`, so that a fill fails whenever the kernel's source is stale.
fn Remote.fill(self, mut buf: SliceMut[u8]) fails sys::Revoked limits stack 4_096 {
    let Some(reach) = reached(self) else {
        fail sys::Revoked.Stale
    }
    var done: usize = 0
    loop {
        let Some(parts) = mut buf.split_at_mut(done) else {
            return
        }
        var tail = parts.tail
        let Some(chunk) = mut tail.prefix_mut(tail.len().min(FILE_CHUNK)) else {
            return
        }
        var head = chunk
        if invoke(reach.handle, operation: FILL, args: b"", result: mut head) >= FAILURES {
            fail sys::Revoked.Stale
        }
        done += head.len()
        if done == buf.len() {
            return
        }
    }
} Remote.fill

/// The allocator, executor and clock of the runtime, minted for its first task.
fn space_base() -> Base

/// A handle holding a capability of the crossing kind whose handle hash is `hash`, served by
/// `service` through `sys::Crossing`, its entry deriving from `service`'s.
fn crossing_handle[S: sys::Crossing and sys::Capability and Copy](service: S, hash: Array[u8, 33]) -> sys::Handle fails sys::Revoked

/// The word of the capability a handle holds, which names its entry.
fn handle_word(handle: sys::Handle) -> u64 limits pure, notrap, terminates

/// The handle hash of the type of the capability a handle holds.
fn handle_hash(handle: sys::Handle) -> Array[u8, 33] limits pure, notrap, terminates

/// Makes an `CALL_INVOKE` call, giving its result.
fn invoke(handle: u64, operation: u64, args: Slice[u8], mut result: SliceMut[u8]) -> u64

/// Makes a `CALL_NOW` call, giving the nanoseconds of the kernel's clock.
fn now() -> u64

/// Makes a `CALL_END` call, telling the kernel how the job or instance numbered `job` ended.
fn end(how: u64, detail: u64, bytes: Slice[u8], job: u64)

/// Waits until the kernel has orders for the runtime. No cancellation ends the wait once it has
/// started.
fn wait_orders() fails task::Cancelled uses wait

/// The number of a trap's kind.
fn trap_number(trap: sys::Trap) -> u64 limits pure, notrap, terminates
