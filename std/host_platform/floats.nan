//! The decimal text of floats, through the C library.

foreign fn strfromd(text: hw::Ptr[u8], size: usize, format: hw::Ptr[u8], value: f64) -> i32 convention "sysv"

foreign fn strtod(text: hw::Ptr[u8], end: hw::Ptr[hw::Ptr[u8]]) -> f64 convention "sysv"

foreign fn strtof(text: hw::Ptr[u8], end: hw::Ptr[hw::Ptr[u8]]) -> f32 convention "sysv"

/// A decimal: its digits, without leading or trailing zeros past the first, and the power of
/// ten of the first digit.
struct Decimal derives Copy {
    digits: Array[u8, 24]
    count: usize
    exponent: i32
} Decimal

/// Writes the text of an f64 and returns its length: `NaN`, `inf`, `-inf`, or the shortest
/// digits that read back as the value, positional for 0 and magnitudes from 1e-5 up to 1e16,
/// otherwise with an exponent.
pkg fn f64_text(value: f64, mut out: Array[u8, 40]) -> usize {
    let magnitude = value.abs()
    return float_text(value.is_nan(), negative: (value.to_bits() >> 63) == 1, magnitude, narrow: false, mut out)
} f64_text

/// Writes the text of an f32 as `f64_text` does, its digits the shortest that read back as an
/// f32.
pkg fn f32_text(value: f32, mut out: Array[u8, 40]) -> usize {
    let magnitude = f64.widen(value.abs())
    return float_text(value.is_nan(), negative: (value.to_bits() >> 31) == 1, magnitude, narrow: true, mut out)
} f32_text

fn float_text(
    nan: bool,
    negative: bool,
    magnitude: f64,
    narrow: bool,
    mut out: Array[u8, 40],
    ) -> usize {
    var len: usize = 0
    if nan {
        return append(mut out, at: len, bytes: b"NaN")
    }
    if negative {
        len = append(mut out, at: len, bytes: b"-")
    }
    if magnitude == f64.from_bits(0x7FF0_0000_0000_0000) {
        return append(mut out, at: len, bytes: b"inf")
    }
    if magnitude == 0.0 {
        return append(mut out, at: len, bytes: b"0.0")
    }
    let decimal = shortest(magnitude, narrow)
    if magnitude >= 0.00001 and magnitude < 10_000_000_000_000_000.0 {
        return positional(decimal, mut out, at: len)
    }
    return scientific(decimal, mut out, at: len)
} float_text

/// Appends bytes to a text from `at` and returns its new length.
fn append(mut out: Array[u8, 40], at: usize, bytes: Slice[u8]) -> usize {
    var len = at
    for byte in bytes {
        out[len] = byte
        len += 1
    }
    return len
} append

/// The digits of a decimal, `0` for the whole text past them.
fn digit(decimal: Decimal, index: usize) -> u8 {
    if index < decimal.count {
        return decimal.digits[index]
    }
    return b'0'
} digit

/// Writes a decimal positionally: at least one digit on each side of the point.
fn positional(decimal: Decimal, mut out: Array[u8, 40], at: usize) -> usize {
    var len = at
    if decimal.exponent < 0 {
        len = append(mut out, at: len, bytes: b"0.")
        var zeros = -decimal.exponent - 1
        while zeros > 0 {
            len = append(mut out, at: len, bytes: b"0")
            zeros -= 1
        }
        for index in 0..<decimal.count {
            out[len] = decimal.digits[index]
            len += 1
        }
        return len
    }
    let whole = usize.fit(decimal.exponent) + 1
    for index in 0..<whole {
        out[len] = digit(decimal, index)
        len += 1
    }
    len = append(mut out, at: len, bytes: b".")
    if decimal.count <= whole {
        return append(mut out, at: len, bytes: b"0")
    }
    for index in whole..<decimal.count {
        out[len] = decimal.digits[index]
        len += 1
    }
    return len
} positional

/// Writes a decimal as its first digit, `.`, the others or `0`, `e` and the exponent.
fn scientific(decimal: Decimal, mut out: Array[u8, 40], at: usize) -> usize {
    var len = at
    out[len] = decimal.digits[0]
    len += 1
    len = append(mut out, at: len, bytes: b".")
    if decimal.count == 1 {
        len = append(mut out, at: len, bytes: b"0")
    }
    for index in 1..<decimal.count {
        out[len] = decimal.digits[index]
        len += 1
    }
    len = append(mut out, at: len, bytes: b"e")
    if decimal.exponent < 0 {
        len = append(mut out, at: len, bytes: b"-")
    }
    return append_exponent(mut out, at: len, exponent: distance(decimal.exponent))
} scientific

/// The magnitude of an exponent.
fn distance(exponent: i32) -> u32 {
    if exponent < 0 {
        return u32.fit(-exponent)
    }
    return u32.fit(exponent)
} distance

/// Appends the decimal digits of an exponent and returns the text's new length.
fn append_exponent(mut out: Array[u8, 40], at: usize, exponent: u32) -> usize {
    var len = at
    if exponent >= 100 {
        out[len] = b'0' + u8.fit(exponent / 100)
        len += 1
    }
    if exponent >= 10 {
        out[len] = b'0' + u8.fit(exponent / 10 % 10)
        len += 1
    }
    out[len] = b'0' + u8.fit(exponent % 10)
    return len + 1
} append_exponent

/// The shortest decimal reading back as a positive finite magnitude, in f32 when `narrow`:
/// at each digit count, the nearest decimal of that many digits, or else the one on the
/// other side of the magnitude, the only other that may read back.
fn shortest(magnitude: f64, narrow: bool) -> Decimal {
    var count: usize = 1
    var most: usize = 17
    if narrow {
        most = 9
    }
    while count < most {
        let nearest = nearest_of(magnitude, count)
        let read = read_back(nearest, narrow)
        if read == magnitude {
            return nearest
        }
        let other = step(nearest, up: read < magnitude)
        if read_back(other, narrow) == magnitude {
            return other
        }
        count += 1
    }
    return nearest_of(magnitude, count: most)
} shortest

/// The decimal of `count` digits nearest a magnitude, ties to an even last digit.
fn nearest_of(magnitude: f64, count: usize) -> Decimal {
    var format = Array[u8, 8].filled(0)
    format[0] = b'%'
    format[1] = b'.'
    let precision = count - 1
    var at: usize = 2
    if precision >= 10 {
        format[at] = b'0' + u8.fit(precision / 10)
        at += 1
    }
    format[at] = b'0' + u8.fit(precision % 10)
    format[at + 1] = b'e'
    var written = Array[u8, 40].filled(0)
    discard strfromd(hw::Ptr.of_view_mut(mut written.view_mut()), size: 40, format: hw::Ptr.of_view(format.view()), value: magnitude)
    var decimal = Decimal(digits: Array[u8, 24].filled(b'0'), count: 0, exponent: 0)
    var index: usize = 0
    while written[index] != b'e' {
        if written[index] != b'.' {
            decimal.digits[decimal.count] = written[index]
            decimal.count += 1
        }
        index += 1
    }
    index += 1
    var negative = false
    if written[index] == b'-' {
        negative = true
    }
    index += 1
    var exponent: i32 = 0
    while written[index] != 0 {
        exponent = exponent * 10 + i32.widen(written[index] - b'0')
        index += 1
    }
    if negative {
        exponent = -exponent
    }
    decimal.exponent = exponent
    return trimmed(decimal)
} nearest_of

/// A decimal without the zeros ending its digits, keeping the first.
fn trimmed(decimal: Decimal) -> Decimal {
    var result = decimal
    while result.count > 1 and result.digits[result.count - 1] == b'0' {
        result.count -= 1
    }
    return result
} trimmed

/// The decimal one unit of its last digit above or below another.
fn step(decimal: Decimal, up: bool) -> Decimal {
    var result = decimal
    var index = result.count
    loop {
        if index == 0 {
            result.digits[0] = b'1'
            for later in 1..<result.count {
                result.digits[later] = b'0'
            }
            result.exponent += 1
            return trimmed(result)
        }
        index -= 1
        let current = result.digits[index]
        if up and current != b'9' {
            result.digits[index] = current + 1
            return trimmed(result)
        }
        if not up and current != b'0' {
            result.digits[index] = current - 1
            return renormalised(result)
        }
        if up {
            result.digits[index] = b'0'
        } else {
            result.digits[index] = b'9'
        }
    }
} step

/// A decimal stepped down past its first digit: without the zero that now leads it.
fn renormalised(decimal: Decimal) -> Decimal {
    if decimal.digits[0] != b'0' or decimal.count == 1 {
        return trimmed(decimal)
    }
    var result = decimal
    for index in 1..<decimal.count {
        result.digits[index - 1] = decimal.digits[index]
    }
    result.count -= 1
    result.exponent -= 1
    return trimmed(result)
} renormalised

/// The value a decimal reads back as, rounded to f32 first when `narrow`.
fn read_back(decimal: Decimal, narrow: bool) -> f64 {
    var written = Array[u8, 40].filled(0)
    var len: usize = 0
    for index in 0..<decimal.count {
        written[len] = decimal.digits[index]
        len += 1
    }
    written[len] = b'e'
    len += 1
    let exponent = decimal.exponent - i32.fit(decimal.count) + 1
    if exponent < 0 {
        written[len] = b'-'
        len += 1
    }
    discard append_exponent(mut written, at: len, exponent: distance(exponent))
    let start = hw::Ptr.of_view(written.view())
    if narrow {
        return f64.widen(strtof(start, end: hw::Ptr.of_addr(0)))
    }
    return strtod(start, end: hw::Ptr.of_addr(0))
} read_back
