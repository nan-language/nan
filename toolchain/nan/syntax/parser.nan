//! The LL(1) parse over the grammar's tables, under the resolutions the grammar publishes.

struct Frame derives Copy {
    seq: usize
    elem: usize
    count: usize
    rule: Option[Rule]
    /// The index of the first token the frame read.
    start: usize
} Frame

/// Why the parse stopped before consuming a token.
enum Failure {
    /// A token the grammar does not accept, with the terminals it accepts there.
    Token(at: usize, expected: TermSet)
    /// A rejected alternative, parsed from the token at `start`.
    Rejected(code: diagnostic::Code, start: usize)
    /// `match`, or an `NL` inside a `{` the item opens, in a single-line item.
    MultipleLines(at: usize)
} Failure

enum Fed derives Copy, Eq {
    /// The token belongs to the parse and was consumed.
    Consumed
    /// The start rule completed before the token.
    Done
} Fed

/// The next token, its index, and the token after it, which the context-word exceptions and the
/// resolution of `limits` commas read.
struct Lookahead derives Copy {
    token: Token
    next: Option[Token]
    at: usize
} Lookahead

/// The first token and the end token index of a prefix expression.
struct Operand derives Copy, Eq {
    start: usize
    end: usize
} Operand

/// A parse in progress: the frames of the expanded rules and what the item read so far opened.
struct State {
    /// The start rule until the first token chooses its alternative.
    start: Option[Rule]
    frames: mem::List[Frame]
    single_line: bool
    braces: usize
    pascal_path: bool
    /// The last prefix expression parsed.
    last_operand: Option[Operand]
} State

/// Receives the parse's tree events.
interface Sink {
    fn open(mut self, rule: Rule)
    fn token(mut self, at: usize)
    fn close(mut self)
} Sink

impl Builder: Sink

/// A sink for dry runs, which keep no tree.
struct Discard derives Copy {
} Discard

impl Discard: Sink

fn Discard.open(mut self, rule: Rule) {
} Discard.open

fn Discard.token(mut self, at: usize) {
} Discard.token

fn Discard.close(mut self) {
} Discard.close

/// Whether a lookahead can start what `reached` describes, through a rejected alternative or not.
fn Look.starts(self, reached: First) -> bool {
    return self.opens(reached.ok) or self.opens(reached.rejected)
} Look.starts

/// Whether a set holds a terminal a lookahead token can be.
fn Look.opens(self, set: TermSet) -> bool {
    match self.context {
        Some(word) => {
            if set.holds(word) {
                return true
            }
        }
        None => {}
    }
    return match self.term {
        Some(term) => set.holds(term)
        None => false
    }
} Look.opens

/// The terminals a lookahead token can be: the terminal its kind is, and the context word it
/// reads as.
struct Look derives Copy {
    term: Option[TermBit]
    context: Option[TermBit]
} Look

fn Look.of(lookahead: Lookahead, source: Slice[u8], grammar: Tables) -> Look {
    var next_kind: Option[TokenKind] = None
    match lookahead.next {
        Some(next) => {
            next_kind = Some(next.kind)
        }
        None => {}
    }
    var context = lookahead.token.context_word(source, grammar)
    match context {
        Some(ContextWord.Task) => {
            if next_kind != Some(TokenKind.Keyword(Keyword.Fn)) {
                context = None
            }
        }
        Some(ContextWord.All) or Some(ContextWord.Any) => {
            if next_kind != Some(TokenKind.Ident) {
                context = None
            }
        }
        Some(ContextWord.Manual) => {
            if next_kind != Some(TokenKind.Text) {
                context = None
            }
        }
        else => {}
    }
    var term: Option[TermBit] = None
    match lookahead.token.kind.term() {
        Some(held) => {
            term = Some(TermBit.of(held.index()))
        }
        None => {}
    }
    var word: Option[TermBit] = None
    match context {
        Some(read) => {
            word = Some(TermBit.of(Term.Context(read).index()))
        }
        None => {}
    }
    return Look(term: term, context: word)
} Look.of

/// Whether the lookahead can start `rule`, through a rejected alternative or not.
fn starts(rule: Rule, lookahead: Lookahead, source: Slice[u8], grammar: Tables) -> bool {
    return Look.of(lookahead, source, grammar).starts(grammar.analysis.choice(rule.choice(grammar)))
} starts

/// Whether an identifier has the PascalCase shape: an uppercase letter, then letters and digits
/// holding a lowercase letter unless it is one letter.
pkg fn is_pascal(name: Slice[u8]) -> bool {
    if name.len() == 0 or not (name[0] >= b'A' and name[0] <= b'Z') {
        return false
    }
    var lowercase = false
    for byte in name {
        let lower = byte >= b'a' and byte <= b'z'
        let upper = byte >= b'A' and byte <= b'Z'
        let digit = byte >= b'0' and byte <= b'9'
        if not (lower or upper or digit) {
            return false
        }
        lowercase = lowercase or lower
    }
    return name.len() == 1 or lowercase
} is_pascal

fn State.new(start: Rule, alloc: mem::Alloc) -> State {
    return State(start: Some(start), frames: mem::List[Frame].empty(alloc), single_line: false, braces: 0, pascal_path: false, last_operand: None)
} State.new

fn State.clone(self, alloc: mem::Alloc) -> State {
    var frames = mem::List[Frame].empty(alloc)
    for frame in self.frames {
        mut frames.push(frame)
    }
    return State(start: self.start, frames: take frames, single_line: self.single_line, braces: self.braces, pascal_path: self.pascal_path, last_operand: self.last_operand)
} State.clone

/// Notes a rule's node closed over the tokens `start..end`: a prefix expression is the last
/// operand.
fn State.closed(mut self, rule: Rule, start: usize, end: usize) {
    match rule {
        Rule.PrefixExpr => {
            self.last_operand = Some(Operand(start: start, end: end))
        }
        else => {}
    }
} State.closed

fn State.push_rule[S: Sink](mut self, rule: Rule, seq: usize, at: usize, mut sink: S, grammar: Tables) {
    mut sink.open(rule)
    let single_line_kind = match rule {
        Rule.ImplItem or Rule.ConstItem or Rule.ConstAssertItem or Rule.RegistryItem or Rule.ContributeItem or Rule.RetiredItem => true
        else => false
    }
    var single_line_fn = false
    match rule {
        Rule.FnEnd => {
            expect seq < grammar.seqs.len() and grammar.seqs[seq].elems.len() > 0
            single_line_fn = match grammar.seqs[seq].elems[0].atom {
                Atom.Term(Term.Punct(Punct.Eq)) or Atom.Rule(Rule.ConventionClause) => true
                else => false
            }
        }
        else => {}
    }
    self.single_line = self.single_line or single_line_kind or single_line_fn
    mut self.frames.push(Frame(seq: seq, elem: 0, count: 0, rule: Some(rule), start: at))
} State.push_rule

/// The alternative of a choice the lookahead selects, if any: the first that a context word
/// starts outside every rejection, else through one, else the first the terminal starts the same
/// way, else the first nullable one.
fn State.choose(choice: usize, look: Look, grammar: Tables) -> Option[usize] {
    let row = choice * CHOOSING_ROW
    let table = grammar.choosing.view()
    match look.context {
        Some(word) => {
            match chosen(table, at: row + word.index) {
                Some(alt) => return Some(alt)
                None => {}
            }
            match chosen(table, at: row + TERMS + word.index) {
                Some(alt) => return Some(alt)
                None => {}
            }
        }
        None => {}
    }
    match look.term {
        Some(term) => {
            match chosen(table, at: row + term.index) {
                Some(alt) => return Some(alt)
                None => {}
            }
            match chosen(table, at: row + TERMS + term.index) {
                Some(alt) => return Some(alt)
                None => {}
            }
        }
        None => {}
    }
    return chosen(table, at: row + 2 * TERMS)
} State.choose

/// The alternative the entry at an index of `Grammar.choosing` names, if any.
fn chosen(table: Slice[u8], at: usize) -> Option[usize] {
    if at >= table.len() / 2 {
        return None
    }
    let entry = table.u16_le(2 * at)
    if entry == 0 {
        return None
    }
    return Some(usize.widen(entry - 1))
} chosen

/// Advances the parse to the lookahead token: expands and completes rules until the token is
/// consumed, the start rule completes before it, or the parse fails at it.
fn State.feed[S: Sink](mut self, lookahead: Lookahead, source: Slice[u8], mut sink: S, grammar: Tables) -> Fed fails Failure
    waive length "one loop over the frames, as the Rust parse"
{
    let look = Look.of(lookahead, source, grammar)
    let at = lookahead.at
    var expected = TermSet.default()
    match mut self.start.extract() {
        Some(start) => {
            let choice = start.choice(grammar)
            let Some(alt) = State.choose(choice, look, grammar) else {
                fail Failure.Token(at: at, expected: grammar.analysis.choice(choice).ok)
            }
            mut self.push_rule(start, seq: alt, at, mut sink, grammar)
        }
        None => {}
    }
    loop {
        let depth = self.frames.len()
        if depth == 0 {
            return Fed.Done
        }
        let top = depth - 1
        let frame = self.frames[top]
        expect frame.seq < grammar.seqs.len()
        let elems = grammar.seqs[frame.seq].elems
        if frame.elem >= elems.len() {
            discard mut self.frames.pop()
            match grammar.seqs[frame.seq].rejection {
                Some(code) => fail Failure.Rejected(code: code, start: frame.start)
                None => {}
            }
            match frame.rule {
                Some(rule) => {
                    mut sink.close()
                    mut self.closed(rule, start: frame.start, end: at)
                }
                None => {}
            }
            if top > 0 {
                let count = self.frames[top - 1].count
                expect count < ~0usize
                self.frames[top - 1].count = count + 1
            }
            continue
        }
        let repeat = elems[frame.elem].repeat
        let may = match repeat {
            Repeat.One or Repeat.Opt => frame.count == 0
            Repeat.Star or Repeat.Plus => true
        }
        let must = match repeat {
            Repeat.One or Repeat.Plus => frame.count == 0
            Repeat.Opt or Repeat.Star => false
        }
        if not may {
            self.frames[top].elem = frame.elem + 1
            self.frames[top].count = 0
            continue
        }
        let atom = elems[frame.elem].atom
        let can_start = look.opens(elems[frame.elem].opens)
        if not must and not (can_start and self.resolves(frame, atom, lookahead, source, grammar)) {
            if not can_start {
                mut expected.union(elems[frame.elem].starts.ok)
            }
            self.frames[top].elem = frame.elem + 1
            self.frames[top].count = 0
            continue
        }
        match atom {
            Atom.Term(term) => {
                if not can_start {
                    mut expected.insert(term)
                    fail Failure.Token(at: at, expected: expected)
                }
                let count = self.frames[top].count
                expect count < ~0usize
                self.frames[top].count = count + 1
                try mut self.consume(lookahead, source, mut sink)
                return Fed.Consumed
            }
            Atom.Rule(rule) => {
                let Some(alt) = State.choose(elems[frame.elem].choice, look, grammar) else {
                    mut expected.union(elems[frame.elem].starts.ok)
                    fail Failure.Token(at: at, expected: expected)
                }
                mut self.push_rule(rule, seq: alt, at, mut sink, grammar)
            }
            Atom.Group(choice) => {
                let Some(alt) = State.choose(choice, look, grammar) else {
                    mut expected.union(elems[frame.elem].starts.ok)
                    fail Failure.Token(at: at, expected: expected)
                }
                mut self.frames.push(Frame(seq: alt, elem: 0, count: 0, rule: None, start: at))
            }
        }
    }
} State.feed

/// Whether the resolutions the grammar publishes let an element the lookahead can start begin
/// there: generic arguments after a PascalCase path segment, and a `limits` comma before a limit.
fn State.resolves(self, frame: Frame, atom: Atom, lookahead: Lookahead, source: Slice[u8], grammar: Tables) -> bool {
    match frame.rule {
        Some(Rule.PathExpr) => match atom {
            Atom.Rule(Rule.GenericArgs) => return self.pascal_path
            else => {}
        }
        Some(Rule.LimitsClause) => match atom {
            Atom.Group(_) => {
                let Some(next) = lookahead.next else {
                    return false
                }
                let after = Lookahead(token: next, next: None, at: lookahead.at)
                return Look.of(after, source, grammar).starts(grammar.analysis.choice(Rule.Limit.choice(grammar)))
            }
            else => {}
        }
        else => {}
    }
    return true
} State.resolves

fn State.consume[S: Sink](mut self, lookahead: Lookahead, source: Slice[u8], mut sink: S) fails Failure {
    let token = lookahead.token
    match first token.kind {
        TokenKind.Keyword(Keyword.Match) if self.single_line => fail Failure.MultipleLines(at: lookahead.at)
        TokenKind.Nl if self.single_line and self.braces > 0 => fail Failure.MultipleLines(at: lookahead.at)
        TokenKind.Punct(Punct.LBrace) => {
            expect self.braces < ~0usize
            self.braces += 1
        }
        TokenKind.Punct(Punct.RBrace) => {
            self.braces = self.braces.saturating_sub(1)
        }
        else => {}
    }
    match token.kind {
        TokenKind.Ident => {
            let Some(head) = source.prefix(usize.widen(token.end)) else {
                expect false
                return
            }
            let Some(parts) = head.split_at(usize.widen(token.start)) else {
                expect false
                return
            }
            self.pascal_path = is_pascal(parts.tail)
        }
        else => {}
    }
    mut sink.token(lookahead.at)
} State.consume

/// The rule of the innermost frame that expands one.
fn State.innermost_rule(self) -> Option[Rule] {
    for index in 0..<self.frames.len() {
        match self.frames[self.frames.len() - 1 - index].rule {
            Some(rule) => return Some(rule)
            None => {}
        }
    }
    return None
} State.innermost_rule

/// The atom the innermost frame stands at, if it has not passed its end.
fn State.current_atom(self, grammar: Tables) -> Option[Atom] {
    let depth = self.frames.len()
    if depth == 0 {
        return None
    }
    let frame = self.frames[depth - 1]
    expect frame.seq < grammar.seqs.len()
    let elems = grammar.seqs[frame.seq].elems
    if frame.elem >= elems.len() {
        return None
    }
    return Some(elems[frame.elem].atom)
} State.current_atom

/// Whether the parse accepts these tokens in order, each read with the next as lookahead.
fn State.accepts(self, tokens: Slice[Token], source: Slice[u8], grammar: Tables, alloc: mem::Alloc) -> bool {
    var state = self.clone(alloc)
    var dry = Discard()
    for index in 0..<tokens.len() {
        var next: Option[Token] = None
        if index + 1 < tokens.len() {
            next = Some(tokens[index + 1])
        }
        let lookahead = Lookahead(token: tokens[index], next: next, at: ~0usize)
        match attempt mut state.feed(lookahead, source, sink: mut dry, grammar) {
            Ok(Fed.Consumed) => {}
            else => return false
        }
    }
    return true
} State.accepts
