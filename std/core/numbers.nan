pub fn i8.wrapping_add(self, other: i8) -> i8 limits pure, notrap, terminates
    example (-1i8).wrapping_add(1) == 0

pub fn i8.wrapping_sub(self, other: i8) -> i8 limits pure, notrap, terminates
    example 0i8.wrapping_sub(1) == -1

pub fn i8.wrapping_mul(self, other: i8) -> i8 limits pure, notrap, terminates
    example (-2i8).wrapping_mul(3) == -6

pub fn i8.overflowing_add(self, other: i8) -> Overflowing[i8] limits pure, notrap, terminates
    example (-1i8).overflowing_add(1) == Overflowing(value: 0, overflowed: false)
{
    let value = self.wrapping_add(other)
    let overflowed = (self >= 0) == (other >= 0) and (value >= 0) != (self >= 0)
    return Overflowing(value: value, overflowed: overflowed)
} i8.overflowing_add

pub fn i8.checked_add(self, other: i8) -> Option[i8] limits pure, notrap, terminates
    example (-1i8).checked_add(1) == Some(0)
{
    let sum = self.overflowing_add(other)
    if sum.overflowed {
        return None
    }
    return Some(sum.value)
} i8.checked_add

pub fn i8.saturating_add(self, other: i8) -> i8 limits pure, notrap, terminates
    example (-1i8).saturating_add(-1) == -2
{
    let sum = self.overflowing_add(other)
    if not sum.overflowed {
        return sum.value
    }
    if other > 0 {
        return 127
    }
    return -128
} i8.saturating_add

pub fn i8.overflowing_sub(self, other: i8) -> Overflowing[i8] limits pure, notrap, terminates
    example 0i8.overflowing_sub(1) == Overflowing(value: -1, overflowed: false)
{
    let value = self.wrapping_sub(other)
    let overflowed = (self >= 0) != (other >= 0) and (value >= 0) != (self >= 0)
    return Overflowing(value: value, overflowed: overflowed)
} i8.overflowing_sub

pub fn i8.checked_sub(self, other: i8) -> Option[i8] limits pure, notrap, terminates
    example 0i8.checked_sub(1) == Some(-1)
{
    let difference = self.overflowing_sub(other)
    if difference.overflowed {
        return None
    }
    return Some(difference.value)
} i8.checked_sub

pub fn i8.saturating_sub(self, other: i8) -> i8 limits pure, notrap, terminates
    example 0i8.saturating_sub(1) == -1
{
    let difference = self.overflowing_sub(other)
    if not difference.overflowed {
        return difference.value
    }
    if other < 0 {
        return 127
    }
    return -128
} i8.saturating_sub

pub fn i8.overflowing_mul(self, other: i8) -> Overflowing[i8] limits pure, notrap, terminates
    example (-2i8).overflowing_mul(3) == Overflowing(value: -6, overflowed: false)
{
    let exact = i64.from_bits(i64.widen(self).wide_mul(i64.widen(other)).low)
    let overflowed = exact < -128 or exact > 127
    return Overflowing(value: i8.truncate(exact), overflowed: overflowed)
} i8.overflowing_mul

pub fn i8.checked_mul(self, other: i8) -> Option[i8] limits pure, notrap, terminates
    example (-2i8).checked_mul(3) == Some(-6)
{
    let product = self.overflowing_mul(other)
    if product.overflowed {
        return None
    }
    return Some(product.value)
} i8.checked_mul

pub fn i8.saturating_mul(self, other: i8) -> i8 limits pure, notrap, terminates
    example (-2i8).saturating_mul(3) == -6
{
    let product = self.overflowing_mul(other)
    if not product.overflowed {
        return product.value
    }
    if (self < 0) == (other < 0) {
        return 127
    }
    return -128
} i8.saturating_mul

pub fn i8.wrapping_neg(self) -> i8 limits pure, notrap, terminates
    example (-5i8).wrapping_neg() == 5
{
    return 0i8.wrapping_sub(self)
} i8.wrapping_neg

pub fn i8.overflowing_neg(self) -> Overflowing[i8] limits pure, notrap, terminates
    example (-5i8).overflowing_neg() == Overflowing(value: 5, overflowed: false)
{
    return Overflowing(value: self.wrapping_neg(), overflowed: self == -128)
} i8.overflowing_neg

pub fn i8.checked_neg(self) -> Option[i8] limits pure, notrap, terminates
    example (-5i8).checked_neg() == Some(5)
{
    if self == -128 {
        return None
    }
    return Some(-self)
} i8.checked_neg

pub fn i8.saturating_neg(self) -> i8 limits pure, notrap, terminates
    example (-5i8).saturating_neg() == 5
{
    if self == -128 {
        return 127
    }
    return -self
} i8.saturating_neg

pub fn i8.div_trunc(self, divisor: i8) -> i8 limits pure, terminates
    example (-7i8).div_trunc(2) == -3

pub fn i8.rem_trunc(self, divisor: i8) -> i8 limits pure, terminates
    example (-7i8).rem_trunc(2) == -1

pub fn i8.div_floor(self, divisor: i8) -> i8 limits pure, terminates
    example (-7i8).div_floor(2) == -4
{
    let quotient = self.div_trunc(divisor)
    let remainder = self.rem_trunc(divisor)
    if remainder != 0 and (remainder < 0) != (divisor < 0) {
        return quotient - 1
    }
    return quotient
} i8.div_floor

pub fn i8.mod_floor(self, divisor: i8) -> i8 limits pure, terminates
    example (-7i8).mod_floor(2) == 1
{
    let remainder = self.rem_trunc(divisor)
    if remainder != 0 and (remainder < 0) != (divisor < 0) {
        return remainder + divisor
    }
    return remainder
} i8.mod_floor

