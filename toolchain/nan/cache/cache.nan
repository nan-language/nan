//! The user directory: its build cache, whose files hold their contents, then their checksum, and the secret keys of its principals.

/// The home directory a process uses in place of the one the user database gives, and the
/// directory of its local store in place of the user directory's `store`, as a harness gives
/// them.
pkg struct HomeOverride {
    pkg home: text::String
    pkg store: Option[text::String]
} HomeOverride

pkg fn copied_override(home: Option[HomeOverride], alloc: mem::Alloc) -> Option[HomeOverride] {
    let Some(given) = home else {
        return None
    }
    var store: Option[text::String] = None
    match given.store {
        Some(path) => {
            store = Some(text::String.of(path.as_str(), alloc))
        }
        None => {}
    }
    return Some(HomeOverride(home: text::String.of(given.home.as_str(), alloc), store: take store))
} copied_override

/// The build cache of the running user, with the directory of its local store; without a
/// directory when the user database gives the user no home directory, so that no record is found
/// and none is kept.
pkg struct Cache {
    dir: Option[text::String]
    store_path: Option[text::String]
    keys: Option[text::String]
    home: text::String
    uid: u32
    alloc: mem::Alloc
} Cache

/// The local store's directory in the user directory, once checked, and how to check its files.
pkg struct StoreDir {
    pkg dir: Option[text::String]
    pkg home: text::String
    pkg uid: u32
    pkg alloc: mem::Alloc
} StoreDir

/// Whether a file or directory of the store is exposed: its path as `~/.nan/...` when it is.
pkg fn StoreDir.exposed(self, path: Str) -> Option[Exposed] fails platform::IoError {
    let held = match first attempt platform::symlink_metadata(path) {
        Ok(held) => held
        Err(platform::IoError.NotFound) => return None
        Err(error) => fail error
    }
    if exposed(held, uid: self.uid) {
        return Some(Exposed(path: shown(self.home.as_str(), path, alloc: self.alloc)))
    }
    return None
} StoreDir.exposed

/// A part of the user directory that a symbolic link could redirect or another user could
/// write: its path as `~/.nan/...`.
pkg struct Exposed {
    pkg path: text::String
} Exposed

/// The running user's build cache, after checking the user directory, `cache` and `store`
/// and creating each that is missing; `given` replaces the home directory and the store.
pkg fn Cache.open(given: Option[HomeOverride], alloc: mem::Alloc) -> Result[Cache, Exposed] fails platform::IoError {
    let uid = try platform::running_user(alloc)
    var found: Option[text::String] = None
    var chosen: Option[text::String] = None
    match given {
        Some(replaced) => {
            found = Some(text::String.of(replaced.home.as_str(), alloc))
            chosen = copied(replaced.store, alloc)
        }
        None => {
            found = try platform::home(uid, alloc)
        }
    }
    let Some(home) = found else {
        return Ok(Cache(dir: None, store_path: None, keys: None, home: text::String.empty(alloc), uid: uid, alloc: alloc))
    }
    let user = platform::join(home.as_str(), name: ".nan", alloc)
    let cache = platform::join(user.as_str(), name: "cache", alloc)
    let store = match chosen {
        Some(dir) => dir
        None => platform::join(user.as_str(), name: "store", alloc)
    }
    var dirs = mem::List[text::String].empty(alloc)
    mut dirs.push(text::String.of(user.as_str(), alloc))
    mut dirs.push(text::String.of(cache.as_str(), alloc))
    mut dirs.push(text::String.of(store.as_str(), alloc))
    var missing = mem::List[text::String].empty(alloc)
    for dir in take dirs {
        let held = match first attempt platform::symlink_metadata(dir.as_str()) {
            Ok(held) => held
            Err(platform::IoError.NotFound) => {
                mut missing.push(take dir)
                continue
            }
            Err(error) => fail error
        }
        if exposed(held, uid) {
            return Err(Exposed(path: shown(home.as_str(), path: dir.as_str(), alloc)))
        }
    }
    for dir in missing {
        let made = attempt platform::create_dir(dir.as_str(), mode: 0b111_000_000)
        match first made {
            Ok(_) => {}
            Err(platform::IoError.AlreadyExists) => {
                let held = try platform::symlink_metadata(dir.as_str())
                if exposed(held, uid) {
                    return Err(Exposed(path: shown(home.as_str(), path: dir.as_str(), alloc)))
                }
            }
            Err(error) => fail error
        }
    }
    return Ok(Cache(dir: Some(take cache), store_path: Some(take store), keys: Some(platform::join(user.as_str(), name: "keys", alloc)), home: take home, uid: uid, alloc: alloc))
} Cache.open

/// A copy of an optional text.
fn copied(held: Option[text::String], alloc: mem::Alloc) -> Option[text::String] {
    let Some(value) = held else {
        return None
    }
    return Some(text::String.of(value.as_str(), alloc))
} copied

/// The local store of the user directory.
pkg fn Cache.store(self) -> StoreDir {
    return StoreDir(dir: copied(self.store_path, alloc: self.alloc), home: text::String.of(self.home.as_str(), alloc: self.alloc), uid: self.uid, alloc: self.alloc)
} Cache.store

/// The contents of a cache entry, none when it is missing or its checksum does not match.
pkg fn Cache.entry(self, key: hashing::HashValue) -> Result[Option[mem::Bytes], Exposed] fails platform::IoError {
    let name = entry_name(key, alloc: self.alloc)
    return try self.record(name.as_str())
} Cache.entry

/// Writes a cache entry under its key unless one is there.
pkg fn Cache.put(self, key: hashing::HashValue, contents: Slice[u8]) fails platform::IoError {
    let name = entry_name(key, alloc: self.alloc)
    let Some(dir) = self.dir else {
        return
    }
    if platform::exists(platform::join(dir.as_str(), name: name.as_str(), alloc: self.alloc).as_str()) {
        return
    }
    try self.replace(name.as_str(), contents)
} Cache.put

/// Whether the cache holds an entry under a key.
pkg fn Cache.holds(self, key: hashing::HashValue) -> bool {
    let Some(dir) = self.dir else {
        return false
    }
    return platform::exists(platform::join(dir.as_str(), name: entry_name(key, alloc: self.alloc).as_str(), alloc: self.alloc).as_str())
} Cache.holds

/// Another handle of the cache.
pkg fn Cache.copied(self, alloc: mem::Alloc) -> Cache {
    return Cache(dir: copied_text(self.dir, alloc), store_path: copied_text(self.store_path, alloc), keys: copied_text(self.keys, alloc), home: text::String.of(self.home.as_str(), alloc), uid: self.uid, alloc: alloc)
} Cache.copied

fn copied_text(held: Option[text::String], alloc: mem::Alloc) -> Option[text::String] {
    let Some(written) = held else {
        return None
    }
    return Some(text::String.of(written.as_str(), alloc))
} copied_text

/// Deletes the cache entry under a key, if there.
pkg fn Cache.remove(self, key: hashing::HashValue) fails platform::IoError {
    let Some(dir) = self.dir else {
        return
    }
    let name = entry_name(key, alloc: self.alloc)
    match first attempt platform::remove_file(platform::join(dir.as_str(), name: name.as_str(), alloc: self.alloc).as_str()) {
        Ok(_) or Err(platform::IoError.NotFound) => {}
        Err(error) => fail error
    }
} Cache.remove

/// The name of a cache entry's file: `entry-` and its key in full form.
fn entry_name(key: hashing::HashValue, alloc: mem::Alloc) -> text::String {
    var name = text::String.of("entry-", alloc)
    mut name.append(key.full(alloc).as_str())
    return name
} entry_name

/// The contents of a cache record, none when it is missing or its checksum does not match.
pkg fn Cache.record(self, name: Str) -> Result[Option[mem::Bytes], Exposed] fails platform::IoError {
    let Some(dir) = self.dir else {
        return Ok(None)
    }
    let path = platform::join(dir.as_str(), name, alloc: self.alloc)
    let held = match first attempt platform::symlink_metadata(path.as_str()) {
        Ok(held) => held
        Err(platform::IoError.NotFound) => return Ok(None)
        Err(error) => fail error
    }
    if exposed(held, uid: self.uid) {
        return Err(Exposed(path: shown(self.home.as_str(), path: path.as_str(), alloc: self.alloc)))
    }
    let file = try platform::read_file(path.as_str(), alloc: self.alloc)
    return Ok(checked_contents(file.view(), alloc: self.alloc))
} Cache.record

/// The contents of a file holding contents followed by their checksum, none when the checksum
/// does not match or the file is shorter than one.
fn checked_contents(file: Slice[u8], alloc: mem::Alloc) -> Option[mem::Bytes] {
    if file.len() < CHECKSUM_LEN {
        return None
    }
    let Some(parts) = file.split_at(file.len() - CHECKSUM_LEN) else {
        return None
    }
    if checksum(parts.head).view() != parts.tail {
        return None
    }
    var contents = mem::Bytes.empty(alloc)
    mut contents.append(parts.head)
    return Some(take contents)
} checked_contents

const CHECKSUM_LEN: usize = 16

/// The multipliers of the two lanes of `checksum`, odd constants of the golden ratio and of
/// xxHash.
const LANE_A: u64 = 0x9E37_79B9_7F4A_7C15

const LANE_B: u64 = 0xC2B2_AE3D_27D4_EB4F

/// The checksum of a cache file's contents, which tells a file cut short or altered from the
/// one written: two lanes of 64 bits, folding in each little-endian word of eight bytes, the
/// last one zero-padded, by an exclusive or or a sum, a multiplication and a rotation, then the
/// length, each finished by the avalanche of MurmurHash3.
fn checksum(data: Slice[u8]) -> Array[u8, 16] {
    var a = LANE_A
    var b = LANE_B
    var at: usize = 0
    while at <= data.len() and data.len() - at >= 8 {
        let word = data.u64_le(at)
        a = rotated((a ^ word).wrapping_mul(LANE_A), by: 31)
        b = rotated(b.wrapping_add(word).wrapping_mul(LANE_B), by: 27)
        at += 8
    }
    var last: u64 = 0
    var shift: u32 = 0
    while at < data.len() {
        last = last | (u64.widen(data[at]) << shift)
        shift += 8
        at += 1
    }
    a = rotated((a ^ last).wrapping_mul(LANE_A), by: 31) ^ u64.widen(data.len())
    b = rotated(b.wrapping_add(last).wrapping_mul(LANE_B), by: 27) ^ u64.widen(data.len())
    var sum = Array[u8, 16].filled(0)
    let low = avalanche(a ^ b)
    let high = avalanche(b.wrapping_add(a))
    for index in 0..<8usize {
        sum[index] = u8.truncate(low >> u32.truncate(8 * index))
        sum[8 + index] = u8.truncate(high >> u32.truncate(8 * index))
    }
    return sum
} checksum

fn rotated(value: u64, by: u32) -> u64
    requires by > 0 and by < 64
{
    return (value << by) | (value >> (64 - by))
} rotated

/// The finalisation of MurmurHash3's 64-bit hash.
fn avalanche(value: u64) -> u64 {
    var mixed = value ^ (value >> 33)
    mixed = mixed.wrapping_mul(0xFF51_AFD7_ED55_8CCD)
    mixed = mixed ^ (mixed >> 33)
    mixed = mixed.wrapping_mul(0xC4CE_B9FE_1A85_EC53)
    return mixed ^ (mixed >> 33)
} avalanche

/// Replaces a cache record, writing it whole under a new name and renaming it into place.
pkg fn Cache.replace(self, name: Str, contents: Slice[u8]) fails platform::IoError {
    let Some(dir) = self.dir else {
        return
    }
    var fresh_name = text::String.of(".", alloc: self.alloc)
    mut fresh_name.append(name)
    mut fresh_name.write(text::fmt(".{id}", id: platform::process_id()), budget: 32)
    let fresh = platform::join(dir.as_str(), name: fresh_name.as_str(), alloc: self.alloc)
    let file = try platform::File.create(fresh.as_str(), mode: 0b110_000_000)
    defer take file.close()
    try file.write_all(contents)
    try file.write_all(checksum(contents).view())
    try platform::rename_path(fresh.as_str(), to: platform::join(dir.as_str(), name, alloc: self.alloc).as_str())
} Cache.replace

/// The secret seed `keys/<principal>.key` holds: none when the file is missing or does not hold
/// 32 bytes.
pkg fn Cache.secret_key(self, principal: Str) -> Result[Option[Array[u8, 32]], Exposed] fails platform::IoError {
    let Some(keys) = self.keys else {
        return Ok(None)
    }
    let file = key_file(keys.as_str(), principal, alloc: self.alloc)
    let directory = match try self.secret_held(keys.as_str()) {
        Ok(held) => held
        Err(found) => return Err(take found)
    }
    if not directory {
        return Ok(None)
    }
    let held_file = match try self.secret_held(file.as_str()) {
        Ok(held) => held
        Err(found) => return Err(take found)
    }
    if not held_file {
        return Ok(None)
    }
    let contents = try platform::read_file(file.as_str(), alloc: self.alloc)
    if contents.len() != 32 {
        return Ok(None)
    }
    var seed = Array[u8, 32].filled(0)
    mut seed.view_mut().copy_from(contents.view())
    return Ok(Some(seed))
} Cache.secret_key

/// Whether the directory of secret keys or a key file exists, or its path when it is exposed.
fn Cache.secret_held(self, path: Str) -> Result[bool, Exposed] fails platform::IoError {
    let held = match first attempt platform::symlink_metadata(path) {
        Ok(held) => held
        Err(platform::IoError.NotFound) => return Ok(false)
        Err(error) => fail error
    }
    if secret_exposed(held, uid: self.uid) {
        return Err(Exposed(path: shown(self.home.as_str(), path, alloc: self.alloc)))
    }
    return Ok(true)
} Cache.secret_held

/// Whether `new_key` wrote a secret key, and the key file's path as `~/.nan/...`.
pkg struct NewKey {
    pkg made: bool
    pkg path: text::String
} NewKey

/// Writes the secret seed of a principal that has no key file, creating `keys` when it is
/// missing: not made, writing nothing, when the file exists.
pkg fn Cache.new_key(self, principal: Str, seed: Array[u8, 32]) -> Result[NewKey, Exposed] fails platform::IoError {
    let Some(keys) = self.keys else {
        fail platform::IoError.NotFound
    }
    match first attempt platform::create_dir(keys.as_str(), mode: 0b111_000_000) {
        Ok(_) or Err(platform::IoError.AlreadyExists) => {}
        Err(error) => fail error
    }
    if secret_exposed(try platform::symlink_metadata(keys.as_str()), uid: self.uid) {
        return Err(Exposed(path: shown(self.home.as_str(), path: keys.as_str(), alloc: self.alloc)))
    }
    let file = key_file(keys.as_str(), principal, alloc: self.alloc)
    let path = shown(self.home.as_str(), path: file.as_str(), alloc: self.alloc)
    let opened = match first attempt platform::File.create_new(file.as_str(), mode: 0b110_000_000) {
        Ok(opened) => opened
        Err(platform::IoError.AlreadyExists) => return Ok(NewKey(made: false, path: take path))
        Err(error) => fail error
    }
    defer take opened.close()
    try opened.write_all(seed.view())
    return Ok(NewKey(made: true, path: take path))
} Cache.new_key

/// The path of a principal's key file in the directory of secret keys.
fn key_file(keys: Str, principal: Str, alloc: mem::Alloc) -> text::String {
    var name = text::String.of(principal, alloc)
    mut name.append(".key")
    return platform::join(keys, name: name.as_str(), alloc)
} key_file

/// Whether the directory of secret keys or a key file is a symbolic link, belongs to another
/// user, or is accessible to its group or to others.
fn secret_exposed(held: platform::Metadata, uid: u32) -> bool {
    return held.is_symlink() or held.uid != uid or (held.mode & 0b000_111_111) != 0
} secret_exposed

/// A path within the home directory, written as `~/` and its path there.
fn shown(home: Str, path: Str, alloc: mem::Alloc) -> text::String {
    var written = text::String.of("~/", alloc)
    match platform::strip_prefix(path, base: home, alloc) {
        Some(within) => mut written.append(within.as_str())
        None => mut written.append(path)
    }
    return written
} shown

/// Whether a part of the user directory is a symbolic link, belongs to another user, or is
/// writable by its group or by others.
fn exposed(held: platform::Metadata, uid: u32) -> bool {
    return held.is_symlink() or held.uid != uid or (held.mode & 0b000_010_010) != 0
} exposed
