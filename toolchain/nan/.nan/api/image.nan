item "nan::image::signature_pages"
head "fn signature_pages(signed: u64) -> u64"
accepted "ensures result <= signed / SIGNATURE_PAGE + 1"
item "nan::image::write_headers"
head "fn write_headers(mut out: mem::Bytes, sections: Slice[PeSection], sizes: Sizes, arch: workspace::Arch)"
accepted "requires sections.len() > 0 and sizes.entry >= sizes.image_base"
