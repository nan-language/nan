//! The watchdog's registers and its driver.

/// Where the board decodes the watchdog's registers.
const WATCHDOG_BASE: u64 = 0xFED5_0000

pub layout Control: u32 {
    enable: bit 0
    reset_on_expiry: bit 1
    prescaler: bit 4..=7
    reserved: rest
} Control

/// `expired` is set when the count runs out and cleared by writing 1 to it.
pub layout Status: u32 le {
    expired: bit 0
    reserved: rest
} Status

pub layout Counter: u32 le {
    ticks: bit 0..=23
} Counter

pub registers WatchdogRegs {
    control: Control at 0x0 read write
    reload: u32 at 0x4 write
    count: Counter at 0x8 read
    status: Status at 0xC read
} WatchdogRegs

/// The watchdog's window and the ticks each pet grants.
pub open struct Watchdog {
    regs: hw::Mmio[WatchdogRegs]
    ticks: u32
} Watchdog

/// The watchdog's registers.
pub fn map_watchdog() -> hw::Mmio[WatchdogRegs] {
    return hw::Mmio[WatchdogRegs].map(phys: WATCHDOG_BASE)
} map_watchdog

/// Starts counting down `ticks` ticks of the clock divided by 2^`prescaler`, the board resetting
/// when the count runs out.
pub fn Watchdog.start(take regs: hw::Mmio[WatchdogRegs], ticks: u32, prescaler: u8) -> Watchdog
    requires prescaler <= 15
{
    mut regs.write(WatchdogRegs.reload, value: ticks)
    mut regs.write(WatchdogRegs.control, value: Control(enable: true, reset_on_expiry: true, prescaler: prescaler, reserved: 0))
    return Watchdog(regs: take regs, ticks: ticks)
} Watchdog.start

/// Restarts the count from the watchdog's ticks.
pub fn Watchdog.pet(mut self) {
    mut self.regs.write(WatchdogRegs.reload, value: self.ticks)
} Watchdog.pet

/// The ticks left before the count runs out.
pub fn Watchdog.remaining(mut self) -> u32 {
    let counter = mut self.regs.read(WatchdogRegs.count)
    return counter.ticks
} Watchdog.remaining

/// Whether the count ran out since the flag was last cleared, clearing it when it did.
pub fn Watchdog.clear_expiry(mut self) -> bool {
    let status = mut self.regs.read(WatchdogRegs.status)
    if status.expired {
        mut self.regs.write(WatchdogRegs.status, value: Status(expired: true, reserved: 0))
    }
    return status.expired
} Watchdog.clear_expiry

/// Disables the watchdog and ends its window.
pub fn Watchdog.stop(take self) {
    mut self.regs.write(WatchdogRegs.control, value: Control(enable: false, reset_on_expiry: false, prescaler: 0, reserved: 0))
} Watchdog.stop
