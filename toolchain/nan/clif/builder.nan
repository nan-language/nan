pkg fn Builder.load(mut self, ty: Type, flags: MemFlags, p: Value, offset: i32) -> Value {
    return mut self.build_value(InstructionData.Load(opcode: Opcode.Load, flags: flags, arg: p, offset: offset), ctrl_typevar: Some(ty))
} Builder.load

pkg fn Builder.store(mut self, flags: MemFlags, x: Value, p: Value, offset: i32) {
    let ty = self.value_type(x)
    discard mut self.build(InstructionData.Store(opcode: Opcode.Store, flags: flags, x: x, p: p, offset: offset), ctrl_typevar: Some(ty))
} Builder.store

pkg fn Builder.atomic_load(mut self, ty: Type, flags: MemFlags, p: Value) -> Value {
    return mut self.build_value(InstructionData.LoadNoOffset(opcode: Opcode.AtomicLoad, flags: flags, arg: p), ctrl_typevar: Some(ty))
} Builder.atomic_load

pkg fn Builder.atomic_store(mut self, flags: MemFlags, x: Value, p: Value) {
    let ty = self.value_type(x)
    discard mut self.build(InstructionData.StoreNoOffset(opcode: Opcode.AtomicStore, flags: flags, x: x, p: p), ctrl_typevar: Some(ty))
} Builder.atomic_store

pkg fn Builder.atomic_rmw(mut self, ty: Type, flags: MemFlags, op: AtomicRmwOp, p: Value, x: Value) -> Value {
    return mut self.build_value(InstructionData.AtomicRmw(opcode: Opcode.AtomicRmw, flags: flags, op: op, p: p, x: x), ctrl_typevar: Some(ty))
} Builder.atomic_rmw

pkg fn Builder.atomic_cas(mut self, flags: MemFlags, p: Value, e: Value, x: Value) -> Value {
    let ty = self.value_type(x)
    return mut self.build_value(InstructionData.AtomicCas(opcode: Opcode.AtomicCas, flags: flags, p: p, e: e, x: x), ctrl_typevar: Some(ty))
} Builder.atomic_cas

pkg fn Builder.fence(mut self) {
    discard mut self.build(InstructionData.NullAry(opcode: Opcode.Fence), ctrl_typevar: None)
} Builder.fence

pkg fn Builder.stack_addr(mut self, ty: Type, slot: StackSlot, offset: i32) -> Value {
    return mut self.build_value(InstructionData.StackLoad(opcode: Opcode.StackAddr, slot: slot, offset: offset), ctrl_typevar: Some(ty))
} Builder.stack_addr

pkg fn Builder.symbol_value(mut self, ty: Type, global_value: GlobalValue) -> Value {
    return mut self.build_value(InstructionData.UnaryGlobalValue(opcode: Opcode.SymbolValue, global_value: global_value), ctrl_typevar: Some(ty))
} Builder.symbol_value

pkg fn Builder.tls_value(mut self, ty: Type, global_value: GlobalValue) -> Value {
    return mut self.build_value(InstructionData.UnaryGlobalValue(opcode: Opcode.TlsValue, global_value: global_value), ctrl_typevar: Some(ty))
} Builder.tls_value

pkg fn Builder.func_addr(mut self, ty: Type, func_ref: FuncRef) -> Value {
    return mut self.build_value(InstructionData.FuncAddr(opcode: Opcode.FuncAddr, func_ref: func_ref), ctrl_typevar: Some(ty))
} Builder.func_addr

pkg fn Builder.get_frame_pointer(mut self, ty: Type) -> Value {
    return mut self.build_value(InstructionData.NullAry(opcode: Opcode.GetFramePointer), ctrl_typevar: Some(ty))
} Builder.get_frame_pointer

pkg fn Builder.call(mut self, func_ref: FuncRef, args: Slice[Value]) -> Inst {
    let values = self.value_list(args)
    return mut self.build(InstructionData.Call(opcode: Opcode.Call, func_ref: func_ref, args: take values), ctrl_typevar: None)
} Builder.call

pkg fn Builder.call_indirect(mut self, sig_ref: SigRef, callee: Value, args: Slice[Value]) -> Inst {
    let ty = self.value_type(callee)
    let values = self.value_list(args)
    return mut self.build(InstructionData.CallIndirect(opcode: Opcode.CallIndirect, sig_ref: sig_ref, callee: callee, args: take values), ctrl_typevar: Some(ty))
} Builder.call_indirect

/// Returns from the function with `args`: Cranelift's `return`.
pkg fn Builder.ret(mut self, args: Slice[Value]) {
    let values = self.value_list(args)
    discard mut self.build(InstructionData.MultiAry(opcode: Opcode.Return, args: take values), ctrl_typevar: None)
} Builder.ret

pkg fn Builder.jump(mut self, block: Block, args: Slice[Value]) {
    let destination = self.block_call(block, args)
    let inst = mut self.build(InstructionData.Jump(opcode: Opcode.Jump, destination: take destination), ctrl_typevar: None)
    mut self.declare_successor(block, jump_inst: inst)
} Builder.jump

pkg fn Builder.brif(mut self, c: Value, then: Block, then_args: Slice[Value], otherwise: Block, otherwise_args: Slice[Value]) {
    let block_then = self.block_call(then, args: then_args)
    let block_else = self.block_call(otherwise, args: otherwise_args)
    let ty = self.value_type(c)
    let inst = mut self.build(InstructionData.Brif(opcode: Opcode.Brif, arg: c, then: take block_then, otherwise: take block_else), ctrl_typevar: Some(ty))
    mut self.declare_successor(then, jump_inst: inst)
    if then != otherwise {
        mut self.declare_successor(otherwise, jump_inst: inst)
    }
} Builder.brif

pkg fn Builder.trap(mut self, code: TrapCode) {
    discard mut self.build(InstructionData.Trap(opcode: Opcode.Trap, code: code), ctrl_typevar: None)
} Builder.trap

pkg fn Builder.stack_switch(mut self, store_context_ptr: Value, load_context_ptr: Value, in_payload0: Value) -> Value {
    let ty = self.value_type(load_context_ptr)
    return mut self.build_value(InstructionData.Ternary(opcode: Opcode.StackSwitch, x: store_context_ptr, y: load_context_ptr, z: in_payload0), ctrl_typevar: Some(ty))
} Builder.stack_switch
