//! Sums the numbers up to its input's depth, one call deeper per number, as many times as it asks.

pub closed struct Depth derives Encode {
    pub calls: u64
    pub repeats: u64
} Depth

fn sum(n: u64) -> u64 {
    if n == 0 {
        return 0
    }
    return n.wrapping_add(sum(n - 1))
} sum

fn main(take world: nanos::World, take input: Depth) -> u64 fails task::Cancelled uses wait {
    var total: u64 = 0
    for _ in 0..<input.repeats {
        total = total.wrapping_add(sum(input.calls))
    }
    return total
} main
