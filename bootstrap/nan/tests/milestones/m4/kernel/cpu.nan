//! The CPU's own operations: its identification and counter, a wait for an interrupt, the CPU signal and a shootdown.

/// The ticks a check waits at most for every CPU to take the signal.
const SIGNAL_TICKS: u32 = 50

/// Counts each CPU signal a CPU takes.
pub interrupt fn on_signal(take irq: hw::IrqContext) -> hw::IrqExit limits stack 1_024 {
    discard hw::Anchor[State].with(fn(state: State) {
        discard state.signals.contents().fetch_add(1)
    })
    take irq.complete()
    return hw::IrqExit.Resume
} on_signal

contribute hw::vectors signal = hw::Vector(vector: hw::SIGNAL_VECTOR, ist: 0, handler: hw::VectorHandler.Irq(on_signal), user: None)

/// Reports the CPU's vendor string, its counter advancing and the CPU `read_tscp` names, a wait
/// for an interrupt, every CPU taking the signal, and a shootdown every CPU serves.
fn check_cpu(console: hw::IrqShared[Console], cpu: hw::Ring0, signals: mem::Shared[core::atomic::AtomicU64], ticks: mem::Shared[hw::Signal[u64]]) fails task::Cancelled uses wait {
    let vendor = cpu.cpuid(0, subleaf: 0)
    if printable(vendor.ebx) and printable(vendor.edx) and printable(vendor.ecx) {
        say(console, text: "cpuid: the vendor string is 12 printable bytes\n")
    }
    let before = cpu.read_tsc()
    discard try await ticks.contents().wait()
    let after = cpu.read_tscp()
    if after.count > before and after.cpu < hw::cpu_count() {
        say(console, text: "tsc: the counter advanced over a tick\n")
    }
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap {
        cpu.wait_for_interrupt(t)
    })
    say(console, text: "idle: an interrupt ended a wait\n")
    let taken = signals.contents().load()
    for index in 0..<hw::cpu_count() {
        cpu.signal_cpu(index)
    }
    var waited: u32 = 0
    while signals.contents().load() < taken + u64.widen(hw::cpu_count()) and waited < SIGNAL_TICKS {
        discard try await ticks.contents().wait()
        waited = waited + 1
    }
    if waited < SIGNAL_TICKS {
        say_number(console, before: "signal: each of ", value: u64.widen(hw::cpu_count()), after: " cpus took the cpu signal\n")
    }
    try await cpu.invalidate_everywhere(hw::TlbScope.Page(hw::VirtAddr(value: 0x20_0000)))
    try await cpu.invalidate_everywhere(hw::TlbScope.All)
    say(console, text: "shootdown: every cpu invalidated its translations\n")
} check_cpu

/// Whether the four bytes of a register are printable ASCII.
fn printable(register: u32) -> bool {
    var shift: u32 = 0
    while shift < 32 {
        let byte = u8.truncate(register >> shift)
        if byte < 0x20 or byte > 0x7E {
            return false
        }
        shift = shift + 8
    }
    return true
} printable

test printable_rejects_control_bytes for printable {
    expect printable(0x756E_6547)
    expect not printable(0x756E_0047)
} printable_rejects_control_bytes
