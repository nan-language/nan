//! The firmware's variables.

pkg fn get_variable(name: Str, vendor: boot::Guid, alloc: mem::Alloc) -> boot::Variable fails boot::ServiceError {
    var units = Array[u16, 256].filled(0)
    try wide(name, path: false, mut units)
    let kind = guid_bits(vendor)
    var attributes = Array[u64, 1].filled(0)
    var size = Array[u64, 1].filled(0)
    var data = mem::Bytes.empty(alloc)
    loop {
        let status = call(runtime_service(VARIABLE_GET), a: src_units(units.view()), b: src(kind.view()), c: dst_words(mut attributes.view_mut()), d: dst_words(mut size.view_mut()), e: dst(mut data.view_mut()))
        if status != BUFFER_TOO_SMALL {
            try success(status)
            mut data.truncate(usize.widen(size[0]))
            let bits = u32.truncate(attributes[0])
            return boot::Variable(attributes: boot::VariableAttributes.from_bits(bits), data: Untrusted.of(take data))
        }
        data = try zeroed(size[0], alloc)
    }
} get_variable

pkg fn set_variable(name: Str, vendor: boot::Guid, attributes: boot::VariableAttributes, data: Slice[u8]) fails boot::ServiceError {
    var units = Array[u16, 256].filled(0)
    try wide(name, path: false, mut units)
    let kind = guid_bits(vendor)
    let bits = u64.widen(attributes.to_bits())
    try success(call(runtime_service(VARIABLE_SET), a: src_units(units.view()), b: src(kind.view()), c: bits, d: u64.widen(data.len()), e: src(data)))
} set_variable
