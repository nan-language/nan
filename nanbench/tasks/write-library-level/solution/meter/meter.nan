//! Readings as percentages.

/// The reading's share of `full` in percent, rounded down and at most 100; 0 when `full` is 0.
pub fn level(reading: u32, full: u32) -> u8 {
    if full == 0 {
        return 0
    }
    let percent = u64.widen(reading) * 100 / u64.widen(full)
    if percent > 100 {
        return 100
    }
    return u8.fit(percent)
} level
