//! The size's keys counted in a hash map, then as many others looked up.

enum BenchError derives Render {
    Usage
    Stdio(sys::StdioError) from
    Cancelled(task::Cancelled) from
} BenchError

/// The number the first argument states in decimal, if it states one.
validator fn size(args: Untrusted[mem::List[mem::Bytes]]) -> Option[u64] {
    let Some(arg) = args.inspect().get(0) else {
        return None
    }
    var value: u64 = 0
    for digit in arg.view() {
        if digit < b'0' or digit > b'9' {
            return None
        }
        value = value * 10 + u64.widen(digit - b'0')
    }
    return Some(value)
} size

/// The state after `state` of a 64-bit linear congruential generator.
fn next(state: u64) -> u64 = state.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407)

fn main(take world: host::World) fails BenchError uses wait {
    let Some(n) = size(world.args) else {
        fail BenchError.Usage
    }
    var counts = mem::HashMap[u64, u64].empty(0, alloc: world.alloc)
    var state: u64 = 1
    for _ in 0..<n {
        state = next(state)
        let key = state >> 40
        if counts.contains(key) {
            counts[key] += 1
        } else {
            discard mut counts.insert(key, value: 1)
        }
    }
    var found: u64 = 0
    for _ in 0..<n {
        state = next(state)
        let Some(count) = counts.get(state >> 40) else {
            continue
        }
        found += count
    }
    var out = text::String.empty(world.alloc)
    mut out.write(text::fmt("{distinct} {found}\n", distinct: counts.len(), found), budget: 64)
    let written = take out.into_bytes()
    try await world.stdio.write_out(written.view())
} main
