//! Component instances in isolated spaces: the kernel's side, which holds an instance whose task runs in a space, sending its holder's requests and its inboxes' calls down the first channel of the space's link, routing the answers the space sends back and calling its holder's runner for it, and the space's side, which runs the instance task, relays between that channel and the instance and forwards the operations of the instance's runner capability to the kernel.

/// The bytes of a frame's head, which holds the length of the encoding following it.
const FRAME_HEAD: usize = 4

pub fn hold_isolated[T, E](cpu: hw::Ring0, job: sys::load::Isolated, component: Str, services: Services, link: Link, take checkpoint: Option[mem::Bytes], runner: sys::Runner, mut frames: mem::List[hw::PhysFrame[4_096]], mut extended: Option[hw::ExtendedState], exec: task::Executor, alloc: mem::Alloc, body: fn(take instance: Instance) -> T fails E uses wait limits stack 65_536) -> Option[T] fails E uses wait {
    let Some(entry) = job.component(component) else {
        return None
    }
    var given = Some(take checkpoint)
    var result: Option[T] = None
    try await task::scope(exec, body: fn[mut given, mut frames, mut extended, mut result](s: task::Scope) fails E uses wait {
        let Some(from) = mut given.extract() else {
            return
        }
        let Opened(instance: instance, launch: launch, ending: ending, last: last) = opened(s, checkpoint: None, runner: sys::Runner.denied(), alloc)
        let watched = instance.abandoner.share()
        discard s.spawn(fn[take from, take launch, take ending, take last, take watched, mut frames, mut extended]() fails task::Cancelled uses wait {
            let ended = match attempt await held_in(cpu, job, entry, services, runner, link, checkpoint: take from, take launch, abandoner: take watched, mut frames, mut extended, exec, alloc) {
                Ok(how) => how
                Err(cancelled) => failed(take cancelled, alloc)
            }
            discard attempt await ending.send(Routed.Ended)
            discard attempt await last.send(take ended)
        })
        result = Some(try await body(take instance))
    })
    return result
} hold_isolated

/// Runs the instance of the component entry `entry` in a space of `job` made from `frames`,
/// resuming from `checkpoint` and acting through `runner`, until it ends, and gives how it ended:
/// failed with the rendering of an `IsolatedError` when `link` has no channel or no space can be
/// made.
fn held_in(cpu: hw::Ring0, job: sys::load::Isolated, entry: sys::load::Job, services: Services, runner: sys::Runner, link: Link, take checkpoint: Option[mem::Bytes], take launch: Launch, take abandoner: mem::Shared[sys::Abandoner], mut frames: mem::List[hw::PhysFrame[4_096]], mut extended: Option[hw::ExtendedState], exec: task::Executor, alloc: mem::Alloc) -> Ended fails task::Cancelled uses wait {
    if link.channels.len() == 0 {
        return failed(IsolatedError.NoChannel, alloc)
    }
    match attempt placed(cpu, job, entry, services, runner, link, held: true, input: encoded(checkpoint, alloc), mut frames, alloc) {
        Ok(Placed(space: made, state: started, table: table)) => {
            var space = made
            var state = started
            let outcome = attempt await relayed(cpu, mut space, mut state, mut extended, served: Serving(services: services, table: take table), runner, link, take launch, take abandoner, mut frames, exec, alloc)
            take space.release(mut frames)
            match outcome {
                Ok(how) => return how
                Err(cancelled) => fail cancelled
            }
        }
        Err(error) => return failed(IsolatedError.Unplaced(error), alloc)
    }
} held_in

/// What the kernel's relays of an instance hold: the receivers of its holder's requests, of its
/// inboxes' calls and of the frames to send down, the receiver whose sender stays held while the
/// instance runs, and the abandoner of its domain.
struct Relays {
    requests: task::Receiver[Asked]
    calls: task::Receiver[Called]
    outgoing: task::Receiver[mem::Bytes]
    parked: task::Receiver[u8]
    abandoner: mem::Shared[sys::Abandoner]
} Relays

/// Runs an instance's space until it ends, sending its holder's requests and its inboxes' calls
/// down the first channel of `link` and routing the answers the space sends up it, calling through
/// `runner` the ports the instance calls, and gives how it ended; once `abandoner` abandons, the
/// space runs no more and the instance ends abandoned.
fn relayed(cpu: hw::Ring0, mut space: sys::load::Space, mut state: hw::UserState, mut extended: Option[hw::ExtendedState], take served: Serving, runner: sys::Runner, link: Link, take launch: Launch, take abandoner: mem::Shared[sys::Abandoner], mut frames: mem::List[hw::PhysFrame[4_096]], exec: task::Executor, alloc: mem::Alloc) -> Ended fails task::Cancelled uses wait {
    let Launch(checkpoint: _, runner: _, requests: requests, calls: calls, answers: answers) = launch
    let task::Channel(sender: down, receiver: outgoing) = task::Channel[mem::Bytes].bounded(QUEUED_CALLS, alloc)
    let task::Channel(sender: parking, receiver: parked) = task::Channel[u8].bounded(1, alloc)
    let allocs = task::Cown.of(mem::Map[u64, mem::Alloc].empty(alloc), alloc)
    let halted = core::atomic::AtomicBool.of(false)
    var relays = Some(Relays(requests: take requests, calls: take calls, outgoing: take outgoing, parked: take parked, abandoner: take abandoner))
    var ended = Ended.Cancelled
    try await task::scope(exec, body: fn[mut space, mut state, mut extended, mut frames, mut relays, mut ended](s: task::Scope) fails task::Cancelled uses wait {
        let Some(Relays(requests: asked, calls: called, outgoing: sending, parked: waiting, abandoner: domain)) = mut relays.extract() else {
            return
        }
        let requests_down = down.split()
        let calls_down = down.split()
        let ports_down = down.split()
        let replies = answers.split()
        let answered = answers.split()
        let routing = allocs.share()
        let drawing = allocs.share()
        discard s.spawn(fn[take sending]() fails task::Cancelled uses wait {
            try await sent_down(link, outgoing: take sending)
        })
        discard s.spawn(fn[take asked, take requests_down]() fails task::Cancelled uses wait {
            try await asked_down(take asked, out: requests_down, exec, alloc)
        })
        discard s.spawn(fn[take called, take calls_down, take replies, take drawing]() fails task::Cancelled uses wait {
            try await called_down(take called, out: calls_down, answers: replies, allocs: drawing, table: served.table, alloc)
        })
        discard s.spawn(fn[take answered, take routing, take ports_down]() fails task::Cancelled uses wait {
            try await answered_up(link, answers: answered, allocs: routing, table: served.table, runner, out: ports_down, exec, alloc)
        })
        discard s.spawn(fn[take waiting, take domain]() fails task::Cancelled uses wait {
            let watched = attempt await domain.contents().run(fn[take waiting]() fails task::Cancelled uses wait {
                var held = waiting
                discard try await mut held.receive()
            }, exec, alloc)
            let Ok(Err(_)) = watched else {
                return
            }
            halted.store(true)
            link.ring(0)
        })
        ended = try await run_space(cpu, mut space, mut state, mut extended, served, link, halted: fn() => halted.load(), mut frames, alloc)
        s.cancel()
    })
    discard parking
    return ended
} relayed

/// Sends each frame `outgoing` carries down the first channel of `link`.
fn sent_down(link: Link, take outgoing: task::Receiver[mem::Bytes]) fails task::Cancelled uses wait {
    var receiver = outgoing
    loop {
        let Some(frame) = try await mut receiver.receive() else {
            return
        }
        match attempt await link.sent(0, data: frame.view()) {
            Ok(_) => {}
            Err(LinkError.Cancelled(cancelled)) => fail cancelled
            Err(LinkError.NoChannel) => return
        }
    }
} sent_down

/// The order of a holder's request, and the receiver whose sender the holder releases to end the
/// wait of a waiting one.
struct Ordered {
    order: Order
    stop: Option[task::Receiver[u8]]
} Ordered

fn ordered(take request: Request) -> Ordered {
    match request {
        Request.Step => return Ordered(order: Order.Step, stop: None)
        Request.Incoming(stop) => return Ordered(order: Order.Incoming, stop: Some(take stop))
        Request.Ready(stop) => return Ordered(order: Order.Ready, stop: Some(take stop))
        Request.StartKeyed => return Ordered(order: Order.StartKeyed, stop: None)
        Request.Idle => return Ordered(order: Order.Idle, stop: None)
        Request.Checkpoint => return Ordered(order: Order.Checkpoint, stop: None)
        Request.Resumed(reason) => return Ordered(order: Order.Resumed(reason), stop: None)
        Request.Pressure(level) => return Ordered(order: Order.Pressure(level), stop: None)
        Request.Health => return Ordered(order: Order.Health, stop: None)
        Request.Suspend => return Ordered(order: Order.Suspend, stop: None)
        Request.Wake => return Ordered(order: Order.Wake, stop: None)
    }
} ordered

/// Sends `out` the frame of each request of an instance's holder, then the end of its wait once
/// the holder releases the sender of a waiting one's stop, and that the holder released the
/// instance once every sender of `requests` is released.
fn asked_down(take requests: task::Receiver[Asked], out: task::Sender[mem::Bytes], exec: task::Executor, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var receiver = requests
    try await task::scope(exec, body: fn[mut receiver](s: task::Scope) fails task::Cancelled uses wait {
        loop {
            let Some(asked) = try await mut receiver.receive() else {
                discard attempt await out.send(framed(Down.Release, alloc))
                return
            }
            let Asked(id: id, request: request) = asked
            let Ordered(order: order, stop: stop) = ordered(take request)
            discard attempt await out.send(framed(Down.Ask(Asking(id: id, order: order)), alloc))
            let Some(watching) = stop else {
                continue
            }
            let stopping = out.split()
            discard s.spawn(fn[take watching, take stopping]() fails task::Cancelled uses wait {
                var released = watching
                discard try await mut released.receive()
                discard attempt await stopping.send(framed(Down.Stop(id), alloc))
            })
        }
    })
} asked_down

/// Sends `out` the frame of each call of an instance's inboxes, its handles added to the space's
/// `table`, keeping in `allocs` the allocator its reply is drawn through; a call carrying a handle
/// the space cannot hold is answered at once as malformed.
fn called_down(take calls: task::Receiver[Called], out: task::Sender[mem::Bytes], answers: task::Sender[Routed], allocs: task::Cown[mem::Map[u64, mem::Alloc]], table: Table, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var receiver = calls
    loop {
        let Some(called) = try await mut receiver.receive() else {
            return
        }
        let Called(id: id, hash: hash, request: request, alloc: drawn) = called
        let Some(crossing) = table.admitted(request.handles.view(), alloc) else {
            discard attempt await answers.send(Routed.Answered(Replied(id: id, answer: Answer.Served(Err(sys::CallError.Malformed(core::DecodeError.Invalid))))))
            continue
        }
        await when mut allocs {
            discard mut allocs.insert(id, value: drawn)
        }
        let sys::Encoded(bytes: bytes, handles: _) = request
        discard attempt await out.send(framed(Down.Call(Calling(id: id, hash: hash, bytes: take bytes, handles: take crossing)), alloc))
    }
} called_down

/// Routes through `answers` each answer the space sends up the first channel of `link`, a call's
/// reply drawn through the allocator `allocs` keeps for it and its handles those of the entries of
/// the space's `table` it names, and calls through `runner` each port the instance calls, on a task
/// of its own sending `out` the frame of the reply; it stops hearing a space that frames a message
/// it cannot decode or longer than `MOST_BYTES`.
fn answered_up(link: Link, answers: task::Sender[Routed], allocs: task::Cown[mem::Map[u64, mem::Alloc]], table: Table, runner: sys::Runner, out: task::Sender[mem::Bytes], exec: task::Executor, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var pending = mem::Bytes.empty(alloc)
    try await task::scope(exec, body: fn[mut pending](s: task::Scope) fails task::Cancelled uses wait {
        loop {
            let Some(up) = try await next_up(link, mut pending, alloc) else {
                return
            }
            match up {
                Up.Answered(Answering(id: id, answer: sent)) => {
                    let drawn = await when mut allocs => mut allocs.remove(id)
                    discard attempt await answers.send(Routed.Answered(Replied(id: id, answer: answer_of(take sent, table, alloc: drawn.value_or(alloc)))))
                }
                Up.Called(called) => {
                    let replying = out.split()
                    discard s.spawn(fn[take called, take replying]() fails task::Cancelled uses wait {
                        try await ported(take called, runner, table, out: replying, alloc)
                    })
                }
            }
        }
    })
} answered_up

/// The next message the space sends up the first channel of `link`, after what `pending` holds of
/// it; none once the space frames one it cannot decode or longer than `MOST_BYTES`.
fn next_up(link: Link, mut pending: mem::Bytes, alloc: mem::Alloc) -> Option[Up] fails task::Cancelled uses wait {
    loop {
        match frame_len(pending) {
            Some(len) => {
                if u64.widen(len) > MOST_BYTES {
                    return None
                }
                match frame_off(mut pending, len, alloc) {
                    Some(frame) => return up_of(frame, alloc)
                    None => {}
                }
            }
            None => {}
        }
        let received = match attempt await link.receive(0, alloc) {
            Ok(bytes) => bytes
            Err(LinkError.Cancelled(cancelled)) => fail cancelled
            Err(LinkError.NoChannel) => return None
        }
        mut pending.append(bytes_of(received.view(), alloc).view())
    }
} next_up

/// The message a frame holds, none when it does not decode.
fn up_of(frame: mem::Bytes, alloc: mem::Alloc) -> Option[Up] {
    match attempt mem::wire::Codec[Up].decode(Untrusted.of(frame.view()), alloc) {
        Ok(up) => return Some(take up)
        Err(_) => return None
    }
} up_of

/// Calls through `runner` the port an instance's space calls, its handles those of the entries of
/// the space's `table` it names, and sends `out` the frame of the reply, its handles added to
/// `table`.
fn ported(take called: PortCall, runner: sys::Runner, table: Table, out: task::Sender[mem::Bytes], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let PortCall(id: id, port: port, hash: hash, call: request) = called
    let answer = try await port_answer(port, hash, take request, runner, table, alloc)
    discard attempt await out.send(framed(Down.Ported(PortReply(id: id, answer: take answer)), alloc))
} ported

/// What crosses down of the reply to a call through the port `port` of `runner`.
fn port_answer(port: u64, hash: sys::ProtocolHash, take request: Naming, runner: sys::Runner, table: Table, alloc: mem::Alloc) -> PortAnswer fails task::Cancelled uses wait {
    let Naming(bytes: bytes, handles: handles) = request
    let Some(handed) = table.handed(handles, alloc) else {
        return PortAnswer.Unknown
    }
    let reply = match attempt await runner.call(port, hash, bytes: bytes.view(), handles: handed.view(), alloc) {
        Ok(given) => given
        Err(sys::RunnerError.Cancelled(cancelled)) => fail cancelled
        Err(sys::RunnerError.Revoked(_)) => return PortAnswer.Revoked
        Err(sys::RunnerError.Unknown) => return PortAnswer.Unknown
    }
    let Some(crossing) = table.admitted(reply.handles.view(), alloc) else {
        return PortAnswer.Unknown
    }
    return PortAnswer.Replied(Carrying(bytes: take reply.bytes, handles: take crossing))
} port_answer

/// The answer of what an instance's space gave, a reply's bytes drawn through `alloc` and its
/// handles those of the entries of the space's `table` it names, a reply naming another refused as
/// malformed.
fn answer_of(take sent: Sent, table: Table, alloc: mem::Alloc) -> Answer {
    match sent {
        Sent.Done => return Answer.Done
        Sent.Flag(flag) => return Answer.Flag(flag)
        Sent.Started(count) => return Answer.Started(usize.widen(count))
        Sent.Checkpointed(bytes) => return Answer.Checkpointed(take bytes)
        Sent.Healthy => return Answer.Health(sys::HealthReply.Healthy)
        Sent.Unhealthy(why) => {
            let reason = match attempt text::Fixed[256].try_of(why.as_str()) {
                Ok(fixed) => fixed
                Err(_) => text::Fixed[256].empty()
            }
            return Answer.Health(sys::HealthReply.Unhealthy(reason))
        }
        Sent.Served(Naming(bytes: bytes, handles: handles)) => {
            let Some(handed) = table.handed(handles, alloc) else {
                return Answer.Served(Err(sys::CallError.Malformed(core::DecodeError.Invalid)))
            }
            var reply = sys::Encoded(bytes: mem::Bytes.empty(alloc), handles: take handed)
            mut reply.bytes.append(bytes.view())
            return Answer.Served(Ok(take reply))
        }
        Sent.Refused(Refusal.Malformed(code)) => return Answer.Served(Err(sys::CallError.Malformed(decode_error(code))))
        Sent.Refused(Refusal.Closed) => return Answer.Served(Err(sys::CallError.Closed(task::SendError.Closed)))
    }
} answer_of

/// What a kernel sends the space of an instance it holds: a request of its holder, the end of a
/// wait its holder no longer waits for, a call of an inbox, and that its holder released the
/// instance.
enum Down derives Encode {
    Ask(Asking)
    Stop(u64)
    Call(Calling)
    Release
    Ported(PortReply)
} Down

/// A request of an instance's holder and the number of its wait.
struct Asking derives Encode {
    id: u64
    order: Order
} Asking

/// A stepper operation an instance's holder asks for.
enum Order derives Copy, Encode {
    Step
    Incoming
    Ready
    StartKeyed
    Idle
    Checkpoint
    Resumed(sys::ResumeReason)
    Pressure(u8)
    Health
    Suspend
    Wake
} Order

/// A call of an instance's inbox: the number of its wait, its protocol hash, its bytes and what the
/// space receives of its handles.
struct Calling derives Encode {
    id: u64
    hash: sys::ProtocolHash
    bytes: mem::Bytes
    handles: mem::List[Carried]
} Calling

/// What the space of an instance sends its kernel: an answer of its instance, or a call its
/// instance makes through a port of its runner capability.
enum Up derives Encode {
    Answered(Answering)
    Called(PortCall)
} Up

/// An answer of an instance and the number of the wait it ends.
struct Answering derives Encode {
    id: u64
    answer: Sent
} Answering

/// A call an instance makes through a port: the number of its wait, the port, the protocol hash and
/// the call.
struct PortCall derives Encode {
    id: u64
    port: u64
    hash: sys::ProtocolHash
    call: Naming
} PortCall

/// The reply to a call an instance made through a port, and the number of its wait.
struct PortReply derives Encode {
    id: u64
    answer: PortAnswer
} PortReply

/// The reply to a call through a port as it crosses into a space, or how the call failed.
enum PortAnswer derives Encode {
    Replied(Carrying)
    Unknown
    Revoked
} PortAnswer

/// An encoding a kernel sends a space: its bytes, and what crossed into the space's table for each
/// of its handles.
struct Carrying derives Encode {
    bytes: mem::Bytes
    handles: mem::List[Carried]
} Carrying

/// An answer of an instance as its space sends it.
enum Sent derives Encode {
    Done
    Flag(bool)
    Started(u64)
    Checkpointed(mem::Bytes)
    Healthy
    Unhealthy(text::String)
    Served(Naming)
    Refused(Refusal)
} Sent

/// An encoding a space sends its kernel: its bytes, and the handle of the entry of the space's table
/// for each of its handles.
struct Naming derives Encode {
    bytes: mem::Bytes
    handles: mem::List[u64]
} Naming

/// How a call an instance's space served failed: malformed, with the number `decode_code` gives
/// its decoding failure, or closed.
enum Refusal derives Encode {
    Malformed(u8)
    Closed
} Refusal

/// The frame of the `mem::wire` encoding of a value: the encoding's length as four little-endian
/// bytes, then the encoding.
fn framed[V: Encode](value: V, alloc: mem::Alloc) -> mem::Bytes {
    let body = encoded(value, alloc)
    var frame = mem::Bytes.zeroed(FRAME_HEAD, alloc)
    mut frame.view_mut().write_u32_le(0, value: u32.truncate(body.len()))
    mut frame.append(body.view())
    return frame
} framed

/// The length of the encoding of the first frame `pending` holds, none while it holds less than a
/// frame's head.
fn frame_len(pending: mem::Bytes) -> Option[usize] {
    let Some(head) = pending.view().prefix(FRAME_HEAD) else {
        return None
    }
    return Some(usize.widen(head.u32_le(0)))
} frame_len

/// Takes the encoding of `len` bytes of the first frame `pending` holds off its front, none while
/// it does not hold the whole frame.
fn frame_off(mut pending: mem::Bytes, len: usize, alloc: mem::Alloc) -> Option[mem::Bytes] {
    var body = mem::Bytes.empty(alloc)
    var rest = mem::Bytes.empty(alloc)
    let Some(parts) = pending.view().split_at(FRAME_HEAD + len) else {
        return None
    }
    let Some(head) = parts.head.split_at(FRAME_HEAD) else {
        return None
    }
    mut body.append(head.tail)
    mut rest.append(parts.tail)
    pending = rest
    return Some(take body)
} frame_off

/// The number of a decoding failure, as a refusal sends it.
fn decode_code(error: core::DecodeError) -> u8 {
    match error {
        core::DecodeError.Truncated => return 0
        core::DecodeError.Malformed => return 1
        core::DecodeError.Trailing => return 2
        core::DecodeError.TooDeep => return 3
        core::DecodeError.UnknownKey => return 4
        core::DecodeError.DuplicateKey => return 5
        core::DecodeError.MissingField => return 6
        core::DecodeError.UnknownVariant => return 7
        core::DecodeError.OutOfRange => return 8
        core::DecodeError.InvalidText => return 9
        core::DecodeError.OutOfMemory => return 11
        core::DecodeError.UnknownSchema => return 12
        else => return 10
    }
} decode_code

/// The decoding failure of a number `decode_code` gives, `Invalid` for one it never gives.
fn decode_error(code: u8) -> core::DecodeError {
    match code {
        0 => return core::DecodeError.Truncated
        1 => return core::DecodeError.Malformed
        2 => return core::DecodeError.Trailing
        3 => return core::DecodeError.TooDeep
        4 => return core::DecodeError.UnknownKey
        5 => return core::DecodeError.DuplicateKey
        6 => return core::DecodeError.MissingField
        7 => return core::DecodeError.UnknownVariant
        8 => return core::DecodeError.OutOfRange
        9 => return core::DecodeError.InvalidText
        11 => return core::DecodeError.OutOfMemory
        12 => return core::DecodeError.UnknownSchema
        else => return core::DecodeError.Invalid
    }
} decode_error

/// What the instance task of a space owns: its world, and what it receives from the space's relays.
struct Entered {
    world: World
    launch: Launch
} Entered

/// The ends of an instance's channels that the relays of its space hold: the senders of its
/// holder's requests and of its inboxes' calls, the receiver of its answers and the receiver of the
/// frames to send up.
struct Relaying {
    requests: task::Sender[Asked]
    calls: task::Sender[Called]
    answered: task::Receiver[Routed]
    outgoing: task::Receiver[mem::Bytes]
} Relaying

/// Holds the instance of the component entry `job` in a space for its kernel: runs the instance
/// task in a domain of the space's runtime on `world`, resuming from the checkpoint whose
/// `mem::wire` encoding `input` is and acting through the runner capability of the space's table
/// whose handle is `runner`, while relaying the requests and calls the kernel sends over the
/// channel `port` serves to the instance and its answers and calls through ports back, their
/// handles those the runtime holds through `base` for the entries of the space's table, and gives
/// how the domain ended.
fn served_instance(job: sys::load::Job, port: Port, base: Remote, runner: u64, take world: World, take input: mem::Bytes) -> Result[Ended, sys::Trap] fails task::Cancelled uses wait {
    let alloc = world.alloc
    let exec = world.exec
    let Ok(checkpoint) = attempt mem::wire::Codec[Option[mem::Bytes]].decode(Untrusted.of(input.view()), alloc) else {
        return Ok(Ended.Undecodable)
    }
    let task::Channel(sender: requests, receiver: asked) = task::Channel[Asked].bounded(1, alloc)
    let task::Channel(sender: calls, receiver: called) = task::Channel[Called].bounded(QUEUED_CALLS, alloc)
    let task::Channel(sender: answers, receiver: answered) = task::Channel[Routed].bounded(QUEUED_CALLS, alloc)
    let task::Channel(sender: up, receiver: outgoing) = task::Channel[mem::Bytes].bounded(QUEUED_CALLS, alloc)
    let waits = task::Cown.of(PortWaits(next: 0, waiting: mem::Map[u64, task::Sender[PortAnswer]].empty(alloc)), alloc)
    let forwarders = sys::Minter[Forwarder, Forwarding, u64].of(Forwarding(base: base, up: up.split(), waits: waits.share(), alloc: alloc), alloc)
    defer take forwarders.close()
    let acting = match attempt sys::Runner.served(forwarders.mint(runner)) {
        Ok(served) => served
        Err(_) => sys::Runner.denied()
    }
    let launch = Launch(checkpoint: take checkpoint, runner: acting, requests: take asked, calls: take called, answers: take answers)
    var entered = Some(Entered(world: take world, launch: take launch))
    var relaying = Some(Relaying(requests: take requests, calls: take calls, answered: take answered, outgoing: take outgoing))
    var outcome: Result[Ended, sys::Trap] = Ok(Ended.Cancelled)
    try await task::scope(exec, body: fn[mut entered, mut relaying, mut outcome](s: task::Scope) fails task::Cancelled uses wait {
        let Some(Entered(world: granted, launch: launched)) = mut entered.extract() else {
            return
        }
        let Some(Relaying(requests: down, calls: inbox, answered: answering, outgoing: sending)) = mut relaying.extract() else {
            return
        }
        let replies = waits.share()
        let framing = up.split()
        discard s.spawn(fn[take down, take inbox, take replies]() fails task::Cancelled uses wait {
            try await relayed_in(port, requests: take down, calls: take inbox, base, waits: replies, exec, alloc)
        })
        discard s.spawn(fn[take answering, take framing]() fails task::Cancelled uses wait {
            try await relayed_out(answered: take answering, up: framing, base, alloc)
        })
        discard s.spawn(fn[take sending]() fails task::Cancelled uses wait {
            try await written_up(port, outgoing: take sending)
        })
        outcome = try await sys::Domain.run_sized(fn[take granted, take launched]() -> Ended fails task::Cancelled uses wait limits stack 4_096 {
            return try await call(job, world: take granted, input: take launched)
        }, stack: job.stack() + CALL_STACK, exec, alloc)
        s.cancel()
    })
    return outcome
} served_instance

/// Gives the instance each request and call the kernel sends over `port`, each request through a
/// task of its own so that the end of a wait sent after it is never held up behind it, and each
/// call with the handles the runtime holds through `base` for what the kernel carried into the
/// space's table; ends each wait whose end the kernel sends, gives each reply to a call through a
/// port to its wait in `waits`, and returns once the kernel releases the instance.
fn relayed_in(port: Port, take requests: task::Sender[Asked], take calls: task::Sender[Called], base: Remote, waits: task::Cown[PortWaits], exec: task::Executor, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var buffer = mem::Bytes.zeroed(usize.widen(RING_BYTES), alloc)
    var pending = mem::Bytes.empty(alloc)
    var stops = mem::Map[u64, task::Sender[u8]].empty(alloc)
    try await task::scope(exec, body: fn[mut buffer, mut pending, mut stops](s: task::Scope) fails task::Cancelled uses wait {
        loop {
            let Ok(count) = attempt await port.read_in(mut buffer.view_mut()) else {
                return
            }
            let Some(read) = buffer.view().prefix(count) else {
                return
            }
            mut pending.append(read)
            loop {
                let Some(len) = frame_len(pending) else {
                    break
                }
                let Some(frame) = frame_off(mut pending, len, alloc) else {
                    break
                }
                let Ok(down) = attempt mem::wire::Codec[Down].decode(Untrusted.of(frame.view()), alloc) else {
                    return
                }
                match down {
                    Down.Ask(Asking(id: id, order: order)) => {
                        let request = requested(order, id, mut stops, alloc)
                        let sender = requests.split()
                        discard s.spawn(fn[take request, take sender]() fails task::Cancelled uses wait {
                            discard attempt await sender.send(Asked(id: id, request: take request))
                        })
                    }
                    Down.Stop(id) => {
                        discard mut stops.remove(id)
                    }
                    Down.Call(calling) => {
                        discard attempt await calls.send(called_in(take calling, base, alloc))
                    }
                    Down.Release => return
                    Down.Ported(reply) => try await port_replied(take reply, waits)
                }
            }
        }
    })
} relayed_in

/// Gives the reply to a call through a port to the wait of its number in `waits`.
fn port_replied(take reply: PortReply, waits: task::Cown[PortWaits]) fails task::Cancelled uses wait {
    let PortReply(id: id, answer: answer) = reply
    let waiting = await when mut waits => mut waits.waiting.remove(id)
    let Some(sender) = waiting else {
        return
    }
    discard attempt await sender.send(take answer)
} port_replied

/// The call of an inbox the kernel sends, with the handles the runtime holds through `base` for what
/// the kernel carried into the space's table, a handle it cannot hold left out.
fn called_in(take calling: Calling, base: Remote, alloc: mem::Alloc) -> Called {
    let Calling(id: id, hash: hash, bytes: bytes, handles: crossing) = calling
    var request = sys::Encoded.empty(alloc)
    mut request.bytes.append(bytes.view())
    for crossed in crossing {
        match minted_for(base, crossed) {
            Some(handle) => mut request.handles.push(handle)
            None => {}
        }
    }
    return Called(id: id, hash: hash, request: take request, alloc: alloc)
} called_in

/// The request of an order, a waiting one's with the receiver whose sender `stops` keeps under the
/// number of its wait.
fn requested(order: Order, id: u64, mut stops: mem::Map[u64, task::Sender[u8]], alloc: mem::Alloc) -> Request {
    match order {
        Order.Step => return Request.Step
        Order.Incoming => return Request.Incoming(stopped_by(id, mut stops, alloc))
        Order.Ready => return Request.Ready(stopped_by(id, mut stops, alloc))
        Order.StartKeyed => return Request.StartKeyed
        Order.Idle => return Request.Idle
        Order.Checkpoint => return Request.Checkpoint
        Order.Resumed(reason) => return Request.Resumed(reason)
        Order.Pressure(level) => return Request.Pressure(level)
        Order.Health => return Request.Health
        Order.Suspend => return Request.Suspend
        Order.Wake => return Request.Wake
    }
} requested

/// The receiver of a wait's stop, whose sender `stops` keeps under the number of the wait.
fn stopped_by(id: u64, mut stops: mem::Map[u64, task::Sender[u8]], alloc: mem::Alloc) -> task::Receiver[u8] {
    let task::Channel(sender: sender, receiver: receiver) = task::Channel[u8].bounded(1, alloc)
    discard mut stops.insert(id, value: take sender)
    return receiver
} stopped_by

/// Sends `up` the frame of each answer of the instance, its handles named through `base`, until
/// every sender of `answered` is released.
fn relayed_out(take answered: task::Receiver[Routed], up: task::Sender[mem::Bytes], base: Remote, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var receiver = answered
    loop {
        let Some(Routed.Answered(Replied(id: id, answer: answer))) = try await mut receiver.receive() else {
            return
        }
        let frame = framed(Up.Answered(Answering(id: id, answer: sent_of(take answer, base, alloc))), alloc)
        let Ok(_) = attempt await up.send(take frame) else {
            return
        }
    }
} relayed_out

/// Sends the kernel over `port` each frame `outgoing` carries.
fn written_up(port: Port, take outgoing: task::Receiver[mem::Bytes]) fails task::Cancelled uses wait {
    var receiver = outgoing
    loop {
        let Some(frame) = try await mut receiver.receive() else {
            return
        }
        let Ok(_) = attempt await port.write_out(frame.view()) else {
            return
        }
    }
} written_up

/// The runner capability of an instance's space, its record the handle of the runner capability in
/// the space's table: it acts through the kernel by `invoke`, and calls a port over the link's
/// first channel, so that the space runs on while the call waits.
struct Forwarder {
} Forwarder

impl Forwarder: sys::Kind[Forwarding, u64]

impl Forwarder: sys::RunnerService

/// What the runner capability of an instance's space shares: the remote capability its handles are
/// minted through, the sender of the frames the space sends up, the waits of the calls through
/// ports and the runtime's allocator.
struct Forwarding {
    base: Remote
    up: task::Sender[mem::Bytes]
    waits: task::Cown[PortWaits]
    alloc: mem::Alloc
} Forwarding

/// The calls through ports of an instance's space that wait for their replies: the number of the
/// next, and the sender of each one's reply by its number.
struct PortWaits {
    next: u64
    waiting: mem::Map[u64, task::Sender[PortAnswer]]
} PortWaits

/// What reaching the runner capability of an instance's space gives for an operation by `invoke`.
struct Forward derives Copy {
    base: Remote
    handle: u64
    alloc: mem::Alloc
} Forward

/// What reaching the runner capability of an instance's space gives for a call through a port.
struct Calls {
    base: Remote
    up: task::Sender[mem::Bytes]
    waits: task::Cown[PortWaits]
} Calls

fn forwarded(runner: Forwarder) -> Forward fails sys::RunnerError {
    let Some(forward) = sys::reach(runner, body: fn(state: Forwarding, handle: u64) => Forward(base: state.base, handle: handle, alloc: state.alloc)) else {
        fail sys::RunnerError.Revoked(sys::Revoked.Stale)
    }
    return forward
} forwarded

/// Makes an `invoke` of an operation of the runner capability of the space's table, giving its
/// result written into `result`.
fn acted_through(forward: Forward, operation: u64, args: Slice[u8], mut result: SliceMut[u8]) -> u64 fails sys::RunnerError {
    let given = invoke(forward.handle, operation, args, result: mut result)
    if given == STALE {
        fail sys::RunnerError.Revoked(sys::Revoked.Stale)
    }
    if given >= FAILURES {
        fail sys::RunnerError.Unknown
    }
    return given
} acted_through

/// Makes an `invoke` of an operation of the runner capability of the space's table that gives no
/// bytes.
fn acted(forward: Forward, operation: u64, args: Slice[u8]) fails sys::RunnerError {
    var nothing = Array[u8, 1].filled(0)
    discard try acted_through(forward, operation, args, result: mut nothing.view_mut())
} acted

/// `bytes` and the handles of the space's table for which the runtime minted the capabilities
/// `handles` holds, failing with `RunnerError.Unknown` when it minted none of one.
fn naming(base: Remote, bytes: Slice[u8], handles: Slice[sys::Handle], alloc: mem::Alloc) -> Naming fails sys::RunnerError {
    let Some(named) = handles_named(base, minted: handles, alloc) else {
        fail sys::RunnerError.Unknown
    }
    var copy = mem::Bytes.empty(alloc)
    mut copy.append(bytes)
    return Naming(bytes: take copy, handles: take named)
} naming

fn Forwarder.send_to(self, port: u64, hash: sys::ProtocolHash, bytes: Slice[u8], handles: Slice[sys::Handle]) fails sys::RunnerError limits stack 4_096 {
    let forward = try forwarded(self)
    let sent = try naming(forward.base, bytes, handles, alloc: forward.alloc)
    try acted(forward, operation: RUN_SEND_TO, args: encoded(Sending(port: port, hash: hash, call: take sent), alloc: forward.alloc).view())
} Forwarder.send_to

fn Forwarder.call(self, port: u64, hash: sys::ProtocolHash, bytes: Slice[u8], handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::RunnerError uses wait limits stack 4_096 {
    let Some(calls) = sys::reach(self, body: fn(state: Forwarding, handle: u64) => Calls(base: state.base, up: state.up.split(), waits: state.waits.share())) else {
        fail sys::RunnerError.Revoked(sys::Revoked.Stale)
    }
    let Calls(base: base, up: up, waits: waits) = calls
    let sent = try naming(base, bytes, handles, alloc)
    let task::Channel(sender: answer, receiver: answers) = task::Channel[PortAnswer].bounded(1, alloc)
    var id: u64 = 0
    await when mut waits {
        id = waits.next
        waits.next += 1
        discard mut waits.waiting.insert(id, value: take answer)
    }
    match attempt await up.send(framed(Up.Called(PortCall(id: id, port: port, hash: hash, call: take sent)), alloc)) {
        Ok(_) => {}
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        Err(task::SendError.Closed) => fail sys::RunnerError.Unknown
    }
    var receiver = answers
    let Some(answered) = try await mut receiver.receive() else {
        fail sys::RunnerError.Unknown
    }
    let PortAnswer.Replied(Carrying(bytes: replied, handles: crossing)) = answered else {
        let PortAnswer.Revoked = answered else {
            fail sys::RunnerError.Unknown
        }
        fail sys::RunnerError.Revoked(sys::Revoked.Stale)
    }
    var reply = sys::Encoded.empty(alloc)
    mut reply.bytes.append(replied.view())
    for crossed in crossing {
        let Some(handle) = minted_for(base, crossed) else {
            fail sys::RunnerError.Unknown
        }
        mut reply.handles.push(handle)
    }
    return reply
} Forwarder.call

fn Forwarder.reply(self, request: u64, bytes: Slice[u8], handles: Slice[sys::Handle]) fails sys::RunnerError limits stack 4_096 {
    let forward = try forwarded(self)
    let reply = try naming(forward.base, bytes, handles, alloc: forward.alloc)
    try acted(forward, operation: RUN_REPLY, args: encoded(Replying(request: request, reply: take reply), alloc: forward.alloc).view())
} Forwarder.reply

fn Forwarder.publish(self, summary: Slice[u8]) fails sys::RunnerError limits stack 4_096 {
    let forward = try forwarded(self)
    var bytes = mem::Bytes.empty(forward.alloc)
    mut bytes.append(summary)
    try acted(forward, operation: RUN_PUBLISH, args: encoded(bytes, alloc: forward.alloc).view())
} Forwarder.publish

fn Forwarder.sync(self) fails sys::RunnerError limits stack 4_096 {
    try acted(try forwarded(self), operation: RUN_SYNC, args: b"")
} Forwarder.sync

fn Forwarder.capability(self, id: u64) -> sys::Handle fails sys::RunnerError limits stack 4_096 {
    let forward = try forwarded(self)
    var result = Array[u8, CARRIED_BYTES].filled(0)
    let count = try acted_through(forward, operation: RUN_CAPABILITY, args: encoded(id, alloc: forward.alloc).view(), result: mut result.view_mut())
    let Some(bytes) = result.view().prefix(usize.widen(count)) else {
        fail sys::RunnerError.Unknown
    }
    let Ok(crossed) = attempt mem::wire::Codec[Carried].decode(Untrusted.of(take bytes), alloc: forward.alloc) else {
        fail sys::RunnerError.Unknown
    }
    let Some(handle) = minted_for(forward.base, crossed) else {
        fail sys::RunnerError.Unknown
    }
    return handle
} Forwarder.capability

fn Forwarder.drop_capability(self, id: u64) fails sys::RunnerError limits stack 4_096 {
    let forward = try forwarded(self)
    try acted(forward, operation: RUN_DROP, args: encoded(id, alloc: forward.alloc).view())
} Forwarder.drop_capability

/// What a space sends its kernel of an answer of its instance, a reply's handles named through
/// `base`; a reply carrying a handle the runtime minted for no entry of the space's table is refused
/// as malformed.
fn sent_of(take answer: Answer, base: Remote, alloc: mem::Alloc) -> Sent {
    match answer {
        Answer.Done => return Sent.Done
        Answer.Flag(flag) => return Sent.Flag(flag)
        Answer.Started(count) => return Sent.Started(u64.widen(count))
        Answer.Checkpointed(bytes) => return Sent.Checkpointed(take bytes)
        Answer.Health(sys::HealthReply.Healthy) => return Sent.Healthy
        Answer.Health(sys::HealthReply.Unhealthy(why)) => return Sent.Unhealthy(text::String.of(why.as_str(), alloc))
        Answer.Served(Ok(reply)) => {
            let Some(handles) = handles_named(base, minted: reply.handles.view(), alloc) else {
                return Sent.Refused(Refusal.Malformed(decode_code(core::DecodeError.Invalid)))
            }
            return Sent.Served(Naming(bytes: take reply.bytes, handles: take handles))
        }
        Answer.Served(Err(failure)) => {
            let sys::CallError.Malformed(error) = failure else {
                return Sent.Refused(Refusal.Closed)
            }
            return Sent.Refused(Refusal.Malformed(decode_code(error)))
        }
    }
} sent_of
