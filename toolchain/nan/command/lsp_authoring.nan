//! The language server's authoring help: completions, signature help, inlay hints and semantic tokens.

/// The semantic token types, separated by spaces, by the index a token's type is written with.
const TOKEN_TYPES: Str = "namespace type struct enum interface parameter variable property enumMember function method keyword comment string number"

/// The semantic token modifiers, separated by spaces, by the bit a token's modifiers set.
const TOKEN_MODIFIERS: Str = "declaration readonly"

/// The legend of the semantic tokens, which the server gives for whole documents.
fn semantic_tokens_options(alloc: mem::Alloc) -> Json {
    var legend = mem::List[Member].empty(alloc)
    mut legend.push(Member.of("tokenTypes", value: texts_array(TOKEN_TYPES, alloc), alloc))
    mut legend.push(Member.of("tokenModifiers", value: texts_array(TOKEN_MODIFIERS, alloc), alloc))
    var members = mem::List[Member].empty(alloc)
    mut members.push(Member.of("legend", value: Json.Object(take legend), alloc))
    mut members.push(Member.of("full", value: Json.Bool(true), alloc))
    return Json.Object(take members)
} semantic_tokens_options

/// The completion item kind of what a completion offers.
fn completion_kind(offered: check::Offered) -> u64 {
    return match offered {
        check::Offered.Method => 2
        check::Offered.Function => 3
        check::Offered.Field => 5
        check::Offered.Local => 6
        check::Offered.Interface => 8
        check::Offered.Module => 9
        check::Offered.Enum => 13
        check::Offered.Keyword => 14
        check::Offered.Variant => 20
        check::Offered.Const => 21
        check::Offered.Struct => 22
    }
} completion_kind

/// `textDocument/completion`: the names that may follow the position, the identifier ending
/// there written in part.
fn Server.completion(self, params: Json, alloc: mem::Alloc) -> Option[Json] {
    let Some(asked) = self.positioned(params, alloc) else {
        return None
    }
    var items = mem::List[Json].empty(alloc)
    for completion in take asked.opened.session.completions(asked.opened.path.as_str(), at: asked.at) {
        var members = mem::List[Member].empty(alloc)
        mut members.push(Member.of("label", value: Json.Text(take completion.label), alloc))
        mut members.push(Member.of("kind", value: Json.number(completion_kind(completion.offered), alloc), alloc))
        if not completion.detail.is_empty() {
            mut members.push(Member.of("detail", value: Json.Text(take completion.detail), alloc))
        }
        mut items.push(Json.Object(take members))
    }
    var listed = mem::List[Member].empty(alloc)
    mut listed.push(Member.of("isIncomplete", value: Json.Bool(false), alloc))
    mut listed.push(Member.of("items", value: Json.Array(take items), alloc))
    return Some(Json.Object(take listed))
} Server.completion

/// `textDocument/signatureHelp`: the head of the function the call being written at the
/// position calls, with the parameter its argument there takes.
fn Server.signature_help(self, params: Json, alloc: mem::Alloc) -> Option[Json] {
    let Some(asked) = self.positioned(params, alloc) else {
        return None
    }
    let Some(signature) = asked.opened.session.signature(asked.opened.path.as_str(), at: asked.at) else {
        return Some(Json.Null)
    }
    var parameters = mem::List[Json].empty(alloc)
    for parameter in signature.parameters {
        var members = mem::List[Member].empty(alloc)
        mut members.push(Member.of("label", value: Json.text(parameter.as_str(), alloc), alloc))
        mut parameters.push(Json.Object(take members))
    }
    var written = mem::List[Member].empty(alloc)
    mut written.push(Member.of("label", value: Json.Text(take signature.label), alloc))
    mut written.push(Member.of("parameters", value: Json.Array(take parameters), alloc))
    var signatures = mem::List[Json].empty(alloc)
    mut signatures.push(Json.Object(take written))
    var members = mem::List[Member].empty(alloc)
    mut members.push(Member.of("signatures", value: Json.Array(take signatures), alloc))
    mut members.push(Member.of("activeSignature", value: Json.number(0, alloc), alloc))
    mut members.push(Member.of("activeParameter", value: Json.number(u64.widen(signature.active), alloc), alloc))
    return Some(Json.Object(take members))
} Server.signature_help

/// `textDocument/inlayHint`: the type of each binding of the range written without one, after
/// its name.
fn Server.inlay_hints(self, params: Json, alloc: mem::Alloc) -> Option[Json] {
    let Some(opened) = self.document(params, alloc) else {
        return None
    }
    let Some(source) = opened.session.workspace.contents().bytes(opened.path.as_str()) else {
        return None
    }
    let Some(range) = params.get("range") else {
        return None
    }
    let Some(start) = position_offset(source, range, name: "start", encoding: self.encoding) else {
        return None
    }
    let Some(end) = position_offset(source, range, name: "end", encoding: self.encoding) else {
        return None
    }
    var hints = mem::List[Json].empty(alloc)
    for hint in opened.session.type_hints(opened.path.as_str(), start, end) {
        var label = text::String.of(": ", alloc)
        mut label.append(hint.shown.as_str())
        var members = mem::List[Member].empty(alloc)
        mut members.push(Member.of("position", value: position_json(source, at: hint.at, encoding: self.encoding, alloc), alloc))
        mut members.push(Member.of("label", value: Json.Text(take label), alloc))
        mut members.push(Member.of("kind", value: Json.number(1, alloc), alloc))
        mut hints.push(Json.Object(take members))
    }
    return Some(Json.Array(take hints))
} Server.inlay_hints

/// The index of a class among the token types.
fn token_type(class: check::NameClass) -> u64 {
    return match class {
        check::NameClass.Namespace => 0
        check::NameClass.Type => 1
        check::NameClass.Struct => 2
        check::NameClass.Enum => 3
        check::NameClass.Interface => 4
        check::NameClass.Parameter => 5
        check::NameClass.Variable => 6
        check::NameClass.Property => 7
        check::NameClass.EnumMember => 8
        check::NameClass.Function => 9
        check::NameClass.Method => 10
        check::NameClass.Keyword => 11
        check::NameClass.Comment => 12
        check::NameClass.Text => 13
        check::NameClass.Number => 14
    }
} token_type

/// `textDocument/semanticTokens/full`: the document's classed names, keywords, literals and
/// comments, each relative to the one before it.
fn Server.semantic_tokens(self, params: Json, alloc: mem::Alloc) -> Option[Json] {
    let Some(opened) = self.document(params, alloc) else {
        return None
    }
    let Some(source) = opened.session.workspace.contents().bytes(opened.path.as_str()) else {
        return None
    }
    var data = mem::List[Json].empty(alloc)
    var line: u32 = 0
    var character: u32 = 0
    for classed in opened.session.classes(opened.path.as_str()) {
        let starting = line_character(source, at: classed.start, encoding: self.encoding)
        let ending = line_character(source, at: classed.end, encoding: self.encoding)
        var relative = starting.character
        if starting.line == line {
            relative = starting.character.saturating_sub(character)
        }
        var modifiers: u64 = 0
        if classed.declaration {
            modifiers = 1
        }
        if classed.readonly {
            modifiers = modifiers | 2
        }
        mut data.push(Json.number(u64.widen(starting.line.saturating_sub(line)), alloc))
        mut data.push(Json.number(u64.widen(relative), alloc))
        mut data.push(Json.number(u64.widen(ending.character.saturating_sub(starting.character)), alloc))
        mut data.push(Json.number(token_type(classed.class), alloc))
        mut data.push(Json.number(modifiers, alloc))
        line = starting.line
        character = starting.character
    }
    var members = mem::List[Member].empty(alloc)
    mut members.push(Member.of("data", value: Json.Array(take data), alloc))
    return Some(Json.Object(take members))
} Server.semantic_tokens
