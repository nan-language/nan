//! The out-of-line compiler stubs of the machine targets: fixed machine code each image emits once for the operations Cranelift cannot express, in the bytes of its architecture.

/// The compiler stubs. Each takes its integer arguments and gives its integer result in the
/// registers its architecture's convention names, and returns, but `Halt`, which stops the
/// processor with maskable interrupts disabled, and `EnterImage`. A port stub, on x86_64 alone, takes the port
/// and, for `Out`, the value; a memory-mapped stub takes the address and, for a write, the
/// value; `Copy` and `Fill` take the target, the source or byte, and the length, a copy between
/// overlapping ranges running backwards when its target lies above its source. `Thread` reads
/// the first word of the running CPU's record, which the GS base addresses on x86_64 and
/// `TPIDR_EL1` on AArch64; `SetCpu` points that register at a record. `Cli` and `Sti` disable
/// and enable maskable interrupts; `IrqSave` gives their state and disables them, `IrqRestore`
/// restores it. `IdleWait` halts until an interrupt with maskable interrupts enabled.
/// `DisableFloats` makes every floating-point, SSE and SIMD instruction of the running CPU
/// fault, setting `CR0.TS` on x86_64 and clearing `CPACR_EL1.FPEN` on AArch64.
///
/// The x86_64 stubs are `Lidt`, which loads an interrupt descriptor table; `Wrmsr` and `Rdmsr`,
/// which write and read a model-specific register; `ReadCr2`, `ReadCr3` and `WriteCr3`, the
/// control registers; `Invlpg`; `LoadTables`, which loads a CPU's descriptor tables through
/// their pseudo-descriptor; `EnableAvx`, which enables XSAVE and the x87, SSE and AVX state
/// components where the CPU has AVX; `GigabytePages`, which gives 1 when the CPU maps
/// 1 GiB pages and 0 otherwise; and `ReadTsc`, which reads the time-stamp counter once every
/// earlier instruction has completed. `ConstantTime` sets the running CPU's data-independent
/// timing mode when it has one: on x86_64 DOITM, when `IA32_ARCH_CAPABILITIES` enumerates it,
/// and on AArch64 `PSTATE.DIT`, when `ID_AA64PFR0_EL1` does. `CpuFeatures` records in the
/// running CPU's record the features the other x86_64 stubs read, and makes the CPU's index,
/// which it takes, its `TSC_AUX`. `Cpuid` writes the four registers a leaf and subleaf give at an address;
/// `Rdtscp` gives the counter and writes the CPU's index at an address, reading both with
/// maskable interrupts disabled where the CPU lacks `rdtscp`; `Rdrand` and `Rdseed` write a
/// value at an address and give 1, or give 0 when the CPU lacks the instruction or it keeps
/// failing; `MonitorWait` takes a word's address, the value seen there and a hint, and waits
/// until the word may have changed or an interrupt arrives, returning at once where the CPU
/// lacks `monitor` and `mwait` with interrupts breaking the wait; `FlushAll` drops every cached
/// translation; `Invpcid` takes an `invpcid` kind, a PCID and a page, dropping every cached
/// translation instead where the CPU lacks the instruction or has PCIDs disabled; `Shootdown`
/// drops a page's cached translations, or every one for a scope of 1 or with PCIDs enabled;
/// `Cr3Tag` gives the bits a PCID and the no-flush flag add to a root, none with PCIDs
/// disabled; `ReadXcr0` gives `XCR0`, 0 without XSAVE enabled, and `Xgetbv` gives it at any
/// privilege, 0 where CPUID reports XSAVE disabled; `WriteXcr0` writes it and gives
/// 1, or gives 0 for a value `xsetbv` would fault on; `EnableProtection` sets the
/// control-register bit of the `hw::Protection` variant at an index and gives 1, or
/// gives 0 where the CPU lacks it; `ClearBuffers` runs `verw`; and `UserOpen` and `UserClose`
/// allow and forbid access to user pages where SMAP is enabled. The AArch64 stubs are
/// `ReadSysReg` and `WriteSysReg`, each naming a system register by its 15-bit encoding, which
/// the instruction holds; `ReadTtbr0` and `WriteTtbr0`, the low translation-table base
/// register, and `WriteTtbr0Tagged`, which writes it without invalidating; `TlbiPage`, which
/// invalidates a page's translations under the current ASID, `TlbiAsid` and `TlbiAsidPage`,
/// which invalidate those of an ASID, `TlbiAll`, every one of the running CPU, and
/// `TlbiBroadcast`, every CPU's translations of a page under every ASID, or all of them for a
/// scope of 1; `CleanCache`, `CleanInvalidateCache` and `InvalidateCache`, which maintain the
/// data cache lines holding a range given by its address and length, and `SyncInstructions`,
/// which makes the instruction cache see the range's data; `WaitEvent`, which takes a word's
/// address and the value seen there and waits for an event unless the word differs;
/// `SendSignal`, which sends software-generated interrupt 1 to the CPU of an affinity;
/// `EnterRoot`, which installs the entry root with the
/// memory attributes and translation control the entry seams program; `EnterImage`, which masks
/// every exception, turns the MMU and caches off, drops the instruction cache and translations
/// and branches to its third argument, keeping its first two in `x0` and `x1`; `InterruptStack`, which
/// makes a stack top the one exceptions switch to and leaves the caller on its stack through
/// `SP_EL0`; `Switch`, the task-stack switch, and `MachineSwitch`, which keeps the general
/// registers alone, the floating-point ones holding nothing on a machine target; `SemiExit`,
/// the exit port; `Hvc`, which makes a PSCI call through the hypervisor conduit, taking the
/// function identifier and three arguments and giving the result; and `FiqOn` and `FiqOff`, which unmask and mask fast interrupts,
/// through which a halting CPU stops the others.
enum Stub derives Copy, Eq, Hash {
    Out1
    Out2
    Out4
    In1
    In2
    In4
    MmioRead1
    MmioRead2
    MmioRead4
    MmioRead8
    MmioWrite1
    MmioWrite2
    MmioWrite4
    MmioWrite8
    Fill
    Copy
    Pause
    Mfence
    IdleWait
    Lidt
    Sti
    Cli
    IrqSave
    IrqRestore
    Thread
    Wrmsr
    Rdmsr
    ReadCr2
    ReadCr3
    WriteCr3
    Invlpg
    LoadTables
    EnableAvx
    GigabytePages
    ReadTsc
    ConstantTime
    CpuFeatures
    Cpuid
    Rdtscp
    Rdrand
    Rdseed
    MonitorWait
    FlushAll
    Invpcid
    Shootdown
    Cr3Tag
    ReadXcr0
    Xgetbv
    WriteXcr0
    EnableProtection
    ClearBuffers
    UserOpen
    UserClose
    Halt
    DisableFloats
    SetCpu
    ReadSysReg(u16)
    WriteSysReg(u16)
    ReadTtbr0
    WriteTtbr0
    WriteTtbr0Tagged
    TlbiPage
    TlbiAsid
    TlbiAsidPage
    TlbiAll
    TlbiBroadcast
    CleanCache
    CleanInvalidateCache
    InvalidateCache
    SyncInstructions
    WaitEvent
    SendSignal
    EnterRoot
    EnterImage
    InterruptStack
    Switch
    MachineSwitch
    SemiExit
    Hvc
    FiqOn
    FiqOff
} Stub

// The x86_64 stubs read the running CPU's features and its executor thread's index at these
// offsets of its record and of the thread's.
const assert CPU_FEATURES == 0xf8 and CPU_THREAD == 0 and THREAD_INDEX == 0x28

/// A compiler stub's code: the words it takes and gives, and its machine code.
view struct StubCode {
    params: usize
    returns: usize
    bytes: Slice[u8]
} StubCode

/// The words the stub takes and gives, and its machine code in the architecture's instruction
/// set. `ReadSysReg` and `WriteSysReg`, whose code the running CPU's register field builds, are
/// emitted by `call_stub` instead and never reach here.
proj fn Stub.code(self, arch: workspace::Arch) -> StubCode {
    return match arch {
        workspace::Arch.Amd64 => self.x64_code()
        workspace::Arch.Aarch64 => self.aarch64_code()
    }
} Stub.code

/// The x86_64 machine code of a stub, taking its arguments in `rdi`, `rsi` and `rdx` and giving
/// its result in `rax`.
proj fn Stub.x64_code(self) -> StubCode {
    return match self {
        Stub.Out1 => StubCode(params: 2, returns: 0, bytes: b"\x89\xfa\x89\xf0\xee\xc3")
        Stub.Out2 => StubCode(params: 2, returns: 0, bytes: b"\x89\xfa\x89\xf0\x66\xef\xc3")
        Stub.Out4 => StubCode(params: 2, returns: 0, bytes: b"\x89\xfa\x89\xf0\xef\xc3")
        Stub.In1 => StubCode(params: 1, returns: 1, bytes: b"\x89\xfa\x31\xc0\xec\xc3")
        Stub.In2 => StubCode(params: 1, returns: 1, bytes: b"\x89\xfa\x31\xc0\x66\xed\xc3")
        Stub.In4 => StubCode(params: 1, returns: 1, bytes: b"\x89\xfa\xed\xc3")
        Stub.MmioRead1 => StubCode(params: 1, returns: 1, bytes: b"\x0f\xb6\x07\xc3")
        Stub.MmioRead2 => StubCode(params: 1, returns: 1, bytes: b"\x0f\xb7\x07\xc3")
        Stub.MmioRead4 => StubCode(params: 1, returns: 1, bytes: b"\x8b\x07\xc3")
        Stub.MmioRead8 => StubCode(params: 1, returns: 1, bytes: b"\x48\x8b\x07\xc3")
        Stub.MmioWrite1 => StubCode(params: 2, returns: 0, bytes: b"\x40\x88\x37\xc3")
        Stub.MmioWrite2 => StubCode(params: 2, returns: 0, bytes: b"\x66\x89\x37\xc3")
        Stub.MmioWrite4 => StubCode(params: 2, returns: 0, bytes: b"\x89\x37\xc3")
        Stub.MmioWrite8 => StubCode(params: 2, returns: 0, bytes: b"\x48\x89\x37\xc3")
        Stub.Fill => StubCode(params: 3, returns: 0, bytes: b"\x48\x89\xd1\x89\xf0\xf3\xaa\xc3")
        Stub.Copy => StubCode(params: 3, returns: 0, bytes: b"\x48\x89\xd1\x48\x39\xf7\x76\x18\x48\x8d\x04\x16\x48\x39\xc7\x73\x0f\x48\x8d\x74\x16\xff\x48\x8d\x7c\x17\xff\xfd\xf3\xa4\xfc\xc3\xf3\xa4\xc3")
        Stub.Pause => StubCode(params: 0, returns: 0, bytes: b"\xf3\x90\xc3")
        Stub.Mfence => StubCode(params: 0, returns: 0, bytes: b"\x0f\xae\xf0\xc3")
        Stub.IdleWait => StubCode(params: 0, returns: 0, bytes: b"\xfb\xf4\xfa\xc3")
        Stub.Lidt => StubCode(params: 1, returns: 0, bytes: b"\x0f\x01\x1f\xc3")
        Stub.Sti => StubCode(params: 0, returns: 0, bytes: b"\xfb\xc3")
        Stub.Cli => StubCode(params: 0, returns: 0, bytes: b"\xfa\xc3")
        Stub.IrqSave => StubCode(params: 0, returns: 1, bytes: b"\x9c\x58\xfa\xc3")
        Stub.IrqRestore => StubCode(params: 1, returns: 0, bytes: b"\xf7\xc7\x00\x02\x00\x00\x74\x01\xfb\xc3")
        Stub.Thread => StubCode(params: 0, returns: 1, bytes: b"\x65\x48\x8b\x04\x25\x00\x00\x00\x00\xc3")
        Stub.Wrmsr => StubCode(params: 2, returns: 0, bytes: b"\x89\xf9\x48\x89\xf0\x48\x89\xf2\x48\xc1\xea\x20\x0f\x30\xc3")
        Stub.Rdmsr => StubCode(params: 1, returns: 1, bytes: b"\x89\xf9\x0f\x32\x48\xc1\xe2\x20\x48\x09\xd0\xc3")
        Stub.ReadCr2 => StubCode(params: 0, returns: 1, bytes: b"\x0f\x20\xd0\xc3")
        Stub.ReadCr3 => StubCode(params: 0, returns: 1, bytes: b"\x0f\x20\xd8\xc3")
        Stub.WriteCr3 => StubCode(params: 1, returns: 0, bytes: b"\x0f\x22\xdf\xc3")
        Stub.Invlpg => StubCode(params: 1, returns: 0, bytes: b"\x0f\x01\x3f\xc3")
        Stub.LoadTables => StubCode(params: 1, returns: 0, bytes: b"\x0f\x01\x17\x6a\x08\x48\x8d\x05\x03\x00\x00\x00\x50\x48\xcb\xb8\x10\x00\x00\x00\x8e\xd8\x8e\xc0\x8e\xd0\xb8\x28\x00\x00\x00\x0f\x00\xd8\xc3")
        Stub.EnableAvx => StubCode(params: 0, returns: 0, bytes: b"\x53\xb8\x01\x00\x00\x00\x0f\xa2\x5b\x81\xe1\x00\x00\x00\x14\x81\xf9\x00\x00\x00\x14\x75\x17\x0f\x20\xe0\x48\x0d\x00\x00\x04\x00\x0f\x22\xe0\x31\xc9\x0f\x01\xd0\x83\xc8\x07\x0f\x01\xd1\xc3")
        Stub.GigabytePages => StubCode(params: 0, returns: 1, bytes: b"\x53\xb8\x00\x00\x00\x80\x0f\xa2\x3d\x01\x00\x00\x80\x72\x11\xb8\x01\x00\x00\x80\x0f\xa2\x89\xd0\xc1\xe8\x1a\x83\xe0\x01\x5b\xc3\x31\xc0\x5b\xc3")
        Stub.ReadTsc => StubCode(params: 0, returns: 1, bytes: b"\x0f\xae\xe8\x0f\x31\x48\xc1\xe2\x20\x48\x09\xd0\xc3")
        Stub.ConstantTime => StubCode(params: 0, returns: 0, bytes: b"\x53\x31\xc0\x0f\xa2\x83\xf8\x07\x72\x28\xb8\x07\x00\x00\x00\x31\xc9\x0f\xa2\x0f\xba\xe2\x1d\x73\x19\xb9\x0a\x01\x00\x00\x0f\x32\x0f\xba\xe0\x0c\x73\x0c\xb9\x01\x1b\x00\x00\x0f\x32\x83\xc8\x01\x0f\x30\x5b\xc3")
        Stub.CpuFeatures => StubCode(params: 1, returns: 0, bytes: b"\x53\x49\x89\xfa\x45\x31\xc0\x31\xc0\x0f\xa2\x41\x89\xc1\xb8\x01\x00\x00\x00\x31\xc9\x0f\xa2\x0f\xba\xe1\x1e\x73\x04\x41\x83\xc8\x04\x0f\xba\xe1\x11\x73\x04\x41\x83\xc8\x20\x0f\xba\xe1\x03\x73\x1b\x41\x83\xf9\x05\x72\x15\xb8\x05\x00\x00\x00\x31\xc9\x0f\xa2\x83\xe1\x03\x83\xf9\x03\x75\x04\x41\x83\xc8\x10\x41\x83\xf9\x07\x72\x41\xb8\x07\x00\x00\x00\x31\xc9\x0f\xa2\x0f\xba\xe3\x0a\x73\x04\x41\x83\xc8\x02\x0f\xba\xe3\x12\x73\x04\x41\x83\xc8\x08\x0f\xba\xe3\x07\x73\x04\x41\x83\xc8\x40\x0f\xba\xe3\x14\x73\x07\x41\x81\xc8\x80\x00\x00\x00\x0f\xba\xe1\x02\x73\x07\x41\x81\xc8\x00\x01\x00\x00\xb8\x00\x00\x00\x80\x31\xc9\x0f\xa2\x3d\x01\x00\x00\x80\x72\x1f\xb8\x01\x00\x00\x80\x31\xc9\x0f\xa2\x0f\xba\xe2\x1b\x73\x10\x41\x83\xc8\x01\xb9\x03\x01\x00\xc0\x44\x89\xd0\x31\xd2\x0f\x30\x65\x4c\x89\x04\x25\xf8\x00\x00\x00\x5b\xc3")
        Stub.Cpuid => StubCode(params: 3, returns: 0, bytes: b"\x53\x49\x89\xd0\x89\xf8\x89\xf1\x0f\xa2\x41\x89\x00\x41\x89\x58\x04\x41\x89\x48\x08\x41\x89\x50\x0c\x5b\xc3")
        Stub.Rdtscp => StubCode(params: 1, returns: 1, bytes: b"\x65\xf6\x04\x25\xf8\x00\x00\x00\x01\x74\x0d\x0f\x01\xf9\x48\xc1\xe2\x20\x48\x09\xd0\x89\x0f\xc3\x9c\xfa\x0f\xae\xe8\x0f\x31\x48\xc1\xe2\x20\x48\x09\xd0\x65\x48\x8b\x0c\x25\x00\x00\x00\x00\x8b\x49\x28\x89\x0f\x9d\xc3")
        Stub.Rdrand => StubCode(params: 1, returns: 1, bytes: b"\x65\xf6\x04\x25\xf8\x00\x00\x00\x04\x74\x0f\xb9\x0a\x00\x00\x00\x48\x0f\xc7\xf0\x72\x07\xff\xc9\x75\xf6\x31\xc0\xc3\x48\x89\x07\xb8\x01\x00\x00\x00\xc3")
        Stub.Rdseed => StubCode(params: 1, returns: 1, bytes: b"\x65\xf6\x04\x25\xf8\x00\x00\x00\x08\x74\x11\xb9\x0a\x00\x00\x00\x48\x0f\xc7\xf8\x72\x09\xf3\x90\xff\xc9\x75\xf4\x31\xc0\xc3\x48\x89\x07\xb8\x01\x00\x00\x00\xc3")
        Stub.MonitorWait => StubCode(params: 3, returns: 0, bytes: b"\x65\xf6\x04\x25\xf8\x00\x00\x00\x10\x74\x1f\x49\x89\xd0\x48\x89\xf8\x31\xc9\x31\xd2\x0f\x01\xc8\x48\x39\x37\x75\x0c\x41\x0f\xb6\xc0\xb9\x01\x00\x00\x00\x0f\x01\xc9\xc3\xf3\x90\xc3")
        Stub.FlushAll => StubCode(params: 0, returns: 0, bytes: b"\x0f\x20\xe0\x48\x89\xc1\x48\x81\xf1\x80\x00\x00\x00\x0f\x22\xe1\x0f\x22\xe0\xc3")
        Stub.Invpcid => StubCode(params: 3, returns: 0, bytes: b"\x65\xf6\x04\x25\xf8\x00\x00\x00\x02\x74\x31\x0f\x20\xe0\x0f\xba\xe0\x11\x73\x28\x48\x89\xd0\x48\xc1\xe0\x10\x48\xc1\xf8\x10\x48\x39\xd0\x75\x17\x48\x83\xec\x10\x48\x89\x34\x24\x48\x89\x54\x24\x08\x66\x0f\x38\x82\x3c\x24\x48\x83\xc4\x10\xc3\x0f\x20\xe0\x48\x89\xc1\x48\x81\xf1\x80\x00\x00\x00\x0f\x22\xe1\x0f\x22\xe0\xc3")
        Stub.Shootdown => StubCode(params: 1, returns: 0, bytes: b"\x48\x83\xff\x01\x74\x0d\x0f\x20\xe0\x0f\xba\xe0\x11\x72\x04\x0f\x01\x3f\xc3\x0f\x20\xe0\x48\x89\xc1\x48\x81\xf1\x80\x00\x00\x00\x0f\x22\xe1\x0f\x22\xe0\xc3")
        Stub.Cr3Tag => StubCode(params: 2, returns: 1, bytes: b"\x0f\x20\xe0\x0f\xba\xe0\x11\x73\x0b\x48\x89\xf8\x48\xc1\xe6\x3f\x48\x09\xf0\xc3\x31\xc0\xc3")
        Stub.ReadXcr0 => StubCode(params: 0, returns: 1, bytes: b"\x0f\x20\xe0\x0f\xba\xe0\x12\x73\x0d\x31\xc9\x0f\x01\xd0\x48\xc1\xe2\x20\x48\x09\xd0\xc3\x31\xc0\xc3")
        Stub.Xgetbv => StubCode(params: 0, returns: 1, bytes: b"\x53\xb8\x01\x00\x00\x00\x31\xc9\x0f\xa2\x5b\x0f\xba\xe1\x1b\x73\x0d\x31\xc9\x0f\x01\xd0\x48\xc1\xe2\x20\x48\x09\xd0\xc3\x31\xc0\xc3")
        Stub.WriteXcr0 => StubCode(params: 1, returns: 1, bytes: b"\x0f\x20\xe0\x0f\xba\xe0\x12\x73\x70\x40\xf6\xc7\x01\x74\x6a\x89\xf8\x83\xe0\x06\x83\xf8\x04\x74\x60\x89\xf8\x25\xe0\x00\x00\x00\x74\x0d\x3d\xe0\x00\x00\x00\x75\x50\x40\xf6\xc7\x04\x74\x4a\x89\xf8\x83\xe0\x18\x74\x05\x83\xf8\x18\x75\x3e\x89\xf8\x25\x00\x00\x06\x00\x74\x07\x3d\x00\x00\x06\x00\x75\x2e\x53\xb8\x0d\x00\x00\x00\x31\xc9\x0f\xa2\x5b\x48\xc1\xe2\x20\x48\x09\xd0\x48\xf7\xd0\x48\x85\xf8\x75\x14\x89\xf8\x48\x89\xfa\x48\xc1\xea\x20\x31\xc9\x0f\x01\xd1\xb8\x01\x00\x00\x00\xc3\x31\xc0\xc3")
        Stub.EnableProtection => StubCode(params: 1, returns: 1, bytes: b"\x48\x8d\x0d\x35\x00\x00\x00\x8b\x14\xf9\x8b\x74\xf9\x04\x65\x85\x14\x25\xf8\x00\x00\x00\x74\x21\x81\xfe\x00\x00\x02\x00\x75\x0a\x0f\x20\xd8\xa9\xff\x0f\x00\x00\x75\x0f\x0f\x20\xe0\x48\x09\xf0\x0f\x22\xe0\xb8\x01\x00\x00\x00\xc3\x31\xc0\xc3\x40\x00\x00\x00\x00\x00\x10\x00\x80\x00\x00\x00\x00\x00\x20\x00\x00\x01\x00\x00\x00\x08\x00\x00\x20\x00\x00\x00\x00\x00\x02\x00")
        Stub.ClearBuffers => StubCode(params: 0, returns: 0, bytes: b"\x6a\x10\x0f\x00\x2c\x24\x48\x83\xc4\x08\xc3")
        Stub.UserOpen => StubCode(params: 0, returns: 0, bytes: b"\x0f\x20\xe0\x0f\xba\xe0\x15\x73\x03\x0f\x01\xcb\xc3")
        Stub.UserClose => StubCode(params: 0, returns: 0, bytes: b"\x0f\x20\xe0\x0f\xba\xe0\x15\x73\x03\x0f\x01\xca\xc3")
        Stub.Halt => StubCode(params: 0, returns: 0, bytes: b"\xfa\xf4\xeb\xfd")
        Stub.DisableFloats => StubCode(params: 0, returns: 0, bytes: b"\x0f\x20\xc0\x48\x83\xc8\x08\x0f\x22\xc0\xc3")
        else => {
            expect false
            return StubCode(params: 0, returns: 0, bytes: b"")
        }
    }
} Stub.x64_code

/// The AArch64 machine code of a stub, taking its arguments in `x0`, `x1` and `x2` and giving
/// its result in `x0`.
proj fn Stub.aarch64_code(self) -> StubCode {
    return match self {
        Stub.MmioRead1 => StubCode(params: 1, returns: 1, bytes: b"\xbf\x33\x03\xd5\x00\x00\x40\x39\xbf\x33\x03\xd5\xc0\x03\x5f\xd6")
