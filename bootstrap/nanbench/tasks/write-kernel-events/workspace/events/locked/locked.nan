//! The log behind a spin lock, reached with interrupts disabled.

/// Records `event` in the log.
pub fn record_event(log: hw::SpinLock[events::Log], event: events::Event) {
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap {
        log.with(t, body: fn(mut held: events::Log) limits notrap, terminates, noalloc {
            mut held.record(event)
        })
    })
} record_event

/// Takes the oldest event from the log.
pub fn next_event(log: hw::SpinLock[events::Log]) -> Option[events::Event] {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> Option[events::Event] limits notrap {
        return log.with(t, body: fn(mut held: events::Log) -> Option[events::Event] limits notrap, terminates, noalloc {
            return mut held.next()
        })
    })
} next_event

/// The events the log dropped so far.
pub fn dropped_events(log: hw::SpinLock[events::Log]) -> u64 {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> u64 limits notrap {
        return log.with(t, body: fn(mut held: events::Log) -> u64 limits notrap, terminates, noalloc {
            return held.dropped()
        })
    })
} dropped_events
