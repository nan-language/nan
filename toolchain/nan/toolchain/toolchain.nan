//! The toolchain hash of each language version this implementation implements.

/// The language versions this implementation implements.
pkg const LANGUAGES: Array[u64, 1] = Array[u64, 1].filled(1)

/// The hash standing for the toolchain's source tree: the tree hash the running image's
/// `.nan.tree` section records, or the file the platform names holds; `InvalidData` when there is
/// neither or it holds no hash.
pkg fn source_tree(alloc: mem::Alloc) -> hashing::HashValue fails platform::IoError {
    let Some(tree) = try recorded_tree(alloc) else {
        fail platform::IoError.InvalidData
    }
    return tree
} source_tree

/// The source tree hash the running image's `.nan.tree` section records, or the file the platform
/// names holds; none when the image holds no such section and the platform names no such file,
/// and `InvalidData` when the section or file holds no hash.
pkg fn recorded_tree(alloc: mem::Alloc) -> Option[hashing::HashValue] fails platform::IoError {
    let recorded = match platform::os::own_tree(alloc) {
        Some(path) => Some(try platform::os::read_all(path.as_str(), alloc))
        None => try image_tree(alloc)
    }
    let Some(held) = recorded else {
        return None
    }
    let Some(tree) = hashing::HashValue.read(held.view()) else {
        fail platform::IoError.InvalidData
    }
    return Some(tree)
} recorded_tree

/// The contents of the running image's `.nan.tree` section; none when it holds no such section.
fn image_tree(alloc: mem::Alloc) -> Option[mem::Bytes] fails platform::IoError {
    let image = platform::os::own_image(alloc)
    return try artefact::section_contents(read: fn(at: usize, length: usize) -> mem::Bytes fails platform::IoError {
        return try platform::os::read_at(image.as_str(), at, length, alloc)
    }, name: TREE_SECTION)
} image_tree

/// The section of an image that records its source tree hash.
const TREE_SECTION: Slice[u8] = b".nan.tree"

/// The hash of the canonical encoding of the record of a language version and the toolchain
/// source tree hash.
pkg fn hash(language: u64, tree: hashing::HashValue, alloc: mem::Alloc) -> hashing::HashValue {
    var version = mem::Bytes.empty(alloc)
    encoding::uvar(mut version, value: language)
    var held = mem::Bytes.empty(alloc)
    encoding::bytes(mut held, value: tree.bytes.view())
    var record = encoding::Record.empty(alloc)
    mut record.field(1, content: take version)
    mut record.field(2, content: take held)
    let encoded = take record.finish(alloc)
    return hashing::HashValue.of(encoded.view())
} hash
