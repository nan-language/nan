//! `nan build` and `nan run`: final builds, bundle builds, and starting the image built.

/// What a command ends with: its output, the program `nan run` starts, or the status `nan run`
/// ends with when it cannot start one.
enum Outcome {
    Output(output::Output)
    Launch(emulator::Launch)
    Ended(u8)
} Outcome

/// `nan build` and `nan run`: the output, or for `nan run` of a built program, the program to
/// start in its place.
fn build_run(invocation: Invocation, session: check::Session, current: Str, trace: Trace, alloc: mem::Alloc) -> Outcome fails platform::IoError {
    let held = session.workspace.contents()
    let Some(resolved) = scope::Scope.resolve(held, current, written: invocation.scope(), alloc) else {
        let written = match invocation.scope() {
            Some(given) => given
            None => "."
        }
        return Outcome.Output(invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: written, alloc))
    }
    trace.scoped(resolved.written.as_str(), alloc)
    match invocation.value("--against") {
        Some(against) => return try bundle_run(invocation, session, current, resolved, against, alloc)
        None => {}
    }
    let programs = programs_of(held, scope: resolved.scope, alloc)
    var single = programs.len() == 1
    match resolved.scope {
        scope::Scope.Package(_) or scope::Scope.Workspace => {}
        else => {
            single = false
        }
    }
    let compared_with = invocation.value("--compare-with")
    let host = all_host(held, programs: programs.view())
    let unusable = programs.len() == 0 or invocation.value("--as").is_some() or (invocation.name == Name.Run and not single) or (compared_with.is_some() and (not single or not host)) or (invocation.flag("--keep-resets") and host)
    if unusable {
        return Outcome.Output(invocation.tool_error(diagnostic::Code.ToolUsage, scope: resolved.written.as_str(), alloc))
    }
    var compared: Option[final_build::Compared] = None
    match compared_with {
        Some(image) => {
            compared = Some(final_build::Compared(path: platform::join(current, name: image, alloc), written: text::String.of(image, alloc)))
        }
        None => {}
    }
    var built = try build_all(session, programs: programs.view(), compared, alloc)
    if invocation.name == Name.Run and built.errors == 0 {
        let Some(image) = mut built.images.pop() else {
            expect false
            return Outcome.Ended(emulator::OTHER_END)
        }
        return try launched(invocation, held, program: programs[0], image: image.as_str(), alloc)
    }
    for written in take built.interfaces {
        mut built.images.push(take written)
    }
    built.interfaces = mem::List[text::String].empty(alloc)
    return Outcome.Output(built_output(invocation, session, resolved, take built, alloc))
} build_run

/// `nan build --against`: builds the bundle of the package the scope names, which declares no
/// entry or a nanos target, against a kernel's interface file.
fn bundle_run(invocation: Invocation, session: check::Session, current: Str, resolved: scope::Resolved, against: Str, alloc: mem::Alloc) -> Outcome fails platform::IoError {
    let held = session.workspace.contents()
    var buildable: Option[usize] = None
    match resolved.scope.package_index(held) {
        Some(index) => {
            match held.package_at(index) {
                Some(source) => match source.manifest {
                    Some(manifest) => if manifest.entry.is_none() or manifest.targets.position(fn(target: workspace::Target) => target.is_nanos()).is_some() {
                        buildable = Some(index)
                    }
                    None => {}
                }
                None => {}
            }
        }
        None => {}
    }
    var usable = invocation.name == Name.Build and invocation.value("--compare-with").is_none()
    match resolved.scope {
        scope::Scope.Package(_) => {}
        else => {
            usable = false
        }
    }
    let Some(package_index) = buildable else {
        return Outcome.Output(invocation.tool_error(diagnostic::Code.ToolUsage, scope: resolved.written.as_str(), alloc))
    }
    if not usable {
        return Outcome.Output(invocation.tool_error(diagnostic::Code.ToolUsage, scope: resolved.written.as_str(), alloc))
    }
    let Some(source) = held.package_at(package_index) else {
        expect false
        return Outcome.Ended(emulator::OTHER_END)
    }
    var signer: Option[core::crypto::SecretKey] = None
    match invocation.value("--as") {
        Some(principal) => {
            match try publishing_key(session, source, publisher: principal, authors: mem::List[text::String].empty(alloc).view(), alloc) {
                Ok(secret) => {
                    signer = Some(take secret)
                }
                Err(reported) => {
                    var diagnostics = mem::List[diagnostic::Diagnostic].empty(alloc)
                    mut diagnostics.push(final_build::at_manifest(source, take reported, alloc))
                    return Outcome.Output(built_output(invocation, session, resolved, built: builds_of(take diagnostics, images: mem::List[text::String].empty(alloc), alloc), alloc))
                }
            }
        }
        None => {}
    }
    let built = try final_build::bundle(session, package_index, against: platform::join(current, name: against, alloc).as_str(), signer, alloc)
    let final_build::Build(diagnostics: reported, image: image, interface_file: _) = built
    var images = mem::List[text::String].empty(alloc)
    match image {
        Some(written) => mut images.push(take written)
        None => {}
    }
    return Outcome.Output(built_output(invocation, session, resolved, built: builds_of(take reported, take images, alloc), alloc))
} bundle_run

/// The output of a build: its diagnostics, then a record for each file it wrote.
fn built_output(invocation: Invocation, session: check::Session, resolved: scope::Resolved, take built: Builds, alloc: mem::Alloc) -> output::Output {
    let held = session.workspace.contents()
    mut built.images.sort_by(fn(left: text::String, right: text::String) => left.as_str().cmp(right.as_str()))
    let std = session.std()
    var records = mem::List[output::Record].empty(alloc)
    for reported in built.diagnostics {
        mut records.push(record(held, std, scope: resolved.scope, reported, alloc))
    }
    for image in built.images {
        var fields = mem::List[text::String].empty(alloc)
        mut fields.push(text::String.of(image.as_str(), alloc))
        mut records.push(output::Record(word: text::String.of("wrote", alloc), fields: take fields, lines: mem::List[text::String].empty(alloc)))
    }
    var summary = mem::List[output::Count].empty(alloc)
    mut summary.push(output::Count(name: text::String.of("files", alloc), value: built.images.len()))
    mut summary.push(output::Count(name: text::String.of("errors", alloc), value: built.errors))
    mut summary.push(output::Count(name: text::String.of("incomplete", alloc), value: built.incomplete))
    var verdict = output::Verdict.Ok
    if built.errors > 0 {
        verdict = output::Verdict.Failed
    }
    return output::Output(command: invocation.command(resolved.written.as_str(), skip: true, alloc), elision: invocation.command(resolved.written.as_str(), skip: false, alloc), verdict: verdict, summary: take summary, records: take records)
} built_output

/// Whether every program declares a host target.
fn all_host(held: workspace::Workspace, programs: Slice[usize]) -> bool {
    for program in programs {
        let Some(source) = held.package_at(program) else {
            expect false
            return false
        }
        let Some(manifest) = source.manifest else {
            return false
        }
        if manifest.targets.position(fn(declared: workspace::Target) => declared.is_host()).is_none() {
            return false
        }
    }
    return true
} all_host

/// What the final builds of a command report and the images and interface files they write: the
/// diagnostics by path, line and code, each once, with their counts of errors and incompleteness.
struct Builds {
    diagnostics: mem::List[diagnostic::Diagnostic]
    images: mem::List[text::String]
    interfaces: mem::List[text::String]
    errors: usize
    incomplete: usize
} Builds

/// Performs the final build of each program, comparing its code roots with those of the image
/// `compared` gives, when given.
fn build_all(session: check::Session, programs: Slice[usize], compared: Option[final_build::Compared], alloc: mem::Alloc) -> Builds fails platform::IoError {
    var diagnostics = mem::List[diagnostic::Diagnostic].empty(alloc)
    var images = mem::List[text::String].empty(alloc)
    var interfaces = mem::List[text::String].empty(alloc)
    for program in programs {
        let built = try final_build::build(session, program, compared, alloc)
        let final_build::Build(diagnostics: reported, image: image, interface_file: interface_file) = built
        for found in take reported {
            mut diagnostics.push(take found)
        }
        match interface_file {
            Some(written) => mut interfaces.push(take written)
            None => {}
        }
        let Some(written) = image else {
            continue
        }
        mut images.push(take written)
    }
    var builds = builds_of(take diagnostics, take images, alloc)
    builds.interfaces = interfaces
    return builds
} build_all

/// What builds report and the images they write: the diagnostics by path, line and code, each
/// once, with their counts of errors and incompleteness.
fn builds_of(take diagnostics: mem::List[diagnostic::Diagnostic], take images: mem::List[text::String], alloc: mem::Alloc) -> Builds {
    let distinct = diagnostic::sorted_diagnostics(take diagnostics, alloc)
    var errors: usize = 0
    var incomplete: usize = 0
    for reported in distinct {
        invariant errors < distinct.len() and incomplete < distinct.len()
        let class = reported.code.class()
        if class == diagnostic::Class.Error {
            errors += 1
        } else if class == diagnostic::Class.Incompleteness {
            incomplete += 1
        }
    }
    return Builds(diagnostics: take distinct, images: take images, interfaces: mem::List[text::String].empty(alloc), errors: errors, incomplete: incomplete)
} builds_of

/// What `nan run` starts once the image of the program at index `program` is built at `image`,
/// relative to the workspace root: the image on a Linux target, Wine running it on a Windows
/// target, the emulator booting it on a machine target; or the status it ends with when it cannot
/// start one.
fn launched(invocation: Invocation, held: workspace::Workspace, program: usize, image: Str, alloc: mem::Alloc) -> Outcome fails platform::IoError {
    let path = platform::join(held.root.as_str(), name: image, alloc)
    let Some(source) = held.package_at(program) else {
        expect false
        return Outcome.Ended(emulator::OTHER_END)
    }
    let target = source.program_target()
    if not emulator::available(target, alloc) {
        return Outcome.Ended(emulator::OTHER_END)
    }
    if target.is_machine() {
        var files = mem::List[text::String].empty(alloc)
        if target.kind() == Some(workspace::Kind.Uefi) {
            files = volume_files(held, uefi: target, image: path.as_str(), alloc)
        }
        let machines = platform::join(held.root.as_str(), name: ".nan/machine", alloc)
        let dir = platform::join(machines.as_str(), name: target.name(), alloc)
        let boots = emulator::Boots.Kept(dir: take dir, resets: invocation.flag("--keep-resets"))
        return Outcome.Launch(try emulator::launch(target, image: path.as_str(), files: files.view(), boots: take boots, alloc))
    }
    let windows = target.kind() == Some(workspace::Kind.Windows)
    var args = mem::List[text::String].empty(alloc)
    if windows {
        mut args.push(text::String.of(path.as_str(), alloc))
    }
    for arg in invocation.passed {
        mut args.push(text::String.of(arg.as_str(), alloc))
    }
    var env = mem::List[text::String].empty(alloc)
    if windows {
        mut env.push(text::String.of(emulator::WINE_QUIET, alloc))
        return Outcome.Launch(emulator::Launch(program: text::String.of(emulator::WINE, alloc), args: take args, env: take env, machine: None))
    }
    return Outcome.Launch(emulator::Launch(program: take path, args: take args, env: take env, machine: None))
} launched

/// The image files of the workspace's programs for the machine targets of a UEFI target's
/// architecture, other than `image`, which the boot volume of that UEFI target's image holds
/// under `nan run`.
fn volume_files(held: workspace::Workspace, uefi: workspace::Target, image: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var files = mem::List[text::String].empty(alloc)
    let Some(arch) = uefi.arch() else {
        expect false
        return files
    }
    var kinds = mem::List[workspace::Kind].empty(alloc)
    mut kinds.push(workspace::Kind.Uefi)
    mut kinds.push(workspace::Kind.Bare)
    for kind in kinds {
        var directory = platform::join(held.root.as_str(), name: ".nan/images", alloc)
        directory = platform::join(directory.as_str(), name: workspace::Target.of(arch, kind).name(), alloc)
        let Ok(entries) = attempt platform::list_dir(directory.as_str(), alloc) else {
            continue
        }
        for listed in entries {
            let name = output::lossy(listed.name.view(), alloc)
            let path = platform::join(directory.as_str(), name: name.as_str(), alloc)
            let Ok(held_file) = attempt platform::metadata(path.as_str()) else {
                continue
            }
            if held_file.is_file() and path.as_str() != image {
                mut files.push(take path)
            }
        }
    }
    mut files.sort_by(fn(left: text::String, right: text::String) => left.as_str().cmp(right.as_str()))
    return files
} volume_files

/// The indexes of the programs a scope holds: every program of the workspace, or the program
/// holding a narrower scope.
fn programs_of(held: workspace::Workspace, scope: scope::Scope, alloc: mem::Alloc) -> mem::List[usize] {
    var found = mem::List[usize].empty(alloc)
    var candidates = mem::List[usize].empty(alloc)
    match scope {
        scope::Scope.Workspace => {
            for index in 0..<held.packages.len() {
                mut candidates.push(index)
            }
        }
        else => {
            match scope.package_index(held) {
                Some(index) => mut candidates.push(index)
                None => {}
            }
        }
    }
    for index in candidates {
        let Some(source) = held.package_at(index) else {
            expect false
            continue
        }
        let Some(manifest) = source.manifest else {
            continue
        }
        if manifest.entry.is_some() {
            mut found.push(index)
        }
    }
    return found
} programs_of
