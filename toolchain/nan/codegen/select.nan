//! Instruction selection for x86-64: the blocks of machine instructions over virtual registers that compute a function, in the order emission lays them out, with the frame they need.

/// The state of selection: the code selected so far and what it knows of the function's values.
struct Selector {
    isa: Isa
    alloc: mem::Alloc
    facts: Facts
    code: VCode[x64::Inst]
    /// Each value's register, its low half for a 128-bit integer, `NO_REG` until it has one.
    lows: mem::List[machinst::Reg]
    /// The high half of each 128-bit integer value.
    highs: mem::List[machinst::Reg]
    /// Each stack slot's offset from the stack pointer.
    slot_offsets: mem::List[u32]
    /// The block being selected.
    current: VBlock
    /// The source location of the instruction being selected.
    loc: clif::SourceLoc
    /// The quotients the block being selected computed by magic numbers.
    quotients: mem::List[Quotient]
    /// The operand the block being selected rebuilds from an overflowing operation's result.
    rebuilt: Rebuilt
} Selector

/// An operand of an addition or subtraction that a cold block reached only when the operation
/// overflows rebuilds from its result, so that it need not stay live past the operation, and the
/// register holding it there; `NO_VALUE` for none.
struct Rebuilt derives Copy, Eq {
    value: clif::Value
    reg: machinst::Reg
} Rebuilt

const NOT_REBUILT: Rebuilt = Rebuilt(value: NO_VALUE, reg: NO_REG)

/// The machine code of a function.
fn select(func: clif::Function, isa: Isa, alloc: mem::Alloc) -> VCode[x64::Inst] {
    var selector = Selector.new(func, isa, alloc)
    let order = selector.facts.order(func)
    for block in order {
        mut selector.select_block(func, block)
        let at = usize.widen(block.index)
        expect at < selector.facts.then_edges.len() and at < selector.facts.else_edges.len()
        let then_edge = selector.facts.then_edges[at]
        let else_edge = selector.facts.else_edges[at]
        if then_edge != NONE {
            mut selector.edge_block(func, block, then: true)
        }
        if else_edge != NONE {
            mut selector.edge_block(func, block, then: false)
        }
    }
    selector.code.hints = selector.code.edge_hints(alloc)
    return selector.code
} select

fn Selector.new(func: clif::Function, isa: Isa, alloc: mem::Alloc) -> Selector {
    let values = usize.widen(func.value_count())
    var selector = Selector(
        isa: isa,
        alloc: alloc,
        facts: Facts.of(func, alloc),
        code: VCode[x64::Inst].empty(alloc),
        lows: filled(values, value: NO_REG, alloc),
        highs: filled(values, value: NO_REG, alloc),
        slot_offsets: mem::List[u32].empty(alloc),
        current: VBlock(begin: 0, end: 0, param_start: 0, param_count: 0, arg_start: 0, arg_count: 0, succ_start: 0, succ_count: 0),
        loc: clif::DEFAULT_LOC,
        quotients: mem::List[Quotient].empty(alloc),
        rebuilt: NOT_REBUILT,
    )
    mut selector.facts.fuse_overflow_checks(func)
    mut selector.facts.mark_shown_values(func)
    mut selector.lay_out_frame(func)
    return selector
} Selector.new

/// Lays out the outgoing argument area the calls need and the stack slots above it, each aligned
/// as it asks and at least to 8 bytes.
fn Selector.lay_out_frame(mut self, func: clif::Function) {
    var outgoing: u32 = 0
    var calls = false
    for block in self.facts.order(func) {
        for inst in func.block_insts(block, alloc: self.alloc) {
            match func.inst_data(inst) {
                clif::InstructionData.Call(opcode: _, func_ref: func_ref, args: _) => {
                    let sig = func.imported_signature(func.ext_func(func_ref).signature)
                    outgoing = larger(outgoing, other: places(sig, alloc: self.alloc).stack)
                    calls = true
                }
                clif::InstructionData.CallIndirect(opcode: _, sig_ref: sig_ref, callee: _, args: _) => {
                    outgoing = larger(outgoing, other: places(func.imported_signature(sig_ref), alloc: self.alloc).stack)
                    calls = true
                }
                clif::InstructionData.UnaryGlobalValue(opcode: clif::Opcode.TlsValue, global_value: _) => {
                    calls = calls or not self.facts.only_addresses(func, value: result_of(func, inst, alloc: self.alloc))
                }
                else => {}
            }
        }
    }
    let SlotLayout(offsets: offsets, end: end, align: align) = lay_out_slots(func, outgoing: outgoing, alloc: self.alloc)
    self.slot_offsets = offsets
    self.code.slots_end = end
    self.code.align = align
    self.code.calls = calls
} Selector.lay_out_frame

fn Selector.emit(mut self, inst: x64::Inst) {
    mut self.code.insts.push(VInst(inst: inst, loc: self.loc))
} Selector.emit

fn Selector.temp(mut self, float: bool) -> machinst::Reg {
    return mut self.code.new_vreg(float)
} Selector.temp

/// A move between registers of one class, the destination preferring the source's register.
fn Selector.mov(mut self, dst: machinst::Reg, src: machinst::Reg) {
    prefer(mut self.code.hints, reg: dst, preferred: src)
    prefer(mut self.code.hints, reg: src, preferred: dst)
    mut self.emit(x64::Inst.Mov(dst: dst, src: src))
} Selector.mov

/// A new register holding a copy of `src`.
fn Selector.copy(mut self, src: machinst::Reg) -> machinst::Reg {
    let float = self.code.is_float(src)
    let dst = mut self.temp(float)
    mut self.mov(dst, src: src)
    return dst
} Selector.copy

/// The register of a value, its low half for a 128-bit integer: a new virtual register the first
/// time an instruction names the value.
fn Selector.reg(mut self, value: clif::Value, func: clif::Function) -> machinst::Reg {
    let resolved = func.resolve_aliases(value)
    if resolved == self.rebuilt.value {
        return self.rebuilt.reg
    }
    let at = usize.widen(resolved.index)
    expect at < self.lows.len() and at < self.highs.len()
    let existing = self.lows[at]
    if existing != NO_REG {
        return existing
    }
    let ty = func.value_type(resolved)
    var low = NO_REG
    if ty.is_vector() {
        low = mut self.code.new_vector_vreg()
    } else {
        low = mut self.code.new_vreg(ty.is_float())
    }
    self.lows[at] = low
    if ty == clif::Type.Int128 {
        let high = mut self.code.new_vreg(false)
        self.highs[at] = high
    }
    return low
} Selector.reg

/// The register of a 128-bit value's high half.
fn Selector.high(mut self, value: clif::Value, func: clif::Function) -> machinst::Reg {
    discard mut self.reg(value, func)
    let at = usize.widen(func.resolve_aliases(value).index)
    expect at < self.highs.len()
    return self.highs[at]
} Selector.high

/// Makes a value's registers those of another value, or copies them when the value already has
/// its own.
fn Selector.alias(mut self, value: clif::Value, func: clif::Function, low: machinst::Reg, high: machinst::Reg) {
    let at = usize.widen(func.resolve_aliases(value).index)
    expect at < self.lows.len() and at < self.highs.len()
    if self.lows[at] == NO_REG {
        self.lows[at] = low
        self.highs[at] = high
        return
    }
    let existing = self.lows[at]
    let existing_high = self.highs[at]
    mut self.mov(existing, src: low)
    if high != NO_REG {
        mut self.mov(existing_high, src: high)
    }
} Selector.alias

/// The constant a value is as the 32-bit immediate of an operation on its type: sign-extended
/// from a narrower integer type, and for a 64-bit one only when it fits.
fn Selector.imm(self, value: clif::Value, func: clif::Function) -> Option[i32] {
    let Some(bits) = self.facts.constant(value, func) else {
        return None
    }
    let ty = func.value_type(value)
    if not ty.is_int() or ty == clif::Type.Int128 {
        return None
    }
    return imm32(bits, width: ty.bits())
} Selector.imm

fn imm32(bits: u64, width: u32) -> Option[i32] {
    if width >= 64 {
        return i32.checked_fit(i64.from_bits(bits))
    }
    let shift = 64 - width
    return Some(i32.truncate(i64.from_bits(bits << shift).shr_arith(shift)))
} imm32

/// The register holding a value for an instruction to read; a stack slot's address, and a
/// constant other than a wide one, is written into a new register for each read.
fn Selector.src(mut self, value: clif::Value, func: clif::Function) -> machinst::Reg {
    if self.is_wide(value, func) {
        return mut self.reg(value, func)
    }
    let Some(bits) = self.facts.constant(value, func) else {
        let at = usize.widen(func.resolve_aliases(value).index)
        expect at < self.facts.defs.len()
        let def = self.facts.defs[at]
        if def != NONE {
            match func.inst_data(clif::Inst(index: def)) {
                clif::InstructionData.StackLoad(opcode: _, slot: slot, offset: offset) => {
                    let address = mut self.temp(false)
                    mut self.emit(x64::Inst.Lea(dst: address, src: x64::Amode.at(x64::RSP, disp: self.slot_disp(slot, offset))))
                    return address
                }
                else => {}
            }
        }
        return mut self.reg(value, func)
    }
    let ty = func.value_type(value)
    if ty.is_float() {
        return mut self.float_constant(ty, bits)
    }
    let reg = mut self.temp(false)
    mut self.emit(x64::Inst.MovImm(dst: reg, imm: bits))
    return reg
} Selector.src

/// Whether a value is a wide constant: a float other than zero, or an integer of 64 bits no 32-bit
/// immediate gives, which its own register holds from where it is defined, as a loop's
/// preheader holds the constants hoisting moves there.
fn Selector.is_wide(self, value: clif::Value, func: clif::Function) -> bool {
    let Some(bits) = self.facts.constant(value, func) else {
        return false
    }
    let ty = func.value_type(value)
    if ty.is_float() {
        return bits != 0
    }
    return ty == clif::Type.Int64 and imm32(bits, width: 64).is_none()
} Selector.is_wide

/// A wide constant written into its own register where it is defined.
fn Selector.wide_constant(mut self, func: clif::Function, inst: clif::Inst) {
    let result = result_of(func, inst, alloc: self.alloc)
    if not self.is_wide(result, func) {
        return
    }
    let Some(bits) = self.facts.constant(result, func) else {
        return
    }
    let dst = mut self.reg(result, func)
    let ty = func.value_type(result)
    if ty.is_float() {
        let int = mut self.temp(false)
        mut self.emit(x64::Inst.MovImm(dst: int, imm: bits))
        mut self.emit(x64::Inst.MovToXmm(size: x64::Size.of_bits(ty.bits()), dst: dst, src: int))
        return
    }
    mut self.emit(x64::Inst.MovImm(dst: dst, imm: bits))
} Selector.wide_constant

/// The register holding a 128-bit value's high half for an instruction to read.
fn Selector.src_high(mut self, value: clif::Value, func: clif::Function) -> machinst::Reg {
    let Some(bits) = self.facts.constant(value, func) else {
        return mut self.high(value, func)
    }
    let reg = mut self.temp(false)
    var high: u64 = 0
    if i64.from_bits(bits) < 0 {
        high = 0xFFFF_FFFF_FFFF_FFFF
    }
    mut self.emit(x64::Inst.MovImm(dst: reg, imm: high))
    return reg
} Selector.src_high

/// A new SSE register holding float bits.
fn Selector.float_constant(mut self, ty: clif::Type, bits: u64) -> machinst::Reg {
    let reg = mut self.temp(true)
    if bits == 0 {
        mut self.emit(x64::Inst.FloatBits(op: x64::BitOp.Xor, dst: reg, src: reg))
        return reg
    }
    let int = mut self.temp(false)
    mut self.emit(x64::Inst.MovImm(dst: int, imm: bits))
    mut self.emit(x64::Inst.MovToXmm(size: x64::Size.of_bits(ty.bits()), dst: reg, src: int))
    return reg
} Selector.float_constant

fn Selector.start_block(mut self) {
    mut self.quotients.truncate(0)
    self.current = VBlock(begin: u32.fit(self.code.insts.len()), end: 0, param_start: u32.fit(self.code.params.len()), param_count: 0, arg_start: u32.fit(self.code.args.len()), arg_count: 0, succ_start: u32.fit(self.code.succs.len()), succ_count: 0)
} Selector.start_block

fn Selector.finish_block(mut self) {
    mut self.pair_nan_tests()
    mut self.pair_lane_tests()
    self.current.end = u32.fit(self.code.insts.len())
    let params = u32.fit(self.code.params.len())
    let args = u32.fit(self.code.args.len())
    let succs = u32.fit(self.code.succs.len())
    expect self.current.param_start <= params and self.current.arg_start <= args and self.current.succ_start <= succs
    self.current.param_count = params - self.current.param_start
    self.current.arg_count = args - self.current.arg_start
    self.current.succ_count = succs - self.current.succ_start
    mut self.code.blocks.push(self.current)
} Selector.finish_block

/// Joins each test of a float vector's lanes for NaNs in the block with the next one on lanes of
/// its size, when no instruction between them reads or writes the earlier vector, so that one
/// branch tests both.
fn Selector.pair_lane_tests(mut self) {
    let begin = usize.widen(self.current.begin)
    let end = self.code.insts.len()
    var joined = filled(end - begin, value: false, alloc: self.alloc)
    for at in begin..<end {
        let x64::Inst.CanonNanLanes(size: size, reg: earlier, mask: _, canon: _, temp: _) = self.code.insts[at].inst else {
            continue
        }
        let Some(later) = self.next_lane_test(from: at + 1, size, earlier) else {
            continue
        }
        let held = self.code.insts[later]
        let x64::Inst.CanonNanLanes(size: _, reg: tested, mask: mask, canon: canon, temp: temp) = held.inst else {
            continue
        }
        self.code.insts[later] = VInst(inst: x64::Inst.CanonNanLanePair(size: size, left: earlier, right: tested, mask: mask, canon: canon, temp: temp), loc: held.loc)
        joined[at - begin] = true
    }
    for back in 0..<(end - begin) {
        if joined[end - begin - 1 - back] {
            discard mut self.code.insts.remove(end - 1 - back)
        }
    }
} Selector.pair_lane_tests

/// Tests two floats of one size for NaNs at once where the block tests one and later the other,
/// no instruction between reading the first but stores of it, which follow the joined test once
/// no instruction between them and it writes their registers or memory or loads their bytes.
fn Selector.pair_nan_tests(mut self) {
    var at = usize.widen(self.current.begin)
    while at < self.code.insts.len() {
        let x64::Inst.CanonNan(size: size, reg: earlier, temp: _) = self.code.insts[at].inst else {
            at += 1
            continue
        }
        let Some(joined) = self.nan_partner(from: at + 1, size, earlier) else {
            at += 1
            continue
        }
        var rest = mem::List[VInst[x64::Inst]].empty(self.alloc)
        for index in (at + 1)..<self.code.insts.len() {
            mut rest.push(self.code.insts[index])
        }
        mut self.code.insts.truncate(at)
        var moved = mem::List[VInst[x64::Inst]].empty(self.alloc)
        let later = joined.later - at - 1
        for index in 0..<later {
            if joined.stores.position(fn(store: usize) => store == index + at + 1) != None {
                mut moved.push(rest[index])
            } else {
                mut self.code.insts.push(rest[index])
            }
        }
        let x64::Inst.CanonNan(size: _, reg: tested, temp: temp) = rest[later].inst else {
            expect false
            return
        }
        mut self.code.insts.push(VInst(inst: x64::Inst.CanonNanPair(size: size, left: earlier, right: tested, temp: temp), loc: rest[later].loc))
        for held in moved {
            mut self.code.insts.push(held)
        }
        for index in (later + 1)..<rest.len() {
            mut self.code.insts.push(rest[index])
        }
    }
} Selector.pair_nan_tests

/// Where a block's test of `earlier`, a float of `size`, for a NaN joins the next such test from
/// `from`: that test and the stores of `earlier` before it, none when another instruction before
/// it reads `earlier`, has an effect, or writes the registers a store reads or, for a load, may
/// read the bytes a store writes.
fn Selector.nan_partner(self, from: usize, size: x64::Size, earlier: machinst::Reg) -> Option[NanPartner] {
    var stores = mem::List[usize].empty(self.alloc)
    var read = mem::List[machinst::Reg].empty(self.alloc)
    for index in from..<self.code.insts.len() {
        let inst = self.code.insts[index].inst
        match inst {
            x64::Inst.CanonNan(size: tested, reg: _, temp: _) => {
                if tested == size {
                    return Some(NanPartner(later: index, stores: take stores))
                }
            }
            x64::Inst.Store(size: _, src: src, dst: dst) => {
                if src != earlier {
                    return None
                }
                mut stores.push(index)
                each_address_reg(dst, visit: fn[mut read](reg: machinst::Reg) {
                    mut read.push(reg)
                })
                continue
            }
            x64::Inst.Load(kind: kind, dst: _, src: src) => {
                for store in stores {
                    let x64::Inst.Store(size: stored, src: _, dst: dst) = self.code.insts[store].inst else {
                        continue
                    }
                    if may_overlap(dst, size: size_bytes(stored), other: src, other_size: load_bytes(kind)) {
                        return None
                    }
                }
            }
            else => {
                if not inst.is_pure() {
                    return None
                }
            }
        }
        var clashes = false
        discard inst.map_regs(fn[mut clashes](reg: machinst::Reg, role: machinst::Role) -> machinst::Reg {
            let writes = role != machinst::Role.Use
            clashes = clashes or reg == earlier or (writes and read.position(fn(held: machinst::Reg) => held == reg) != None)
            return reg
        })
        if clashes {
            return None
        }
    }
    return None
} Selector.nan_partner

/// The test of a float for a NaN that joins an earlier one, by instruction index, and the stores
/// of the earlier float before it that move past the joined test.
struct NanPartner {
    later: usize
    stores: mem::List[usize]
} NanPartner

/// Shows `visit` the registers a memory operand reads.
fn each_address_reg(mem: x64::Amode, visit: fn(reg: machinst::Reg)) {
    let x64::Amode.Mem(base: base, index: index, shift: _, disp: _) = mem else {
        return
    }
    visit(base)
    match index {
        Some(held) => visit(held)
        None => {}
    }
} each_address_reg

/// Whether two accesses of `size` and `other_size` bytes may reach a byte in common: always but
/// for two from different displacements past the same base and index.
fn may_overlap(mem: x64::Amode, size: i64, other: x64::Amode, other_size: i64) -> bool {
    let x64::Amode.Mem(base: base, index: index, shift: shift, disp: disp) = mem else {
        return true
    }
    let x64::Amode.Mem(base: other_base, index: other_index, shift: other_shift, disp: other_disp) = other else {
        return true
    }
    if base != other_base or index != other_index or shift != other_shift {
        return true
    }
    return i64.widen(disp) < i64.widen(other_disp) + other_size and i64.widen(other_disp) < i64.widen(disp) + size
} may_overlap

fn size_bytes(size: x64::Size) -> i64 {
    return match size {
        x64::Size.Byte => 1
        x64::Size.Word => 2
        x64::Size.Dword => 4
        x64::Size.Qword => 8
    }
} size_bytes

fn load_bytes(kind: x64::LoadKind) -> i64 {
    return match kind {
        x64::LoadKind.Zx8 => 1
        x64::LoadKind.Zx16 => 2
        x64::LoadKind.Dword or x64::LoadKind.Float32 => 4
        x64::LoadKind.Qword or x64::LoadKind.Float64 => 8
    }
} load_bytes

/// The index of the next test of a float vector's lanes for NaNs on lanes of `size` from
/// `from`, none when an instruction before it reads or writes `earlier`.
fn Selector.next_lane_test(self, from: usize, size: x64::Size, earlier: machinst::Reg) -> Option[usize] {
    for index in from..<self.code.insts.len() {
        let inst = self.code.insts[index].inst
        match inst {
            x64::Inst.CanonNanLanes(size: tested, reg: _, mask: _, canon: _, temp: _) => {
                if tested == size {
                    return Some(index)
                }
            }
            else => {}
        }
        var touched = false
        discard inst.map_regs(fn[mut touched](reg: machinst::Reg, role: machinst::Role) -> machinst::Reg {
            if reg == earlier {
                touched = true
            }
            return reg
        })
        if touched {
            return None
        }
    }
    return None
} Selector.next_lane_test

fn Selector.select_block(mut self, func: clif::Function, block: clif::Block) {
    mut self.start_block()
    let params = func.block_params(block, alloc: self.alloc)
    if func.entry_block() == Some(block) {
        mut self.entry_params(func, params: params.view())
    } else {
        for param in params {
            let low = mut self.reg(param, func)
            mut self.code.params.push(low)
            if func.value_type(param) == clif::Type.Int128 {
                let high = mut self.high(param, func)
                mut self.code.params.push(high)
            }
        }
    }
    mut self.rebuild_operand(func, block)
    for inst in func.block_insts(block, alloc: self.alloc) {
        if not self.facts.is_live(inst) {
            continue
        }
        self.loc = func.srcloc(inst)
        mut self.select_inst(func, block, inst)
    }
    self.rebuilt = NOT_REBUILT
    mut self.finish_block()
} Selector.select_block

/// The entry's parameters, received where the function's signature places them.
fn Selector.entry_params(mut self, func: clif::Function, params: Slice[clif::Value]) {
    let placed = places(func.signature, alloc: self.alloc)
    var regs = machinst::RegSet.empty()
    for place in placed.params {
        match place {
            Place.Reg(reg) => {
                regs = regs.plus(reg)
            }
            Place.Stack(_) => {}
        }
    }
    mut self.emit(x64::Inst.Args(params: regs))
    var at: usize = 0
    for param in params {
        let low = mut self.reg(param, func)
        expect at < placed.params.len()
        mut self.receive(low, place: placed.params[at])
        at += 1
        if func.value_type(param) == clif::Type.Int128 {
            let high = mut self.high(param, func)
            expect at < placed.params.len()
            mut self.receive(high, place: placed.params[at])
            at += 1
        }
    }
} Selector.entry_params

/// Moves a parameter from where it arrives into its register.
fn Selector.receive(mut self, reg: machinst::Reg, place: Place) {
    match place {
        Place.Reg(arrived) => mut self.mov(reg, src: arrived)
        Place.Stack(offset) => {
            let src = x64::Amode.at(x64::RBP, disp: i32.fit(offset + 16))
            let kind = load_kind(self.code.is_float(reg), size: x64::Size.Qword)
            mut self.emit(x64::Inst.Load(kind: kind, dst: reg, src: src))
        }
    }
} Selector.receive

/// The load of a value of a size into a register of its class.
fn load_kind(float: bool, size: x64::Size) -> x64::LoadKind {
    if float {
        if size == x64::Size.Dword {
            return x64::LoadKind.Float32
        }
        return x64::LoadKind.Float64
    }
    return match size {
        x64::Size.Byte => x64::LoadKind.Zx8
        x64::Size.Word => x64::LoadKind.Zx16
        x64::Size.Dword => x64::LoadKind.Dword
        x64::Size.Qword => x64::LoadKind.Qword
    }
} load_kind

/// A block holding only the jump of one edge of a block's conditional branch, passing its
/// arguments.
fn Selector.edge_block(mut self, func: clif::Function, block: clif::Block, then: bool) {
    mut self.start_block()
    let insts = func.block_insts(block, alloc: self.alloc)
    expect insts.len() > 0
    let last = insts[insts.len() - 1]
    self.loc = func.srcloc(last)
    match func.inst_data(last) {
        clif::InstructionData.Brif(opcode: _, arg: _, then: then_call, otherwise: else_call) => {
            if then {
                mut self.jump(func, target: then_call.block, args: then_call.args.view())
            } else {
                mut self.jump(func, target: else_call.block, args: else_call.args.view())
            }
        }
        else => {
            expect false
        }
    }
    mut self.finish_block()
} Selector.edge_block

/// A jump passing arguments to a block's parameters.
fn Selector.jump(mut self, func: clif::Function, target: clif::Block, args: Slice[clif::Value]) {
    for arg in args {
        let low = mut self.src(arg, func)
        mut self.code.args.push(low)
        if func.value_type(arg) == clif::Type.Int128 {
            let high = mut self.src_high(arg, func)
            mut self.code.args.push(high)
        }
    }
    let position = self.facts.position_of(self.facts.destination(target))
    mut self.code.succs.push(position)
    mut self.emit(x64::Inst.Jmp(label: position))
} Selector.jump
