//! The timer's registers, its interrupt and the signal it posts.

/// The vector the timer's interrupt arrives on.
const TIMER_VECTOR: u8 = 0x30

/// `expired` is set when the timer fires and cleared by writing 1 to it.
pub layout TimerStatus: u32 le {
    expired: bit 0
    reserved: rest
} TimerStatus

pub registers TimerRegs {
    status: TimerStatus at 0x0 write_one_clear
} TimerRegs

/// The timer, the ticks counted since it was attached, and the signal that receives every
/// `period`-th count, none when `period` is 0.
pub open linear struct Ticker {
    regs: hw::Mmio[TimerRegs]
    ticks: u64
    period: u64
    wake: mem::Shared[hw::Signal[u64]]
} Ticker

pub fn Ticker.of(take regs: hw::Mmio[TimerRegs], period: u64, wake: mem::Shared[hw::Signal[u64]]) -> Ticker {
    return Ticker(regs: take regs, ticks: 0, period: period, wake: wake.share())
} Ticker.of

/// Installs the ticker on the timer's vector.
pub fn attach(take ticker: Ticker) -> hw::IrqShared[Ticker] {
    return hw::IrqShared.install(take ticker, vector: TIMER_VECTOR, on_irq: Ticker.on_irq)
} attach

/// Uninstalls the ticker and ends the timer's window.
pub fn detach(take shared: hw::IrqShared[Ticker]) {
    let Ticker(regs: regs, ticks: _, period: _, wake: _) = take shared.uninstall()
    take regs.unmap()
} detach
