//! Emission of x86-64 code: the frame and its prologue and epilogue, a block ending in a trap reserving the stack slots when only such blocks reach them, each instruction with its allocated registers and its spilled operands reloaded and stored through scratch registers, a reload left out when its scratch register already holds the slot within the block, the parallel moves of block arguments, a jump to a small block replaced by a copy of it, and the runs of source locations.

/// The frame below the saved frame pointer, from the stack pointer up: the outgoing argument
/// area, the stack slots, the spill slots, padding, the saved SSE registers, then the pushed
/// general-purpose ones.
struct Frame {
    /// The offset of the spill slots from the stack pointer.
    spills: u32
    /// The bytes the prologue subtracts from the stack pointer after its pushes.
    body: u32
    /// The bytes a block ending in a trap subtracts from the stack pointer at its start when only
    /// such blocks reach the stack slots and no value spills: the slots' bytes, which `body`
    /// leaves out; 0 otherwise.
    cold: u32
    /// The alignment beyond 16 the prologue aligns the stack pointer down to, 16 for none.
    align: u32
    saved: machinst::RegSet
    /// The bytes from the return address down to the deepest the stack pointer goes, both
    /// included.
    size: u64
} Frame

/// The alignment of a function's code: a cache line, so that the code of a small function spans
/// the fewest lines it can.
const FUNCTION_ALIGN: u32 = 64

/// The general-purpose callee-saved registers in the order the prologue pushes them.
fn saved_reg(index: u32) -> machinst::Reg {
    return match index {
        0 => x64::RBX
        1 => x64::RSI
        2 => x64::RDI
        3 => x64::R12
        4 => x64::R13
        5 => x64::R14
        else => x64::R15
    }
} saved_reg

const SAVED_REG_COUNT: u32 = 7

/// The bytes the prologue's pushes of callee-saved registers take.
fn pushed_bytes(saved: machinst::RegSet) -> u32
    ensures result <= 56
{
    var pushed: u32 = 0
    for index in 0u32..<SAVED_REG_COUNT {
        invariant pushed <= 8 * index
        if saved.contains(saved_reg(index)) {
            pushed += 8
        }
    }
    return pushed
} pushed_bytes

/// The bytes the saved SSE registers take, 16 for each.
fn vector_bytes(saved: machinst::RegSet) -> u32
    ensures result <= 256
{
    var bytes: u32 = 0
    for number in 0u32..<16 {
        invariant bytes <= 16 * number
        if saved.contains(x64::xmm(number)) {
            bytes += 16
        }
    }
    return bytes
} vector_bytes

/// The callee-saved registers the frame saves: those allocation finds the code changes, and the
/// scratch registers of floats when the code holds a float and its calling convention keeps them.
fn frame_saved(code: VCode[x64::Inst], allocation: Allocation) -> machinst::RegSet {
    if code.floats.position(fn(float: bool) => float).is_none() {
        return allocation.saved
    }
    let scratches = machinst::RegSet.of(scratch(true, index: 0)).plus(scratch(true, index: 1))
    return allocation.saved.union(scratches.intersect(x64::Inst.callee_saved(code.call_conv)))
} frame_saved

fn Frame.of(code: VCode[x64::Inst], allocation: Allocation) -> Frame {
    let saved = frame_saved(code, allocation)
    let spills = round_up(code.slots_end, to: 8)
    let pushed = pushed_bytes(saved)
    let kept = pushed + vector_bytes(saved)
    let used = spills + (8 * allocation.slot_count)
    let body = round_up(used + kept, to: 16) - pushed
    var size = u64.widen(16 + pushed + body)
    if code.align > 16 {
        size += u64.widen(code.align - 16)
    }
    if allocation.slot_count > 0 or code.align > 16 or code.slots_end == 0 or not only_traps_address_stack(code) {
        return Frame(spills: spills, body: body, cold: 0, align: code.align, saved: saved, size: size)
    }
    let hot = round_up(kept, to: 16) - pushed
    return Frame(spills: spills, body: hot, cold: body - hot, align: code.align, saved: saved, size: size)
} Frame.of

/// Whether only blocks ending in a trap address the stack.
fn only_traps_address_stack(code: VCode[x64::Inst]) -> bool {
    for block in code.blocks {
        if not ends_in_trap(code, block) and addresses_stack(code, block) {
            return false
        }
    }
    return true
} only_traps_address_stack

/// Whether a block's last instruction traps.
fn ends_in_trap(code: VCode[x64::Inst], block: VBlock) -> bool {
    if block.end <= block.begin or usize.widen(block.end) > code.insts.len() {
        return false
    }
    return match code.insts[usize.widen(block.end) - 1].inst {
        x64::Inst.Ud2 => true
        else => false
    }
} ends_in_trap

/// Whether an instruction of a block reads or writes the stack pointer.
fn addresses_stack(code: VCode[x64::Inst], block: VBlock) -> bool {
    var touches = false
    for at in block.begin..<block.end {
        expect usize.widen(at) < code.insts.len()
        discard code.insts[usize.widen(at)].inst.map_regs(fn[mut touches](reg: machinst::Reg, role: machinst::Role) -> machinst::Reg {
            if reg == x64::RSP {
                touches = true
            }
            return reg
        })
    }
    return touches
} addresses_stack

/// The scratch registers of a class: `r11` and `r10`, or `xmm15` and `xmm14`.
fn scratch(float: bool, index: u32) -> machinst::Reg
    requires index < 2
{
    if float {
        return x64::xmm(15 - index)
    }
    return machinst::Reg(index: 11 - index)
} scratch

/// The state of emission: the code encoded so far, the runs of source locations, and the spill
/// slot whose value each scratch register holds, `NONE` for none.
struct Emitter {
    asm: x64::Assembler
    isa: Isa
    frame: Frame
    calls: bool
    locations: mem::List[Located]
    loc: clif::SourceLoc
    held: Array[u32, SCRATCH_COUNT]
    /// The first of the allocation's saves across calls not emitted yet.
    next_save: usize
    alloc: mem::Alloc
} Emitter

/// The scratch registers, by the index `held` follows them at.
fn scratch_at(index: usize) -> machinst::Reg
    requires index < SCRATCH_COUNT
{
    return scratch(index >= 2, index: u32.fit(index % 2))
} scratch_at

/// The scratch registers by the index `held` follows them at.
fn x64_scratches() -> Array[machinst::Reg, SCRATCH_COUNT] {
    var regs = Array[machinst::Reg, SCRATCH_COUNT].filled(NO_REG)
    for index in 0..<SCRATCH_COUNT {
        regs[index] = scratch_at(index)
    }
    return regs
} x64_scratches

/// The index of a scratch register in `held`, none for another register.
fn scratch_index(reg: machinst::Reg) -> Option[usize] {
    for index in 0..<SCRATCH_COUNT {
        if scratch_at(index) == reg {
            return Some(index)
        }
    }
    return None
} scratch_index

/// Records the spill slot a register holds, `NONE` for none, forgetting it for any other scratch
/// register.
fn Emitter.hold(mut self, reg: machinst::Reg, slot: u32) {
    if slot != NONE {
        mut self.forget_slot(slot)
    }
    match scratch_index(reg) {
        Some(index) => {
            expect index < SCRATCH_COUNT
            self.held[index] = slot
        }
        None => {}
    }
} Emitter.hold

/// Forgets that any scratch register holds a slot.
fn Emitter.forget_slot(mut self, slot: u32) {
    for index in 0..<SCRATCH_COUNT {
        if self.held[index] == slot {
            self.held[index] = NONE
        }
    }
} Emitter.forget_slot

/// Whether a register holds a spill slot's value.
fn Emitter.holds(self, reg: machinst::Reg, slot: u32) -> bool {
    let Some(index) = scratch_index(reg) else {
        return false
    }
    expect index < SCRATCH_COUNT
    return self.held[index] == slot
} Emitter.holds

fn emit(code: VCode[x64::Inst], allocation: Allocation, isa: Isa, alloc: mem::Alloc) -> Code {
    var emitter = Emitter(asm: x64::Assembler.new(alloc), isa: isa, frame: Frame.of(code, allocation), calls: code.calls, locations: mem::List[Located].empty(alloc), loc: clif::DEFAULT_LOC, held: Array[u32, SCRATCH_COUNT].filled(NONE), next_save: 0, alloc: alloc)
    for _ in 0..<(code.blocks.len() + code.table_count()) {
        discard mut emitter.asm.new_label()
    }
    mut emitter.prologue()
    for index in 0..<code.blocks.len() {
        mut emitter.block(code, allocation, block: u32.fit(index))
    }
    mut emitter.tables(code)
    let Emitter(asm: asm, isa: _, frame: frame, calls: _, locations: locations, loc: _, held: _, next_save: _, alloc: _) = emitter
    let encoded = take asm.finish()
    var moved = mem::List[Located].empty(alloc)
    for located in locations {
        mut moved.push(Located(offset: encoded.moved(located.offset), loc: located.loc))
    }
    let x64::Encoded(bytes: bytes, relocs: relocs, cuts: _) = encoded
    return Code(bytes: take bytes, align: FUNCTION_ALIGN, relocs: take relocs, frame: frame.size, locations: take moved, removable: false)
} emit

fn Emitter.put(mut self, inst: x64::Inst) {
    mut self.asm.emit(inst)
} Emitter.put

/// Starts the run of code of a source location, dropping a run that holds no code.
fn Emitter.locate(mut self, loc: clif::SourceLoc) {
    if loc == self.loc {
        return
    }
    self.loc = loc
    let offset = self.asm.offset()
    let count = self.locations.len()
    if count > 0 and self.locations[count - 1].offset == offset {
        discard mut self.locations.pop()
    }
    let last = self.locations.len()
    if loc.is_default() or (last > 0 and self.locations[last - 1].loc == loc) {
        return
    }
    mut self.locations.push(Located(offset: offset, loc: loc))
} Emitter.locate

/// Sets up the frame: links it into the frame pointer chain, probes the pages it spans when it
/// reaches the guard page size, saves the callee-saved registers the code changes and reserves
/// the rest, aligned as the stack slots ask.
fn Emitter.prologue(mut self) {
    mut self.put(x64::Inst.Push(reg: x64::RBP))
    mut self.put(x64::Inst.Mov(dst: x64::RBP, src: x64::RSP))
    if self.isa.probes {
        mut self.probe()
    }
    for index in 0u32..<SAVED_REG_COUNT {
        if self.frame.saved.contains(saved_reg(index)) {
            mut self.put(x64::Inst.Push(reg: saved_reg(index)))
        }
    }
    let body = i32.fit(self.frame.body)
    if body > 0 {
        mut self.put(x64::Inst.AluImm(op: x64::AluOp.Sub, size: x64::Size.Qword, dst: x64::RSP, imm: body))
    }
    mut self.vector_saves(restore: false)
    let align = i32.fit(self.frame.align)
    if align > 16 {
        mut self.put(x64::Inst.AluImm(op: x64::AluOp.And, size: x64::Size.Qword, dst: x64::RSP, imm: -align))
    }
} Emitter.prologue

/// Touches each guard-page-sized step of the stack the frame and a callee's linkage span: at most
/// four steps unrolled, more in a loop.
fn Emitter.probe(mut self) {
    var total = u32.truncate(self.frame.size) - 16
    if self.calls {
        total += 16
    }
    let count = total / GUARD
    if count == 0 {
        return
    }
    let span = i32.fit(count * GUARD)
    if count <= 4 {
        for _ in 0u32..<count {
            mut self.put(x64::Inst.AluImm(op: x64::AluOp.Sub, size: x64::Size.Qword, dst: x64::RSP, imm: i32.fit(GUARD)))
            mut self.put(x64::Inst.StoreImm(size: x64::Size.Dword, imm: 0, dst: x64::Amode.at(x64::RSP, disp: 0)))
        }
    } else {
        mut self.put(x64::Inst.Mov(dst: x64::R11, src: x64::RSP))
        mut self.put(x64::Inst.AluImm(op: x64::AluOp.Sub, size: x64::Size.Qword, dst: x64::R11, imm: span))
        let again = mut self.asm.new_label()
        mut self.asm.bind(again)
        mut self.put(x64::Inst.AluImm(op: x64::AluOp.Sub, size: x64::Size.Qword, dst: x64::RSP, imm: i32.fit(GUARD)))
        mut self.put(x64::Inst.StoreImm(size: x64::Size.Dword, imm: 0, dst: x64::Amode.at(x64::RSP, disp: 0)))
        mut self.put(x64::Inst.Cmp(size: x64::Size.Qword, lhs: x64::RSP, rhs: x64::R11))
        mut self.put(x64::Inst.Jcc(cond: x64::Cond.NotEqual, label: again))
    }
    mut self.put(x64::Inst.AluImm(op: x64::AluOp.Add, size: x64::Size.Qword, dst: x64::RSP, imm: span))
} Emitter.probe

/// Stores each saved SSE register below the pushed general-purpose ones, or loads it back.
fn Emitter.vector_saves(mut self, restore: bool) {
    var below = pushed_bytes(self.frame.saved)
    for number in 0u32..<16 {
        invariant below <= 56 + (16 * number)
        let reg = x64::xmm(number)
        if not self.frame.saved.contains(reg) {
            continue
        }
        below += 16
        let place = x64::Amode.at(x64::RBP, disp: -i32.fit(below))
        if restore {
            mut self.put(x64::Inst.VectorLoad(dst: reg, src: place))
        } else {
            mut self.put(x64::Inst.VectorStore(src: reg, dst: place))
        }
    }
} Emitter.vector_saves

/// Restores the callee-saved registers and the caller's frame, and returns.
fn Emitter.epilogue(mut self) {
    mut self.vector_saves(restore: true)
    let pushed = i32.fit(pushed_bytes(self.frame.saved))
    let body = i32.fit(self.frame.body)
    if self.frame.align > 16 {
        mut self.put(x64::Inst.Lea(dst: x64::RSP, src: x64::Amode.at(x64::RBP, disp: -pushed)))
    } else if body > 0 {
        mut self.put(x64::Inst.AluImm(op: x64::AluOp.Add, size: x64::Size.Qword, dst: x64::RSP, imm: body))
    }
    for back in 0u32..<SAVED_REG_COUNT {
        let reg = saved_reg(SAVED_REG_COUNT - 1 - back)
        if self.frame.saved.contains(reg) {
            mut self.put(x64::Inst.Pop(reg: reg))
        }
    }
    mut self.put(x64::Inst.Pop(reg: x64::RBP))
    mut self.put(x64::Inst.Ret(results: machinst::RegSet.empty()))
} Emitter.epilogue

/// A block's code: its label bound, its instructions, and its exit, the jump to the block laid
/// out next left out and a conditional jump to it inverted.
fn Emitter.block(mut self, code: VCode[x64::Inst], allocation: Allocation, block: u32)
    requires usize.widen(block) < code.blocks.len()
{
    let data = code.blocks[usize.widen(block)]
    expect code.holds(data)
    mut self.asm.bind(block)
    self.held = Array[u32, SCRATCH_COUNT].filled(NONE)
    if self.frame.cold > 0 and ends_in_trap(code, block: data) and addresses_stack(code, block: data) {
        mut self.put(x64::Inst.AluImm(op: x64::AluOp.Sub, size: x64::Size.Qword, dst: x64::RSP, imm: i32.fit(self.frame.cold)))
    }
    let next = block + 1
    var at = data.begin
    while at < data.end {
        let vinst = code.insts[usize.widen(at)]
        mut self.locate(vinst.loc)
        match vinst.inst {
            x64::Inst.Jmp(label: label) => {
                mut self.edge_moves(code, allocation, data)
                if label != next {
                    if label != block and copyable(code, block: label, within: COPIED_INSTS) {
                        mut self.copy_block(code, allocation, block: label, from: block, within: COPIED_INSTS)
                    } else {
                        mut self.put(vinst.inst)
                    }
                }
            }
            x64::Inst.Jcc(cond: cond, label: label) => {
                expect at + 1 < data.end
                let x64::Inst.Jmp(label: other) = code.insts[usize.widen(at + 1)].inst else {
                    mut self.put(vinst.inst)
                    at += 1
                    continue
                }
                if label == next and at + 2 == data.end and not is_jcc(code, at: at, begin: data.begin) {
                    mut self.put(x64::Inst.Jcc(cond: cond.invert(), label: other))
                    at += 2
                    continue
                }
                mut self.put(vinst.inst)
            }
            x64::Inst.Ret(results: _) => mut self.epilogue()
            x64::Inst.JumpTable(index: index, base: base, temp: temp, table: table) => mut self.instruction(code, allocation, inst: x64::Inst.JumpTable(index: index, base: base, temp: temp, table: u32.fit(code.blocks.len()) + table))
            x64::Inst.Call(target: _, args: _, results: _, clobbers: _) => mut self.saved_call(code, allocation, inst: vinst.inst, at)
            else => mut self.instruction(code, allocation, inst: vinst.inst)
        }
        at += 1
    }
} Emitter.block

/// A copy of a block `copyable` allows, in place of a jump to it from block `from`: its
/// instructions, then its jumps to the blocks other than the one after `from`, the conditional
/// one taken to an earlier block when neither target follows, and a jump replaced by a copy of
/// its target too while the copies hold at most `within` instructions.
fn Emitter.copy_block(mut self, code: VCode[x64::Inst], allocation: Allocation, block: u32, from: u32, within: u32)
    requires usize.widen(block) < code.blocks.len()
{
    let data = code.blocks[usize.widen(block)]
    expect code.holds(data) and data.end - data.begin <= within
    self.held = Array[u32, SCRATCH_COUNT].filled(NONE)
    let next = from + 1
    let left = within - (data.end - data.begin)
    var at = data.begin
    while at < data.end {
        let vinst = code.insts[usize.widen(at)]
        mut self.locate(vinst.loc)
        match vinst.inst {
            x64::Inst.Jmp(label: label) => {
                mut self.edge_moves(code, allocation, data)
                if label != next {
                    if label != from and label != block and copyable(code, block: label, within: left) {
                        mut self.copy_block(code, allocation, block: label, from: from, within: left)
                    } else {
                        mut self.put(vinst.inst)
                    }
                }
            }
            x64::Inst.Jcc(cond: cond, label: label) => {
                expect at + 1 < data.end
                let ends = at + 2 == data.end and data.arg_count == 0 and not is_jcc(code, at: at, begin: data.begin)
                let x64::Inst.Jmp(label: other) = code.insts[usize.widen(at + 1)].inst else {
                    mut self.put(vinst.inst)
                    at += 1
                    continue
                }
                if not ends {
                    mut self.put(vinst.inst)
                    at += 1
                    continue
                }
                if label == next {
                    mut self.put(x64::Inst.Jcc(cond: cond.invert(), label: other))
                } else if other == next {
                    mut self.put(vinst.inst)
                } else if other <= from and label > from {
                    mut self.put(x64::Inst.Jcc(cond: cond.invert(), label: other))
                    mut self.put(x64::Inst.Jmp(label: label))
                } else {
                    mut self.put(vinst.inst)
                    mut self.put(x64::Inst.Jmp(label: other))
                }
                at += 2
                continue
            }
            else => mut self.instruction(code, allocation, inst: vinst.inst)
        }
        at += 1
    }
} Emitter.copy_block

/// Whether a jump to a block is replaced by a copy of it: a block other than the entry of at most
/// `within` instructions that, besides its jumps, only compute registers and flags.
fn copyable(code: VCode[x64::Inst], block: u32, within: u32) -> bool {
    if block == 0 or usize.widen(block) >= code.blocks.len() {
        return false
    }
    let data = code.blocks[usize.widen(block)]
    if data.end - data.begin > within {
        return false
    }
    for at in data.begin..<data.end {
        expect usize.widen(at) < code.insts.len()
        let inst = code.insts[usize.widen(at)].inst
        match inst {
            x64::Inst.Jmp(label: _) or x64::Inst.Jcc(cond: _, label: _) => {}
            else => {
                if not inst.is_pure() {
                    return false
                }
            }
        }
    }
    return true
} copyable

/// The most instructions of the blocks a jump to them is replaced by.
const COPIED_INSTS: u32 = 4

/// A call, the registers saved across it stored to their slots before it and loaded after.
fn Emitter.saved_call(mut self, code: VCode[x64::Inst], allocation: Allocation, inst: x64::Inst, at: u32) {
    let begin = self.next_save
    var last = begin
    while last < allocation.saves.len() and allocation.saves[last].at == at {
        last += 1
    }
    for index in begin..<last {
        let save = allocation.saves[index]
        mut self.move_loc(Loc.Slot(slot_of(allocation, vreg: save.vreg)), src: Loc.Reg(save.reg), float: code.is_float(save.reg))
    }
    mut self.instruction(code, allocation, inst)
    for index in begin..<last {
        let save = allocation.saves[index]
        mut self.move_loc(Loc.Reg(save.reg), src: Loc.Slot(slot_of(allocation, vreg: save.vreg)), float: code.is_float(save.reg))
    }
    self.next_save = last
} Emitter.saved_call

/// The jump tables after the code, each 4-byte aligned at its label, the labels of blocks after
/// the blocks' own.
fn Emitter.tables(mut self, code: VCode[x64::Inst]) {
    for table in 0..<code.table_count() {
        mut self.asm.align4()
        let start = self.asm.offset()
        mut self.asm.bind(u32.fit(code.blocks.len() + table))
        expect table + 1 < code.table_starts.len()
        for at in code.table_starts[table]..<code.table_starts[table + 1] {
            expect usize.widen(at) < code.table_blocks.len()
            mut self.asm.table_entry(code.table_blocks[usize.widen(at)], start)
        }
    }
} Emitter.tables

/// Whether the instruction before `at` in its block is a conditional jump.
fn is_jcc(code: VCode[x64::Inst], at: u32, begin: u32) -> bool
    requires begin <= at and usize.widen(at) < code.insts.len()
{
    if at == begin {
        return false
    }
    return match code.insts[usize.widen(at - 1)].inst {
        x64::Inst.Jcc(cond: _, label: _) => true
        else => false
    }
} is_jcc

fn Emitter.slot(self, slot: u32) -> x64::Amode {
    return x64::Amode.at(x64::RSP, disp: i32.fit(self.frame.spills + (8 * slot)))
} Emitter.slot

/// Copies between two locations of one class, through `r10` from slot to slot; a load into a
/// scratch register holding the slot is left out.
fn Emitter.move_loc(mut self, dst: Loc, src: Loc, float: bool) {
    if dst == src {
        return
    }
    var load = x64::LoadKind.Qword
    if float {
        load = x64::LoadKind.Float64
    }
    match dst {
        Loc.Reg(to) => match src {
            Loc.Reg(from_reg) => {
                mut self.put(x64::Inst.Mov(dst: to, src: from_reg))
                mut self.hold(to, slot: NONE)
            }
            Loc.Slot(slot) => {
                if self.holds(to, slot) {
                    return
                }
                let mem = self.slot(slot)
                mut self.put(x64::Inst.Load(kind: load, dst: to, src: mem))
                mut self.hold(to, slot)
            }
        }
        Loc.Slot(to_slot) => {
            let target = self.slot(to_slot)
            match src {
                Loc.Reg(from_reg) => {
                    mut self.put(x64::Inst.Store(size: x64::Size.Qword, src: from_reg, dst: target))
                    mut self.forget_slot(to_slot)
                    mut self.hold(from_reg, slot: to_slot)
                }
                Loc.Slot(slot) => {
                    let mem = self.slot(slot)
                    mut self.put(x64::Inst.Load(kind: x64::LoadKind.Qword, dst: x64::R10, src: mem))
                    mut self.put(x64::Inst.Store(size: x64::Size.Qword, src: x64::R10, dst: target))
                    mut self.forget_slot(to_slot)
                    mut self.hold(x64::R10, slot: to_slot)
                }
            }
        }
    }
} Emitter.move_loc

/// The moves passing a block's jump arguments to its target's parameters, as one parallel move:
/// each copy made once nothing still to be read sits in its destination, a cycle broken by
/// saving one destination in the class's first scratch register.
fn Emitter.edge_moves(mut self, code: VCode[x64::Inst], allocation: Allocation, data: VBlock) {
    if data.arg_count == 0 {
        return
    }
    let succs = code.block_succs(data)
    expect succs.len() > 0 and usize.widen(succs[0]) < code.blocks.len()
    let args = code.block_args(data)
    let params = code.block_params(code.blocks[usize.widen(succs[0])])
    expect args.len() <= params.len()
    var moves = mem::List[Move].empty(self.alloc)
    for index in 0..<args.len() {
        let arg = args[index]
        let param = params[index]
        let src = location(allocation, reg: arg)
        let dst = location(allocation, reg: param)
        if src != dst {
            mut moves.push(Move(dst: dst, src: src, float: code.is_float(arg)))
        }
    }
    while moves.len() > 0 {
        var progressed = false
        var index: usize = 0
        while index < moves.len() {
            let candidate = moves[index]
            if is_read(moves, at: candidate.dst, except: index) {
                index += 1
                continue
            }
            mut self.move_loc(candidate.dst, src: candidate.src, float: candidate.float)
            discard mut moves.remove(index)
            progressed = true
        }
        if not progressed {
            expect moves.len() > 0
            let blocked = moves[0].dst
            let saved = Loc.Reg(scratch(moves[0].float, index: 0))
            mut self.move_loc(saved, src: blocked, float: moves[0].float)
            for pending in mut moves {
                if pending.src == blocked {
                    pending.src = saved
                }
            }
        }
    }
} Emitter.edge_moves

/// An instruction with its allocated registers: a move between locations directly, a store whose
/// value, base and index are all spilled through its address computed first, any other with
/// each spilled operand in a scratch register, loaded before when read and stored after when
/// written.
fn Emitter.instruction(mut self, code: VCode[x64::Inst], allocation: Allocation, inst: x64::Inst) {
    match inst {
        x64::Inst.Mov(dst: dst, src: src) => {
            mut self.move_loc(location(allocation, reg: dst), src: location(allocation, reg: src), float: code.is_float(dst))
            return
        }
        x64::Inst.Store(size: size, src: src, dst: x64::Amode.Mem(base: base, index: Some(index), shift: shift, disp: disp)) => {
            if is_spilled(allocation, reg: src) and is_spilled(allocation, reg: base) and is_spilled(allocation, reg: index) and src != base and src != index and base != index {
                let address = scratch(false, index: 1)
                mut self.instruction(code, allocation, inst: x64::Inst.Lea(dst: address, src: x64::Amode.Mem(base: base, index: Some(index), shift: shift, disp: disp)))
                mut self.instruction(code, allocation, inst: x64::Inst.Store(size: size, src: src, dst: x64::Amode.at(address, disp: 0)))
                return
            }
        }
        else => {}
    }
    var operands = mem::List[Operand].empty(self.alloc)
    discard inst.map_regs(fn[mut operands](reg: machinst::Reg, role: machinst::Role) -> machinst::Reg {
        mut operands.push(Operand(reg: reg, role: role, assigned: reg))
        return reg
    })
    assign_scratch(mut operands, code, allocation, sequence: inst.is_sequence(), scratches: x64_scratches())
    for index in 0..<operands.len() {
        let operand = operands[index]
        if is_spilled(allocation, reg: operand.reg) and is_first(operands, at: index, read: true) {
            mut self.move_loc(Loc.Reg(operand.assigned), src: location(allocation, reg: operand.reg), float: code.is_float(operand.reg))
        }
    }
    var next: usize = 0
    let rewritten = inst.map_regs(fn[mut next](reg: machinst::Reg, role: machinst::Role) -> machinst::Reg {
        expect next < operands.len()
        let assigned = operands[next].assigned
        next += 1
        return assigned
    })
    mut self.put(rewritten)
    let clobbers = rewritten.clobbers()
    for index in 0..<SCRATCH_COUNT {
        if clobbers.contains(scratch_at(index)) {
            self.held[index] = NONE
        }
    }
    for operand in operands {
        if operand.role != machinst::Role.Use {
            mut self.hold(operand.assigned, slot: NONE)
        }
    }
    for index in 0..<operands.len() {
        let operand = operands[index]
        if is_spilled(allocation, reg: operand.reg) and is_first(operands, at: index, read: false) {
            mut self.move_loc(location(allocation, reg: operand.reg), src: Loc.Reg(operand.assigned), float: code.is_float(operand.reg))
        }
    }
} Emitter.instruction
