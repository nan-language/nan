//! The firmware services of the UEFI targets, reached through the system table the program entry seam recorded and called under the firmware's convention on the boot stack: the services `uefi_platform` implements over its calls, the end of boot services, after which the image runs on its own entry root and descriptor tables, the hand-off to a loaded bare image, and the time.

/// The offsets in the system table of its runtime services and its boot services; in the
/// runtime services of `GetTime`; in the boot services of `GetMemoryMap` and
/// `ExitBootServices`.
const RUNTIME_SERVICES: u64 = 88

const BOOT_SERVICES: u64 = 96

const GET_TIME: u64 = 24

const GET_MEMORY_MAP: u64 = 56

const EXIT_BOOT_SERVICES: u64 = 232

/// The statuses `exit_services` and `GetTime` tell apart, an error's having its high bit set.
const EFI_SUCCESS: i64 = 0

const EFI_BUFFER_TOO_SMALL: i64 = i64.from_bits(0x8000_0000_0000_0005)

/// The descriptors of slack a memory map buffer holds for the entries the firmware adds before
/// the map is read into it.
const MAP_SLACK: i64 = 8

/// `m.with_services(body)`: calls `body` with the firmware's services, a view, and returns its
/// result or forwards its failure.
fn firmware_with_services(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let body_ty = fn_param(lo, supply, index: 1)
    let called = mut lo.call_value(mut fx, fn_ty: body_ty, function: supply.param(1).address_value(), args: Array[Held, 1].filled(Held.Empty).view())
    hw_forward(mut lo, mut fx, supply, called)
} firmware_with_services

/// `services.f(...)`: calls the function `f` of `uefi_platform` with the arguments after the
/// services, giving its result or forwarding its failure.
fn firmware_service(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    var args = mem::List[Held].empty(fx.alloc)
    for index in 1..<supply.params.len() {
        mut args.push(supply.param(index))
    }
    let called = mut lo.platform_call(mut fx, name: supply.member(), args: args.view())
    hw_forward(mut lo, mut fx, supply, called)
} firmware_service

/// `services.free(take region)`: calls `uefi_platform::free` with the region's base and length.
fn firmware_free(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let held = supply.param(1).address_value()
    let base = mut fx.load(PTR, addr: held, offset: REGION_BASE)
    let len = mut fx.load(PTR, addr: held, offset: REGION_LEN)
    var args = mem::List[Held].empty(fx.alloc)
    mut args.push(Held.Scalar(base))
    mut args.push(Held.Scalar(len))
    let called = mut lo.platform_call(mut fx, name: "free", args: args.view())
    hw_forward(mut lo, mut fx, supply, called)
} firmware_free

/// `take m.enter(take image)`: hands the image to `uefi_platform::hand_off` with the machine's
/// root allocator; it never returns.
fn firmware_enter(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let machine = supply.param(0).address_value()
    let at = boot_field(mut lo, supply, field_name: "alloc")
    let alloc = mut fx.offset(machine, offset: at)
    var args = mem::List[Held].empty(fx.alloc)
    mut args.push(Held.Address(alloc))
    mut args.push(supply.param(1))
    discard mut lo.platform_call(mut fx, name: "hand_off", args: args.view())
    mut fx.b.trap(clif::TrapCode(user: 1))
} firmware_enter

/// The operations `uefi_platform` declares without a body: a call of a firmware function with
/// five arguments, the system table and image handle the entry seam recorded, a region from its
/// base and length, the content-blind copy of Untrusted bytes to an address, the cleaning of a
/// range from the data caches, the jump into a loaded bare image and a trap of exhausted memory.
fn firmware_platform(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let arch = lo.ck.db().target.arch()
    match supply.path.as_str() {
        "uefi_platform::call" => {
            let function = supply.param(0).scalar_value()
            var args = mem::List[clif::Value].empty(fx.alloc)
            for index in 1usize..<6 {
                mut args.push(supply.param(index).scalar_value())
            }
            let status = firmware_call(arch, mut fx, code: function, args: args.view())
            supply.ret(mut lo, mut fx, held: Held.Scalar(status))
        }
        "uefi_platform::system_table" => {
            let table = system_table(mut lo, mut fx)
            supply.ret(mut lo, mut fx, held: Held.Scalar(table))
        }
        "uefi_platform::image_handle" => {
            let state_address = mut lo.state(mut fx)
            let image = mut fx.load(PTR, addr: state_address, offset: STATE_PLATFORM)
            supply.ret(mut lo, mut fx, held: Held.Scalar(image))
        }
        "uefi_platform::region" => {
            let held = mut fx.slot(16, align: 8)
            mut fx.store(supply.param(0).scalar_value(), addr: held, offset: REGION_BASE)
            mut fx.store(supply.param(1).scalar_value(), addr: held, offset: REGION_LEN)
            let result = mut lo.held_at(mut fx, ty: supply.abi.result, address: held)
            supply.ret(mut lo, mut fx, held: result)
        }
        "uefi_platform::place" => {
            let contents = supply.param(0).address_value()
            let start = mut fx.load(PTR, addr: contents, offset: 0)
            let len = mut fx.load(PTR, addr: contents, offset: 8)
            let at = supply.param(1).scalar_value()
            discard mut lo.call_routine(mut fx, routine: Routine.Copy, args: fx.list3(at, b: start, c: len).view())
            supply.done(mut lo, mut fx)
        }
        "uefi_platform::clean" => {
            if arch == Some(workspace::Arch.Aarch64) {
                let range = fx.list2(supply.param(0).scalar_value(), b: supply.param(1).scalar_value())
                discard mut lo.call_stub(mut fx, stub: Stub.CleanCache, args: range.view())
            }
            supply.done(mut lo, mut fx)
        }
        "uefi_platform::jump" => {
            let entry = supply.param(0).scalar_value()
            let info = supply.param(1).scalar_value()
            let tree = supply.param(2).scalar_value()
            let page = supply.param(3).scalar_value()
            mut lo.enter_image(mut fx, entry, info, tree, page)
        }
        "uefi_platform::exhausted" => raise_kind(mut lo, mut fx, kind: "trap.exhausted")
        else => {
            expect false
        }
    }
} firmware_platform

/// `take m.exit_services()`: reads the firmware's final memory map into a runtime record the
/// runtime state keeps, in a record grown while the map does not fit it, and ends boot services
/// with its key, reading the map again while they refuse; then, with maskable interrupts
/// disabled, extends the entry root over usable memory above 4 GiB and installs it, on x86_64
/// with the boot CPU's descriptor tables and AVX enabled when the CPU has it, on AArch64 with the
/// memory attributes and translation control the entry root needs; and gives the machine's
/// `boot::Kernel`, which holds what the `boot::Machine` held.
fn exit_services(mut lo: Lowering, mut fx: Fx, supply: Supply)
    waive length "the final memory map, the end of boot services and the switch to the entry root, in order"
{
    let arch = lo.ck.db().target.arch()
    let machine = supply.param(0).address_value()
    let table = system_table(mut lo, mut fx)
    let services = mut fx.load(PTR, addr: table, offset: BOOT_SERVICES)
    let get_map = mut fx.load(PTR, addr: services, offset: GET_MEMORY_MAP)
    let exit = mut fx.load(PTR, addr: services, offset: EXIT_BOOT_SERVICES)
    let size = mut fx.slot(8, align: 8)
    let key = mut fx.slot(8, align: 8)
    let stride = mut fx.slot(8, align: 8)
    let version = mut fx.slot(8, align: 8)
    let platform_state = mut lo.state(mut fx)
    let image = mut fx.load(PTR, addr: platform_state, offset: STATE_PLATFORM)
    let zero_value = mut fx.ptr(0)
    let ended = mut fx.repeat(Array[clif::Value, 2].filled(zero_value).view(), body: fn[mut lo](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() > 1
        let map = current[0]
        let room = current[1]
        mut fx1.store(room, addr: size, offset: 0)
        var map_args = Array[clif::Value, 5].filled(size)
        map_args[1] = map
        map_args[2] = key
        map_args[3] = stride
        map_args[4] = version
        let status = firmware_call(arch, fx: mut fx1, code: get_map, args: map_args.view())
        let short = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: status, y: EFI_BUFFER_TOO_SMALL)
        var results = Array[clif::Type, 3].filled(PTR)
        results[2] = clif::Type.Int8
        let next = mut fx1.choose_in(mut lo, condition: short, results: results.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            mut lo2.record_free(mut fx2, address: map)
            let needed = mut fx2.load(PTR, addr: size, offset: 0)
            let described = mut fx2.load(PTR, addr: stride, offset: 0)
            let slack = mut fx2.b.imul_imm_s(described, y: MAP_SLACK)
            let grown_room = mut fx2.b.iadd(needed, y: slack)
            let grown_map = mut lo2.record_alloc(mut fx2, size: grown_room)
            let missing = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: grown_map, y: 0)
            mut fx2.if_true(missing, then: fn[mut lo2](mut fx3: Fx) {
                raise_kind(mut lo2, fx: mut fx3, kind: "trap.exhausted")
            })
            var produced = mem::List[clif::Value].empty(fx2.alloc)
            mut produced.push(grown_map)
            mut produced.push(grown_room)
            mut produced.push(mut fx2.int(clif::Type.Int8, value: 1))
            return produced
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let current_key = mut fx2.load(PTR, addr: key, offset: 0)
            var exit_args = Array[clif::Value, 2].filled(image)
            exit_args[1] = current_key
            let exit_status = firmware_call(arch, fx: mut fx2, code: exit, args: exit_args.view())
            let refused = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: exit_status, y: EFI_SUCCESS)
            var produced = mem::List[clif::Value].empty(fx2.alloc)
            mut produced.push(map)
            mut produced.push(room)
            mut produced.push(refused)
            return produced
        })
        var state = mem::List[clif::Value].empty(fx1.alloc)
        mut state.push(next[0])
        mut state.push(next[1])
        return Pass(again: next[2], next: take state)
    })
    let map = ended[0]
    discard mut lo.call_stub(mut fx, stub: Stub.Cli, args: mem::List[clif::Value].empty(fx.alloc).view())
    let state_address = mut lo.state(mut fx)
    mut fx.store(map, addr: state_address, offset: STATE_MEMORY_MAP)
    let used = mut fx.load(PTR, addr: size, offset: 0)
    mut fx.store(used, addr: state_address, offset: STATE_MAP_SIZE)
    let described = mut fx.load(PTR, addr: stride, offset: 0)
    mut fx.store(described, addr: state_address, offset: STATE_MAP_STRIDE)
    mut lo.extend_entry_root(mut fx)
    let root_data = mut lo.entry_root()
    let root = mut lo.data_address(mut fx, id: root_data)
    if arch == Some(workspace::Arch.Aarch64) {
        discard mut lo.call_stub(mut fx, stub: Stub.Cli, args: mem::List[clif::Value].empty(fx.alloc).view())
        discard mut lo.call_stub(mut fx, stub: Stub.EnterRoot, args: Array[clif::Value, 1].filled(root).view())
    } else {
        discard mut lo.call_stub(mut fx, stub: Stub.WriteCr3, args: Array[clif::Value, 1].filled(root).view())
        let boot = mut lo.cpu_records(mut fx)
        mut lo.load_cpu_tables(mut fx, record: boot)
        discard mut lo.call_stub(mut fx, stub: Stub.EnableAvx, args: mem::List[clif::Value].empty(fx.alloc).view())
    }
    let Some(kernel) = supply.sret else {
        expect false
        return
    }
    let Some(grant) = supply.owner else {
        expect false
        return
    }
    let laid = mut lo.layout_of(grant)
    mut lo.copy(mut fx, dst: kernel, src: machine, size: laid.contents().size, align: laid.contents().align)
    supply.ret(mut lo, mut fx, held: Held.Address(kernel))
} exit_services

/// The firmware's time from `GetTime`: whether it gave one, its year, month, day, hour, minute
/// and second, and its nanoseconds.
struct FirmwareTime derives Copy {
    valid: clif::Value
    fields: Array[clif::Value, 6]
    nanoseconds: clif::Value
} FirmwareTime

/// Reads the firmware's time through `GetTime`.
fn firmware_time(mut lo: Lowering, mut fx: Fx) -> FirmwareTime {
    let arch = lo.ck.db().target.arch()
    let table = system_table(mut lo, mut fx)
    let services = mut fx.load(PTR, addr: table, offset: RUNTIME_SERVICES)
    let reader = mut fx.load(PTR, addr: services, offset: GET_TIME)
    let time = mut fx.slot(16, align: 8)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: time, offset: 0)
    mut fx.store(zero, addr: time, offset: 8)
    var call_args = Array[clif::Value, 2].filled(time)
    call_args[1] = zero
    let status = firmware_call(arch, mut fx, code: reader, args: call_args.view())
    let valid = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: status, y: EFI_SUCCESS)
    let year_bits = mut fx.load(clif::Type.Int16, addr: time, offset: 0)
    let year = mut fx.b.uextend(PTR, x: year_bits)
    var fields = Array[clif::Value, 6].filled(year)
    for index in 1usize..<6 {
        let byte = mut fx.load(clif::Type.Int8, addr: time, offset: u64.widen(index) + 1)
        fields[index] = mut fx.b.uextend(PTR, x: byte)
    }
    let nanosecond_bits = mut fx.load(clif::Type.Int32, addr: time, offset: 8)
    let nanoseconds = mut fx.b.uextend(PTR, x: nanosecond_bits)
    return FirmwareTime(valid: valid, fields: fields, nanoseconds: nanoseconds)
} firmware_time

/// The system table the program entry seam recorded.
fn system_table(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    return mut fx.load(PTR, addr: state_address, offset: STATE_PLATFORM_TABLE)
} system_table

/// Calls a firmware function at an address under the firmware's convention, giving its status:
/// the Microsoft x64 convention on x86_64 and the Procedure Call Standard on AArch64. The
/// firmware runs on the boot stack, outside the task-stack accounting, as a stub does.
fn firmware_call(arch: Option[workspace::Arch], mut fx: Fx, code: clif::Value, args: Slice[clif::Value]) -> clif::Value {
    let convention = if arch == Some(workspace::Arch.Aarch64) {
        clif::CallConv.SystemV
    } else {
        clif::CallConv.WindowsFastcall
    }
    var signature = clif::Signature.new(convention, alloc: fx.alloc)
    for _ in 0..<args.len() {
        mut signature.params.push(clif::AbiParam(value_type: PTR))
    }
    mut signature.returns.push(clif::AbiParam(value_type: PTR))
    let sig_ref = mut fx.b.import_signature(take signature)
    let call = mut fx.b.call_indirect(sig_ref, callee: code, args)
    mut fx.sites.push(CallSite(inst: call, site: Site(kind: StackKind.Stub, at: None)))
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() > 0
    return results[0]
} firmware_call
