test pool_remove_moves_the_entry_out for Pool.remove {
    var numbers = Pool[u8, Unit].empty(testing::world().alloc)
    let handle = mut numbers.insert(4)
    let removed = mut numbers.remove(handle)
    expect removed == 4
    expect not numbers.contains(handle)
} pool_remove_moves_the_entry_out

test pool_cursor_yields_live_entries for Pool.cursor {
    var numbers = Pool[u8, Unit].empty(testing::world().alloc)
    let freed = mut numbers.insert(1)
    discard mut numbers.insert(2)
    discard mut numbers.remove(freed)
    var total: u32 = 0
    for value in numbers {
        total += u32.widen(value)
    }
    expect total == 2
} pool_cursor_yields_live_entries

test make_mut_clones_shared_contents for Shared.make_mut {
    let world = testing::world()
    var owned = Shared.of(Bytes.zeroed(1, alloc: world.alloc), alloc: world.alloc)
    let shared = owned.share()
    var contents = mut owned.make_mut(clone: fn(value: Bytes, alloc: Alloc) -> Bytes {
        var copy = Bytes.empty(alloc)
        mut copy.append(value.view())
        return copy
    })
    mut contents.push(1)
    expect owned.contents().len() == 2
    expect shared.contents().len() == 1
} make_mut_clones_shared_contents

test entry_key_projects_the_key for Entry.key {
