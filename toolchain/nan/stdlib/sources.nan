const TEXT_SYS_SIM_SIM: Str =
    \\//! Simulated sys capabilities.
    \\
    \\pub fn fs(limit: usize, alloc: mem::Alloc) -> sys::Fs
    \\
    \\pub fn net() -> sys::Net
    \\
    \\pub fn random(seed: u64) -> sys::Random
    \\    example attempt random(7).next_u64() == Ok(14_742_688_630_346_610_928)
    \\
    \\pub fn stdio(input: Slice[u8], alloc: mem::Alloc) -> sys::Stdio
    \\
    \\test small_fs_refuses_a_large_write for fs {
    \\    let world = testing::world()
    \\    let small = fs(4, alloc: world.alloc)
    \\    let outcome = attempt await small.write_all("big", data: b"hello")
    \\    let full = match outcome {
    \\        Err(fs::FsError.NoSpace) => true
    \\        else => false
    \\    }
    \\    expect full
    \\} small_fs_refuses_a_large_write
    \\
    \\test loopback_reaches_no_other_host for net {
    \\    let loopback = net()
    \\    let outcome = attempt await loopback.connect("example.com", port: 80)
    \\    var unreachable = false
    \\    match outcome {
    \\        Ok(conn) => take conn.abandon()
    \\        Err(failure) => {
    \\            unreachable = match failure {
    \\                net::NetError.Unreachable => true
    \\                else => false
    \\            }
    \\        }
    \\    }
    \\    expect unreachable
    \\} loopback_reaches_no_other_host
    \\
    \\test random_yields_stream_two_of_its_seed for random {
    \\    let value = try random(7).next_u64()
    \\    expect value == 14_742_688_630_346_610_928
    \\} random_yields_stream_two_of_its_seed
