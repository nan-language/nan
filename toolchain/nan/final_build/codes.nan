//! The compiled code the build cache keeps across final builds and test images: an entry holding the code of every function a lowering compiled, and a record naming the entry the latest lowering of each program or tested package of a workspace under a target left.

/// The name of the record naming the entry of the code the latest lowering of `kind` for the
/// package `root` compiled in the workspace under the checker's target.
pkg fn codes_record(session: check::Session, checker: check::Checker, root: ty::PackageId, kind: Str, alloc: mem::Alloc) -> text::String {
    let db = checker.db()
    var keyed = mem::Bytes.empty(alloc)
    encoding::bytes(mut keyed, value: session.toolchain_hash().bytes.view())
    encoding::bytes(mut keyed, value: db.target.name().as_bytes())
    encoding::bytes(mut keyed, value: session.workspace.contents().root.as_bytes())
    encoding::bytes(mut keyed, value: kind.as_bytes())
    encoding::bytes(mut keyed, value: db.package_data(root).name.as_bytes())
    var name = text::String.of("codes-", alloc)
    mut name.append(hashing::HashValue.of(keyed.view()).full(alloc).as_str())
    return name
} codes_record

/// The contents of the entry a record names, empty when the cache holds none.
pkg fn kept_codes(session: check::Session, record: Str, alloc: mem::Alloc) -> mem::Bytes {
    let none = mem::Bytes.empty(alloc)
    let Some(user_cache) = user_cache_of(session, alloc) else {
        return none
    }
    let Some(key) = recorded_key(user_cache, record) else {
        return none
    }
    let Ok(found) = attempt user_cache.entry(key) else {
        return none
    }
    let Ok(Some(held)) = found else {
        return none
    }
    return held
} kept_codes

/// Keeps the code a lowering compiled anew: an entry under the hash of its kind, the toolchain's
/// hash and the keys of its functions, the record naming it, and the entry the record named
/// before dropped.
pkg fn keep_codes(session: check::Session, record: Str, lowered: lower::Lowered, alloc: mem::Alloc) {
    let Some(entry) = lowered.codes else {
        return
    }
    let Some(user_cache) = user_cache_of(session, alloc) else {
        return
    }
    var keyed = mem::Bytes.empty(alloc)
    encoding::bytes(mut keyed, value: b"codes 1")
    encoding::bytes(mut keyed, value: session.toolchain_hash().bytes.view())
    encoding::bytes(mut keyed, value: entry.inputs.bytes.view())
    let key = hashing::HashValue.of(keyed.view())
    let earlier = recorded_key(user_cache, record)
    let Ok(_) = attempt user_cache.put(key, contents: entry.contents.view()) else {
        return
    }
    let Ok(_) = attempt user_cache.replace(record, contents: key.bytes.view()) else {
        return
    }
    match earlier {
        Some(dropped) => if dropped != key {
            discard attempt user_cache.remove(dropped)
        }
        None => {}
    }
} keep_codes

fn user_cache_of(session: check::Session, alloc: mem::Alloc) -> Option[cache::Cache] {
    let Ok(opened) = attempt cache::Cache.open(cache::copied_override(session.home, alloc), alloc) else {
        return None
    }
    let Ok(user_cache) = opened else {
        return None
    }
    return Some(take user_cache)
} user_cache_of

/// The key a record names, none without a well-formed one.
fn recorded_key(user_cache: cache::Cache, record: Str) -> Option[hashing::HashValue] {
    let Ok(found) = attempt user_cache.record(record) else {
        return None
    }
    let Ok(Some(held)) = found else {
        return None
    }
    return hashing::HashValue.read(held.view())
} recorded_key
