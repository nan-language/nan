//! Reading the grammar notation of the ebnf blocks, and building the grammar's tables from it.

const START_RULE: Str = "item"

/// An atom of grammar notation.
enum Notation {
    Name(text::String)
    Quoted(text::String)
    Context(text::String)
    CodePoints(low: u32, high: u32)
    Group(mem::List[Seq])
} Notation

struct Elem {
    atom: Notation
    repeat: Repeat
} Elem

struct Seq {
    elems: mem::List[Elem]
    rejection: Option[text::String]
} Seq

/// A token of grammar notation; `DotDot` is the symbol `..`, `Sym` each other symbol.
enum Tok {
    Name(text::String)
    Quoted(text::String)
    Context(text::String)
    CodePoint(u32)
    Rejection(text::String)
    Sym(char)
    DotDot
} Tok

/// The grammar, its syntactic tables left to the first parse that needs them.
pkg fn Grammar.load(alloc: mem::Alloc) -> Grammar {
    return Grammar(lexicon: mem::Shared.of(Lexicon.load(alloc), alloc: alloc), syntactic: mem::OnceMap[u8, mem::Shared[Tables]].empty(seed: 0, alloc))
} Grammar.load

/// The grammar's syntactic tables, built at the first call.
fn Grammar.tables(self, alloc: mem::Alloc) -> mem::Shared[Tables] {
    match self.syntactic.get(0) {
        Some(built) => return built.share()
        None => {}
    }
    return self.syntactic.insert(0, value: mem::Shared.of(Tables.load(self.lexicon.share(), alloc), alloc: alloc)).share()
} Grammar.tables

/// Builds the lexer's tables, reading the ebnf blocks only up to the rules the rejected code
/// points follow from.
fn Lexicon.load(alloc: mem::Alloc) -> Lexicon {
    var rules = mem::HashMap[text::String, mem::List[Seq]].empty(seed: 0, alloc)
    var at: usize = 0
    while not (resolved(rules, name: "REJECTED", alloc) and resolved(rules, name: "REJECTED_SPACE", alloc)) {
        let toks = rule_tokens(EBNF, mut at, alloc)
        expect toks.len() > 0
        add_rule(mut rules, take toks, alloc)
    }
    return Lexicon(rejected: sorted_ranges(rules, name: "REJECTED", alloc), rejected_space: sorted_ranges(rules, name: "REJECTED_SPACE", alloc), punctuation: punctuation(alloc), keywords: keyword_table(alloc), context_words: context_table(alloc))
} Lexicon.load

/// Whether a lexical rule, and every rule it names, is among those read.
fn resolved(rules: mem::HashMap[text::String, mem::List[Seq]], name: Str, alloc: mem::Alloc) -> bool {
    let Some(seqs) = rules.get(text::String.of(name, alloc)) else {
        return false
    }
    for seq in seqs {
        for elem in seq.elems {
            match elem.atom {
                Notation.Name(inner) => {
                    if not resolved(rules, name: inner.as_str(), alloc) {
                        return false
                    }
                }
                else => {}
            }
        }
    }
    return true
} resolved

/// Builds the syntactic tables from the ebnf blocks, trapping when the grammar names a terminal,
/// a rule or a rejection code the enums of the syntax layer lack, or the enums hold one the
/// grammar does not.
fn Tables.load(take lexicon: mem::Shared[Lexicon], alloc: mem::Alloc) -> Tables {
    let rules = parse_grammar(EBNF, alloc)
    check_listed(spellings(rules, name: "HARD_KEYWORD", alloc), listed: keyword_spellings(alloc))
    check_listed(spellings(rules, name: "PUNCT", alloc), listed: punct_spellings(alloc))
    check_listed(spellings(rules, name: "FOREIGN", alloc), listed: foreign_spellings(alloc))
    var reach = Reach(order: mem::List[text::String].empty(alloc), context_words: mem::Set[text::String].empty(alloc))
    mut reach.reach(rules, name: text::String.of(START_RULE, alloc), alloc)
    var reached_words = mem::List[text::String].empty(alloc)
    for word in reach.context_words {
        mut reached_words.push(text::String.of(word.as_str(), alloc))
    }
    check_listed(reached_words, listed: context_spellings(alloc))
    var generator = Generator(rules: rule_ids(reach.order, alloc), choices: mem::List[mem::List[usize]].empty(alloc), seqs: mem::List[SeqDef].empty(alloc))
    var rule_choices = mem::List[usize].empty(alloc)
    for name in reach.order {
        mut rule_choices.push(mut generator.choice(rules.at(name), alloc))
    }
    var tables = Tables(lexicon: take lexicon, rule_choices: take rule_choices, choices: take generator.choices, seqs: take generator.seqs, analysis: Analysis.empty(alloc), choosing: mem::Bytes.empty(alloc))
    let analysis = Analysis.compute(tables, alloc)
    tables.analysis = analysis
    mut tables.plan_elems()
    tables.choosing = choosing(tables, alloc)
    return tables
} Tables.load

/// Traps unless an enum lists exactly the spellings a lexical rule or the reached rules list, in
/// their order.
fn check_listed(spelt: mem::List[text::String], listed: mem::List[text::String]) {
    expect spelt.len() == listed.len()
    for index in 0..<spelt.len() {
        expect spelt[index].as_str() == listed[index].as_str()
    }
} check_listed

fn keyword_spellings(alloc: mem::Alloc) -> mem::List[text::String] {
    var listed = mem::List[text::String].empty(alloc)
    for index in 0..<KEYWORDS {
        let Some(keyword) = Keyword.from_index(index) else {
            expect false
            return listed
        }
        mut listed.push(text::String.of(keyword.spelling(), alloc))
    }
    expect Keyword.from_index(KEYWORDS).is_none()
    return listed
} keyword_spellings

/// The hard keywords by the first byte of their spelling, below 128.
fn keyword_table(alloc: mem::Alloc) -> mem::List[mem::List[Spelled[Keyword]]] {
    var by_byte = mem::List[mem::List[Spelled[Keyword]]].empty(alloc)
    add_bytes(mut by_byte, alloc)
    for index in 0..<KEYWORDS {
        let Some(keyword) = Keyword.from_index(index) else {
            expect false
            return by_byte
        }
        add_word(mut by_byte, spelling: keyword.spelling(), word: keyword, alloc)
    }
    return by_byte
} keyword_table

/// The context words by the first byte of their spelling, below 128.
fn context_table(alloc: mem::Alloc) -> mem::List[mem::List[Spelled[ContextWord]]] {
    var by_byte = mem::List[mem::List[Spelled[ContextWord]]].empty(alloc)
    add_bytes(mut by_byte, alloc)
    for index in 0..<CONTEXTS {
        let Some(word) = ContextWord.from_index(index) else {
            expect false
            return by_byte
        }
        add_word(mut by_byte, spelling: word.spelling(), word, alloc)
    }
    return by_byte
} context_table

/// Adds an empty list of words for each byte below 128.
fn add_bytes[T](mut by_byte: mem::List[mem::List[Spelled[T]]], alloc: mem::Alloc) {
    for _ in 0..<128usize {
        mut by_byte.push(mem::List[Spelled[T]].empty(alloc))
    }
} add_bytes

/// Places a word among those its spelling's first byte starts.
fn add_word[T](mut by_byte: mem::List[mem::List[Spelled[T]]], spelling: Str, take word: T, alloc: mem::Alloc) {
    let bytes = spelling.as_bytes()
    expect bytes.len() > 0 and usize.widen(bytes[0]) < by_byte.len()
    var spelt = mem::Bytes.empty(alloc)
    mut spelt.append(bytes)
    var held = mut by_byte.at_mut(usize.widen(bytes[0]))
    mut held.push(Spelled(spelling: take spelt, word: take word))
} add_word

fn punct_spellings(alloc: mem::Alloc) -> mem::List[text::String] {
    var listed = mem::List[text::String].empty(alloc)
    for index in 0..<PUNCTS {
        let Some(punct) = Punct.from_index(index) else {
            expect false
            return listed
        }
        mut listed.push(text::String.of(punct.spelling(), alloc))
    }
    expect Punct.from_index(PUNCTS).is_none()
    return listed
} punct_spellings

/// The `Punct` and `Foreign` tokens by the first byte of their spelling, each byte's longest
/// first.
fn punctuation(alloc: mem::Alloc) -> mem::List[mem::List[PunctSpelling]] {
    var by_byte = mem::List[mem::List[PunctSpelling]].empty(alloc)
    for _ in 0..<128usize {
        mut by_byte.push(mem::List[PunctSpelling].empty(alloc))
    }
    for index in 0..<PUNCTS {
        let Some(punct) = Punct.from_index(index) else {
            expect false
            return by_byte
        }
        add_spelt(mut by_byte, kind: TokenKind.Punct(punct), spelling: punct.spelling(), alloc)
    }
    for index in 0..<FOREIGNS {
        let Some(spelt) = Foreign.from_index(index) else {
            expect false
            return by_byte
        }
        add_spelt(mut by_byte, kind: TokenKind.Foreign(spelt), spelling: spelt.spelling(), alloc)
    }
    return by_byte
} punctuation

/// Places a token among those its spelling's first byte starts, after every longer or as long.
fn add_spelt(mut by_byte: mem::List[mem::List[PunctSpelling]], kind: TokenKind, spelling: Str, alloc: mem::Alloc) {
    let bytes = spelling.as_bytes()
    expect bytes.len() > 0 and usize.widen(bytes[0]) < by_byte.len()
    var spelt = mem::Bytes.empty(alloc)
    mut spelt.append(bytes)
    var held = mut by_byte.at_mut(usize.widen(bytes[0]))
    var at: usize = 0
    while at < held.len() and held[at].spelling.len() >= bytes.len() {
        at += 1
    }
    mut held.insert(at, value: PunctSpelling(kind: kind, spelling: take spelt))
} add_spelt

fn foreign_spellings(alloc: mem::Alloc) -> mem::List[text::String] {
    var listed = mem::List[text::String].empty(alloc)
    for index in 0..<FOREIGNS {
        let Some(spelt) = Foreign.from_index(index) else {
            expect false
            return listed
        }
        mut listed.push(text::String.of(spelt.spelling(), alloc))
    }
    expect Foreign.from_index(FOREIGNS).is_none()
    return listed
} foreign_spellings

fn context_spellings(alloc: mem::Alloc) -> mem::List[text::String] {
    var listed = mem::List[text::String].empty(alloc)
    for index in 0..<CONTEXTS {
        let Some(word) = ContextWord.from_index(index) else {
            expect false
            return listed
        }
        mut listed.push(text::String.of(word.spelling(), alloc))
    }
    expect ContextWord.from_index(CONTEXTS).is_none()
    return listed
} context_spellings

/// Each reached rule by its name, trapping unless the rules of `Rule` are the reached ones, in
/// order of first reach.
fn rule_ids(order: mem::List[text::String], alloc: mem::Alloc) -> mem::HashMap[text::String, Rule] {
    var ids = mem::HashMap[text::String, Rule].empty(seed: 0, alloc)
    for index in 0..<order.len() {
        let Some(rule) = Rule.from_index(index) else {
            expect false
            return ids
        }
        expect rule.name() == order[index].as_str()
        discard mut ids.insert(text::String.of(rule.name(), alloc), value: rule)
    }
    expect Rule.from_index(order.len()).is_none()
    return ids
} rule_ids

/// Parses every rule of the ebnf blocks, written in the grammar notation of the charter.
fn parse_grammar(source: Str, alloc: mem::Alloc) -> mem::HashMap[text::String, mem::List[Seq]] {
    var rules = mem::HashMap[text::String, mem::List[Seq]].empty(seed: 0, alloc)
    var at: usize = 0
    loop {
        let toks = rule_tokens(source, mut at, alloc)
        if toks.len() == 0 {
            return rules
        }
        add_rule(mut rules, take toks, alloc)
    }
} parse_grammar

/// Parses the tokens of one rule, `name = choice ;`, into the rules read.
fn add_rule(mut rules: mem::HashMap[text::String, mem::List[Seq]], take toks: mem::List[Tok], alloc: mem::Alloc) {
    var parser = EbnfParser(toks: take toks, pos: 1)
    let Some(Tok.Name(defined)) = parser.toks.get(0) else {
        expect false
        return
    }
    let name = text::String.of(defined.as_str(), alloc)
    mut parser.expect_sym('=')
    let body = mut parser.choice(alloc)
    mut parser.expect_sym(';')
    expect parser.pos == parser.toks.len()
    let previous = mut rules.insert(take name, value: take body)
    expect previous.is_none()
} add_rule

/// Whether a character has the Unicode White_Space property.
fn is_whitespace(c: char) -> bool {
    return match c {
        '\t'..='\r' or ' ' or '\u{85}' or '\u{A0}' or '\u{1680}' or '\u{2000}'..='\u{200A}' => true
        '\u{2028}' or '\u{2029}' or '\u{202F}' or '\u{205F}' or '\u{3000}' => true
        else => false
    }
} is_whitespace

fn is_hex_digit(c: char) -> bool {
    return match c {
        '0'..='9' or 'a'..='f' or 'A'..='F' => true
        else => false
    }
} is_hex_digit

fn is_word_char(c: char) -> bool {
    return c.is_ascii_alphabetic() or c.is_ascii_digit() or c == '_'
} is_word_char

/// The tokens of the rule of grammar notation from byte `at` of `source` through its `;`, moving
/// `at` past them; none when only white space is left.
fn rule_tokens(source: Str, mut at: usize, alloc: mem::Alloc) -> mem::List[Tok] {
    let bytes = source.as_bytes()
    var toks = mem::List[Tok].empty(alloc)
    while at < bytes.len() {
        let Some(c) = text::utf8::char_at(bytes, at) else {
            expect false
            return toks
        }
        let next = char_after(bytes, at, c)
        if is_whitespace(c) {
            at += c.utf8_len()
        } else if c == 'U' and next == Some('+') {
            at += 2
            let from = at
            skip_while(bytes, mut at, kept: fn(found: char) => is_hex_digit(found))
            let Some(head) = bytes.prefix(at) else {
                expect false
                return toks
            }
            let Some(parts) = head.split_at(from) else {
                expect false
                return toks
            }
            let Some(value) = hex_value(parts.tail) else {
                expect false
                return toks
            }
            mut toks.push(Tok.CodePoint(value))
        } else if c.is_ascii_alphabetic() or c == '_' {
            let from = at
            skip_while(bytes, mut at, kept: fn(found: char) => is_word_char(found))
            mut toks.push(Tok.Name(collected(source, from, to: at, alloc)))
        } else if c == '"' or c == '\'' {
            at += 1
            let word = take_until(source, mut at, end: c, alloc)
            if c == '"' {
                mut toks.push(Tok.Quoted(take word))
            } else {
                mut toks.push(Tok.Context(take word))
            }
        } else if c == '{' and next == Some('!') {
            at += 2
            mut toks.push(Tok.Rejection(take_until(source, mut at, end: '}', alloc)))
        } else if c == '.' and next == Some('.') {
            mut toks.push(Tok.DotDot)
            at += 2
        } else {
            let symbol = match c {
                '=' or ';' or '|' or '?' or '*' or '+' or '-' or '(' or ')' => true
                else => false
            }
            expect symbol
            mut toks.push(Tok.Sym(c))
            at += 1
            if c == ';' {
                return toks
            }
        }
    }
    return toks
} rule_tokens

/// The character after `c`, which starts at byte `at`, if any.
fn char_after(bytes: Slice[u8], at: usize, c: char) -> Option[char] {
    expect at <= ~0usize - c.utf8_len()
    return text::utf8::char_at(bytes, at: at + c.utf8_len())
} char_after

/// Moves `at` past the characters that `kept` holds for.
fn skip_while(bytes: Slice[u8], mut at: usize, kept: fn(found: char) -> bool) {
    loop {
        let Some(c) = text::utf8::char_at(bytes, at) else {
            return
        }
        if not kept(c) {
            return
        }
        expect at <= ~0usize - c.utf8_len()
        at += c.utf8_len()
    }
} skip_while

/// The text of the bytes from `from` to before `to`.
fn collected(source: Str, from: usize, to: usize, alloc: mem::Alloc) -> text::String {
    let Some(run) = source.slice_bytes(from, end: to) else {
        expect false
        return text::String.empty(alloc)
    }
    return text::String.of(run, alloc)
} collected

/// The text from byte `at` to before the next `end`, leaving `at` after that `end`.
fn take_until(source: Str, mut at: usize, end: char, alloc: mem::Alloc) -> text::String {
    let from = at
    skip_while(source.as_bytes(), mut at, kept: fn(found: char) => found != end)
    expect at < source.byte_len()
    let run = collected(source, from, to: at, alloc)
    at += end.utf8_len()
    return run
} take_until

struct EbnfParser {
    toks: mem::List[Tok]
    pos: usize
} EbnfParser

fn EbnfParser.at_sym(self, sym: char) -> bool
    ensures not result or self.pos < self.toks.len()
{
    return match self.toks.get(self.pos) {
        Some(Tok.Sym(found)) => found == sym
        else => false
    }
} EbnfParser.at_sym

fn EbnfParser.at_dot_dot(self) -> bool
    ensures not result or self.pos < self.toks.len()
{
    return match self.toks.get(self.pos) {
        Some(Tok.DotDot) => true
        else => false
    }
} EbnfParser.at_dot_dot

fn EbnfParser.expect_sym(mut self, sym: char) {
    expect self.at_sym(sym)
    self.pos += 1
} EbnfParser.expect_sym

fn EbnfParser.choice(mut self, alloc: mem::Alloc) -> mem::List[Seq] {
    var alts = mem::List[Seq].empty(alloc)
    mut alts.push(mut self.sequence(alloc))
    while self.at_sym('|') {
        self.pos += 1
        mut alts.push(mut self.sequence(alloc))
    }
    return alts
} EbnfParser.choice

fn EbnfParser.sequence(mut self, alloc: mem::Alloc) -> Seq {
    var elems = mem::List[Elem].empty(alloc)
    while self.starts_atom() {
        let atom = mut self.atom(alloc)
        var repeat = Repeat.One
        if self.at_sym('?') {
            repeat = Repeat.Opt
            self.pos += 1
        } else if self.at_sym('*') {
            repeat = Repeat.Star
            self.pos += 1
        } else if self.at_sym('+') {
            repeat = Repeat.Plus
            self.pos += 1
        } else if self.at_sym('-') {
            self.pos += 1
            discard mut self.atom(alloc)
        }
        mut elems.push(Elem(atom: take atom, repeat: repeat))
    }
    expect elems.len() > 0
    var rejection: Option[text::String] = None
    match self.toks.get(self.pos) {
        Some(Tok.Rejection(code)) => {
            rejection = Some(text::String.of(code.as_str(), alloc))
            self.pos += 1
        }
        else => {}
    }
    return Seq(elems: take elems, rejection: take rejection)
} EbnfParser.sequence

fn EbnfParser.starts_atom(self) -> bool {
    return match self.toks.get(self.pos) {
        Some(Tok.Name(_)) or Some(Tok.Quoted(_)) or Some(Tok.Context(_)) or Some(Tok.CodePoint(_)) => true
        Some(Tok.Sym(sym)) => sym == '('
        else => false
    }
} EbnfParser.starts_atom

fn EbnfParser.atom(mut self, alloc: mem::Alloc) -> Notation {
    if self.at_sym('(') {
        self.pos += 1
        let alts = mut self.choice(alloc)
        mut self.expect_sym(')')
        return Notation.Group(take alts)
    }
    let atom = self.single_atom(alloc)
    self.pos += 1
    if not self.at_dot_dot() {
        return atom
    }
    self.pos += 1
    let upper = mut self.atom(alloc)
    let Notation.CodePoints(low: low, high: _) = atom else {
        return atom
    }
    let Notation.CodePoints(low: _, high: high) = upper else {
        return atom
    }
    return Notation.CodePoints(low: low, high: high)
} EbnfParser.atom

/// The atom the token at the position stands for, when it is no group.
fn EbnfParser.single_atom(self, alloc: mem::Alloc) -> Notation
    ensures self.pos < self.toks.len()
{
    match self.toks.get(self.pos) {
        Some(Tok.Name(name)) => return Notation.Name(text::String.of(name.as_str(), alloc))
        Some(Tok.Quoted(quoted)) => return Notation.Quoted(text::String.of(quoted.as_str(), alloc))
        Some(Tok.Context(word)) => return Notation.Context(text::String.of(word.as_str(), alloc))
        Some(Tok.CodePoint(value)) => return Notation.CodePoints(low: value, high: value)
        else => {}
    }
    expect false
    return Notation.CodePoints(low: 0, high: 0)
} EbnfParser.single_atom

/// The quoted alternatives of a lexical rule listing spellings, such as `PUNCT`.
fn spellings(rules: mem::HashMap[text::String, mem::List[Seq]], name: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var listed = mem::List[text::String].empty(alloc)
    for seq in rules.at(text::String.of(name, alloc)) {
        expect seq.elems.len() == 1
        let elem = seq.elems[0]
        expect elem.repeat == Repeat.One
        let Notation.Quoted(spelling) = elem.atom else {
            expect false
            return listed
        }
        mut listed.push(text::String.of(spelling.as_str(), alloc))
    }
    return listed
} spellings

/// The syntactic rules reachable from the start rule, in order of first reach, and the context
/// words they name.
struct Reach {
    order: mem::List[text::String]
    context_words: mem::Set[text::String]
} Reach

/// Lists the syntactic rules reachable from `name`, in order of first reach.
fn Reach.reach(mut self, rules: mem::HashMap[text::String, mem::List[Seq]], name: text::String, alloc: mem::Alloc) {
    for rule in self.order {
        if rule.as_str() == name.as_str() {
            return
        }
    }
    mut self.order.push(text::String.of(name.as_str(), alloc))
    let Some(body) = rules.get(name) else {
        expect false
        return
    }
    mut self.reach_seqs(rules, seqs: body, alloc)
} Reach.reach

fn Reach.reach_seqs(mut self, rules: mem::HashMap[text::String, mem::List[Seq]], seqs: mem::List[Seq], alloc: mem::Alloc) {
    for seq in seqs {
        for elem in seq.elems {
            match elem.atom {
                Notation.Name(name) => {
                    if is_rule_name(name.as_str()) {
                        mut self.reach(rules, name, alloc)
                    }
                }
                Notation.Context(word) => {
                    discard mut self.context_words.insert(text::String.of(word.as_str(), alloc))
                }
                Notation.Group(alts) => mut self.reach_seqs(rules, seqs: alts, alloc)
                else => {}
            }
        }
    }
} Reach.reach_seqs

/// The choices and sequences registered so far, by id, and each reached rule by its name.
struct Generator {
    rules: mem::HashMap[text::String, Rule]
    choices: mem::List[mem::List[usize]]
    seqs: mem::List[SeqDef]
} Generator

/// Registers a choice and its alternatives, returning its id.
fn Generator.choice(mut self, alts: mem::List[Seq], alloc: mem::Alloc) -> usize {
    let id = self.choices.len()
    mut self.choices.push(mem::List[usize].empty(alloc))
    var seq_ids = mem::List[usize].empty(alloc)
    for seq in alts {
        mut seq_ids.push(mut self.seq(seq, alloc))
    }
    expect id < self.choices.len()
    self.choices[id] = seq_ids
    return id
} Generator.choice

fn Generator.seq(mut self, seq: Seq, alloc: mem::Alloc) -> usize {
    let id = self.seqs.len()
    mut self.seqs.push(SeqDef(elems: mem::List[ElemDef].empty(alloc), rejection: None))
    var elems = mem::List[ElemDef].empty(alloc)
    for elem in seq.elems {
        mut elems.push(mut self.elem(elem, alloc))
    }
    var rejection: Option[diagnostic::Code] = None
    match seq.rejection {
        Some(code) => {
            let Some(named) = diagnostic::Code.from_name(code.as_str()) else {
                expect false
                return id
            }
            rejection = Some(named)
        }
        None => {}
    }
    expect id < self.seqs.len()
    self.seqs[id] = SeqDef(elems: take elems, rejection: rejection)
    return id
} Generator.seq

fn Generator.elem(mut self, elem: Elem, alloc: mem::Alloc) -> ElemDef {
    let atom = match elem.atom {
        Notation.Name(name) => self.named(name)
        Notation.Quoted(quoted) => quoted_term(quoted.as_str())
        Notation.Context(word) => context_term(word.as_str())
        Notation.Group(alts) => Atom.Group(mut self.choice(alts, alloc))
        Notation.CodePoints(low: _, high: _) => code_points_term()
    }
    return ElemDef(atom: atom, repeat: elem.repeat, choice: 0, starts: First.default(), opens: TermSet.default())
} Generator.elem

/// The alternatives each choice of a grammar offers a lookahead, as `Tables.choosing` holds them.
fn choosing(grammar: Tables, alloc: mem::Alloc) -> mem::Bytes {
    var table = mem::Bytes.zeroed(2 * CHOOSING_ROW * grammar.choices.len(), alloc)
    for choice in 0..<grammar.choices.len() {
        let row = choice * CHOOSING_ROW
        for alt in grammar.choices[choice] {
            expect alt < usize.widen(~0u16)
            let reached = grammar.analysis.seq(alt)
            let entry = u16.fit(alt) + 1
            reached.ok.mark_first(mut table.view_mut(), offset: row, entry)
            reached.rejected.mark_first(mut table.view_mut(), offset: row + TERMS, entry)
            let nullable_at = 2 * (row + 2 * TERMS)
            if reached.nullable and nullable_at + 2 <= table.len() and table.view().u16_le(nullable_at) == 0 {
                mut table.view_mut().write_u16_le(nullable_at, value: entry)
            }
        }
    }
    return table
} choosing

/// Records in each element the choice its atom expands and what can start it.
fn Tables.plan_elems(mut self) {
    for seq in 0..<self.seqs.len() {
        for at in 0..<self.seqs[seq].elems.len() {
            let elem = self.seqs[seq].elems[at]
            let choice = match elem.atom {
                Atom.Rule(rule) => rule.choice(self)
                Atom.Group(group) => group
                Atom.Term(_) => 0
            }
            let reached = self.analysis.atom(elem.atom, grammar: self)
            self.seqs[seq].elems[at].choice = choice
            var opens = reached.ok
            mut opens.union(reached.rejected)
            self.seqs[seq].elems[at].starts = reached
            self.seqs[seq].elems[at].opens = opens
        }
    }
} Tables.plan_elems

/// The atom a name stands for: a reached rule, or a token class.
fn Generator.named(self, name: text::String) -> Atom {
    if is_rule_name(name.as_str()) {
        let Some(rule) = self.rules.get(name) else {
            expect false
            return Atom.Rule(Rule.Item)
        }
        return Atom.Rule(rule)
    }
    for index in 0..<CLASSES {
        let Some(class) = Class.from_index(index) else {
            expect false
            return Atom.Rule(Rule.Item)
        }
        if class.name() == name.as_str() {
            return Atom.Term(Term.Class(class))
        }
    }
    expect false
    return Atom.Rule(Rule.Item)
} Generator.named

/// The terminal a quoted spelling stands for: a hard keyword, or a punctuation token.
fn quoted_term(quoted: Str) -> Atom {
    if is_word(quoted) {
        let Some(keyword) = Keyword.from_spelling(quoted.as_bytes()) else {
            expect false
            return Atom.Rule(Rule.Item)
        }
        return Atom.Term(Term.Keyword(keyword))
    }
    for index in 0..<PUNCTS {
        let Some(punct) = Punct.from_index(index) else {
            expect false
            return Atom.Rule(Rule.Item)
        }
        if punct.spelling() == quoted {
            return Atom.Term(Term.Punct(punct))
        }
    }
    expect false
    return Atom.Rule(Rule.Item)
} quoted_term

fn context_term(word: Str) -> Atom {
    let Some(context) = ContextWord.from_spelling(word.as_bytes()) else {
        expect false
        return Atom.Rule(Rule.Item)
    }
    return Atom.Term(Term.Context(context))
} context_term

/// Code points appear only in lexical rules.
fn code_points_term() -> Atom {
    expect false
    return Atom.Rule(Rule.Item)
} code_points_term

/// The code point ranges a lexical rule matches, following the rules it names, sorted.
fn sorted_ranges(rules: mem::HashMap[text::String, mem::List[Seq]], name: Str, alloc: mem::Alloc) -> mem::List[CodeRange] {
    var ranges = mem::List[CodeRange].empty(alloc)
    code_point_ranges(rules, name: text::String.of(name, alloc), mut ranges)
    mut ranges.sort_by(fn(left: CodeRange, right: CodeRange) => left.cmp(right))
    return ranges
} sorted_ranges

/// Adds the code point ranges a lexical rule matches, following the rules it names.
fn code_point_ranges(rules: mem::HashMap[text::String, mem::List[Seq]], name: text::String, mut ranges: mem::List[CodeRange]) {
    for seq in rules.at(name) {
        for elem in seq.elems {
            match elem.atom {
                Notation.CodePoints(low: low, high: high) => mut ranges.push(CodeRange(low: low, high: high))
                Notation.Name(inner) => code_point_ranges(rules, name: inner, mut ranges)
                else => {
                    expect false
                }
            }
        }
    }
} code_point_ranges

fn is_rule_name(name: Str) -> bool {
    var cursor = name.cursor()
    let Some(first_char) = mut cursor.next() else {
        return false
    }
    return first_char >= 'a' and first_char <= 'z'
} is_rule_name

fn is_word(spelling: Str) -> bool {
    var cursor = spelling.cursor()
    let Some(first_char) = mut cursor.next() else {
        return false
    }
    if not (first_char.is_ascii_alphabetic() or first_char == '_') {
        return false
    }
    loop {
        let Some(c) = mut cursor.next() else {
            return true
        }
        if not is_word_char(c) {
            return false
        }
    }
} is_word
