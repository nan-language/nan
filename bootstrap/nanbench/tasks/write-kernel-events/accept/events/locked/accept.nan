//! Acceptance tests of the event log.

/// An event of source 1 with `code`.
fn coded(code: u32) -> events::Event = events::Event(source: 1, code: code)

test events_come_out_oldest_first for events::Log.next {
    let log = hw::SpinLock.of(events::Log.empty())
    record_event(log, event: coded(7))
    record_event(log, event: events::Event(source: 2, code: 8))
    record_event(log, event: coded(9))
    let earliest = next_event(log)
    let middle = next_event(log)
    let latest = next_event(log)
    let nothing = next_event(log)
    expect earliest == Some(coded(7))
    expect middle == Some(events::Event(source: 2, code: 8))
    expect latest == Some(coded(9))
    expect nothing == None
} events_come_out_oldest_first

test a_full_log_drops_new_events for events::Log.record {
    let log = hw::SpinLock.of(events::Log.empty())
    for code in 0..<20u32 {
        record_event(log, event: coded(code))
    }
    let drops = dropped_events(log)
    var kept: u32 = 0
    var in_order = true
    loop {
        let Some(event) = next_event(log) else {
            break
        }
        if event.code != kept {
            in_order = false
        }
        kept += 1
    }
    expect drops == 4
    expect kept == 16
    expect in_order
} a_full_log_drops_new_events

test slots_are_reused_around_the_log for events::Log.record {
    let log = hw::SpinLock.of(events::Log.empty())
    for code in 0..<10u32 {
        record_event(log, event: coded(code))
    }
    for _ in 0..<6u32 {
        discard next_event(log)
    }
    for code in 100..<112u32 {
        record_event(log, event: coded(code))
    }
    let drops = dropped_events(log)
    var codes = mem::List[u32].empty(testing::world().alloc)
    loop {
        let Some(event) = next_event(log) else {
            break
        }
        mut codes.push(event.code)
    }
    expect drops == 0
    expect codes.len() == 16
    expect codes[0] == 6
    expect codes[3] == 9
    expect codes[4] == 100
    expect codes[15] == 111
} slots_are_reused_around_the_log

test drops_are_counted_for_every_refused_event for events::Log.dropped {
    var log = events::Log.empty()
    for code in 0..<40u32 {
        mut log.record(coded(code))
    }
    let first_drops = log.dropped()
    discard mut log.next()
    mut log.record(coded(99))
    mut log.record(coded(100))
    expect first_drops == 24
    expect log.dropped() == 25
} drops_are_counted_for_every_refused_event
