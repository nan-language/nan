pub fn F32x4.store(self, mut to: SliceMut[f32], at: usize) limits pure, notrap, terminates
    requires at <= to.len() and to.len() - at >= 4

pub fn F32x4.lane(self, index: usize) -> f32 limits pure, notrap, terminates
    requires index < 4
    example F32x4.splat(5.0).replace_lane(1, value: 6.0).lane(1) == 6.0
{
    return self.lanes[index]
} F32x4.lane

pub fn F32x4.replace_lane(self, index: usize, value: f32) -> F32x4 limits pure, notrap, terminates
    requires index < 4
    example F32x4.splat(5.0).replace_lane(0, value: 6.0).lane(1) == 5.0
{
    var lanes = self.lanes
    lanes[index] = value
    return F32x4(lanes: lanes)
} F32x4.replace_lane

pub fn F32x4.add(self, other: F32x4) -> F32x4 limits pure, notrap, terminates
    example F32x4.splat(1.5).add(F32x4.splat(2.0)).lane(0) == 3.5
{
    var lanes = self.lanes
    for index in 0..<4usize {
        lanes[index] = lanes[index] + other.lanes[index]
    }
    return F32x4(lanes: lanes)
} F32x4.add

pub fn F32x4.sub(self, other: F32x4) -> F32x4 limits pure, notrap, terminates
    example F32x4.splat(1.5).sub(F32x4.splat(2.0)).lane(0) == -0.5
{
    var lanes = self.lanes
    for index in 0..<4usize {
        lanes[index] = lanes[index] - other.lanes[index]
    }
    return F32x4(lanes: lanes)
} F32x4.sub

pub fn F32x4.mul(self, other: F32x4) -> F32x4 limits pure, notrap, terminates
    example F32x4.splat(1.5).mul(F32x4.splat(2.0)).lane(0) == 3.0
{
    var lanes = self.lanes
    for index in 0..<4usize {
        lanes[index] = lanes[index] * other.lanes[index]
    }
    return F32x4(lanes: lanes)
} F32x4.mul

pub fn F32x4.div(self, other: F32x4) -> F32x4 limits pure, notrap, terminates
    example F32x4.splat(0.0).div(F32x4.splat(0.0)).lane(0).to_bits() == 0x7FC0_0000
{
    var lanes = self.lanes
    for index in 0..<4usize {
        lanes[index] = lanes[index] / other.lanes[index]
    }
    return F32x4(lanes: lanes)
} F32x4.div

pub fn F32x4.min(self, other: F32x4) -> F32x4 limits pure, notrap, terminates
    example F32x4.splat(0.0).min(F32x4.splat(-0.0)).lane(0).to_bits() == 0x8000_0000
{
    var lanes = self.lanes
    for index in 0..<4usize {
        lanes[index] = minimum(lanes[index], other: other.lanes[index])
    }
    return F32x4(lanes: lanes)
} F32x4.min

pub fn F32x4.max(self, other: F32x4) -> F32x4 limits pure, notrap, terminates
    example F32x4.splat(1.0).max(F32x4.splat(0.0 / 0.0)).lane(0).to_bits() == 0x7FC0_0000
{
    var lanes = self.lanes
    for index in 0..<4usize {
        lanes[index] = maximum(lanes[index], other: other.lanes[index])
    }
    return F32x4(lanes: lanes)
} F32x4.max

pub fn F32x4.sqrt(self) -> F32x4 limits pure, notrap, terminates
    example F32x4.splat(2.25).sqrt().lane(2) == 1.5
{
    var lanes = self.lanes
    for index in 0..<4usize {
        lanes[index] = lanes[index].sqrt()
    }
    return F32x4(lanes: lanes)
} F32x4.sqrt

pub fn F32x4.lanes_eq(self, other: F32x4) -> Mask32x4 limits pure, notrap, terminates
    example not F32x4.splat(0.0 / 0.0).lanes_eq(F32x4.splat(0.0 / 0.0)).any()
{
    var lanes = Array[u32, 4].filled(0)
    for index in 0..<4usize {
        if self.lanes[index] == other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask32x4(lanes: lanes)
} F32x4.lanes_eq

pub fn F32x4.lanes_lt(self, other: F32x4) -> Mask32x4 limits pure, notrap, terminates
    example F32x4.splat(-0.5).lanes_lt(F32x4.splat(0.0)).all()
{
    var lanes = Array[u32, 4].filled(0)
    for index in 0..<4usize {
        if self.lanes[index] < other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask32x4(lanes: lanes)
} F32x4.lanes_lt

pub fn F32x4.lanes_gt(self, other: F32x4) -> Mask32x4 limits pure, notrap, terminates
    example not F32x4.splat(-0.0).lanes_gt(F32x4.splat(0.0)).any()
{
    var lanes = Array[u32, 4].filled(0)
    for index in 0..<4usize {
        if self.lanes[index] > other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask32x4(lanes: lanes)
} F32x4.lanes_gt

pub fn F32x4.select(mask: Mask32x4, if_true: F32x4, if_false: F32x4) -> F32x4 limits pure, notrap, terminates
    example F32x4.select(F32x4.splat(1.0).lanes_lt(F32x4.splat(2.0)), if_true: F32x4.splat(3.0), if_false: F32x4.splat(4.0)).lane(0) == 3.0
{
    var lanes = if_false.lanes
    for index in 0..<4usize {
        let chosen = mask.lanes[index]
        lanes[index] = f32.from_bits((if_true.lanes[index].to_bits() & chosen) | (if_false.lanes[index].to_bits() & ~chosen))
    }
    return F32x4(lanes: lanes)
} F32x4.select

pub fn F32x4.sum(self) -> f32 limits pure, notrap, terminates
    example F32x4.splat(1.0).replace_lane(0, value: 100_000_000.0).replace_lane(2, value: -100_000_000.0).sum() == 0.0
{
    return (self.lanes[0] + self.lanes[1]) + (self.lanes[2] + self.lanes[3])
} F32x4.sum

pub fn F32x4.from_i32x4(value: I32x4) -> F32x4 limits pure, notrap, terminates
    example F32x4.from_i32x4(I32x4.splat(16_777_217)).lane(0) == 16_777_216.0
{
    var lanes = Array[f32, 4].filled(0.0)
    for index in 0..<4usize {
        lanes[index] = f32.nearest(value.lanes[index])
    }
    return F32x4(lanes: lanes)
} F32x4.from_i32x4

pub fn F32x4.to_i32x4(self) -> I32x4 limits pure, notrap, terminates
    example F32x4.splat(-2.5).replace_lane(1, value: 3_000_000_000.0).replace_lane(2, value: 0.0 / 0.0).to_i32x4() == I32x4.splat(-2).replace_lane(1, value: 2_147_483_647).replace_lane(2, value: 0)
{
    var lanes = Array[i32, 4].filled(0)
    for index in 0..<4usize {
        lanes[index] = i32.saturate(self.lanes[index])
    }
    return I32x4(lanes: lanes)
} F32x4.to_i32x4

pub fn F32x4.to_bytes(self) -> U8x16 limits pure, notrap, terminates
    example F32x4.splat(-0.0).to_bytes().lane(3) == 0x80
{
    var bits = Array[u32, 4].filled(0)
    for index in 0..<4usize {
        bits[index] = self.lanes[index].to_bits()
    }
    return U32x4(lanes: bits).to_bytes()
} F32x4.to_bytes

pub fn F32x4.from_bytes(bytes: U8x16) -> F32x4 limits pure, notrap, terminates
    example F32x4.from_bytes(U8x16.splat(0)).lane(0) == 0.0
{
    let bits = U32x4.from_bytes(bytes)
    var lanes = Array[f32, 4].filled(0.0)
    for index in 0..<4usize {
        lanes[index] = f32.from_bits(bits.lanes[index])
    }
    return F32x4(lanes: lanes)
} F32x4.from_bytes

/// 8 lanes of IEEE 754 binary16 values, held as their bit patterns.
pub open struct F16x8 derives Copy {
    lanes: Array[u16, 8]
} F16x8

pub fn F16x8.of_bits(bits: Array[u16, 8]) -> F16x8 limits pure, notrap, terminates
    example F16x8.of_bits(Array[u16, 8].filled(0x3C00)).widen_low().lane(0) == 1.0
{
    return F16x8(lanes: bits)
} F16x8.of_bits

pub fn F16x8.to_bits(self) -> Array[u16, 8] limits pure, notrap, terminates
    example F16x8.narrow(F32x4.splat(1.0), high: F32x4.splat(-2.0)).to_bits()[4] == 0xC000
{
    return self.lanes
} F16x8.to_bits

pub fn F16x8.load(from: Slice[u16], at: usize) -> F16x8 limits pure, notrap, terminates
    requires at <= from.len() and from.len() - at >= 8
    example F16x8.load(Array[u16, 9].filled(0x3C00).view(), at: 1).widen_high().lane(3) == 1.0
{
    var lanes = Array[u16, 8].filled(0)
    for index in at..<(at + 8) {
        lanes[index - at] = from[index]
    }
    return F16x8(lanes: lanes)
} F16x8.load

pub fn F16x8.store(self, mut to: SliceMut[u16], at: usize) limits pure, notrap, terminates
    requires at <= to.len() and to.len() - at >= 8

pub fn F16x8.to_bytes(self) -> U8x16 limits pure, notrap, terminates
    example F16x8.of_bits(Array[u16, 8].filled(0x3C00)).to_bytes().lane(1) == 0x3C
{
    return U16x8(lanes: self.lanes).to_bytes()
} F16x8.to_bytes

pub fn F16x8.from_bytes(bytes: U8x16) -> F16x8 limits pure, notrap, terminates
    example F16x8.from_bytes(U8x16.splat(0)).to_bits()[7] == 0
{
    return F16x8(lanes: U16x8.from_bytes(bytes).lanes)
} F16x8.from_bytes

pub fn F16x8.widen_low(self) -> F32x4 limits pure, notrap, terminates
    example F16x8.of_bits(Array[u16, 8].filled(0x0001)).widen_low().lane(0).to_bits() == 0x3380_0000
{
    var lanes = Array[f32, 4].filled(0.0)
    for index in 0..<4usize {
        lanes[index] = f32.from_bits(widened(self.lanes[index]))
    }
    return F32x4(lanes: lanes)
} F16x8.widen_low

pub fn F16x8.widen_high(self) -> F32x4 limits pure, notrap, terminates
    example F16x8.of_bits(Array[u16, 8].filled(0x7C01)).widen_high().lane(0).to_bits() == 0x7FC0_0000
{
    var lanes = Array[f32, 4].filled(0.0)
    for index in 0..<4usize {
        lanes[index] = f32.from_bits(widened(self.lanes[index + 4]))
    }
    return F32x4(lanes: lanes)
} F16x8.widen_high

pub fn F16x8.narrow(low: F32x4, high: F32x4) -> F16x8 limits pure, notrap, terminates
    example F16x8.narrow(F32x4.splat(65_520.0), high: F32x4.splat(0.00000001)).to_bits()[0] == 0x7C00
    example F16x8.narrow(F32x4.splat(1.00048828125), high: F32x4.splat(0.0)).to_bits()[0] == 0x3C00
{
    var lanes = Array[u16, 8].filled(0)
    for index in 0..<4usize {
        lanes[index] = narrowed(low.lanes[index].to_bits())
        lanes[index + 4] = narrowed(high.lanes[index].to_bits())
    }
    return F16x8(lanes: lanes)
} F16x8.narrow

/// IEEE 754 minimum: a NaN when either is one, and `-0.0` below `0.0`.
fn minimum(value: f32, other: f32) -> f32 limits pure, notrap, terminates {
    if value.is_nan() or other.is_nan() {
        return value + other
    }
    if value < other {
        return value
    }
    if other < value {
        return other
    }
    return f32.from_bits(value.to_bits() | other.to_bits())
} minimum

/// IEEE 754 maximum: a NaN when either is one, and `0.0` above `-0.0`.
fn maximum(value: f32, other: f32) -> f32 limits pure, notrap, terminates {
    if value.is_nan() or other.is_nan() {
        return value + other
    }
    if value > other {
        return value
    }
    if other > value {
        return other
    }
    return f32.from_bits(value.to_bits() & other.to_bits())
} maximum

/// The binary32 pattern of a binary16 one, exact, a NaN giving the canonical NaN.
fn widened(half: u16) -> u32 limits pure, notrap, terminates {
    let sign = u32.widen(half >> 15) << 31
    let exponent = u32.widen((half >> 10) & 0x1F)
    var fraction = u32.widen(half & 0x3FF)
    if exponent == 0x1F {
        if fraction != 0 {
            return 0x7FC0_0000
        }
        return sign | 0x7F80_0000
    }
    if exponent == 0 {
        if fraction == 0 {
            return sign
        }
        var shift = 0u32
        for _ in 0..<10u32 {
            if (fraction & 0x400) == 0 {
                fraction = fraction << 1
                shift = shift.wrapping_add(1)
            }
        }
        return sign | (113u32.wrapping_sub(shift) << 23) | ((fraction & 0x3FF) << 13)
    }
    return sign | (exponent.wrapping_add(112) << 23) | (fraction << 13)
} widened

/// The binary16 pattern nearest a binary32 one, ties to even, a NaN giving the canonical NaN
/// `0x7E00`.
fn narrowed(bits: u32) -> u16 limits pure, notrap, terminates {
    let sign = u16.truncate(bits >> 16) & 0x8000
    let exponent = (bits >> 23) & 0xFF
    let fraction = bits & 0x7F_FFFF
    if exponent == 0xFF {
        if fraction != 0 {
            return 0x7E00
        }
        return sign | 0x7C00
    }
    if exponent >= 143 {
        return sign | 0x7C00
    }
    if exponent >= 113 {
        let kept = (exponent.wrapping_sub(112) << 10) | (fraction >> 13)
        let rest = fraction & 0x1FFF
        var rounded = kept
        if rest > 0x1000 or (rest == 0x1000 and (kept & 1) == 1) {
            rounded = rounded.wrapping_add(1)
        }
        return sign | u16.truncate(rounded)
    }
    if exponent < 102 {
        return sign
    }
    let significand = fraction | 0x80_0000
    let shift = 126 - exponent
    let kept = significand >> shift
    let rest = significand & (1u32 << shift).wrapping_sub(1)
    let half = 1u32 << (shift - 1)
    var rounded = kept
    if rest > half or (rest == half and (kept & 1) == 1) {
        rounded = rounded.wrapping_add(1)
    }
    return sign | u16.truncate(rounded)
} narrowed

test store_writes_the_lanes_u8x16 for U8x16.store {
    var out = Array[u8, 17].filled(0)
    U8x16.splat(3).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[16] == 3
} store_writes_the_lanes_u8x16

test store_writes_the_lanes_i8x16 for I8x16.store {
    var out = Array[i8, 17].filled(0)
    I8x16.splat(3).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[16] == 3
} store_writes_the_lanes_i8x16

test store_writes_the_lanes_u16x8 for U16x8.store {
    var out = Array[u16, 9].filled(0)
    U16x8.splat(3).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[8] == 3
} store_writes_the_lanes_u16x8

test store_writes_the_lanes_i16x8 for I16x8.store {
    var out = Array[i16, 9].filled(0)
    I16x8.splat(3).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[8] == 3
} store_writes_the_lanes_i16x8

test store_writes_the_lanes_u32x4 for U32x4.store {
    var out = Array[u32, 5].filled(0)
    U32x4.splat(3).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[4] == 3
} store_writes_the_lanes_u32x4

test store_writes_the_lanes_i32x4 for I32x4.store {
    var out = Array[i32, 5].filled(0)
    I32x4.splat(3).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[4] == 3
} store_writes_the_lanes_i32x4

test store_writes_the_lanes_u64x2 for U64x2.store {
    var out = Array[u64, 3].filled(0)
    U64x2.splat(3).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[2] == 3
} store_writes_the_lanes_u64x2

test store_writes_the_lanes_i64x2 for I64x2.store {
    var out = Array[i64, 3].filled(0)
    I64x2.splat(3).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[2] == 3
} store_writes_the_lanes_i64x2

test store_writes_the_lanes_f32x4 for F32x4.store {
    var out = Array[f32, 5].filled(0.0)
    F32x4.splat(1.5).store(mut out.view_mut(), at: 1)
    expect out[0] == 0.0 and out[4] == 1.5
} store_writes_the_lanes_f32x4

test store_writes_the_lanes_f16x8 for F16x8.store {
    var out = Array[u16, 9].filled(0)
    F16x8.of_bits(Array[u16, 8].filled(0x3C00)).store(mut out.view_mut(), at: 1)
    expect out[0] == 0 and out[8] == 0x3C00
} store_writes_the_lanes_f16x8
