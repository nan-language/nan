    \\pub fn Set.contains(self, value: T) -> bool limits pure, notrap, terminates
    \\    example not Set[u8].empty(testing::world().alloc).contains(1)
    \\{
    \\    return self.contains_by(fn(stored: T) => stored.cmp(value))
