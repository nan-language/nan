//! The controller's cause registers and the ring of buffers it filled.

pub layout Causes: u32 le {
    received: bit 0
    sent: bit 1
    link: bit 2
    error: bit 3
    reserved: rest
} Causes

pub registers NicRegs {
    causes: Causes at 0x0 write_one_clear
    mask: Causes at 0x4 read write
} NicRegs

pub layout UsedEntry: bytes 8 le {
    id: u32 at 0
    length: u32 at 4
} UsedEntry

pub layout UsedRing: bytes 68 le {
    index: u16 at 0
    pad: u16 at 2
    entries: Array[UsedEntry, 8] at 4
} UsedRing

/// Acknowledges the raised causes that the mask enables, and gives them.
pub fn take_causes(mut regs: hw::Mmio[NicRegs]) -> Causes {
    let raised = mut regs.read(NicRegs.causes)
    let enabled = mut regs.read(NicRegs.mask)
    let handled = Causes.from_bits(raised.to_bits() & enabled.to_bits())
    mut regs.write(NicRegs.causes, value: handled)
    return handled
} take_causes

/// The bytes of the used entries from number `seen` up to the index the controller published,
/// entries being numbered modulo 2^16 and entry n lying in slot n mod 8.
pub fn received_bytes(mut ring: hw::DmaShared[UsedRing], seen: u16) -> u64 {
    let published = mut ring.read_acquire(UsedRing.index)
    var total: u64 = 0
    var at = seen
    while at != published {
        let entry = mut ring.read_acquire_at(UsedRing.entries, index: usize.widen(at % 8))
        total += u64.widen(entry.length)
        at = at.wrapping_add(1)
    }
    return total
} received_bytes
