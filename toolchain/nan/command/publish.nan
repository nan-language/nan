//! `nan publish --local <dir>`: runs the release gate on the package in `<dir>`, moves the tombstones of its source into its history, builds its artefact, signed with `--as`, and appends it to the local store as a named release whose parent is the history head.

/// `nan publish`.
fn publish_run(invocation: Invocation, session: check::Session, current: Str, trace: Trace, alloc: mem::Alloc) -> output::Output fails platform::IoError {
    let written = invocation.joined_args(alloc)
    let held = session.workspace.contents()
    let Some(index) = local_package(invocation, held) else {
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: written.as_str(), alloc)
    }
    var breaking = invocation.listed("--breaking", alloc)
    let reason = mut breaking.pop()
    let unsigned_authors = invocation.value("--as").is_none() and invocation.listed("--author", alloc).len() > 0
    if invocation.listed("--breaking", alloc).len() == 1 or unsigned_authors {
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: written.as_str(), alloc)
    }
    trace.scoped(written.as_str(), alloc)
    let Some(source) = held.package_at(index) else {
        expect false
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: written.as_str(), alloc)
    }
    let Some(manifest) = source.manifest else {
        expect false
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: written.as_str(), alloc)
    }
    var manifest_path = text::String.of(source.dir.as_str(), alloc)
    mut manifest_path.append("/package.nan")
    let signing = match try release_signing(invocation, session, source, alloc) {
        Ok(chosen) => chosen
        Err(reported) => {
            var refused = mem::List[diagnostic::Diagnostic].empty(alloc)
            mut refused.push(take reported)
            return refusal(invocation, written: written.as_str(), session, index, diagnostics: refused.view(), alloc)
        }
    }
    var packages = mem::List[usize].empty(alloc)
    mut packages.push(index)
    let gate = try judged(session, packages: packages.view(), authors: signing.authors.view())
    if gate.diagnostics.len() > 0 or gate.report.failures.len() > 0 {
        let std = session.std()
        var records = mem::List[output::Record].empty(alloc)
        for reported in gate.diagnostics {
            mut records.push(record(held, std, scope: scope::Scope.Package(index), reported, alloc))
        }
        for failing in take fail_records(held, scope: scope::Scope.Package(index), report: gate.report, alloc) {
            mut records.push(take failing)
        }
        return publish_output(invocation, written: written.as_str(), take records, diagnostics: gate.diagnostics.view(), changes: mem::List[journal::Change].empty(alloc).view(), alloc)
    }
    var refused = mem::List[diagnostic::Diagnostic].empty(alloc)
    for dep in manifest.deps {
        if dep.path {
            mut refused.push(diagnostic::Diagnostic.at(diagnostic::Code.VersionPathDependency, path: manifest_path.as_str(), line: dep.line, alloc))
        }
    }
    let user_cache = match try cache::Cache.open(cache::copied_override(session.home, alloc), alloc) {
        Ok(opened) => opened
        Err(exposed) => {
            mut refused.push(exposed_diagnostic(take exposed, alloc))
            return refusal(invocation, written: written.as_str(), session, index, diagnostics: refused.view(), alloc)
        }
    }
    let local_store = store::Store.new(user_cache.store())
    let read = match try local_store.entries() {
        Ok(found) => found
        Err(exposed) => {
            mut refused.push(exposed_diagnostic(take exposed, alloc))
            return refusal(invocation, written: written.as_str(), session, index, diagnostics: refused.view(), alloc)
        }
    }
    let staged = staged_release(invocation, source, take read, take breaking, take reason, refused: mut refused, alloc)
    if refused.len() > 0 {
        return refusal(invocation, written: written.as_str(), session, index, diagnostics: refused.view(), alloc)
    }
    return try published(invocation, written: written.as_str(), session, index, take staged, local_store, take signing, alloc)
} publish_run

/// The index of the workspace package in the directory `--local` names, without its trailing
/// `/`.
fn local_package(invocation: Invocation, held: workspace::Workspace) -> Option[usize] {
    let local = match invocation.value("--local") {
        Some(given) => given
        None => ""
    }
    let local_bytes = local.as_bytes()
    var dir_end: usize = 0
    for step in 0..<local_bytes.len() {
        let at = local_bytes.len() - step
        if local_bytes[at - 1] != b'/' {
            dir_end = at
            break
        }
    }
    let Some(dir) = local.slice_bytes(0, end: dir_end) else {
        return None
    }
    return held.package_position(fn(candidate: workspace::Package) => candidate.dir.as_str() == dir)
} local_package

/// The publisher of a release published with `--as`: its principal and secret key.
struct ReleaseSigner {
    principal: text::String
    secret: core::crypto::SecretKey
} ReleaseSigner

/// How a release is signed: by its publisher, when `--as` names one, naming its author
/// principals.
struct ReleaseSigning {
    signer: Option[ReleaseSigner]
    authors: mem::List[text::String]
} ReleaseSigning

/// How `--as` and `--author` sign a release: its author principals, the `--author` ones or the
/// publisher alone, in byte order; or why the package is not published.
fn release_signing(invocation: Invocation, session: check::Session, source: workspace::Package, alloc: mem::Alloc) -> Result[ReleaseSigning, diagnostic::Diagnostic] fails platform::IoError {
    var authors = mem::List[text::String].empty(alloc)
    for author in invocation.listed("--author", alloc) {
        if not check::lists_principal(authors.view(), principal: author.as_str()) {
            mut authors.push(text::String.of(author.as_str(), alloc))
        }
    }
    let Some(principal) = invocation.value("--as") else {
        return Ok(ReleaseSigning(signer: None, authors: take authors))
    }
    if authors.len() == 0 {
        mut authors.push(text::String.of(principal, alloc))
    }
    mut authors.sort_by(fn(left: text::String, right: text::String) => left.as_str().cmp(right.as_str()))
    let secret = match try publishing_key(session, source, publisher: principal, authors: authors.view(), alloc) {
        Ok(found) => found
        Err(reported) => return Err(take reported)
    }
    return Ok(ReleaseSigning(signer: Some(ReleaseSigner(principal: text::String.of(principal, alloc), secret: take secret)), authors: take authors))
} release_signing

/// The secret key of a release's publisher, or why the package is not published: a principal
/// out of form, or a key the user directory lacks or whose public key differs from the one the
/// package's principals file gives the publisher.
fn publishing_key(session: check::Session, source: workspace::Package, publisher: Str, authors: Slice[text::String], alloc: mem::Alloc) -> Result[core::crypto::SecretKey, diagnostic::Diagnostic] fails platform::IoError {
    var formed = machine::is_principal(publisher)
    for author in authors {
        formed = formed and machine::is_principal(author.as_str())
    }
    if not formed {
        return Err(diagnostic::Diagnostic.new(diagnostic::Code.SealBadPrincipal, alloc))
    }
    let expected = source.machine.principals(alloc).key(publisher)
    let seed = match try secret_key_of(session.home, principal: publisher, alloc) {
        Ok(Some(held)) => held
        Ok(None) => return Err(diagnostic::Diagnostic.new(diagnostic::Code.KeyMissing, alloc))
        Err(exposed) => return Err(exposed_diagnostic(take exposed, alloc))
    }
    let secret = core::crypto::SecretKey.of_seed(seed)
    match expected {
        Some(key) => {
            if key != secret.public_key() {
                return Err(diagnostic::Diagnostic.new(diagnostic::Code.KeyMissing, alloc))
            }
        }
        None => {}
    }
    return Ok(take secret)
} publishing_key

/// What a publish decides from the local store before building its release, adding to
/// `refused` a parent the store does not hold and a store name another package holds.
fn staged_release(invocation: Invocation, source: workspace::Package, take read: mem::List[store::Entry], take breaking: mem::List[text::String], take reason: Option[text::String], mut refused: mem::List[diagnostic::Diagnostic], alloc: mem::Alloc) -> Staged {
    var manifest_path = text::String.of(source.dir.as_str(), alloc)
    mut manifest_path.append("/package.nan")
    var manifest_line: u32 = 1
    var package_name = text::String.empty(alloc)
    match source.manifest {
        Some(manifest) => {
            manifest_line = manifest.line
            package_name = text::String.of(manifest.name.as_str(), alloc)
        }
        None => {}
    }
    var entries = mem::List[mem::Shared[store::Entry]].empty(alloc)
    var roots = mem::List[hashing::HashValue].empty(alloc)
    for stored in take read {
        mut roots.push(stored.root(alloc))
        mut entries.push(mem::Shared.of(take stored, alloc))
    }
    let history = source.machine.history()
    var parent: Option[usize] = None
    match history_head(history) {
        Some(head) => {
            parent = roots.position(fn(root: hashing::HashValue) => root == head)
            if parent.is_none() {
                mut refused.push(diagnostic::Diagnostic.at(diagnostic::Code.VersionParentMissing, path: manifest_path.as_str(), line: manifest_line, alloc))
            }
        }
        None => {}
    }
    let name = store_name(invocation, history, package_name: package_name.as_str(), alloc)
    for stored in entries {
        let held_entry = stored.contents()
        let Some(entry_name) = held_entry.name else {
            continue
        }
        if entry_name.as_str() == name.as_str() and held_entry.package_name.as_str() != package_name.as_str() {
            mut refused.push(diagnostic::Diagnostic.at(diagnostic::Code.VersionStoreNameTaken, path: manifest_path.as_str(), line: manifest_line, alloc))
            break
        }
    }
    return Staged(name: take name, breaking: take breaking, reason: take reason, parent: parent, entries: take entries, roots: take roots)
} staged_release

/// The store name of a release: the one `--name` gives, else its history's, else its package's.
fn store_name(invocation: Invocation, history: Option[machine::History], package_name: Str, alloc: mem::Alloc) -> text::String {
    match invocation.value("--name") {
        Some(given) => return text::String.of(given, alloc)
        None => {}
    }
    match history {
        Some(recorded) => return text::String.of(recorded.name.as_str(), alloc)
        None => {}
    }
    return text::String.of(package_name, alloc)
} store_name

/// What a publish decided before building its release: the store name, the items `--breaking`
/// names and its reason, the store entry of the parent, and the store's entries with their code
/// roots.
struct Staged {
    name: text::String
    breaking: mem::List[text::String]
    reason: Option[text::String]
    parent: Option[usize]
    entries: mem::List[mem::Shared[store::Entry]]
    roots: mem::List[hashing::HashValue]
} Staged

/// Builds the release of a package whose tombstones move into its history, judges its classes
/// against its parent, appends it to the local store and records it as the history head.
fn published(
    invocation: Invocation,
    written: Str,
    session: check::Session,
    index: usize,
    take staged: Staged,
    local_store: store::Store,
    take signing: ReleaseSigning,
    alloc: mem::Alloc,
    ) -> output::Output fails platform::IoError
    waive length "one pass over the steps of a publish, in the bootstrap's order"
{
    let held = session.workspace.contents()
    let Some(source) = held.package_at(index) else {
        expect false
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: written, alloc)
    }
    let grammar = session.grammar.contents()
    let Some(manifest) = source.manifest else {
        expect false
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: written, alloc)
    }
    var manifest_path = text::String.of(source.dir.as_str(), alloc)
    mut manifest_path.append("/package.nan")
    let moved = moved_tombstones(session, index, alloc)
    let history = source.machine.history()
    var history_path = text::String.of(source.dir.as_str(), alloc)
    mut history_path.append("/.nan/history.nan")
    let none_recorded = mem::List[machine::SchemaRecord].empty(alloc)
    let staged_history = machine::History(name: text::String.of(staged.name.as_str(), alloc), head: history_head(history), modules: moved_modules(history, moved: moved.tombstones.view(), records: none_recorded.view(), alloc))
    var files = mem::Map[text::String, mem::Bytes].empty(alloc)
    for file in moved.changed {
        var content = mem::Bytes.empty(alloc)
        mut content.append(file.content.view())
        discard mut files.insert(text::String.of(file.path.as_str(), alloc), value: take content)
    }
    let history_bytes = match staged_history.bytes(grammar, alloc) {
        Some(bytes) => bytes
        None => mem::Bytes.empty(alloc)
    }
    discard mut files.insert(text::String.of(history_path.as_str(), alloc), value: take history_bytes)
    let moved_workspace = try held.rebuilt(files, store_entry: fn(root: hashing::HashValue) -> Option[mem::Shared[store::Entry]] {
        let Some(at) = staged.roots.position(fn(known: hashing::HashValue) => known == root) else {
            return None
        }
        expect at < staged.entries.len()
        return Some(staged.entries[at].share())
    }, grammar, alloc)
    let moved_session = session.over(mem::Shared.of(take moved_workspace, alloc), alloc)
    let Some(closure) = moved_session.workspace.contents().closure_of(index) else {
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: written, alloc)
    }
    let built = moved_session.build(closure, member: workspace::Member.Source(index))
    let exported = release::exported(built.artefact.view(), grammar, alloc)
    var parent_exported = mem::Map[text::String, machine::ApiEntry].empty(alloc)
    var held_forwards = mem::Map[text::String, release::Forward].empty(alloc)
    var parent_entry: Option[mem::Shared[store::Entry]] = None
    match staged.parent {
        Some(at) => {
            expect at < staged.entries.len()
            parent_exported = release::exported(staged.entries[at].contents().artefact.view(), grammar, alloc)
            held_forwards = release::forwards(staged.entries[at].contents().artefact.view(), alloc)
            parent_entry = Some(staged.entries[at].share())
        }
        None => {}
    }
    var breaking = mem::List[text::String].empty(alloc)
    for item in staged.breaking {
        mut breaking.push(publish_canonical(held, named: item.as_str(), alloc))
    }
    for item in breaking {
        let exports = exported.get_by(fn(key: text::String) => key.as_str().cmp(item.as_str())).is_some()
        let parent_exports = parent_exported.get_by(fn(key: text::String) => key.as_str().cmp(item.as_str())).is_some()
        if not exports or not parent_exports {
            var targeted = mem::List[diagnostic::Diagnostic].empty(alloc)
            mut targeted.push(diagnostic::Diagnostic.at(diagnostic::Code.VersionBreakingTarget, path: manifest_path.as_str(), line: manifest.line, alloc))
            return refusal(invocation, written, session, index, diagnostics: targeted.view(), alloc)
        }
    }
    let unpreserved = session.not_preserved(index, parent: parent_exported, held: held_forwards, release_exported: exported)
    if unpreserved.len() > 0 {
        return refusal(invocation, written, session, index, diagnostics: unpreserved.view(), alloc)
    }
    let compatible = moved_session.compatible(index, parent: parent_exported, release_exported: exported)
    let release_forwards = release::forwards(built.artefact.view(), alloc)
    let classes = release::classes(parent_exported, release: exported, epochs: fn(path: Str) -> release::EpochPair {
        return release::EpochPair(old: parent_epoch(staged, path), new: bumped_epoch(staged, breaking: breaking.view(), path))
    }, forwarded: release_forwards, compatible, alloc)
    let class = release::release_class(classes, parented: staged.parent.is_some())
    let encode = moved_session.encode_class(index, parent: parent_entry)
    let summaries = moved_session.publish_summaries(closure, package_index: index)
    let summary = publish_summary(class, encode, exported, classes, staged, breaking: breaking.view(), take summaries, alloc)
    var parent_root: Option[hashing::HashValue] = None
    match staged.parent {
        Some(at) => {
            expect at < staged.roots.len()
            parent_root = Some(staged.roots[at])
        }
        None => {}
    }
    let check::Built(artefact: built_artefact, sources: sources) = built
    let artefact_bytes = signed_artefact(moved_session, index, closure, built: built_artefact.view(), take signing, alloc)
    let appending = try local_store.append(store::Append(package_name: text::String.of(manifest.name.as_str(), alloc), name: Some(text::String.of(staged.name.as_str(), alloc)), parent: parent_root, summary: Some(take summary), artefact: take artefact_bytes, sources: take sources))
    let added = match appending {
        Ok(stored) => stored
        Err(exposed) => {
            var exposure = mem::List[diagnostic::Diagnostic].empty(alloc)
            mut exposure.push(exposed_diagnostic(take exposed, alloc))
            return refusal(invocation, written, session, index, diagnostics: exposure.view(), alloc)
        }
    }
    let root = added.root(alloc)
    let schemas = moved_session.schema_records(index)
    let recorded = machine::History(name: text::String.of(staged.name.as_str(), alloc), head: Some(root), modules: moved_modules(history, moved: moved.tombstones.view(), records: schemas.view(), alloc))
    let recorded_bytes = match recorded.bytes(grammar, alloc) {
        Some(bytes) => bytes
        None => mem::Bytes.empty(alloc)
    }
    discard mut files.insert(take history_path, value: take recorded_bytes)
    var changes = mem::List[journal::Change].empty(alloc)
    for file in take files {
        let mem::KeyValue(key: path, value: content) = file
        let unchanged = match held.bytes(path.as_str()) {
            Some(bytes) => bytes == content.view()
            None => false
        }
        if not unchanged {
            mut changes.push(journal::Change(path: take path, content: Some(take content)))
        }
    }
    try journal::apply(held.root.as_str(), changes: changes.view(), alloc)
    var records = mem::List[output::Record].empty(alloc)
    var fields = mem::List[text::String].empty(alloc)
    mut fields.push(text::String.of(staged.name.as_str(), alloc))
    mut fields.push(root.short(alloc))
    mut fields.push(text::String.of(class.word(), alloc))
    mut fields.push(text::String.of(encode.word(), alloc))
    mut records.push(output::Record(word: text::String.of("published", alloc), fields: take fields, lines: mem::List[text::String].empty(alloc)))
    for change in changes {
        var wrote = mem::List[text::String].empty(alloc)
        mut wrote.push(text::String.of(change.path.as_str(), alloc))
        mut records.push(output::Record(word: text::String.of("wrote", alloc), fields: take wrote, lines: mem::List[text::String].empty(alloc)))
    }
    return publish_output(invocation, written, take records, diagnostics: mem::List[diagnostic::Diagnostic].empty(alloc).view(), changes: changes.view(), alloc)
} published

/// A built artefact, given its sections when its publisher signs it.
fn signed_artefact(
    session: check::Session,
    index: usize,
    closure: workspace::Closure,
    built: Slice[u8],
    take signing: ReleaseSigning,
    alloc: mem::Alloc,
    ) -> mem::Bytes {
    var copy = mem::Bytes.empty(alloc)
    mut copy.append(built)
    let ReleaseSigning(signer: chosen, authors: authors) = signing
    let Some(publisher) = chosen else {
        return copy
    }
    let Ok(decoded) = artefact::decode(built, alloc) else {
        expect false
        return copy
    }
    let held = session.workspace.contents()
    var roots = mem::List[artefact::ClosureRoot].empty(alloc)
    for member in closure.members {
        let root = match member.value() {
            workspace::Member.Source(_) => decoded.root_hash()
            workspace::Member.Release(at) => held.releases[at].root
        }
        mut roots.push(artefact::ClosureRoot(package_name: text::String.of(member.key().as_str(), alloc), root: root))
    }
    var lock = mem::Bytes.empty(alloc)
    match held.package_at(index) {
        Some(source) => {
            match source.machine.lock_file {
                Some(loaded) => mut lock.append(loaded.bytes.view())
                None => {}
            }
        }
        None => {}
    }
    let ReleaseSigner(principal: principal, secret: secret) = publisher
    return artefact::published(built, signing: artefact::Publication(principal: take principal, secret: take secret, toolchain: session.toolchain_hash(), closure: take roots, authors: take authors, lock: take lock), alloc)
} signed_artefact

/// The history head a history records, none without a history.
fn history_head(history: Option[machine::History]) -> Option[hashing::HashValue] {
    let Some(recorded) = history else {
        return None
    }
    return recorded.head
} history_head

/// The behaviour epoch of an item in the parent release, 0 without one.
fn parent_epoch(staged: Staged, path: Str) -> u64 {
    let Some(at) = staged.parent else {
        return 0
    }
    expect at < staged.entries.len()
    return release::epoch(staged.entries[at].contents().summary, path)
} parent_epoch

/// The behaviour epoch of an item in the release: its parent's, one more when `--breaking` names
/// it.
fn bumped_epoch(staged: Staged, breaking: Slice[text::String], path: Str) -> u64 {
    let kept = parent_epoch(staged, path)
    for item in breaking {
        if item.as_str() == path {
            expect kept < ~0u64
            return kept + 1
        }
    }
    return kept
} bumped_epoch

/// The publish summary of a release.
fn publish_summary(class: store::Class, encode: store::Class, exported: mem::Map[text::String, machine::ApiEntry], classes: mem::Map[text::String, store::Class], staged: Staged, breaking: Slice[text::String], take summaries: check::PublishSummaries, alloc: mem::Alloc) -> store::Summary {
    var items = mem::List[store::ExportedItem].empty(alloc)
    for exported_item in exported {
        let path = exported_item.key().as_str()
        let item_class = match classes.get_by(fn(key: text::String) => key.as_str().cmp(path)) {
            Some(held) => held
            None => store::Class.Additive
        }
        mut items.push(store::ExportedItem(path: text::String.of(path, alloc), class: item_class, epoch: bumped_epoch(staged, breaking, path)))
    }
    var bumps = mem::List[store::EpochBump].empty(alloc)
    for item in breaking {
        let written = match staged.reason {
            Some(held) => text::String.of(held.as_str(), alloc)
            None => text::String.empty(alloc)
        }
        mut bumps.push(store::EpochBump(path: text::String.of(item.as_str(), alloc), reason: take written))
    }
    let check::PublishSummaries(functions: functions, authority: authority) = summaries
    return store::Summary(class: class, encode: encode, items: take items, bumps: take bumps, authority: take authority, functions: take functions)
} publish_summary

/// The canonical path of an item named as commands name one.
fn publish_canonical(workspace: workspace::Workspace, named: Str, alloc: mem::Alloc) -> text::String {
    let Some(resolved) = scope::Scope.resolve(workspace, current: workspace.root.as_str(), written: Some(named), alloc) else {
        return text::String.of(named, alloc)
    }
    let scope::Scope.Lines(path: path, lines: lines) = resolved.scope else {
        return text::String.of(named, alloc)
    }
    let Some(item) = workspace.item_at(path.as_str(), line: lines.low, alloc) else {
        return text::String.of(named, alloc)
    }
    return item.canonical(alloc)
} publish_canonical

/// The tombstones publishing moves out of a package's source: its source files without them, by
/// path, and each tombstone's module and text in canonical format.
struct MovedTombstones {
    changed: mem::List[artefact::SourceFile]
    tombstones: mem::List[ModuleTombstone]
} MovedTombstones

/// A tombstone's module and text.
struct ModuleTombstone {
    module: text::String
    text: text::String
} ModuleTombstone

/// The modules of a package's history once a publish adds the tombstones it moves out of the
/// package's source and the schema records of its release, each module's in byte order.
fn moved_modules(history: Option[machine::History], moved: Slice[ModuleTombstone], records: Slice[machine::SchemaRecord], alloc: mem::Alloc) -> mem::List[machine::HistoryModule] {
    var modules = mem::Map[text::String, machine::HistoryModule].empty(alloc)
    match history {
        Some(recorded) => {
            for held in recorded.modules {
                var schemas = mem::List[machine::TypeSchema].empty(alloc)
                for schema in held.schemas {
                    mut schemas.push(machine::TypeSchema(ty: text::String.of(schema.ty.as_str(), alloc), hash: schema.hash))
                }
                var tombstones = mem::List[text::String].empty(alloc)
                for tombstone in held.tombstones {
                    mut tombstones.push(text::String.of(tombstone.as_str(), alloc))
                }
                discard mut modules.insert(text::String.of(held.module.as_str(), alloc), value: machine::HistoryModule(module: text::String.of(held.module.as_str(), alloc), schemas: take schemas, tombstones: take tombstones))
            }
        }
        None => {}
    }
    for tombstone in moved {
        mut ensure_module(mut modules, module: tombstone.module.as_str(), alloc)
        var moved_into = mut modules.at_mut(tombstone.module)
        if moved_into.tombstones.position(fn(known: text::String) => known == tombstone.text).is_none() {
            mut moved_into.tombstones.push(text::String.of(tombstone.text.as_str(), alloc))
        }
    }
    for schema_record in records {
        mut ensure_module(mut modules, module: schema_record.module.as_str(), alloc)
        var recorded_in = mut modules.at_mut(schema_record.module)
        let recorded_schema = machine::TypeSchema(ty: text::String.of(schema_record.ty.as_str(), alloc), hash: schema_record.hash)
        if recorded_in.schemas.position(fn(known: machine::TypeSchema) => known == recorded_schema).is_none() {
            mut recorded_in.schemas.push(take recorded_schema)
        }
    }
    var found = mem::List[machine::HistoryModule].empty(alloc)
    for pair in take modules {
        let mem::KeyValue(key: _, value: history_module) = pair
        var sorted = history_module
        mut sorted.tombstones.sort_by(fn(left: text::String, right: text::String) => left.as_str().cmp(right.as_str()))
        mut sorted.schemas.sort_by(fn(left: machine::TypeSchema, right: machine::TypeSchema) => left.cmp(right))
        mut found.push(take sorted)
    }
    return found
} moved_modules

/// Adds an empty module to a history's modules unless it holds one of that name.
fn ensure_module(mut modules: mem::Map[text::String, machine::HistoryModule], module: Str, alloc: mem::Alloc) {
    let name = text::String.of(module, alloc)
    if not modules.contains(name) {
        discard mut modules.insert(text::String.of(module, alloc), value: machine::HistoryModule(module: take name, schemas: mem::List[machine::TypeSchema].empty(alloc), tombstones: mem::List[text::String].empty(alloc)))
    }
} ensure_module

/// The tombstones of a package's source to move into its history: all but those keeping an
/// `Encode` key of a type deriving `Encode`.
fn moved_tombstones(session: check::Session, index: usize, alloc: mem::Alloc) -> MovedTombstones {
    let held = session.workspace.contents()
    var changed = mem::List[artefact::SourceFile].empty(alloc)
    var moved = mem::List[ModuleTombstone].empty(alloc)
    let Some(source) = held.package_at(index) else {
        expect false
        return MovedTombstones(changed: take changed, tombstones: take moved)
    }
    let encoded = session.encode_key_tombstones(index)
    for file in source.files {
        let Some(module) = file.module else {
            continue
        }
        let syntax = file.syntax
        var removed = mem::List[core::Range[u32]].empty(alloc)
        for position in 0..<syntax.items.len() {
            let item = syntax.items[position]
            let Some(tree) = item.tree else {
                continue
            }
            let is_tombstone = match tree.kind() {
                Some(kind) => kind.rule == syntax::Rule.RetiredItem
                None => false
            }
            let lines = syntax.item_lines(item)
            if not is_tombstone or item.abandoned or keeps_key(encoded.view(), path: file.path.as_str(), line: lines.low) {
                continue
            }
            expect module < source.modules.len()
            mut moved.push(ModuleTombstone(module: text::String.of(source.modules[module].name.as_str(), alloc), text: format::item_text(syntax, item, alloc)))
            mut removed.push(lines)
        }
        if removed.len() == 0 {
            continue
        }
        var kept = mem::Bytes.empty(alloc)
        var first_kept = true
        for number in 1..=u32.fit(syntax.lines.len()) {
            if removed.position(fn(range: core::Range[u32]) => range.contains(number)).is_some() {
                continue
            }
            if not first_kept {
                mut kept.push(b'\n')
            }
            first_kept = false
            mut kept.append(syntax.line_text(number))
        }
        mut kept.push(b'\n')
        let parsed = syntax::parse(take kept, grammar: session.grammar.contents(), alloc)
        mut changed.push(artefact::SourceFile(path: text::String.of(file.path.as_str(), alloc), content: format::source_file(parsed, only: None, alloc)))
    }
    return MovedTombstones(changed: take changed, tombstones: take moved)
} moved_tombstones

/// Whether a tombstone keeping an `Encode` key starts at a file's line.
fn keeps_key(encoded: Slice[diagnostic::At], path: Str, line: u32) -> bool {
    for at in encoded {
        if at.path.as_str() == path and at.line == line {
            return true
        }
    }
    return false
} keeps_key

/// The output of a refused publish: its diagnostics.
fn refusal(invocation: Invocation, written: Str, session: check::Session, index: usize, diagnostics: Slice[diagnostic::Diagnostic], alloc: mem::Alloc) -> output::Output {
    let held = session.workspace.contents()
    let std = session.std()
    var records = mem::List[output::Record].empty(alloc)
    for reported in diagnostics {
        mut records.push(record(held, std, scope: scope::Scope.Package(index), reported, alloc))
    }
    return publish_output(invocation, written, take records, diagnostics, changes: mem::List[journal::Change].empty(alloc).view(), alloc)
} refusal

fn publish_output(invocation: Invocation, written: Str, take records: mem::List[output::Record], diagnostics: Slice[diagnostic::Diagnostic], changes: Slice[journal::Change], alloc: mem::Alloc) -> output::Output {
    var errors: usize = 0
    var incomplete: usize = 0
    for reported in diagnostics {
        invariant errors < diagnostics.len() and incomplete < diagnostics.len()
        let class = reported.code.class()
        if class == diagnostic::Class.Error {
            errors += 1
        } else if class == diagnostic::Class.Incompleteness {
            incomplete += 1
        }
    }
    var refused = diagnostics.len() > 0
    for held in records {
        if held.word.as_str() == "fail" {
            refused = true
        }
    }
    var verdict = output::Verdict.Ok
    if refused {
        verdict = output::Verdict.Failed
    }
    return output::Output(command: invocation.command(written, skip: true, alloc), elision: invocation.command(written, skip: false, alloc), verdict: verdict, summary: written_summary(files: changes.len(), errors, incomplete, alloc), records: take records)
} publish_output
