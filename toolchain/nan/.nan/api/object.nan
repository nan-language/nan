item "nan::object::Elf.lay_out"
head "fn Elf.lay_out(self, alloc: mem::Alloc) -> Layout"
accepted "ensures result.sections.len() == self.sections.len() and result.symbol_strings.len() == self.symbols.len() and result.symbol_indexes.len() == self.symbols.len()"
item "nan::object::Elf.section"
head "fn Elf.section(mut self, kind: SectionKind) -> u32"
accepted "ensures usize.widen(result) < self.sections.len()"
