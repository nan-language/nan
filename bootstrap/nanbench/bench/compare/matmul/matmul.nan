//! The sum of the entries of the product of two square matrices whose order is the size.

enum BenchError derives Render {
    Usage
    Stdio(sys::StdioError) from
    Cancelled(task::Cancelled) from
} BenchError

/// The number the first argument states in decimal, if it states one.
validator fn size(args: Untrusted[mem::List[mem::Bytes]]) -> Option[u64] {
    let Some(arg) = args.inspect().get(0) else {
        return None
    }
    var value: u64 = 0
    for digit in arg.view() {
        if digit < b'0' or digit > b'9' {
            return None
        }
        value = value * 10 + u64.widen(digit - b'0')
    }
    return Some(value)
} size

/// A row-major `n` by `n` matrix whose entry at row `i` and column `j` is `(i * step + j) % 17`.
fn matrix(n: usize, step: usize, alloc: mem::Alloc) -> mem::List[f64] {
    var entries = mem::List[f64].empty(alloc)
    mut entries.reserve(n * n)
    for i in 0..<n {
        for j in 0..<n {
            mut entries.push(f64.nearest((i * step + j) % 17))
        }
    }
    return entries
} matrix

/// The product of two row-major `n` by `n` matrices.
fn product(a: Slice[f64], b: Slice[f64], n: usize, alloc: mem::Alloc) -> mem::List[f64] {
    var c = mem::List[f64].empty(alloc)
    mut c.reserve(n * n)
    for _ in 0..<(n * n) {
        mut c.push(0.0)
    }
    for i in 0..<n {
        for k in 0..<n {
            let factor = a[i * n + k]
            for j in 0..<n {
                c[i * n + j] += factor * b[k * n + j]
            }
        }
    }
    return c
} product

fn main(take world: host::World) fails BenchError uses wait {
    let Some(n) = size(world.args) else {
        fail BenchError.Usage
    }
    let order = usize.widen(n)
    let a = matrix(order, step: 7, alloc: world.alloc)
    let b = matrix(order, step: 3, alloc: world.alloc)
    let c = product(a.view(), b: b.view(), n: order, alloc: world.alloc)
    var total: f64 = 0.0
    for entry in c {
        total += entry
    }
    var out = text::String.empty(world.alloc)
    mut out.write(text::fmt("{total}\n", total: u64.fit(total)), budget: 64)
    let written = take out.into_bytes()
    try await world.stdio.write_out(written.view())
} main
