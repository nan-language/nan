//! An AArch64 bare kernel running jobs of nanos bundles.

package aarch64_nanos_jobs {
    language 1
    targets aarch64-bare
    entry main
    allow capability in aarch64_nanos_jobs
    allow device in aarch64_nanos_jobs
    allow trusted in aarch64_nanos_jobs
    allow validate in aarch64_nanos_jobs
} aarch64_nanos_jobs
