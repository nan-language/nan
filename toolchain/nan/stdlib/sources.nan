const TEXT_MEM_WIRE_WIRE: Str =
    \\//! The canonical binary format.
    \\
    \\pub open struct Codec[T: Encode] {
    \\} Codec
    \\
    \\pub fn Codec.encode(value: T, mut out: mem::Bytes)
    \\    ensures out.len() >= old(out.len())
    \\
    \\pub fn Codec.try_encode(value: T, mut out: mem::Bytes) fails mem::OutOfMemory
    \\    ensures out.len() >= old(out.len())
    \\
    \\pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    \\    example attempt Codec[u16].decode(Untrusted.of(b"\\xAC\\x02"), alloc: testing::world().alloc) == Ok(300)
    \\    example attempt Codec[u8].decode(Untrusted.of(b"\\x05\\x00"), alloc: testing::world().alloc) == Err(core::DecodeError.Trailing)
    \\
    \\pub fn Codec.canonical(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails core::DecodeError
    \\    example (attempt Codec[u8].canonical(Untrusted.of(b"\\x05\\x00"), alloc: testing::world().alloc)).is_err()
    \\
    \\pub fn Codec.erased() -> Erased limits pure, notrap, terminates
    \\    example Codec[u8].erased().schema == Codec[u8].schema_hash()
    \\
    \\pub fn Codec.schema_hash() -> SchemaHash limits pure, notrap, terminates
    \\    example Codec[u8].schema_hash() != Codec[u16].schema_hash()
    \\
    \\pub fn Codec.schema(alloc: mem::Alloc) -> Schema
    \\    example Codec[i32].schema(testing::world().alloc).accepts(Schema.Signed(width: 32))
    \\
    \\pub fn Codec.decode_from(schema: SchemaHash, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    \\    example attempt Codec[u16].decode_from(Codec[u16].schema_hash(), raw: Untrusted.of(b"\\xAC\\x02"), alloc: testing::world().alloc) == Ok(300)
    \\    example attempt Codec[u16].decode_from(Codec[u8].schema_hash(), raw: Untrusted.of(b"\\x05"), alloc: testing::world().alloc) == Err(core::DecodeError.UnknownSchema)
    \\
    \\pub fn Codec.encode_as(value: T, schema: SchemaHash, mut out: mem::Bytes, alloc: mem::Alloc) -> bool
    \\    ensures out.len() >= old(out.len())
    \\
    \\pub closed struct SchemaHash derives Copy, Eq, Ord, Hash, Encode {
    \\    pub bytes: Array[u8, 33]
    \\} SchemaHash
    \\
    \\pub closed enum Schema derives Encode {
    \\    Bool
    \\    Char
    \\    Text
    \\    Bytes
    \\    Unsigned(width: u8)
    \\    Signed(width: u8)
    \\    Float(width: u8)
    \\    BoundedText(capacity: u64)
    \\    Sequence(element: mem::Box[Schema], length: Option[u64], capacity: Option[u64], unique: bool)
    \\    Map(key: mem::Box[Schema], value: mem::Box[Schema])
    \\    Record(open: bool, fields: mem::List[SchemaField])
    \\    Variant(open: bool, variants: mem::List[SchemaVariant])
    \\    Back(depth: u64)
    \\} Schema
    \\
    \\pub closed struct SchemaField derives Encode {
    \\    pub key: text::String
    \\    pub aliases: mem::List[text::String]
    \\    pub defaulted: bool
    \\    pub value: Schema
    \\} SchemaField
    \\
    \\pub closed struct SchemaVariant derives Encode {
    \\    pub key: text::String
    \\    pub aliases: mem::List[text::String]
    \\    pub payload: Option[Schema]
    \\} SchemaVariant
    \\
    \\pub open struct Erased derives Copy {
    \\    pub schema: SchemaHash
    \\    pub canonical: fn(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails core::DecodeError limits terminates
    \\} Erased
    \\
    \\pub open enum Kept {
    \\    Empty
    \\    Fields(Untrusted[mem::Bytes])
    \\} Kept
    \\
    \\impl Kept: core::Eq
    \\
    \\impl Kept: core::Ord
    \\
    \\impl Kept: core::Hash
    \\
    \\impl Kept: core::Default
    \\
    \\impl Kept: core::Generate
    \\
    \\pub fn Kept.eq(self, other: Kept) -> bool limits pure, notrap, terminates
    \\    example Kept.Empty.eq(Kept.Empty)
    \\{
    \\    return true
    \\} Kept.eq
    \\
    \\pub fn Kept.cmp(self, other: Kept) -> core::Ordering limits pure, notrap, terminates
    \\    example Kept.Empty.cmp(Kept.Empty) == core::Ordering.Equal
    \\{
    \\    return core::Ordering.Equal
    \\} Kept.cmp
    \\
    \\pub fn Kept.hash[H: core::Hasher](self, mut hasher: H) limits pure, notrap, terminates {
    \\} Kept.hash
    \\
    \\pub fn Kept.default() -> Kept limits pure, terminates
    \\    example Kept.default() == Kept.Empty
    \\{
    \\    return Kept.Empty
    \\} Kept.default
    \\
    \\pub fn Kept.generate(mut choices: core::Choices, alloc: mem::Alloc) -> Kept limits terminates {
    \\    return Kept.Empty
    \\} Kept.generate
    \\
    \\pub fn Schema.accepts(self, old: Schema) -> bool
    \\    example Schema.BoundedText(capacity: 16).accepts(Schema.BoundedText(capacity: 8))
    \\    example not Schema.Unsigned(width: 16).accepts(Schema.Unsigned(width: 8))
    \\{
    \\    match self {
    \\        Schema.Unsigned(width: new) => {
    \\            let Schema.Unsigned(width: held) = old else {
    \\                return false
    \\            }
    \\            return new == held
    \\        }
    \\        Schema.Signed(width: new) => {
    \\            let Schema.Signed(width: held) = old else {
    \\                return false
    \\            }
    \\            return new == held
    \\        }
    \\        Schema.Float(width: new) => {
    \\            let Schema.Float(width: held) = old else {
    \\                return false
    \\            }
    \\            return new == held
    \\        }
    \\        Schema.Back(depth: new) => {
    \\            let Schema.Back(depth: held) = old else {
    \\                return false
    \\            }
    \\            return new == held
    \\        }
    \\        Schema.BoundedText(capacity: new) => {
    \\            let Schema.BoundedText(capacity: held) = old else {
    \\                return false
    \\            }
    \\            return new >= held
    \\        }
    \\        Schema.Sequence(element: element, length: length, capacity: capacity, unique: unique) => {
    \\            let Schema.Sequence(element: old_element, length: old_length, capacity: old_capacity, unique: old_unique) = old else {
    \\                return false
    \\            }
    \\            let fits = match capacity {
    \\                None => true
    \\                Some(room) => match old_capacity {
    \\                    Some(held) => room >= held
    \\                    None => false
    \\                }
    \\            }
    \\            return element.contents().accepts(old_element.contents()) and length == old_length and fits and (not unique or old_unique)
    \\        }
    \\        Schema.Map(key: key, value: value) => {
    \\            let Schema.Map(key: old_key, value: old_value) = old else {
    \\                return false
    \\            }
    \\            return key.contents().accepts(old_key.contents()) and value.contents().accepts(old_value.contents())
    \\        }
    \\        Schema.Record(open: open, fields: fields) => {
    \\            let Schema.Record(open: _, fields: old_fields) = old else {
    \\                return false
    \\            }
    \\            return record_accepts(open, fields: fields.view(), old_fields: old_fields.view())
    \\        }
    \\        Schema.Variant(open: _, variants: variants) => {
    \\            let Schema.Variant(open: _, variants: old_variants) = old else {
    \\                return false
    \\            }
    \\            return variants_accept(variants.view(), old_variants: old_variants.view())
    \\        }
    \\        else => return self.kind() == old.kind()
    \\    }
    \\} Schema.accepts
    \\
    \\test records_accept_defaulted_and_dropped_fields for Schema.accepts {
    \\    let alloc = testing::world().alloc
    \\    var old_fields = mem::List[SchemaField].empty(alloc)
    \\    mut old_fields.push(plain_field("level", value: Schema.Unsigned(width: 8), alloc))
    \\    mut old_fields.push(plain_field("mode", value: Schema.Text, alloc))
    \\    var renamed = plain_field("lvl", value: Schema.Unsigned(width: 8), alloc)
    \\    mut renamed.aliases.push(text::String.of("level", alloc))
    \\    var added = plain_field("verbose", value: Schema.Bool, alloc)
    \\    added.defaulted = true
    \\    var new_fields = mem::List[SchemaField].empty(alloc)
    \\    mut new_fields.push(take renamed)
    \\    mut new_fields.push(take added)
    \\    let old = Schema.Record(open: false, fields: take old_fields)
    \\    let open = Schema.Record(open: true, fields: take new_fields)
    \\    expect open.accepts(old)
    \\    expect not old.accepts(open)
    \\} records_accept_defaulted_and_dropped_fields
    \\
    \\fn plain_field(key: Str, take value: Schema, alloc: mem::Alloc) -> SchemaField {
    \\    return SchemaField(key: text::String.of(key, alloc), aliases: mem::List[text::String].empty(alloc), defaulted: false, value: take value)
    \\} plain_field
    \\
    \\/// The position of a node's kind among the kinds of nodes.
    \\fn Schema.kind(self) -> u32 {
    \\    return match self {
    \\        Schema.Bool => 0
    \\        Schema.Char => 1
    \\        Schema.Text => 2
    \\        Schema.Bytes => 3
    \\        Schema.Unsigned(width: _) => 4
    \\        Schema.Signed(width: _) => 5
    \\        Schema.Float(width: _) => 6
    \\        Schema.BoundedText(capacity: _) => 7
    \\        Schema.Sequence(element: _, length: _, capacity: _, unique: _) => 8
    \\        Schema.Map(key: _, value: _) => 9
    \\        Schema.Record(open: _, fields: _) => 10
    \\        Schema.Variant(open: _, variants: _) => 11
    \\        Schema.Back(depth: _) => 12
    \\    }
    \\} Schema.kind
    \\
    \\/// Whether a field's key or one of its aliases is `key`.
    \\fn field_matches(field: SchemaField, key: Str) -> bool {
    \\    if field.key.as_str() == key {
    \\        return true
    \\    }
    \\    return field.aliases.position(fn(alias: text::String) => alias.as_str() == key).is_some()
    \\} field_matches
    \\
    \\/// Whether a record's fields accept old ones: each old field kept by a matching field accepting
    \\/// it, or dropped from an open record, and each field matching an old one or defaulted.
    \\fn record_accepts(open: bool, fields: Slice[SchemaField], old_fields: Slice[SchemaField]) -> bool {
    \\    for held in old_fields {
    \\        var matched: Option[usize] = None
    \\        for at in 0..<fields.len() {
    \\            if field_matches(fields[at], key: held.key.as_str()) {
    \\                matched = Some(at)
    \\                break
    \\            }
    \\        }
    \\        let kept = match matched {
    \\            Some(at) => fields[at].value.accepts(held.value)
    \\            None => open
    \\        }
    \\        if not kept {
    \\            return false
    \\        }
    \\    }
    \\    for field in fields {
    \\        if field.defaulted {
    \\            continue
    \\        }
    \\        var known = false
    \\        for held in old_fields {
    \\            if field_matches(field, key: held.key.as_str()) {
    \\                known = true
    \\                break
    \\            }
    \\        }
    \\        if not known {
    \\            return false
    \\        }
    \\    }
    \\    return true
    \\} record_accepts
    \\
    \\/// Whether variants accept old ones: each old variant matched by key or alias with a payload
    \\/// accepting its own.
    \\fn variants_accept(variants: Slice[SchemaVariant], old_variants: Slice[SchemaVariant]) -> bool {
    \\    for held in old_variants {
    \\        var found = false
    \\        for variant in variants {
    \\            let matched = variant.key == held.key or variant.aliases.position(fn(alias: text::String) => alias == held.key).is_some()
    \\            if not matched {
    \\                continue
    \\            }
    \\            let accepted = match variant.payload {
    \\                None => held.payload.is_none()
    \\                Some(payload) => match held.payload {
    \\                    Some(old_payload) => payload.accepts(old_payload)
    \\                    None => false
    \\                }
    \\            }
    \\            if accepted {
    \\                found = true
    \\                break
    \\            }
    \\        }
    \\        if not found {
    \\            return false
    \\        }
    \\    }
    \\    return true
    \\} variants_accept
    \\
    \\test encode_appends_a_uvar for Codec.encode {
    \\    var out = mem::Bytes.zeroed(1, alloc: testing::world().alloc)
    \\    Codec[u16].encode(300, mut out)
    \\    expect out.len() == 3
    \\    expect out[1] == 0xAC
    \\    expect out[2] == 0x02
    \\} encode_appends_a_uvar
    \\
    \\test try_encode_leaves_out_unchanged_when_exhausted for Codec.try_encode {
    \\    let budget = testing::world().alloc.split(65_536)
    \\    var out = mem::Bytes.empty(budget.alloc())
    \\    take budget.close()
    \\    let encoded = attempt Codec[u16].try_encode(300, mut out)
    \\    expect encoded.is_err()
    \\    expect out.len() == 0
    \\} try_encode_leaves_out_unchanged_when_exhausted
    \\
    \\test encode_as_writes_the_own_schema_alone for Codec.encode_as {
    \\    let alloc = testing::world().alloc
    \\    var out = mem::Bytes.empty(alloc)
    \\    let own = Codec[u16].encode_as(300, schema: Codec[u16].schema_hash(), mut out, alloc)
    \\    let other = Codec[u16].encode_as(300, schema: Codec[u8].schema_hash(), mut out, alloc)
    \\    expect own
    \\    expect not other
    \\    expect out.len() == 2
    \\} encode_as_writes_the_own_schema_alone
    \\
    \\struct Touched {
    \\    written: bool
    \\} Touched
    \\
    \\impl Touched: core::Hasher
    \\
    \\fn Touched.write(mut self, bytes: Slice[u8]) limits pure, notrap, terminates {
    \\    self.written = true
    \\} Touched.write
    \\
    \\test kept_fields_hash_nothing for Kept.hash {
    \\    var hasher = Touched(written: false)
    \\    Kept.Empty.hash(mut hasher)
    \\    expect not hasher.written
    \\} kept_fields_hash_nothing
    \\
    \\test generated_kept_fields_are_empty for Kept.generate (kept: Kept) {
    \\    let Kept.Empty = kept else {
    \\        expect false
    \\        return
    \\    }
    \\} generated_kept_fields_are_empty
    \\

const TEXT_SYS_FS_FS: Str =
    \\//! Files and their errors.
    \\
    \\pub open struct File {
    \\} File
    \\
    \\pub fn File.read(mut self, mut buf: Untrusted[SliceMut[u8]]) -> usize fails FsError uses wait
    \\    ensures result <= buf.byte_len()
    \\
    \\pub fn File.write(mut self, data: Slice[u8]) -> usize fails FsError uses wait
    \\    ensures result <= data.len()
    \\    ensures data.is_empty() or result >= 1
    \\
    \\pub fn File.byte_len(self) -> u64 fails FsError uses wait
    \\
    \\pub open enum FsError derives Render {
    \\    NotFound
    \\    Denied
    \\    InvalidPath
    \\    NoSpace
    \\    Revoked(sys::Revoked) from
    \\    Cancelled(task::Cancelled) from
    \\} FsError
    \\
    \\test reads_drain_the_file for File.read {
    \\    let world = testing::world()
    \\    try await world.fs.write_all("data", data: b"abc")
    \\    var file = try await world.fs.open("data")
    \\    var buf = Untrusted.of(Array[u8, 2].filled(0))
    \\    var total: usize = 0
    \\    loop {
    \\        let count = try await mut file.read(mut buf.view_mut())
    \\        if count == 0 {
    \\            break
    \\        }
    \\        total += count
    \\    }
    \\    expect total == 3
    \\} reads_drain_the_file
    \\
    \\test write_extends_the_file for File.write {
    \\    let world = testing::world()
    \\    var file = try await world.fs.create("log")
    \\    let written = try await mut file.write(b"abc")
    \\    let len = try await file.byte_len()
    \\    expect written >= 1
    \\    expect len == u64.widen(written)
    \\} write_extends_the_file
    \\
    \\test byte_len_counts_the_contents for File.byte_len {
    \\    let world = testing::world()
    \\    try await world.fs.write_all("data", data: b"abcd")
    \\    let file = try await world.fs.open("data")
    \\    let len = try await file.byte_len()
    \\    expect len == 4
    \\} byte_len_counts_the_contents
    \\

const TEXT_SYS_NET_NET: Str =
    \\//! Listeners, connections and their errors.
    \\
    \\pub open struct Listener {
    \\} Listener
    \\
    \\pub fn Listener.accept(mut self) -> Conn fails NetError uses wait
    \\
    \\pub open linear struct Conn {
    \\} Conn
    \\
    \\pub fn Conn.read(mut self, mut buf: Untrusted[SliceMut[u8]]) -> usize fails NetError uses wait
    \\    ensures result <= buf.byte_len()
    \\
    \\pub fn Conn.write(mut self, data: Slice[u8]) -> usize fails NetError uses wait
    \\    ensures result <= data.len()
    \\    ensures data.is_empty() or result >= 1
    \\
    \\pub fn Conn.close(take self) fails NetError uses wait
    \\
    \\pub fn Conn.abandon(take self)
    \\
    \\pub open enum NetError derives Render {
    \\    Refused
    \\    Reset
    \\    Unreachable
    \\    AddressInUse
    \\    Denied
    \\    Revoked(sys::Revoked) from
    \\    Cancelled(task::Cancelled) from
    \\} NetError
    \\
    \\test accept_takes_a_loopback_connection for Listener.accept {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    var listener = try await loopback.listen(4_100)
    \\    try await task::scope(world.exec, body: fn[mut listener](s: task::Scope) fails NetError uses wait {
    \\        discard s.spawn(fn() fails NetError uses wait {
    \\            let client = try await loopback.connect("localhost", port: 4_100)
    \\            take client.abandon()
    \\        })
    \\        let server = try await mut listener.accept()
    \\        take server.abandon()
    \\    })
    \\} accept_takes_a_loopback_connection
    \\
    \\test read_receives_the_peer_bytes for Conn.read {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    let clock = world.clock
    \\    var listener = try await loopback.listen(4_100)
    \\    var count: usize = 0
    \\    try await task::scope(world.exec, body: fn[mut listener, mut count](s: task::Scope) fails NetError uses wait {
    \\        discard s.spawn(fn() fails NetError uses wait {
    \\            var client = try await loopback.connect("localhost", port: 4_100)
    \\            defer take client.abandon()
    \\            discard try await mut client.write(b"x")
    \\            try await clock.sleep(100)
    \\        })
    \\        var server = try await mut listener.accept()
    \\        defer take server.abandon()
    \\        var buf = Untrusted.of(Array[u8, 4].filled(0))
    \\        count = try await mut server.read(mut buf.view_mut())
    \\    })
    \\    expect count == 1
    \\} read_receives_the_peer_bytes
    \\
    \\test write_sends_part_of_the_data for Conn.write {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    var listener = try await loopback.listen(4_100)
    \\    var sent: usize = 0
    \\    try await task::scope(world.exec, body: fn[mut listener, mut sent](s: task::Scope) fails NetError uses wait {
    \\        let client = s.spawn(fn() -> usize fails NetError uses wait {
    \\            var conn = try await loopback.connect("localhost", port: 4_100)
    \\            defer take conn.abandon()
    \\            return try await mut conn.write(b"ping")
    \\        })
    \\        let server = try await mut listener.accept()
    \\        defer take server.abandon()
    \\        sent = try await take client.join()
    \\    })
    \\    expect sent >= 1
    \\} write_sends_part_of_the_data
    \\
    \\test close_shuts_the_connection_down for Conn.close {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    var listener = try await loopback.listen(4_100)
    \\    try await task::scope(world.exec, body: fn[mut listener](s: task::Scope) fails NetError uses wait {
    \\        let client = s.spawn(fn() fails NetError uses wait {
    \\            let conn = try await loopback.connect("localhost", port: 4_100)
    \\            try await take conn.close()
    \\        })
    \\        let server = try await mut listener.accept()
    \\        defer take server.abandon()
    \\        try await take client.join()
    \\    })
    \\} close_shuts_the_connection_down
    \\
    \\test abandon_resets_the_peer for Conn.abandon {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    var listener = try await loopback.listen(4_100)
    \\    var reset = false
    \\    try await task::scope(world.exec, body: fn[mut listener, mut reset](s: task::Scope) fails NetError uses wait {
    \\        let client = s.spawn(fn() fails NetError uses wait {
    \\            let conn = try await loopback.connect("localhost", port: 4_100)
    \\            take conn.abandon()
    \\        })
    \\        var server = try await mut listener.accept()
    \\        defer take server.abandon()
    \\        try await take client.join()
    \\        var buf = Untrusted.of(Array[u8, 4].filled(0))
    \\        let outcome = attempt await mut server.read(mut buf.view_mut())
    \\        reset = match outcome {
    \\            Err(NetError.Reset) => true
    \\            else => false
    \\        }
    \\    })
    \\    expect reset
    \\} abandon_resets_the_peer
    \\

