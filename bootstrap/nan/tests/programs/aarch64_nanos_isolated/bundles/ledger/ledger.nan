//! A book served through the Ledger protocol, and a teller calling it through a port: the book adds amounts, weighs bytes, gives back a clock it receives, notes its total through a log it receives, publishing it, and gives that log back, logs through the log its runner holds as capability 7 and the one it lends through port 1, asks its runner for a resource, which a space's runner never holds, adds through the gauge its world holds, the gauge a call gives it and the one its runner holds as capability 8, settling its world's gauge from a keyed task, postpones a wait until settled, then answers it with its total, counts the ticks of a keyed task it starts whenever resumed, traps dividing by zero and spins without end when asked; the teller relays an amount to it, timing the call, has it note through the teller's log and weighs bytes there.

pub protocol Ledger {
    pub fn add(amount: u32) -> u64 limits pure
    pub fn echo(clock: sys::Clock) -> sys::Clock limits pure
    pub fn note(log: sys::Log) -> sys::Log limits recorded
    pub fn borrow() limits recorded
    pub fn gauge(amount: u32, given: gauges::Gauge) -> u64 limits recorded
    pub fn divide(by: u32) -> u64 limits pure
    pub fn spin() -> u64 limits pure
    pub fn wait() -> u64 limits pure
    pub fn settle() limits traceless
    pub fn weigh(bytes: mem::Bytes) -> u64 limits pure
    fn tick() limits pure
} Ledger

/// What the runner of a book lends through port 1.
pub protocol Lender {
    pub fn lend() -> sys::Log limits pure
} Lender

pub closed struct Env {
    pub log: sys::Log
    pub gauge: gauges::Gauge
    pub alloc: mem::Alloc
} Env

impl Env: nanos::Environment

pub fn Env.build(take world: nanos::World) -> Env fails nanos::CapError {
    let gauge = try nanos::Cap[gauges::Gauge].get(world.caps, key: "gauge")
    return Env(log: world.log, gauge: gauge, alloc: world.alloc)
} Env.build

pub closed struct Book derives Encode {
    pub total: u64
    pub ticks: u64
    pub pending: u64
} Book

impl Book: sys::Component[Env, Ledger]

impl Book: sys::Resume[Env, Ledger]

pub fn Book.start(mut env: Env) -> Book = Book(total: 0, ticks: 0, pending: 0)

pub fn Book.add(mut self, take amount: u32, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    self.total = self.total.wrapping_add(u64.widen(amount))
    return self.total
} Book.add

pub fn Book.echo(mut self, take clock: sys::Clock, mut env: Env, mut cx: sys::Cx[Ledger]) -> sys::Clock = clock

pub fn Book.note(mut self, take log: sys::Log, mut env: Env, mut cx: sys::Cx[Ledger]) -> sys::Log {
    log.info("noted", value: self.total)
    var summary = mem::Bytes.empty(env.alloc)
    mem::wire::Codec[u64].encode(self.total, out: mut summary)
    discard attempt mut cx.publish(summary.view())
    return log
} Book.note

pub fn Book.borrow(mut self, mut env: Env, mut cx: sys::Cx[Ledger]) {
    match attempt mut cx.capability(sys::CapabilityId[sys::Log](id: 7)) {
        Ok(held) => held.info("held", value: true)
        Err(_) => env.log.info("held", value: false)
    }
    let lender = sys::Port[Lender].of(cx, id: 1)
    let resources = sys::Resources.of(cx)
    let log = env.log
    let alloc = env.alloc
    mut cx.spawn(key: 2, run: fn(out: sys::Outbox[Ledger]) fails task::Cancelled uses wait {
        var call = sys::Encoded.empty(alloc)
        let lent = sys::Wire[Lender].lend(mut call)
        match attempt await lender.call(lent, call, alloc) {
            Ok(borrowed) => borrowed.info("lent", value: true)
            Err(_) => log.info("lent", value: false)
        }
        let resource = attempt await resources.resource(sys::ResourceId[sys::fs::File](id: 3))
        log.info("resource held", value: resource.is_ok())
        discard attempt await out.tick()
    })
} Book.borrow

pub fn Book.gauge(mut self, take amount: u32, take given: gauges::Gauge, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    let total = match attempt env.gauge.add(u64.widen(amount), alloc: env.alloc) {
        Ok(sum) => sum
        Err(failure) => {
            env.log.info("gauge", value: failure)
            return 0
        }
    }
    env.log.info("gauged", value: total)
    match attempt given.add(1, alloc: env.alloc) {
        Ok(sum) => env.log.info("given gauge", value: sum)
        Err(failure) => env.log.info("given gauge", value: failure)
    }
    match attempt mut cx.capability(sys::CapabilityId[gauges::Gauge](id: 8)) {
        Ok(lent) => match attempt lent.add(10, alloc: env.alloc) {
            Ok(sum) => env.log.info("lent gauge", value: sum)
            Err(failure) => env.log.info("lent gauge", value: failure)
        }
        Err(_) => env.log.info("lent gauge", value: false)
    }
    let gauge = env.gauge
    let log = env.log
    let alloc = env.alloc
    mut cx.spawn(key: 3, run: fn(out: sys::Outbox[Ledger]) fails task::Cancelled uses wait {
        match attempt await gauge.settled(alloc) {
            Ok(sum) => log.info("settled", value: sum)
            Err(failure) => log.info("settled", value: failure)
        }
        discard attempt await out.tick()
    })
    return total
} Book.gauge

pub fn Book.divide(mut self, take by: u32, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    return self.total / u64.widen(by)
} Book.divide

pub fn Book.spin(mut self, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    loop {
    }
} Book.spin

pub fn Book.wait(mut self, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    let Some(request) = mut cx.postpone() else {
        return self.total
    }
    self.pending = request
    return self.total
} Book.wait

pub fn Book.settle(mut self, mut env: Env, mut cx: sys::Cx[Ledger]) {
    var reply = sys::Encoded.empty(env.alloc)
    let answer: Result[u64, Never] = Ok(self.total)
    mem::wire::Codec[Result[u64, Never]].encode(answer, out: mut reply.bytes)
    discard attempt mut cx.reply(self.pending, reply)
} Book.settle

pub fn Book.weigh(mut self, take bytes: mem::Bytes, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    var sum: u64 = 0
    for byte in bytes.view() {
        sum = sum.wrapping_add(u64.widen(byte))
    }
    return sum
} Book.weigh

fn Book.tick(mut self, mut env: Env, mut cx: sys::Cx[Ledger]) {
    self.ticks += 1
} Book.tick

pub fn Book.resume(mut self, reason: sys::ResumeReason, mut env: Env, mut cx: sys::Cx[Ledger]) {
    env.log.info("resumed", value: reason)
    mut cx.spawn(key: 1, run: fn(out: sys::Outbox[Ledger]) fails task::Cancelled uses wait {
        discard attempt await out.tick()
    })
} Book.resume

/// What a teller serves: relaying an amount to the book its runner reaches through port 2, having
/// that book note through the teller's log, and weighing there 3 bytes past a number of kibibytes,
/// each from a keyed task that tells the teller once done.
pub protocol Till {
    pub fn relay(amount: u32) limits recorded
    pub fn note() limits recorded
    pub fn weigh(kibibytes: u32) limits recorded
    fn done() limits pure
} Till

pub closed struct TellerEnv {
    pub log: sys::Log
    pub clock: sys::Clock
    pub alloc: mem::Alloc
} TellerEnv

impl TellerEnv: nanos::Environment

pub fn TellerEnv.build(take world: nanos::World) -> TellerEnv {
    return TellerEnv(log: world.log, clock: world.clock, alloc: world.alloc)
} TellerEnv.build

pub closed struct Teller derives Encode {
    pub finished: u64
} Teller

impl Teller: sys::Component[TellerEnv, Till]

pub fn Teller.start(mut env: TellerEnv) -> Teller = Teller(finished: 0)

pub fn Teller.relay(mut self, take amount: u32, mut env: TellerEnv, mut cx: sys::Cx[Till]) {
    let book = sys::Port[Ledger].of(cx, id: 2)
    let log = env.log
    let clock = env.clock
    let alloc = env.alloc
    mut cx.spawn(key: 1, run: fn(out: sys::Outbox[Till]) fails task::Cancelled uses wait {
        var call = sys::Encoded.empty(alloc)
        let added = sys::Wire[Ledger].add(mut call, amount)
        let start = elapsed(clock)
        match attempt await book.call(added, call, alloc) {
            Ok(total) => {
                log.info("relayed", value: total)
                log.info("relayed within the recheck", value: elapsed(clock) - start < 900_000_000)
            }
            Err(_) => log.info("relayed", value: false)
        }
        discard attempt await out.done()
    })
} Teller.relay

pub fn Teller.note(mut self, mut env: TellerEnv, mut cx: sys::Cx[Till]) {
    let book = sys::Port[Ledger].of(cx, id: 2)
    let log = env.log
    let alloc = env.alloc
    mut cx.spawn(key: 2, run: fn(out: sys::Outbox[Till]) fails task::Cancelled uses wait {
        var call = sys::Encoded.empty(alloc)
        let noting = sys::Wire[Ledger].note(mut call, log)
        match attempt await book.call(noting, call, alloc) {
            Ok(given) => given.info("given back", value: true)
            Err(_) => log.info("given back", value: false)
        }
        discard attempt await out.done()
    })
} Teller.note

pub fn Teller.weigh(mut self, take kibibytes: u32, mut env: TellerEnv, mut cx: sys::Cx[Till]) {
    let book = sys::Port[Ledger].of(cx, id: 2)
    let log = env.log
    let alloc = env.alloc
    mut cx.spawn(key: 3, run: fn(out: sys::Outbox[Till]) fails task::Cancelled uses wait {
        var bytes = mem::Bytes.zeroed(usize.widen(kibibytes) * 1_024 + 3, alloc)
        for index in 0..<bytes.len() {
            bytes[index] = u8.truncate(index % 251)
        }
        var call = sys::Encoded.empty(alloc)
        let weighing = sys::Wire[Ledger].weigh(mut call, take bytes)
        match attempt await book.call(weighing, call, alloc) {
            Ok(sum) => log.info("weighed", value: sum)
            Err(_) => log.info("weighed", value: false)
        }
        discard attempt await out.done()
    })
} Teller.weigh

/// The nanoseconds of a clock, 0 once it is revoked.
fn elapsed(clock: sys::Clock) -> u64 {
    return match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} elapsed

fn Teller.done(mut self, mut env: TellerEnv, mut cx: sys::Cx[Till]) {
    self.finished += 1
} Teller.done
