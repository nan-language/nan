//! Text: owned strings, inline fixed texts, their writers, and interners. A string is a vector of bytes; a fixed text is its length and its bytes inline.

/// The offsets of an interner's record, which the interner is the address of, drawn through its
/// allocator: its lock, its allocator handle, its count of texts, the address and capacity of
/// its table of texts, the address and size of its index, and its reach, the domain holding it,
/// to which an insertion by a task of a domain nested in it passes the copy and the tables it
/// draws; then the record's size. Each interned text is a copy drawn through the allocator, which never moves; the table holds each
/// copy's address and length by symbol index, and each slot of the index, a power of two of
/// them probed linearly from a text's hash, holds a symbol index plus one, zero when empty.
const INTERNER_LOCK: u64 = 0

const INTERNER_ALLOC: u64 = 8

const INTERNER_COUNT: u64 = 16

const INTERNER_TEXTS: u64 = 24

const INTERNER_CAPACITY: u64 = 32

const INTERNER_SLOTS: u64 = 40

const INTERNER_SLOT_COUNT: u64 = 48

const INTERNER_REACH: u64 = 56

const INTERNER_SIZE: u64 = 64

/// The bytes of an entry of an interner's table: a copy's address and length.
const TEXT_ENTRY: u64 = 16

/// The most texts an interner holds: one per `u32` index.
const MOST_TEXTS: i64 = 0x1_0000_0000

const TEXT_BYTE: Element = Element(size: 1, align: 1)

fn text_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) -> bool {
    let path = supply.path.as_str()
    let owner_end = match check::last_dot(path) {
        Some(dot) => dot
        None => 0
    }
    let Some(owner) = path.slice_bytes(0, end: owner_end) else {
        expect false
        return false
    }
    match owner {
        "text::String" => text_string(mut lo, mut fx, supply)
        "text::Fixed" => text_fixed(mut lo, mut fx, supply)
        "text::Interner" => interner(mut lo, mut fx, supply)
        else => return false
    }
    return true
} text_lower

/// Whether releasing a text type does anything, none for a type std declares in full.
fn text_needs_release(owner_path: Str) -> Option[bool] {
    return match owner_path {
        "text::String" or "text::Interner" => Some(true)
        "text::Fixed" => Some(false)
        else => None
    }
} text_needs_release

/// Whether moving a text type into another domain's reach does anything, none for a type std
/// declares in full.
fn text_transfers(owner_path: Str) -> Option[bool] {
    return match owner_path {
        "text::String" or "text::Interner" => Some(true)
        else => None
    }
} text_transfers

/// Moves a value of a text type at an address into another domain's reach; false for a type
/// std declares in full.
fn text_transfer(mut lo: Lowering, mut fx: Fx, owner_path: Str, address: clif::Value, lift: clif::Value) -> bool {
    match owner_path {
        "text::String" => {
            let none = mut fx.ptr(0)
            vector_transfer(mut lo, mut fx, address, element: lists_byte(), from: None, lift, owner: none)
        }
        "text::Interner" => {
            let record = mut fx.load(PTR, addr: address, offset: 0)
            let lifting = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: lift, y: 0)
            mut fx.if_true(lifting, then: fn(mut fx1: Fx) {
                mut fx1.store(lift, addr: record, offset: INTERNER_REACH)
            })
            discard transfer_lift(mut lo, mut fx, address: record, lift)
            let count = mut fx.load(PTR, addr: record, offset: INTERNER_COUNT)
            let zero = mut fx.ptr(0)
            mut fx.each(zero, end: count, body: fn[mut lo](mut fx1: Fx, index: clif::Value) {
                let entry = text_text_entry(mut fx1, record, index)
                let copied = mut fx1.load(PTR, addr: entry, offset: 0)
                discard transfer_lift(mut lo, fx: mut fx1, address: copied, lift)
            })
            lift_tables(mut lo, mut fx, record, lift)
        }
        else => return false
    }
    return true
} text_transfer

/// Passes the storage of an interner's text and slot tables to a domain.
fn lift_tables(mut lo: Lowering, mut fx: Fx, record: clif::Value, lift: clif::Value) {
    lift_storage(mut lo, mut fx, record, field: INTERNER_TEXTS, size: INTERNER_CAPACITY, lift)
    lift_storage(mut lo, mut fx, record, field: INTERNER_SLOTS, size: INTERNER_SLOT_COUNT, lift)
} lift_tables

/// Moves an interner's table or index, at `field` of its record, into another domain's reach
/// when its size at `size` is not zero.
fn lift_storage(mut lo: Lowering, mut fx: Fx, record: clif::Value, field: u64, size: u64, lift: clif::Value) {
    let held = mut fx.load(PTR, addr: record, offset: size)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: held, y: 0)
    mut fx.if_true(present, then: fn[mut lo](mut fx1: Fx) {
        let storage = mut fx1.load(PTR, addr: record, offset: field)
        discard transfer_lift(mut lo, fx: mut fx1, address: storage, lift)
    })
} lift_storage

/// Releases a value of a text type at an address; false for a type std declares in full.
fn text_release(mut lo: Lowering, mut fx: Fx, owner_path: Str, address: clif::Value) -> bool {
    match owner_path {
        "text::String" => free_storage(mut lo, mut fx, address)
        "text::Interner" => release_interner(mut lo, mut fx, address)
        else => return false
    }
    return true
} text_release

fn text_string(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let address = supply.param(0).address_value()
    match supply.member() {
        "empty" => {
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            let alloc = mut fx.load(PTR, addr: address, offset: 0)
            vector_empty(mut fx, address: sret, alloc, element: TEXT_BYTE)
        }
        "as_str" => {
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            vector_write_view(mut fx, view: sret, address)
        }
        "push" or "try_push" => {
            let buffer = mut fx.slot(4, align: 1)
            let len = encode_utf8(mut fx, c: supply.param(1).scalar_value(), buffer)
            lists_append(mut lo, mut fx, supply, address, start: buffer, count: len)
        }
        "append" or "try_append" => {
            let text_view = supply.param(1).address_value()
            let start = mut fx.load(PTR, addr: text_view, offset: 0)
            let len = mut fx.load(PTR, addr: text_view, offset: 8)
            lists_append(mut lo, mut fx, supply, address, start, count: len)
        }
        "clear" => {
            let zero = mut fx.ptr(0)
            mut fx.store(zero, addr: address, offset: VECTOR_LEN)
        }
        "into_bytes" => {
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            mut lo.copy(mut fx, dst: sret, src: address, size: 32, align: 8)
        }
        "write" or "try_write" => string_write(mut lo, mut fx, supply)
        else => {
            expect false
        }
    }
    supply.done(mut lo, mut fx)
} text_string

/// `String.write(value, budget)` and `try_write`: renders once to measure the output, then
/// again into storage drawn for exactly that output.
fn string_write(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let address = supply.param(0).address_value()
    let value = supply.param(1).address_value()
    let budget = supply.param(2).scalar_value()
    let none = mut fx.ptr(0)
    let measure = new_renderer(mut fx, buffer: none, budget)
    render_dyn(mut fx, address: value, renderer_value: measure)
    let written = render_written(mut fx, renderer_value: measure)
    let elided = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: written, y: budget)
    let three = mut fx.ptr(3)
    let dots = mut fx.b.umin(budget, y: three)
    let zero = mut fx.ptr(0)
    let marker = mut fx.b.select(elided, x: dots, y: zero)
    let room = mut fx.b.isub(budget, y: dots)
    let end_results = fx.types1(PTR)
    let ends = mut fx.choose(elided, results: end_results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let end = elided_end(mut fx1, value, budget, room)
        return fx1.list1(end)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(written)
    })
    expect ends.len() == 1
    let end = ends[0]
    let output = mut fx.b.iadd(end, y: marker)
    let len = mut fx.load(PTR, addr: address, offset: VECTOR_LEN)
    let sum = mut fx.b.uadd_overflow(len, y: output)
    let needed = sum.value
    let drawn_results = fx.types1(clif::Type.Int8)
    let drawn = mut fx.choose_in(mut lo, condition: sum.flag, results: drawn_results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let none_drawn = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(none_drawn)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let reserved = vector_reserve(mut lo1, fx: mut fx1, address, needed, element: TEXT_BYTE)
        return fx1.list1(reserved)
    })
    expect drawn.len() == 1
    let failed = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: drawn[0], y: 0)
    mut fx.if_true(failed, then: fn[mut lo](mut fx1: Fx) {
        let none_taken = mem::List[Taken].empty(fx1.alloc)
        supply.exhausted(mut lo, fx: mut fx1, taken: none_taken.view())
    })
    let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
    let target = mut fx.b.iadd(data, y: len)
    let keep = window_renderer(mut fx, buffer: target, budget, skip: zero, limit: end)
    render_dyn(mut fx, address: value, renderer_value: keep)
    let marked = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: marker, y: 0)
    mut fx.if_true(marked, then: fn[mut lo](mut fx1: Fx) {
        let literal_held = mut lo.view_literal(fx: mut fx1, contents: b"...")
        let literal = literal_held.address_value()
        let dots_start = mut fx1.load(PTR, addr: literal, offset: 0)
        let at = mut fx1.b.iadd(target, y: end)
        let args = fx1.list3(at, b: dots_start, c: marker)
        discard mut lo.call_routine(fx: mut fx1, routine: Routine.Copy, args: args.view())
    })
    mut fx.store(needed, addr: address, offset: VECTOR_LEN)
} string_write

/// The length of the longest prefix of the elided rendering of a `Dyn[Render]` value within
/// `budget` that ends at a char boundary within `room` bytes, read from the bytes the rendering
/// holds around `room`.
fn elided_end(mut fx: Fx, value: clif::Value, budget: clif::Value, room: clif::Value) -> clif::Value {
    let three = mut fx.ptr(3)
    let back = mut fx.b.umin(room, y: three)
    let skip = mut fx.b.isub(room, y: back)
    let window = mut fx.slot(4, align: 1)
    let four = mut fx.ptr(4)
    let renderer = window_renderer(mut fx, buffer: window, budget, skip, limit: four)
    render_dyn(mut fx, address: value, renderer_value: renderer)
    let initial = fx.list1(room)
    let ends = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, carried: Slice[clif::Value]) -> Pass {
        expect carried.len() == 1
        let end = carried[0]
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedGreaterThan, x: end, y: skip)
        let results = fx1.types1(clif::Type.Int8)
        let continued = mut fx1.choose(inside, results: results.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let offset = mut fx2.b.isub(end, y: skip)
            let at = mut fx2.b.iadd(window, y: offset)
            let byte = mut fx2.load(clif::Type.Int8, addr: at, offset: 0)
            let high = mut fx2.b.band_imm_s(byte, y: 0xC0)
            let following = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: high, y: 0x80)
            return fx2.list1(following)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let outside = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(outside)
        })
        expect continued.len() == 1
        let continuation = continued[0]
        let earlier = mut fx1.b.iadd_imm_s(end, y: -1)
        let next = mut fx1.b.select(continuation, x: earlier, y: end)
        return Pass(again: continuation, next: fx1.list1(next))
    })
    expect ends.len() == 1
    return ends[0]
} elided_end

fn text_fixed(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let Some(fixed_ty) = supply.owner else {
        expect false
        return
    }
    let capacity = const_count(lo, ty: fixed_ty, index: 0)
    let len_field = mut lo.layouts.field(lo.ck, ty: fixed_ty, variant: None, label: "len")
    let len_at = len_field.offset
    let bytes_field = mut lo.layouts.field(lo.ck, ty: fixed_ty, variant: None, label: "bytes")
    let bytes_at = bytes_field.offset
    if supply.member() == "empty" {
        let Some(sret) = supply.sret else {
            expect false
            return
        }
        let zero = mut fx.ptr(0)
        mut fx.store(zero, addr: sret, offset: len_at)
        supply.done(mut lo, mut fx)
        return
    }
    let address = supply.param(0).address_value()
    let len = mut fx.load(PTR, addr: address, offset: len_at)
    let bytes = mut fx.offset(address, offset: bytes_at)
    let end = mut fx.b.iadd(bytes, y: len)
    match supply.member() {
        "as_str" => {
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            mut fx.store(bytes, addr: sret, offset: 0)
            mut fx.store(len, addr: sret, offset: 8)
        }
        "push" => {
            let added = encode_utf8(mut fx, c: supply.param(1).scalar_value(), buffer: end)
            let grown = mut fx.b.iadd(len, y: added)
            mut fx.store(grown, addr: address, offset: len_at)
        }
        "append" => {
            let text_view = supply.param(1).address_value()
            let start = mut fx.load(PTR, addr: text_view, offset: 0)
            let added = mut fx.load(PTR, addr: text_view, offset: 8)
            let args = fx.list3(end, b: start, c: added)
            discard mut lo.call_routine(mut fx, routine: Routine.Copy, args: args.view())
            let grown = mut fx.b.iadd(len, y: added)
            mut fx.store(grown, addr: address, offset: len_at)
        }
        "clear" => {
            let zero = mut fx.ptr(0)
            mut fx.store(zero, addr: address, offset: len_at)
        }
        "write" or "try_write" => {
            let value = supply.param(1).address_value()
            let budget = supply.param(2).scalar_value()
            let full = mut fx.ptr(capacity)
            let room = mut fx.b.isub(full, y: len)
            let limited = mut fx.b.umin(budget, y: room)
            let renderer = new_renderer(mut fx, buffer: end, budget: limited)
            render_dyn(mut fx, address: value, renderer_value: renderer)
            let added = render_finish(mut lo, mut fx, renderer_value: renderer)
            let grown = mut fx.b.iadd(len, y: added)
            mut fx.store(grown, addr: address, offset: len_at)
        }
        else => {
            expect false
        }
    }
    supply.done(mut lo, mut fx)
} text_fixed

fn interner(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    if supply.member() == "empty" {
        interner_empty(mut lo, mut fx, supply)
        return
    }
    let record = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
    let lock = mut fx.offset(record, offset: INTERNER_LOCK)
    let lock_args = fx.list1(lock)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: lock_args.view())
    match supply.member() {
        "len" => {
            let count = mut fx.load(PTR, addr: record, offset: INTERNER_COUNT)
            discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: lock_args.view())
            supply.ret(mut lo, mut fx, held: Held.Scalar(count))
        }
        "intern" or "try_intern" or "lookup" => interner_intern(mut lo, mut fx, supply, record, lock)
        "resolve" => interner_resolve(mut lo, mut fx, supply, record, lock)
        else => {
            expect false
        }
    }
} interner

/// `Interner.empty`: a new interner's record, zeroed but for its allocator handle.
fn interner_empty(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let alloc = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
    let size = mut fx.ptr(INTERNER_SIZE)
    let align = mut fx.ptr(8)
    let alloc_args = fx.list3(alloc, b: size, c: align)
    let record_results = mut lo.call_routine(mut fx, routine: Routine.Alloc, args: alloc_args.view())
    expect record_results.len() == 1
    let record = record_results[0]
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
    mut fx.if_true(missing, then: fn[mut lo](mut fx1: Fx) {
        raise_kind(mut lo, fx: mut fx1, kind: "trap.exhausted")
    })
    let zero = mut fx.ptr(0)
    let fill_args = fx.list3(record, b: zero, c: size)
    discard mut lo.call_routine(mut fx, routine: Routine.Fill, args: fill_args.view())
    mut fx.store(alloc, addr: record, offset: INTERNER_ALLOC)
    let reach = current_domain(mut lo, mut fx)
    mut fx.store(reach, addr: record, offset: INTERNER_REACH)
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    mut fx.store(record, addr: sret, offset: 0)
    supply.done(mut lo, mut fx)
} interner_empty

/// `intern`, `try_intern` and `lookup` of a text, the interner's lock held: the symbol of an
/// interned text equal to it; `intern` and `try_intern` intern it when none is.
fn interner_intern(mut lo: Lowering, mut fx: Fx, supply: Supply, record: clif::Value, lock: clif::Value) {
    let text_view = supply.param(1).address_value()
    let start = mut fx.load(PTR, addr: text_view, offset: 0)
    let len = mut fx.load(PTR, addr: text_view, offset: 8)
    let hash = hash_text(mut fx, start, len)
    let found = text_find(mut lo, mut fx, record, hash, start, len)
    let lock_args = fx.list1(lock)
    if supply.member() == "lookup" {
        discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: lock_args.view())
        let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: found, y: 0)
        let index = mut fx.b.iadd_imm_s(found, y: -1)
        let option = supply.abi.result
        let laid = mut lo.layout_of(option)
        let result = match supply.sret {
            Some(sret) => sret
            None => mut fx.slot(laid.contents().size, align: laid.contents().align)
        }
        mut lo.write_option_with(mut fx, layout_ty: option, address: result, presence: present, write_payload: fn(mut lo1: Lowering, mut fx1: Fx, payload: clif::Value) {
            let symbol = mut fx1.b.ireduce(clif::Type.Int32, x: index)
            mut fx1.store(symbol, addr: payload, offset: 0)
        })
        let held = mut lo.held_at(mut fx, ty: option, address: result)
        supply.ret(mut lo, mut fx, held)
        return
    }
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: found, y: 0)
    mut fx.if_true(present, then: fn[mut lo](mut fx1: Fx) {
        let unlock_args = fx1.list1(lock)
        discard mut lo.call_routine(fx: mut fx1, routine: Routine.Unlock, args: unlock_args.view())
        let index = mut fx1.b.iadd_imm_s(found, y: -1)
        return_symbol(mut lo, fx: mut fx1, supply, index)
    })
    let index = text_insert(mut lo, mut fx, supply, record, hash, start, len)
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: lock_args.view())
    lift_insertion(mut lo, mut fx, record, index)
    return_symbol(mut lo, mut fx, supply, index)
} interner_intern

/// Passes what an insertion by a task of a domain nested in the interner's reach drew to that
/// reach: the copy of the text at `index` and the interner's tables.
fn lift_insertion(mut lo: Lowering, mut fx: Fx, record: clif::Value, index: clif::Value) {
    let reach = mut fx.load(PTR, addr: record, offset: INTERNER_REACH)
    let domain = current_domain(mut lo, mut fx)
    let nested = nested_in(mut fx, inner: domain, outer: reach)
    mut fx.if_true(nested, then: fn[mut lo](mut fx1: Fx) {
        let entry = text_text_entry(mut fx1, record, index)
        let copied = mut fx1.load(PTR, addr: entry, offset: 0)
        discard transfer_lift(mut lo, fx: mut fx1, address: copied, lift: reach)
        lift_tables(mut lo, fx: mut fx1, record, lift: reach)
    })
} lift_insertion

/// `Interner.resolve`: the text of a symbol, the interner's lock held, trapping with
/// `trap.bounds` for a symbol of no text.
fn interner_resolve(mut lo: Lowering, mut fx: Fx, supply: Supply, record: clif::Value, lock: clif::Value) {
    let symbol = supply.param(1)
    let narrow_index = match symbol {
        Held.Scalar(index) => index
        else => mut fx.load(clif::Type.Int32, addr: symbol.address_value(), offset: 0)
    }
    let index = mut fx.b.uextend(PTR, x: narrow_index)
    let count = mut fx.load(PTR, addr: record, offset: INTERNER_COUNT)
    let outside = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThanOrEqual, x: index, y: count)
    mut fx.if_true(outside, then: fn[mut lo](mut fx1: Fx) {
        let unlock_args = fx1.list1(lock)
        discard mut lo.call_routine(fx: mut fx1, routine: Routine.Unlock, args: unlock_args.view())
        raise_kind(mut lo, fx: mut fx1, kind: "trap.bounds")
    })
    let entry = text_text_entry(mut fx, record, index)
    let start = mut fx.load(PTR, addr: entry, offset: 0)
    let len = mut fx.load(PTR, addr: entry, offset: 8)
    let lock_args = fx.list1(lock)
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: lock_args.view())
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    mut fx.store(start, addr: sret, offset: 0)
    mut fx.store(len, addr: sret, offset: 8)
    supply.done(mut lo, mut fx)
} interner_resolve

/// Returns the symbol of an index.
fn return_symbol(mut lo: Lowering, mut fx: Fx, supply: Supply, index: clif::Value) {
    let symbol = supply.abi.result
    let laid = mut lo.layout_of(symbol)
    let slot = mut fx.slot(laid.contents().size, align: laid.contents().align)
    let narrow_index = mut fx.b.ireduce(clif::Type.Int32, x: index)
    mut fx.store(narrow_index, addr: slot, offset: 0)
    let held = mut lo.held_at(mut fx, ty: symbol, address: slot)
    supply.ret(mut lo, mut fx, held)
} return_symbol

/// The FNV-1a hash of bytes.
fn hash_text(mut fx: Fx, start: clif::Value, len: clif::Value) -> clif::Value {
    let basis = mut fx.int(PTR, value: i64.from_bits(0xcbf2_9ce4_8422_2325))
    let zero = mut fx.ptr(0)
    let initial = fx.list2(zero, b: basis)
    let hashed = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, carried: Slice[clif::Value]) -> Pass {
        expect carried.len() == 2
        let at = carried[0]
        let hash = carried[1]
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: len)
        let results = fx1.types2(PTR, b: PTR)
        let next = mut fx1.choose(inside, results: results.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let address = mut fx2.b.iadd(start, y: at)
            let byte = mut fx2.load(clif::Type.Int8, addr: address, offset: 0)
            let widened = mut fx2.b.uextend(PTR, x: byte)
            let xored = mut fx2.b.bxor(hash, y: widened)
            let mixed = mut fx2.b.imul_imm_s(xored, y: 0x0100_0000_01b3)
            let following = mut fx2.b.iadd_imm_s(at, y: 1)
            return fx2.list2(following, b: mixed)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list2(at, b: hash)
        })
        return Pass(again: inside, next: take next)
    })
    expect hashed.len() == 2
    return hashed[1]
} hash_text

/// The address of the table entry of a symbol index.
fn text_text_entry(mut fx: Fx, record: clif::Value, index: clif::Value) -> clif::Value {
    let texts = mut fx.load(PTR, addr: record, offset: INTERNER_TEXTS)
    let offset = mut fx.b.imul_imm_s(index, y: i64.fit(TEXT_ENTRY))
    return mut fx.b.iadd(texts, y: offset)
} text_text_entry

/// The symbol index plus one of an interned text equal to the given bytes, zero when none is.
fn text_find(mut lo: Lowering, mut fx: Fx, record: clif::Value, hash: clif::Value, start: clif::Value, len: clif::Value) -> clif::Value {
    let slots = mut fx.load(PTR, addr: record, offset: INTERNER_SLOTS)
    let slot_count = mut fx.load(PTR, addr: record, offset: INTERNER_SLOT_COUNT)
    let indexed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: slot_count, y: 0)
    let results = fx.types1(PTR)
    let found = mut fx.choose_in(mut lo, condition: indexed, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let mask = mut fx1.b.iadd_imm_s(slot_count, y: -1)
        let start_position = mut fx1.b.band(hash, y: mask)
        let initial = fx1.list2(start_position, b: start_position)
        let probed = mut fx1.repeat(initial.view(), body: fn[mut lo1](mut fx2: Fx, carried: Slice[clif::Value]) -> Pass {
            expect carried.len() == 2
            return probe_slot(mut lo1, fx: mut fx2, record, slots, mask, start, len, position: carried[0])
        })
        expect probed.len() == 2
        return fx1.list1(probed[1])
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let none_found = mut fx1.ptr(0)
        return fx1.list1(none_found)
    })
    expect found.len() == 1
    return found[0]
} text_find

/// One probe of `text_find` at a slot position of an interner's index: whether to probe the
/// next slot, the next position and the symbol index plus one of an equal text found there.
fn probe_slot(mut lo: Lowering, mut fx: Fx, record: clif::Value, slots: clif::Value, mask: clif::Value, start: clif::Value, len: clif::Value, position: clif::Value) -> Pass {
    let offset = mut fx.b.imul_imm_s(position, y: 4)
    let at = mut fx.b.iadd(slots, y: offset)
    let narrow_held = mut fx.load(clif::Type.Int32, addr: at, offset: 0)
    let held = mut fx.b.uextend(PTR, x: narrow_held)
    let empty = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: held, y: 0)
    let results = fx.types1(clif::Type.Int8)
    let matched = mut fx.choose_in(mut lo, condition: empty, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let unmatched = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(unmatched)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let index = mut fx1.b.iadd_imm_s(held, y: -1)
        let entry = text_text_entry(mut fx1, record, index)
        let other = mut fx1.load(PTR, addr: entry, offset: 0)
        let other_len = mut fx1.load(PTR, addr: entry, offset: 8)
        let same_len = mut fx1.b.icmp(clif::IntCC.Equal, x: other_len, y: len)
        let same_results = fx1.types1(clif::Type.Int8)
        return mut fx1.choose_in(mut lo1, condition: same_len, results: same_results.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let args = fx2.list3(other, b: start, c: len)
            let order = mut lo2.call_routine(fx: mut fx2, routine: Routine.Compare, args: args.view())
            expect order.len() == 1
            let equal = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: order[0], y: 0)
            return fx2.list1(equal)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let unequal = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(unequal)
        })
    })
    expect matched.len() == 1
    let same = matched[0]
    let stop = mut fx.b.bor(empty, y: same)
    let following = mut fx.b.iadd_imm_s(position, y: 1)
    let next = mut fx.b.band(following, y: mask)
    let zero = mut fx.ptr(0)
    let result = mut fx.b.select(same, x: held, y: zero)
    let again = mut fx.b.bxor_imm_s(stop, y: 1)
    return Pass(again: again, next: fx.list2(next, b: result))
} probe_slot

/// Puts a symbol index plus one in the first empty slot from a hash of an index with room.
fn text_place(mut fx: Fx, slots: clif::Value, slot_count: clif::Value, hash: clif::Value, held: clif::Value) {
    let mask = mut fx.b.iadd_imm_s(slot_count, y: -1)
    let start_position = mut fx.b.band(hash, y: mask)
    let initial = fx.list1(start_position)
    discard mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, carried: Slice[clif::Value]) -> Pass {
        expect carried.len() == 1
        let position = carried[0]
        let offset = mut fx1.b.imul_imm_s(position, y: 4)
        let at = mut fx1.b.iadd(slots, y: offset)
        let current = mut fx1.load(clif::Type.Int32, addr: at, offset: 0)
        let empty = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: current, y: 0)
        mut fx1.if_true(empty, then: fn(mut fx2: Fx) {
            let narrow_held = mut fx2.b.ireduce(clif::Type.Int32, x: held)
            mut fx2.store(narrow_held, addr: at, offset: 0)
        })
        let following = mut fx1.b.iadd_imm_s(position, y: 1)
        let next = mut fx1.b.band(following, y: mask)
        let again = mut fx1.b.bxor_imm_s(empty, y: 1)
        return Pass(again: again, next: fx1.list1(next))
    })
} text_place

/// Interns a text absent from an interner, whose lock the caller holds: draws its copy and any
/// larger table and index first, so that exhaustion, which unlocks and traps or fails, changes
/// nothing. Gives the new symbol index.
fn text_insert(mut lo: Lowering, mut fx: Fx, supply: Supply, record: clif::Value, hash: clif::Value, start: clif::Value, len: clif::Value) -> clif::Value {
    let lock = mut fx.offset(record, offset: INTERNER_LOCK)
    let alloc = mut fx.load(PTR, addr: record, offset: INTERNER_ALLOC)
    let count = mut fx.load(PTR, addr: record, offset: INTERNER_COUNT)
    let capacity = mut fx.load(PTR, addr: record, offset: INTERNER_CAPACITY)
    let slot_count = mut fx.load(PTR, addr: record, offset: INTERNER_SLOT_COUNT)
    let full = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: count, y: MOST_TEXTS)
    mut fx.if_true(full, then: fn[mut lo](mut fx1: Fx) {
        let none_drawn = mem::List[clif::Value].empty(fx1.alloc)
        insert_exhausted(mut lo, fx: mut fx1, supply, lock, drawn: none_drawn.view())
    })
    let one = mut fx.ptr(1)
    let copy_size = mut fx.b.umax(len, y: one)
    let copy_args = fx.list3(alloc, b: copy_size, c: one)
    let copy_results = mut lo.call_routine(mut fx, routine: Routine.Alloc, args: copy_args.view())
    expect copy_results.len() == 1
    let copy = copy_results[0]
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: copy, y: 0)
    mut fx.if_true(missing, then: fn[mut lo](mut fx1: Fx) {
        let none_drawn = mem::List[clif::Value].empty(fx1.alloc)
        insert_exhausted(mut lo, fx: mut fx1, supply, lock, drawn: none_drawn.view())
    })
    let grows = mut fx.b.icmp(clif::IntCC.Equal, x: count, y: capacity)
    let doubled = mut fx.b.ishl_imm_s(capacity, y: 1)
    let eight = mut fx.ptr(8)
    let wanted = mut fx.b.umax(doubled, y: eight)
    let table = insert_table(mut lo, mut fx, supply, lock, alloc, copy, grows, wanted)
    let after = mut fx.b.iadd_imm_s(count, y: 1)
    let loaded = mut fx.b.ishl_imm_s(after, y: 1)
    let rehash = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: loaded, y: slot_count)
    let doubled_slots = mut fx.b.ishl_imm_s(slot_count, y: 1)
    let sixteen = mut fx.ptr(16)
    let new_slot_count = mut fx.b.umax(doubled_slots, y: sixteen)
    let index = insert_index(mut lo, mut fx, supply, lock, alloc, copy, table, rehash, new_slot_count)
    mut fx.if_true(grows, then: fn[mut lo](mut fx1: Fx) {
        grow_table(mut lo, fx: mut fx1, record, table, count, capacity, wanted)
    })
    let text_args = fx.list3(copy, b: start, c: len)
    discard mut lo.call_routine(mut fx, routine: Routine.Copy, args: text_args.view())
    let entry = text_text_entry(mut fx, record, index: count)
    mut fx.store(copy, addr: entry, offset: 0)
    mut fx.store(len, addr: entry, offset: 8)
    mut fx.if_true(rehash, then: fn[mut lo](mut fx1: Fx) {
        rehash_index(mut lo, fx: mut fx1, record, index, count, slot_count, new_slot_count)
    })
    let slots = mut fx.load(PTR, addr: record, offset: INTERNER_SLOTS)
    let current_slot_count = mut fx.load(PTR, addr: record, offset: INTERNER_SLOT_COUNT)
    text_place(mut fx, slots, slot_count: current_slot_count, hash, held: after)
    mut fx.store(after, addr: record, offset: INTERNER_COUNT)
    return count
} text_insert

/// Ends `text_insert` on exhaustion: frees what it drew so far, at the nonzero addresses of
/// `drawn`, unlocks the interner and ends the operation as exhaustion does.
fn insert_exhausted(mut lo: Lowering, mut fx: Fx, supply: Supply, lock: clif::Value, drawn: Slice[clif::Value]) {
    for address in drawn {
        let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: address, y: 0)
        mut fx.if_true(present, then: fn[mut lo](mut fx1: Fx) {
            let free_args = fx1.list1(address)
            discard mut lo.call_routine(fx: mut fx1, routine: Routine.Free, args: free_args.view())
        })
    }
    let unlock_args = fx.list1(lock)
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: unlock_args.view())
    let none_taken = mem::List[Taken].empty(fx.alloc)
    supply.exhausted(mut lo, mut fx, taken: none_taken.view())
} insert_exhausted

/// The larger table `text_insert` draws when the interner's is full, zero when it has room.
fn insert_table(mut lo: Lowering, mut fx: Fx, supply: Supply, lock: clif::Value, alloc: clif::Value, copy: clif::Value, grows: clif::Value, wanted: clif::Value) -> clif::Value {
    let results = fx.types1(PTR)
    let table = mut fx.choose_in(mut lo, condition: grows, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let bytes = mut fx1.b.imul_imm_s(wanted, y: i64.fit(TEXT_ENTRY))
        let align = mut fx1.ptr(8)
        let alloc_args = fx1.list3(alloc, b: bytes, c: align)
        let drawn_table_results = mut lo1.call_routine(fx: mut fx1, routine: Routine.Alloc, args: alloc_args.view())
        expect drawn_table_results.len() == 1
        let drawn_table = drawn_table_results[0]
        let missing = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: drawn_table, y: 0)
        mut fx1.if_true(missing, then: fn[mut lo1](mut fx2: Fx) {
            let drawn = fx2.list1(copy)
            insert_exhausted(mut lo1, fx: mut fx2, supply, lock, drawn: drawn.view())
        })
        return fx1.list1(drawn_table)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let no_table = mut fx1.ptr(0)
        return fx1.list1(no_table)
    })
    expect table.len() == 1
    return table[0]
} insert_table

/// The larger index `text_insert` draws, zeroed, when the interner's would be more than half
/// full, zero otherwise.
fn insert_index(mut lo: Lowering, mut fx: Fx, supply: Supply, lock: clif::Value, alloc: clif::Value, copy: clif::Value, table: clif::Value, rehash: clif::Value, new_slot_count: clif::Value) -> clif::Value {
    let results = fx.types1(PTR)
    let index = mut fx.choose_in(mut lo, condition: rehash, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let bytes = mut fx1.b.imul_imm_s(new_slot_count, y: 4)
        let align = mut fx1.ptr(4)
        let alloc_args = fx1.list3(alloc, b: bytes, c: align)
        let drawn_index_results = mut lo1.call_routine(fx: mut fx1, routine: Routine.Alloc, args: alloc_args.view())
        expect drawn_index_results.len() == 1
        let drawn_index = drawn_index_results[0]
        let missing = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: drawn_index, y: 0)
        mut fx1.if_true(missing, then: fn[mut lo1](mut fx2: Fx) {
            let drawn = fx2.list2(copy, b: table)
            insert_exhausted(mut lo1, fx: mut fx2, supply, lock, drawn: drawn.view())
        })
        let zero = mut fx1.ptr(0)
        let fill_args = fx1.list3(drawn_index, b: zero, c: bytes)
        discard mut lo1.call_routine(fx: mut fx1, routine: Routine.Fill, args: fill_args.view())
        return fx1.list1(drawn_index)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let no_index = mut fx1.ptr(0)
        return fx1.list1(no_index)
    })
    expect index.len() == 1
    return index[0]
} insert_index

/// Moves an interner's table to the larger one drawn for it, freeing the old one when it held
/// an allocation.
fn grow_table(mut lo: Lowering, mut fx: Fx, record: clif::Value, table: clif::Value, count: clif::Value, capacity: clif::Value, wanted: clif::Value) {
    let old = mut fx.load(PTR, addr: record, offset: INTERNER_TEXTS)
    let bytes = mut fx.b.imul_imm_s(count, y: i64.fit(TEXT_ENTRY))
    let copy_args = fx.list3(table, b: old, c: bytes)
    discard mut lo.call_routine(mut fx, routine: Routine.Copy, args: copy_args.view())
    let had = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: capacity, y: 0)
    mut fx.if_true(had, then: fn[mut lo](mut fx1: Fx) {
        let free_args = fx1.list1(old)
        discard mut lo.call_routine(fx: mut fx1, routine: Routine.Free, args: free_args.view())
    })
    mut fx.store(table, addr: record, offset: INTERNER_TEXTS)
    mut fx.store(wanted, addr: record, offset: INTERNER_CAPACITY)
} grow_table

/// Places every interned text of an interner in the larger index drawn for it, then frees the
/// old index when it held an allocation.
fn rehash_index(mut lo: Lowering, mut fx: Fx, record: clif::Value, index: clif::Value, count: clif::Value, slot_count: clif::Value, new_slot_count: clif::Value) {
    let old = mut fx.load(PTR, addr: record, offset: INTERNER_SLOTS)
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: count, body: fn(mut fx1: Fx, existing: clif::Value) {
        let entry = text_text_entry(mut fx1, record, index: existing)
        let copied = mut fx1.load(PTR, addr: entry, offset: 0)
        let copied_len = mut fx1.load(PTR, addr: entry, offset: 8)
        let hash = hash_text(mut fx1, start: copied, len: copied_len)
        let held = mut fx1.b.iadd_imm_s(existing, y: 1)
        text_place(mut fx1, slots: index, slot_count: new_slot_count, hash, held)
    })
    let had = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: slot_count, y: 0)
    mut fx.if_true(had, then: fn[mut lo](mut fx1: Fx) {
        let free_args = fx1.list1(old)
        discard mut lo.call_routine(fx: mut fx1, routine: Routine.Free, args: free_args.view())
    })
    mut fx.store(index, addr: record, offset: INTERNER_SLOTS)
    mut fx.store(new_slot_count, addr: record, offset: INTERNER_SLOT_COUNT)
} rehash_index

/// Releases an interner: its texts, table, index and record.
fn release_interner(mut lo: Lowering, mut fx: Fx, address: clif::Value) {
    let record = mut fx.load(PTR, addr: address, offset: 0)
    let count = mut fx.load(PTR, addr: record, offset: INTERNER_COUNT)
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: count, body: fn[mut lo](mut fx1: Fx, index: clif::Value) {
        let entry = text_text_entry(mut fx1, record, index)
        let copied = mut fx1.load(PTR, addr: entry, offset: 0)
        let free_args = fx1.list1(copied)
        discard mut lo.call_routine(fx: mut fx1, routine: Routine.Free, args: free_args.view())
    })
    free_storage_of(mut lo, mut fx, record, field: INTERNER_TEXTS, size: INTERNER_CAPACITY)
    free_storage_of(mut lo, mut fx, record, field: INTERNER_SLOTS, size: INTERNER_SLOT_COUNT)
    let free_args = fx.list1(record)
    discard mut lo.call_routine(mut fx, routine: Routine.Free, args: free_args.view())
} release_interner

/// Frees an interner's table or index, at `field` of its record, when its size at `size` is
/// not zero.
fn free_storage_of(mut lo: Lowering, mut fx: Fx, record: clif::Value, field: u64, size: u64) {
    let held = mut fx.load(PTR, addr: record, offset: size)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: held, y: 0)
    mut fx.if_true(present, then: fn[mut lo](mut fx1: Fx) {
        let storage = mut fx1.load(PTR, addr: record, offset: field)
        let free_args = fx1.list1(storage)
        discard mut lo.call_routine(fx: mut fx1, routine: Routine.Free, args: free_args.view())
    })
} free_storage_of
