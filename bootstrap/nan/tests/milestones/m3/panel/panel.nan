//! The signal a panel shows for a gauge reading.

/// What a panel shows.
enum Signal derives Eq {
    Start
    Stop
} Signal

/// The signal for a raw gauge reading: `Stop` at full scale.
fn signal(raw: u32) -> Signal {
    if gauge::percent(raw) == 100 {
        return Signal.Stop
    }
    return Signal.Start
} signal

test full_scale_stops for signal {
    expect signal(1_024) == Signal.Stop
    expect signal(0) == Signal.Start
} full_scale_stops
