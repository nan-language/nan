    let reply = try await runner.call(4, hash: Wire[Meter].hash(), bytes: call.bytes.view(), handles: call.handles.view(), alloc: world.alloc)
    let Ok(Ok(port)) = attempt mem::wire::Codec[Result[u64, Full]].decode(Untrusted.of(reply.bytes.view()), alloc: world.alloc) else {
        expect false
        return
    }
    expect port == 4
} runner_calls_give_their_kinds_reply

