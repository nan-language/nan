//! Files, directories and their metadata.

const O_RDONLY: i32 = 0

const O_WRONLY: i32 = 1

const O_RDWR: i32 = 2

const O_NOFOLLOW: i32 = 0x100

const O_CREAT: i32 = 0x200

const O_TRUNC: i32 = 0x400

const O_EXCL: i32 = 0x800

const O_DIRECTORY: i32 = 0x10_0000

const O_CLOEXEC: i32 = 0x100_0000

/// The directory `openat` and `unlinkat` resolve relative paths in when given no descriptor.
const AT_FDCWD: i32 = -2

const AT_REMOVEDIR: i32 = 0x80

const LOCK_SH: i32 = 1

const LOCK_EX: i32 = 2

const LOCK_UN: i32 = 8

const SEEK_SET: i32 = 0

const SEEK_CUR: i32 = 1

const SEEK_END: i32 = 2

/// The `fcntl` command giving the path of what a descriptor names, in `MAXPATHLEN` bytes.
const F_GETPATH: i32 = 50

const MAXPATHLEN: usize = 1_024

const STDIN: i32 = 0

const STDOUT: i32 = 1

const STDERR: i32 = 2

/// The bytes a read asks for at least, before the file's size is known.
const READ_CHUNK: usize = 8_192

/// The common attributes `getattrlist` and `getattrlistbulk` are asked for: which were returned,
/// a directory entry's name, the file's type, its owner and its permissions.
const ATTR_CMN_RETURNED_ATTRS: u32 = 0x8000_0000

const ATTR_CMN_NAME: u32 = 0x1

const ATTR_CMN_OBJTYPE: u32 = 0x8

const ATTR_CMN_OWNERID: u32 = 0x8000

const ATTR_CMN_ACCESSMASK: u32 = 0x2_0000

/// The options of `getattrlist` not following a final symbolic link, and of `getattrlistbulk`
/// giving every attribute asked for its place.
const FSOPT_NOFOLLOW: u32 = 0x1

const FSOPT_PACK_INVAL_ATTRS: u64 = 0x8

/// The types of files `ATTR_CMN_OBJTYPE` gives.
const VREG: u32 = 1

const VDIR: u32 = 2

const VLNK: u32 = 5

/// The bytes `getattrlistbulk` fills at once.
const BULK_BUFFER: usize = 65_536

/// The offsets in an entry `getattrlistbulk` gives of the reference to its name and of its type,
/// after its length and the attributes returned.
const BULK_NAME: usize = 24

const BULK_KIND: usize = 32

/// `struct attrlist`: the five groups of attributes asked for.
layout AttrList: bytes 24 le {
    count: u16 at 0
    reserved: u16 at 2
    common: u32 at 4
    volume: u32 at 8
    directory: u32 at 12
    file: u32 at 16
    fork: u32 at 20
} AttrList

/// What `getattrlist` writes for the type, owner and permissions of a file: their length, then
/// each.
layout Attributes: bytes 16 le {
    length: u32 at 0
    kind: u32 at 4
    owner: u32 at 8
    access: u32 at 12
} Attributes

foreign fn open(path: hw::Ptr[u8], flags: i32, mode: u64, unused3: u64, unused4: u64, unused5: u64, unused6: u64, unused7: u64, stacked_mode: u64) -> i32 convention "darwin"

foreign fn openat(dir: i32, path: hw::Ptr[u8], flags: i32, mode: u64, unused4: u64, unused5: u64, unused6: u64, unused7: u64, stacked_mode: u64) -> i32 convention "darwin"

foreign fn close(fd: i32) -> i32 convention "darwin"

foreign fn read(fd: i32, buf: hw::Ptr[u8], count: usize) -> isize convention "darwin"

foreign fn pread(fd: i32, buf: hw::Ptr[u8], count: usize, offset: i64) -> isize convention "darwin"

foreign fn write(fd: i32, buf: hw::Ptr[u8], count: usize) -> isize convention "darwin"

foreign fn lseek(fd: i32, offset: i64, whence: i32) -> i64 convention "darwin"

foreign fn fsync(fd: i32) -> i32 convention "darwin"

foreign fn ftruncate(fd: i32, length: i64) -> i32 convention "darwin"

foreign fn flock(fd: i32, operation: i32) -> i32 convention "darwin"

foreign fn fcntl(fd: i32, command: i32, argument: u64, unused3: u64, unused4: u64, unused5: u64, unused6: u64, unused7: u64, stacked_argument: u64) -> i32 convention "darwin"

foreign fn getattrlist(path: hw::Ptr[u8], attributes: hw::Ptr[AttrList], buffer: hw::Ptr[Attributes], size: usize, options: u32) -> i32 convention "darwin"

foreign fn getattrlistbulk(dir: i32, attributes: hw::Ptr[AttrList], buffer: hw::Ptr[u8], size: usize, options: u64) -> i32 convention "darwin"

foreign fn rename(from: hw::Ptr[u8], to: hw::Ptr[u8]) -> i32 convention "darwin"

foreign fn unlink(path: hw::Ptr[u8]) -> i32 convention "darwin"

foreign fn unlinkat(dir: i32, path: hw::Ptr[u8], flags: i32) -> i32 convention "darwin"

foreign fn mkdir(path: hw::Ptr[u8], mode: u16) -> i32 convention "darwin"

foreign fn getcwd(buf: hw::Ptr[u8], size: usize) -> hw::Ptr[u8] convention "darwin"

/// What the system records of a file: its kind, and who else may reach it.
pub open struct Metadata derives Copy {
    pub kind: platform::FileKind
    uid: u32
    mode: u32
} Metadata

/// Whether a user other than `user` owns the file or may write it, as its owner and mode say on
/// Linux and macOS; never on Windows, whose access control lists the toolchain does not read.
pub fn Metadata.writable_by_others(self, user: u32) -> bool {
    return self.uid != user or (self.mode & 0b000_010_010) != 0
} Metadata.writable_by_others

/// Whether a user other than `user` owns the file or may access it, as its owner and mode say on
/// Linux and macOS; never on Windows, whose access control lists the toolchain does not read.
pub fn Metadata.accessible_by_others(self, user: u32) -> bool {
    return self.uid != user or (self.mode & 0b000_111_111) != 0
} Metadata.accessible_by_others

pub fn Metadata.is_file(self) -> bool = self.kind == platform::FileKind.Regular

pub fn Metadata.is_dir(self) -> bool = self.kind == platform::FileKind.Directory

pub fn Metadata.is_symlink(self) -> bool = self.kind == platform::FileKind.Symlink

/// A file this process holds open, until `close`.
pub open linear struct File {
    fd: i32
} File

/// Opens a file for reading.
pub fn File.open(path: Str) -> File fails platform::IoError {
    return try open_file(path, flags: O_RDONLY, mode: 0)
} File.open

/// Opens a file for writing, creating it when it is missing, with `mode` where the system gives
/// files one, and emptying it otherwise.
pub fn File.create(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, flags: O_WRONLY | O_CREAT | O_TRUNC, mode)
} File.create

/// Creates a file, with `mode` where the system gives files one, and opens it for writing;
/// `AlreadyExists` when the path names one.
pub fn File.create_new(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, flags: O_WRONLY | O_CREAT | O_EXCL, mode)
} File.create_new

/// Opens a file for writing without changing it, creating it when it is missing, with `mode` where
/// the system gives files one.
pub fn File.open_or_create(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, flags: O_WRONLY | O_CREAT, mode)
} File.open_or_create

/// Opens a file with `open`, whose `mode` argument, variadic, is passed both in its place and as
/// the argument Apple's AArch64 convention passes on the stack.
fn open_file(path: Str, flags: i32, mode: u32) -> File fails platform::IoError {
    let name = try c_text(path.as_bytes())
    let wide = u64.widen(mode)
    loop {
        let fd = trusted "name holds a NUL-terminated path" { open(hw::Ptr.of_view(name.bytes.view()), flags: flags | O_CLOEXEC, mode: wide, unused3: 0, unused4: 0, unused5: 0, unused6: 0, unused7: 0, stacked_mode: wide) }
        if fd >= 0 {
            return File(fd: fd)
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} open_file

pub fn File.close(take self) {
    let File(fd: fd) = self
    discard close(fd)
} File.close

/// Writes all of `data` at the file's position.
pub fn File.write_all(self, data: Slice[u8]) fails platform::IoError {
    try write_fd(self.fd, data)
} File.write_all

/// Returns once the file's contents and metadata are on disk.
pub fn File.sync_all(self) fails platform::IoError {
    loop {
        if fsync(self.fd) == 0 {
            return
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} File.sync_all

/// Returns once the entries of the directory `path` are on disk, as renames into it leave them: on
/// Linux and macOS by syncing the directory, and on Windows, whose file systems journal their
/// entries in order, once it finds that `path` names a directory.
pub fn sync_dir(path: Str) fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    try file.sync_all()
} sync_dir

/// Waits for the exclusive lock of the file.
pub fn File.lock(self) fails platform::IoError {
    try checked(flock(self.fd, operation: LOCK_EX))
} File.lock

/// Waits for a shared lock of the file.
pub fn File.lock_shared(self) fails platform::IoError {
    try checked(flock(self.fd, operation: LOCK_SH))
} File.lock_shared

/// Releases the lock the file holds.
pub fn File.unlock(self) fails platform::IoError {
    try checked(flock(self.fd, operation: LOCK_UN))
} File.unlock

/// The rest of the file from its position.
pub fn File.read_to_end(self, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    return try read_rest(self.fd, alloc)
} File.read_to_end

/// What standard input holds up to its end.
pub fn read_stdin(alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    return try read_rest(STDIN, alloc)
} read_stdin

/// What one read of standard input gives, at most `room` bytes; none at its end.
pub fn read_stdin_some(room: usize, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    var data = mem::Bytes.zeroed(room, alloc)
    loop {
        let start = hw::Ptr.of_view_mut(mut data.view_mut())
        let count = trusted "start addresses the len bytes of data" { read(STDIN, buf: start, count: data.len()) }
        if count >= 0 {
            mut data.truncate(usize.fit(count))
            return data
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} read_stdin_some

/// The rest of an open descriptor's file from its position.
fn read_rest(fd: i32, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    var room = READ_CHUNK
    let left = remaining(fd)
    if left > 0 {
        room = usize.widen(left).saturating_add(1)
    }
    var data = mem::Bytes.zeroed(room, alloc)
    var filled: usize = 0
    loop {
        if filled == data.len() {
            let extra = mem::Bytes.zeroed(data.len(), alloc)
            mut data.append(extra.view())
        }
        let start = hw::Ptr.of_view_mut(mut data.view_mut())
        let count = trusted "start addresses the len bytes of data, of which filled are behind" { read(fd, buf: start.offset(isize.fit(filled)), count: data.len() - filled) }
        if count == 0 {
            mut data.truncate(filled)
            return data
        }
        if count > 0 {
            filled += usize.fit(count)
            continue
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} read_rest

/// The bytes of an open file after its position, zero when the system gives none, as for a pipe.
fn remaining(fd: i32) -> u64 {
    let at = lseek(fd, offset: 0, whence: SEEK_CUR)
    if at < 0 {
        return 0
    }
    let end = lseek(fd, offset: 0, whence: SEEK_END)
    discard lseek(fd, offset: at, whence: SEEK_SET)
    if end <= at {
        return 0
    }
    return u64.fit(end - at)
} remaining

/// Writes all of `data` to an open descriptor.
fn write_fd(fd: i32, data: Slice[u8]) fails platform::IoError {
    var written: usize = 0
    while written < data.len() {
        let start = hw::Ptr.of_view(data)
        let count = trusted "start addresses the len bytes of data, of which written are behind" { write(fd, buf: start.offset(isize.fit(written)), count: data.len() - written) }
        if count > 0 {
            written += usize.fit(count)
            continue
        }
        if count == 0 {
            fail platform::IoError.Other(0)
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} write_fd

/// Fails with the last error when a call of the C library reported failure with -1.
fn checked(status: i32) fails platform::IoError {
    if status == -1 {
        fail last_error()
    }
} checked

/// Writes all of `data` to standard output.
pub fn write_stdout(data: Slice[u8]) fails platform::IoError {
    try write_fd(STDOUT, data)
} write_stdout

/// Writes all of `data` to standard error.
pub fn write_stderr(data: Slice[u8]) fails platform::IoError {
    try write_fd(STDERR, data)
} write_stderr

/// The contents of a file.
pub fn read_all(path: Str, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    return try file.read_to_end(alloc)
} read_all

/// The `length` bytes of a file at an offset, fewer when the file ends before them.
pub fn read_at(path: Str, at: usize, length: usize, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    var data = mem::Bytes.zeroed(length, alloc)
    var filled: usize = 0
    while filled < length {
        let start = hw::Ptr.of_view_mut(mut data.view_mut())
        let count = trusted "start addresses the length bytes of data, of which filled are behind" { pread(file.fd, buf: start.offset(isize.fit(filled)), count: length - filled, offset: i64.fit(at + filled)) }
        if count == 0 {
            break
        }
        if count > 0 {
            filled += usize.fit(count)
            continue
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
    mut data.truncate(filled)
    return data
} read_at

/// The contents of a file, which hold text; `InvalidData` when they are not well-formed UTF-8.
pub fn read_text(path: Str, alloc: mem::Alloc) -> text::String fails platform::IoError {
    let data = try read_all(path, alloc)
    let Ok(decoded) = attempt text::String.try_from_utf8(data.view(), alloc) else {
        fail platform::IoError.InvalidData
    }
    return decoded
} read_text

/// Writes a file whole, creating it when it is missing, with mode rw-rw-rw- where the system gives
/// files one.
pub fn write_all(path: Str, contents: Slice[u8]) fails platform::IoError {
    let file = try File.create(path, mode: 0b110_110_110)
    defer take file.close()
    try file.write_all(contents)
} write_all

/// Writes a file of `bytes` zero bytes, replacing any file `path` names; on Linux and macOS the
/// system allocates them only as they are written.
pub fn write_sized(path: Str, bytes: u64) fails platform::IoError {
    let file = try File.create(path, mode: 0b110_110_110)
    defer take file.close()
    let Some(length) = i64.checked_fit(bytes) else {
        fail platform::IoError.Other(EINVAL)
    }
    try checked(ftruncate(file.fd, length))
} write_sized

/// Whether this process may open a file for reading and writing.
pub fn may_read_write(path: Str) -> bool {
    let Ok(file) = attempt open_file(path, flags: O_RDWR, mode: 0) else {
        return false
    }
    take file.close()
    return true
} may_read_write

/// Renames a file or directory, replacing the file `to` names.
pub fn rename_path(from: Str, to: Str) fails platform::IoError {
    let old = try c_text(from.as_bytes())
    let new = try c_text(to.as_bytes())
    try checked(trusted "old and new hold NUL-terminated paths" { rename(hw::Ptr.of_view(old.bytes.view()), to: hw::Ptr.of_view(new.bytes.view())) })
} rename_path

/// Removes a file, a read-only one too.
pub fn remove_file(path: Str) fails platform::IoError {
    let name = try c_text(path.as_bytes())
    try checked(trusted "name holds a NUL-terminated path" { unlink(hw::Ptr.of_view(name.bytes.view())) })
} remove_file

/// Creates a directory, with `mode` where the system gives directories one, its parent existing.
pub fn create_dir(path: Str, mode: u32) fails platform::IoError {
    let name = try c_text(path.as_bytes())
    try checked(trusted "name holds a NUL-terminated path" { mkdir(hw::Ptr.of_view(name.bytes.view()), mode: u16.truncate(mode)) })
} create_dir

/// Creates a directory and every missing parent, with mode rwxrwxrwx where the system gives
/// directories one; succeeds when the path names a directory.
pub fn create_dir_all(path: Str, alloc: mem::Alloc) fails platform::IoError {
    if path.is_empty() {
        return
    }
    let made = attempt create_dir(path, mode: 0b111_111_111)
    match first made {
        Ok(_) => return
        Err(platform::IoError.NotFound) => {}
        Err(failure) => {
            if is_dir(path) {
                return
            }
            fail failure
        }
    }
    let Some(above) = platform::parent(path, alloc) else {
        fail platform::IoError.Other(0)
    }
    try create_dir_all(above.as_str(), alloc)
    let Err(failure) = attempt create_dir(path, mode: 0b111_111_111) else {
        return
    }
    if is_dir(path) {
        return
    }
    fail failure
} create_dir_all

/// The metadata of what a path names, a symbolic link or junction followed.
pub fn metadata(path: Str) -> Metadata fails platform::IoError {
    return try metadata_with(path, options: 0)
} metadata

/// The metadata of what a path names, a symbolic link or junction itself.
pub fn symlink_metadata(path: Str) -> Metadata fails platform::IoError {
    return try metadata_with(path, options: FSOPT_NOFOLLOW)
} symlink_metadata

/// The metadata `getattrlist` gives with `options` of what a path names.
fn metadata_with(path: Str, options: u32) -> Metadata fails platform::IoError {
    let name = try c_text(path.as_bytes())
    var asked = AttrList(count: 5, reserved: 0, common: ATTR_CMN_OBJTYPE | ATTR_CMN_OWNERID | ATTR_CMN_ACCESSMASK, volume: 0, directory: 0, file: 0, fork: 0)
    var raw = Attributes.from_bits(Array[u8, 16].filled(0))
    let buffer = hw::Ptr.of_mut(mut raw)
    try checked(trusted "name holds a NUL-terminated path, asked a struct attrlist and buffer the 16 bytes its attributes take" { getattrlist(hw::Ptr.of_view(name.bytes.view()), attributes: hw::Ptr.of_mut(mut asked), buffer, size: 16, options) })
    let held = trusted "getattrlist wrote the attributes at buffer" { buffer.read() }
    return Metadata(kind: kind_of(held.kind), uid: held.owner, mode: held.access)
} metadata_with

/// The kind of file of a type `ATTR_CMN_OBJTYPE` gives.
fn kind_of(kind: u32) -> platform::FileKind {
    return match kind {
        VREG => platform::FileKind.Regular
        VDIR => platform::FileKind.Directory
        VLNK => platform::FileKind.Symlink
        else => platform::FileKind.Other
    }
} kind_of

/// Whether a path names something, a symbolic link followed.
pub fn exists(path: Str) -> bool {
    let Ok(_) = attempt metadata(path) else {
        return false
    }
    return true
} exists

/// Whether a path names a directory, a symbolic link followed.
pub fn is_dir(path: Str) -> bool {
    let Ok(held) = attempt metadata(path) else {
        return false
    }
    return held.is_dir()
} is_dir

/// The entries of a directory but `.` and `..`, in the order the system gives them.
pub fn list_dir(path: Str, alloc: mem::Alloc) -> mem::List[platform::DirEntry] fails platform::IoError {
    let name = try c_text(path.as_bytes())
    let fd = try opened_dir(AT_FDCWD, name, nofollow: false)
    defer close_end(fd)
    return try dir_entries(fd, alloc)
} list_dir

/// Opens the directory `name` of the directory open as `dir`, a symbolic link not followed when
/// `nofollow`.
fn opened_dir(dir: i32, name: CText, nofollow: bool) -> i32 fails platform::IoError {
    var flags = O_RDONLY | O_DIRECTORY | O_CLOEXEC
    if nofollow {
        flags = flags | O_NOFOLLOW
    }
    loop {
        let fd = trusted "name holds a NUL-terminated path" { openat(dir, path: hw::Ptr.of_view(name.bytes.view()), flags, mode: 0, unused4: 0, unused5: 0, unused6: 0, unused7: 0, stacked_mode: 0) }
        if fd >= 0 {
            return fd
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} opened_dir

/// The entries of the directory open as `fd`, which `getattrlistbulk` gives without `.` and `..`.
fn dir_entries(fd: i32, alloc: mem::Alloc) -> mem::List[platform::DirEntry] fails platform::IoError {
    var asked = AttrList(count: 5, reserved: 0, common: ATTR_CMN_RETURNED_ATTRS | ATTR_CMN_NAME | ATTR_CMN_OBJTYPE, volume: 0, directory: 0, file: 0, fork: 0)
    var buffer = mem::Bytes.zeroed(BULK_BUFFER, alloc)
    var found = mem::List[platform::DirEntry].empty(alloc)
    loop {
        let start = hw::Ptr.of_view_mut(mut buffer.view_mut())
        let count = trusted "asked is a struct attrlist and start addresses the BULK_BUFFER bytes of buffer" { getattrlistbulk(fd, attributes: hw::Ptr.of_mut(mut asked), buffer: start, size: BULK_BUFFER, options: FSOPT_PACK_INVAL_ATTRS) }
        if count == 0 {
            return found
        }
        if count < 0 {
            let code = last_code()
            if code != EINTR {
                fail error_of(code)
            }
            continue
        }
        try bulk_entries(buffer.view(), count: usize.fit(count), into: mut found, alloc)
    }
} dir_entries

/// Appends the `count` entries `getattrlistbulk` wrote to `buffer`: each its length, the
/// attributes returned, the reference to its NUL-terminated name and its type.
fn bulk_entries(buffer: Slice[u8], count: usize, mut into: mem::List[platform::DirEntry], alloc: mem::Alloc) fails platform::IoError {
    var at: usize = 0
    for _ in 0..<count {
        if at + BULK_KIND + 4 > buffer.len() {
            fail platform::IoError.InvalidData
        }
        let length = usize.widen(buffer.u32_le(at))
        let named_at = at + BULK_NAME
        let name_start = named_at + usize.widen(buffer.u32_le(named_at))
        let name_length = usize.widen(buffer.u32_le(named_at + 4))
        if name_length == 0 or name_start + name_length > buffer.len() {
            fail platform::IoError.InvalidData
        }
        var name = mem::Bytes.empty(alloc)
        for index in name_start..<(name_start + name_length - 1) {
            mut name.push(buffer[index])
        }
        mut into.push(platform::DirEntry(name: take name, kind: kind_of(buffer.u32_le(at + BULK_KIND))))
        if length == 0 {
            fail platform::IoError.InvalidData
        }
        at += length
    }
} bulk_entries

/// Closes a descriptor, unless it is -1.
fn close_end(fd: i32) {
    if fd >= 0 {
        discard close(fd)
    }
} close_end

/// Removes a directory with everything in it, or a symbolic link or junction itself; a link inside
/// is removed, never followed.
pub fn remove_dir_all(path: Str, alloc: mem::Alloc) fails platform::IoError {
    let held = try symlink_metadata(path)
    if held.is_symlink() {
        try remove_file(path)
        return
    }
    let name = try c_text(path.as_bytes())
    try remove_tree(AT_FDCWD, name, alloc)
} remove_dir_all

/// Removes the directory `name` of the directory open as `dir`, after what it holds; `name`
/// itself when it is not a directory and lies in a removed directory.
fn remove_tree(dir: i32, name: CText, alloc: mem::Alloc) fails platform::IoError {
    let fd = match first attempt opened_dir(dir, name, nofollow: true) {
        Ok(opened) => opened
        Err(failure) => {
            let unlinkable = failure == platform::IoError.Other(ENOTDIR) or failure == platform::IoError.Other(ELOOP)
            if unlinkable and dir != AT_FDCWD {
                try checked(trusted "name holds a NUL-terminated path" { unlinkat(dir, path: hw::Ptr.of_view(name.bytes.view()), flags: 0) })
                return
            }
            fail failure
        }
    }
    defer close_end(fd)
    for entry in try dir_entries(fd, alloc) {
        let child = try c_text(entry.name.view())
        let removed = attempt remove_child(fd, name: child, kind: entry.kind, alloc)
        let Err(failure) = removed else {
            continue
        }
        if failure != platform::IoError.NotFound {
            fail failure
        }
    }
    let gone = trusted "name holds a NUL-terminated path" { unlinkat(dir, path: hw::Ptr.of_view(name.bytes.view()), flags: AT_REMOVEDIR) }
    if gone == -1 {
        let failure = last_error()
        if failure != platform::IoError.NotFound {
            fail failure
        }
    }
} remove_tree

fn remove_child(dir: i32, name: CText, kind: platform::FileKind, alloc: mem::Alloc) fails platform::IoError {
    if kind == platform::FileKind.Directory {
        try remove_tree(dir, name, alloc)
        return
    }
    try checked(trusted "name holds a NUL-terminated path" { unlinkat(dir, path: hw::Ptr.of_view(name.bytes.view()), flags: 0) })
} remove_child

/// The current directory of this process, with `/` separators: the bytes Linux and macOS give, or
/// the UTF-8 of the path Windows gives.
pub fn current_dir(alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    var size: usize = 512
    loop {
        var buffer = mem::Bytes.zeroed(size, alloc)
        let start = hw::Ptr.of_view_mut(mut buffer.view_mut())
        let found = trusted "start addresses the size bytes of buffer" { getcwd(start, size) }
        if found.addr() != 0 {
            return copied_text(start, alloc)
        }
        let code = last_code()
        if code != ERANGE {
            fail error_of(code)
        }
        size = size * 2
    }
} current_dir

/// The absolute path naming what a path names, once every link and every `.` and `..` component is
/// resolved, with `/` separators; `InvalidData` when the system's path is not well-formed Unicode.
pub fn canonicalize(path: Str, alloc: mem::Alloc) -> text::String fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    var buffer = mem::Bytes.zeroed(MAXPATHLEN, alloc)
    let start = hw::Ptr.of_view_mut(mut buffer.view_mut())
    let address = u64.widen(start.addr())
    try checked(trusted "start addresses the MAXPATHLEN bytes F_GETPATH writes, passed in place of the variadic argument and as the one Apple's AArch64 convention passes on the stack" { fcntl(file.fd, command: F_GETPATH, argument: address, unused3: 0, unused4: 0, unused5: 0, unused6: 0, unused7: 0, stacked_argument: address) })
    let resolved = copied_text(start, alloc)
    let Ok(written) = attempt text::String.try_from_utf8(resolved.view(), alloc) else {
        fail platform::IoError.InvalidData
    }
    return written
} canonicalize
