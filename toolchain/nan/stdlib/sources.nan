    \\pub open struct Set[T: Ord] {
    \\} Set
    \\
    \\pub fn Set.empty(alloc: Alloc) -> Set[T]
    \\    ensures result.len() == 0
    \\    example Set[u8].empty(testing::world().alloc).len() == 0
    \\
    \\pub fn Set.len(self) -> usize limits pure, notrap, terminates
    \\
    \\pub fn Set.contains(self, value: T) -> bool limits pure, notrap, terminates
    \\    example not Set[u8].empty(testing::world().alloc).contains(1)
    \\{
    \\    return self.contains_by(fn(stored: T) => stored.cmp(value))
    \\} Set.contains
    \\
    \\pub fn Set.insert(mut self, take value: T) -> bool
    \\    ensures result != old(self.contains(value))
    \\    ensures match result {
    \\        true => self.len() > 0 and self.len() - 1 == old(self.len())
    \\        false => self.len() == old(self.len())
    \\    }
    \\    example Set[u8].empty(testing::world().alloc).insert(1)
    \\
    \\pub fn Set.try_insert(mut self, take value: T) -> bool fails OutOfMemory
    \\    ensures result != old(self.contains(value))
    \\    ensures match result {
    \\        true => self.len() > 0 and self.len() - 1 == old(self.len())
    \\        false => self.len() == old(self.len())
    \\    }
    \\    example attempt Set[u8].empty(testing::world().alloc).try_insert(1) == Ok(true)
    \\
    \\pub fn Set.remove(mut self, value: T) -> bool
    \\    ensures result == old(self.contains(value))
    \\    ensures not self.contains(value)
    \\    ensures match result {
    \\        true => old(self.len()) > 0 and self.len() == old(self.len()) - 1
    \\        false => self.len() == old(self.len())
    \\    }
    \\    example not Set[u8].empty(testing::world().alloc).remove(1)
    \\
    \\pub proj fn Set.cursor(self) -> SetCursor[T]
    \\
    \\pub fn Set.into_cursor(take self) -> SetIntoCursor[T]
    \\
    \\pub fn Set.retain(mut self, keep: fn(value: T) -> bool)
