//! Greeters 7, doubling, and 8, dividing a hundred.

contribute greeting::greeters doubling = greeting::Greeter(id: 7, answer: double)

contribute greeting::greeters dividing = greeting::Greeter(id: 8, answer: divide)

fn double(value: u32) -> u32 {
    return value * 2
} double

fn divide(value: u32) -> u32 {
    return 100 / value
} divide
