//! A quota of pages, and quotas kept per CPU and charged with interrupts disabled.

/// The pages in use out of a limit.
pub closed struct Quota {
    pub used: u32
    pub limit: u32
} Quota

/// Charges `pages` when they fit within the limit, telling whether they did.
pub fn Quota.charge(mut self, pages: u32) -> bool limits notrap, terminates, noalloc {
    let Some(total) = self.used.checked_add(pages) else {
        return false
    }
    if total > self.limit {
        return false
    }
    self.used = total
    return true
} Quota.charge

/// The share of the limit in use, in percent rounded down; 100 for a limit of 0.
pub fn Quota.percent_used(self) -> u32 limits notrap, terminates, noalloc {
    if self.limit == 0 {
        return 100
    }
    return u32.truncate(u64.widen(self.used) * 100 / u64.widen(self.limit))
} Quota.percent_used

/// Charges `pages` to the quota of the CPU running the caller.
pub fn charge_here(quotas: hw::PerCpu[Quota], pages: u32) -> bool {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> bool limits notrap {
        return quotas.with(t, body: fn(mut quota: Quota) -> bool limits notrap, terminates, noalloc {
            return mut quota.charge(pages)
        })
    })
} charge_here
