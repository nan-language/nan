//! Forms of the canonical NIR encoding.

/// An unsigned integer in LEB128, without redundant trailing groups.
pkg fn uvar(mut out: mem::Bytes, value: u64) {
    var rest = value
    loop {
        let group = u8.truncate(rest & 0x7F)
        rest = rest >> 7
        if rest == 0 {
            mut out.push(group)
            return
        }
        mut out.push(group | 0x80)
    }
} uvar

/// Bytes: their length as a uvar, then the bytes.
pkg fn bytes(mut out: mem::Bytes, value: Slice[u8]) {
    uvar(mut out, value: u64.widen(value.len()))
    mut out.append(value)
} bytes

/// A signed integer: the uvar 2n when n is at least 0, and −2n − 1 otherwise.
pkg fn svar(mut out: mem::Bytes, value: i64) {
    if value >= 0 {
        uvar(mut out, value: u64.fit(value) << 1)
        return
    }
    uvar(mut out, value: (u64.fit(-(value + 1)) << 1) | 1)
} svar

/// A record being written: its fields, each a key and its content, keys strictly increasing; an
/// absent field is never added.
pkg struct Record {
    fields: mem::List[Field]
} Record

/// A field of a record: its key and its content.
struct Field {
    key: u64
    content: mem::Bytes
} Field

pkg fn Record.empty(alloc: mem::Alloc) -> Record = Record(fields: mem::List[Field].empty(alloc))

pkg fn Record.field(mut self, key: u64, take content: mem::Bytes) {
    mut self.fields.push(Field(key: key, content: take content))
} Record.field

/// The record: its field count, then each field's key as a uvar and its content as bytes.
pkg fn Record.finish(take self, alloc: mem::Alloc) -> mem::Bytes {
    var out = mem::Bytes.empty(alloc)
    uvar(mut out, value: u64.widen(self.fields.len()))
    for field in self.fields {
        uvar(mut out, value: field.key)
        bytes(mut out, value: field.content.view())
    }
    return out
} Record.finish
