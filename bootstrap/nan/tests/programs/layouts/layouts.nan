//! Layout values built, read, compared, hashed and converted from bits in a built program.

layout Flags: u16 le {
    ready: bit 0
    count: bit 1..=4
    reserved: rest
} Flags

layout Outer: u32 le {
    low: Flags at 0
    tag: bit 20..=23
    spare: rest
} Outer

layout Head: bytes 4 be {
    kind: u16 at 0
    size: u16 at 2
} Head

layout Mode: u8 tags {
    Off = 0
    On = 1
} Mode

layout Pair: u16 le {
    low: Mode at 0
    high: Mode at 8
} Pair

struct Sum {
    total: u64
} Sum

impl Sum: core::Hasher

fn Sum.write(mut self, bytes: Slice[u8]) limits pure, notrap, terminates {
    for byte in bytes {
        self.total = self.total.wrapping_mul(31).wrapping_add(u64.widen(byte))
    }
} Sum.write

fn hashed[T: Hash](value: T) -> u64 {
    var sum = Sum(total: 0)
    value.hash(mut sum)
    return sum.total
} hashed

fn flags(ready: bool, count: u8, spare: u16) -> Flags {
    return Flags(ready: ready, count: count, reserved: spare)
} flags

fn main(take world: host::World) fails task::Cancelled uses wait {
    let built = flags(true, count: 3, spare: 0x100)
    world.log.info("built bits", value: built.to_bits())
    world.log.info("built rest", value: built.reserved)
    var read = Flags.from_bits(0xFFFF)
    world.log.info("read rest", value: read.reserved)
    read.reserved = 0x20
    world.log.info("assigned bits", value: read.to_bits())
    var outer = Outer(low: built, tag: 5, spare: 0)
    outer.low.count = 1
    world.log.info("nested bits", value: outer.to_bits())
    let front = Head(kind: 1, size: 2)
    let copy = Head(kind: 1, size: 2)
    world.log.info("bytes equal", value: front == copy and front != Head(kind: 2, size: 2))
    world.log.info("bytes bits", value: front.to_bits()[1])
    world.log.info("hashes as bits", value: hashed(built) == hashed(built.to_bits()))
    world.log.info("tags equal", value: Mode.On == Mode.On and Mode.On != Mode.Off)
    world.log.info("valid pair", value: Pair.checked_from_bits(0x0101).is_some())
    world.log.info("invalid high", value: Pair.checked_from_bits(0x0201).is_some())
    world.log.info("invalid low", value: Pair.checked_from_bits(0x0102).is_some())
} main
