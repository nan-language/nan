//! Binary trees of boxes up to the size's depth, built, counted and dropped.

enum BenchError derives Render {
    Usage
    Stdio(sys::StdioError) from
    Cancelled(task::Cancelled) from
} BenchError

/// The number the first argument states in decimal, if it states one.
validator fn size(args: Untrusted[mem::List[mem::Bytes]]) -> Option[u64] {
    let Some(arg) = args.inspect().get(0) else {
        return None
    }
    var value: u64 = 0
    for digit in arg.view() {
        if digit < b'0' or digit > b'9' {
            return None
        }
        value = value * 10 + u64.widen(digit - b'0')
    }
    return Some(value)
} size

/// A node of a binary tree, with both children or neither.
struct Node {
    left: Option[mem::Box[Node]]
    right: Option[mem::Box[Node]]
} Node

/// A complete binary tree `depth` levels deep below its root.
fn tree(depth: u64, heap: mem::Heap) -> Node {
    if depth == 0 {
        return Node(left: None, right: None)
    }
    return Node(left: Some(heap.boxed(tree(depth - 1, heap))), right: Some(heap.boxed(tree(depth - 1, heap))))
} tree

/// The nodes of the tree under this one, itself included.
fn Node.count(self) -> u64 {
    let Some(left) = self.left else {
        return 1
    }
    let Some(right) = self.right else {
        return 1
    }
    return 1 + left.contents().count() + right.contents().count()
} Node.count

fn main(take world: host::World) fails BenchError uses wait {
    let Some(n) = size(world.args) else {
        fail BenchError.Usage
    }
    let heap = mem::Heap.of(world.alloc)
    let deepest = if n < 6 {
        6u64
    } else {
        n
    }
    var out = text::String.empty(world.alloc)
    mut out.write(text::fmt("{count}\n", count: tree(deepest + 1, heap).count()), budget: 64)
    let long_lived = tree(deepest, heap)
    var depth: u64 = 4
    while depth <= deepest {
        let trees = 1u64 << u32.fit(deepest - depth + 4)
        var total: u64 = 0
        for _ in 0..<trees {
            total += tree(depth, heap).count()
        }
        mut out.write(text::fmt("{trees} {depth} {total}\n", trees, depth, total), budget: 96)
        depth += 2
    }
    mut out.write(text::fmt("{count}\n", count: long_lived.count()), budget: 64)
    let written = take out.into_bytes()
    try await world.stdio.write_out(written.view())
} main
