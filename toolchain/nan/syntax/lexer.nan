//! Line-local lexing of a source file into tokens, virtual tokens and lexical diagnostics.

/// A physical line: its byte range without the LF, the offset of its plain comment, and whether it
/// holds a lexical diagnostic.
pkg struct Line derives Copy {
    pkg start: u32
    pkg end: u32
    pkg comment: Option[u32]
    pkg lexical_error: bool
} Line

pkg struct LexDiagnostic {
    pkg line: u32
    pkg code: diagnostic::Code
    /// The bytes of the offending character or token.
    pkg span: diagnostic::Span
    pkg fix: Option[mem::List[diagnostic::Replacement]]
} LexDiagnostic

pkg struct Lexed {
    pkg tokens: mem::List[Token]
    pkg lines: mem::List[Line]
    pkg diagnostics: mem::List[LexDiagnostic]
} Lexed

/// The bytes from `start` to before `end` of a source.
struct ByteRange derives Copy {
    start: usize
    end: usize
} ByteRange

/// The position in its file of a byte of the line, kept to 32 bits as tokens keep positions.
fn ByteRange.position(self, offset: usize) -> u32 {
    return u32.truncate(self.start).wrapping_add(u32.truncate(offset))
} ByteRange.position

pkg fn lex(source: Slice[u8], grammar: Grammar, alloc: mem::Alloc) -> Lexed
    waive length "one pass over the lines, as the specification orders their tokens"
{
    var ranges = mem::List[ByteRange].empty(alloc)
    var start: usize = 0
    loop {
        let index = output::first_of(source, start, one: b'\n', other: b'\n')
        if index >= source.len() {
            break
        }
        mut ranges.push(ByteRange(start: start, end: index))
        start = index + 1
    }
    let unterminated = start < source.len() or source.len() == 0
    if unterminated {
        mut ranges.push(ByteRange(start: start, end: source.len()))
    }
    var lexed = Lexed(tokens: mem::List[Token].empty(alloc), lines: mem::List[Line].empty(alloc), diagnostics: mem::List[LexDiagnostic].empty(alloc))
    var pending_nl: Option[Token] = None
    var chars = mem::List[CharAt].empty(alloc)
    expect ranges.len() <= usize.widen(~0u32)
    for index in 0..<ranges.len() {
        let range = ranges[index]
        let number = u32.fit(index) + 1
        let is_last = index + 1 == ranges.len()
        let Some(head) = source.prefix(range.end) else {
            expect false
            return lexed
        }
        let Some(parts) = head.split_at(range.start) else {
            expect false
            return lexed
        }
        let bytes = parts.tail
        let scan = lex_line(bytes, last_unterminated: unterminated and is_last, chars: mut chars, grammar, alloc)
        let comment = match scan.comment {
            Some(at) => Some(range.position(at))
            None => None
        }
        mut lexed.lines.push(Line(start: u32.truncate(range.start), end: u32.truncate(range.end), comment: comment, lexical_error: scan.error.is_some()))
        if scan.tokens.len() == 0 and scan.error.is_none() {
            continue
        }
        var last: Option[Token] = None
        for scanned in scan.tokens {
            if scanned.from == 0 {
                mut lexed.tokens.push(Token(kind: TokenKind.Col0, start: u32.truncate(range.start), end: u32.truncate(range.start), line: number))
            }
            let token = Token(kind: scanned.kind, start: range.position(scanned.from), end: range.position(scanned.to), line: number)
            mut lexed.tokens.push(token)
            last = Some(token)
        }
        let Some(Offence.At(at: offset, code: code)) = scan.error else {
            let Some(last_token) = last else {
                expect false
                return lexed
            }
            let nl = Token(kind: TokenKind.Nl, start: last_token.end, end: last_token.end, line: number)
            let run_continues = last_token.kind == TokenKind.TextLine and index + 1 < ranges.len() and starts_text_run(source, range: ranges[index + 1])
            if last_token.kind.is_continuing() or run_continues {
                pending_nl = Some(nl)
            } else {
                mut lexed.tokens.push(nl)
                pending_nl = None
            }
            continue
        }
        expect offset <= bytes.len()
        var width: usize = 1
        if code == diagnostic::Code.LexTrailingWhitespace {
            width = bytes.len() - offset
        } else {
            match text::utf8::char_at(bytes, at: offset) {
                Some(c) => {
                    width = c.utf8_len()
                }
                None => {}
            }
        }
        var fix: Option[mem::List[diagnostic::Replacement]] = None
        match line_fix(bytes, at: offset, code, grammar, alloc) {
            Some(replacements) => {
                fix = Some(shifted(take replacements, line: range, alloc))
            }
            None => {}
        }
        let position = range.position(offset)
        if width > bytes.len() - offset {
            width = bytes.len() - offset
        }
        let span = diagnostic::Span(start: position, end: position.wrapping_add(u32.truncate(width)))
        mut lexed.diagnostics.push(LexDiagnostic(line: number, code: code, span: span, fix: take fix))
        mut lexed.tokens.push(Token(kind: TokenKind.LexError, start: position, end: position, line: number))
        mut lexed.tokens.push(Token(kind: TokenKind.Nl, start: position, end: position, line: number))
        pending_nl = None
    }
    match pending_nl {
        Some(nl) => mut lexed.tokens.push(nl)
        None => {}
    }
    let last_line = u32.truncate(ranges.len())
    let eof = u32.truncate(source.len())
    mut lexed.tokens.push(Token(kind: TokenKind.Eof, start: eof, end: eof, line: last_line))
    return lexed
} lex

/// Whether a line starts with `\\` after its spaces.
fn starts_text_run(source: Slice[u8], range: ByteRange) -> bool {
    let Some(head) = source.prefix(range.end) else {
        expect false
        return false
    }
    let Some(parts) = head.split_at(range.start) else {
        expect false
        return false
    }
    let line = parts.tail
    for at in 0..<line.len() {
        if line[at] != b' ' {
            return starts_with_at(line, at, prefix: b"\\\\")
        }
    }
    return false
} starts_text_run

/// Replacements of byte ranges of a line, moved by the offset of the line in its file.
fn shifted(take replacements: mem::List[diagnostic::Replacement], line: ByteRange, alloc: mem::Alloc) -> mem::List[diagnostic::Replacement] {
    var moved = mem::List[diagnostic::Replacement].empty(alloc)
    for replacement in take replacements {
        let start = line.position(usize.widen(replacement.start))
        let end = line.position(usize.widen(replacement.end))
        mut moved.push(diagnostic::Replacement(start: start, end: end, text: take replacement.text))
    }
    return moved
} shifted

/// A character of a line at its byte offset.
struct CharAt derives Copy {
    at: usize
    ch: Ch
} CharAt

/// A character, or a maximal prefix of an ill-formed UTF-8 sequence.
enum Ch derives Copy, Eq {
    Char(char)
    Invalid
} Ch

enum Literal derives Copy, Eq {
    Text
    Bytes
    Char
    Byte
    TextLine
} Literal

fn Literal.holds_bytes(self) -> bool {
    return self == Literal.Bytes or self == Literal.Byte
} Literal.holds_bytes

fn Literal.kind(self) -> TokenKind {
    return match self {
        Literal.Text => TokenKind.Text
        Literal.Bytes => TokenKind.Bytes
        Literal.Char => TokenKind.Char
        Literal.Byte => TokenKind.Byte
        Literal.TextLine => TokenKind.TextLine
    }
} Literal.kind

/// A token a line scan found, by its kind and its byte range in the line.
struct Scanned derives Copy {
    kind: TokenKind
    from: usize
    to: usize
} Scanned

/// The offending character of a line: its offset in the line and the code it is reported with.
enum Offence derives Copy {
    At(at: usize, code: diagnostic::Code)
} Offence

struct LineScan {
    tokens: mem::List[Scanned]
    comment: Option[usize]
    error: Option[Offence]
} LineScan

/// Records an offence at `at` unless one at an earlier or the same offset is recorded.
fn report(mut error: Option[Offence], at: usize, code: diagnostic::Code) {
    match error {
        Some(Offence.At(at: first_at, code: _)) => {
            if at >= first_at {
                return
            }
        }
        None => {}
    }
    error = Some(Offence.At(at: at, code: code))
} report

/// Sets `chars` to the characters of a line at their offsets, each maximal prefix of an
/// ill-formed UTF-8 sequence standing as one invalid character, as `utf8_chunks` reads them.
fn line_chars(bytes: Slice[u8], mut chars: mem::List[CharAt]) {
    mut chars.truncate(0)
    var at: usize = 0
    while at < bytes.len() {
        if bytes[at] < 0x80 {
            match char.checked_from_bits(u32.widen(bytes[at])) {
                Some(c) => mut chars.push(CharAt(at: at, ch: Ch.Char(c)))
                None => mut chars.push(CharAt(at: at, ch: Ch.Invalid))
            }
            at += 1
            continue
        }
        match text::utf8::char_at(bytes, at) {
            Some(c) => {
                mut chars.push(CharAt(at: at, ch: Ch.Char(c)))
                expect c.utf8_len() <= bytes.len() - at
                at += c.utf8_len()
            }
            None => {
                mut chars.push(CharAt(at: at, ch: Ch.Invalid))
                let width = invalid_length(bytes, at)
                expect width <= bytes.len() - at
                at += width
            }
        }
    }
} line_chars

/// The length of the maximal prefix of an ill-formed UTF-8 sequence starting at `at`: the bytes a
/// well-formed sequence could start with.
fn invalid_length(bytes: Slice[u8], at: usize) -> usize
    ensures result <= 3
{
    expect at < bytes.len()
    let lead = bytes[at]
    let second = byte_or_zero(bytes, at: at + 1)
    let allowed = match first lead {
        0xE0 => second >= 0xA0 and second <= 0xBF
        0xED => second >= 0x80 and second <= 0x9F
        0xE1..=0xEF => second >= 0x80 and second <= 0xBF
        0xF0 => second >= 0x90 and second <= 0xBF
        0xF4 => second >= 0x80 and second <= 0x8F
        0xF1..=0xF3 => second >= 0x80 and second <= 0xBF
        else => false
    }
    if not allowed {
        return 1
    }
    if not is_continuation(byte_or_zero(bytes, at: at + 2)) {
        return 2
    }
    return 3
} invalid_length

fn byte_or_zero(bytes: Slice[u8], at: usize) -> u8
    ensures result == 0 or at < bytes.len()
{
    if at < bytes.len() {
        return bytes[at]
    }
    return 0
} byte_or_zero

fn is_continuation(byte: u8) -> bool {
    return (byte & 0xC0) == 0x80
} is_continuation

/// Whether a line holds printable ASCII alone, each byte its own character, none rejected.
fn is_plain(bytes: Slice[u8]) -> bool {
    for byte in bytes {
        if byte < 0x20 or byte > 0x7E {
            return false
        }
    }
    return true
} is_plain

/// Lexes one physical line, its characters into `chars` unless it is plain; offsets are relative
/// to the line. The line keeps only the tokens ending before its first offending character.
fn lex_line(bytes: Slice[u8], last_unterminated: bool, mut chars: mem::List[CharAt], grammar: Grammar, alloc: mem::Alloc) -> LineScan {
    let plain = is_plain(bytes)
    if plain {
        mut chars.truncate(0)
    } else {
        line_chars(bytes, mut chars)
    }
    var error: Option[Offence] = None
    var indentation: usize = 0
    while indentation < bytes.len() and bytes[indentation] == b' ' {
        indentation += 1
    }
    if indentation < bytes.len() and indentation % 4 != 0 {
        report(mut error, at: 0, code: diagnostic::Code.LexIndentation)
    }
    for char_at in chars {
        let code = match char_at.ch {
            Ch.Invalid => Some(diagnostic::Code.LexInvalidUtf8)
            Ch.Char(c) => match c {
                ' '..='~' => None
                else => rejected_code(c, grammar)
            }
        }
        let Some(rejected) = code else {
            continue
        }
        report(mut error, at: char_at.at, code: rejected)
        break
    }
    var trailing: usize = 0
    while trailing < bytes.len() and bytes[bytes.len() - 1 - trailing] == b' ' {
        trailing += 1
    }
    expect trailing <= bytes.len()
    if trailing > 0 {
        report(mut error, at: bytes.len() - trailing, code: diagnostic::Code.LexTrailingWhitespace)
    }
    if last_unterminated {
        report(mut error, at: bytes.len(), code: diagnostic::Code.LexMissingFinalNewline)
    }
    var count = chars.len()
    var start_index = chars.len()
    if plain {
        count = bytes.len()
        start_index = indentation
    }
    for index in 0..<chars.len() {
        if chars[index].at >= indentation {
            start_index = index
            break
        }
    }
    let Some(line) = bytes.prefix(bytes.len()) else {
        expect false
        return LineScan(tokens: mem::List[Scanned].empty(alloc), comment: None, error: error)
    }
    let lexicon = grammar.lexicon.contents()
    var scanner = Scanner(chars: chars.view(), plain: plain, count: count, bytes: take line, rejected: lexicon.rejected.view(), punctuation: lexicon.punctuation.view(), keywords: lexicon.keywords.view(), index: start_index, tokens: mem::List[Scanned].empty(alloc), comment: None)
    match attempt mut scanner.run() {
        Err(Offence.At(at: at, code: code)) => report(mut error, at, code)
        Ok(_) => {}
    }
    var tokens = scanner.tokens
    let Some(Offence.At(at: limit, code: _)) = error else {
        return LineScan(tokens: take tokens, comment: scanner.comment, error: error)
    }
    mut tokens.retain(fn(scanned: Scanned) => scanned.to <= limit)
    return LineScan(tokens: take tokens, comment: None, error: error)
} lex_line

/// The exact fix of a line's lexical error at byte `at`, as replacements of byte ranges of the
/// line.
fn line_fix(bytes: Slice[u8], at: usize, code: diagnostic::Code, grammar: Grammar, alloc: mem::Alloc) -> Option[mem::List[diagnostic::Replacement]]
    waive length "one arm per code with an exact fix"
{
    expect at <= bytes.len()
    if not text::utf8::is_valid(bytes) {
        return None
    }
    let held = literals(bytes, alloc)
    var fix = mem::List[diagnostic::Replacement].empty(alloc)
    match first code {
        diagnostic::Code.LexCarriageReturn => {
            for offset in 0..<bytes.len() {
                if bytes[offset] == b'\r' {
                    mut fix.push(replacing(offset, end: offset + 1, written: "", alloc))
                }
            }
        }
        diagnostic::Code.LexTab => {
            var indentation: usize = 0
            while indentation < bytes.len() and (bytes[indentation] == b' ' or bytes[indentation] == b'\t') {
                indentation += 1
            }
            for offset in 0..<bytes.len() {
                if bytes[offset] == b'\t' {
                    var written = " "
                    if offset < indentation {
                        written = "    "
                    } else if held[offset].literal.is_some() {
                        written = "\\t"
                    }
                    mut fix.push(replacing(offset, end: offset + 1, written, alloc))
                }
            }
        }
        diagnostic::Code.LexTrailingWhitespace => {
            var kept: usize = 0
            for offset in 0..<bytes.len() {
                if bytes[offset] != b' ' {
                    kept = offset + 1
                }
            }
            expect bytes.len() > 0
            if held[bytes.len() - 1].literal == Some(Literal.TextLine) {
                mut fix.push(replacing(bytes.len() - 1, end: bytes.len(), written: "\\x20", alloc))
            } else {
                mut fix.push(replacing(kept, end: bytes.len(), written: "", alloc))
            }
        }
        diagnostic::Code.LexMissingFinalNewline => mut fix.push(replacing(bytes.len(), end: bytes.len(), written: "\n", alloc))
        diagnostic::Code.LexRejectedCodePoint => {
            let Some(c) = text::utf8::char_at(bytes, at) else {
                return None
            }
            expect c.utf8_len() <= bytes.len() - at
            var written = text::String.empty(alloc)
            match held[at].literal {
                Some(Literal.Text) or Some(Literal.Char) or Some(Literal.TextLine) => {
                    mut written.append("\\u{")
                    push_hex(mut written, value: c.to_bits(), width: 1)
                    mut written.push('}')
                }
                Some(Literal.Bytes) or Some(Literal.Byte) => {
                    if not c.is_ascii() {
                        return None
                    }
                    mut written.append("\\x")
                    push_hex(mut written, value: c.to_bits(), width: 2)
                }
                None => {
                    if in_ranges(c, ranges: grammar.lexicon.contents().rejected_space.view()) {
                        mut written.push(' ')
                    }
                }
            }
            mut fix.push(diagnostic::Replacement(start: u32.truncate(at), end: u32.truncate(at + c.utf8_len()), text: take written))
        }
        diagnostic::Code.LexNotAtLineStart if starts_with_at(bytes, at, prefix: b"///") or starts_with_at(bytes, at, prefix: b"//!") => {
            expect bytes.len() - at >= 3
            mut fix.push(replacing(at, end: at + 3, written: "//", alloc))
        }
        diagnostic::Code.LexLiteralSuffix => {
            let Some(before) = suffix_start(bytes, at) else {
                return None
            }
            mut fix.push(replacing(before, end: before, written: ".0", alloc))
        }
        diagnostic::Code.LexEscapeOutOfRange => {
            if not starts_with_at(bytes, at, prefix: b"\\x") or bytes.len() - at < 4 or not is_char_boundary(bytes, at: at + 4) {
                return None
            }
            var written = text::String.empty(alloc)
            mut written.append("\\u{")
            var index = at + 2
            while index < at + 4 {
                let Some(c) = text::utf8::char_at(bytes, at: index) else {
                    return None
                }
                mut written.push(c.to_ascii_uppercase())
                expect c.utf8_len() <= bytes.len() - index
                index += c.utf8_len()
            }
            mut written.push('}')
            mut fix.push(diagnostic::Replacement(start: u32.truncate(at), end: u32.truncate(at + 4), text: take written))
        }
        diagnostic::Code.LexUnknownEscape if held[at].literal == Some(Literal.Bytes) or held[at].literal == Some(Literal.Byte) => {
            let Some(replaced) = byte_escape(bytes, at, alloc) else {
                return None
            }
            mut fix.push(take replaced)
        }
        else => return None
    }
    return Some(take fix)
} line_fix

fn replacing(start: usize, end: usize, written: Str, alloc: mem::Alloc) -> diagnostic::Replacement {
    return diagnostic::Replacement(start: u32.truncate(start), end: u32.truncate(end), text: text::String.of(written, alloc))
} replacing

/// The `\xHH` rewriting the `\u{H}` at `at` of a byte literal, when it names a value below `80`.
fn byte_escape(bytes: Slice[u8], at: usize, alloc: mem::Alloc) -> Option[diagnostic::Replacement] {
    if not starts_with_at(bytes, at, prefix: b"\\u{") {
        return None
    }
    expect at <= bytes.len() and bytes.len() - at >= 3
    var close = at + 3
    while close < bytes.len() and bytes[close] != b'}' {
        close += 1
    }
    if close == bytes.len() {
        return None
    }
    expect close >= at + 3 and close < bytes.len()
    let Some(parts) = bytes.split_at(at + 3) else {
        return None
    }
    let Some(written_digits) = parts.tail.prefix(close - at - 3) else {
        return None
    }
    let Some(value) = hex_value(written_digits) else {
        return None
    }
    if value >= 0x80 {
        return None
    }
    var written = text::String.empty(alloc)
    mut written.append("\\x")
    push_hex(mut written, value, width: 2)
    return Some(diagnostic::Replacement(start: u32.truncate(at), end: u32.truncate(close + 1), text: take written))
} byte_escape

/// The offset at which a `.0` turns the number run at `at` with a float suffix into a float.
fn suffix_start(bytes: Slice[u8], at: usize) -> Option[usize] {
    var end = at
    while end < bytes.len() {
        let byte = bytes[end]
        let fraction = byte == b'.' and end + 1 < bytes.len() and is_decimal_byte(bytes[end + 1])
        if not (is_word_byte(byte) or fraction) {
            break
        }
        end += 1
    }
    let Some(run) = bytes.prefix(end) else {
        return None
    }
    let Some(before) = dec_int(run, from: at) else {
        return None
    }
    if not (rest_is(run, from: before, word: "f32") or rest_is(run, from: before, word: "f64")) {
        return None
    }
    return Some(before)
} suffix_start

fn starts_with_at(bytes: Slice[u8], at: usize, prefix: Slice[u8]) -> bool {
    let Some(parts) = bytes.split_at(at) else {
        return false
    }
    let Some(head) = parts.tail.prefix(prefix.len()) else {
        return false
    }
    return head == prefix
} starts_with_at

fn is_char_boundary(bytes: Slice[u8], at: usize) -> bool {
    return at >= bytes.len() or not is_continuation(bytes[at])
} is_char_boundary

/// Writes `value` in uppercase hexadecimal digits, at least `width` of them.
fn push_hex(mut out: text::String, value: u32, width: usize) {
    var count: usize = 1
    while count < 8 and (value >> u32.truncate(4 * count)) != 0 {
        count += 1
    }
    if count < width {
        count = width
    }
    expect count <= 8
    for index in 0..<count {
        let digit = (value >> u32.truncate(4 * (count - 1 - index))) & 0xF
        var code = u32.widen(b'0') + digit
        if digit >= 10 {
            code = u32.widen(b'A') + digit - 10
        }
        let Some(c) = char.checked_from_bits(code) else {
            expect false
            return
        }
        mut out.push(c)
    }
} push_hex

/// The literal holding a byte of a line, if any.
struct Held derives Copy {
    literal: Option[Literal]
} Held

/// The literal holding each byte of a line, read as the scanner reads literals, past the
/// characters it rejects; none in code and comments.
fn literals(bytes: Slice[u8], alloc: mem::Alloc) -> mem::List[Held]
    ensures result.len() > bytes.len()
{
    var held = mem::List[Held].empty(alloc)
    var first_byte: usize = 0
    while first_byte < bytes.len() and bytes[first_byte] == b' ' {
        first_byte += 1
    }
    if starts_with_at(bytes, at: first_byte, prefix: b"\\\\") {
        while held.len() < first_byte {
            mut held.push(Held(literal: None))
        }
        while held.len() <= bytes.len() {
            mut held.push(Held(literal: Some(Literal.TextLine)))
        }
        return held
    }
    var at: usize = 0
    while at < bytes.len() {
        let byte = bytes[at]
        let next = byte_or_zero(bytes, at: at + 1)
        var literal = Literal.Text
        var quote = byte
        var contents = at + 1
        if byte == b'/' and next == b'/' {
            break
        } else if byte == b'"' {
            literal = Literal.Text
        } else if byte == b'\'' {
            literal = Literal.Char
        } else if byte == b'b' and next == b'"' {
            literal = Literal.Bytes
            quote = next
            contents = at + 2
        } else if byte == b'b' and next == b'\'' {
            literal = Literal.Byte
            quote = next
            contents = at + 2
        } else if is_word_byte(byte) {
            while at < bytes.len() and is_word_byte(bytes[at]) {
                at += 1
            }
            continue
        } else {
            at += 1
            continue
        }
        var end = contents
        while end < bytes.len() and bytes[end] != quote {
            if bytes[end] == b'\\' and end + 1 < bytes.len() {
                end += 2
            } else {
                end += 1
            }
        }
        var stop = bytes.len()
        if end < bytes.len() {
            stop = end + 1
        }
        while held.len() < at {
            mut held.push(Held(literal: None))
        }
        while held.len() < stop {
            mut held.push(Held(literal: Some(literal)))
        }
        at = stop
    }
    while held.len() <= bytes.len() {
        mut held.push(Held(literal: None))
    }
    return held
} literals

fn in_ranges(c: char, ranges: Slice[CodeRange]) -> bool {
    let value = c.to_bits()
    for range in ranges {
        if value >= range.low and value <= range.high {
            return true
        }
    }
    return false
} in_ranges

/// Whether a character is a rejected code point outside printable ASCII.
pkg fn is_rejected(c: char, grammar: Grammar) -> bool {
    return is_rejected_in(c, rejected: grammar.lexicon.contents().rejected.view())
} is_rejected

fn is_rejected_in(c: char, rejected: Slice[CodeRange]) -> bool {
    let value = c.to_bits()
    return not (value >= 0x20 and value < 0x7F) and in_ranges(c, ranges: rejected)
} is_rejected_in

fn rejected_code(c: char, grammar: Grammar) -> Option[diagnostic::Code] {
    if c == '\t' {
        return Some(diagnostic::Code.LexTab)
    }
    if c == '\r' {
        return Some(diagnostic::Code.LexCarriageReturn)
    }
    if is_rejected(c, grammar) {
        return Some(diagnostic::Code.LexRejectedCodePoint)
    }
    return None
} rejected_code

/// Scans the tokens of one line. A rejected or ill-formed character stops the scan without an
/// error of its own: the line's character scan reports it. Every method takes the scanner `mut`,
/// so that calls pass it in place instead of copying it.
view struct Scanner {
    /// The characters of the line, none for a plain line.
    chars: Slice[CharAt]
    /// Whether the line is plain, each byte the character of its index.
    plain: bool
    /// The number of characters of the line.
    count: usize
    /// The bytes of the line.
    bytes: Slice[u8]
    rejected: Slice[CodeRange]
    punctuation: Slice[mem::List[PunctSpelling]]
    keywords: Slice[mem::List[Spelled[Keyword]]]
    index: usize
    tokens: mem::List[Scanned]
    comment: Option[usize]
} Scanner

fn Scanner.char_at(mut self, index: usize) -> Option[char]
    ensures match result {
        Some(_) => index < self.count
        None => true
    }
{
    if index >= self.count {
        return None
    }
    if self.plain {
        if index >= self.bytes.len() {
            return None
        }
        return char.checked_from_bits(u32.widen(self.bytes[index]))
    }
    if index >= self.chars.len() {
        return None
    }
    return match self.chars[index].ch {
        Ch.Char(c) => Some(c)
        Ch.Invalid => None
    }
} Scanner.char_at

fn Scanner.offset(mut self, index: usize) -> usize {
    if index >= self.count {
        return self.bytes.len()
    }
    if self.plain or index >= self.chars.len() {
        return index
    }
    return self.chars[index].at
} Scanner.offset

fn Scanner.push(mut self, kind: TokenKind, from: usize, to: usize) {
    let scanned = Scanned(kind: kind, from: mut self.offset(from), to: mut self.offset(to))
    mut self.tokens.push(scanned)
    self.index = to
} Scanner.push

fn Scanner.run(mut self) fails Offence {
    while self.index < self.count {
        let start = self.index
        let Some(c) = mut self.char_at(start) else {
            return
        }
        if c == ' ' {
            self.index += 1
            continue
        }
        if is_rejected_in(c, rejected: self.rejected) {
            return
        }
        let first_token = self.tokens.len() == 0
        let next = mut self.char_at(start + 1)
        match first c {
            '/' if next == Some('/') => try mut self.comment_or_doc(start, first_token)
            '\\' if next == Some('\\') => {
                if not first_token {
                    fail Offence.At(at: mut self.offset(start), code: diagnostic::Code.LexNotAtLineStart)
                }
                expect start + 1 < self.count
                let end = self.count
                try mut self.content(from: start + 2, to: end, literal: Literal.TextLine)
                mut self.push(TokenKind.TextLine, from: start, to: end)
            }
            '"' => try mut self.quoted(start, quote_at: start, literal: Literal.Text)
            '\'' => try mut self.quoted(start, quote_at: start, literal: Literal.Char)
            'b' if next == Some('"') => try mut self.quoted(start, quote_at: start + 1, literal: Literal.Bytes)
            'b' if next == Some('\'') => try mut self.quoted(start, quote_at: start + 1, literal: Literal.Byte)
            _ if c.is_ascii_alphabetic() or c == '_' => mut self.word(start)
            _ if c.is_ascii_digit() => try mut self.number(start)
            else => try mut self.punct(start, c)
        }
    }
} Scanner.run

/// Scans the `//` at `start`: a plain comment ends the scan, a doc comment is a token.
fn Scanner.comment_or_doc(mut self, start: usize, first_token: bool) fails Offence {
    expect start <= self.count and self.count - start >= 2
    let third = mut self.char_at(start + 2)
    var kind = TokenKind.Doc
    if third == Some('!') {
        kind = TokenKind.FileDoc
    } else if third != Some('/') {
        self.comment = Some(mut self.offset(start))
        self.index = self.count
        return
    }
    if not first_token {
        fail Offence.At(at: mut self.offset(start), code: diagnostic::Code.LexNotAtLineStart)
    }
    mut self.push(kind, from: start, to: self.count)
} Scanner.comment_or_doc

fn Scanner.word(mut self, start: usize) {
    var end = start
    loop {
        let Some(c) = mut self.char_at(end) else {
            break
        }
        if not (c.is_ascii_alphabetic() or c.is_ascii_digit() or c == '_') {
            break
        }
        end += 1
    }
    var kind = TokenKind.Ident
    let from = mut self.offset(start)
    let to = mut self.offset(end)
    let Some(head) = self.bytes.prefix(to) else {
        expect false
        return
    }
    let Some(parts) = head.split_at(from) else {
        expect false
        return
    }
    match word_of(self.keywords, text: parts.tail) {
        Some(keyword) => {
            kind = TokenKind.Keyword(keyword)
        }
        None => {}
    }
    mut self.push(kind, from: start, to: end)
} Scanner.word

fn Scanner.number(mut self, start: usize) fails Offence {
    var end = start
    loop {
        let Some(c) = mut self.char_at(end) else {
            break
        }
        if c.is_ascii_alphabetic() or c.is_ascii_digit() or c == '_' {
            end += 1
            continue
        }
        let Some(after) = mut self.char_at(end + 1) else {
            break
        }
        if c != '.' or not after.is_ascii_digit() {
            break
        }
        end += 2
    }
    let from = mut self.offset(start)
    let to = mut self.offset(end)
    let Some(head) = self.bytes.prefix(to) else {
        expect false
        return
    }
    let Some(parts) = head.split_at(from) else {
        expect false
        return
    }
    match classify_number(parts.tail) {
        Ok(kind) => mut self.push(kind, from: start, to: end)
        Err(code) => fail Offence.At(at: mut self.offset(start), code: code)
    }
} Scanner.number

fn Scanner.punct(mut self, start: usize, c: char) fails Offence {
    let Some(parts) = self.bytes.split_at(mut self.offset(start)) else {
        expect false
        return
    }
    let ahead = parts.tail
    var found: Option[TokenKind] = None
    var length: usize = 0
    if ahead.len() > 0 and usize.widen(ahead[0]) < self.punctuation.len() {
        for spelt in self.punctuation[usize.widen(ahead[0])] {
            if starts_with_at(ahead, at: 0, prefix: spelt.spelling.view()) {
                found = Some(spelt.kind)
                length = spelt.spelling.len()
                break
            }
        }
    }
    let Some(kind) = found else {
        if c.is_ascii() {
            fail Offence.At(at: mut self.offset(start), code: diagnostic::Code.LexUnexpectedCharacter)
        }
        fail Offence.At(at: mut self.offset(start), code: diagnostic::Code.LexNonAscii)
    }
    expect start <= ~0usize - length
    mut self.push(kind, from: start, to: start + length)
} Scanner.punct

/// Scans a literal from its opener at `open`, its opening quote at `quote_at`.
fn Scanner.quoted(mut self, open: usize, quote_at: usize, literal: Literal) fails Offence {
    let Some(quote) = mut self.char_at(quote_at) else {
        expect false
        return
    }
    let contents = quote_at + 1
    var index = contents
    loop {
        if index >= self.count {
            fail Offence.At(at: mut self.offset(open), code: diagnostic::Code.LexUnterminatedLiteral)
        }
        let found = mut self.char_at(index)
        if found == Some('\\') and index + 1 < self.count {
            index += 2
        } else if found == Some(quote) {
            break
        } else {
            index += 1
        }
    }
    let close = index
    try mut self.content(from: contents, to: close, literal)
    if (literal == Literal.Char or literal == Literal.Byte) and mut self.units(from: contents, to: close, literal) != 1 {
        fail Offence.At(at: mut self.offset(open), code: diagnostic::Code.LexCharLiteralSize)
    }
    if literal == Literal.Byte {
        for at in contents..<close {
            if mut self.is_non_ascii(at) {
                fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexNonAsciiByte)
            }
        }
    }
    mut self.push(literal.kind(), from: open, to: close + 1)
} Scanner.quoted

/// A character that is neither ASCII nor rejected, which a byte literal cannot hold.
fn Scanner.is_non_ascii(mut self, index: usize) -> bool {
    let Some(c) = mut self.char_at(index) else {
        return false
    }
    return not c.is_ascii() and not is_rejected_in(c, rejected: self.rejected)
} Scanner.is_non_ascii

/// Checks the escapes of a literal's contents in order, and the characters of a `BYTES`.
fn Scanner.content(mut self, from: usize, to: usize, literal: Literal) fails Offence {
    var index = from
    while index < to {
        if mut self.char_at(index) == Some('\\') {
            index = try mut self.escape(at: index, to, literal)
        } else if literal == Literal.Bytes and mut self.is_non_ascii(index) {
            fail Offence.At(at: mut self.offset(index), code: diagnostic::Code.LexNonAsciiByte)
        } else {
            index += 1
        }
    }
} Scanner.content

/// The number of characters and escapes of contents whose escapes are valid.
fn Scanner.units(mut self, from: usize, to: usize, literal: Literal) -> usize {
    var index = from
    var units: usize = 0
    while index < to {
        invariant units <= index
        if mut self.char_at(index) == Some('\\') {
            let Ok(after) = attempt mut self.escape(at: index, to, literal) else {
                expect false
                return units
            }
            index = after
        } else {
            index += 1
        }
        units += 1
    }
    return units
} Scanner.units

/// The character at `index` of the contents ending before `to`.
fn Scanner.inside(mut self, index: usize, to: usize) -> Option[char]
    ensures match result {
        Some(_) => index < to
        None => true
    }
{
    if index < to {
        return mut self.char_at(index)
    }
    return None
} Scanner.inside

/// The index after the escape at `at`, which ends before `to`.
fn Scanner.escape(mut self, at: usize, to: usize, literal: Literal) -> usize fails Offence {
    expect at < to
    let Some(escaped) = mut self.inside(index: at + 1, to) else {
        fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexUnknownEscape)
    }
    match first escaped {
        '\\' or '"' or '\'' or 'n' or 'r' or 't' or '0' => return at + 2
        'x' => {
            let Some(value) = mut self.escape_digits(from: at + 2, to) else {
                fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexUnknownEscape)
            }
            if value > 0x7F and not literal.holds_bytes() {
                fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexEscapeOutOfRange)
            }
            return at + 4
        }
        'u' if not literal.holds_bytes() => {
            let Some('{') = mut self.inside(index: at + 2, to) else {
                fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexUnknownEscape)
            }
            let Some(close) = mut self.digits_close(from: at + 3, to) else {
                fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexUnknownEscape)
            }
            let count = close - at - 3
            if count < 1 or count > 6 {
                fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexUnknownEscape)
            }
            let Some(parts) = self.bytes.split_at(mut self.offset(at + 3)) else {
                expect false
                return 0
            }
            let Some(written) = parts.tail.prefix(count) else {
                expect false
                return 0
            }
            let Some(value) = hex_value(written) else {
                expect false
                return 0
            }
            if char.checked_from_bits(value).is_none() {
                fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexEscapeOutOfRange)
            }
            return close + 1
        }
        else => fail Offence.At(at: mut self.offset(at), code: diagnostic::Code.LexUnknownEscape)
    }
} Scanner.escape

/// The index of the `}` that ends the hexadecimal digits from `from` before `to`, if one does.
fn Scanner.digits_close(mut self, from: usize, to: usize) -> Option[usize]
    ensures match result {
        Some(close) => from <= close and close < to
        None => true
    }
{
    for close in from..<to {
        let Some(c) = mut self.char_at(close) else {
            return None
        }
        if c == '}' {
            return Some(close)
        }
        if not is_hex_byte_char(c) {
            return None
        }
    }
    return None
} Scanner.digits_close

/// The value of the two characters at `from`, after a `\x`, as `u32::from_str_radix` reads them.
fn Scanner.escape_digits(mut self, from: usize, to: usize) -> Option[u32]
    ensures match result {
        Some(_) => from < to and from + 1 < to
        None => true
    }
{
    let Some(high) = mut self.inside(index: from, to) else {
        return None
    }
    let Some(low) = mut self.inside(index: from + 1, to) else {
        return None
    }
    if not (high.is_ascii() and low.is_ascii()) {
        return None
    }
    let Some(parts) = self.bytes.split_at(mut self.offset(from)) else {
        return None
    }
    let Some(written) = parts.tail.prefix(2) else {
        return None
    }
    return hex_value(written)
} Scanner.escape_digits

fn is_hex_byte_char(c: char) -> bool {
    return c.is_ascii() and is_hex_byte(u8.truncate(c.to_bits()))
} is_hex_byte_char

/// The value of hexadecimal digits as `u32::from_str_radix` reads them: an optional leading `+`,
/// then at least one digit; none on overflow.
fn hex_value(written: Slice[u8]) -> Option[u32] {
    if written.len() == 0 {
        return None
    }
    var start: usize = 0
    if written[0] == b'+' or written[0] == b'-' {
        if written.len() == 1 {
            return None
        }
        if written[0] == b'+' {
            start = 1
        }
    }
    var value: u32 = 0
    for index in start..<written.len() {
        let Some(digit) = hex_digit_value(written[index]) else {
            return None
        }
        let Some(shifted_value) = value.checked_mul(16) else {
            return None
        }
        let Some(next) = shifted_value.checked_add(digit) else {
            return None
        }
        value = next
    }
    return Some(value)
} hex_value

fn hex_digit_value(byte: u8) -> Option[u32] {
    return match byte {
        b'0'..=b'9' => Some(u32.widen(byte - b'0'))
        b'a'..=b'f' => Some(u32.widen(byte - b'a') + 10)
        b'A'..=b'F' => Some(u32.widen(byte - b'A') + 10)
        else => None
    }
} hex_digit_value

/// Classifies a number run as an `INT` or `FLOAT` token, or the error it is.
fn classify_number(run: Slice[u8]) -> Result[TokenKind, diagnostic::Code] {
    var integer = dec_int(run, from: 0)
    if starts_with_at(run, at: 0, prefix: b"0x") {
        integer = digits(run, from: 2, is_digit: is_hex_byte)
    } else if starts_with_at(run, at: 0, prefix: b"0b") {
        integer = digits(run, from: 2, is_digit: is_binary_byte)
    }
    match integer {
        Some(end) => {
            if int_suffix(run, from: end) {
                return Ok(TokenKind.Int)
            }
        }
        None => {}
    }
    var fraction: Option[usize] = None
    match dec_int(run, from: 0) {
        Some(end) => {
            if end < run.len() and run[end] == b'.' {
                fraction = digits(run, from: end + 1, is_digit: is_decimal_byte)
            }
        }
        None => {}
    }
    match fraction {
        Some(end) => {
            if end == run.len() or float_suffix(run, from: end) {
                return Ok(TokenKind.Float)
            }
        }
        None => {}
    }
    var suffixed = false
    match dec_int(run, from: 0) {
        Some(end) => {
            suffixed = float_suffix(run, from: end)
        }
        None => {}
    }
    if starts_with_at(run, at: 0, prefix: b"0b") {
        match digits(run, from: 2, is_digit: is_binary_byte) {
            Some(end) => {
                suffixed = suffixed or float_suffix(run, from: end)
            }
            None => {}
        }
    }
    match fraction {
        Some(end) => {
            suffixed = suffixed or int_suffix(run, from: end)
        }
        None => {}
    }
    if suffixed {
        return Err(diagnostic::Code.LexLiteralSuffix)
    }
    return Err(diagnostic::Code.LexMalformedNumber)
} classify_number

fn int_suffix(run: Slice[u8], from: usize) -> bool {
    expect from <= run.len()
    if from == run.len() {
        return true
    }
    let suffixes = match run.len() - from {
        2 => rest_is(run, from, word: "u8") or rest_is(run, from, word: "i8")
        3 => rest_is(run, from, word: "u16") or rest_is(run, from, word: "u32") or rest_is(run, from, word: "u64") or rest_is(run, from, word: "i16") or rest_is(run, from, word: "i32") or rest_is(run, from, word: "i64")
        5 => rest_is(run, from, word: "usize") or rest_is(run, from, word: "isize")
        else => false
    }
    return suffixes
} int_suffix

fn float_suffix(run: Slice[u8], from: usize) -> bool {
    return rest_is(run, from, word: "f32") or rest_is(run, from, word: "f64")
} float_suffix

/// Whether the bytes of `run` from `from` on are exactly `word`.
fn rest_is(run: Slice[u8], from: usize, word: Str) -> bool {
    expect from <= run.len()
    return run.len() - from == word.byte_len() and starts_with_at(run, at: from, prefix: word.as_bytes())
} rest_is

/// Matches `"0" | "1" .. "9" ( "_"? DIGIT )*` at `from`, returning the offset after the match.
fn dec_int(text: Slice[u8], from: usize) -> Option[usize] {
    if from < text.len() and text[from] == b'0' {
        return Some(from + 1)
    }
    if from < text.len() and is_decimal_byte(text[from]) {
        return digits(text, from, is_digit: is_decimal_byte)
    }
    return None
} dec_int

/// Matches `D ( "_"? D )*` at `from` for the digits `D`, returning the offset after the match.
fn digits(text: Slice[u8], from: usize, is_digit: fn(byte: u8) -> bool) -> Option[usize] {
    if not (from < text.len() and is_digit(text[from])) {
        return None
    }
    var end = from + 1
    loop {
        invariant end <= text.len()
        if end < text.len() and is_digit(text[end]) {
            end += 1
        } else if text.len() - end >= 2 and text[end] == b'_' and is_digit(text[end + 1]) {
            end += 2
        } else {
            return Some(end)
        }
    }
} digits

fn is_decimal_byte(byte: u8) -> bool {
    return byte >= b'0' and byte <= b'9'
} is_decimal_byte

fn is_hex_byte(byte: u8) -> bool {
    return hex_digit_value(byte).is_some()
} is_hex_byte

fn is_binary_byte(byte: u8) -> bool {
    return byte == b'0' or byte == b'1'
} is_binary_byte

fn is_word_byte(byte: u8) -> bool {
    return is_decimal_byte(byte) or (byte >= b'a' and byte <= b'z') or (byte >= b'A' and byte <= b'Z') or byte == b'_'
} is_word_byte

/// The tokens of a source, one logical line per row, spelt as grammar notation names them.
fn rendered(source: Slice[u8], alloc: mem::Alloc) -> text::String {
    let lexed = lex(source, grammar: Grammar.load(alloc), alloc)
    var out = text::String.empty(alloc)
    for index in 0..<lexed.tokens.len() {
        let token = lexed.tokens[index]
        if index > 0 and lexed.tokens[index - 1].kind == TokenKind.Nl {
            mut out.push('\n')
        } else if index > 0 {
            mut out.push(' ')
        }
        match token.kind {
            TokenKind.Keyword(keyword) => mut out.append(keyword.spelling())
            TokenKind.Punct(punct) => mut out.append(punct.spelling())
            TokenKind.Foreign(spelt) => mut out.append(spelt.spelling())
            TokenKind.LexError => mut out.append("ERROR")
            else => mut out.append(token.written(alloc).as_str())
        }
    }
    return out
} rendered

/// Traps unless the tokens of a source render as expected.
fn expect_rendered(source: Slice[u8], expected: Str, alloc: mem::Alloc) {
    let found = rendered(source, alloc)
    expect found.as_str() == expected
} expect_rendered

/// Traps unless a source has exactly one lexical diagnostic, on its first line, with the code named.
fn expect_once(source: Slice[u8], code: Str, alloc: mem::Alloc) {
    let lexed = lex(source, grammar: Grammar.load(alloc), alloc)
    expect lexed.diagnostics.len() == 1
    expect lexed.diagnostics[0].line == 1
    expect lexed.diagnostics[0].code.name() == code
} expect_once

test virtual_tokens_follow_logical_lines for lex {
    let alloc = testing::world().alloc
    let source =
        \\/// Limits a sensor reading to the calibrated range.
        \\pub fn clamp_reading(raw: u32) -> u32
        \\    ensures result <= 1_000
        \\{
        \\    if raw > 1_000 {
        \\        return 1_000
        \\    }
        \\    return raw
        \\} clamp_reading
        \\
    let expected =
        \\COL0 DOC NL
        \\COL0 pub fn IDENT ( IDENT : IDENT ) -> IDENT NL
        \\ensures IDENT <= INT NL
        \\COL0 { if IDENT > INT { return INT NL
        \\} NL
        \\return IDENT NL
        \\COL0 } IDENT NL
        \\EOF
    expect_rendered(source.as_bytes(), expected, alloc)
    expect_rendered(b"a +\n\n    // middle\n    b\nc\n", expected: "COL0 IDENT + IDENT NL\nCOL0 IDENT NL\nEOF", alloc)
    expect_rendered(b"x =\n    \\\\usage: nan\n    \\\\    check\n\n    \\\\new run\n", expected: "COL0 IDENT = TEXT_LINE TEXT_LINE NL\nTEXT_LINE NL\nEOF", alloc)
    expect_rendered(b"a b\"NAN\\x00\" 'x' b'\\n' \"caf\\u{E9}\" 0xFEB0_0000 0b1000_0001 255u8 0.5 0x1f32 0..<n a<<=b\n", expected: "COL0 IDENT BYTES CHAR BYTE TEXT INT INT INT FLOAT INT INT ..< IDENT IDENT <<= IDENT NL\nEOF", alloc)
    expect_rendered(b"a && b || !c? ;\n", expected: "COL0 IDENT && IDENT || ! IDENT ? ; NL\nEOF", alloc)
} virtual_tokens_follow_logical_lines

test each_line_reports_its_first_offending_character for lex {
    let alloc = testing::world().alloc
    expect_once(b"  return x\n", code: "lex.indentation", alloc)
    expect_once(b"\tx\n", code: "lex.tab", alloc)
    expect_once(b"x\r\n", code: "lex.carriage-return", alloc)
    expect_once(b"x \n", code: "lex.trailing-whitespace", alloc)
    expect_once(b"x \xFF y\n", code: "lex.invalid-utf8", alloc)
    expect_once(b"x \\ y\n", code: "lex.unexpected-character", alloc)
    expect_once(b"MAX_\xC3\x89TAGES\n", code: "lex.non-ascii", alloc)
    expect_once(b"0755\n", code: "lex.malformed-number", alloc)
    expect_once(b"1.5u8\n", code: "lex.literal-suffix", alloc)
    expect_once(b"0b1f32\n", code: "lex.literal-suffix", alloc)
    expect_once(b"\"C:\\data\"\n", code: "lex.unknown-escape", alloc)
    expect_once(b"b\"\\u{41}\"\n", code: "lex.unknown-escape", alloc)
    expect_once(b"\"caf\\xE9\"\n", code: "lex.escape-out-of-range", alloc)
    expect_once(b"\"\\u{D800}\"\n", code: "lex.escape-out-of-range", alloc)
    expect_once(b"b'\xC3\xA9'\n", code: "lex.non-ascii-byte", alloc)
    expect_once(b"'ok'\n", code: "lex.char-literal-size", alloc)
    expect_once(b"x = '\xE2\x82'\n", code: "lex.invalid-utf8", alloc)
    expect_once(b"x = '\xE2\xE2'\n", code: "lex.char-literal-size", alloc)
    expect_once(b"x \"unfinished\n", code: "lex.unterminated-literal", alloc)
    expect_once(b"x /// doc\n", code: "lex.not-at-line-start", alloc)
    expect_once(b"x", code: "lex.missing-final-newline", alloc)
    expect_rendered(b"x = \xE2\x80\x8B\n", expected: "COL0 IDENT = ERROR NL\nEOF", alloc)
    expect_rendered(b"", expected: "ERROR NL\nEOF", alloc)
} each_line_reports_its_first_offending_character
