//! The grammar of language 1, built from `docs/spec/41-grammar.md`, and its LL(1) analysis.

/// The grammar's tables: the choice each syntactic rule expands, each choice's alternatives and
/// each alternative's elements, the code points the lexer rejects, and the LL(1) analysis.
pkg struct Grammar {
    /// The choice of each rule, by rule index.
    rule_choices: mem::List[usize]
    /// The alternatives of each choice, as sequence ids.
    choices: mem::List[mem::List[usize]]
    seqs: mem::List[SeqDef]
    /// The ranges `REJECTED` matches, sorted.
    rejected: mem::List[CodeRange]
    /// The ranges `REJECTED_SPACE` matches, sorted.
    rejected_space: mem::List[CodeRange]
    analysis: Analysis
} Grammar

/// The code points from `low` to `high`, both included.
struct CodeRange derives Copy, Eq, Ord {
    low: u32
    high: u32
} CodeRange

/// One alternative of a choice: elements in order, and the code it is rejected with, if any.
struct SeqDef {
    elems: mem::List[ElemDef]
    rejection: Option[diagnostic::Code]
} SeqDef

struct ElemDef derives Copy, Eq {
    atom: Atom
    repeat: Repeat
} ElemDef

enum Atom derives Copy, Eq {
    Rule(Rule)
    /// A parenthesised group, by its choice id.
    Group(usize)
    Term(Term)
} Atom

enum Repeat derives Copy, Eq {
    One
    Opt
    Star
    Plus
} Repeat

/// A terminal of the syntactic grammar.
enum Term derives Copy, Eq {
    Keyword(Keyword)
    Punct(Punct)
    Context(ContextWord)
    Class(Class)
} Term

const KEYWORDS: usize = 67

const PUNCTS: usize = 42

const FOREIGNS: usize = 7

const CONTEXTS: usize = 52

const CLASSES: usize = 13

const TERMS: usize = KEYWORDS + PUNCTS + CONTEXTS + CLASSES

const WORDS: usize = (TERMS + 63) / 64

fn Rule.choice(self, grammar: Grammar) -> usize {
    return grammar.rule_choices[self.index()]
} Rule.choice

fn Term.index(self) -> usize {
    return match self {
        Term.Keyword(keyword) => keyword.index()
        Term.Punct(punct) => KEYWORDS + punct.index()
        Term.Context(word) => KEYWORDS + PUNCTS + word.index()
        Term.Class(class) => KEYWORDS + PUNCTS + CONTEXTS + class.index()
    }
} Term.index

fn Term.from_index(index: usize) -> Term {
    if index < KEYWORDS {
        let Some(keyword) = Keyword.from_index(index) else {
            expect false
            return Term.Class(Class.Eof)
        }
        return Term.Keyword(keyword)
    }
    if index < KEYWORDS + PUNCTS {
        let Some(punct) = Punct.from_index(index - KEYWORDS) else {
            expect false
            return Term.Class(Class.Eof)
        }
        return Term.Punct(punct)
    }
    if index < KEYWORDS + PUNCTS + CONTEXTS {
        let Some(word) = ContextWord.from_index(index - KEYWORDS - PUNCTS) else {
            expect false
            return Term.Class(Class.Eof)
        }
        return Term.Context(word)
    }
    let Some(class) = Class.from_index(index - KEYWORDS - PUNCTS - CONTEXTS) else {
        expect false
        return Term.Class(Class.Eof)
    }
    return Term.Class(class)
} Term.from_index

/// The terminal as grammar notation writes it: `"fn"`, `'language'` or `IDENT`.
fn Term.written(self, alloc: mem::Alloc) -> text::String {
    var written = text::String.empty(alloc)
    match self {
        Term.Keyword(keyword) => {
            mut written.push('"')
            mut written.append(keyword.spelling())
            mut written.push('"')
        }
        Term.Punct(punct) => {
            mut written.push('"')
            mut written.append(punct.spelling())
            mut written.push('"')
        }
        Term.Context(word) => {
            mut written.push('\'')
            mut written.append(word.spelling())
            mut written.push('\'')
        }
        Term.Class(class) => mut written.append(class.name())
    }
    return written
} Term.written

/// A set of terminals.
struct TermSet derives Copy, Eq, Default {
    words: Array[u64, WORDS]
} TermSet

fn TermSet.single(term: Term) -> TermSet {
    var set = TermSet.default()
    mut set.insert(term)
    return set
} TermSet.single

fn TermSet.insert(mut self, term: Term) {
    let index = term.index()
    self.words[index / 64] |= 1u64 << u32.truncate(index % 64)
} TermSet.insert

fn TermSet.contains(self, term: Term) -> bool {
    let index = term.index()
    return (self.words[index / 64] & (1u64 << u32.truncate(index % 64))) != 0
} TermSet.contains

fn TermSet.union(mut self, other: TermSet) {
    for index in 0..<WORDS {
        self.words[index] |= other.words[index]
    }
} TermSet.union

fn TermSet.is_superset(self, other: TermSet) -> bool {
    for index in 0..<WORDS {
        if (self.words[index] & other.words[index]) != other.words[index] {
            return false
        }
    }
    return true
} TermSet.is_superset

/// The terminals of the set, in index order.
fn TermSet.terms(self, alloc: mem::Alloc) -> mem::List[Term] {
    var held = mem::List[Term].empty(alloc)
    for index in 0..<TERMS {
        if (self.words[index / 64] & (1u64 << u32.truncate(index % 64))) != 0 {
            mut held.push(Term.from_index(index))
        }
    }
    return held
} TermSet.terms

/// What can start a symbol: terminals reached outside every rejected alternative (`ok`), terminals
/// reached through a rejected alternative (`rejected`), and whether it derives no token.
struct First derives Copy, Eq, Default {
    ok: TermSet
    rejected: TermSet
    nullable: bool
} First

/// What can start each choice and each sequence of the grammar.
struct Analysis {
    choices: mem::List[First]
    seqs: mem::List[First]
} Analysis

fn Analysis.empty(alloc: mem::Alloc) -> Analysis = Analysis(choices: mem::List[First].empty(alloc), seqs: mem::List[First].empty(alloc))

fn Analysis.compute(grammar: Grammar, alloc: mem::Alloc) -> Analysis {
    var analysis = Analysis.empty(alloc)
    for _ in 0..<grammar.choices.len() {
        mut analysis.choices.push(First.default())
    }
    for _ in 0..<grammar.seqs.len() {
        mut analysis.seqs.push(First.default())
    }
    loop {
        var changed = false
        for id in 0..<grammar.seqs.len() {
            let seq = grammar.seqs[id]
            var reached = analysis.elems(seq.elems, grammar)
            if seq.rejection.is_some() {
                mut reached.rejected.union(reached.ok)
                reached.ok = TermSet.default()
            }
            changed = changed or analysis.seqs[id] != reached
            analysis.seqs[id] = reached
        }
        for id in 0..<grammar.choices.len() {
            var reached = First.default()
            for alt in grammar.choices[id] {
                let alternative = analysis.seqs[alt]
                mut reached.ok.union(alternative.ok)
                mut reached.rejected.union(alternative.rejected)
                reached.nullable = reached.nullable or alternative.nullable
            }
            changed = changed or analysis.choices[id] != reached
            analysis.choices[id] = reached
        }
        if not changed {
            return analysis
        }
    }
} Analysis.compute

fn Analysis.choice(self, choice: usize) -> First {
    return self.choices[choice]
} Analysis.choice

fn Analysis.seq(self, seq: usize) -> First {
    return self.seqs[seq]
} Analysis.seq

fn Analysis.atom(self, atom: Atom, grammar: Grammar) -> First {
    return match atom {
        Atom.Term(term) => First(ok: TermSet.single(term), rejected: TermSet.default(), nullable: false)
        Atom.Rule(rule) => self.choices[rule.choice(grammar)]
        Atom.Group(choice) => self.choices[choice]
    }
} Analysis.atom

/// What can start a run of elements, through every element that may derive no token.
fn Analysis.elems(self, elems: mem::List[ElemDef], grammar: Grammar) -> First {
    var reached = First(ok: TermSet.default(), rejected: TermSet.default(), nullable: true)
    for elem in elems {
        let atom = self.atom(elem.atom, grammar)
        mut reached.ok.union(atom.ok)
        mut reached.rejected.union(atom.rejected)
        let optional = match elem.repeat {
            Repeat.Opt or Repeat.Star => true
            Repeat.One or Repeat.Plus => false
        }
        if not (atom.nullable or optional) {
            reached.nullable = false
            break
        }
    }
    return reached
} Analysis.elems

test choices_are_ll1_under_the_published_resolutions for Grammar.load {
    let alloc = testing::world().alloc
    let grammar = Grammar.load(alloc)
    for alts in grammar.choices {
        for left in 0..<alts.len() {
            for right in (left + 1)..<alts.len() {
                let left_first = grammar.analysis.seq(alts[left])
                let right_first = grammar.analysis.seq(alts[right])
                for term in left_first.ok.terms(alloc) {
                    expect not right_first.ok.contains(term)
                }
                for term in left_first.rejected.terms(alloc) {
                    expect not right_first.rejected.contains(term)
                }
            }
        }
    }
} choices_are_ll1_under_the_published_resolutions

test rejected_code_points_leave_printable_ascii_alone for Grammar.load {
    let grammar = Grammar.load(testing::world().alloc)
    for range in grammar.rejected {
        expect range.high < 0x20 or range.low >= 0x7F
    }
} rejected_code_points_leave_printable_ascii_alone

