//! The image writer: links the relocatable object of a Windows or machine target's lowering into its image, a PE32+ console program on a Windows target, a PE32+ EFI application on a UEFI target, a static ELF64 executable on a bare target, or a bundle. It lays the object's sections out in segments, one per access kind, resolves its symbols and applies its relocations.

/// The size of a page, to which every segment is aligned.
const PAGE: u64 = 4_096

/// The data object of 16 bytes into which the image writer writes the image's first and last
/// address plus one.
pkg const IMAGE_EXTENT: Str = "_NSimage"

/// The data object of `SEGMENT_TABLE_BYTES` bytes into which the image writer writes the image's
/// segment count, then for each of its segments, in address order, its absolute address, its size
/// and its access: bit 0 for writable and bit 1 for executable. An image has at most
/// `MOST_SEGMENTS` segments.
pkg const SEGMENT_TABLE: Str = "_NSsegments"

pkg const MOST_SEGMENTS: u64 = 4

pkg const SEGMENT_TABLE_BYTES: u64 = 8 + 24 * MOST_SEGMENTS

/// The relocation header, a data object of `RELOCATION_HEADER_BYTES` bytes into which the image
/// writer of a bare image writes five words as linked: the header's address, the image's first
/// and last address plus one, the address of a table listing the address of each absolute address
/// its relocations wrote, and that table's entry count. The table lies in a read-only segment
/// after the others; none of the header's words is itself relocated.
pkg const RELOCATION_HEADER: Str = "_NSrelocs"

pkg const RELOCATION_HEADER_BYTES: usize = 40

/// The image of a Windows or machine target linking an object lowering wrote, entered at the
/// symbol `entry`.
pkg fn write(target: workspace::Target, object: Slice[u8], entry: Str, alloc: mem::Alloc) -> mem::Bytes {
    let Some(arch) = target.arch() else {
        expect false
        return mem::Bytes.empty(alloc)
    }
    match target.kind() {
        Some(workspace::Kind.Windows) => {
            let linked = link(object, base: pe_base(Program.Console), imports: Imports.Table, alloc)
            return pe_write(linked, entry: linked.symbol(entry), arch, program: Program.Console, alloc)
        }
        Some(workspace::Kind.Uefi) => {
            let linked = link(object, base: pe_base(Program.Efi), imports: Imports.None, alloc)
            return pe_write(linked, entry: linked.symbol(entry), arch, program: Program.Efi, alloc)
        }
        Some(workspace::Kind.Bare) => {
            let linked = link(object, base: elf_base(arch), imports: Imports.None, alloc)
            return elf_write(linked, entry: linked.symbol(entry), arch, alloc)
        }
        else => {
            expect false
            return mem::Bytes.empty(alloc)
        }
    }
} write

/// How a link treats the symbols an object leaves undefined: none is left undefined; a bundle's
/// absolute addresses of one are imports, and its calls of one go through an import stub after
/// the object's code; a Windows image's are each an `IMPORT_PREFIX` symbol naming a word of the
/// import address table, which the system's loader fills with the address of the function it
/// names.
enum Imports derives Copy, Eq {
    None
    Bundle
    Table
} Imports

/// The prefix of the symbol naming the import address table's word of a function a Windows image
/// imports, followed by the function's name for a function of `KERNEL32`, and otherwise by its
/// library's name, `!` and its name.
pkg const IMPORT_PREFIX: Str = "__imp_"

/// The library a Windows image imports a function from when its symbol names none.
const KERNEL32: Str = "kernel32.dll"

/// A function a Windows image imports: its library, its name and the symbol naming its word.
struct Named {
    library: text::String
    function: text::String
    symbol: text::String
} Named

/// What a segment's memory permits beside reading.
enum Access derives Copy, Eq {
    Execute
    Read
    Write
} Access

/// A segment of an image: its address, its bytes and its size in memory, the rest zeros.
struct Segment {
    address: u64
    access: Access
    bytes: mem::Bytes
    size: u64
} Segment

fn Segment.contains(self, address: u64) -> bool = address >= self.address and address - self.address < self.size

/// An object linked at an address: its segments, the address of each of its symbols, the
/// address of each 8-byte absolute address its relocations wrote, and each word holding the
/// address of a symbol it imports; a Windows image's words are its import address table, the
/// last segment, where each library's functions follow each other in order and end with a zero
/// word, and each name is the library's, `!` and the function's.
struct Linked {
    segments: mem::List[Segment]
    symbols: mem::Map[text::String, u64]
    absolute: mem::List[u64]
    imports: mem::List[Import]
    unallocated: mem::List[Unallocated]
} Linked

/// The address of a word holding the address of a symbol an object imports, and its name.
struct Import {
    address: u64
    name: text::String
} Import

/// The code a bundle calls an imported function through, in its text: an indirect jump through
/// the word that follows it, which holds the function's address.
const IMPORT_STUB: Slice[u8] = b"\xff\x25\x02\x00\x00\x00\xcc\xcc"

const IMPORT_STUB_BYTES: u64 = 16

/// The address of a symbol the lowering defines.
fn Linked.symbol(self, name: Str) -> u64 {
    let Some(address) = self.symbols.get_by(fn(key: text::String) => key.as_str().cmp(name)) else {
        expect false
        return 0
    }
    return address
} Linked.symbol

/// The end of the memory the segments occupy.
fn Linked.end(self) -> u64 {
    var end: u64 = 0
    for segment in self.segments {
        if segment.address + segment.size > end {
            end = segment.address + segment.size
        }
    }
    return end
} Linked.end

/// Writes the relocation header and appends its table when the object defines the header, the
/// table listing the image extent's words too.
fn Linked.record_relocations(mut self, base: u64, alloc: mem::Alloc) {
    let Some(header) = self.symbols.get_by(fn(key: text::String) => key.as_str().cmp(RELOCATION_HEADER)) else {
        return
    }
    var places = mem::List[u64].empty(alloc)
    for address in self.absolute {
        mut places.push(address)
    }
    match self.symbols.get_by(fn(key: text::String) => key.as_str().cmp(IMAGE_EXTENT)) {
        Some(extent) => {
            mut places.push(extent)
            mut places.push(extent + 8)
        }
        None => {}
    }
    match self.symbols.get_by(fn(key: text::String) => key.as_str().cmp(SEGMENT_TABLE)) {
        Some(table_at) => {
            for index in 0..<(u64.widen(self.segments.len()) + 1) {
                mut places.push(table_at + 8 + 24 * index)
            }
        }
        None => {}
    }
    mut places.sort_by(fn(left: u64, right: u64) => left.cmp(right))
    let table = next_multiple_of(self.end(), multiple: PAGE)
    if places.len() > 0 {
        var bytes = mem::Bytes.empty(alloc)
        for place in places {
            object::append_u64(mut bytes, value: place)
        }
        mut self.segments.push(Segment(address: table, access: Access.Read, bytes: take bytes, size: 8 * u64.widen(places.len())))
    }
    var words = mem::List[u64].empty(alloc)
    mut words.push(header)
    mut words.push(base)
    mut words.push(self.end())
    mut words.push(table)
    mut words.push(u64.widen(places.len()))
    mut self.write_words(at: header, words: words.view())
} Linked.record_relocations

/// Writes words at an address of a segment's bytes.
fn Linked.write_words(mut self, at: u64, words: Slice[u64]) {
    let Some(index) = self.segments.position(fn(segment: Segment) => segment.contains(at)) else {
        expect false
        return
    }
    expect self.segments[index].contains(at)
    let offset = usize.widen(at - self.segments[index].address)
    var bytes = mut self.segments[index].bytes.view_mut()
    for slot in 0..<words.len() {
        mut bytes.write_u64_le(offset + 8 * slot, value: words[slot])
    }
} Linked.write_words

/// Writes the image's extent, from `base` to the end of its segments, into the data object
/// `IMAGE_EXTENT` when the object defines one, as two absolute addresses.
fn Linked.record_extent(mut self, base: u64) {
    let Some(at) = self.symbols.get_by(fn(key: text::String) => key.as_str().cmp(IMAGE_EXTENT)) else {
        return
    }
    let end = self.end()
    var words = Array[u64, 2].filled(base)
    words[1] = end
    mut self.write_words(at, words: words.view())
    mut self.absolute.push(at)
    mut self.absolute.push(at + 8)
} Linked.record_extent

/// Writes the image's segments into the data object `SEGMENT_TABLE` when the object defines one,
/// each segment's address being absolute.
fn Linked.record_segments(mut self, alloc: mem::Alloc) {
    let Some(at) = self.symbols.get_by(fn(key: text::String) => key.as_str().cmp(SEGMENT_TABLE)) else {
        return
    }
    expect u64.widen(self.segments.len()) <= MOST_SEGMENTS
    var words = mem::List[u64].empty(alloc)
    mut words.push(u64.widen(self.segments.len()))
    for segment in self.segments {
        let access: u64 = match segment.access {
            Access.Execute => 2
            Access.Read => 0
            Access.Write => 1
        }
        mut words.push(segment.address)
        mut words.push(segment.size)
        mut words.push(access)
    }
    mut self.write_words(at, words: words.view())
    for index in 0..<u64.widen(self.segments.len()) {
        mut self.absolute.push(at + 8 + 24 * index)
    }
} Linked.record_segments

/// The relocation types the objects lowering writes hold: the x86_64 ones, which patch a byte
/// range with an absolute or program-counter-relative address, and the AArch64 ones, which patch
/// an instruction's immediate field, `A64_ABS64` aside.
const ABS64: u32 = 1
const PC32: u32 = 2
const PLT32: u32 = 4
const A64_ABS64: u32 = 257
const A64_ADR_PREL_PG_HI21: u32 = 275
const A64_ADD_ABS_LO12_NC: u32 = 277
const A64_CALL26: u32 = 283

/// Patches the 32-bit AArch64 instruction at `offset` in `bytes`, replacing the bits `field`
/// covers with `value`.
fn patch_a64(mut bytes: SliceMut[u8], offset: usize, field: u32, value: u32) {
    var word = u32.widen(bytes[offset])
    word = word | (u32.widen(bytes[offset + 1]) << 8)
    word = word | (u32.widen(bytes[offset + 2]) << 16)
    word = word | (u32.widen(bytes[offset + 3]) << 24)
    let patched = (word & ~field) | (value & field)
    mut bytes.write_u32_le(offset, value: patched)
} patch_a64

/// A value rounded up to a multiple.
fn next_multiple_of(value: u64, multiple: u64) -> u64 {
    let rest = value % multiple
    if rest == 0 {
        return value
    }
    return value + (multiple - rest)
} next_multiple_of

/// Links an object with its first segment at `base`, treating its undefined symbols as `imports`
/// says.
fn link(object: Slice[u8], base: u64, imports: Imports, alloc: mem::Alloc) -> Linked {
    var read_object = read(object, alloc)
    let called = called_imports(read_object, alloc)
    expect imports == Imports.Bundle or called.len() == 0
    var placed = mem::List[Option[u64]].empty(alloc)
    for _ in read_object.sections {
        mut placed.push(None)
    }
    var segments = mem::List[Segment].empty(alloc)
    let sections = read_object.sections.view()
    var next = add_segment(mut segments, mut placed, sections, address: base, access: Access.Execute, stubs: u64.widen(called.len()), alloc)
    var stubs: u64 = 0
    if called.len() > 0 and segments.len() > 0 {
        stubs = segments[0].address + segments[0].size - u64.widen(called.len()) * IMPORT_STUB_BYTES
    }
    next = add_segment(mut segments, mut placed, sections, address: next, access: Access.Read, stubs: 0, alloc)
    next = add_segment(mut segments, mut placed, sections, address: next, access: Access.Write, stubs: 0, alloc)
    var imported = mem::List[Import].empty(alloc)
    for index in 0..<called.len() {
        mut imported.push(Import(address: stubs + u64.widen(index) * IMPORT_STUB_BYTES + 8, name: text::String.of(called[index].as_str(), alloc)))
    }
    var table = mem::Map[text::String, u64].empty(alloc)
    if imports == Imports.Table {
        mut segments.push(import_table(read_object, at: next, mut imported, mut table, alloc))
    }
    var symbols = mem::Map[text::String, u64].empty(alloc)
    for symbol in read_object.symbols {
        let Some(section) = symbol.section else {
            continue
        }
        expect section < placed.len()
        let Some(start) = placed[section] else {
            continue
        }
        if not symbol.name.is_empty() {
            discard mut symbols.insert(text::String.of(symbol.name.as_str(), alloc), value: start + symbol.value)
        }
    }
    var absolute = mem::List[u64].empty(alloc)
    expect placed.len() == read_object.sections.len()
    for index in 0..<read_object.sections.len() {
        let Some(start) = placed[index] else {
            continue
        }
        if read_object.sections[index].relocations.len() == 0 {
            continue
        }
        let Some(at) = segments.position(fn(segment: Segment) => segment.contains(start)) else {
            expect false
            continue
        }
        var segment = mut segments.at_mut(at)
        for relocation in read_object.sections[index].relocations {
            expect relocation.symbol < read_object.symbols.len()
            let symbol = read_object.symbols[relocation.symbol]
            let place = start + relocation.offset
            var target: i64 = 0
            if undefined(symbol) {
                let Some(imported_at) = import_target(called, table, name: symbol.name.as_str(), stubs) else {
                    expect imports == Imports.Bundle and (relocation.kind == ABS64 or relocation.kind == A64_ABS64)
                    mut imported.push(Import(address: place, name: text::String.of(symbol.name.as_str(), alloc)))
                    continue
                }
                target = i64.from_bits(imported_at) + relocation.addend
            } else {
                target = i64.from_bits(address_of(symbol, placed: placed.view())) + relocation.addend
            }
            mut segment.relocate(at: place, kind: relocation.kind, target, mut absolute)
        }
    }
    mut imported.sort_by(import_order)
    var linked = Linked(segments: take segments, symbols: take symbols, absolute: take absolute, imports: take imported, unallocated: take read_object.unallocated)
    mut linked.record_relocations(base, alloc)
    mut linked.record_extent(base)
    mut linked.record_segments(alloc)
    mut linked.absolute.sort_by(fn(left: u64, right: u64) => left.cmp(right))
    return linked
} link

/// Whether a symbol is one the object leaves undefined.
fn undefined(symbol: Symbol) -> bool = symbol.section.is_none() and not symbol.name.is_empty()

/// The address an undefined symbol's relocation reaches: the import stub of a function the
/// object calls, which `stubs` begin, or the import address table's word of a Windows image's
/// import; none for a bundle's import, which its loader resolves.
fn import_target(called: mem::List[text::String], table: mem::Map[text::String, u64], name: Str, stubs: u64) -> Option[u64] {
    match called.position(fn(known: text::String) => known.as_str() == name) {
        Some(stub) => return Some(stubs + u64.widen(stub) * IMPORT_STUB_BYTES)
        None => {}
    }
    return table.get_by(fn(key: text::String) => key.as_str().cmp(name))
} import_target

/// Lays out a Windows image's import address table at `at`, after its other segments: the words
/// of each library's functions, which a zero word ends, each recorded in `imported` with its
/// library and in `table` by the symbol naming it; gives the table's segment.
fn import_table(read_object: Object, at: u64, mut imported: mem::List[Import], mut table: mem::Map[text::String, u64], alloc: mem::Alloc) -> Segment {
    let named = table_imports(read_object, alloc)
    var word = at
    for index in 0..<named.len() {
        if index > 0 and named[index - 1].library != named[index].library {
            word += 8
        }
        var name = text::String.of(named[index].library.as_str(), alloc)
        mut name.append("!")
        mut name.append(named[index].function.as_str())
        mut imported.push(Import(address: word, name: take name))
        discard mut table.insert(text::String.of(named[index].symbol.as_str(), alloc), value: word)
        word += 8
    }
    let words = word + 8 - at
    var zeros = mem::Bytes.empty(alloc)
    object::resize(mut zeros, length: usize.widen(words))
    return Segment(address: at, access: Access.Write, bytes: take zeros, size: words)
} import_table

/// The names of the undefined symbols an object calls, in the order of their first calls.
fn called_imports(read_object: Object, alloc: mem::Alloc) -> mem::List[text::String] {
    var called = mem::List[text::String].empty(alloc)
    for section in read_object.sections {
        for relocation in section.relocations {
            expect relocation.symbol < read_object.symbols.len()
            let symbol = read_object.symbols[relocation.symbol]
            let calls = relocation.kind == PC32 or relocation.kind == PLT32
            if undefined(symbol) and calls and called.position(fn(name: text::String) => name == symbol.name).is_none() {
                mut called.push(text::String.of(symbol.name.as_str(), alloc))
            }
        }
    }
    return called
} called_imports

/// The functions a Windows image imports through the relocations of its object, each once, in
/// the order of their libraries, names and symbols.
fn table_imports(read_object: Object, alloc: mem::Alloc) -> mem::List[Named] {
    var named = mem::List[Named].empty(alloc)
    for section in read_object.sections {
        for relocation in section.relocations {
            expect relocation.symbol < read_object.symbols.len()
            let symbol = read_object.symbols[relocation.symbol]
            if not undefined(symbol) or named.position(fn(known: Named) => known.symbol == symbol.name).is_some() {
                continue
            }
            let whole = symbol.name.as_str()
            expect whole.starts_with(IMPORT_PREFIX)
            let Some(import) = whole.slice_bytes(IMPORT_PREFIX.byte_len(), end: whole.byte_len()) else {
                expect false
                continue
            }
            var library = text::String.of(KERNEL32, alloc)
            var function = text::String.of(import, alloc)
            match import.find("!") {
                Some(split) => {
                    let Some(head) = import.slice_bytes(0, end: split) else {
                        expect false
                        continue
                    }
                    let Some(tail) = import.slice_bytes(split + 1, end: import.byte_len()) else {
                        expect false
                        continue
                    }
                    library = text::String.of(head, alloc)
                    function = text::String.of(tail, alloc)
                }
                None => {}
            }
            mut named.push(Named(library: take library, function: take function, symbol: text::String.of(whole, alloc)))
        }
    }
    mut named.sort_by(named_order)
    return named
} table_imports

fn named_order(left: Named, right: Named) -> core::Ordering {
    let library = left.library.as_str().cmp(right.library.as_str())
    if library != core::Ordering.Equal {
        return library
    }
    let function = left.function.as_str().cmp(right.function.as_str())
    if function != core::Ordering.Equal {
        return function
    }
    return left.symbol.as_str().cmp(right.symbol.as_str())
} named_order

fn import_order(left: Import, right: Import) -> core::Ordering {
    if left.address != right.address {
        return left.address.cmp(right.address)
    }
    return left.name.as_str().cmp(right.name.as_str())
} import_order

/// Adds the segment of an access at an address when it holds any section, its sections of
/// zeros after the others and a code segment's `stubs` import stubs after its code, returning the
/// address of the next segment.
fn add_segment(mut segments: mem::List[Segment], mut placed: mem::List[Option[u64]], sections: Slice[ObjectSection], address: u64, access: Access, stubs: u64, alloc: mem::Alloc) -> u64 {
    var segment = Segment(address: address, access: access, bytes: mem::Bytes.empty(alloc), size: 0)
    match access {
        Access.Execute => place_kind(mut segment, mut placed, sections, kind: Kind.Text)
        Access.Read => place_kind(mut segment, mut placed, sections, kind: Kind.ReadOnly)
        Access.Write => {
            place_kind(mut segment, mut placed, sections, kind: Kind.Data)
            place_kind(mut segment, mut placed, sections, kind: Kind.Zeroed)
        }
    }
    if stubs > 0 {
        object::resize(mut segment.bytes, length: usize.widen(next_multiple_of(segment.size, multiple: IMPORT_STUB_BYTES)))
        for _ in 0..<stubs {
            mut segment.bytes.append(IMPORT_STUB)
            for _ in 0..<8usize {
                mut segment.bytes.push(0)
            }
        }
        segment.size = u64.widen(segment.bytes.len())
    }
    if segment.size == 0 {
        return address
    }
    let next = next_multiple_of(segment.address + segment.size, multiple: PAGE)
    mut segments.push(take segment)
    return next
} add_segment

/// Places the sections of a kind at the end of a segment, at their alignments, recording their
/// addresses.
fn place_kind(mut segment: Segment, mut placed: mem::List[Option[u64]], sections: Slice[ObjectSection], kind: Kind) {
    for index in 0..<sections.len() {
        invariant placed.len() == sections.len()
        let section = sections[index]
        if section.kind != kind {
            continue
        }
        let offset = next_multiple_of(segment.size, multiple: section.align)
        placed[index] = Some(segment.address + offset)
        segment.size = offset + section.size
        if kind != Kind.Zeroed {
            object::resize(mut segment.bytes, length: usize.widen(offset))
            mut segment.bytes.append(section.data.view())
        }
    }
} place_kind

/// The address a symbol defined in a placed section has.
fn address_of(symbol: Symbol, placed: Slice[Option[u64]]) -> u64 {
    let Some(section) = symbol.section else {
        expect false
        return 0
    }
    expect section < placed.len()
    let Some(start) = placed[section] else {
        expect false
        return 0
    }
    return start + symbol.value
} address_of

/// Writes the value a relocation computes from its target at an address of the segment,
/// recording an absolute address written.
fn Segment.relocate(mut self, at: u64, kind: u32, target: i64, mut absolute: mem::List[u64]) {
    expect self.contains(at)
    let offset = usize.widen(at - self.address)
    let relative = target - i64.from_bits(at)
    var bytes = mut self.bytes.view_mut()
    match kind {
        ABS64 or A64_ABS64 => {
            mut bytes.write_u64_le(offset, value: target.to_bits())
            mut absolute.push(at)
        }
        PC32 or PLT32 => {
            let Some(displacement) = i32.checked_fit(relative) else {
                expect false
                return
            }
            mut bytes.write_u32_le(offset, value: displacement.to_bits())
        }
        A64_CALL26 => {
            // The branch's 26-bit field holds the instruction count to the target.
            let count = relative.div_trunc(4)
            expect count >= -(1 << 25) and count < (1 << 25)
            patch_a64(mut bytes, offset: offset, field: 0x03FF_FFFF, value: u32.truncate(count.to_bits()))
        }
        A64_ADR_PREL_PG_HI21 => {
            // The address of the 4 KiB page the target lies in, relative to the page the
            // instruction lies in, in units of pages, held in the split immediate.
            let pages = ((target & ~0xFFF) - i64.from_bits(at & ~0xFFF)).div_trunc(1 << 12)
            expect pages >= -(1 << 20) and pages < (1 << 20)
            let value = u32.truncate(pages.to_bits())
            patch_a64(mut bytes, offset: offset, field: 0x6000_0000, value: value << 29)
            patch_a64(mut bytes, offset: offset, field: 0x00FF_FFE0, value: (value >> 2) << 5)
        }
        A64_ADD_ABS_LO12_NC => {
            // The target's low 12 bits, added to the page the previous instruction formed.
            let low = u32.truncate((target & 0xFFF).to_bits())
            patch_a64(mut bytes, offset: offset, field: 0x003F_FC00, value: low << 10)
        }
        else => {
            expect false
        }
    }
} Segment.relocate
