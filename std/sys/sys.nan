    pub operations: mem::List[OperationSchema]
} ProtocolSchema

pub closed struct OperationSchema derives Encode {
    pub name: text::String
    pub class: Reversibility
    pub parameters: mem::List[ParameterSchema]
    pub result: Option[TypeSchema]
    pub failure: Option[TypeSchema]
} OperationSchema

pub closed enum Reversibility derives Copy, Eq, Encode {
    Traceless
    Recorded
    Restorable
    Irreversible(emit: bool, actuate: bool, erase: bool, spend: bool)
} Reversibility

pub closed struct ParameterSchema derives Encode {
    pub name: text::String
    pub value: TypeSchema
} ParameterSchema

pub closed enum TypeSchema derives Encode {
    Encoded(mem::wire::Schema)
    Handle(Array[u8, 33])
    Record(mem::List[FieldSchema])
} TypeSchema

pub closed struct FieldSchema derives Encode {
    pub name: text::String
    pub value: PartSchema
} FieldSchema

pub closed enum PartSchema derives Encode {
    Encoded(mem::wire::Schema)
    Handle(Array[u8, 33])
} PartSchema

pub fn ProtocolSchema.serves(self, client: ProtocolSchema, operation: Str, alloc: mem::Alloc) -> bool
    example Wire[Meter].schema(testing::world().alloc).serves(Wire[MeterSpare].schema(testing::world().alloc), operation: "clear", alloc: testing::world().alloc)
{
    let Some(offered) = self.operations.position(fn(held: OperationSchema) => held.name.as_str() == operation) else {
        return false
    }
    if self.hash == client.hash {
        return true
    }
    let Some(called) = client.operations.position(fn(held: OperationSchema) => held.name.as_str() == operation) else {
        return false
    }
    return self.operations[offered].serves(client.operations[called], alloc)
} ProtocolSchema.serves

pub fn ProtocolSchema.serves_call(self, hash: ProtocolHash, peers: Slice[ProtocolSchema], operation: Str, alloc: mem::Alloc) -> bool {
    if hash == self.hash {
        return self.serves(self, operation, alloc)
    }
    for peer in peers {
        if peer.hash == hash {
            return self.serves(peer, operation, alloc)
        }
    }
    return false
} ProtocolSchema.serves_call

/// Whether this operation reads each call `call` makes and `call` reads each reply it gives.
fn OperationSchema.serves(self, call: OperationSchema, alloc: mem::Alloc) -> bool {
    if self.parameters.len() != call.parameters.len() {
        return false
    }
    for parameter in self.parameters {
        let Some(at) = call.parameters.position(fn(sent: ParameterSchema) => sent.name == parameter.name) else {
            return false
        }
        if not parameter.value.accepts(call.parameters[at].value, alloc) {
            return false
        }
    }
    let replied = match self.result {
        None => call.result.is_none()
        Some(result) => match call.result {
            Some(read) => read.accepts(result, alloc)
            None => false
        }
    }
    return replied and match self.failure {
        None => true
        Some(failure) => match call.failure {
            Some(read) => read.accepts(failure, alloc)
            None => false
        }
    }
} OperationSchema.serves

/// Whether values of this type schema decode from the encodings of `old`'s.
fn TypeSchema.accepts(self, old: TypeSchema, alloc: mem::Alloc) -> bool {
    return match self {
        TypeSchema.Encoded(tree) => match old {
            TypeSchema.Encoded(held) => tree.accepts(held, alloc)
            else => false
        }
        TypeSchema.Handle(hash) => match old {
            TypeSchema.Handle(held) => hash == held
            else => false
        }
        TypeSchema.Record(fields) => match old {
            TypeSchema.Record(held) => fields_accept(fields, old: held, alloc)
            else => false
        }
    }
} TypeSchema.accepts

/// Whether the fields of a record schema decode from the encodings of `old`'s: the same names,
/// each field's part schema accepting the old one of its name.
fn fields_accept(fields: mem::List[FieldSchema], old: mem::List[FieldSchema], alloc: mem::Alloc) -> bool {
    if fields.len() != old.len() {
        return false
    }
    for field in fields {
        let Some(at) = old.position(fn(held: FieldSchema) => held.name == field.name) else {
            return false
        }
        if not field.value.accepts(old[at].value, alloc) {
            return false
        }
    }
    return true
} fields_accept

/// Whether values of this part schema decode from the encodings of `old`'s.
fn PartSchema.accepts(self, old: PartSchema, alloc: mem::Alloc) -> bool {
    return match self {
        PartSchema.Encoded(tree) => match old {
            PartSchema.Encoded(held) => tree.accepts(held, alloc)
            PartSchema.Handle(_) => false
        }
        PartSchema.Handle(hash) => match old {
            PartSchema.Handle(held) => hash == held
            PartSchema.Encoded(_) => false
        }
    }
} PartSchema.accepts

pub open struct Reply[R: Send, E: Send] {
} Reply

pub fn Reply.decode(self, raw: Untrusted[Slice[u8]], handles: Slice[Handle], alloc: mem::Alloc) -> R fails CallError[E]
    example keeps_clock(testing::world().clock, alloc: testing::world().alloc)

