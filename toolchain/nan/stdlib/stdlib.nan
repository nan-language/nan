//! The std packages the toolchain carries: the source files of the `std` directory.

/// A std package: those std aliases name, in layer order, then the platform packages, which no
/// alias names.
pkg enum StdPackage derives Copy, Eq, Hash {
    Core
    Mem
    Text
    Task
    Sys
    Hw
    Boot
    Host
    Testing
    HostPlatform
    UefiPlatform
    BarePlatform
} StdPackage

pkg proj fn StdPackage.name(self) -> Str {
    return match self {
        StdPackage.Core => "core"
        StdPackage.Mem => "mem"
        StdPackage.Text => "text"
        StdPackage.Task => "task"
        StdPackage.Sys => "sys"
        StdPackage.Hw => "hw"
        StdPackage.Boot => "boot"
        StdPackage.Host => "host"
        StdPackage.Testing => "testing"
        StdPackage.HostPlatform => "host_platform"
        StdPackage.UefiPlatform => "uefi_platform"
        StdPackage.BarePlatform => "bare_platform"
    }
} StdPackage.name

/// The std package a package name names.
pkg fn StdPackage.named(name: Str) -> Option[StdPackage] {
    return match name {
        "core" => Some(StdPackage.Core)
        "mem" => Some(StdPackage.Mem)
        "text" => Some(StdPackage.Text)
        "task" => Some(StdPackage.Task)
        "sys" => Some(StdPackage.Sys)
        "hw" => Some(StdPackage.Hw)
        "boot" => Some(StdPackage.Boot)
        "host" => Some(StdPackage.Host)
        "testing" => Some(StdPackage.Testing)
        "host_platform" => Some(StdPackage.HostPlatform)
        "uefi_platform" => Some(StdPackage.UefiPlatform)
        "bare_platform" => Some(StdPackage.BarePlatform)
        else => None
    }
} StdPackage.named

/// The std packages that std aliases name, in layer order.
pkg const PACKAGES: Array[StdPackage, 9] = aliased_packages()

fn aliased_packages() -> Array[StdPackage, 9] {
    var aliased = Array[StdPackage, 9].filled(StdPackage.Core)
    aliased[1] = StdPackage.Mem
    aliased[2] = StdPackage.Text
    aliased[3] = StdPackage.Task
    aliased[4] = StdPackage.Sys
    aliased[5] = StdPackage.Hw
    aliased[6] = StdPackage.Boot
    aliased[7] = StdPackage.Host
    aliased[8] = StdPackage.Testing
    return aliased
} aliased_packages

/// The platform packages, which no alias names.
pkg const PLATFORMS: Array[StdPackage, 3] = platform_packages()

fn platform_packages() -> Array[StdPackage, 3] {
    var held = Array[StdPackage, 3].filled(StdPackage.HostPlatform)
    held[1] = StdPackage.UefiPlatform
    held[2] = StdPackage.BarePlatform
    return held
} platform_packages

/// Whether a package name is a std package's.
pkg fn is_std(name: Str) -> bool {
    return StdPackage.named(name).is_some()
} is_std
