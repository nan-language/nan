//! The construction text that derived `Render` writes.

pub open struct Codec[T: Encode] {
} Codec

pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    example attempt Codec[Option[i16]].decode(Untrusted.of(b" Some(-1_200) "), alloc: testing::world().alloc) == Ok(Some(-1_200))
    example attempt Codec[mem::List[u8]].decode(Untrusted.of(b"[1, 2,]"), alloc: testing::world().alloc) == Err(core::DecodeError.Malformed)
    example attempt Codec[char].decode(Untrusted.of(b"'\\u{D800}'"), alloc: testing::world().alloc) == Err(core::DecodeError.InvalidText)

test decode_reads_text_literals for Codec.decode {
    let escaped = attempt Codec[text::Fixed[4]].decode(Untrusted.of(b"\"a\\\"\\u{E9}\""), alloc: testing::world().alloc)
    let byte = attempt Codec[text::Fixed[4]].decode(Untrusted.of(b"\"\\x41\""), alloc: testing::world().alloc)
    expect escaped == Ok(text::Fixed[4].of("a\"é"))
    expect byte == Ok(text::Fixed[4].of("A"))
} decode_reads_text_literals


/// A position in the bytes being read and the end of the part read there.
struct Cursor {
    at: usize
    end: usize
} Cursor

/// The node a `Back` node at depth `depth` names among the record and variant nodes enclosing
/// it, innermost last.
fn back_target(enclosing: Slice[usize], depth: u64) -> usize fails core::DecodeError {
    let count = enclosing.len()
    if depth == 0 or usize.widen(depth) > count {
        fail core::DecodeError.Malformed
    }
    return enclosing[count - usize.widen(depth)]
} back_target

/// The position in `names` of the name a named schema gives the node at `at`, if any.
fn name_index(schema: mem::wire::NamedSchema, at: usize) -> Option[usize] {
    return schema.names.position(fn(name: mem::wire::SchemaName) => name.node == at)
} name_index

/// Appends the last segment of a canonical path.
fn append_last_segment(mut out: text::String, path: Str) {
    let bytes = path.as_bytes()
    var start: usize = 0
    for at in 0..<bytes.len() {
        if bytes[at] == 58 {
            start = at + 1
        }
    }
    match path.slice_bytes(start, end: path.byte_len()) {
        Some(segment) => mut out.append(segment)
        None => mut out.append(path)
    }
} append_last_segment

fn take_byte(bytes: Slice[u8], mut at: Cursor) -> u8 fails core::DecodeError {
    if at.at >= at.end {
        fail core::DecodeError.Truncated
    }
    let byte = bytes[at.at]
    at.at += 1
    return byte
} take_byte

/// A uvar: LEB128, minimal, at most 2^64 - 1.
fn take_uvar(bytes: Slice[u8], mut at: Cursor) -> u64 fails core::DecodeError {
    var value: u64 = 0
    var shift: u32 = 0
    loop {
        let byte = try take_byte(bytes, at: mut at)
        let low = u64.widen(byte & 0x7F)
        if shift > 63 or (shift == 63 and low > 1) {
            fail core::DecodeError.Malformed
        }
        value = value | (low << shift)
        if (byte & 0x80) == 0 {
            if byte == 0 and shift > 0 {
                fail core::DecodeError.Malformed
            }
            return value
        }
        shift += 7
    }
} take_uvar

/// A copy of the next `len` bytes, the cursor moved past them.
fn take_copy(bytes: Slice[u8], mut at: Cursor, len: u64, alloc: mem::Alloc) -> mem::Bytes fails core::DecodeError {
    if len > u64.widen(at.end - at.at) {
        fail core::DecodeError.Truncated
    }
    var copy = mem::Bytes.empty(alloc)
    for index in 0..<usize.widen(len) {
        mut copy.push(bytes[at.at + index])
    }
    at.at += usize.widen(len)
    return copy
} take_copy

fn put_uvar(mut out: mem::Bytes, value: u64) {
    var rest = value
    while rest >= 0x80 {
        mut out.push(u8.truncate(rest) | 0x80)
        rest = rest >> 7
    }
    mut out.push(u8.truncate(rest))
} put_uvar

fn put_text(mut out: mem::Bytes, value: Slice[u8]) {
    put_uvar(mut out, value: u64.widen(value.len()))
    mut out.append(value)
} put_text

/// A leaf value written as `write_nested` writes it.
enum Leaf {
    Unsigned(u64)
    Signed(i64)
    Single(f32)
    Double(f64)
    Character(char)
    Words(text::String)
    Octets(mem::Bytes)
} Leaf

impl Leaf: Render

fn Leaf.render(self, mut out: core::Renderer) {
    match self {
        Leaf.Unsigned(value) => mut out.write_nested(value)
        Leaf.Signed(value) => mut out.write_nested(value)
        Leaf.Single(value) => mut out.write_nested(value)
        Leaf.Double(value) => mut out.write_nested(value)
        Leaf.Character(value) => mut out.write_nested(value)
        Leaf.Words(value) => mut out.write_nested(value)
        Leaf.Octets(value) => mut out.write_nested(value)
    }
} Leaf.render

fn write_leaf(mut out: text::String, take leaf: Leaf) {
    mut out.write(Dyn[Render].view(leaf), budget: ~0usize)
} write_leaf

pub validator fn render_as(schema: mem::wire::NamedSchema, raw: Untrusted[Slice[u8]], alloc: mem::Alloc, mut out: text::String) fails core::DecodeError {
    let bytes = raw.inspect()
    var at = Cursor(at: 0, end: bytes.len())
    var walk = Walk(enclosing: mem::List[usize].empty(alloc), depth: 0)
    var steps = mem::List[RenderStep].empty(alloc)
    mut steps.push(RenderStep.Node(0))
    while true {
        let Some(step) = mut steps.pop() else {
            break
        }
        try render_step(schema, step, bytes, at: mut at, walk: mut walk, steps: mut steps, alloc, out: mut out)
    }
    if at.at != bytes.len() {
        fail core::DecodeError.Trailing
    }
} render_as

/// The nesting a walk of a schema tree is in: the record and variant nodes enclosing it, innermost
/// last, and how many sequences, maps, records and variants hold it.
struct Walk {
    enclosing: mem::List[usize]
    depth: usize
} Walk

/// Enters a sequence, map, record or variant, failing with `TooDeep` past 128 of them.
fn Walk.nest(mut self) fails core::DecodeError {
    if self.depth >= 128 {
        fail core::DecodeError.TooDeep
    }
    self.depth += 1
} Walk.nest

/// Closing text a rendering writes once the values before it are written.
enum Mark derives Copy {
    Bracket
    Brace
    Parenthesis
    Colon
} Mark

/// A step a rendering has left to take, the last one pushed taken first: a node to read, the
/// elements, entries or fields of a node still to read, text to write, the end of a field or
/// payload, which restores the end of what holds it, and the end of a node.
enum RenderStep derives Copy {
    Node(usize)
    Elements(element: usize, left: u64, leading: bool)
    Entries(key: usize, value: usize, left: u64, leading: bool)
    Fields(node: usize, left: u64, written: usize)
    Write(Mark)
    Close(end: usize, outer: usize)
    Leave(enclosed: bool)
} RenderStep

fn render_step(schema: mem::wire::NamedSchema, step: RenderStep, bytes: Slice[u8], mut at: Cursor, mut walk: Walk, mut steps: mem::List[RenderStep], alloc: mem::Alloc, mut out: text::String) fails core::DecodeError {
    match step {
        RenderStep.Node(node) => try render_node(schema, node, bytes, at: mut at, walk: mut walk, steps: mut steps, alloc, out: mut out)
        RenderStep.Elements(element: element, left: left, leading: leading) => {
            if left == 0 {
                return
            }
            if not leading {
                mut out.append(", ")
            }
            mut steps.push(RenderStep.Elements(element: element, left: left - 1, leading: false))
            mut steps.push(RenderStep.Node(element))
        }
        RenderStep.Entries(key: key, value: value, left: left, leading: leading) => {
            if left == 0 {
                return
            }
            if not leading {
                mut out.append(", ")
            }
            mut steps.push(RenderStep.Entries(key: key, value: value, left: left - 1, leading: false))
            mut steps.push(RenderStep.Node(value))
            mut steps.push(RenderStep.Write(Mark.Colon))
            mut steps.push(RenderStep.Node(key))
        }
        RenderStep.Fields(node: node, left: left, written: written) => try render_field(schema, node, left, written, bytes, at: mut at, steps: mut steps, alloc, out: mut out)
        RenderStep.Write(mark) => {
            match mark {
                Mark.Bracket => mut out.append("]")
                Mark.Brace => mut out.append("}")
                Mark.Parenthesis => mut out.append(")")
                Mark.Colon => mut out.append(": ")
            }
        }
        RenderStep.Close(end: end, outer: outer) => {
            if at.at != end {
                fail core::DecodeError.Malformed
            }
            at.end = outer
        }
        RenderStep.Leave(enclosed: enclosed) => {
            walk.depth -= 1
            if enclosed {
                discard mut walk.enclosing.pop()
            }
        }
    }
} render_step

/// Reads the node at `node`, writing a leaf and the opening text of any other node, and pushes
/// the steps that read the rest of it.
fn render_node(schema: mem::wire::NamedSchema, node: usize, bytes: Slice[u8], mut at: Cursor, mut walk: Walk, mut steps: mem::List[RenderStep], alloc: mem::Alloc, mut out: text::String) fails core::DecodeError {
    if node >= schema.tree.nodes.len() {
        fail core::DecodeError.Malformed
    }
    match schema.tree.nodes[node] {
        mem::wire::SchemaNode.Sequence(element: element, length: length, capacity: _, unique: _) => {
            try mut walk.nest()
            let count = try take_uvar(bytes, at: mut at)
            if length.is_some() and length != Some(count) {
                fail core::DecodeError.Malformed
            }
            mut out.append("[")
            mut steps.push(RenderStep.Leave(enclosed: false))
            mut steps.push(RenderStep.Write(Mark.Bracket))
            mut steps.push(RenderStep.Elements(element: element, left: count, leading: true))
        }
        mem::wire::SchemaNode.Map(key: key, value: value) => {
            try mut walk.nest()
            let count = try take_uvar(bytes, at: mut at)
            mut out.append("{")
            mut steps.push(RenderStep.Leave(enclosed: false))
            mut steps.push(RenderStep.Write(Mark.Brace))
            mut steps.push(RenderStep.Entries(key: key, value: value, left: count, leading: true))
        }
        mem::wire::SchemaNode.Record(open: _, fields: fields) => {
            try mut walk.nest()
            mut walk.enclosing.push(node)
            let named = name_index(schema, at: node)
            match named {
                Some(index) => {
                    append_last_segment(mut out, path: schema.names[index].path.as_str())
                    mut out.append("(")
                }
                None => {
                    if fields.len() == 0 {
                        mut out.append("Unit")
                    }
                }
            }
            let count = try take_uvar(bytes, at: mut at)
            mut steps.push(RenderStep.Leave(enclosed: true))
            if named.is_some() {
                mut steps.push(RenderStep.Write(Mark.Parenthesis))
            }
            mut steps.push(RenderStep.Fields(node: node, left: count, written: 0))
        }
        mem::wire::SchemaNode.Variant(open: _, variants: _) => {
            try mut walk.nest()
            mut walk.enclosing.push(node)
            mut steps.push(RenderStep.Leave(enclosed: true))
            try render_variant(schema, node, bytes, at: mut at, steps: mut steps, alloc, out: mut out)
        }
        mem::wire::SchemaNode.Back(depth: depth) => mut steps.push(RenderStep.Node(try back_target(walk.enclosing.view(), depth)))
        else => try render_leaf(schema.tree.nodes[node], bytes, at: mut at, alloc, out: mut out)
    }
} render_node

/// Writes the value of a node without children read from `bytes`.
fn render_leaf(node: mem::wire::SchemaNode, bytes: Slice[u8], mut at: Cursor, alloc: mem::Alloc, mut out: text::String) fails core::DecodeError {
    match node {
        mem::wire::SchemaNode.Bool => {
            match try take_byte(bytes, at: mut at) {
                0 => mut out.append("false")
                1 => mut out.append("true")
                else => fail core::DecodeError.Malformed
            }
        }
        mem::wire::SchemaNode.Unsigned(width: width) => {
            let value = try take_uvar(bytes, at: mut at)
            if width < 64 and (value >> u32.widen(width)) != 0 {
                fail core::DecodeError.OutOfRange
            }
            write_leaf(mut out, leaf: Leaf.Unsigned(value))
        }
        mem::wire::SchemaNode.Signed(width: _) => {
            let zigzag = try take_uvar(bytes, at: mut at)
            var value = i64.from_bits(zigzag >> 1)
            if (zigzag & 1) != 0 {
                value = -1 - value
            }
            write_leaf(mut out, leaf: Leaf.Signed(value))
        }
        mem::wire::SchemaNode.Float(width: width) => {
            let held = try take_copy(bytes, at: mut at, len: 8, alloc)
            let raw = Untrusted.of(held.view())
            if width == 32 {
                write_leaf(mut out, leaf: Leaf.Single(try mem::wire::Codec[f32].decode(raw, alloc)))
            } else {
                write_leaf(mut out, leaf: Leaf.Double(try mem::wire::Codec[f64].decode(raw, alloc)))
            }
        }
        mem::wire::SchemaNode.Char => {
            let scalar = try take_uvar(bytes, at: mut at)
            if scalar > 0x10_FFFF {
                fail core::DecodeError.InvalidText
            }
            let Some(value) = char.checked_from_bits(u32.truncate(scalar)) else {
                fail core::DecodeError.InvalidText
            }
            write_leaf(mut out, leaf: Leaf.Character(value))
        }
        mem::wire::SchemaNode.Text or mem::wire::SchemaNode.BoundedText(capacity: _) => {
            let len = try take_uvar(bytes, at: mut at)
            let held = try take_copy(bytes, at: mut at, len, alloc)
            let Ok(value) = attempt text::String.try_from_utf8(held.view(), alloc) else {
                fail core::DecodeError.InvalidText
            }
            write_leaf(mut out, leaf: Leaf.Words(take value))
        }
        mem::wire::SchemaNode.Bytes => {
            let len = try take_uvar(bytes, at: mut at)
            write_leaf(mut out, leaf: Leaf.Octets(try take_copy(bytes, at: mut at, len, alloc)))
        }
        else => fail core::DecodeError.Malformed
    }
} render_leaf

/// Reads the next field of a record still to read, of `left`: writes `key: ` unless its record
/// does not declare it, which an open record skips, and pushes the steps reading its value and
/// the fields after it.
fn render_field(schema: mem::wire::NamedSchema, node: usize, left: u64, written: usize, bytes: Slice[u8], mut at: Cursor, mut steps: mem::List[RenderStep], alloc: mem::Alloc, mut out: text::String) fails core::DecodeError {
    let mem::wire::SchemaNode.Record(open: open, fields: fields) = schema.tree.nodes[node] else {
        fail core::DecodeError.Malformed
    }
    var remaining = left
    while remaining > 0 {
        let key_len = try take_uvar(bytes, at: mut at)
        let key = try take_copy(bytes, at: mut at, len: key_len, alloc)
        let len = try take_uvar(bytes, at: mut at)
        if len > u64.widen(at.end - at.at) {
            fail core::DecodeError.Truncated
        }
        let end = at.at + usize.widen(len)
        remaining -= 1
        let Some(index) = fields.position(fn(field: mem::wire::SchemaField) => field.key.as_bytes() == key.view()) else {
            if not open {
                fail core::DecodeError.UnknownKey
            }
            at.at = end
            continue
        }
        if written > 0 {
            mut out.append(", ")
        }
        mut out.append(fields[index].key.as_str())
        mut out.append(": ")
        mut steps.push(RenderStep.Fields(node: node, left: remaining, written: written + 1))
        mut steps.push(RenderStep.Close(end: end, outer: at.end))
        at.end = end
        mut steps.push(RenderStep.Node(fields[index].value))
        return
    }
} render_field

/// Writes a variant read from `bytes`: the name of its enum, `.` and its key, without the name
/// for `Option` and `Result`, then pushes the steps reading its payload in parentheses.
fn render_variant(schema: mem::wire::NamedSchema, node: usize, bytes: Slice[u8], mut at: Cursor, mut steps: mem::List[RenderStep], alloc: mem::Alloc, mut out: text::String) fails core::DecodeError {
    let mem::wire::SchemaNode.Variant(open: _, variants: variants) = schema.tree.nodes[node] else {
        fail core::DecodeError.Malformed
    }
    let key_len = try take_uvar(bytes, at: mut at)
    let key = try take_copy(bytes, at: mut at, len: key_len, alloc)
    let Some(index) = variants.position(fn(variant: mem::wire::SchemaVariant) => variant.key.as_bytes() == key.view()) else {
        fail core::DecodeError.UnknownVariant
    }
    match name_index(schema, at: node) {
        Some(named) => {
            let path = schema.names[named].path.as_str()
            if path != "core::Option" and path != "core::Result" {
                append_last_segment(mut out, path)
                mut out.append(".")
            }
        }
        None => {}
    }
    mut out.append(variants[index].key.as_str())
    match try take_byte(bytes, at: mut at) {
        0 => {
            if variants[index].payload.is_some() {
                fail core::DecodeError.Malformed
            }
        }
        1 => {
            let Some(payload) = variants[index].payload else {
                fail core::DecodeError.Malformed
            }
            let len = try take_uvar(bytes, at: mut at)
            if len > u64.widen(at.end - at.at) {
                fail core::DecodeError.Truncated
            }
            let end = at.at + usize.widen(len)
            mut out.append("(")
            mut steps.push(RenderStep.Close(end: end, outer: at.end))
            mut steps.push(RenderStep.Write(Mark.Parenthesis))
            at.end = end
            mut steps.push(RenderStep.Node(payload))
        }
        else => fail core::DecodeError.Malformed
    }
} render_variant

pub validator fn encode_as(schema: mem::wire::NamedSchema, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes fails core::DecodeError {
    let text = raw.inspect()
    var at = Cursor(at: 0, end: text.len())
    var walk = Walk(enclosing: mem::List[usize].empty(alloc), depth: 0)
    var frames = mem::List[Frame].empty(alloc)
    var out = mem::Bytes.empty(alloc)
    var next: Option[usize] = Some(0)
    while true {
        match next {
            Some(node) => {
                next = try encode_node(schema, node, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
            }
            None => {
                if frames.len() == 0 {
                    break
                }
                next = try encode_resume(schema, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
            }
        }
    }
    skip_space(text, at: mut at)
    if at.at != text.len() {
        fail core::DecodeError.Trailing
    }
    return out
} encode_as

/// Where the reading of a sequence, map, record or variant is: between elements, after an entry's
/// key or value, among the fields of a record or labelled payload, read with parentheses or not,
/// or in a payload.
enum Phase derives Copy, Eq {
    Elements
    Keys
    Values
    Fields(parenthesized: bool)
    Payload
} Phase

/// A sequence, map, record or variant whose construction text is being read: its node, where its
/// reading is, the count of its elements or entries read, the encodings of what it read, by field
/// for a record, the fields present, the field or variant read, and whether a value of it is
/// being read.
struct Frame {
    node: usize
    phase: Phase
    count: u64
    out: mem::Bytes
    values: mem::List[mem::Bytes]
    present: mem::List[bool]
    chosen: usize
    reading: bool
} Frame

/// Enters a frame reading the node at `node` in `phase`, with room for the fields of a record.
fn enter(mut walk: Walk, mut frames: mem::List[Frame], schema: mem::wire::NamedSchema, node: usize, phase: Phase, alloc: mem::Alloc) fails core::DecodeError {
    try mut walk.nest()
    var values = mem::List[mem::Bytes].empty(alloc)
    var present = mem::List[bool].empty(alloc)
    match schema.tree.nodes[node] {
        mem::wire::SchemaNode.Record(open: _, fields: fields) => {
            for _ in fields {
                mut values.push(mem::Bytes.empty(alloc))
                mut present.push(false)
            }
        }
        else => {}
    }
    mut frames.push(Frame(node: node, phase: phase, count: 0, out: mem::Bytes.empty(alloc), values: take values, present: take present, chosen: 0, reading: false))
} enter

/// Appends bytes to the encoding of what the innermost frame reads, or to `out` outside every
/// frame.
fn emit(mut frames: mem::List[Frame], mut out: mem::Bytes, bytes: Slice[u8]) {
    let count = frames.len()
    if count == 0 {
        mut out.append(bytes)
        return
    }
    let top = count - 1
    match frames[top].phase {
        Phase.Fields(parenthesized: _) => {
            let chosen = frames[top].chosen
            mut frames[top].values[chosen].append(bytes)
        }
        else => mut frames[top].out.append(bytes)
    }
} emit

/// Leaves the innermost frame, whose encoding `encoded` is, appending it to what holds it.
fn leave(mut walk: Walk, mut frames: mem::List[Frame], mut out: mem::Bytes, encoded: Slice[u8]) {
    discard mut frames.pop()
    walk.depth -= 1
    emit(mut frames, mut out, bytes: encoded)
} leave

/// Starts reading the node at `node`: encodes a leaf, or enters a frame for any other node, and
/// gives the node of the value to read next, none when the innermost frame goes on.
fn encode_node(schema: mem::wire::NamedSchema, node: usize, text: Slice[u8], mut at: Cursor, mut walk: Walk, mut frames: mem::List[Frame], alloc: mem::Alloc, mut out: mem::Bytes) -> Option[usize] fails core::DecodeError {
    if node >= schema.tree.nodes.len() {
        fail core::DecodeError.Malformed
    }
    match schema.tree.nodes[node] {
        mem::wire::SchemaNode.Sequence(element: element, length: _, capacity: _, unique: _) => {
            try expect_byte(text, at: mut at, byte: 91)
            try enter(mut walk, frames: mut frames, schema, node, phase: Phase.Elements, alloc)
            if peek(text, at: mut at) == Some(93) {
                return None
            }
            frames[frames.len() - 1].reading = true
            return Some(element)
        }
        mem::wire::SchemaNode.Map(key: key, value: _) => {
            try expect_byte(text, at: mut at, byte: 123)
            try enter(mut walk, frames: mut frames, schema, node, phase: Phase.Keys, alloc)
            if peek(text, at: mut at) == Some(125) {
                return None
            }
            frames[frames.len() - 1].reading = true
            return Some(key)
        }
        mem::wire::SchemaNode.Record(open: _, fields: _) => {
            if word_next(text, at: mut at) {
                discard try take_word(text, at: mut at, alloc)
            }
            let parenthesized = peek(text, at: mut at) == Some(40)
            if parenthesized {
                at.at += 1
            }
            try enter(mut walk, frames: mut frames, schema, node, phase: Phase.Fields(parenthesized: parenthesized), alloc)
            mut walk.enclosing.push(node)
            return try next_field(schema, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
        }
        mem::wire::SchemaNode.Variant(open: _, variants: _) => return try encode_variant(schema, node, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
        mem::wire::SchemaNode.Back(depth: depth) => return Some(try back_target(walk.enclosing.view(), depth))
        else => {
            var leaf = mem::Bytes.empty(alloc)
            try encode_leaf(schema.tree.nodes[node], text, at: mut at, alloc, out: mut leaf)
            emit(mut frames, mut out, bytes: leaf.view())
            return None
        }
    }
} encode_node

/// Goes on reading the innermost frame once the value it was reading, if any, is read: gives the
/// node of its next value, or leaves it at its end and gives none.
fn encode_resume(schema: mem::wire::NamedSchema, text: Slice[u8], mut at: Cursor, mut walk: Walk, mut frames: mem::List[Frame], alloc: mem::Alloc, mut out: mem::Bytes) -> Option[usize] fails core::DecodeError {
    let top = frames.len() - 1
    let reading = frames[top].reading
    frames[top].reading = false
    match frames[top].phase {
        Phase.Elements => return try next_element(schema, text, at: mut at, walk: mut walk, frames: mut frames, reading, alloc, out: mut out)
        Phase.Keys or Phase.Values => return try next_entry(schema, text, at: mut at, walk: mut walk, frames: mut frames, reading, alloc, out: mut out)
        Phase.Fields(parenthesized: _) => {
            if reading and peek(text, at: mut at) != Some(44) {
                return try fields_end(schema, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
            }
            if reading {
                at.at += 1
            }
            return try next_field(schema, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
        }
        Phase.Payload => return try payload_end(schema, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
    }
} encode_resume

/// Goes on reading the innermost frame's sequence after an element, if `reading` one: gives the
/// node of the next element, or ends the sequence.
fn next_element(schema: mem::wire::NamedSchema, text: Slice[u8], mut at: Cursor, mut walk: Walk, mut frames: mem::List[Frame], reading: bool, alloc: mem::Alloc, mut out: mem::Bytes) -> Option[usize] fails core::DecodeError {
    let top = frames.len() - 1
    let mem::wire::SchemaNode.Sequence(element: element, length: length, capacity: capacity, unique: _) = schema.tree.nodes[frames[top].node] else {
        fail core::DecodeError.Malformed
    }
    if reading {
        frames[top].count += 1
        if peek(text, at: mut at) == Some(44) {
            at.at += 1
            frames[top].reading = true
            return Some(element)
        }
    }
    try expect_byte(text, at: mut at, byte: 93)
    let count = frames[top].count
    if length.is_some() and length != Some(count) {
        fail core::DecodeError.OutOfRange
    }
    match capacity {
        Some(limit) => {
            if count > limit {
                fail core::DecodeError.OutOfRange
            }
        }
        None => {}
    }
    var encoded = mem::Bytes.empty(alloc)
    put_uvar(mut encoded, value: count)
    mut encoded.append(frames[top].out.view())
    leave(mut walk, frames: mut frames, mut out, encoded: encoded.view())
    return None
} next_element

/// Goes on reading the innermost frame's map after a key or a value, if `reading` one: gives the
/// node of the value of the key read, of the next key, or ends the map.
fn next_entry(schema: mem::wire::NamedSchema, text: Slice[u8], mut at: Cursor, mut walk: Walk, mut frames: mem::List[Frame], reading: bool, alloc: mem::Alloc, mut out: mem::Bytes) -> Option[usize] fails core::DecodeError {
    let top = frames.len() - 1
    let mem::wire::SchemaNode.Map(key: key, value: value) = schema.tree.nodes[frames[top].node] else {
        fail core::DecodeError.Malformed
    }
    if reading and frames[top].phase == Phase.Keys {
        try expect_byte(text, at: mut at, byte: 58)
        frames[top].phase = Phase.Values
        frames[top].reading = true
        return Some(value)
    }
    if reading {
        frames[top].count += 1
        frames[top].phase = Phase.Keys
        if peek(text, at: mut at) == Some(44) {
            at.at += 1
            frames[top].reading = true
            return Some(key)
        }
    }
    try expect_byte(text, at: mut at, byte: 125)
    var encoded = mem::Bytes.empty(alloc)
    put_uvar(mut encoded, value: frames[top].count)
    mut encoded.append(frames[top].out.view())
    leave(mut walk, frames: mut frames, mut out, encoded: encoded.view())
    return None
} next_entry

/// Ends the innermost frame's variant once its payload is read: its key, then its payload framed.
fn payload_end(schema: mem::wire::NamedSchema, text: Slice[u8], mut at: Cursor, mut walk: Walk, mut frames: mem::List[Frame], alloc: mem::Alloc, mut out: mem::Bytes) -> Option[usize] fails core::DecodeError {
    let top = frames.len() - 1
    let mem::wire::SchemaNode.Variant(open: _, variants: variants) = schema.tree.nodes[frames[top].node] else {
        fail core::DecodeError.Malformed
    }
    try expect_byte(text, at: mut at, byte: 41)
    var encoded = mem::Bytes.empty(alloc)
    put_text(mut encoded, value: variants[frames[top].chosen].key.as_bytes())
    mut encoded.push(1)
    put_text(mut encoded, value: frames[top].out.view())
    discard mut walk.enclosing.pop()
    leave(mut walk, frames: mut frames, mut out, encoded: encoded.view())
    return None
} payload_end

/// Reads the key of the next field of the innermost frame's record, each `key: value` up to the
/// closing parenthesis or the end, aliases read as their keys and fields an open type does not
/// declare skipped: gives the node of its value, or ends the record.
fn next_field(schema: mem::wire::NamedSchema, text: Slice[u8], mut at: Cursor, mut walk: Walk, mut frames: mem::List[Frame], alloc: mem::Alloc, mut out: mem::Bytes) -> Option[usize] fails core::DecodeError {
    let top = frames.len() - 1
    let mem::wire::SchemaNode.Record(open: open, fields: fields) = schema.tree.nodes[frames[top].node] else {
        fail core::DecodeError.Malformed
    }
    while word_next(text, at: mut at) {
        let key = try take_word(text, at: mut at, alloc)
        try expect_byte(text, at: mut at, byte: 58)
        let found = fields.position(fn(field: mem::wire::SchemaField) => field.key.as_bytes() == key.view() or field.aliases.position(fn(alias: text::String) => alias.as_bytes() == key.view()).is_some())
        match found {
            Some(index) => {
                if frames[top].present[index] {
                    fail core::DecodeError.DuplicateKey
                }
                frames[top].present[index] = true
                frames[top].chosen = index
                frames[top].reading = true
                return Some(fields[index].value)
            }
            None => {
                if not open {
                    fail core::DecodeError.UnknownKey
                }
                try skip_value(text, at: mut at, alloc)
            }
        }
        if peek(text, at: mut at) != Some(44) {
            break
        }
        at.at += 1
    }
    return try fields_end(schema, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
} next_field

/// Ends the innermost frame's record: its fields present, in byte order of keys, and its closing
/// parenthesis when it opened with one.
fn fields_end(schema: mem::wire::NamedSchema, text: Slice[u8], mut at: Cursor, mut walk: Walk, mut frames: mem::List[Frame], alloc: mem::Alloc, mut out: mem::Bytes) -> Option[usize] fails core::DecodeError {
    let top = frames.len() - 1
    let mem::wire::SchemaNode.Record(open: _, fields: fields) = schema.tree.nodes[frames[top].node] else {
        fail core::DecodeError.Malformed
    }
    var count: u64 = 0
    for index in 0..<fields.len() {
        if frames[top].present[index] {
            count += 1
        } else if not fields[index].defaulted {
            fail core::DecodeError.MissingField
        }
    }
    var encoded = mem::Bytes.empty(alloc)
    put_uvar(mut encoded, value: count)
    for index in 0..<fields.len() {
        if frames[top].present[index] {
            put_text(mut encoded, value: fields[index].key.as_bytes())
            put_text(mut encoded, value: frames[top].values[index].view())
        }
    }
    if frames[top].phase == Phase.Fields(parenthesized: true) {
        try expect_byte(text, at: mut at, byte: 41)
    }
    discard mut walk.enclosing.pop()
    leave(mut walk, frames: mut frames, mut out, encoded: encoded.view())
    return None
} fields_end

fn is_space(byte: u8) -> bool = byte == 32 or byte == 9 or byte == 10 or byte == 13

fn is_word_byte(byte: u8) -> bool = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95

fn skip_space(text: Slice[u8], mut at: Cursor) {
    while at.at < at.end and is_space(text[at.at]) {
        at.at += 1
    }
} skip_space

/// The next byte after whitespace, none at the end.
fn peek(text: Slice[u8], mut at: Cursor) -> Option[u8] {
    skip_space(text, at: mut at)
    if at.at >= at.end {
        return None
    }
    return Some(text[at.at])
} peek

/// Whether a word comes next, after whitespace.
fn word_next(text: Slice[u8], mut at: Cursor) -> bool {
    return match peek(text, at: mut at) {
        Some(byte) => is_word_byte(byte)
        None => false
    }
} word_next

fn expect_byte(text: Slice[u8], mut at: Cursor, byte: u8) fails core::DecodeError {
    if peek(text, at: mut at) != Some(byte) {
        fail core::DecodeError.Malformed
    }
    at.at += 1
} expect_byte

/// A copy of the bytes from `start` to `end`.
fn copy_range(text: Slice[u8], start: usize, end: usize, alloc: mem::Alloc) -> mem::Bytes {
    var copy = mem::Bytes.empty(alloc)
    for index in start..<end {
        mut copy.push(text[index])
    }
    return copy
} copy_range

/// The next word, a letter, digit or `_` run, after whitespace.
fn take_word(text: Slice[u8], mut at: Cursor, alloc: mem::Alloc) -> mem::Bytes fails core::DecodeError {
    skip_space(text, at: mut at)
    let start = at.at
    while at.at < at.end and is_word_byte(text[at.at]) {
        at.at += 1
    }
    if at.at == start {
        fail core::DecodeError.Malformed
    }
    return copy_range(text, start, end: at.at, alloc)
} take_word

/// The end of the literal whose opening quote `quote` lies just before `at`.
fn literal_end(text: Slice[u8], mut at: Cursor, quote: u8) fails core::DecodeError {
    while at.at < at.end {
        let byte = text[at.at]
        at.at += 1
        if byte == 92 {
            at.at += 1
        } else if byte == quote {
            return
        }
    }
    fail core::DecodeError.Malformed
} literal_end

/// The next token of a leaf, after whitespace: a char, text or bytes literal, or a number or
/// word, `-` and an exponent's sign included.
fn take_token(text: Slice[u8], mut at: Cursor, alloc: mem::Alloc) -> mem::Bytes fails core::DecodeError {
    skip_space(text, at: mut at)
    let start = at.at
    if at.at >= at.end {
        fail core::DecodeError.Malformed
    }
    let lead = text[at.at]
    if lead == 34 or lead == 39 {
        at.at += 1
        try literal_end(text, at: mut at, quote: lead)
    } else if lead == 98 and at.at + 1 < at.end and text[at.at + 1] == 34 {
        at.at += 2
        try literal_end(text, at: mut at, quote: 34)
    } else {
        if lead == 45 {
            at.at += 1
        }
        while at.at < at.end {
            let byte = text[at.at]
            let signed = (byte == 45 or byte == 43) and at.at > start and (text[at.at - 1] == 101 or text[at.at - 1] == 69)
            if not is_word_byte(byte) and byte != 46 and not signed {
                break
            }
            at.at += 1
        }
    }
    if at.at > at.end or at.at == start {
        fail core::DecodeError.Malformed
    }
    return copy_range(text, start, end: at.at, alloc)
} take_token

/// Skips a value of any form: a field an open type does not declare.
fn skip_value(text: Slice[u8], mut at: Cursor, alloc: mem::Alloc) fails core::DecodeError {
    let Some(lead) = peek(text, at: mut at) else {
        fail core::DecodeError.Malformed
    }
    if lead == 40 or lead == 91 or lead == 123 {
        try skip_group(text, at: mut at)
        return
    }
    discard try take_token(text, at: mut at, alloc)
    while peek(text, at: mut at) == Some(46) {
        at.at += 1
        discard try take_word(text, at: mut at, alloc)
    }
    if peek(text, at: mut at) == Some(40) {
        try skip_group(text, at: mut at)
    }
} skip_value

/// Skips a bracketed group and every group and literal it holds.
fn skip_group(text: Slice[u8], mut at: Cursor) fails core::DecodeError {
    var depth: usize = 0
    while at.at < at.end {
        let byte = text[at.at]
        at.at += 1
        if byte == 34 or byte == 39 {
            try literal_end(text, at: mut at, quote: byte)
        } else if byte == 40 or byte == 91 or byte == 123 {
            depth += 1
        } else if byte == 41 or byte == 93 or byte == 125 {
            if depth == 0 {
                fail core::DecodeError.Malformed
            }
            depth -= 1
            if depth == 0 {
                return
            }
        }
    }
    fail core::DecodeError.Malformed
} skip_group

/// Encodes a leaf read as its typed construction text decoder reads it.
fn encode_leaf(node: mem::wire::SchemaNode, text: Slice[u8], mut at: Cursor, alloc: mem::Alloc, mut out: mem::Bytes) fails core::DecodeError {
    let token = try take_token(text, at: mut at, alloc)
    let raw = Untrusted.of(token.view())
    match node {
        mem::wire::SchemaNode.Bool => {
            let value = try Codec[bool].decode(raw, alloc)
            mut out.push(value.to_bits())
        }
        mem::wire::SchemaNode.Unsigned(width: width) => {
            let value = try Codec[u64].decode(raw, alloc)
            if width < 64 and (value >> u32.widen(width)) != 0 {
                fail core::DecodeError.OutOfRange
            }
            put_uvar(mut out, value)
        }
        mem::wire::SchemaNode.Signed(width: width) => {
            let value = try Codec[i64].decode(raw, alloc)
            if width < 64 {
                let bound = 1i64 << u32.widen(width - 1)
                if value < -bound or value >= bound {
                    fail core::DecodeError.OutOfRange
                }
            }
            put_uvar(mut out, value: (value.to_bits() << 1) ^ value.shr_arith(63).to_bits())
        }
        mem::wire::SchemaNode.Float(width: width) => {
            if width == 32 {
                mem::wire::Codec[f32].encode(try Codec[f32].decode(raw, alloc), mut out)
            } else {
                mem::wire::Codec[f64].encode(try Codec[f64].decode(raw, alloc), mut out)
            }
        }
        mem::wire::SchemaNode.Char => {
            let value = try Codec[char].decode(raw, alloc)
            put_uvar(mut out, value: u64.widen(value.to_bits()))
        }
        mem::wire::SchemaNode.Text or mem::wire::SchemaNode.BoundedText(capacity: _) => {
            let value = try Codec[text::String].decode(raw, alloc)
            match node {
                mem::wire::SchemaNode.BoundedText(capacity: capacity) => {
                    if u64.widen(value.byte_len()) > capacity {
                        fail core::DecodeError.OutOfRange
                    }
                }
                else => {}
            }
            put_text(mut out, value: value.as_bytes())
        }
        mem::wire::SchemaNode.Bytes => {
            let value = try Codec[mem::Bytes].decode(raw, alloc)
            put_text(mut out, value: value.view())
        }
        else => fail core::DecodeError.Malformed
    }
} encode_leaf

/// Starts reading a variant: optionally a name and `.`, its key or an alias of it, then its
/// payload in parentheses, a labelled payload as the fields of a record; gives the node of its
/// payload, none for a variant without one or with a labelled one, whose fields are read next.
fn encode_variant(schema: mem::wire::NamedSchema, node: usize, text: Slice[u8], mut at: Cursor, mut walk: Walk, mut frames: mem::List[Frame], alloc: mem::Alloc, mut out: mem::Bytes) -> Option[usize] fails core::DecodeError {
    let mem::wire::SchemaNode.Variant(open: _, variants: variants) = schema.tree.nodes[node] else {
        fail core::DecodeError.Malformed
    }
    var key = try take_word(text, at: mut at, alloc)
    if peek(text, at: mut at) == Some(46) {
        at.at += 1
        key = try take_word(text, at: mut at, alloc)
    }
    let Some(index) = variants.position(fn(variant: mem::wire::SchemaVariant) => variant.key.as_bytes() == key.view() or variant.aliases.position(fn(alias: text::String) => alias.as_bytes() == key.view()).is_some()) else {
        fail core::DecodeError.UnknownVariant
    }
    let Some(payload) = variants[index].payload else {
        try mut walk.nest()
        walk.depth -= 1
        var encoded = mem::Bytes.empty(alloc)
        put_text(mut encoded, value: variants[index].key.as_bytes())
        mut encoded.push(0)
        emit(mut frames, mut out, bytes: encoded.view())
        return None
    }
    try expect_byte(text, at: mut at, byte: 40)
    try enter(mut walk, frames: mut frames, schema, node, phase: Phase.Payload, alloc)
    mut walk.enclosing.push(node)
    frames[frames.len() - 1].chosen = index
    let labelled = name_index(schema, at: payload).is_none() and payload < schema.tree.nodes.len() and is_record(schema.tree.nodes[payload])
    if labelled {
        try enter(mut walk, frames: mut frames, schema, node: payload, phase: Phase.Fields(parenthesized: false), alloc)
        mut walk.enclosing.push(payload)
        return try next_field(schema, text, at: mut at, walk: mut walk, frames: mut frames, alloc, out: mut out)
    }
    frames[frames.len() - 1].reading = true
    return Some(payload)
} encode_variant

fn is_record(node: mem::wire::SchemaNode) -> bool {
    return match node {
        mem::wire::SchemaNode.Record(open: _, fields: _) => true
        else => false
    }
} is_record

enum Medium derives Encode {
    Copper
    Fiber(lanes: u8)
} Medium

struct Port derives Encode {
    name: text::String
    mtu: u16
    medium: Medium
    backup: Option[Medium]
} Port

/// `Port`'s schema tree with its names: nodes 0 the port, 1 the backup's `Option`, 2 and 5 the
/// media.
fn port_schema(alloc: mem::Alloc) -> mem::wire::NamedSchema {
    var names = mem::List[mem::wire::SchemaName].empty(alloc)
    mut names.push(mem::wire::SchemaName(node: 0, path: text::String.of("text::construction::Port", alloc)))
    mut names.push(mem::wire::SchemaName(node: 1, path: text::String.of("core::Option", alloc)))
    mut names.push(mem::wire::SchemaName(node: 2, path: text::String.of("text::construction::Medium", alloc)))
    mut names.push(mem::wire::SchemaName(node: 5, path: text::String.of("text::construction::Medium", alloc)))
    return mem::wire::NamedSchema(tree: mem::wire::Codec[Port].schema(alloc), names: take names)
} port_schema

fn port(alloc: mem::Alloc) -> Port {
    return Port(name: text::String.of("eth\t0", alloc), mtu: 1_500, medium: Medium.Fiber(lanes: 2), backup: Some(Medium.Copper))
} port

test render_as_writes_construction_text for render_as {
    let alloc = testing::world().alloc
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[Port].encode(port(alloc), out: mut bytes)
    var out = text::String.empty(alloc)
    let rendered = attempt render_as(port_schema(alloc), raw: Untrusted.of(bytes.view()), alloc, out: mut out)
    expect rendered.is_ok()
    expect out.as_str() == "Port(backup: Some(Medium.Copper), medium: Medium.Fiber(lanes: 2), mtu: 1500, name: \"eth\\t0\")"
} render_as_writes_construction_text

test encode_as_reads_construction_text for encode_as {
    let alloc = testing::world().alloc
    var expected = mem::Bytes.empty(alloc)
    mem::wire::Codec[Port].encode(port(alloc), out: mut expected)
    let encoded = attempt encode_as(port_schema(alloc), raw: Untrusted.of(b" Port( name: \"eth\\t0\", mtu: 1_500, medium: Fiber(lanes: 2), backup: Some(Medium.Copper) ) "), alloc)
    let missing = attempt encode_as(port_schema(alloc), raw: Untrusted.of(b"Port(name: \"a\", mtu: 1, backup: None)"), alloc)
    let unknown = attempt encode_as(port_schema(alloc), raw: Untrusted.of(b"Port(name: \"a\", mtu: 1, medium: Copper, backup: None, speed: 9)"), alloc)
    let wide = attempt encode_as(port_schema(alloc), raw: Untrusted.of(b"Port(name: \"a\", mtu: 70000, medium: Copper, backup: None)"), alloc)
    let Ok(bytes) = encoded else {
        expect false
        return
    }
    expect bytes.view() == expected.view()
    expect missing.is_err() and unknown.is_err() and wide.is_err()
} encode_as_reads_construction_text

/// Sequences nested `depth` deep under a schema whose root is a sequence of itself: their
/// construction text and their encoding.
struct Nested {
    schema: mem::wire::NamedSchema
    text: mem::Bytes
    bytes: mem::Bytes
} Nested

fn nested(depth: usize, alloc: mem::Alloc) -> Nested {
    var nodes = mem::List[mem::wire::SchemaNode].empty(alloc)
    mut nodes.push(mem::wire::SchemaNode.Sequence(element: 0, length: None, capacity: None, unique: false))
    var text = mem::Bytes.empty(alloc)
    var bytes = mem::Bytes.empty(alloc)
    for level in 0..<depth {
        mut text.push(b'[')
        if level + 1 < depth {
            mut bytes.push(1)
        } else {
            mut bytes.push(0)
        }
    }
    for _ in 0..<depth {
        mut text.push(b']')
    }
    let schema = mem::wire::NamedSchema(tree: mem::wire::Schema(nodes: take nodes), names: mem::List.empty(alloc))
    return Nested(schema: take schema, text: take text, bytes: take bytes)
} nested

test render_as_nests_at_most_128_deep for render_as {
    let alloc = testing::world().alloc
    let deepest = nested(128, alloc)
    let deeper = nested(129, alloc)
    var out = text::String.empty(alloc)
    let rendered = attempt render_as(deepest.schema, raw: Untrusted.of(deepest.bytes.view()), alloc, out: mut out)
    var spilled = text::String.empty(alloc)
    let refused = attempt render_as(deeper.schema, raw: Untrusted.of(deeper.bytes.view()), alloc, out: mut spilled)
    expect rendered.is_ok() and out.as_bytes() == deepest.text.view()
    expect refused == Err(core::DecodeError.TooDeep)
} render_as_nests_at_most_128_deep

test encode_as_nests_at_most_128_deep for encode_as {
    let alloc = testing::world().alloc
    let deepest = nested(128, alloc)
    let deeper = nested(129, alloc)
    let Ok(encoded) = attempt encode_as(deepest.schema, raw: Untrusted.of(deepest.text.view()), alloc) else {
        expect false
        return
    }
    let refused = attempt encode_as(deeper.schema, raw: Untrusted.of(deeper.text.view()), alloc)
    expect encoded.view() == deepest.bytes.view()
    expect refused == Err(core::DecodeError.TooDeep)
} encode_as_nests_at_most_128_deep
