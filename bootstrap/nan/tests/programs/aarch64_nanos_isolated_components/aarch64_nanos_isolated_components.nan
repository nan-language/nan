//! Holds instances of the components of nanos bundles in isolated spaces, with jobs beside them, serving their logs and standard streams on the serial port and their random source from a counter, denying them a file system: instances of a component whose calls, a postponed one included, made under a header that reaches their handlers and comes back with the calls those make through ports and capabilities of crossing kinds, over bridges too, keyed tasks and checkpoints run in their spaces, with logs and gauges crossing into and out of them and a runner the kernel serves, one ending trapped and one abandoned, then another held on its link, an instance sharing its space with a job that traps, divides and adds through a gauge its world holds, logging through a log of its own and denied a random source, with another instance that is abandoned and with one whose space breaches its link, a book and tellers in two spaces calling it over a bridge, a log crossing there and back, payloads streamed and moved through frames of their own, a teller and a job calling it over bridges through lines their worlds hold, the job in a space whose clock is revoked, whose kernel admits each call until their credit runs out or a line is revoked, a breach ending the book, and calls, replies, states and a job's result past what a link carries leaving their spaces, books of one isolation breaching their link with more replies moved to the kernel unread than its frames hold, two books of one isolation, the first ending while the second runs on and giving back fewer frames than it lent, the second the rest, and an instance answering more calls giving it logs than its table holds the entries of at once and finding a log its runner holds revoked once it drops and takes it again.

registers Pl011 {
    data: u8 at 0x0 write
} Pl011

registers FwCfg {
    data: u8 at 0x0 read
    selector: u16 at 0x8 write
} FwCfg

/// The fw_cfg key of the file directory, and the bytes of a file's name in it.
const DIRECTORY: u16 = 0x19

const NAME_BYTES: usize = 56

/// The public key of the seed of 32 bytes 7, with which the harness signs the bundles.
const SIGNER: Slice[u8] = b"\xEA\x4A\x6C\x63\xE2\x9C\x52\x0A\xBE\xF5\x50\x7B\x13\x2E\xC5\xF9\x95\x47\x76\xAE\xBE\xBE\x7B\x92\x42\x1E\xEA\x69\x14\x46\xD2\x2C"

/// What the typed job is asked and what it answers, as it declares them.
pub closed enum Ask derives Encode {
    Divide(u32)
    Gauge(u32)
    Dial(mem::Bytes)
} Ask

pub closed enum Answer derives Encode {
    Number(u64)
    Bytes(mem::Bytes)
} Answer

/// The book's protocol and state, as the kernel declares them.
pub protocol Ledger {
    pub fn add(amount: u32) -> u64 limits pure
    pub fn echo(clock: sys::Clock) -> sys::Clock limits pure
    pub fn note(log: sys::Log) -> sys::Log limits recorded
    pub fn borrow() limits recorded
    pub fn gauge(amount: u32, given: gauges::Gauge) -> u64 limits recorded
    pub fn divide(by: u32) -> u64 limits pure
    pub fn spin() -> u64 limits pure
    pub fn wait() -> u64 limits pure
    pub fn settle() limits traceless
    pub fn weigh(bytes: mem::Bytes) -> u64 limits pure
    pub fn fill(kibibytes: u32) -> mem::Bytes limits recorded
    pub fn sum(one: sys::Log, two: sys::Log, three: sys::Log, four: sys::Log, given: sys::Log) -> u64 limits pure
    pub fn flood(calls: u32) limits recorded
} Ledger

pub protocol Till {
    pub fn relay(amount: u32) limits recorded
    pub fn note() limits recorded
    pub fn weigh(kibibytes: u32) limits recorded
    pub fn dial(amount: u32) limits recorded
} Till

pub closed struct Book derives Encode {
    pub total: u64
    pub ticks: u64
    pub pending: u64
} Book

/// The hoard's protocol and state, as the kernel declares them.
pub protocol Hoarding {
    pub fn grow(kibibytes: u32) -> u64 limits recorded
} Hoarding

pub closed struct Hoard derives Encode {
    pub bytes: mem::Bytes
} Hoard

/// The serial port serving a job's log and standard streams, its state counting the bytes of
/// standard input it has given, its standard input closed once given, its record 1 for the log
/// the book notes through and 2 for the log of a job that has its own.
struct Console {
} Console

impl Console: sys::Kind[core::atomic::AtomicU64, u64]

impl Console: sys::LogService

impl Console: sys::StdioService

/// A random source serving the bytes of a counter.
struct Counter {
} Counter

impl Counter: sys::Kind[core::atomic::AtomicU64, u64]

impl Counter: sys::RandomService

fn Console.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
    match sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => record) {
        Some(1) => say(text: "note ")
        Some(2) => say(text: "job ")
        else => say(text: "log ")
    }
    match level {
        sys::LogLevel.Info => say(text: "info ")
        sys::LogLevel.Warn => say(text: "warn ")
        sys::LogLevel.Error => say(text: "error ")
    }
    say(text: message)
    say(text: ": ")
    say(text: value)
    say(text: "\n")
} Console.log

fn Console.read_in(self, mut buf: SliceMut[u8]) -> usize fails sys::StdioError limits stack 4_096 {
    let input = b"from the kernel"
    let given = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(input.len())))
    let Some(Some(start)) = given else {
        fail sys::StdioError.Closed
    }
    if start > 0 {
        fail sys::StdioError.Closed
    }
    var count: usize = 0
    while count < buf.len() and count < input.len() {
        buf[count] = input[count]
        count += 1
    }
    return count
} Console.read_in

fn Console.write_out(self, data: Slice[u8]) limits stack 4_096 {
    say(text: "out ")
    say_bytes(data)
} Console.write_out

fn Console.write_err(self, data: Slice[u8]) limits stack 4_096 {
    say(text: "err ")
    say_bytes(data)
} Console.write_err

fn Counter.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
    let given = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(buf.len())))
    let start = given.value_or(None).value_or(0)
    for index in 0..<buf.len() {
        buf[index] = u8.truncate(start + u64.widen(index))
    }
} Counter.fill

fn say(text: Str) {
    say_bytes(text.as_bytes())
} say

fn say_bytes(bytes: Slice[u8]) {
    var port = trusted "the virt board maps the PL011 at 0x0900_0000 and nothing else maps it" { hw::Mmio[Pl011].map(0x0900_0000) }
    for byte in bytes {
        mut port.write(Pl011.data, value: byte)
    }
    take port.unmap()
} say_bytes

fn say_number(value: u64) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var left = value
    loop {
        digits[count] = b'0' + u8.truncate(left % 10)
        count += 1
        left = left / 10
        if left == 0 {
            break
        }
    }
    var port = trusted "the virt board maps the PL011 at 0x0900_0000 and nothing else maps it" { hw::Mmio[Pl011].map(0x0900_0000) }
    while count > 0 {
        count -= 1
        mut port.write(Pl011.data, value: digits[count])
    }
    take port.unmap()
} say_number

/// Reads a big-endian number of `count` bytes from the fw_cfg data register.
fn read_be(mut fw_cfg: hw::Mmio[FwCfg], count: u32) -> u64 {
    var value: u64 = 0
    for _ in 0..<count {
        value = (value << 8) | u64.widen(mut fw_cfg.read(FwCfg.data))
    }
    return value
} read_be

/// Selects a fw_cfg item, whose key the selector register takes big-endian.
fn select(mut fw_cfg: hw::Mmio[FwCfg], key: u16) {
    mut fw_cfg.write(FwCfg.selector, value: (key << 8) | (key >> 8))
} select

/// The fw_cfg file of a name: its key and size, a zero key when there is none.
struct Found derives Copy {
    key: u16
    size: u64
} Found

fn find_file(mut fw_cfg: hw::Mmio[FwCfg], name: Str) -> Found {
    var found = Found(key: 0, size: 0)
    for _ in 0..<read_be(mut fw_cfg, count: 4) {
        let size = read_be(mut fw_cfg, count: 4)
        let key = u16.truncate(read_be(mut fw_cfg, count: 2))
        discard read_be(mut fw_cfg, count: 2)
        var same = true
        for index in 0..<NAME_BYTES {
            let byte = mut fw_cfg.read(FwCfg.data)
            var wanted: u8 = 0
            if index < name.as_bytes().len() {
                wanted = name.as_bytes()[index]
            }
            same = same and byte == wanted
        }
        if same {
            found = Found(key: key, size: size)
        }
    }
    return found
} find_file

/// The bytes of the fw_cfg file of a name, empty when there is none.
fn fw_file(name: Str, alloc: mem::Alloc) -> mem::Bytes {
    var fw_cfg = trusted "the virt board maps fw_cfg at 0x0902_0000 and nothing else maps it" { hw::Mmio[FwCfg].map(0x0902_0000) }
    select(mut fw_cfg, key: DIRECTORY)
    let found = find_file(mut fw_cfg, name)
    var bytes = mem::Bytes.empty(alloc)
    if found.key != 0 {
        select(mut fw_cfg, key: found.key)
        for _ in 0..<found.size {
            mut bytes.push(mut fw_cfg.read(FwCfg.data))
        }
    }
    take fw_cfg.unmap()
    return bytes
} fw_file

fn stop(text: Str) -> Never {
    say(text)
    loop {
    }
} stop

/// The kernel's policy, which keeps every task on CPU 0, a lesser class first, with 1 ms slices.
struct OneCpu {
} OneCpu

impl OneCpu: hw::Policy

fn OneCpu.place(self, t: hw::IrqsDisabled, task: hw::TaskView) -> hw::Placement limits notrap, terminates, noalloc, stack 4_096 {
    return hw::Placement(cpu: 0, key: u64.widen(task.share.class), bound: false)
} OneCpu.place

fn OneCpu.steal(self, t: hw::IrqsDisabled, cpu: u32, round: u32) -> Option[hw::Steal] limits notrap, terminates, noalloc, stack 4_096 {
    return None
} OneCpu.steal

fn OneCpu.slice(self, t: hw::IrqsDisabled, cpu: u32, task: hw::TaskView) -> u64 limits notrap, terminates, noalloc, stack 4_096 {
    return 1_000_000
} OneCpu.slice

fn OneCpu.idle(self, t: hw::IrqsDisabled, cpu: u32, until_ns: Option[u64]) -> hw::Idle limits notrap, terminates, noalloc, stack 4_096 {
    return hw::Idle.Halt
} OneCpu.idle

/// The frames each space takes and draws from for itself: 16 MiB, less than its runtime's boot area.
const SPACE_FRAMES: usize = 4_096

/// The frames each job or instance lends its space and draws from: 32 MiB, more than the space's
/// own.
const LOAN_FRAMES: usize = 8_192

/// The bytes of usable memory the kernel's heap grows by, beyond its boot heap, for the lists of
/// frames its isolations pass around.
const HEAP_BYTES: u64 = 16_777_216

/// The offset of the bytes of a link's channel frame, and their count.
const RING_DATA: u64 = 64

const RING_BYTES: u64 = 4_096 - RING_DATA

/// A bundle verified for isolated spaces.
fn isolated(loader: sys::load::Loader, bytes: Slice[u8], alloc: mem::Alloc) -> sys::load::Isolated {
    let keys = Array[core::crypto::PublicKey, 1].filled(bundle_key())
    let Ok(job) = attempt loader.isolate(bytes, keys: keys.view(), alloc) else {
        stop(text: "unverified\n")
    }
    return job
} isolated

/// What the kernel serves every job, and the console the book notes through.
struct Grants derives Copy {
    clock: sys::Clock
    console: Console
    noter: Console
    own: Console
    counter: Counter
    exec: task::Executor
    alloc: mem::Alloc
} Grants

/// The services of an isolated job: the kernel's clock, its log and standard streams on the
/// console, its random source the counter and its file system denied.
fn services(grants: Grants) -> nanos::Services {
    let Ok(log) = attempt sys::Log.served(grants.console) else {
        stop(text: "no log\n")
    }
    let Ok(stdio) = attempt sys::Stdio.served(grants.console) else {
        stop(text: "no stdio\n")
    }
    let Ok(random) = attempt sys::Random.served(grants.counter) else {
        stop(text: "no random\n")
    }
    return nanos::Services(clock: grants.clock, log: log, stdio: stdio, random: random, fs: sys::Fs.denied())
} services

/// The services of an isolated job of its own: its log on the console under its own name, and a
/// random source revoked before it starts.
fn own_services(grants: Grants) -> nanos::Services {
    let served = services(grants)
    let Ok(log) = attempt sys::Log.served(grants.own) else {
        stop(text: "no log\n")
    }
    let Ok(revoker) = attempt sys::revocable(served.random) else {
        stop(text: "no random\n")
    }
    let random = revoker.capability()
    take revoker.revoke()
    return nanos::Services(clock: served.clock, log: log, stdio: served.stdio, random: random, fs: served.fs)
} own_services

/// The frames a space takes, from the end of `frames`.
fn frames_for_space(mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    return frames_taken(mut frames, count: SPACE_FRAMES, alloc)
} frames_for_space

/// The frames a job or instance lends its space, from the end of `frames`.
fn frames_for_job(mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    return frames_taken(mut frames, count: LOAN_FRAMES, alloc)
} frames_for_job

/// `count` frames from the end of `frames`.
fn frames_taken(mut frames: mem::List[hw::PhysFrame[4_096]], count: usize, alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    var taken = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    for _ in 0..<count {
        let Some(frame) = mut frames.pop() else {
            stop(text: "out of frames\n")
        }
        mut taken.push(take frame)
    }
    return taken
} frames_taken

/// Gives back to `frames` every frame of `taken`.
fn given_back(take taken: mem::List[hw::PhysFrame[4_096]], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    for frame in take taken {
        mut frames.push(take frame)
    }
} given_back

/// Writes how a run ended, giving what it returned, empty for a run returning nothing.
fn report(name: Str, take outcome: Result[nanos::Ended, nanos::IsolatedError], alloc: mem::Alloc) -> mem::Bytes {
    say(text: name)
    match outcome {
        Ok(nanos::Ended.Returned(bytes)) => {
            say(text: " returned\n")
            return bytes
        }
        Ok(nanos::Ended.Failed(rendered)) => {
            say(text: " failed ")
            say(text: rendered.as_str())
            say(text: "\n")
        }
        Ok(nanos::Ended.Trapped(trap)) => {
            match trap.kind() {
                sys::TrapKind.DivisionByZero => say(text: " trapped trap.division-by-zero\n")
                sys::TrapKind.Exception => say(text: " trapped trap.exception\n")
                sys::TrapKind.Exhausted => say(text: " trapped trap.exhausted\n")
                else => say(text: " trapped otherwise\n")
            }
            say_trap(trap, alloc)
        }
        Ok(nanos::Ended.Cancelled) or Ok(nanos::Ended.Abandoned) => say(text: " stopped\n")
        Ok(nanos::Ended.Undecodable) => say(text: " undecodable\n")
        Err(_) => say(text: " did not run\n")
    }
    return mem::Bytes.empty(alloc)
} report

/// The books one isolation holds one after another, each moving to the kernel a reply it never
/// reads: more than the isolation's frames hold unless the frames of each reply come back to it.
const BREACHING_BOOKS: usize = 3

/// Holds `BREACHING_BOOKS` books one after another in one isolation, each breaching its link once
/// it moved its reply to the kernel as `fill_breached` has it, and writes how many ended trapped
/// breaching it.
fn fills_unread(cpu: hw::Ring0, ledger: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let gauging = gauges::open(grants.clock, alloc: grants.alloc)
    defer gauges::close(take gauging)
    var caps = nanos::Caps.empty(grants.alloc)
    mut nanos::Cap[gauges::Gauge].put(mut caps, key: "gauge", capability: gauges::mint(gauging))
    var links = mem::List[nanos::Link].empty(grants.alloc)
    var outbounds = mem::List[u64].empty(grants.alloc)
    for _ in 0..<BREACHING_BOOKS {
        var link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
        let up = next_frame(mut frames)
        mut outbounds.push(up.base())
        discard mut link.open("book", inbound: next_frame(mut frames), outbound: take up)
        mut links.push(take link)
    }
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var loan = frames_for_job(mut frames, alloc: grants.alloc)
    var breached: u64 = 0
    discard attempt await nanos::isolate(cpu, tenant: 11, services: services(grants), frames: mut held, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut breached, mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
        for index in 0..<links.len() {
            let outbound = outbounds[index]
            let held_book = attempt await nanos::hold_isolated(space, job: ledger, component: "Book", link: links[index], services: services(grants), caps, checkpoint: None, runner: sys::Runner.denied(), frames: mut loan, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) -> bool fails nanos::InstanceError uses wait {
                return try await fill_breached(take instance, outbound, grants)
            })
            match held_book {
                Ok(Some(true)) => {
                    breached += 1
                }
                else => {}
            }
        }
    })
    given_back(take held, mut frames)
    given_back(take loan, mut frames)
    returned(take extended, mut frames)
    for link in take links {
        take link.release(mut frames)
    }
    say(text: "breached ")
    say_number(breached)
    say(text: " books of one isolation leaving a fill unread\n")
} fills_unread

/// Has the book fill 3 MiB, a reply that moves to the kernel through frames of their own: once the
/// call is incoming, writes into the frame at `outbound`, in which its space writes the first
/// channel of its link, the start of a frame no runtime writes, which the first bytes the space
/// writes after it complete, then steps the book, and gives whether it ended trapped breaching the
/// link.
fn fill_breached(take instance: nanos::Instance, outbound: u64, grants: Grants) -> bool fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    var request = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].fill(mut request, kibibytes: 3_072)
    var pending = Some(take request)
    try await task::scope(grants.exec, body: fn[mut book, mut pending](s: task::Scope) fails nanos::InstanceError uses wait {
        let Some(call) = mut pending.extract() else {
            return
        }
        let inbox = book.inbox()
        let replied = s.spawn(fn[take inbox, take call]() fails task::Cancelled uses wait limits stack 16_384 {
            discard attempt await inbox.call(sys::Wire[Ledger].hash(), request: 0, encoding: take call, alloc: grants.alloc)
        })
        try await book.incoming()
        written_as_space(frame: outbound, data: b"\x05\x00\x00\x00\xFF\xFF\xFF\xFF")
        discard attempt await mut book.step()
        try await take replied.join()
    })
    undefer book
    match try await take book.end() {
        nanos::Ended.Trapped(trap) => match trap.kind() {
            sys::TrapKind.Bounds => return true
            else => return false
        }
        else => return false
    }
} fill_breached

/// The last frame of a list, or a stop when none is left.
fn next_frame(mut frames: mem::List[hw::PhysFrame[4_096]]) -> hw::PhysFrame[4_096] {
    let Some(frame) = mut frames.pop() else {
        stop(text: "out of frames\n")
    }
    return frame
} next_frame

/// Gives back the frame of an extended state.
fn returned(take extended: Option[hw::ExtendedState], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    match extended {
        Some(owned) => mut frames.push(take owned.into_frame())
        None => {}
    }
} returned

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    let clock = k.clock()
    let Some(loader) = k.loader() else {
        stop(text: "no loader\n")
    }
    let Some(cpu) = mut k.ring0() else {
        stop(text: "no ring0\n")
    }
    var regions = mut k.regions()
    var frames = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    let Some(region) = mut regions.pop() else {
        stop(text: "no usable memory\n")
    }
    var heap = region
    let Some(rest) = mut heap.split(at: heap.base() + HEAP_BYTES) else {
        stop(text: "too little memory\n")
    }
    k.grow_heap(take heap)
    take rest.frames(mut frames)
    mut k.policy(OneCpu())
    take k.anchor(0u8, run: fn[take loader, take cpu, take frames](exec: task::Executor) fails task::Cancelled uses wait limits stack 262_144 {
        let consoles = sys::Minter[Console, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let counters = sys::Minter[Counter, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let grants = Grants(clock: clock, console: consoles.mint(0), noter: consoles.mint(1), own: consoles.mint(2), counter: counters.mint(0), exec: exec, alloc: alloc)
        var pool = frames
        let served = attempt await serve(cpu, loader, grants, frames: mut pool)
        take consoles.close()
        take counters.close()
        let Some(last) = mut pool.pop() else {
            stop(text: "out of frames\n")
        }
        relinquished(take cpu, frame: take last)
        for frame in take pool {
            given_up(take frame)
        }
        discard served
    })
} main

/// Gives up the CPU's privileges, which a frame holds from now on, and the frame.
fn relinquished(take cpu: hw::Ring0, take frame: hw::PhysFrame[4_096]) {
    let base = frame.base()
    trusted "the frame holds the privileges, and no value owns them from now on" { hw::Ptr[hw::Ring0].of_addr(usize.widen(base + 8)).write(take cpu) }
    given_up(take frame)
} relinquished

/// Gives up an unused frame, which holds itself from now on.
fn given_up(take frame: hw::PhysFrame[4_096]) {
    let base = frame.base()
    trusted "the frame holds itself, and no value owns it from now on" { hw::Ptr[hw::PhysFrame[4_096]].of_addr(usize.widen(base)).write(take frame) }
} given_up

/// Holds instances of the ledger's components: instances of a component held in spaces, one
/// sharing its space with jobs and other instances, instances in two spaces calling over a bridge,
/// instances of one space breaching their link with a reply moved to the kernel unread, and two
/// instances of one space giving back the frames their bundle's image drew.
fn serve(cpu: hw::Ring0, loader: sys::load::Loader, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let typed = isolated(loader, bytes: fw_file(name: "opt/nan/typed", alloc: grants.alloc).view(), alloc: grants.alloc)
    let ledger = isolated(loader, bytes: fw_file(name: "opt/nan/ledger", alloc: grants.alloc).view(), alloc: grants.alloc)
    try await booked(cpu, job: ledger, grants, mut frames)
    try await shared(cpu, book: ledger, job: typed, grants, mut frames)
    try await bridged(cpu, ledger, typed, grants, mut frames)
    try await fills_unread(cpu, ledger, grants, mut frames)
    try await images_lent(cpu, ledger, grants, mut frames)
} serve

/// Holds in a space over the first channel of a link a hoard, then instances of the ledger's book,
/// with a gauge in their worlds, acting through a runner the kernel serves: started, called, given
/// a log it notes through, publishing its total, and gives back, lent logs through its runner,
/// gauged, refused a call carrying a clock, checkpointed and ended, then restored from that
/// checkpoint, a handler that traps, a handler that never returns until the instance is
/// abandoned, an add on that instance's link, and, in a space whose executor draws from a budget,
/// a handler flooding a port its runner stalls with calls.
fn booked(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let gauging = gauges::open(grants.clock, alloc: grants.alloc)
    defer gauges::close(take gauging)
    let gauge = gauges::mint(gauging)
    var caps = nanos::Caps.empty(grants.alloc)
    mut nanos::Cap[gauges::Gauge].put(mut caps, key: "gauge", capability: gauge)
    var later = nanos::Caps.empty(grants.alloc)
    mut nanos::Cap[gauges::Gauge].put(mut later, key: "gauge", capability: gauges::mint(gauging))
    let lending = sys::Minter[Lending, Lent, u64].of(Lent(noter: grants.noter, gauge: gauges::mint(gauging), clock: grants.clock, alloc: grants.alloc), alloc: grants.alloc)
    defer take lending.close()
    let given = gauges::mint(gauging)
    let Ok(runner) = attempt sys::Runner.served(lending.mint(0)) else {
        stop(text: "no runner\n")
    }
    var link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    discard mut link.open("book", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var pool = frames_for_space(mut frames, alloc: grants.alloc)
    var loan = frames_for_job(mut frames, alloc: grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    discard attempt await nanos::isolate(cpu, tenant: 4, services: services(grants), frames: mut pool, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
        try await hoarded(space, job, link, grants, frames: mut loan)
        let opened = attempt await nanos::hold_isolated(space, job, component: "Book", link, services: services(grants), caps, checkpoint: None, runner, frames: mut loan, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) -> nanos::Checkpoint fails nanos::InstanceError uses wait {
            return try await started(take instance, grants, gauging, gauges: Gauges(world: gauge, given: given))
        })
        match opened {
            Ok(Some(checkpoint)) => {
                discard attempt await nanos::hold_isolated(space, job, component: "Book", link, services: services(grants), caps: later, checkpoint: Some(take checkpoint), runner, frames: mut loan, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
                    try await restored(take instance, grants)
                })
            }
            else => say(text: "book unheld\n")
        }
        discard attempt await nanos::hold_isolated(space, job, component: "Book", link, services: services(grants), caps: later, checkpoint: None, runner, frames: mut loan, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
            try await trapped(take instance, grants)
        })
        discard attempt await nanos::hold_isolated(space, job, component: "Book", link, services: services(grants), caps: later, checkpoint: None, runner, frames: mut loan, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
            try await abandoned(take instance, grants)
        })
        discard attempt await nanos::hold_isolated(space, job, component: "Book", link, services: services(grants), caps: later, checkpoint: None, runner, frames: mut loan, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
            try await reheld(take instance, grants)
        })
    })
    var flooding = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    discard mut flooding.open("book", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let budget = grants.alloc.split(FLOOD_BYTES)
    let account = grants.exec.split_on(task::Share(weight: 1, class: 0, reserve_ppm: 0), alloc: budget.alloc())
    discard attempt await nanos::isolate(cpu, tenant: 12, services: services(grants), frames: mut pool, mut extended, exec: account.executor(), alloc: grants.alloc, body: fn[mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
        discard attempt await nanos::hold_isolated(space, job, component: "Book", link: flooding, services: services(grants), caps: later, checkpoint: None, runner, frames: mut loan, exec: account.executor(), alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
            try await flooded(take instance, grants)
        })
    })
    take account.close()
    take budget.close()
    given_back(take pool, mut frames)
    given_back(take loan, mut frames)
    returned(take extended, mut frames)
    take link.release(mut frames)
    take flooding.release(mut frames)
} booked

/// Holds the ledger's book and runs the typed job in one space: the job traps dividing by zero while
/// the book is held, then divides again, then adds and settles through a gauge twice, logging the
/// second time through a log of its own and denied a random source, another book held there adds and is abandoned, a third
/// ends breaching its link, and the first book adds before and after, fills past what its link
/// carries in between, and ends with its total.
fn shared(cpu: hw::Ring0, book: sys::load::Isolated, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let gauging = gauges::open(grants.clock, alloc: grants.alloc)
    defer gauges::close(take gauging)
    var caps = nanos::Caps.empty(grants.alloc)
    mut nanos::Cap[gauges::Gauge].put(mut caps, key: "gauge", capability: gauges::mint(gauging))
    var link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    discard mut link.open("book", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let neighbour = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    var other = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    discard mut other.open("book", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var malformed = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    let up = next_frame(mut frames)
    let up_base = up.base()
    discard mut malformed.open("book", inbound: next_frame(mut frames), outbound: take up)
    var pool = frames_for_space(mut frames, alloc: grants.alloc)
    var book_loan = frames_for_job(mut frames, alloc: grants.alloc)
    var loan = frames_for_job(mut frames, alloc: grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    discard attempt await nanos::isolate(cpu, tenant: 5, services: services(grants), frames: mut pool, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut book_loan, mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
        discard attempt await nanos::hold_isolated(space, job: book, component: "Book", link, services: services(grants), caps, checkpoint: None, runner: sys::Runner.denied(), frames: mut book_loan, exec: grants.exec, alloc: grants.alloc, body: fn[mut loan](take instance: nanos::Instance) fails nanos::InstanceError uses wait {
            var held = instance
            defer take held.abandon()
            say(text: "shared ")
            try await added(mut held, amount: 5, grants)
            discard report("neighbour", outcome: attempt await nanos::run_isolated(space, job, link: neighbour, services: services(grants), caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Divide(0), alloc: grants.alloc), frames: mut loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
            let quotient = report("neighbour", outcome: attempt await nanos::run_isolated(space, job, link: neighbour, services: services(grants), caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Divide(4), alloc: grants.alloc), frames: mut loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
            say_answer(text: "neighbour quotient ", bytes: take quotient, alloc: grants.alloc)
            let settled = report("neighbour", outcome: attempt await nanos::run_isolated(space, job, link: neighbour, services: services(grants), caps, input: encoded(Ask.Gauge(7), alloc: grants.alloc), frames: mut loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
            say_answer(text: "neighbour settled ", bytes: take settled, alloc: grants.alloc)
            let own = report("neighbour", outcome: attempt await nanos::run_isolated(space, job, link: neighbour, services: own_services(grants), caps, input: encoded(Ask.Gauge(7), alloc: grants.alloc), frames: mut loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
            say_answer(text: "neighbour settled ", bytes: take own, alloc: grants.alloc)
            try await task::scope(grants.exec, body: fn[mut loan](s: task::Scope) fails task::Cancelled uses wait {
                let second = s.spawn(fn[mut loan]() fails task::Cancelled uses wait limits stack 196_608 {
                    discard attempt await nanos::hold_isolated(space, job: book, component: "Book", link: other, services: services(grants), caps, checkpoint: None, runner: sys::Runner.denied(), frames: mut loan, exec: grants.exec, alloc: grants.alloc, body: fn(take another: nanos::Instance) fails nanos::InstanceError uses wait {
                        var abandoning = another
                        defer take abandoning.abandon()
                        say(text: "other ")
                        try await added(mut abandoning, amount: 3, grants)
                        abandoning.domain().contents().trigger()
                        undefer abandoning
                        say(text: "other book ")
                        say_ended(try await take abandoning.end(), alloc: grants.alloc)
                    })
                })
                try await take second.join()
                let third = s.spawn(fn[mut loan]() fails task::Cancelled uses wait limits stack 196_608 {
                    discard attempt await nanos::hold_isolated(space, job: book, component: "Book", link: malformed, services: services(grants), caps, checkpoint: None, runner: sys::Runner.denied(), frames: mut loan, exec: grants.exec, alloc: grants.alloc, body: fn(take breacher: nanos::Instance) fails nanos::InstanceError uses wait {
                        try await breached_up(take breacher, outbound: up_base, grants)
                    })
                })
                try await take third.join()
            })
            say(text: "shared ")
            try await filled(mut held, grants)
            say(text: "shared ")
            try await added(mut held, amount: 7, grants)
            undefer held
            say(text: "shared book ")
            say_ended(try await take held.end(), alloc: grants.alloc)
        })
    })
    given_back(take pool, mut frames)
    given_back(take book_loan, mut frames)
    given_back(take loan, mut frames)
    returned(take extended, mut frames)
    take link.release(mut frames)
    take neighbour.release(mut frames)
    take other.release(mut frames)
    take malformed.release(mut frames)
} shared

/// Holds two books with a gauge in their worlds in one isolation, the second once the first runs,
/// ends the first while the second runs on, then the second, and writes whether the first gave back
/// fewer frames than it lent, its start having drawn the ledger's image while the second still ran
/// it, and the second the rest, its end unmapping the image.
fn images_lent(cpu: hw::Ring0, ledger: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let gauging = gauges::open(grants.clock, alloc: grants.alloc)
    defer gauges::close(take gauging)
    var caps = nanos::Caps.empty(grants.alloc)
    mut nanos::Cap[gauges::Gauge].put(mut caps, key: "gauge", capability: gauges::mint(gauging))
    var first_link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    discard mut first_link.open("book", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var second_link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    discard mut second_link.open("book", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var first_loan = frames_for_job(mut frames, alloc: grants.alloc)
    var second_loan = frames_for_job(mut frames, alloc: grants.alloc)
    let task::Channel(sender: first_running, receiver: first_heard) = task::Channel[u8].bounded(1, alloc: grants.alloc)
    let task::Channel(sender: second_running, receiver: second_heard) = task::Channel[u8].bounded(1, alloc: grants.alloc)
    let task::Channel(sender: first_ending, receiver: end_heard) = task::Channel[u8].bounded(1, alloc: grants.alloc)
    var receivers = Some(Ran(opened: take first_heard, joined: take second_heard, ended: take end_heard))
    discard attempt await nanos::isolate(cpu, tenant: 12, services: services(grants), frames: mut held, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut first_loan, mut second_loan, mut receivers](space: nanos::Isolation) fails task::Cancelled uses wait {
        try await task::scope(grants.exec, body: fn[mut first_loan, mut second_loan, mut receivers](s: task::Scope) fails task::Cancelled uses wait {
            let Some(Ran(opened: opened, joined: joined, ended: ended)) = mut receivers.extract() else {
                return
            }
            let second = s.spawn(fn[mut second_loan, take opened, take ended]() fails task::Cancelled uses wait limits stack 196_608 {
                var running = opened
                discard attempt await mut running.receive()
                var ending = Some(take ended)
                discard attempt await nanos::hold_isolated(space, job: ledger, component: "Book", link: second_link, services: services(grants), caps, checkpoint: None, runner: sys::Runner.denied(), frames: mut second_loan, exec: grants.exec, alloc: grants.alloc, body: fn[mut ending](take instance: nanos::Instance) fails nanos::InstanceError uses wait {
                    var book = instance
                    defer take book.abandon()
                    say(text: "second ")
                    try await added(mut book, amount: 3, grants)
                    discard second_running.offer(0)
                    let Some(gone) = mut ending.extract() else {
                        return
                    }
                    var awaited = gone
                    discard attempt await mut awaited.receive()
                    undefer book
                    say(text: "second book ")
                    say_ended(try await take book.end(), alloc: grants.alloc)
                })
            })
            var waiting = Some(take joined)
            discard attempt await nanos::hold_isolated(space, job: ledger, component: "Book", link: first_link, services: services(grants), caps, checkpoint: None, runner: sys::Runner.denied(), frames: mut first_loan, exec: grants.exec, alloc: grants.alloc, body: fn[mut waiting](take instance: nanos::Instance) fails nanos::InstanceError uses wait {
                var book = instance
                defer take book.abandon()
                say(text: "first ")
                try await added(mut book, amount: 2, grants)
                discard first_running.offer(0)
                let Some(heard) = mut waiting.extract() else {
                    return
                }
                var awaited = heard
                discard attempt await mut awaited.receive()
                undefer book
                say(text: "first book ")
                say_ended(try await take book.end(), alloc: grants.alloc)
            })
            discard first_ending.offer(0)
            try await take second.join()
        })
    })
    match first_loan.len() < LOAN_FRAMES and first_loan.len() + second_loan.len() == 2 * LOAN_FRAMES {
        true => say(text: "the first book gave back fewer frames than it lent, the second the rest\n")
        false => say(text: "the books gave back frames otherwise\n")
    }
    given_back(take held, mut frames)
    given_back(take first_loan, mut frames)
    given_back(take second_loan, mut frames)
    returned(take extended, mut frames)
    take first_link.release(mut frames)
    take second_link.release(mut frames)
} images_lent

/// The receivers through which the books of `images_lent` hear that the first runs, that the second
/// runs and that the first has ended.
struct Ran {
    opened: task::Receiver[u8]
    joined: task::Receiver[u8]
    ended: task::Receiver[u8]
} Ran

/// Has the book fill 1,100 KiB, a reply longer than the first channel of its link carries, and
/// writes the bytes it replies.
fn filled(mut book: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var request = sys::Encoded.empty(grants.alloc)
    let fill = sys::Wire[Ledger].fill(mut request, kibibytes: 1_100)
    say(text: "book filled ")
    let Ok(given) = try await called(mut book, take request, grants) else {
        say(text: "nothing\n")
        return
    }
    match attempt fill.decode(Untrusted.of(given.bytes.view()), handles: given.handles.view(), alloc: grants.alloc) {
        Ok(bytes) => {
            say_number(u64.widen(bytes.len()))
            say(text: "\n")
        }
        Err(_) => say(text: "nothing\n")
    }
} filled

/// Once the book runs, writes into the frame at `outbound`, in which its space writes the first
/// channel of its link, what no runtime writes, then asks the book's health, whose answer has the
/// kernel read it, and writes how the book ended.
fn breached_up(take instance: nanos::Instance, outbound: u64, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    discard try await mut book.health()
    written_as_space(frame: outbound, data: b"\xFF\xFF\xFF\xFF")
    discard attempt await mut book.health()
    undefer book
    say(text: "breaching book ")
    say_ended(try await take book.end(), alloc: grants.alloc)
} breached_up

/// Writes `data` into the ring of the channel frame at `frame` as a space's runtime writes there.
fn written_as_space(frame: u64, data: Slice[u8]) {
    let written = trusted "the frame at `frame` is a channel frame of a link this kernel holds" { hw::Ptr[u64].of_addr(usize.widen(frame)).atomic_load(hw::Order.Acquire) }
    for at in 0..<data.len() {
        let offset = (written + u64.widen(at)) % RING_BYTES
        trusted "the ring of the frame at `frame` holds `RING_BYTES` bytes from `RING_DATA`" { hw::Ptr[u8].of_addr(usize.widen(frame + RING_DATA + offset)).write(data[at]) }
    }
    trusted "the frame at `frame` is a channel frame of a link this kernel holds" { hw::Ptr[u64].of_addr(usize.widen(frame)).atomic_store(written + u64.widen(data.len()), order: hw::Order.Release) }
} written_as_space

/// Holds a book in one space and two tellers, one after the other, in two others, the port 2 of
/// each bridged to the book over a channel the kernel maps into both spaces and the tellers acting
/// through a denied runner: the first relays an amount to the book, has it note through the
/// teller's log, which crosses there and back, weighs payloads past the channel's ring and past
/// a mebibyte there, and dials it amounts to add through the line its world holds, bridged to the
/// book too, until the line's credit of two calls runs out and once the kernel revokes it; a job of
/// the typed bundle then dials it through a line of its own over a bridge of its link, in the first
/// teller's isolation once its clock is revoked; then the kernel writes what no book writes into
/// the channel of the second, which ends the book as breaching it, and the second teller's call
/// through its port reaches its runner instead, while one past what its link's first channel
/// carries fails at once.
fn bridged(cpu: hw::Ring0, ledger: sys::load::Isolated, typed: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let alloc = grants.alloc
    let gauging = gauges::open(grants.clock, alloc)
    defer gauges::close(take gauging)
    var caps = nanos::Caps.empty(alloc)
    mut nanos::Cap[gauges::Gauge].put(mut caps, key: "gauge", capability: gauges::mint(gauging))
    let none = nanos::Caps.empty(alloc)
    let lines = gauges::open_lines(credit: 2, alloc)
    defer gauges::close_lines(take lines)
    let line = gauges::mint_line(lines)
    var teller_caps = nanos::Caps.empty(alloc)
    mut nanos::Cap[gauges::Line].put(mut teller_caps, key: "line", capability: line)
    let job_lines = gauges::open_lines(credit: 1, alloc)
    defer gauges::close_lines(take job_lines)
    var job_caps = nanos::Caps.empty(alloc)
    mut nanos::Cap[gauges::Line].put(mut job_caps, key: "line", capability: gauges::mint_line(job_lines))
    var book_link = nanos::Link.of(next_frame(mut frames), alloc)
    discard mut book_link.open("book", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var teller_link = nanos::Link.of(next_frame(mut frames), alloc)
    discard mut teller_link.open("teller", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var job_link = nanos::Link.of(next_frame(mut frames), alloc)
    var porting = Some(Openings(port: port_frames(mut frames), line: port_frames(mut frames), job: port_frames(mut frames)))
    var book_pool = frames_for_space(mut frames, alloc)
    var book_loan = frames_for_job(mut frames, alloc)
    var book_state = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var teller_pool = frames_for_space(mut frames, alloc)
    var teller_loan = frames_for_job(mut frames, alloc)
    var teller_state = Some(hw::ExtendedState.of(next_frame(mut frames)))
    let task::Channel(sender: inboxes, receiver: inboxed) = task::Channel[nanos::Inbox].bounded(1, alloc)
    let task::Channel(sender: ending, receiver: ended) = task::Channel[u8].bounded(1, alloc)
    var waiting = Some(Waits(inbox: take inboxed, end: take ended))
    discard attempt await task::scope(grants.exec, body: fn[mut book_pool, mut book_loan, mut book_state, mut teller_pool, mut teller_loan, mut teller_state, mut teller_link, mut job_link, mut porting, mut waiting](s: task::Scope) fails task::Cancelled uses wait {
        let book = s.spawn(fn[mut book_pool, mut book_loan, mut book_state]() fails task::Cancelled uses wait limits stack 196_608 {
            discard attempt await nanos::isolate(cpu, tenant: 6, services: services(grants), frames: mut book_pool, extended: mut book_state, exec: grants.exec, alloc, body: fn[mut book_loan](space: nanos::Isolation) fails task::Cancelled uses wait {
                discard attempt await nanos::hold_isolated(space, job: ledger, component: "Book", link: book_link, services: services(grants), caps, checkpoint: None, runner: sys::Runner.denied(), frames: mut book_loan, exec: grants.exec, alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
                    try await bridged_book(take instance, inboxes, ending, grants)
                })
            })
        })
        let Some(Waits(inbox: inboxed_now, end: ended_now)) = mut waiting.extract() else {
            return
        }
        var receiver = inboxed_now
        var book_ended = ended_now
        let Some(inbox) = try await mut receiver.receive() else {
            return
        }
        let Some(openings) = mut porting.extract() else {
            return
        }
        let port = opened_to(mut teller_link, mut job_link, inbox, take openings)
        let Ok(revoker) = attempt sys::revocable(grants.clock) else {
            return
        }
        let served = services(grants)
        let revocable = nanos::Services(clock: revoker.capability(), log: served.log, stdio: served.stdio, random: served.random, fs: served.fs)
        var revoking = Some(take revoker)
        discard attempt await nanos::isolate(cpu, tenant: 7, services: revocable, frames: mut teller_pool, extended: mut teller_state, exec: grants.exec, alloc, body: fn[mut teller_loan, mut revoking](space: nanos::Isolation) fails task::Cancelled uses wait {
            discard attempt await nanos::hold_isolated(space, job: ledger, component: "Teller", link: teller_link, services: served, caps: teller_caps, checkpoint: None, runner: sys::Runner.denied(), frames: mut teller_loan, exec: grants.exec, alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
                try await tellered(take instance, grants, lines, line)
            })
            say_line(text: "line admitted ", line: gauges::mint_line(lines))
            match mut revoking.extract() {
                Some(clock) => take clock.revoke()
                None => {}
            }
            try await job_dialled(space, typed, link: job_link, caps: job_caps, grants, frames: mut teller_loan)
            say_line(text: "job line admitted ", line: gauges::mint_line(job_lines))
        })
        match revoking {
            Some(clock) => take clock.revoke()
            None => {}
        }
        discard attempt await nanos::isolate(cpu, tenant: 7, services: served, frames: mut teller_pool, extended: mut teller_state, exec: grants.exec, alloc, body: fn[mut book_ended, mut teller_loan](space: nanos::Isolation) fails task::Cancelled uses wait {
            discard attempt await nanos::hold_isolated(space, job: ledger, component: "Teller", link: teller_link, services: services(grants), caps: none, checkpoint: None, runner: sys::Runner.denied(), frames: mut teller_loan, exec: grants.exec, alloc, body: fn[mut book_ended](take instance: nanos::Instance) fails nanos::InstanceError uses wait {
                try await breaching(take instance, link: teller_link, port, ended: mut book_ended, grants)
            })
        })
        try await take book.join()
    })
    given_back(take book_pool, mut frames)
    given_back(take book_loan, mut frames)
    given_back(take teller_pool, mut frames)
    given_back(take teller_loan, mut frames)
    returned(take book_state, mut frames)
    returned(take teller_state, mut frames)
    match porting {
        Some(Openings(port: port, line: line_frames, job: job_frames)) => {
            unopened(take port, mut frames)
            unopened(take line_frames, mut frames)
            unopened(take job_frames, mut frames)
        }
        None => {}
    }
    take book_link.release(mut frames)
    take teller_link.release(mut frames)
    take job_link.release(mut frames)
} bridged

/// Writes the calls the kernel of a line admitted, those it made itself and the first byte of the
/// header its last admission ran under.
fn say_line(text: Str, line: gauges::Line) {
    say(text)
    say_number(line.admitted())
    say(text: " relayed ")
    say_number(line.relayed())
    say(text: " under header ")
    say_number(line.headed())
    say(text: "\n")
} say_line

/// Runs the typed job in `space` dialling the book to add 5 through the line `caps` holds, bridged
/// to the book by `link`, and writes the total the book's reply gives.
fn job_dialled(space: nanos::Isolation, typed: sys::load::Isolated, link: nanos::Link, caps: nanos::Caps, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    var call = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].add(mut call, amount: 5)
    let outcome = attempt await nanos::run_isolated(space, job: typed, link, services: services(grants), caps, input: encoded(Ask.Dial(take call.bytes), alloc: grants.alloc), mut frames, exec: grants.exec, alloc: grants.alloc)
    let answer = result_of(take outcome, alloc: grants.alloc)
    say(text: "job dialled ")
    let Ok(Answer.Bytes(reply)) = attempt mem::wire::Codec[Answer].decode(Untrusted.of(answer.view()), alloc: grants.alloc) else {
        say(text: "nothing\n")
        return
    }
    match attempt mem::wire::Codec[Result[u64, Never]].decode(Untrusted.of(reply.view()), alloc: grants.alloc) {
        Ok(Ok(total)) => {
            say_number(total)
            say(text: "\n")
        }
        else => say(text: "nothing\n")
    }
} job_dialled

/// The frames of a bridged channel.
linear struct PortFrames {
    inbound: hw::PhysFrame[4_096]
    outbound: hw::PhysFrame[4_096]
} PortFrames

/// The frames of a bridged channel, from `frames`.
fn port_frames(mut frames: mem::List[hw::PhysFrame[4_096]]) -> PortFrames {
    return PortFrames(inbound: next_frame(mut frames), outbound: next_frame(mut frames))
} port_frames

/// The frames of the channels bridged to the book: the tellers' port 2, the first teller's line
/// and the job's line.
linear struct Openings {
    port: PortFrames
    line: PortFrames
    job: PortFrames
} Openings

/// Opens on `teller_link` the channel of port 2 and that of the line the world holds under `line`,
/// and on `job_link` that of its line, each to the book whose inbox is `inbox`, and gives the
/// index of the port's.
fn opened_to(mut teller_link: nanos::Link, mut job_link: nanos::Link, inbox: nanos::Inbox, take openings: Openings) -> usize {
    let Openings(port: PortFrames(inbound: inbound, outbound: outbound), line: PortFrames(inbound: line_in, outbound: line_out), job: PortFrames(inbound: job_in, outbound: job_out)) = openings
    let port = mut teller_link.open_port(2, to: inbox, take inbound, take outbound)
    discard mut teller_link.open_crossing("line", operation: gauges::DIAL, hash: sys::Wire[Ledger].hash(), to: inbox, inbound: take line_in, outbound: take line_out)
    discard mut job_link.open_crossing("line", operation: gauges::DIAL, hash: sys::Wire[Ledger].hash(), to: inbox, inbound: take job_in, outbound: take job_out)
    return port
} opened_to

/// Gives back to `frames` the frames of a bridged channel no link took.
fn unopened(take port: PortFrames, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    let PortFrames(inbound: inbound, outbound: outbound) = port
    mut frames.push(take inbound)
    mut frames.push(take outbound)
} unopened

/// What the tellers wait for: the book's inbox, and its end.
struct Waits {
    inbox: task::Receiver[nanos::Inbox]
    end: task::Receiver[u8]
} Waits

/// Gives the inbox of the book bridged to the tellers through `inboxes`, steps it while it runs,
/// then writes how it ended and tells `ending`.
fn bridged_book(take instance: nanos::Instance, inboxes: task::Sender[nanos::Inbox], ending: task::Sender[u8], grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    discard attempt await inboxes.send(book.inbox())
    loop {
        let Ok(_) = attempt await book.incoming() else {
            break
        }
        let Ok(_) = attempt await mut book.step() else {
            break
        }
    }
    say(text: "bridged book ")
    say_ended(try await take book.end(), alloc: grants.alloc)
    discard ending.offer(0)
} bridged_book

/// Has the first teller relay 5 to the book, have it note through the teller's log, weigh 3 bytes
/// past 96 KiB there, which stream through the channel, and past 2 MiB, which move through frames of
/// their own, and dial it 2, 3 and 4 through `line`, whose credit admits two calls, then 1 once
/// `lines` revoked it, then writes how the teller ended.
fn tellered(take instance: nanos::Instance, grants: Grants, lines: sys::Minter[gauges::Line, gauges::Lined, u64], line: gauges::Line) fails nanos::InstanceError uses wait {
    var teller = instance
    defer take teller.abandon()
    var relay = sys::Encoded.empty(grants.alloc)
    sys::Wire[Till].relay(mut relay, amount: 5)
    try await till_done(mut teller, request: take relay, grants)
    var note = sys::Encoded.empty(grants.alloc)
    sys::Wire[Till].note(mut note)
    try await till_done(mut teller, request: take note, grants)
    var streamed = sys::Encoded.empty(grants.alloc)
    sys::Wire[Till].weigh(mut streamed, kibibytes: 96)
    try await till_done(mut teller, request: take streamed, grants)
    var moved = sys::Encoded.empty(grants.alloc)
    sys::Wire[Till].weigh(mut moved, kibibytes: 2_048)
    try await till_done(mut teller, request: take moved, grants)
    for amount in 2u32..<5 {
        try await dialled(mut teller, amount, grants)
    }
    gauges::revoke_line(lines, line)
    try await dialled(mut teller, amount: 1, grants)
    undefer teller
    say(text: "teller ")
    say_teller(try await take teller.end(), alloc: grants.alloc)
} tellered

/// Once the second teller runs, its port bridged, writes into the channel of that port what no
/// book writes, then, once the book has ended, has the teller relay 1 and weigh past what the first
/// channel of its link carries, and writes how it ended.
fn breaching(take instance: nanos::Instance, link: nanos::Link, port: usize, mut ended: task::Receiver[u8], grants: Grants) fails nanos::InstanceError uses wait {
    var teller = instance
    defer take teller.abandon()
    discard try await mut teller.health()
    discard attempt link.send(port, data: b"\xFF\xFF\xFF\xFF")
    discard try await mut ended.receive()
    var relay = sys::Encoded.empty(grants.alloc)
    sys::Wire[Till].relay(mut relay, amount: 1)
    try await till_done(mut teller, request: take relay, grants)
    var weighed = sys::Encoded.empty(grants.alloc)
    sys::Wire[Till].weigh(mut weighed, kibibytes: 1_100)
    try await till_done(mut teller, request: take weighed, grants)
    undefer teller
    say(text: "second teller ")
    say_teller(try await take teller.end(), alloc: grants.alloc)
} breaching

/// Has a teller dial `amount` to the book through its line.
fn dialled(mut teller: nanos::Instance, amount: u32, grants: Grants) fails nanos::InstanceError uses wait {
    var dial = sys::Encoded.empty(grants.alloc)
    sys::Wire[Till].dial(mut dial, amount)
    try await till_done(mut teller, request: take dial, grants)
} dialled

/// Has a teller handle a call, start the keyed task it spawns and handle the message that task
/// sends once done.
fn till_done(mut teller: nanos::Instance, take request: sys::Encoded, grants: Grants) fails nanos::InstanceError uses wait {
    var pending = Some(take request)
    try await task::scope(grants.exec, body: fn[mut teller, mut pending](s: task::Scope) fails nanos::InstanceError uses wait {
        let Some(call) = mut pending.extract() else {
            return
        }
        let inbox = teller.inbox()
        let replied = s.spawn(fn[take inbox, take call]() -> Result[Option[sys::Encoded], sys::CallError[Never]] fails task::Cancelled uses wait limits stack 16_384 {
            return try await marked_call(inbox, hash: sys::Wire[Till].hash(), number: 0, take call, alloc: grants.alloc)
        })
        try await teller.incoming()
        discard try await mut teller.step()
        discard try await take replied.join()
    })
    discard try await mut teller.start_keyed()
    try await teller.incoming()
    discard try await mut teller.step()
} till_done

/// Writes how a teller ended.
fn say_teller(take ended: nanos::Ended, alloc: mem::Alloc) {
    match ended {
        nanos::Ended.Returned(_) => say(text: "returned\n")
        else => say_ended(take ended, alloc)
    }
} say_teller

/// Starts the book, calls it and gives a checkpoint of it.
fn started(take instance: nanos::Instance, grants: Grants, gauging: sys::Minter[gauges::Gauge, gauges::Gauged, u64], gauges: Gauges) -> nanos::Checkpoint fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    try await ticked(mut book, reason: sys::ResumeReason.Started)
    try await added(mut book, amount: 5, grants)
    try await noted(mut book, grants)
    try await summed(mut book, grants)
    try await borrowed(mut book, grants)
    try await gauged(mut book, grants, gauging, gauges)
    try await postponed(mut book, grants)
    var echo = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].echo(mut echo, clock: grants.clock)
    match attempt await book.inbox().call(sys::Wire[Ledger].hash(), request: 0, encoding: take echo, alloc: grants.alloc) {
        Err(sys::CallError.Malformed(core::DecodeError.Invalid)) => say(text: "book refused a clock\n")
        else => say(text: "book took a clock\n")
    }
    let checkpoint = try await book.checkpoint()
    say(text: "book checkpoint ")
    say_book(checkpoint.bytes, alloc: grants.alloc)
    undefer book
    say(text: "book ")
    say_ended(try await take book.end(), alloc: grants.alloc)
    return checkpoint
} started

/// Gives the book the log of the noting console, which it notes its total through and gives back,
/// and logs through the log it gives back.
fn noted(mut book: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    let Ok(log) = attempt sys::Log.served(grants.noter) else {
        stop(text: "no note log\n")
    }
    var request = sys::Encoded.empty(grants.alloc)
    let note = sys::Wire[Ledger].note(mut request, log)
    let Ok(reply) = try await called(mut book, take request, grants) else {
        say(text: "book note refused\n")
        return
    }
    match attempt note.decode(Untrusted.of(reply.bytes.view()), handles: reply.handles.view(), alloc: grants.alloc) {
        Ok(given) => given.info("given back", value: true)
        Err(_) => say(text: "book note undecodable\n")
    }
} noted

/// The calls giving the book logs, which lend it four times as many logs as their count, more than
/// its space's table holds the entries of at once.
const SUM_CALLS: u64 = 70

/// Asks the book its total `SUM_CALLS` times, each call giving it four logs lent for that call
/// alone and the log every call gives, and writes how many calls it answered.
fn summed(mut book: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    let Ok(given) = attempt sys::Log.served(grants.noter) else {
        stop(text: "no given log\n")
    }
    var count: u64 = 0
    for _ in 0u64..<SUM_CALLS {
        let one = lender(given)
        defer take one.revoke()
        let two = lender(given)
        defer take two.revoke()
        let three = lender(given)
        defer take three.revoke()
        let four = lender(given)
        defer take four.revoke()
        var request = sys::Encoded.empty(grants.alloc)
        discard sys::Wire[Ledger].sum(mut request, one: one.capability(), two: two.capability(), three: three.capability(), four: four.capability(), given: given)
        match try await called(mut book, take request, grants) {
            Ok(_) => {
                count += 1
            }
            Err(_) => {}
        }
    }
    say(text: "book summed ")
    say_number(count)
    say(text: " calls lending it logs\n")
} summed

/// A revoker of a log deriving from `log`.
fn lender(log: sys::Log) -> sys::Revoker[sys::Log] {
    let Ok(revoker) = attempt sys::revocable(log) else {
        stop(text: "no lent log\n")
    }
    return revoker
} lender

/// Has the book read the log its runner holds as capability 7, tell its runner through port 1, then
/// borrow the log its runner lends there from the keyed task it starts, which sends a tick once it
/// has logged through it.
fn borrowed(mut book: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var request = sys::Encoded.empty(grants.alloc)
    sys::Wire[Ledger].borrow(mut request)
    discard try await called(mut book, take request, grants)
    discard try await mut book.start_keyed()
    try await book.incoming()
    discard try await mut book.step()
    say(text: "book borrowed\n")
} borrowed

/// The gauges the book first held is given: the gauge of its world and the one a call gives it.
struct Gauges derives Copy {
    world: gauges::Gauge
    given: gauges::Gauge
} Gauges

/// Has the book add 5 through the gauge its world holds, 1 through the gauge a call gives it and 10
/// through the one its runner holds as capability 8, and settle its world's gauge from the keyed
/// task it starts, which sends a tick once settled, writing the header that settling ran under;
/// then, once its world's gauge is revoked, add through it again.
fn gauged(mut book: nanos::Instance, grants: Grants, gauging: sys::Minter[gauges::Gauge, gauges::Gauged, u64], gauges: Gauges) fails nanos::InstanceError uses wait {
    var request = sys::Encoded.empty(grants.alloc)
    let gauge = sys::Wire[Ledger].gauge(mut request, amount: 5, given: gauges.given)
    let reply = try await called(mut book, take request, grants)
    say(text: "book gauged ")
    match reply {
        Ok(given) => match attempt gauge.decode(Untrusted.of(given.bytes.view()), handles: given.handles.view(), alloc: grants.alloc) {
            Ok(total) => say_number(total)
            Err(_) => say(text: "nothing")
        }
        Err(_) => say(text: "nothing")
    }
    say(text: "\n")
    discard try await mut book.start_keyed()
    try await book.incoming()
    discard try await mut book.step()
    say(text: "book settled under header ")
    say_number(gauges.world.headed())
    say(text: "\n")
    gauges::revoke(gauging, gauge: gauges.world)
    var again = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].gauge(mut again, amount: 2, given: gauges.given)
    discard try await called(mut book, request: take again, grants)
} gauged

/// Has the book postpone a wait the kernel numbers 4, then settle it, which has the book reply to
/// the wait through its runner.
fn postponed(mut book: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var waiting = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].wait(mut waiting)
    match try await answered(mut book, hash: sys::Wire[Ledger].hash(), number: 4, request: take waiting, grants) {
        Ok(None) => say(text: "book postponed a wait\n")
        else => say(text: "book answered a wait\n")
    }
    var settling = sys::Encoded.empty(grants.alloc)
    sys::Wire[Ledger].settle(mut settling)
    discard try await called(mut book, request: take settling, grants)
} postponed

/// The runner the kernel serves the book: it writes each total the book publishes and each reply
/// it gives, holds the noting console's log as capability 7, which it drops when asked, and lends
/// it through port 1, writing the header of each call and message through that port, holds a
/// gauge as capability 8, answers no call through port 3 before `STALL_NS` have passed, refusing
/// every other operation.
struct Lending {
} Lending

impl Lending: sys::Kind[Lent, u64]

/// What the runner the kernel serves the book holds: the noting console, a gauge, the clock it
/// stalls on and the allocator it decodes through.
struct Lent derives Copy {
    noter: Console
    gauge: gauges::Gauge
    clock: sys::Clock
    alloc: mem::Alloc
} Lent

/// How long the runner the kernel serves the book stalls a call through port 3.
const STALL_NS: u64 = 10_000_000_000

impl Lending: sys::RunnerService

fn Lending.send_to(self, port: u64, hash: sys::ProtocolHash, bytes: Slice[u8], handles: Slice[sys::Handle]) limits stack 4_096 {
    say(text: "told under header ")
    say_number(header_mark())
    say(text: "\n")
} Lending.send_to

fn Lending.call(self, port: u64, hash: sys::ProtocolHash, bytes: Slice[u8], handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::RunnerError uses wait limits stack 4_096 {
    if port == 3 {
        let Some(clock) = sys::reach(self, body: fn(state: Lent, record: u64) => state.clock) else {
            fail sys::RunnerError.Unknown
        }
        try await clock.sleep_ns(STALL_NS)
        fail sys::RunnerError.Unknown
    }
    let Some(log) = lent(self) else {
        fail sys::RunnerError.Unknown
    }
    if port != 1 {
        fail sys::RunnerError.Unknown
    }
    say(text: "lending under header ")
    say_number(header_mark())
    say(text: "\n")
    var reply = sys::Encoded.empty(alloc)
    let lending: Result[u64, u8] = Ok(0)
    mem::wire::Codec[Result[u64, u8]].encode(lending, out: mut reply.bytes)
    mut reply.handles.push(sys::Handle.of(log))
    return reply
} Lending.call

fn Lending.reply(self, request: u64, bytes: Slice[u8], handles: Slice[sys::Handle]) limits stack 4_096 {
    let Some(alloc) = sys::reach(self, body: fn(state: Lent, record: u64) => state.alloc) else {
        return
    }
    var reply = mem::Bytes.empty(alloc)
    mut reply.append(bytes)
    say(text: "replied request ")
    say_number(request)
    match attempt mem::wire::Codec[Result[u64, Never]].decode(Untrusted.of(reply.view()), alloc) {
        Ok(Ok(total)) => {
            say(text: " total ")
            say_number(total)
            say(text: "\n")
        }
        else => say(text: " otherwise\n")
    }
} Lending.reply

fn Lending.publish(self, summary: Slice[u8]) limits stack 4_096 {
    let Some(alloc) = sys::reach(self, body: fn(state: Lent, record: u64) => state.alloc) else {
        return
    }
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(summary)
    let Ok(total) = attempt mem::wire::Codec[u64].decode(Untrusted.of(bytes.view()), alloc) else {
        say(text: "published otherwise\n")
        return
    }
    say(text: "published total ")
    say_number(total)
    say(text: "\n")
} Lending.publish

fn Lending.sync(self) fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Lending.sync

fn Lending.capability(self, id: u64) -> sys::Handle fails sys::RunnerError limits stack 4_096 {
    if id == 8 {
        let Some(gauge) = sys::reach(self, body: fn(state: Lent, record: u64) => state.gauge) else {
            fail sys::RunnerError.Unknown
        }
        return sys::Handle.of(gauge)
    }
    let Some(log) = lent(self) else {
        fail sys::RunnerError.Unknown
    }
    if id != 7 {
        fail sys::RunnerError.Unknown
    }
    return sys::Handle.of(log)
} Lending.capability

fn Lending.drop_capability(self, id: u64) fails sys::RunnerError limits stack 4_096 {
    if id != 7 {
        fail sys::RunnerError.Unknown
    }
} Lending.drop_capability

fn Lending.resource(self, id: u64) -> sys::Held fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Lending.resource

fn Lending.take_resource(self, id: u64) -> sys::Held fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Lending.take_resource

fn Lending.put_resource(self, id: u64, take resource: sys::Held) fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Lending.put_resource

/// The log of the noting console a runner holds, none for a stale runner.
fn lent(runner: Lending) -> Option[sys::Log] {
    let Some(noter) = sys::reach(runner, body: fn(state: Lent, record: u64) => state.noter) else {
        return None
    }
    match attempt sys::Log.served(noter) {
        Ok(log) => return Some(log)
        Err(_) => return None
    }
} lent

/// Restores the book from a checkpoint into a fresh instance and calls it.
fn restored(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    try await ticked(mut book, reason: sys::ResumeReason.Restored)
    try await added(mut book, amount: 7, grants)
    undefer book
    say(text: "book ")
    say_ended(try await take book.end(), alloc: grants.alloc)
} restored

/// Calls a handler of the book that traps, which ends the instance.
fn trapped(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    var zero = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].divide(mut zero, by: 0)
    say(text: "book divided ")
    match attempt await called(mut book, request: take zero, grants) {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    say(text: "book stepped ")
    match attempt await mut book.step() {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    undefer book
    say(text: "book divider ")
    say_ended(try await take book.end(), alloc: grants.alloc)
} trapped

/// The bytes the executor a flooding book is held on draws its tasks' stacks from,
/// and the calls the book makes through port 3 at once.
const FLOOD_BYTES: usize = 2_097_152

const FLOOD_CALLS: u32 = 32

/// Has the book call port 3 from `FLOOD_CALLS` tasks at once, more than the kernel can serve on
/// tasks drawn from `FLOOD_BYTES`, and writes how it ended.
fn flooded(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    var flood = sys::Encoded.empty(grants.alloc)
    sys::Wire[Ledger].flood(mut flood, calls: FLOOD_CALLS)
    discard try await called(mut book, request: take flood, grants)
    discard attempt await mut book.start_keyed()
    discard attempt await book.incoming()
    undefer book
    say(text: "flooding book ")
    match try await take book.end() {
        nanos::Ended.Trapped(trap) => match trap.kind() {
            sys::TrapKind.Exhausted => say(text: "trapped trap.exhausted\n")
            else => say_trap(trap, alloc: grants.alloc)
        }
        else => say(text: "ended otherwise\n")
    }
} flooded

/// Calls a handler of the book that never returns, abandoning the instance from a task of its own
/// while its holder steps the call.
fn abandoned(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    var spin = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].spin(mut spin)
    var pending = Some(take spin)
    var watching = Some(book.domain())
    say(text: "book spun ")
    let outcome = attempt await task::scope(grants.exec, body: fn[mut book, mut pending, mut watching](s: task::Scope) fails nanos::InstanceError uses wait {
        let Some(request) = mut pending.extract() else {
            return
        }
        let Some(watched) = mut watching.extract() else {
            return
        }
        discard s.spawn(fn[take watched]() fails task::Cancelled uses wait limits stack 16_384 {
            try await grants.clock.sleep(10)
            watched.contents().trigger()
        })
        discard try await called(mut book, take request, grants)
    })
    match outcome {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    undefer book
    say(text: "book spinner ")
    say_ended(try await take book.end(), alloc: grants.alloc)
} abandoned

/// Adds to a book held on the link of one abandoned, then ends it.
fn reheld(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    try await added(mut book, amount: 2, grants)
    undefer book
    say(text: "book reheld ")
    say_ended(try await take book.end(), alloc: grants.alloc)
} reheld

/// Resumes the book for a reason, then starts the keyed task its resume spawns and steps the tick
/// that task posts.
fn ticked(mut book: nanos::Instance, reason: sys::ResumeReason) fails nanos::InstanceError uses wait {
    try await mut book.resumed(reason)
    say(text: "book keyed ")
    say_number(u64.widen(try await mut book.start_keyed()))
    say(text: "\n")
    try await book.incoming()
    say(text: "book ticked ")
    match try await mut book.step() {
        true => say(text: "true\n")
        false => say(text: "false\n")
    }
} ticked

/// Adds `amount` to the book and writes the total it answers.
fn added(mut book: nanos::Instance, amount: u32, grants: Grants) fails nanos::InstanceError uses wait {
    var request = sys::Encoded.empty(grants.alloc)
    let add = sys::Wire[Ledger].add(mut request, amount)
    let reply = try await called(mut book, take request, grants)
    say(text: "book added ")
    let Ok(given) = reply else {
        say(text: "nothing\n")
        return
    }
    match attempt add.decode(Untrusted.of(given.bytes.view()), handles: given.handles.view(), alloc: grants.alloc) {
        Ok(total) => {
            say_number(total)
            say(text: "\n")
        }
        Err(_) => say(text: "nothing\n")
    }
} added

/// The reply of the book to a call, which the instance handles in the next step its holder takes,
/// closed when the book postpones it.
fn called(mut book: nanos::Instance, take request: sys::Encoded, grants: Grants) -> Result[sys::Encoded, sys::CallError[Never]] fails nanos::InstanceError uses wait {
    match try await answered(mut book, hash: sys::Wire[Ledger].hash(), number: 0, take request, grants) {
        Ok(Some(reply)) => return Ok(take reply)
        Ok(None) => return Err(sys::CallError.Closed(task::SendError.Closed))
        Err(failure) => return Err(take failure)
    }
} called

/// The reply of an instance to a call of the protocol whose hash is `hash`, numbered `number`, which
/// the instance handles in the next step its holder takes, none when the instance postpones it.
fn answered(mut book: nanos::Instance, hash: sys::ProtocolHash, number: u64, take request: sys::Encoded, grants: Grants) -> Result[Option[sys::Encoded], sys::CallError[Never]] fails nanos::InstanceError uses wait {
    var pending = Some(take request)
    var reply: Result[Option[sys::Encoded], sys::CallError[Never]] = Err(sys::CallError.Closed(task::SendError.Closed))
    try await task::scope(grants.exec, body: fn[mut book, mut pending, mut reply](s: task::Scope) fails nanos::InstanceError uses wait {
        let Some(call) = mut pending.extract() else {
            return
        }
        let inbox = book.inbox()
        let replied = s.spawn(fn[take inbox, take call]() -> Result[Option[sys::Encoded], sys::CallError[Never]] fails task::Cancelled uses wait limits stack 16_384 {
            return try await marked_call(inbox, hash, number, take call, alloc: grants.alloc)
        })
        try await book.incoming()
        discard try await mut book.step()
        reply = try await take replied.join()
    })
    return reply
} answered

/// The header the kernel makes the calls of its tellers' and books' inboxes under.
fn marked() -> sys::Header = sys::Header(bytes: Array[u8, 32].filled(7))

/// The first byte of the running task's header, 0 for none.
fn header_mark() -> u64 {
    let Some(header) = sys::current_header() else {
        return 0
    }
    return u64.widen(header.bytes[0])
} header_mark

/// The reply of an instance to a call of the protocol whose hash is `hash`, numbered `number`,
/// made through `inbox` under the header `marked` gives.
fn marked_call(inbox: nanos::Inbox, hash: sys::ProtocolHash, number: u64, take call: sys::Encoded, alloc: mem::Alloc) -> Result[Option[sys::Encoded], sys::CallError[Never]] fails task::Cancelled uses wait {
    var pending = Some(take call)
    return try await sys::run_headed(marked(), body: fn[mut pending]() -> Result[Option[sys::Encoded], sys::CallError[Never]] fails task::Cancelled uses wait {
        let Some(encoding) = mut pending.extract() else {
            return Err(sys::CallError.Closed(task::SendError.Closed))
        }
        return attempt await inbox.call(hash, request: number, encoding: take encoding, alloc)
    })
} marked_call

/// Grows a hoard past what the first channel of its link carries, checkpoints it and ends it, then
/// restores it from that checkpoint and ends it, writing the bytes each state holds.
fn hoarded(space: nanos::Isolation, job: sys::load::Isolated, link: nanos::Link, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let held = attempt await nanos::hold_isolated(space, job, component: "Hoard", link, services: services(grants), caps: nanos::Caps.empty(grants.alloc), checkpoint: None, runner: sys::Runner.denied(), mut frames, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) -> nanos::Checkpoint fails nanos::InstanceError uses wait {
        var hoard = instance
        defer take hoard.abandon()
        say(text: "hoard grew ")
        try await grown(mut hoard, kibibytes: 1_100, grants)
        let checkpoint = try await hoard.checkpoint()
        say(text: "hoard checkpoint ")
        say_hoard(checkpoint.bytes, alloc: grants.alloc)
        say(text: "hoard checkpoint as its own ")
        match try await hoard.checkpoint_as(checkpoint.schema) {
            Some(own) => say_hoard(own.bytes, alloc: grants.alloc)
            None => say(text: "none\n")
        }
        undefer hoard
        say(text: "hoard ")
        say_hoard_ended(try await take hoard.end(), alloc: grants.alloc)
        return checkpoint
    })
    let Ok(Some(checkpoint)) = held else {
        say(text: "hoard unheld\n")
        return
    }
    discard attempt await nanos::hold_isolated(space, job, component: "Hoard", link, services: services(grants), caps: nanos::Caps.empty(grants.alloc), checkpoint: Some(take checkpoint), runner: sys::Runner.denied(), mut frames, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        var hoard = instance
        defer take hoard.abandon()
        say(text: "hoard restored ")
        try await grown(mut hoard, kibibytes: 0, grants)
        undefer hoard
        say(text: "hoard restored and ")
        say_hoard_ended(try await take hoard.end(), alloc: grants.alloc)
    })
} hoarded

/// Grows a hoard by `kibibytes` and writes the bytes it answers it holds.
fn grown(mut hoard: nanos::Instance, kibibytes: u32, grants: Grants) fails nanos::InstanceError uses wait {
    var request = sys::Encoded.empty(grants.alloc)
    let grow = sys::Wire[Hoarding].grow(mut request, kibibytes)
    let Ok(Some(given)) = try await answered(mut hoard, hash: sys::Wire[Hoarding].hash(), number: 0, take request, grants) else {
        say(text: "nothing\n")
        return
    }
    match attempt grow.decode(Untrusted.of(given.bytes.view()), handles: given.handles.view(), alloc: grants.alloc) {
        Ok(held) => {
            say_number(held)
            say(text: "\n")
        }
        Err(_) => say(text: "nothing\n")
    }
} grown

/// Writes the bytes the hoard whose state `bytes` encodes holds.
fn say_hoard(bytes: mem::Bytes, alloc: mem::Alloc) {
    match attempt mem::wire::Codec[Hoard].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(state) => {
            say_number(u64.widen(state.bytes.len()))
            say(text: "\n")
        }
        Err(_) => say(text: "undecodable\n")
    }
} say_hoard

/// Writes how an instance of the hoard ended.
fn say_hoard_ended(take ended: nanos::Ended, alloc: mem::Alloc) {
    match ended {
        nanos::Ended.Returned(bytes) => {
            say(text: "returned ")
            say_hoard(bytes, alloc)
        }
        nanos::Ended.Trapped(trap) => {
            say(text: "trapped\n")
            say_trap(trap, alloc)
        }
        else => say(text: "ended otherwise\n")
    }
} say_hoard_ended

/// Writes the total and ticks of the book whose state `bytes` encodes.
fn say_book(bytes: mem::Bytes, alloc: mem::Alloc) {
    match attempt mem::wire::Codec[Book].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(state) => {
            say(text: "total ")
            say_number(state.total)
            say(text: " ticks ")
            say_number(state.ticks)
            say(text: "\n")
        }
        Err(_) => say(text: "undecodable\n")
    }
} say_book

/// Writes how an instance of the book ended.
fn say_ended(take ended: nanos::Ended, alloc: mem::Alloc) {
    match ended {
        nanos::Ended.Returned(bytes) => {
            say(text: "returned ")
            say_book(bytes, alloc)
        }
        nanos::Ended.Trapped(trap) => {
            match trap.kind() {
                sys::TrapKind.DivisionByZero => say(text: "trapped trap.division-by-zero\n")
                sys::TrapKind.Bounds => say(text: "trapped trap.bounds\n")
                else => say(text: "trapped otherwise\n")
            }
            say_trap(trap, alloc)
        }
        nanos::Ended.Abandoned => say(text: "abandoned\n")
        else => say(text: "ended otherwise\n")
    }
} say_ended

/// Writes a trap's report.
fn say_trap(trap: sys::Trap, alloc: mem::Alloc) {
    var text = text::String.empty(alloc)
    mut text.write(Dyn[Render].view(trap), budget: 4_096)
    say(text: text.as_str())
} say_trap

/// What a run in a space returned, empty for a run ending otherwise.
fn result_of(take outcome: Result[nanos::Ended, nanos::IsolatedError], alloc: mem::Alloc) -> mem::Bytes {
    match outcome {
        Ok(nanos::Ended.Returned(bytes)) => return bytes
        else => return mem::Bytes.empty(alloc)
    }
} result_of

/// Writes `text`, then the number a typed job answered.
fn say_answer(text: Str, take bytes: mem::Bytes, alloc: mem::Alloc) {
    say(text)
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(Answer.Number(value)) => {
            say_number(value)
            say(text: "\n")
        }
        else => say(text: "nothing\n")
    }
} say_answer

fn encoded[T: Encode](value: T, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return bytes
} encoded

fn bundle_key() -> core::crypto::PublicKey {
    var bytes = Array[u8, 32].filled(0)
    mut bytes.view_mut().copy_from(SIGNER)
    return core::crypto::PublicKey(bytes: bytes)
} bundle_key
