//! The reading of construction text, the form derived `Render` writes, for each kind; a reading gives its values and the code of its failure, zero for none, and whitespace, element lists and their closing bytes read as in JSON.

/// The literals of construction text.
enum ConstructionLiteral derives Copy, Eq, Hash {
    Char
    Text
    Bytes
} ConstructionLiteral

fn ConstructionLiteral.quote(self) -> u8 {
    if self == ConstructionLiteral.Char {
        return b'\''
    }
    return b'"'
} ConstructionLiteral.quote

/// The byte at an address before `end`, -1 at it.
fn construction_byte_at(mut fx: Fx, at: clif::Value, end: clif::Value) -> clif::Value {
    let inside = mut fx.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: end)
    let results = fx.types1(clif::Type.Int64)
    let chosen = mut fx.choose(inside, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let loaded = mut fx1.load(clif::Type.Int8, addr: at, offset: 0)
        let byte = mut fx1.b.uextend(clif::Type.Int64, x: loaded)
        return fx1.list1(byte)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let none = mut fx1.int(clif::Type.Int64, value: -1)
        return fx1.list1(none)
    })
    expect chosen.len() == 1
    return chosen[0]
} construction_byte_at

fn construction_is_digit(mut fx: Fx, byte: clif::Value) -> clif::Value {
    return codecs_in_range(mut fx, value: byte, low: i64.widen(b'0'), high: i64.widen(b'9'))
} construction_is_digit

/// Whether a byte may begin a `WORD`: a letter or `_`.
fn word_start(mut fx: Fx, byte: clif::Value) -> clif::Value {
    let lower = codecs_in_range(mut fx, value: byte, low: i64.widen(b'a'), high: i64.widen(b'z'))
    let upper = codecs_in_range(mut fx, value: byte, low: i64.widen(b'A'), high: i64.widen(b'Z'))
    let underscore = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'_'))
    let letter = mut fx.b.bor(lower, y: upper)
    return mut fx.b.bor(letter, y: underscore)
} word_start

/// Whether a byte follows after whitespace, passing over it when it does.
fn construction_follows(mut fx: Fx, state: clif::Value, byte: u8) -> clif::Value {
    space(mut fx, state)
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let next = construction_byte_at(mut fx, at: pos, end)
    let found = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: next, y: i64.widen(byte))
    mut fx.if_true(found, then: fn(mut fx1: Fx) {
        let after = mut fx1.b.iadd_imm_s(pos, y: 1)
        mut fx1.store(after, addr: state, offset: READER_POS)
    })
    return found
} construction_follows

/// Returns a nonzero failure code from a reading function giving only its code.
fn construction_stop(mut fx: Fx, failed: clif::Value) {
    let bad = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: failed, y: 0)
    mut fx.if_true(bad, then: fn(mut fx1: Fx) {
        let returned = fx1.list1(failed)
        mut fx1.b.ret(returned.view())
    })
} construction_stop

/// Returns `Malformed` from a reading function giving only its code.
fn construction_malformed(mut fx: Fx) {
    let code = json_code(mut fx, code: FAILURE_MALFORMED)
    let returned = fx.list1(code)
    mut fx.b.ret(returned.view())
} construction_malformed

/// A `WORD` after whitespace: at most `capacity` of its bytes written to `buffer` unless it is
/// zero, and its whole length.
fn construction_word(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value) -> Reading {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int64))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.ConstructionWord, take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        word_glue(mut lo1, fx: mut fx1)
    })
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list3(state, b: buffer, c: capacity)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() == 2
    return Reading(value: results[0], failed: results[1])
} construction_word

/// The body of the function reading a word: receives the reader, the buffer and its capacity,
/// and gives the word's whole length and the code of its failure.
fn word_glue(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() == 3
    let state = params[0]
    let buffer = params[1]
    let capacity = params[2]
    let zero = mut fx.ptr(0)
    let peeked = peek(mut fx, state)
    let bad = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: peeked.failed, y: 0)
    mut fx.if_true(bad, then: fn(mut fx1: Fx) {
        let returned = fx1.list2(zero, b: peeked.failed)
        mut fx1.b.ret(returned.view())
    })
    let starts = word_start(mut fx, byte: peeked.value)
    let other = mut fx.b.bxor_imm_s(starts, y: 1)
    mut fx.if_true(other, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: zero, code: FAILURE_MALFORMED)
    })
    let start = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let initial = fx.list1(start)
    let stopped = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 1
        let at = current[0]
        let byte = construction_byte_at(mut fx1, at, end)
        let letter = word_start(mut fx1, byte)
        let digit = construction_is_digit(mut fx1, byte)
        let part = mut fx1.b.bor(letter, y: digit)
        let next = mut fx1.b.iadd_imm_s(at, y: 1)
        let advanced = mut fx1.b.select(part, x: next, y: at)
        return Pass(again: part, next: fx1.list1(advanced))
    })
    expect stopped.len() == 1
    let stop = stopped[0]
    mut fx.store(stop, addr: state, offset: READER_POS)
    let len = mut fx.b.isub(stop, y: start)
    let writing = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: buffer, y: 0)
    mut fx.if_true(writing, then: fn[mut lo](mut fx1: Fx) {
        let kept = mut fx1.b.umin(len, y: capacity)
        let copy_args = fx1.list3(buffer, b: start, c: kept)
        discard mut lo.call_routine(mut fx1, routine: Routine.Copy, args: copy_args.view())
    })
    let none = json_code(mut fx, code: 0)
    let returned = fx.list2(len, b: none)
    mut fx.b.ret(returned.view())
} word_glue

/// A bool: `true` or `false`, `Malformed` for any other word.
fn construction_read_bool(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> Reading {
    let buffer = mut fx.slot(8, align: 1)
    let capacity = mut fx.ptr(8)
    let read = construction_word(mut lo, mut fx, state, buffer, capacity)
    let truth = bytes_equal(mut lo, mut fx, start: buffer, len: read.value, literal: b"true")
    let falsity = bytes_equal(mut lo, mut fx, start: buffer, len: read.value, literal: b"false")
    let either = mut fx.b.bor(truth, y: falsity)
    let ok = succeeded(mut fx, failed: read.failed)
    let malformed = json_code(mut fx, code: FAILURE_MALFORMED)
    let none = json_code(mut fx, code: 0)
    let checked = mut fx.b.select(either, x: none, y: malformed)
    let code = mut fx.b.select(ok, x: checked, y: read.failed)
    return Reading(value: truth, failed: code)
} construction_read_bool

/// The number after whitespace, checked against its grammar: its first byte's address, its
/// end, and whether it has a fraction or an exponent; its digits may hold `_`.
fn construction_number(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> NumberReading {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.ConstructionNumber, take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        construction_number_glue(mut fx1)
    })
    let found = mut fx.slot(24, align: 8)
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list2(state, b: found)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() == 1
    let failed = results[0]
    let start = mut fx.load(PTR, addr: found, offset: 0)
    let end = mut fx.load(PTR, addr: found, offset: 8)
    let fractional = mut fx.load(clif::Type.Int8, addr: found, offset: 16)
    return NumberReading(start: start, end: end, fractional: fractional, failed: failed)
} construction_number

/// The body of the function reading a number: receives the reader and the record its first
/// byte's address, end and whether it has a fraction or an exponent go to, and gives the code
/// of its failure.
fn construction_number_glue(mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() == 2
    let state = params[0]
    let found = params[1]
    let peeked = peek(mut fx, state)
    construction_stop(mut fx, failed: peeked.failed)
    let start = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let lead_sign = construction_byte_at(mut fx, at: start, end)
    let minus = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead_sign, y: i64.widen(b'-'))
    let after_sign = mut fx.b.iadd_imm_s(start, y: 1)
    let integral = mut fx.b.select(minus, x: after_sign, y: start)
    let lead = construction_byte_at(mut fx, at: integral, end)
    let zero_lead = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'0'))
    let results = fx.types1(clif::Type.Int64)
    let integral_ends = mut fx.choose(zero_lead, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let after = mut fx1.b.iadd_imm_s(integral, y: 1)
        return fx1.list1(after)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let after = separated_digits(mut fx1, end, from: integral)
        return fx1.list1(after)
    })
    expect integral_ends.len() == 1
    let at = integral_ends[0]
    let point_byte = construction_byte_at(mut fx, at, end)
    let point = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: point_byte, y: i64.widen(b'.'))
    let fraction_types = fx.types1(clif::Type.Int64)
    let fraction_ends = mut fx.choose(point, results: fraction_types.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let from = mut fx1.b.iadd_imm_s(at, y: 1)
        let after = separated_digits(mut fx1, end, from)
        return fx1.list1(after)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(at)
    })
    expect fraction_ends.len() == 1
    let after_fraction = fraction_ends[0]
    let exponent_byte = construction_byte_at(mut fx, at: after_fraction, end)
    let exponent = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: exponent_byte, y: i64.widen(b'e'))
    let after_exponent = construction_exponent(mut fx, end, exponent, at: after_fraction)
    mut fx.store(after_exponent, addr: state, offset: READER_POS)
    let fractional = mut fx.b.bor(point, y: exponent)
    mut fx.store(start, addr: found, offset: 0)
    mut fx.store(after_exponent, addr: found, offset: 8)
    mut fx.store(fractional, addr: found, offset: 16)
    let none = json_code(mut fx, code: 0)
    let returned = fx.list1(none)
    mut fx.b.ret(returned.view())
} construction_number_glue

/// The address past digits from `from`, `_` standing between two of them, returning
/// `Malformed` when no digit stands at `from`.
fn separated_digits(mut fx: Fx, end: clif::Value, from: clif::Value) -> clif::Value {
    let lead = construction_byte_at(mut fx, at: from, end)
    let digit = construction_is_digit(mut fx, byte: lead)
    let none = mut fx.b.bxor_imm_s(digit, y: 1)
    mut fx.if_true(none, then: fn(mut fx1: Fx) {
        construction_malformed(mut fx1)
    })
    let initial = fx.list1(from)
    let ended = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 1
        let at = current[0]
        let byte = construction_byte_at(mut fx1, at, end)
        let is_digit = construction_is_digit(mut fx1, byte)
        let underscore = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'_'))
        let after = mut fx1.b.iadd_imm_s(at, y: 1)
        let following = construction_byte_at(mut fx1, at: after, end)
        let joined = construction_is_digit(mut fx1, byte: following)
        let separated = mut fx1.b.band(underscore, y: joined)
        let step = mut fx1.b.bor(is_digit, y: separated)
        let advanced = mut fx1.b.select(step, x: after, y: at)
        return Pass(again: step, next: fx1.list1(advanced))
    })
    expect ended.len() == 1
    return ended[0]
} separated_digits

/// The end of a number's exponent when `exponent` holds, `at` its `e`; `at` otherwise.
fn construction_exponent(mut fx: Fx, end: clif::Value, exponent: clif::Value, at: clif::Value) -> clif::Value {
    let results = fx.types1(clif::Type.Int64)
    let chosen = mut fx.choose(exponent, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let after_e = mut fx1.b.iadd_imm_s(at, y: 1)
        let sign = construction_byte_at(mut fx1, at: after_e, end)
        let negative = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: sign, y: i64.widen(b'-'))
        let after = mut fx1.b.iadd_imm_s(after_e, y: 1)
        let from = mut fx1.b.select(negative, x: after, y: after_e)
        let initial = fx1.list1(from)
        let ended = mut fx1.repeat(initial.view(), body: fn(mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() == 1
            let position = current[0]
            let byte = construction_byte_at(mut fx2, at: position, end)
            let digit = construction_is_digit(mut fx2, byte)
            let next = mut fx2.b.iadd_imm_s(position, y: 1)
            let advanced = mut fx2.b.select(digit, x: next, y: position)
            return Pass(again: digit, next: fx2.list1(advanced))
        })
        expect ended.len() == 1
        let to = ended[0]
        let none = mut fx1.b.icmp(clif::IntCC.Equal, x: to, y: from)
        mut fx1.if_true(none, then: fn(mut fx2: Fx) {
            construction_malformed(mut fx2)
        })
        return fx1.list1(to)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(at)
    })
    expect chosen.len() == 1
    return chosen[0]
} construction_exponent

/// An integer without fraction or exponent, `-0` being 0, in 64 bits: `OutOfRange` outside
/// `u64`, or `i64` when signed.
fn construction_read_integer(mut lo: Lowering, mut fx: Fx, state: clif::Value, signed: bool) -> Reading {
    let read = construction_number(mut lo, mut fx, state)
    let ok = succeeded(mut fx, failed: read.failed)
    let results = fx.types2(clif::Type.Int64, b: clif::Type.Int32)
    let parts = mut fx.choose(ok, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return separated_integer(mut fx1, read, signed)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.ptr(0)
        return fx1.list2(zero, b: read.failed)
    })
    expect parts.len() == 2
    return Reading(value: parts[0], failed: parts[1])
} construction_read_integer

/// The value of a number's text read without failure, `_` between its digits, and the code of
/// its failure.
fn separated_integer(mut fx: Fx, read: NumberReading, signed: bool) -> mem::List[clif::Value] {
    let lead = mut fx.load(clif::Type.Int8, addr: read.start, offset: 0)
    let negative = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'-'))
    let after = mut fx.b.iadd_imm_s(read.start, y: 1)
    let from = mut fx.b.select(negative, x: after, y: read.start)
    let zero = mut fx.ptr(0)
    let no = mut fx.int(clif::Type.Int8, value: 0)
    let initial = fx.list3(from, b: zero, c: no)
    let accumulated = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 3
        let at = current[0]
        let value = current[1]
        let overflowed = current[2]
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: read.end)
        let results = fx1.types3(clif::Type.Int64, b: clif::Type.Int64, c: clif::Type.Int8)
        let next = mut fx1.choose(inside, results: results.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return separated_digit(mut fx2, at, value, overflowed)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list3(at, b: value, c: overflowed)
        })
        return Pass(again: inside, next: take next)
    })
    expect accumulated.len() == 3
    let magnitude = accumulated[1]
    let overflowed = accumulated[2]
    var out_of_range = overflowed
    if signed {
        let most_negative = mut fx.int(clif::Type.Int64, value: i64.from_bits(0x8000_0000_0000_0000))
        let most_positive = mut fx.int(clif::Type.Int64, value: 0x7FFF_FFFF_FFFF_FFFF)
        let limit = mut fx.b.select(negative, x: most_negative, y: most_positive)
        let beyond = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: magnitude, y: limit)
        out_of_range = mut fx.b.bor(overflowed, y: beyond)
    } else {
        let nonzero = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: magnitude, y: 0)
        let below = mut fx.b.band(negative, y: nonzero)
        out_of_range = mut fx.b.bor(overflowed, y: below)
    }
    let negated = mut fx.b.ineg(magnitude)
    var value = magnitude
    if signed {
        value = mut fx.b.select(negative, x: negated, y: magnitude)
    }
    let malformed = json_code(mut fx, code: FAILURE_MALFORMED)
    let range = json_code(mut fx, code: FAILURE_OUT_OF_RANGE)
    let none = json_code(mut fx, code: 0)
    let checked = mut fx.b.select(out_of_range, x: range, y: none)
    let code = mut fx.b.select(read.fractional, x: malformed, y: checked)
    return fx.list2(value, b: code)
} separated_integer

/// One more digit or `_` of a number's text at `at` accumulated into `value`: the next address,
/// the value and whether it overflowed.
fn separated_digit(mut fx: Fx, at: clif::Value, value: clif::Value, overflowed: clif::Value) -> mem::List[clif::Value] {
    let byte = mut fx.load(clif::Type.Int8, addr: at, offset: 0)
    let widened = mut fx.b.uextend(clif::Type.Int64, x: byte)
    let underscore = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: widened, y: i64.widen(b'_'))
    let digit = mut fx.b.iadd_imm_s(widened, y: -i64.widen(b'0'))
    let ten = mut fx.ptr(10)
    let scaled = mut fx.b.umul_overflow(value, y: ten)
    let sum = mut fx.b.uadd_overflow(scaled.value, y: digit)
    let over = mut fx.b.bor(scaled.flag, y: sum.flag)
    let now_overflowed = mut fx.b.bor(overflowed, y: over)
    let next = mut fx.b.iadd_imm_s(at, y: 1)
    let kept = mut fx.b.select(underscore, x: value, y: sum.value)
    let still = mut fx.b.select(underscore, x: overflowed, y: now_overflowed)
    return fx.list3(next, b: kept, c: still)
} separated_digit

/// A float: `NaN`, `inf`, `-inf`, or a number rounded to f64, as a value of `float`, the type
/// holding an f64.
fn construction_read_float(mut lo: Lowering, mut fx: Fx, state: clif::Value, float: clif::Type) -> Reading {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.ConstructionFloat, take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        float_glue(mut lo1, fx: mut fx1)
    })
    let out = mut fx.slot(8, align: 8)
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list2(state, b: out)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() == 1
    let value = mut fx.load(float, addr: out, offset: 0)
    return Reading(value: value, failed: results[0])
} construction_read_float

/// The body of the function reading a float: receives the reader and the address its value
/// goes to, and gives the code of its failure.
fn float_glue(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() == 2
    let state = params[0]
    let out = params[1]
    let peeked = peek(mut fx, state)
    construction_stop(mut fx, failed: peeked.failed)
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let after = mut fx.b.iadd_imm_s(pos, y: 1)
    let second = construction_byte_at(mut fx, at: after, end)
    let minus = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: peeked.value, y: i64.widen(b'-'))
    let letter = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: second, y: i64.widen(b'i'))
    let negative = mut fx.b.band(minus, y: letter)
    mut fx.if_true(negative, then: fn(mut fx1: Fx) {
        mut fx1.store(after, addr: state, offset: READER_POS)
    })
    let named_peek = peek(mut fx, state)
    let starts = word_start(mut fx, byte: named_peek.value)
    let named = mut fx.b.bor(negative, y: starts)
    mut fx.if_true(named, then: fn[mut lo](mut fx1: Fx) {
        float_named(mut lo, fx: mut fx1, state, out, negative)
    })
    let read = construction_number(mut lo, mut fx, state)
    construction_stop(mut fx, failed: read.failed)
    let len = mut fx.b.isub(read.end, y: read.start)
    let bits = floats_parse(mut lo, mut fx, start: read.start, len)
    mut fx.store(bits, addr: out, offset: 0)
    let ok_code = json_code(mut fx, code: 0)
    let returned = fx.list1(ok_code)
    mut fx.b.ret(returned.view())
} float_glue

/// Reads a float written as `NaN`, `inf` or `-inf`, `negative` telling whether its `-` was
/// passed over, and returns from the function reading a float.
fn float_named(mut lo: Lowering, mut fx: Fx, state: clif::Value, out: clif::Value, negative: clif::Value) {
    let buffer = mut fx.slot(8, align: 1)
    let capacity = mut fx.ptr(8)
    let read = construction_word(mut lo, mut fx, state, buffer, capacity)
    construction_stop(mut fx, failed: read.failed)
    var value = mut fx.int(clif::Type.Int64, value: 0)
    var known = mut fx.int(clif::Type.Int8, value: 0)
    let not_a_number = named_float(mut lo, mut fx, buffer, len: read.value, spelling: b"NaN", below: false, negative, bits: 0x7FF8_0000_0000_0000, value, known)
    let infinite = named_float(mut lo, mut fx, buffer, len: read.value, spelling: b"inf", below: false, negative, bits: 0x7FF0_0000_0000_0000, value: not_a_number.value, known: not_a_number.known)
    let matched = named_float(mut lo, mut fx, buffer, len: read.value, spelling: b"inf", below: true, negative, bits: 0xFFF0_0000_0000_0000, value: infinite.value, known: infinite.known)
    mut fx.store(matched.value, addr: out, offset: 0)
    let malformed = json_code(mut fx, code: FAILURE_MALFORMED)
    let none = json_code(mut fx, code: 0)
    let checked = mut fx.b.select(matched.known, x: none, y: malformed)
    let returned = fx.list1(checked)
    mut fx.b.ret(returned.view())
} float_named

/// The float word in `buffer` matched against `spelling` and the sign it is read with, whose
/// value has the bits given.
fn named_float(mut lo: Lowering, mut fx: Fx, buffer: clif::Value, len: clif::Value, spelling: Slice[u8], below: bool, negative: clif::Value, bits: u64, value: clif::Value, known: clif::Value) -> FloatWord {
    let same = bytes_equal(mut lo, mut fx, start: buffer, len, literal: spelling)
    var sign = negative
    if not below {
        sign = mut fx.b.bxor_imm_s(negative, y: 1)
    }
    let signed_same = mut fx.b.band(same, y: sign)
    let constant = mut fx.int(clif::Type.Int64, value: i64.from_bits(bits))
    let chosen = mut fx.b.select(signed_same, x: constant, y: value)
    let now_known = mut fx.b.bor(known, y: signed_same)
    return FloatWord(value: chosen, known: now_known)
} named_float

/// A literal after whitespace, its escapes resolved: at most `capacity` of its bytes written
/// to `buffer` unless it is zero, and its whole length.
fn construction_literal(mut lo: Lowering, mut fx: Fx, state: clif::Value, kind: ConstructionLiteral, buffer: clif::Value, capacity: clif::Value) -> Reading {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int64))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.ConstructionLiteral(kind), take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        literal_glue(mut lo1, fx: mut fx1, kind)
    })
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list3(state, b: buffer, c: capacity)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() == 2
    return Reading(value: results[0], failed: results[1])
} construction_literal

/// The reader, buffer, capacity and input end of the function reading a literal, with the zero
/// it gives as length on failure and the scratch room of a char.
struct LiteralRead derives Copy {
    state: clif::Value
    buffer: clif::Value
    capacity: clif::Value
    end: clif::Value
    zero: clif::Value
    scratch: clif::Value
    kind: ConstructionLiteral
} LiteralRead

/// The body of the function reading a literal of a kind: receives the reader, the buffer and
/// its capacity, and gives the literal's whole length and the code of its failure.
fn literal_glue(mut lo: Lowering, mut fx: Fx, kind: ConstructionLiteral) {
    let params = mut fx.entry()
    expect params.len() == 3
    let state = params[0]
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let zero = mut fx.ptr(0)
    var opening = kind.quote()
    if kind == ConstructionLiteral.Bytes {
        opening = b'b'
    }
    let opened = expect_code(mut lo, mut fx, state, expected: opening)
    let failed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: opened, y: 0)
    mut fx.if_true(failed, then: fn(mut fx1: Fx) {
        let returned = fx1.list2(zero, b: opened)
        mut fx1.b.ret(returned.view())
    })
    if kind == ConstructionLiteral.Bytes {
        let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
        let quote = construction_byte_at(mut fx, at: pos, end)
        let other = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: quote, y: i64.widen(b'"'))
        mut fx.if_true(other, then: fn(mut fx1: Fx) {
            string_give_up(mut fx1, len: zero, code: FAILURE_MALFORMED)
        })
        let after = mut fx.b.iadd_imm_s(pos, y: 1)
        mut fx.store(after, addr: state, offset: READER_POS)
    }
    let scratch = mut fx.slot(4, align: 4)
    let read = LiteralRead(state: state, buffer: params[1], capacity: params[2], end: end, zero: zero, scratch: scratch, kind: kind)
    let initial = fx.list1(zero)
    discard mut fx.repeat(initial.view(), body: fn[mut lo](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 1
        return literal_pass(mut lo, fx: mut fx1, read, len: current[0])
    })
    string_give_up(mut fx, len: zero, code: FAILURE_TRUNCATED)
} literal_glue

/// The address of the next byte of a literal and the byte, passed over, giving up with
/// `Truncated` at the input's end.
fn literal_byte(mut fx: Fx, read: LiteralRead) -> mem::List[clif::Value] {
    let pos = mut fx.load(PTR, addr: read.state, offset: READER_POS)
    let at_end = mut fx.b.icmp(clif::IntCC.Equal, x: pos, y: read.end)
    mut fx.if_true(at_end, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: read.zero, code: FAILURE_TRUNCATED)
    })
    let byte = mut fx.load(clif::Type.Int8, addr: pos, offset: 0)
    let after = mut fx.b.iadd_imm_s(pos, y: 1)
    mut fx.store(after, addr: read.state, offset: READER_POS)
    let widened = mut fx.b.uextend(clif::Type.Int64, x: byte)
    return fx.list2(pos, b: widened)
} literal_byte

/// A pass of the loop reading a literal: a char or an escape, the function returning at the
/// closing quote.
fn literal_pass(mut lo: Lowering, mut fx: Fx, read: LiteralRead, len: clif::Value) -> Pass {
    let next = literal_byte(mut fx, read)
    expect next.len() == 2
    let pos = next[0]
    let byte = next[1]
    let closed = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(read.kind.quote()))
    mut fx.if_true(closed, then: fn(mut fx1: Fx) {
        let none = json_code(mut fx1, code: 0)
        let returned = fx1.list2(len, b: none)
        mut fx1.b.ret(returned.view())
    })
    let escape = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'\\'))
    let results = fx.types1(clif::Type.Int64)
    let lens = mut fx.choose_in(mut lo, condition: escape, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return literal_escape(mut lo1, fx: mut fx1, read, len)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return literal_raw(mut lo1, fx: mut fx1, read, pos, byte, len)
    })
    expect lens.len() == 1
    let again = mut fx.int(clif::Type.Int8, value: 1)
    return Pass(again: again, next: fx.list1(lens[0]))
} literal_pass

/// An escape of a literal, its backslash read: the length with what it stands for written.
fn literal_escape(mut lo: Lowering, mut fx: Fx, read: LiteralRead, len: clif::Value) -> mem::List[clif::Value] {
    let next = literal_byte(mut fx, read)
    expect next.len() == 2
    let letter = next[1]
    var scalar = mut fx.int(clif::Type.Int64, value: -1)
    scalar = escape_letter(mut fx, escape: letter, letter: b'\\', meaning: b'\\', scalar)
    scalar = escape_letter(mut fx, escape: letter, letter: b'"', meaning: b'"', scalar)
    scalar = escape_letter(mut fx, escape: letter, letter: b'\'', meaning: b'\'', scalar)
    scalar = escape_letter(mut fx, escape: letter, letter: b'n', meaning: b'\n', scalar)
    scalar = escape_letter(mut fx, escape: letter, letter: b'r', meaning: b'\r', scalar)
    scalar = escape_letter(mut fx, escape: letter, letter: b't', meaning: b'\t', scalar)
    scalar = escape_letter(mut fx, escape: letter, letter: b'0', meaning: 0, scalar)
    let byte_escape = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: letter, y: i64.widen(b'x'))
    let named = scalar
    let results = fx.types1(clif::Type.Int64)
    let hexed = mut fx.choose(byte_escape, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let value = literal_hex(mut fx1, read, least: 2, most: 2)
        if read.kind != ConstructionLiteral.Bytes {
            let wide = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThan, x: value, y: 0x7F)
            mut fx1.if_true(wide, then: fn(mut fx2: Fx) {
                string_give_up(mut fx2, len: read.zero, code: FAILURE_MALFORMED)
            })
        }
        return fx1.list1(value)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(named)
    })
    expect hexed.len() == 1
    scalar = hexed[0]
    if read.kind != ConstructionLiteral.Bytes {
        scalar = literal_unicode(mut fx, read, letter, scalar)
    }
    let unknown = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: scalar, y: -1)
    mut fx.if_true(unknown, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: read.zero, code: FAILURE_MALFORMED)
    })
    var count = scalar
    if read.kind == ConstructionLiteral.Bytes {
        let narrow = mut fx.b.ireduce(clif::Type.Int8, x: scalar)
        mut fx.store(narrow, addr: read.scratch, offset: 0)
        count = mut fx.ptr(1)
    } else {
        let surrogate = codecs_in_range(mut fx, value: scalar, low: 0xD800, high: 0xDFFF)
        let beyond = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThan, x: scalar, y: 0x10_FFFF)
        let invalid = mut fx.b.bor(surrogate, y: beyond)
        mut fx.if_true(invalid, then: fn(mut fx1: Fx) {
            string_give_up(mut fx1, len: read.zero, code: FAILURE_INVALID_TEXT)
        })
        count = encode_utf8(mut fx, c: scalar, buffer: read.scratch)
    }
    let emitted = string_emit(mut lo, mut fx, buffer: read.buffer, capacity: read.capacity, len, from: read.scratch, count)
    return fx.list1(emitted)
} literal_escape

/// The scalar value of a `\u{H}` escape when `letter` is `u`, `scalar` otherwise.
fn literal_unicode(mut fx: Fx, read: LiteralRead, letter: clif::Value, scalar: clif::Value) -> clif::Value {
    let unicode = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: letter, y: i64.widen(b'u'))
    let results = fx.types1(clif::Type.Int64)
    let chosen = mut fx.choose(unicode, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let opening = literal_byte(mut fx1, read)
        expect opening.len() == 2
        let open_other = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: opening[1], y: i64.widen(b'{'))
        mut fx1.if_true(open_other, then: fn(mut fx2: Fx) {
            string_give_up(mut fx2, len: read.zero, code: FAILURE_MALFORMED)
        })
        let value = literal_hex(mut fx1, read, least: 1, most: 6)
        let closing = literal_byte(mut fx1, read)
        expect closing.len() == 2
        let close_other = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: closing[1], y: i64.widen(b'}'))
        mut fx1.if_true(close_other, then: fn(mut fx2: Fx) {
            string_give_up(mut fx2, len: read.zero, code: FAILURE_MALFORMED)
        })
        return fx1.list1(value)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(scalar)
    })
    expect chosen.len() == 1
    return chosen[0]
} literal_unicode

/// Hexadecimal digits up to a byte, at least `least` and at most `most` of them, giving up with
/// `Truncated` or `Malformed`.
fn literal_hex(mut fx: Fx, read: LiteralRead, least: usize, most: usize) -> clif::Value {
    var value = mut fx.ptr(0)
    var done = mut fx.int(clif::Type.Int8, value: 0)
    for index in 0..<most {
        let active = mut fx.b.bxor_imm_s(done, y: 1)
        let results = fx.types2(clif::Type.Int64, b: clif::Type.Int8)
        let so_far = value
        let finished = done
        let parts = mut fx.choose(active, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
            return hex_digit(mut fx1, read, value: so_far, required: index < least)
        }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
            return fx1.list2(so_far, b: finished)
        })
        expect parts.len() == 2
        value = parts[0]
        done = parts[1]
    }
    return value
} literal_hex

/// One more hexadecimal digit of an escape accumulated into `value`, giving up with
/// `Malformed` on another byte when `required`: the value, and whether the digits ended.
fn hex_digit(mut fx: Fx, read: LiteralRead, value: clif::Value, required: bool) -> mem::List[clif::Value] {
    let pos = mut fx.load(PTR, addr: read.state, offset: READER_POS)
    let at_end = mut fx.b.icmp(clif::IntCC.Equal, x: pos, y: read.end)
    mut fx.if_true(at_end, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: read.zero, code: FAILURE_TRUNCATED)
    })
    let loaded = mut fx.load(clif::Type.Int8, addr: pos, offset: 0)
    let byte = mut fx.b.uextend(clif::Type.Int64, x: loaded)
    let digit = codecs_in_range(mut fx, value: byte, low: i64.widen(b'0'), high: i64.widen(b'9'))
    let lower = codecs_in_range(mut fx, value: byte, low: i64.widen(b'a'), high: i64.widen(b'f'))
    let upper = codecs_in_range(mut fx, value: byte, low: i64.widen(b'A'), high: i64.widen(b'F'))
    let letter = mut fx.b.bor(lower, y: upper)
    let is_hex = mut fx.b.bor(digit, y: letter)
    if required {
        let missing = mut fx.b.bxor_imm_s(is_hex, y: 1)
        mut fx.if_true(missing, then: fn(mut fx1: Fx) {
            string_give_up(mut fx1, len: read.zero, code: FAILURE_MALFORMED)
        })
    }
    let from_digit = mut fx.b.iadd_imm_s(byte, y: -i64.widen(b'0'))
    let from_lower = mut fx.b.iadd_imm_s(byte, y: 10 - i64.widen(b'a'))
    let from_upper = mut fx.b.iadd_imm_s(byte, y: 10 - i64.widen(b'A'))
    let lower_or_digit = mut fx.b.select(lower, x: from_lower, y: from_digit)
    let nibble = mut fx.b.select(upper, x: from_upper, y: lower_or_digit)
    let shifted = mut fx.b.ishl_imm_s(value, y: 4)
    let joined = mut fx.b.bor(shifted, y: nibble)
    mut fx.if_true(is_hex, then: fn(mut fx1: Fx) {
        let after = mut fx1.b.iadd_imm_s(pos, y: 1)
        mut fx1.store(after, addr: read.state, offset: READER_POS)
    })
    let ended = mut fx.b.bxor_imm_s(is_hex, y: 1)
    let accumulated = mut fx.b.select(is_hex, x: joined, y: value)
    return fx.list2(accumulated, b: ended)
} hex_digit

/// A char of a literal standing for itself, its lead byte `byte` at `pos` read: the length with
/// it written.
fn literal_raw(mut lo: Lowering, mut fx: Fx, read: LiteralRead, pos: clif::Value, byte: clif::Value, len: clif::Value) -> mem::List[clif::Value] {
    var count = byte
    if read.kind == ConstructionLiteral.Bytes {
        let printable = codecs_in_range(mut fx, value: byte, low: 0x20, high: 0x7E)
        let other = mut fx.b.bxor_imm_s(printable, y: 1)
        mut fx.if_true(other, then: fn(mut fx1: Fx) {
            string_give_up(mut fx1, len: read.zero, code: FAILURE_MALFORMED)
        })
        count = mut fx.ptr(1)
    } else {
        count = literal_char(mut lo, mut fx, read, pos, byte)
    }
    let emitted = string_emit(mut lo, mut fx, buffer: read.buffer, capacity: read.capacity, len, from: pos, count)
    return fx.list1(emitted)
} literal_raw

/// The width of the char a text or char literal holds at `pos`, its lead byte `byte`, passed
/// over: giving up with `InvalidText` on input that is not UTF-8, `Truncated` on a char cut by
/// the input's end and `Malformed` on a char outside `CHARACTER`.
fn literal_char(mut lo: Lowering, mut fx: Fx, read: LiteralRead, pos: clif::Value, byte: clif::Value) -> clif::Value {
    let ascii = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: byte, y: 0x80)
    let two = codecs_in_range(mut fx, value: byte, low: 0xC2, high: 0xDF)
    let three = codecs_in_range(mut fx, value: byte, low: 0xE0, high: 0xEF)
    let four = codecs_in_range(mut fx, value: byte, low: 0xF0, high: 0xF4)
    let ascii_or_two = mut fx.b.bor(ascii, y: two)
    let up_to_three = mut fx.b.bor(ascii_or_two, y: three)
    let known = mut fx.b.bor(up_to_three, y: four)
    let unknown = mut fx.b.bxor_imm_s(known, y: 1)
    mut fx.if_true(unknown, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: read.zero, code: FAILURE_INVALID_TEXT)
    })
    let flags = fx.list3(two, b: three, c: four)
    var width = mut fx.ptr(1)
    for flag in flags {
        let step = mut fx.b.uextend(clif::Type.Int64, x: flag)
        width = mut fx.b.iadd(width, y: step)
    }
    let stop = mut fx.b.iadd(pos, y: width)
    let past = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: stop, y: read.end)
    mut fx.if_true(past, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: read.zero, code: FAILURE_TRUNCATED)
    })
    let valid = utf8_valid(mut lo, mut fx, start: pos, len: width)
    let invalid = mut fx.b.bxor_imm_s(valid, y: 1)
    mut fx.if_true(invalid, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: read.zero, code: FAILURE_INVALID_TEXT)
    })
    let decoded = decode_utf8(mut fx, place: pos, head: byte)
    let control = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: decoded.point, y: 0x20)
    let rejected_point = rejected(mut lo, mut fx, scalar: decoded.point)
    let outside = mut fx.b.bor(control, y: rejected_point)
    mut fx.if_true(outside, then: fn(mut fx1: Fx) {
        string_give_up(mut fx1, len: read.zero, code: FAILURE_MALFORMED)
    })
    mut fx.store(stop, addr: read.state, offset: READER_POS)
    return width
} literal_char

/// The length of the literal that follows, its escapes resolved, the reader staying put.
fn measure_literal(mut lo: Lowering, mut fx: Fx, state: clif::Value, kind: ConstructionLiteral) -> Reading {
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let none = mut fx.ptr(0)
    let read = construction_literal(mut lo, mut fx, state, kind, buffer: none, capacity: none)
    let ok = succeeded(mut fx, failed: read.failed)
    mut fx.if_true(ok, then: fn(mut fx1: Fx) {
        mut fx1.store(pos, addr: state, offset: READER_POS)
    })
    return read
} measure_literal

/// Writes the literal that follows, measured before as `len` bytes, to `destination`.
fn write_literal(mut lo: Lowering, mut fx: Fx, state: clif::Value, kind: ConstructionLiteral, destination: clif::Value, len: clif::Value) {
    discard construction_literal(mut lo, mut fx, state, kind, buffer: destination, capacity: len)
} write_literal

/// A char: a char literal of exactly one char, its scalar value in 64 bits.
fn construction_read_char(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> Reading {
    let buffer = mut fx.slot(8, align: 1)
    let capacity = mut fx.ptr(8)
    let read = construction_literal(mut lo, mut fx, state, kind: ConstructionLiteral.Char, buffer, capacity)
    return one_char(mut fx, buffer, len: read.value, failed: read.failed)
} construction_read_char

/// Opens a record: its name, then whether `(` follows.
fn open_record(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> Reading {
    let none = mut fx.ptr(0)
    let read = construction_word(mut lo, mut fx, state, buffer: none, capacity: none)
    let ok = succeeded(mut fx, failed: read.failed)
    let results = fx.types1(clif::Type.Int8)
    let parens = mut fx.choose(ok, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let opened = construction_follows(mut fx1, state, byte: b'(')
        return fx1.list1(opened)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(no)
    })
    expect parens.len() == 1
    return Reading(value: parens[0], failed: read.failed)
} open_record

/// A record field's key, at most `capacity` bytes of it written to `buffer`, then its colon.
fn construction_read_key(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value) -> Reading {
    let read = construction_word(mut lo, mut fx, state, buffer, capacity)
    let ok = succeeded(mut fx, failed: read.failed)
    let results = fx.types1(clif::Type.Int32)
    let chosen = mut fx.choose(ok, results: results.view(), then: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let colon = expect_code(mut lo, fx: mut fx1, state, expected: b':')
        return fx1.list1(colon)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(read.failed)
    })
    expect chosen.len() == 1
    return Reading(value: read.value, failed: chosen[0])
} construction_read_key

/// A variant's key after its optional name and `.`, at most `capacity` bytes of it written to
/// `buffer`, and whether a payload follows: whether `(` comes next.
fn construction_read_variant(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value) -> VariantReading {
    let read = construction_word(mut lo, mut fx, state, buffer, capacity)
    let ok = succeeded(mut fx, failed: read.failed)
    let results = fx.types3(clif::Type.Int64, b: clif::Type.Int8, c: clif::Type.Int32)
    let parts = mut fx.choose_in(mut lo, condition: ok, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return variant_key(mut lo1, fx: mut fx1, state, buffer, capacity, read)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list3(read.value, b: no, c: read.failed)
    })
    expect parts.len() == 3
    return VariantReading(len: parts[0], payload: parts[1], failed: parts[2])
} construction_read_variant

/// A variant's key after its first word, `read`: the key's length, whether `(` follows, and
/// the code of the failure.
fn variant_key(mut lo: Lowering, mut fx: Fx, state: clif::Value, buffer: clif::Value, capacity: clif::Value, read: Reading) -> mem::List[clif::Value] {
    let named = construction_follows(mut fx, state, byte: b'.')
    let key_types = fx.types2(clif::Type.Int64, b: clif::Type.Int32)
    let key = mut fx.choose_in(mut lo, condition: named, results: key_types.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let second = construction_word(mut lo1, fx: mut fx1, state, buffer, capacity)
        return fx1.list2(second.value, b: second.failed)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let none = json_code(mut fx1, code: 0)
        return fx1.list2(read.value, b: none)
    })
    expect key.len() == 2
    let ok = succeeded(mut fx, failed: key[1])
    let results = fx.types1(clif::Type.Int8)
    let payload = mut fx.choose(ok, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let opened = construction_follows(mut fx1, state, byte: b'(')
        return fx1.list1(opened)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(no)
    })
    expect payload.len() == 1
    return fx.list3(key[0], b: payload[0], c: key[1])
} variant_key

/// Passes over any value, nested no deeper than decoding reads.
fn construction_skip(mut lo: Lowering, mut fx: Fx, state: clif::Value) -> clif::Value {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int32))
    let function = mut lo.glue_function(Glue.ConstructionSkip, take signature, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        construction_skip_glue(mut lo1, fx: mut fx1)
    })
    let reference = mut lo.func_ref(mut fx, id: function)
    let call_args = fx.list1(state)
    let call = mut fx.b.call(reference, args: call_args.view())
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() == 1
    return results[0]
} construction_skip

/// The body of the function passing over a value: receives the reader and gives the code of
/// its failure.
fn construction_skip_glue(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() == 1
    let state = params[0]
    let peeked = peek(mut fx, state)
    construction_stop(mut fx, failed: peeked.failed)
    let byte = peeked.value
    let none = json_code(mut fx, code: 0)
    let pos = mut fx.load(PTR, addr: state, offset: READER_POS)
    let end = mut fx.load(PTR, addr: state, offset: READER_END)
    let after = mut fx.b.iadd_imm_s(pos, y: 1)
    let second = construction_byte_at(mut fx, at: after, end)
    let text = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'"'))
    mut fx.if_true(text, then: fn[mut lo](mut fx1: Fx) {
        skip_literal(mut lo, fx: mut fx1, state, kind: ConstructionLiteral.Text)
    })
    let char_quote = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'\''))
    mut fx.if_true(char_quote, then: fn[mut lo](mut fx1: Fx) {
        let read = construction_read_char(mut lo, fx: mut fx1, state)
        let returned = fx1.list1(read.failed)
        mut fx1.b.ret(returned.view())
    })
    let b = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'b'))
    let quoted = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: second, y: i64.widen(b'"'))
    let bytes = mut fx.b.band(b, y: quoted)
    mut fx.if_true(bytes, then: fn[mut lo](mut fx1: Fx) {
        skip_literal(mut lo, fx: mut fx1, state, kind: ConstructionLiteral.Bytes)
    })
    skip_list(mut lo, mut fx, state, byte, after, opening: b'[', close: b']', none)
    skip_list(mut lo, mut fx, state, byte, after, opening: b'{', close: b'}', none)
    let starts = word_start(mut fx, byte)
    mut fx.if_true(starts, then: fn[mut lo](mut fx1: Fx) {
        skip_construction(mut lo, fx: mut fx1, state, none)
    })
    let minus = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'-'))
    let letter = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: second, y: i64.widen(b'i'))
    let infinite = mut fx.b.band(minus, y: letter)
    mut fx.if_true(infinite, then: fn[mut lo](mut fx1: Fx) {
        skip_infinity(mut lo, fx: mut fx1, state, after, none)
    })
    let number = construction_number(mut lo, mut fx, state)
    let returned = fx.list1(number.failed)
    mut fx.b.ret(returned.view())
} construction_skip_glue

/// Passes over a literal of a kind and returns its code.
fn skip_literal(mut lo: Lowering, mut fx: Fx, state: clif::Value, kind: ConstructionLiteral) {
    let zero = mut fx.ptr(0)
    let read = construction_literal(mut lo, mut fx, state, kind, buffer: zero, capacity: zero)
    let returned = fx.list1(read.failed)
    mut fx.b.ret(returned.view())
} skip_literal

/// Passes over a sequence or map when `byte` opens one, its opening at `after`, then returns
/// `none`.
fn skip_list(mut lo: Lowering, mut fx: Fx, state: clif::Value, byte: clif::Value, after: clif::Value, opening: u8, close: u8, none: clif::Value) {
    let this = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(opening))
    mut fx.if_true(this, then: fn[mut lo](mut fx1: Fx) {
        nest(mut fx1, reader_state: state)
        mut fx1.store(after, addr: state, offset: READER_POS)
        let zero = mut fx1.ptr(0)
        let initial = fx1.list1(zero)
        discard mut fx1.repeat(initial.view(), body: fn[mut lo](mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() == 1
            return skip_element(mut lo, fx: mut fx2, state, index: current[0], opening, close)
        })
        unnest(mut fx1, reader_state: state)
        let returned = fx1.list1(none)
        mut fx1.b.ret(returned.view())
    })
} skip_list

/// A pass of the loop passing over the elements of a sequence, or the entries of a map.
fn skip_element(mut lo: Lowering, mut fx: Fx, state: clif::Value, index: clif::Value, opening: u8, close: u8) -> Pass {
    let read = json_element_follows(mut lo, mut fx, state, index, close)
    construction_stop(mut fx, failed: read.failed)
    mut fx.if_true(read.value, then: fn[mut lo](mut fx1: Fx) {
        let failed = construction_skip(mut lo, fx: mut fx1, state)
        construction_stop(mut fx1, failed)
        if opening == b'{' {
            let colon = expect_code(mut lo, fx: mut fx1, state, expected: b':')
            construction_stop(mut fx1, failed: colon)
            let value_failed = construction_skip(mut lo, fx: mut fx1, state)
            construction_stop(mut fx1, failed: value_failed)
        }
    })
    let next = mut fx.b.iadd_imm_s(index, y: 1)
    return Pass(again: read.value, next: fx.list1(next))
} skip_element

/// Passes over a record or variant beginning with a word, then returns `none`.
fn skip_construction(mut lo: Lowering, mut fx: Fx, state: clif::Value, none: clif::Value) {
    let zero = mut fx.ptr(0)
    let name = construction_word(mut lo, mut fx, state, buffer: zero, capacity: zero)
    construction_stop(mut fx, failed: name.failed)
    let named = construction_follows(mut fx, state, byte: b'.')
    mut fx.if_true(named, then: fn[mut lo](mut fx1: Fx) {
        let key = construction_word(mut lo, fx: mut fx1, state, buffer: zero, capacity: zero)
        construction_stop(mut fx1, failed: key.failed)
    })
    let opened = construction_follows(mut fx, state, byte: b'(')
    let bare = mut fx.b.bxor_imm_s(opened, y: 1)
    mut fx.if_true(bare, then: fn(mut fx1: Fx) {
        let returned = fx1.list1(none)
        mut fx1.b.ret(returned.view())
    })
    nest(mut fx, reader_state: state)
    let initial = fx.list1(zero)
    discard mut fx.repeat(initial.view(), body: fn[mut lo](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 1
        return skip_item(mut lo, fx: mut fx1, state, index: current[0], zero)
    })
    unnest(mut fx, reader_state: state)
    let returned = fx.list1(none)
    mut fx.b.ret(returned.view())
} skip_construction

/// A pass of the loop passing over the items between a record's or variant's parentheses, a
/// field's key and colon first when one comes.
fn skip_item(mut lo: Lowering, mut fx: Fx, state: clif::Value, index: clif::Value, zero: clif::Value) -> Pass {
    let read = json_element_follows(mut lo, mut fx, state, index, close: b')')
    construction_stop(mut fx, failed: read.failed)
    mut fx.if_true(read.value, then: fn[mut lo](mut fx1: Fx) {
        let at = mut fx1.load(PTR, addr: state, offset: READER_POS)
        let key = construction_word(mut lo, fx: mut fx1, state, buffer: zero, capacity: zero)
        let worded = succeeded(mut fx1, failed: key.failed)
        let results = fx1.types1(clif::Type.Int8)
        let labelled = mut fx1.choose(worded, results: results.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let colon = construction_follows(mut fx2, state, byte: b':')
            return fx2.list1(colon)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(no)
        })
        expect labelled.len() == 1
        let unlabelled = mut fx1.b.bxor_imm_s(labelled[0], y: 1)
        mut fx1.if_true(unlabelled, then: fn(mut fx2: Fx) {
            mut fx2.store(at, addr: state, offset: READER_POS)
        })
        let failed = construction_skip(mut lo, fx: mut fx1, state)
        construction_stop(mut fx1, failed)
    })
    let next = mut fx.b.iadd_imm_s(index, y: 1)
    return Pass(again: read.value, next: fx.list1(next))
} skip_item

/// Passes over `-inf`, its `-` at `after` less one, then returns `none`.
fn skip_infinity(mut lo: Lowering, mut fx: Fx, state: clif::Value, after: clif::Value, none: clif::Value) {
    mut fx.store(after, addr: state, offset: READER_POS)
    let buffer = mut fx.slot(8, align: 1)
    let capacity = mut fx.ptr(8)
    let read = construction_word(mut lo, mut fx, state, buffer, capacity)
    construction_stop(mut fx, failed: read.failed)
    let same = bytes_equal(mut lo, mut fx, start: buffer, len: read.value, literal: b"inf")
    let malformed = json_code(mut fx, code: FAILURE_MALFORMED)
    let checked = mut fx.b.select(same, x: none, y: malformed)
    let returned = fx.list1(checked)
    mut fx.b.ret(returned.view())
} skip_infinity
