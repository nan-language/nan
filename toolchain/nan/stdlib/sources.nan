    \\pub fn u64.wrapping_add(self, other: u64) -> u64 limits pure, notrap, terminates
    \\    example (~0u64).wrapping_add(1) == 0
    \\
    \\pub fn u64.wrapping_sub(self, other: u64) -> u64 limits pure, notrap, terminates
