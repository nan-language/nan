//! Merging two versions of a list of lines.

/// The lines of `old` and `new` merged along their longest common subsequence of lines whose old,
/// then new, line numbers are least in lexicographic order: kept lines prefixed with 2 spaces,
/// removed ones `- ` and added ones `+ `, removals first.
pkg fn merged(old: Slice[text::String], new: Slice[text::String], alloc: mem::Alloc) -> mem::List[text::String] {
    var rows = longest_rows(old, new, alloc)
    var lines = mem::List[text::String].empty(alloc)
    var from: usize = 0
    var from_new: usize = 0
    loop {
        let next = next_kept(old, new, rows: mut rows, from, from_new)
        var until = old.len()
        var until_new = new.len()
        match next {
            Some(kept) => {
                until = kept.old
                until_new = kept.new
            }
            None => {}
        }
        for index in from..<until {
            mut lines.push(marked("- ", line: old[index].as_str(), alloc))
        }
        for index in from_new..<until_new {
            mut lines.push(marked("+ ", line: new[index].as_str(), alloc))
        }
        let Some(kept) = next else {
            return lines
        }
        mut lines.push(marked("  ", line: old[kept.old].as_str(), alloc))
        from = kept.old + 1
        from_new = kept.new + 1
    }
} merged

/// The lengths of the longest common subsequences of the lines of `old` and `new` from each pair
/// of positions: a row per position in `old`, the first last, each holding the lengths from the
/// positions in `new`, the last first.
fn longest_rows(old: Slice[text::String], new: Slice[text::String], alloc: mem::Alloc) -> mem::List[mem::List[usize]] {
    var rows = mem::List[mem::List[usize]].empty(alloc)
    var below = mem::List[usize].empty(alloc)
    while below.len() <= new.len() {
        mut below.push(0)
    }
    for step in 0..<old.len() {
        invariant below.len() > new.len()
        let line = old[old.len() - 1 - step].as_str()
        var row = mem::List[usize].empty(alloc)
        var right: usize = 0
        mut row.push(right)
        for column in 0..<new.len() {
            if line == new[new.len() - 1 - column].as_str() {
                expect below[column] <= column
                right = below[column] + 1
            } else if below[column + 1] > right {
                right = below[column + 1]
            }
            mut row.push(right)
        }
        mut rows.push(take below)
        below = row
    }
    mut rows.push(take below)
    return rows
} longest_rows

/// A line kept by the merge, by its index in the old and the new lines.
struct Kept derives Copy {
    old: usize
    new: usize
} Kept

/// The next kept line from `from` and `from_new`: the first old line, then the first new line,
/// that are equal and start a longest common subsequence of what remains. The last of `rows` is
/// the row of `from`; the search takes it and the rows it passes, leaving last the row of the old
/// line after the kept one.
fn next_kept(old: Slice[text::String], new: Slice[text::String], mut rows: mem::List[mem::List[usize]], from: usize, from_new: usize) -> Option[Kept]
    ensures match result {
        Some(kept) => kept.old < old.len() and kept.new < new.len()
        None => true
    }
{
    let Some(current) = mut rows.pop() else {
        expect false
        return None
    }
    expect from_new <= new.len() and current.len() > new.len()
    let remaining = current[current.len() - 1 - from_new]
    if remaining == 0 {
        return None
    }
    for index in from..<old.len() {
        let Some(below) = mut rows.pop() else {
            expect false
            return None
        }
        expect below.len() > new.len()
        for other in from_new..<new.len() {
            if old[index].as_str() == new[other].as_str() and below[below.len() - 2 - other] == remaining - 1 {
                mut rows.push(take below)
                return Some(Kept(old: index, new: other))
            }
        }
    }
    return None
} next_kept

fn marked(sign: Str, line: Str, alloc: mem::Alloc) -> text::String {
    var written = text::String.of(sign, alloc)
    mut written.append(line)
    return written
} marked
