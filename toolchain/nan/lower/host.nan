//! The host targets, whose programs run as processes of an operating system: the glue running a program's entry function as its entry task, and what a stop or a stack overflow does to an interrupted thread's saved registers.

/// The offsets in an interrupted thread's saved context of the registers a stop or fault handler
/// reads and redirects: the register a redirected call passes its argument in, the frame and
/// stack pointers, the instruction pointer, and the link register a leaf's return address lives
/// in where the architecture has one.
struct Context derives Copy {
    arg: u64
    fp: u64
    sp: u64
    ip: u64
    link: Option[u64]
} Context

/// The first result of a call.
fn first_result(take results: mem::List[clif::Value]) -> clif::Value {
    expect results.len() > 0
    return results[0]
} first_result

/// The glue running the entry function as the entry task, and the stack the entry task gets.
struct EntryTask derives Copy {
    glue: object::FuncId
    stack: u64
} EntryTask

/// Declares the glue running the entry function as the entry task, giving it with the stack the
/// entry task gets.
fn entry_task(mut lo: Lowering, program: Program) -> EntryTask {
    let glue = host_entry_glue(mut lo, program)
    let stack_bytes = match lo.ck.fn_sig(program.entry) {
        Some(sig) => match sig.limit_set.stack {
            Some(demanded) => demanded
            None => ENTRY_STACK
        }
        None => ENTRY_STACK
    }
    return EntryTask(glue: glue, stack: stack_bytes)
} entry_task

/// Mints the root grant through the entry landing fn, given `landing` after the grant's address,
/// then starts the entry task, which `entry_task` gave, and runs the executor's scheduler on the
/// calling thread.
fn run_entry(mut lo: Lowering, mut fx: Fx, program: Program, entry: EntryTask, landing: Slice[clif::Value]) {
    let world_ty = lo.std_ty("host", type_name: "World", args: mem::List[ty::Ty].empty(lo.alloc))
    let laid = mut lo.layout_of(world_ty)
    let world = mut fx.slot(laid.contents().size, align: laid.contents().align)
    let landing_id = mut lo.instance(Instance.Nir(item: program.landing_fn, role: nir::Role.Body, index: 0, args: ty::Args.none()))
    let reference = mut lo.call_ref(mut fx, id: landing_id)
    var landing_args = mem::List[clif::Value].empty(fx.alloc)
    mut landing_args.push(world)
    for value in landing {
        mut landing_args.push(value)
    }
    discard mut fx.b.call(reference, args: landing_args.view())
    let env_bytes = if laid.contents().size > 8 {
        laid.contents().size
    } else {
        8
    }
    let env_size = mut fx.ptr(env_bytes)
    let env = first_result(mut lo.call_routine(mut fx, routine: Routine.TaskEnv, args: Array[clif::Value, 1].filled(env_size).view()))
    mut lo.copy(mut fx, dst: env, src: world, size: laid.contents().size, align: laid.contents().align)
    let glue_ref = mut lo.func_ref(mut fx, id: entry.glue)
    let glue_address = mut fx.b.func_addr(PTR, func_ref: glue_ref)
    let state_address = mut lo.state(mut fx)
    let process = mut fx.load(PTR, addr: state_address, offset: STATE_PROCESS)
    let root = mut fx.load(PTR, addr: state_address, offset: STATE_ROOT)
    let zero_word = mut fx.ptr(0)
    let stack_value = mut fx.ptr(entry.stack)
    var spawn_args = Array[clif::Value, 8].filled(zero_word)
    spawn_args[0] = glue_address
    spawn_args[2] = env
    spawn_args[4] = stack_value
    spawn_args[6] = process
    spawn_args[7] = root
    let record = first_result(mut lo.call_routine(mut fx, routine: Routine.Spawn, args: spawn_args.view()))
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
    mut fx.if_true(missing, then: fn[mut lo](mut then_fx: Fx) {
        system_unavailable(mut lo, fx: mut then_fx)
    })
    mut fx.store(record, addr: state_address, offset: STATE_ENTRY_TASK)
    discard mut lo.call_routine(mut fx, routine: Routine.Wake, args: Array[clif::Value, 1].filled(record).view())
    discard mut lo.call_routine(mut fx, routine: Routine.Schedule, args: mem::List[clif::Value].empty(fx.alloc).view())
    mut fx.b.trap(clif::TrapCode(user: 1))
} run_entry

/// The glue the entry task runs: calls the entry function with the root grant, then ends the
/// process with the status its outcome gives.
fn host_entry_glue(mut lo: Lowering, program: Program) -> object::FuncId {
    var signature = clif::Signature.new(CALL_CONV, alloc: lo.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    let id = mut lo.module.declare_function("_NSstack_switch_entry", linkage: object::Linkage.Local, signature)
    let main_instance = Instance.Nir(item: program.entry, role: lo.entry_role(program.entry), index: 0, args: ty::Args.none())
    let abi = mut lo.abi(main_instance)
    let main_id = mut lo.instance(take main_instance)
    mut lo.define(id, signature: take signature, flags: LINES_HIDDEN, build: fn(mut glue_lo: Lowering, mut glue_fx: Fx) {
        let incoming = mut glue_fx.entry()
        expect incoming.len() > 0
        let record = incoming[0]
        let world = mut glue_fx.load(PTR, addr: record, offset: TASK_ENV)
        let Some(failure_ty) = abi.failure else {
            expect false
            return
        }
        let failure_laid = mut glue_lo.layout_of(failure_ty)
        let failure_at = mut glue_fx.slot(failure_laid.contents().size, align: failure_laid.contents().align)
        let reference = mut glue_lo.call_ref(mut glue_fx, id: main_id)
        var main_args = Array[clif::Value, 2].filled(failure_at)
        main_args[1] = world
        let entry_call = mut glue_fx.b.call(reference, args: main_args.view())
        let results = glue_fx.b.inst_results(entry_call, alloc: glue_fx.alloc)
        let state_address = mut glue_lo.state(mut glue_fx)
        let termination = mut glue_fx.load(PTR, addr: state_address, offset: STATE_TERMINATION)
        let requested = mut glue_fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: termination, y: 0)
        mut glue_fx.if_true(requested, then: fn[mut glue_lo](mut then_fx: Fx) {
            discard mut glue_lo.call_routine(mut then_fx, routine: Routine.Exit, args: Array[clif::Value, 1].filled(termination).view())
        })
        expect results.len() > 0
        let failed = mut glue_fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: results[0], y: 0)
        mut glue_fx.if_true(failed, then: fn[mut glue_lo](mut then_fx: Fx) {
            write_err_literal(mut glue_lo, fx: mut then_fx, text: "error: ")
            let failure_held = mut glue_lo.held_at(mut then_fx, ty: failure_ty, address: failure_at)
            let rendered = render_value(mut glue_lo, fx: mut then_fx, ty: failure_ty, value: failure_held, budget: 4_096)
            var written = Array[clif::Value, 2].filled(rendered.buffer)
            written[1] = rendered.len
            discard mut glue_lo.call_routine(mut then_fx, routine: Routine.WriteErr, args: written.view())
            write_err_literal(mut glue_lo, fx: mut then_fx, text: "\n")
            let status = mut then_fx.ptr(1)
            discard mut glue_lo.call_routine(mut then_fx, routine: Routine.Exit, args: Array[clif::Value, 1].filled(status).view())
        })
        let status = match abi.returned {
            Returned.Scalar(_) => mut glue_fx.b.uextend(PTR, x: results[1])
            else => mut glue_fx.ptr(0)
        }
        discard mut glue_lo.call_routine(mut glue_fx, routine: Routine.Exit, args: Array[clif::Value, 1].filled(status).view())
        mut glue_fx.b.ret(mem::List[clif::Value].empty(glue_fx.alloc).view())
    })
    return id
} host_entry_glue

/// Writes a literal text to standard error.
fn write_err_literal(mut lo: Lowering, mut fx: Fx, text: Str) {
    let literal = mut lo.view_literal(mut fx, contents: text.as_bytes())
    let view_at = literal.address_value()
    let start = mut fx.load(PTR, addr: view_at, offset: 0)
    let len = mut fx.load(PTR, addr: view_at, offset: 8)
    var written = Array[clif::Value, 2].filled(start)
    written[1] = len
    discard mut lo.call_routine(mut fx, routine: Routine.WriteErr, args: written.view())
} write_err_literal

/// Stops the task an executor thread runs, interrupted with its registers saved at `context`,
/// when that task is asked to stop, holds no lock, runs on its own stack and has no frame of a
/// function it does not stop inside: the context then resumes in `Stop` on that stack, below the
/// interrupted frame. Otherwise the task runs on, and the stop is asked again later.
fn stop_interrupted(mut lo: Lowering, mut fx: Fx, thread: clif::Value, context: clif::Value, ctx: Context) {
    let record = mut fx.load(PTR, addr: thread, offset: THREAD_CURRENT)
    let running = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
    mut fx.if_true(running, then: fn[mut lo](mut run_fx: Fx) {
        let asked = stop_asked(mut run_fx, record)
        let locks = mut run_fx.load(PTR, addr: thread, offset: THREAD_LOCKS)
        let unlocked = mut run_fx.b.icmp_imm_s(clif::IntCC.Equal, x: locks, y: 0)
        let asked_unlocked = mut run_fx.b.band(asked, y: unlocked)
        let ip = mut run_fx.load(PTR, addr: context, offset: ctx.ip)
        let sp = mut run_fx.load(PTR, addr: context, offset: ctx.sp)
        let fp = mut run_fx.load(PTR, addr: context, offset: ctx.fp)
        let low = mut run_fx.load(PTR, addr: record, offset: TASK_GUARD)
        let base = mut run_fx.load(PTR, addr: record, offset: TASK_STACK)
        let size = mut run_fx.load(PTR, addr: record, offset: TASK_STACK_SIZE)
        let high = mut run_fx.b.iadd(base, y: size)
        let above = mut run_fx.b.icmp(clif::IntCC.UnsignedGreaterThanOrEqual, x: sp, y: low)
        let room = mut run_fx.b.iadd_imm_s(sp, y: 16)
        let below = mut run_fx.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: room, y: high)
        let on_stack = mut run_fx.b.band(above, y: below)
        let stopping = mut run_fx.b.band(asked_unlocked, y: on_stack)
        mut run_fx.if_true(stopping, then: fn[mut lo](mut stop_fx: Fx) {
            var link: Option[clif::Value] = None
            match ctx.link {
                Some(offset) => {
                    link = Some(mut stop_fx.load(PTR, addr: context, offset))
                }
                None => {}
            }
            let at = Interrupted(ip: ip, sp: sp, fp: fp, link: link, low: low, high: high, segment: None)
            let free = stoppable(mut lo, fx: mut stop_fx, at)
            mut stop_fx.if_true(free, then: fn[mut lo](mut then_fx: Fx) {
                stop_resume(mut lo, fx: mut then_fx, ctx, context, record, sp)
            })
        })
    })
} stop_interrupted

/// The rest of `stop_interrupted` once no frame forbids stopping: makes the task resume in `Stop`
/// below the interrupted frame: where the return address lives on the stack, past the red zone
/// and behind a null return; where it lives in the link register, at the aligned stack pointer
/// with that register cleared.
fn stop_resume(mut lo: Lowering, mut fx: Fx, ctx: Context, context: clif::Value, record: clif::Value, sp: clif::Value) {
    var resumed = sp
    match ctx.link {
        Some(link) => {
            resumed = mut fx.b.band_imm_s(sp, y: -16)
            let zero_word = mut fx.ptr(0)
            mut fx.store(zero_word, addr: context, offset: link)
        }
        None => {
            let lowered = mut fx.b.iadd_imm_s(sp, y: -128)
            let aligned = mut fx.b.band_imm_s(lowered, y: -16)
            resumed = mut fx.b.iadd_imm_s(aligned, y: -8)
            let zero_word = mut fx.ptr(0)
            mut fx.store(zero_word, addr: resumed, offset: 0)
        }
    }
    mut fx.store(resumed, addr: context, offset: ctx.sp)
    let stop_id = mut lo.routine(Routine.Stop)
    let stop_ref = mut lo.func_ref(mut fx, id: stop_id)
    let stop_address = mut fx.b.func_addr(PTR, func_ref: stop_ref)
    mut fx.store(stop_address, addr: context, offset: ctx.ip)
    mut fx.store(record, addr: context, offset: ctx.arg)
} stop_resume

/// Whether a fault at address `fault` of a thread interrupted with its registers saved at
/// `context` lies in the guard region of the stack of the task the thread runs, `thread` being
/// zero outside an executor thread; when it does, the context resumes in `OverflowRaise` on the
/// thread's trap stack, as if called at the call whose frame does not fit.
fn overflow_interrupted(mut lo: Lowering, mut fx: Fx, thread: clif::Value, fault: clif::Value, context: clif::Value, ctx: Context) -> clif::Value {
    let inside = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: thread, y: 0)
    let current = mut fx.choose(inside, results: Array[clif::Type, 1].filled(PTR).view(), then: fn(mut yes_fx: Fx) -> mem::List[clif::Value] {
        var running_record = mem::List[clif::Value].empty(yes_fx.alloc)
        mut running_record.push(mut yes_fx.load(PTR, addr: thread, offset: THREAD_CURRENT))
        return running_record
    }, otherwise: fn(mut no_fx: Fx) -> mem::List[clif::Value] {
        var no_record = mem::List[clif::Value].empty(no_fx.alloc)
        mut no_record.push(mut no_fx.ptr(0))
        return no_record
    })
    let record = current[0]
    let running = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
    let guarded = mut fx.choose(running, results: Array[clif::Type, 1].filled(clif::Type.Int8).view(), then: fn(mut yes_fx: Fx) -> mem::List[clif::Value] {
        let base = mut yes_fx.load(PTR, addr: record, offset: TASK_STACK)
        let low = mut yes_fx.load(PTR, addr: record, offset: TASK_GUARD)
        let above = mut yes_fx.b.icmp(clif::IntCC.UnsignedGreaterThanOrEqual, x: fault, y: base)
        let below = mut yes_fx.b.icmp(clif::IntCC.UnsignedLessThan, x: fault, y: low)
        var in_guard = mem::List[clif::Value].empty(yes_fx.alloc)
        mut in_guard.push(mut yes_fx.b.band(above, y: below))
        return in_guard
    }, otherwise: fn(mut no_fx: Fx) -> mem::List[clif::Value] {
        var not_guarded = mem::List[clif::Value].empty(no_fx.alloc)
        mut not_guarded.push(mut no_fx.int(clif::Type.Int8, value: 0))
        return not_guarded
    })
    let in_guard = guarded[0]
    mut fx.if_true(in_guard, then: fn[mut lo](mut raise_fx: Fx) {
        let ip = mut raise_fx.load(PTR, addr: context, offset: ctx.ip)
        let sp = mut raise_fx.load(PTR, addr: context, offset: ctx.sp)
        let fp = mut raise_fx.load(PTR, addr: context, offset: ctx.fp)
        let holding = function_at(mut lo, fx: mut raise_fx, address: ip)
        let entering = mut raise_fx.b.icmp(clif::IntCC.Equal, x: holding.start, y: ip)
        let caller = overflow_caller(mut raise_fx, ctx, context, entering, fault, ip, sp, fp)
        let top = mut raise_fx.load(PTR, addr: thread, offset: THREAD_TRAP_STACK)
        // Resume in `OverflowRaise` on the trap stack as if the faulting site had called it: with
        // the return address where a call leaves it — behind the stack pointer, or in the link
        // register.
        match ctx.link {
            Some(link) => {
                let aligned = mut raise_fx.b.band_imm_s(top, y: -16)
                mut raise_fx.store(aligned, addr: context, offset: ctx.sp)
                mut raise_fx.store(caller[0], addr: context, offset: link)
            }
            None => {
                let entry_slot = mut raise_fx.b.iadd_imm_s(top, y: -8)
                mut raise_fx.store(caller[0], addr: entry_slot, offset: 0)
                mut raise_fx.store(entry_slot, addr: context, offset: ctx.sp)
            }
        }
        mut raise_fx.store(caller[1], addr: context, offset: ctx.fp)
        let raise_id = mut lo.routine(Routine.OverflowRaise)
        let raise_ref = mut lo.func_ref(mut raise_fx, id: raise_id)
        let raise_address = mut raise_fx.b.func_addr(PTR, func_ref: raise_ref)
        mut raise_fx.store(raise_address, addr: context, offset: ctx.ip)
    })
    return in_guard
} overflow_interrupted

/// The caller the faulting call returns to, and that caller's frame pointer: a function faulting
/// as it is entered has not built its frame, so its return address is the one the call left — in
/// the link register where the architecture has one, and otherwise at the stack pointer, unless
/// the push growing the frame is what faulted; a function faulting deeper has its caller in its
/// frame record.
fn overflow_caller(mut fx: Fx, ctx: Context, context: clif::Value, entering: clif::Value, fault: clif::Value, ip: clif::Value, sp: clif::Value, fp: clif::Value) -> mem::List[clif::Value] {
    let caller_types = Array[clif::Type, 2].filled(PTR)
    match ctx.link {
        Some(link) => {
            let address = mut fx.load(PTR, addr: context, offset: link)
            return mut fx.choose(entering, results: caller_types.view(), then: fn(mut yes_fx: Fx) -> mem::List[clif::Value] {
                return yes_fx.list2(address, b: fp)
            }, otherwise: fn(mut no_fx: Fx) -> mem::List[clif::Value] {
                let returns_to = mut no_fx.load(PTR, addr: fp, offset: 8)
                let frame = mut no_fx.load(PTR, addr: fp, offset: 0)
                return no_fx.list2(returns_to, b: frame)
            })
        }
        None => {
            let pushed = mut fx.b.iadd_imm_s(sp, y: -8)
            let calling = mut fx.b.icmp(clif::IntCC.Equal, x: fault, y: pushed)
            return mut fx.choose(entering, results: caller_types.view(), then: fn(mut yes_fx: Fx) -> mem::List[clif::Value] {
                let returns_to = mut yes_fx.load(PTR, addr: sp, offset: 0)
                return yes_fx.list2(returns_to, b: fp)
            }, otherwise: fn(mut no_fx: Fx) -> mem::List[clif::Value] {
                return mut no_fx.choose(calling, results: caller_types.view(), then: fn(mut call_fx: Fx) -> mem::List[clif::Value] {
                    let returns_to = mut call_fx.b.iadd_imm_s(ip, y: 1)
                    return call_fx.list2(returns_to, b: fp)
                }, otherwise: fn(mut body_fx: Fx) -> mem::List[clif::Value] {
                    let returns_to = mut body_fx.load(PTR, addr: fp, offset: 8)
                    let frame = mut body_fx.load(PTR, addr: fp, offset: 0)
                    return body_fx.list2(returns_to, b: frame)
                })
            })
        }
    }
} overflow_caller
