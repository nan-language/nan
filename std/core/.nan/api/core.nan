item "core::Str.slice_bytes"
text "pub proj fn Str.slice_bytes(self, start: usize, end: usize) -> Option[Str] limits pure, notrap, terminates"
text "    ensures match result {"
text "        Some(slice) => start <= end and end <= self.byte_len() and slice.byte_len() == end - start"
text "        None => not (start <= end and end <= self.byte_len() and self.is_char_boundary(start) and self.is_char_boundary(end))"
text "    }"
text "    example \"café\".slice_bytes(0, end: 3) == Some(\"caf\")"
text "    example \"café\".slice_bytes(0, end: 4) == None"
interface "ah54t5t2j2nqnv7tjyybrkzvq3tzvzrvan3on6hfoqfraa6w56gyibe"
digest any "effects none | authority none | may-trap no | terminates"
head "pub proj fn Str.slice_bytes(self, start: usize, end: usize) -> Option[Str] limits pure, notrap, terminates"
accepted "ensures match result {         Some(slice) => start <= end and end <= self.byte_len() and slice.byte_len() == end - start         None => not (start <= end and end <= self.byte_len() and self.is_char_boundary(start) and self.is_char_boundary(end))     }"
accepted "example \"café\".slice_bytes(0, end: 3) == Some(\"caf\")"
