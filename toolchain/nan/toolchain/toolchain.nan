//! The toolchain hash of each language version this implementation implements.

/// The language versions this implementation implements.
pkg const LANGUAGES: Array[u64, 1] = Array[u64, 1].filled(1)

/// The hash standing for the toolchain's source tree: the hash of the canonical encoding of the
/// list of the code roots of the artefacts the running image's `.nan` section holds, in order;
/// `InvalidData` when the image holds no such section or an artefact that does not decode.
pkg fn source_tree(alloc: mem::Alloc) -> hashing::HashValue fails platform::IoError {
    let executable = try platform::read_file("/proc/self/exe", alloc)
    let Some(artefacts) = artefact::image_section(executable.view(), alloc) else {
        fail platform::IoError.InvalidData
    }
    var encoded = mem::Bytes.empty(alloc)
    encoding::uvar(mut encoded, value: u64.widen(artefacts.len()))
    for held in artefacts {
        let Ok(decoded) = artefact::decode(held.view(), alloc) else {
            fail platform::IoError.InvalidData
        }
        encoding::bytes(mut encoded, value: decoded.code_root.view())
    }
    return hashing::HashValue.of(encoded.view())
} source_tree

/// The hash of the canonical encoding of the record of a language version and the toolchain
/// source tree hash.
pkg fn hash(language: u64, tree: hashing::HashValue, alloc: mem::Alloc) -> hashing::HashValue {
    var version = mem::Bytes.empty(alloc)
    encoding::uvar(mut version, value: language)
    var held = mem::Bytes.empty(alloc)
    encoding::bytes(mut held, value: tree.bytes.view())
    var record = encoding::Record.empty(alloc)
    mut record.field(1, content: take version)
    mut record.field(2, content: take held)
    let encoded = take record.finish(alloc)
    return hashing::HashValue.of(encoded.view())
} hash
