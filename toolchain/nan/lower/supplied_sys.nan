//! System capabilities: the root grant, the operations of `sys::Fs`, `sys::Net`, `sys::Clock`, `sys::WallClock`, `sys::Random`, `sys::Log` and `sys::Stdio` through the host platform, in a test image through the sims, or through the kinds serving them, a machine's runtime serving no other file or network operation, the operations of `sys::Runner` through the kinds serving it, capabilities denying every operation, files, listeners and connections, revocation, and the submission of io_uring operations. Each operation checks its capability's entry first, reading its state words through a snapshot and its text through a copy. An `Fs` entry's state is its directory's descriptor, the address and length of its path prefix, and whether it is read-only; a `Net` entry's is the address and length of its host and whether it reaches every host, only that one or none. A file, listener or connection is the entry it was opened through and the holding of its descriptor, or of a kind's record for a served one; a revoker is the holding of its entry or cell.

/// The state word of an `Fs` entry holding whether it is read-only, and of a `Net` entry
/// which hosts it reaches: every host, `SYS_ONLY_HOST` or `SYS_NO_HOST`.
const SYS_FLAGS: u64 = TABLES_ENTRY_STATE + 24
const SYS_ONLY_HOST: i64 = 1
const SYS_NO_HOST: i64 = 2

/// The render budget of a log record's value.
const SYS_LOG_BUDGET: u64 = 1_024

/// `hw::mint_root()`: a new root grant of the target, a `host::World`, `boot::Kernel` or
/// `boot::Machine`.
fn sys_mint_root(mut lo: Lowering, mut fx: Fx) -> Held {
    let grant = lo.root_grant()
    let laid = mut lo.layout_of(grant)
    let slot = mut fx.slot(laid.contents().size, align: laid.contents().align)
    discard mut lo.call_routine(mut fx, routine: Routine.MintRoot, args: Array[clif::Value, 1].filled(slot).view())
    return Held.Address(slot)
} sys_mint_root

fn sys_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) -> bool {
    let path = supply.path.as_str()
    let Some(owner) = path.slice_bytes(0, end: check::last_dot(path).value_or(path.byte_len())) else {
        expect false
        return false
    }
    let member = supply.member()
    if member == "denied" and (owner == "sys::Fs" or owner == "sys::Net" or owner == "sys::WallClock" or owner == "sys::Runner") {
        let handle = tables_denied(mut lo, mut fx)
        let Some(sret) = supply.sret else {
            expect false
            return false
        }
        mut fx.store(handle, addr: sret, offset: 0)
        supply.done(mut lo, mut fx)
        return true
    }
    if member == "served" {
        match owner {
            "sys::Fs" => return served_capability(mut lo, mut fx, supply, kind: TABLES_KIND_FS, interface_name: "FsService")
            "sys::Net" => return served_capability(mut lo, mut fx, supply, kind: TABLES_KIND_NET, interface_name: "NetService")
            "sys::Log" => return served_capability(mut lo, mut fx, supply, kind: TABLES_KIND_LOG, interface_name: "LogService")
            "sys::Clock" => return served_capability(mut lo, mut fx, supply, kind: TABLES_KIND_CLOCK, interface_name: "ClockService")
            "sys::WallClock" => return served_capability(mut lo, mut fx, supply, kind: TABLES_KIND_WALL, interface_name: "WallClockService")
            "sys::Random" => return served_capability(mut lo, mut fx, supply, kind: TABLES_KIND_RANDOM, interface_name: "RandomService")
            "sys::Stdio" => return served_capability(mut lo, mut fx, supply, kind: TABLES_KIND_STDIO, interface_name: "StdioService")
            "sys::Runner" => return served_capability(mut lo, mut fx, supply, kind: TABLES_KIND_RUNNER, interface_name: "RunnerService")
            else => {}
        }
    }
    match owner {
        "sys::Fs" => sys_fs(mut lo, mut fx, supply)
        "sys::Net" => sys_net(mut lo, mut fx, supply)
        "sys::Clock" => sys_clock(mut lo, mut fx, supply)
        "sys::WallClock" => sys_wall_clock(mut lo, mut fx, supply)
        "sys::Random" => sys_random(mut lo, mut fx, supply)
        "sys::Log" => sys_log(mut lo, mut fx, supply)
        "sys::Stdio" => sys_stdio(mut lo, mut fx, supply)
        "sys::Runner" => sys_runner(mut lo, mut fx, supply)
        "sys::fs::File" or "sys::net::Listener" or "sys::net::Conn" => resource(mut lo, mut fx, supply)
        "sys::revocable" or "sys::Revoker" => revocation(mut lo, mut fx, supply)
        "host_platform::submit" => sys_submit(mut lo, mut fx, supply)
        else => return false
    }
    return true
} sys_lower

/// Fails the operation with `Revoked.Stale` when the handle of the capability held at an
/// address is stale.
fn sys_check(mut lo: Lowering, mut fx: Fx, supply: Supply, capability: clif::Value) {
    let handle = mut fx.load(PTR, addr: capability, offset: 0)
    let record = live_entry(mut lo, mut fx, handle)
    let stale = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
} sys_check

/// The state words of the entry of the capability held at an address, failing the operation
/// with `Revoked.Stale` when its handle is stale.
fn sys_checked(mut lo: Lowering, mut fx: Fx, supply: Supply, capability: clif::Value) -> Array[clif::Value, 4] {
    let handle = mut fx.load(PTR, addr: capability, offset: 0)
    let taken = snapshot(mut lo, mut fx, handle)
    let stale = mut fx.b.bxor_imm_s(taken.live, y: 1)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    return taken.words
} sys_checked

/// The snapshot of the entry of the `Fs` or `Net` held at an address, with its method table,
/// failing the operation with `Revoked.Stale` when its handle is stale.
fn sys_checked_served(mut lo: Lowering, mut fx: Fx, supply: Supply, capability: clif::Value) -> Snapshot {
    let handle = mut fx.load(PTR, addr: capability, offset: 0)
    let taken = served_snapshot(mut lo, mut fx, handle)
    let stale = mut fx.b.bxor_imm_s(taken.live, y: 1)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    return taken
} sys_checked_served

/// A copy of the text of the entry of the capability held at an address, which the caller
/// frees, failing the operation with `Revoked.Stale` when its handle is stale.
fn sys_checked_text(mut lo: Lowering, mut fx: Fx, supply: Supply, capability: clif::Value) -> Stretch {
    let handle = mut fx.load(PTR, addr: capability, offset: 0)
    let copy = copy_text(mut lo, mut fx, handle)
    let stale = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: copy.start, y: 0)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    return copy
} sys_checked_text

/// Fails with a failure value of the operation's failure type: the variant of that name, or
/// for a stale handle `Revoked.Stale` itself or the `Revoked` variant holding it.
fn fail_with(mut lo: Lowering, mut fx: Fx, supply: Supply, variant: Str) {
    let Some(failure_ty) = supply.abi.failure else {
        expect false
        return
    }
    var value = Held.Empty
    if variant == "Revoked" {
        let revoked = lo.std_ty("sys", type_name: "Revoked", args: mem::List[ty::Ty].empty(lo.alloc))
        let stale = mut lo.variant_value(mut fx, ty: revoked, variant: "Stale", payload_values: mem::List[Held].empty(lo.alloc).view(), wrapped: None)
        if failure_ty == revoked {
            value = stale
        } else {
            value = mut lo.variant_value(mut fx, ty: failure_ty, variant: "Revoked", payload_values: Array[Held, 1].filled(stale).view(), wrapped: None)
        }
    } else {
        value = mut lo.variant_value(mut fx, ty: failure_ty, variant, payload_values: mem::List[Held].empty(lo.alloc).view(), wrapped: None)
    }
    let Some(failure) = supply.failure else {
        expect false
        return
    }
    mut lo.store_held(mut fx, address: failure, held: value, ty: failure_ty)
    supply.raise_failure(mut fx)
} fail_with

/// Ends the operation after a host platform call: its failure, when it failed, becomes the
/// operation's, and `then` returns its result otherwise.
fn sys_after(mut lo: Lowering, mut fx: Fx, supply: Supply, called: Called, then: fn(mut lo: Lowering, mut fx: Fx, result: Held)) {
    supply.forward_failure(mut lo, mut fx, called)
    then(mut lo, mut fx, result: called.result)
} sys_after

/// A view held in memory: its address and length.
fn sys_view(mut fx: Fx, held: Held) -> Stretch {
    let address = held.address_value()
    let start = mut fx.load(PTR, addr: address, offset: 0)
    let len = mut fx.load(PTR, addr: address, offset: 8)
    return Stretch(start: start, len: len)
} sys_view

/// A new view value of `len` bytes from `start`.
fn new_view(mut fx: Fx, start: clif::Value, len: clif::Value) -> Held {
    let slot = mut fx.slot(16, align: 8)
    mut fx.store(start, addr: slot, offset: 0)
    mut fx.store(len, addr: slot, offset: 8)
    return Held.Address(slot)
} new_view

/// Whether a path has the form a `sys::Fs` path has: relative segments separated by `/`, none
/// empty, `.`, `..` or holding a NUL.
fn valid_path(mut fx: Fx, start: clif::Value, len: clif::Value) -> clif::Value {
    let zero = mut fx.ptr(0)
    let valid = mut fx.int(clif::Type.Int8, value: 1)
    var initial = Array[clif::Value, 4].filled(zero)
    initial[3] = valid
    let state = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 4
        let index = current[0]
        let segment = current[1]
        let dots = current[2]
        let still_valid = current[3]
        let inside = mut fx1.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: index, y: len)
        let going = mut fx1.b.band(inside, y: still_valid)
        var state_types = Array[clif::Type, 4].filled(PTR)
        state_types[3] = clif::Type.Int8
        let next = mut fx1.choose(going, results: state_types.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let at_end = mut fx2.b.icmp(clif::IntCC.Equal, x: index, y: len)
            let byte_values = mut fx2.choose(at_end, results: Array[clif::Type, 1].filled(clif::Type.Int8).view(), then: fn(mut fx3: Fx) -> mem::List[clif::Value] {
                var slash = mem::List[clif::Value].empty(fx3.alloc)
                mut slash.push(mut fx3.int(clif::Type.Int8, value: i64.widen(b'/')))
                return slash
            }, otherwise: fn(mut fx3: Fx) -> mem::List[clif::Value] {
                let address = mut fx3.b.iadd(start, y: index)
                var loaded = mem::List[clif::Value].empty(fx3.alloc)
                mut loaded.push(mut fx3.load(clif::Type.Int8, addr: address, offset: 0))
                return loaded
            })
            expect byte_values.len() == 1
            let byte = byte_values[0]
            let separator = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'/'))
            let nul = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: 0)
            let dot = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: byte, y: i64.widen(b'.'))
            let empty = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: segment, y: 0)
            let all_dots = mut fx2.b.icmp(clif::IntCC.Equal, x: dots, y: segment)
            let short = mut fx2.b.icmp_imm_s(clif::IntCC.UnsignedLessThanOrEqual, x: segment, y: 2)
            let dotted = mut fx2.b.band(all_dots, y: short)
            let bad_segment = mut fx2.b.bor(empty, y: dotted)
            let bad_end = mut fx2.b.band(separator, y: bad_segment)
            let bad = mut fx2.b.bor(bad_end, y: nul)
            let still = mut fx2.b.bxor_imm_s(bad, y: 1)
            let kept_valid = mut fx2.b.band(still_valid, y: still)
            let grown = mut fx2.b.iadd_imm_s(segment, y: 1)
            let restart = mut fx2.ptr(0)
            let next_segment = mut fx2.b.select(separator, x: restart, y: grown)
            let more_dots = mut fx2.b.iadd_imm_s(dots, y: 1)
            let counted_dots = mut fx2.b.select(dot, x: more_dots, y: dots)
            let next_dots = mut fx2.b.select(separator, x: restart, y: counted_dots)
            var stepped = mem::List[clif::Value].empty(fx2.alloc)
            mut stepped.push(mut fx2.b.iadd_imm_s(index, y: 1))
            mut stepped.push(next_segment)
            mut stepped.push(next_dots)
            mut stepped.push(kept_valid)
            return stepped
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            var unchanged = mem::List[clif::Value].empty(fx2.alloc)
            mut unchanged.push(index)
            mut unchanged.push(segment)
            mut unchanged.push(dots)
            mut unchanged.push(still_valid)
            return unchanged
        })
        return Pass(again: going, next: take next)
    })
    expect state.len() == 4
    return state[3]
} valid_path

fn sys_fs(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let capability = supply.param(0).address_value()
    let taken = sys_checked_served(mut lo, mut fx, supply, capability)
    let words = taken.words
    let directory = words[0]
    let member = supply.member()
    if member == "create" or member == "write_all" or member == "remove" {
        let read_only = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: words[3], y: 0)
        mut fx.if_true(read_only, then: fn[mut lo](mut fx1: Fx) {
            fail_with(mut lo, fx: mut fx1, supply, variant: "Denied")
        })
    }
    if member == "subdir" or member == "open" or member == "create" or member == "read_all" or member == "write_all" or member == "remove" {
        let path = sys_view(mut fx, held: supply.param(1))
        let valid = valid_path(mut fx, start: path.start, len: path.len)
        let invalid = mut fx.b.bxor_imm_s(valid, y: 1)
        mut fx.if_true(invalid, then: fn[mut lo](mut fx1: Fx) {
            fail_with(mut lo, fx: mut fx1, supply, variant: "InvalidPath")
        })
    }
    if member == "subdir" {
        let path = sys_view(mut fx, held: supply.param(1))
        let floor = mut fx.ptr(0)
        attenuate(mut lo, mut fx, supply, word: SYS_FLAGS, floor, text: Some(path))
        return
    }
    if member == "read_only" {
        let floor = mut fx.ptr(1)
        attenuate(mut lo, mut fx, supply, word: SYS_FLAGS, floor, text: None)
        return
    }
    let Some(table) = taken.table else {
        expect false
        return
    }
    let kind = ServingKind(service: directory, table: table)
    let served = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: kind.table, y: 0)
    if lo.kernel() {
        let unserved = mut fx.b.bxor_imm_s(served, y: 1)
        mut fx.if_true(unserved, then: fn[mut lo](mut fx1: Fx) {
            fail_with(mut lo, fx: mut fx1, supply, variant: "Denied")
        })
        served_fs(mut lo, mut fx, supply, capability, kind)
        return
    }
    mut fx.if_true(served, then: fn[mut lo](mut fx1: Fx) {
        served_fs(mut lo, fx: mut fx1, supply, capability, kind)
    })
    if lo.seeded() {
        match member {
            "open" or "create" => fs_open(mut lo, mut fx, supply, index: directory, creates: member == "create")
            "read_all" => read_all(mut lo, mut fx, supply, index: directory)
            "write_all" => fs_write_all(mut lo, mut fx, supply, index: directory)
            "remove" => fs_remove(mut lo, mut fx, supply, index: directory)
            else => {
                expect false
            }
        }
        return
    }
    sys_fs_platform(mut lo, mut fx, supply, capability, directory)
} sys_fs

/// An operation of an `Fs` opening, reading, writing or removing a file through the host
/// platform, in the directory whose descriptor is `directory`.
fn sys_fs_platform(mut lo: Lowering, mut fx: Fx, supply: Supply, capability: clif::Value, directory: clif::Value) {
    let member = supply.member()
    let prefix = sys_checked_text(mut lo, mut fx, supply, capability)
    let directory_fd = mut fx.b.ireduce(clif::Type.Int32, x: directory)
    let directory_held = Held.Scalar(directory_fd)
    let path = new_view(mut fx, start: prefix.start, len: prefix.len)
    var args = mem::List[Held].empty(fx.alloc)
    mut args.push(directory_held)
    mut args.push(path)
    mut args.push(supply.param(1))
    var name = "fs_remove"
    if member == "open" {
        name = "fs_open"
    } else if member == "create" {
        name = "fs_create"
    } else if member == "read_all" {
        name = "fs_read_all"
        mut args.push(supply.param(2))
    } else if member == "write_all" {
        name = "fs_write_all"
        mut args.push(supply.param(2))
    }
    let called = mut lo.platform_call(mut fx, name, args: args.view())
    mut lo.record_free(mut fx, address: prefix.start)
    sys_after(mut lo, mut fx, supply, called, then: fn(mut lo1: Lowering, mut fx1: Fx, result: Held) {
        if member == "open" or member == "create" {
            let handle = mut fx1.load(PTR, addr: capability, offset: 0)
            let fd = mut fx1.b.sextend(PTR, x: result.scalar_value())
            ret_resource(mut lo1, fx: mut fx1, supply, handle, descriptor: fd)
        } else if member == "read_all" {
            supply.ret(mut lo1, fx: mut fx1, held: result)
        } else {
            supply.done(mut lo1, fx: mut fx1)
        }
    })
} sys_fs_platform

/// Returns a file, listener or connection: the entry it was opened through and the holding of
/// a descriptor or sim, which settlement closes, or abandons for a connection.
fn ret_resource(mut lo: Lowering, mut fx: Fx, supply: Supply, handle: clif::Value, descriptor: clif::Value) {
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    mut fx.store(handle, addr: sret, offset: 0)
    let abandons = lo.ck.is_std(supply.abi.result, path: "sys::net::Conn")
    var kind = HOLDINGS_KIND_CLOSE
    if abandons {
        kind = HOLDINGS_KIND_ABANDON
    }
    let kind_value = mut fx.ptr(u64.fit(kind))
    var hold_args = Array[clif::Value, 2].filled(kind_value)
    hold_args[1] = descriptor
    let holding_values = mut lo.call_routine(mut fx, routine: Routine.Hold, args: hold_args.view())
    expect holding_values.len() == 1
    let holding = holding_values[0]
    mut fx.store(holding, addr: sret, offset: 8)
    supply.done(mut lo, mut fx)
} ret_resource

/// The descriptor of the resource at an address.
fn sys_descriptor(mut fx: Fx, address: clif::Value) -> clif::Value {
    let holding = mut fx.offset(address, offset: 8)
    let descriptor = holdings_payload(mut fx, address: holding)
    return mut fx.b.ireduce(clif::Type.Int32, x: descriptor)
} sys_descriptor

fn sys_net(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let capability = supply.param(0).address_value()
    let taken = sys_checked_served(mut lo, mut fx, supply, capability)
    let network = taken.words[0]
    let hosts = taken.words[3]
    let Some(table) = taken.table else {
        expect false
        return
    }
    let kind = ServingKind(service: network, table: table)
    let served = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: kind.table, y: 0)
    if lo.kernel() and supply.member() != "only_host" {
        let unserved = mut fx.b.bxor_imm_s(served, y: 1)
        mut fx.if_true(unserved, then: fn[mut lo](mut fx1: Fx) {
            fail_with(mut lo, fx: mut fx1, supply, variant: "Denied")
        })
    }
    match supply.member() {
        "only_host" => {
            let reached = sys_reaches(mut lo, mut fx, supply, capability, hosts, host: supply.param(1))
            let only = mut fx.int(PTR, value: SYS_ONLY_HOST)
            let none = mut fx.int(PTR, value: SYS_NO_HOST)
            let floor = mut fx.b.select(reached, x: only, y: none)
            let host = sys_view(mut fx, held: supply.param(1))
            attenuate(mut lo, mut fx, supply, word: SYS_FLAGS, floor, text: Some(host))
        }
        "listen" => {
            let restricted = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: hosts, y: 0)
            mut fx.if_true(restricted, then: fn[mut lo](mut fx1: Fx) {
                fail_with(mut lo, fx: mut fx1, supply, variant: "Denied")
            })
            if lo.kernel() {
                served_net(mut lo, mut fx, supply, capability, kind)
                return
            }
            mut fx.if_true(served, then: fn[mut lo](mut fx1: Fx) {
                served_net(mut lo, fx: mut fx1, supply, capability, kind)
            })
            if lo.seeded() {
                listen(mut lo, mut fx, supply, network)
                return
            }
            let called = mut lo.platform_call(mut fx, name: "net_listen", args: Array[Held, 1].filled(supply.param(1)).view())
            sys_after(mut lo, mut fx, supply, called, then: fn(mut lo1: Lowering, mut fx1: Fx, result: Held) {
                let handle = mut fx1.load(PTR, addr: capability, offset: 0)
                let fd = mut fx1.b.sextend(PTR, x: result.scalar_value())
                ret_resource(mut lo1, fx: mut fx1, supply, handle, descriptor: fd)
            })
        }
        "connect" => {
            let host = supply.param(1)
            let reached = sys_reaches(mut lo, mut fx, supply, capability, hosts, host)
            let denied = mut fx.b.bxor_imm_s(reached, y: 1)
            mut fx.if_true(denied, then: fn[mut lo](mut fx1: Fx) {
                fail_with(mut lo, fx: mut fx1, supply, variant: "Denied")
            })
            if lo.kernel() {
                served_net(mut lo, mut fx, supply, capability, kind)
                return
            }
            mut fx.if_true(served, then: fn[mut lo](mut fx1: Fx) {
                served_net(mut lo, fx: mut fx1, supply, capability, kind)
            })
            if lo.seeded() {
                connect(mut lo, mut fx, supply, network)
                return
            }
            var connect_args = Array[Held, 2].filled(host)
            connect_args[1] = supply.param(2)
            let called = mut lo.platform_call(mut fx, name: "net_connect", args: connect_args.view())
            sys_after(mut lo, mut fx, supply, called, then: fn(mut lo1: Lowering, mut fx1: Fx, result: Held) {
                let handle = mut fx1.load(PTR, addr: capability, offset: 0)
                let fd = mut fx1.b.sextend(PTR, x: result.scalar_value())
                ret_resource(mut lo1, fx: mut fx1, supply, handle, descriptor: fd)
            })
        }
        else => {
            expect false
        }
    }
} sys_net

/// Whether the `Net` held at `capability`, whose entry's flags word is `hosts`, reaches
/// `host`: compared byte for byte with its own host when it reaches only that one.
fn sys_reaches(mut lo: Lowering, mut fx: Fx, supply: Supply, capability: clif::Value, hosts: clif::Value, host: Held) -> clif::Value {
    let only = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: hosts, y: SYS_ONLY_HOST)
    let results = fx.types1(clif::Type.Int8)
    let reached = mut fx.choose(only, results: results.view(), then: fn[mut lo](mut fx1: Fx) -> mem::List[clif::Value] {
        let copy = sys_checked_text(mut lo, fx: mut fx1, supply, capability)
        let stored = new_view(mut fx1, start: copy.start, len: copy.len)
        let same = mut lo.views_equal(mut fx1, left: stored, right: host)
        mut lo.record_free(mut fx1, address: copy.start)
        return fx1.list1(same)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let unrestricted = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: hosts, y: 0)
        return fx1.list1(unrestricted)
    })
    return reached[0]
} sys_reaches

fn sys_clock(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let capability = supply.param(0).address_value()
    let handle = mut fx.load(PTR, addr: capability, offset: 0)
    let taken = snapshot(mut lo, mut fx, handle)
    let minted = taken.words[0]
    let resolution = taken.words[1]
    let kind = ServingKind(service: taken.words[2], table: taken.words[3])
    let stale = mut fx.b.bxor_imm_s(taken.live, y: 1)
    let served = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: kind.table, y: 0)
    let member = supply.member()
    match member {
        "elapsed_ms" or "elapsed_ns" => {
            mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
                fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
            })
            mut fx.if_true(served, then: fn[mut lo](mut fx1: Fx) {
                let called = served_call(mut lo, fx: mut fx1, interface_name: "ClockService", method: "elapsed_ns", kind, args: mem::List[Held].empty(fx1.alloc).view())
                let reading = round_down(mut fx1, resolution, reading: called.result.scalar_value())
                let elapsed = in_unit(mut fx1, member, elapsed: reading)
                supply.ret(mut lo, fx: mut fx1, held: Held.Scalar(elapsed))
            })
            let now = mut lo.now_ns(mut fx)
            let elapsed = mut fx.b.isub(now, y: minted)
            let rounded = round_down(mut fx, resolution, reading: elapsed)
            supply.ret(mut lo, mut fx, held: Held.Scalar(in_unit(mut fx, member, elapsed: rounded)))
        }
        "sleep" or "sleep_ns" => {
            mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
                supply.done(mut lo, fx: mut fx1)
            })
            let ns = if member == "sleep" {
                from_ms(mut fx, ms: supply.param(1).scalar_value())
            } else {
                supply.param(1).scalar_value()
            }
            mut fx.if_true(served, then: fn[mut lo](mut fx1: Fx) {
                let called = served_call(mut lo, fx: mut fx1, interface_name: "ClockService", method: "sleep_ns", kind, args: Array[Held, 1].filled(Held.Scalar(ns)).view())
                supply.forward_failure(mut lo, fx: mut fx1, called)
                supply.done(mut lo, fx: mut fx1)
            })
            let delay = clock_delay(mut lo, mut fx, minted, resolution, ns)
            if lo.seeded() or lo.kernel() {
                let cancelled = sims_wait(mut lo, mut fx, slot: None, enqueue: fn(mut lo1: Lowering, mut fx1: Fx, op: clif::Value) {
                    if lo1.seeded() {
                        seeded_arm(mut lo1, fx: mut fx1, op, ns: delay)
                    } else {
                        mut lo1.kernel_arm(mut fx1, op, ns: delay)
                    }
                })
                mut fx.if_true(cancelled, then: fn[mut lo](mut fx1: Fx) {
                    sims_fail_cancelled(mut lo, fx: mut fx1, supply)
                })
                supply.done(mut lo, mut fx)
                return
            }
            let called = mut lo.platform_call(mut fx, name: "sleep", args: Array[Held, 1].filled(Held.Scalar(delay)).view())
            sys_after(mut lo, mut fx, supply, called, then: fn(mut lo1: Lowering, mut fx1: Fx, result: Held) {
                supply.done(mut lo1, fx: mut fx1)
            })
        }
        "coarse" => coarse(mut lo, mut fx, supply, word: TABLES_RESOLUTION)
        else => {
            expect false
        }
    }
} sys_clock

/// An elapsed time in nanoseconds in the unit of the `Clock` member reading it: whole
/// milliseconds for `elapsed_ms`.
fn in_unit(mut fx: Fx, member: Str, elapsed: clif::Value) -> clif::Value {
    if member == "elapsed_ms" {
        let per_ms = mut fx.ptr(NS_PER_MS)
        return mut fx.b.udiv(elapsed, y: per_ms)
    }
    return elapsed
} in_unit

fn sys_wall_clock(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    match supply.member() {
        "now_ns" => {
            let words = sys_checked(mut lo, mut fx, supply, capability: supply.param(0).address_value())
            let kind = ServingKind(service: words[2], table: words[3])
            let served = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: kind.table, y: 0)
            mut fx.if_true(served, then: fn[mut lo](mut fx1: Fx) {
                let called = served_call(mut lo, fx: mut fx1, interface_name: "WallClockService", method: "now_ns", kind, args: mem::List[Held].empty(fx1.alloc).view())
                let rounded = round_down(mut fx1, resolution: words[1], reading: called.result.scalar_value())
                supply.ret(mut lo, fx: mut fx1, held: Held.Scalar(rounded))
            })
            var now = words[0]
            if lo.seeded() or lo.machine() {
                let clock = mut lo.now_ns(mut fx)
                now = mut fx.b.iadd(clock, y: words[0])
            } else {
                let called = mut lo.platform_call(mut fx, name: "wall_ns", args: mem::List[Held].empty(fx.alloc).view())
                now = called.result.scalar_value()
            }
            let rounded = round_down(mut fx, resolution: words[1], reading: now)
            supply.ret(mut lo, mut fx, held: Held.Scalar(rounded))
        }
        "coarse" => coarse(mut lo, mut fx, supply, word: TABLES_RESOLUTION)
        else => {
            expect false
        }
    }
} sys_wall_clock

/// `c.coarse(ns)` of a `Clock`, `WallClock` or `task::Executor`: an entry deriving from `c`'s,
/// with the coarser of its resolution, held in the state word at `word`, and `ns`.
fn coarse(mut lo: Lowering, mut fx: Fx, supply: Supply, word: u64) {
    attenuate(mut lo, mut fx, supply, word, floor: supply.param(1).scalar_value(), text: None)
} coarse

/// Returns an entry deriving from the entry of the capability held at the operation's first
/// parameter: its state word at offset `word` raised to at least `floor` and its text extended
/// or replaced by `text`, failing the operation with `Revoked.Stale` when its handle is stale.
fn attenuate(mut lo: Lowering, mut fx: Fx, supply: Supply, word: u64, floor: clif::Value, text: Option[Stretch]) {
    let handle = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
    let offset = mut fx.ptr(word)
    var given = Stretch(start: offset, len: offset)
    match text {
        Some(stretch) => {
            given = stretch
        }
        None => {
            let start = mut fx.ptr(0)
            let len = mut fx.ptr(0)
            given = Stretch(start: start, len: len)
        }
    }
    let derived_values = mut lo.call_routine(mut fx, routine: Routine.Derive, args: fx.list5(handle, b: offset, c: floor, d: given.start, e: given.len).view())
    expect derived_values.len() == 1
    let derived = derived_values[0]
    let stale = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: derived, y: -1)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    mut fx.store(derived, addr: sret, offset: 0)
    supply.done(mut lo, mut fx)
} attenuate

/// A reading of a clock rounded down to a multiple of its resolution.
fn round_down(mut fx: Fx, resolution: clif::Value, reading: clif::Value) -> clif::Value {
    let one = mut fx.ptr(1)
    let divisor = mut fx.b.umax(resolution, y: one)
    let rest = mut fx.b.urem(reading, y: divisor)
    return mut fx.b.isub(reading, y: rest)
} round_down

/// The delay after which `ns` nanoseconds have elapsed on the clock of a live `Clock` entry
/// minted at `minted` with a resolution, rounded up so that it ends when the clock's elapsed
/// time is a multiple of its resolution.
fn clock_delay(mut lo: Lowering, mut fx: Fx, minted: clif::Value, resolution: clif::Value, ns: clif::Value) -> clif::Value {
    let now = mut lo.now_ns(mut fx)
    return on_grid(mut fx, now, origin: minted, resolution, ns)
} clock_delay

fn sys_random(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let capability = supply.param(0).address_value()
    let words = sys_checked(mut lo, mut fx, supply, capability)
    let args = Array[Held, 1].filled(supply.param(1))
    let kind = ServingKind(service: words[0], table: words[1])
    if lo.kernel() {
        discard served_call(mut lo, mut fx, interface_name: "RandomService", method: "fill", kind, args: args.view())
    } else {
        let served = sys_served_entry(mut fx, words)
        discard mut fx.choose_in(mut lo, condition: served, results: mem::List[clif::Type].empty(lo.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
            discard served_call(mut lo1, fx: mut fx1, interface_name: "RandomService", method: "fill", kind, args: args.view())
            return mem::List[clif::Value].empty(fx1.alloc)
        }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
            if lo1.seeded() {
                random_fill(mut lo1, fx: mut fx1, index: words[0], buf: args[0])
            } else {
                discard mut lo1.platform_call(mut fx1, name: "random_fill", args: args.view())
            }
            return mem::List[clif::Value].empty(fx1.alloc)
        })
    }
    supply.done(mut lo, mut fx)
} sys_random

fn sys_log(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let capability = supply.param(0).address_value()
    let handle = mut fx.load(PTR, addr: capability, offset: 0)
    let taken = snapshot(mut lo, mut fx, handle)
    let value_ty = supply.type_arg(lo, index: 0)
    let level = supply.member()
    mut fx.if_true(taken.live, then: fn[mut lo](mut fx1: Fx) {
        if lo.kernel() {
            sys_log_service(mut lo, fx: mut fx1, supply, level, words: taken.words)
            return
        }
        let served = sys_served_entry(mut fx1, words: taken.words)
        discard mut fx1.choose_in(mut lo, condition: served, results: mem::List[clif::Type].empty(lo.alloc).view(), then: fn(mut lo1: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            sys_log_service(mut lo1, fx: mut fx2, supply, level, words: taken.words)
            return mem::List[clif::Value].empty(fx2.alloc)
        }, otherwise: fn(mut lo1: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            sys_log_platform(mut lo1, fx: mut fx2, supply, level, value_ty)
            return mem::List[clif::Value].empty(fx2.alloc)
        })
    })
    supply.done(mut lo, mut fx)
} sys_log

/// Writes a log record through the platform, or in a test image through the sims.
fn sys_log_platform(mut lo: Lowering, mut fx: Fx, supply: Supply, level: Str, value_ty: ty::Ty) {
    if lo.seeded() {
        log_line(mut lo, mut fx, level, message: supply.param(1), value_ty, value: supply.param(2))
        return
    }
    let rendered = render_value(mut lo, mut fx, ty: value_ty, value: supply.param(2), budget: SYS_LOG_BUDGET)
    let rendering = new_view(mut fx, start: rendered.buffer, len: rendered.len)
    let level_view = mut lo.view_literal(mut fx, contents: level.as_bytes())
    var log_args = Array[Held, 3].filled(level_view)
    log_args[1] = supply.param(1)
    log_args[2] = rendering
    discard mut lo.platform_call(mut fx, name: "log_line", args: log_args.view())
} sys_log_platform

/// Calls the `log` method of the kind serving a `Log` entry with the operation's level, message
/// and value rendered within the log's budget.
fn sys_log_service(mut lo: Lowering, mut fx: Fx, supply: Supply, level: Str, words: Array[clif::Value, 4]) {
    let value_ty = supply.type_arg(lo, index: 0)
    let rendered = render_value(mut lo, mut fx, ty: value_ty, value: supply.param(2), budget: SYS_LOG_BUDGET)
    let rendering = new_view(mut fx, start: rendered.buffer, len: rendered.len)
    let level_ty = lo.std_ty("sys", type_name: "LogLevel", args: mem::List[ty::Ty].empty(lo.alloc))
    var variant = "Error"
    if level == "info" {
        variant = "Info"
    } else if level == "warn" {
        variant = "Warn"
    }
    let level_value = mut lo.variant_value(mut fx, ty: level_ty, variant, payload_values: mem::List[Held].empty(lo.alloc).view(), wrapped: None)
    var service_args = Array[Held, 3].filled(level_value)
    service_args[1] = supply.param(1)
    service_args[2] = rendering
    discard served_call(mut lo, mut fx, interface_name: "LogService", method: "log", kind: ServingKind(service: words[0], table: words[1]), args: service_args.view())
} sys_log_service

fn sys_stdio(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let capability = supply.param(0).address_value()
    let words = sys_checked(mut lo, mut fx, supply, capability)
    if lo.kernel() {
        sys_stdio_service(mut lo, mut fx, supply, words)
        return
    }
    let served = sys_served_entry(mut fx, words)
    mut fx.if_true(served, then: fn[mut lo](mut fx1: Fx) {
        sys_stdio_service(mut lo, fx: mut fx1, supply, words)
    })
    if lo.seeded() {
        if supply.member() == "read_in" {
            stdio_read(mut lo, mut fx, supply, index: words[0])
        } else {
            stdio_write(mut lo, mut fx, supply)
        }
        return
    }
    var called = Called(failed: None, failure: None, result: Held.Empty)
    if supply.member() == "read_in" {
        let buf = sys_view(mut fx, held: supply.param(1))
        let fd = mut fx.int(clif::Type.Int32, value: 0)
        var read_args = Array[Held, 3].filled(Held.Scalar(fd))
        read_args[1] = Held.Scalar(buf.start)
        read_args[2] = Held.Scalar(buf.len)
        called = mut lo.platform_call(mut fx, name: "stdio_read", args: read_args.view())
    } else {
        var stream: i64 = 2
        if supply.member() == "write_out" {
            stream = 1
        }
        let fd = mut fx.int(clif::Type.Int32, value: stream)
        var write_args = Array[Held, 2].filled(Held.Scalar(fd))
        write_args[1] = supply.param(1)
        called = mut lo.platform_call(mut fx, name: "stdio_write", args: write_args.view())
    }
    sys_after(mut lo, mut fx, supply, called, then: fn(mut lo1: Lowering, mut fx1: Fx, result: Held) {
        supply.ret(mut lo1, fx: mut fx1, held: result)
    })
} sys_stdio

/// Calls the method of the kind serving a `Stdio` entry that the operation names, its failure
/// becoming the operation's, a count read past `buf`'s length counting as that length.
fn sys_stdio_service(mut lo: Lowering, mut fx: Fx, supply: Supply, words: Array[clif::Value, 4]) {
    let member = supply.member()
    let kind = ServingKind(service: words[0], table: words[1])
    let called = served_call(mut lo, mut fx, interface_name: "StdioService", method: member, kind, args: Array[Held, 1].filled(supply.param(1)).view())
    supply.forward_failure(mut lo, mut fx, called)
    if member == "read_in" {
        let buf = sys_view(mut fx, held: supply.param(1))
        let read = mut fx.b.umin(called.result.scalar_value(), y: buf.len)
        supply.ret(mut lo, mut fx, held: Held.Scalar(read))
    } else {
        supply.done(mut lo, mut fx)
    }
} sys_stdio_service

/// An operation of a `Runner`: the method of its name of the kind serving it, its failure
/// becoming the operation's. The resource `put_resource` takes is released when the runner is
/// stale, and the one `resource` or `take_resource` gives passes to the calling task's domain.
fn sys_runner(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let member = supply.member()
    let capability = supply.param(0).address_value()
    let words = if member == "put_resource" {
        sys_checked_releasing(mut lo, mut fx, supply, capability)
    } else {
        sys_checked(mut lo, mut fx, supply, capability)
    }
    let kind = ServingKind(service: words[0], table: words[1])
    var args = mem::List[Held].empty(lo.alloc)
    for position in 1..<supply.params.len() {
        mut args.push(supply.params[position])
    }
    let called = served_call(mut lo, mut fx, interface_name: "RunnerService", method: member, kind, args: args.view())
    supply.forward_failure(mut lo, mut fx, called)
    if member == "resource" or member == "take_resource" {
        let none = mut fx.ptr(0)
        let domain = current_domain(mut lo, mut fx)
        mut lo.transfer(mut fx, ty: supply.abi.result, address: called.result.address_value(), lift: none, owner: domain)
    }
    supply.ret(mut lo, mut fx, held: called.result)
} sys_runner

/// The state words of the entry of the `Runner` held at an address, failing `put_resource` with
/// `Revoked.Stale` once it releases the `sys::Held` it takes when its handle is stale.
fn sys_checked_releasing(mut lo: Lowering, mut fx: Fx, supply: Supply, capability: clif::Value) -> Array[clif::Value, 4] {
    let handle = mut fx.load(PTR, addr: capability, offset: 0)
    let taken = snapshot(mut lo, mut fx, handle)
    let stale = mut fx.b.bxor_imm_s(taken.live, y: 1)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        let held = lo.std_ty("sys", type_name: "Held", args: mem::List[ty::Ty].empty(lo.alloc))
        mut lo.release(mut fx1, ty: held, address: supply.param(2).address_value())
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    return taken.words
} sys_checked_releasing

/// Whether the state words of a `Log`, `Random` or `Stdio` entry are a served entry's, which
/// names a method table where others hold zero.
fn sys_served_entry(mut fx: Fx, words: Array[clif::Value, 4]) -> clif::Value {
    return mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: words[1], y: 0)
} sys_served_entry

/// The operations of files, listeners and connections, through the entry each was opened by;
/// a release completes whether or not that entry is revoked. A machine's runtime has only those
/// a kind serves.
fn resource(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let address = supply.param(0).address_value()
    let member = supply.member()
    if member != "abandon" and member != "close" {
        sys_check(mut lo, mut fx, supply, capability: address)
    }
    if lo.kernel() {
        served_resource(mut lo, mut fx, supply, address)
        return
    }
    let served = sys_is_served(mut fx, address)
    mut fx.if_true(served, then: fn[mut lo](mut fx1: Fx) {
        served_resource(mut lo, fx: mut fx1, supply, address)
    })
    let descriptor = Held.Scalar(sys_descriptor(mut fx, address))
    if member == "abandon" {
        if lo.seeded() {
            let held_at = mut fx.offset(address, offset: 8)
            let payload = holdings_payload(mut fx, address: held_at)
            sims_abandon(mut lo, mut fx, index: payload)
        } else {
            discard mut lo.platform_call(mut fx, name: "conn_abandon", args: Array[Held, 1].filled(descriptor).view())
        }
        let holding = mut fx.load(PTR, addr: address, offset: 8)
        discard mut lo.call_routine(mut fx, routine: Routine.Unhold, args: Array[clif::Value, 1].filled(holding).view())
        supply.done(mut lo, mut fx)
        return
    }
    let path = supply.path.as_str()
    let Some(owner) = path.slice_bytes(0, end: check::last_dot(path).value_or(0)) else {
        expect false
        return
    }
    if lo.seeded() {
        resource_sim(mut lo, mut fx, supply, owner, member, address)
        return
    }
    let file = owner == "sys::fs::File"
    let conn = owner == "sys::net::Conn"
    var called = Called(failed: None, failure: None, result: Held.Empty)
    if (file or conn) and member == "read" {
        let buf = sys_view(mut fx, held: supply.param(1))
        var platform_name = "conn_read"
        if file {
            platform_name = "file_read"
        }
        var read_args = Array[Held, 3].filled(descriptor)
        read_args[1] = Held.Scalar(buf.start)
        read_args[2] = Held.Scalar(buf.len)
        called = mut lo.platform_call(mut fx, name: platform_name, args: read_args.view())
    } else if (file or conn) and member == "write" {
        var platform_name = "conn_write"
        if file {
            platform_name = "file_write"
        }
        var write_args = Array[Held, 2].filled(descriptor)
        write_args[1] = supply.param(1)
        called = mut lo.platform_call(mut fx, name: platform_name, args: write_args.view())
    } else if file and member == "byte_len" {
        called = mut lo.platform_call(mut fx, name: "file_byte_len", args: Array[Held, 1].filled(descriptor).view())
    } else if owner == "sys::net::Listener" and member == "accept" {
        let accepted = mut lo.platform_call(mut fx, name: "listener_accept", args: Array[Held, 1].filled(descriptor).view())
        sys_after(mut lo, mut fx, supply, called: accepted, then: fn(mut lo1: Lowering, mut fx1: Fx, result: Held) {
            let handle = mut fx1.load(PTR, addr: address, offset: 0)
            let fd = mut fx1.b.sextend(PTR, x: result.scalar_value())
            ret_resource(mut lo1, fx: mut fx1, supply, handle, descriptor: fd)
        })
        return
    } else if conn and member == "close" {
        called = mut lo.platform_call(mut fx, name: "conn_close", args: Array[Held, 1].filled(descriptor).view())
        let holding = mut fx.load(PTR, addr: address, offset: 8)
        discard mut lo.call_routine(mut fx, routine: Routine.Unhold, args: Array[clif::Value, 1].filled(holding).view())
    } else {
        expect false
    }
    sys_after(mut lo, mut fx, supply, called, then: fn(mut lo1: Lowering, mut fx1: Fx, result: Held) {
        supply.ret(mut lo1, fx: mut fx1, held: result)
    })
} resource

/// The operations of files, listeners and connections in a test image, on the sims.
fn resource_sim(mut lo: Lowering, mut fx: Fx, supply: Supply, owner: Str, member: Str, address: clif::Value) {
    if owner == "sys::fs::File" and member == "read" {
        fs_read(mut lo, mut fx, supply)
    } else if owner == "sys::fs::File" and member == "write" {
        fs_write(mut lo, mut fx, supply)
    } else if owner == "sys::fs::File" and member == "byte_len" {
        byte_len(mut lo, mut fx, supply)
    } else if owner == "sys::net::Listener" and member == "accept" {
        accept(mut lo, mut fx, supply)
    } else if owner == "sys::net::Conn" and member == "read" {
        net_read(mut lo, mut fx, supply)
    } else if owner == "sys::net::Conn" and member == "write" {
        net_write(mut lo, mut fx, supply)
    } else if owner == "sys::net::Conn" and member == "close" {
        net_close(mut lo, mut fx, supply)
        let holding = mut fx.load(PTR, addr: address, offset: 8)
        discard mut lo.call_routine(mut fx, routine: Routine.Unhold, args: Array[clif::Value, 1].filled(holding).view())
        supply.done(mut lo, mut fx)
    } else {
        expect false
    }
} resource_sim

/// Whether the resource at an address is one a kind serves.
fn sys_is_served(mut fx: Fx, address: clif::Value) -> clif::Value {
    let holding = mut fx.load(PTR, addr: address, offset: 8)
    let kind = mut fx.load(PTR, addr: holding, offset: HOLDING_KIND)
    return mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: HOLDINGS_KIND_SERVED)
} sys_is_served

/// Releases a file or listener: its descriptor closes, or the kind serving it releases it.
fn sys_release(mut lo: Lowering, mut fx: Fx, owner_path: Str, ty: ty::Ty, address: clif::Value) -> bool {
    if owner_path != "sys::fs::File" and owner_path != "sys::net::Listener" {
        return false
    }
    let held_at = mut fx.offset(address, offset: 8)
    let payload = holdings_payload(mut fx, address: held_at)
    if lo.kernel() {
        served_release(mut lo, mut fx, record: payload)
    } else {
        let served = sys_is_served(mut fx, address)
        discard mut fx.choose_in(mut lo, condition: served, results: mem::List[clif::Type].empty(lo.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
            served_release(mut lo1, fx: mut fx1, record: payload)
            return mem::List[clif::Value].empty(fx1.alloc)
        }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
            if lo1.seeded() {
                sims_release(mut lo1, fx: mut fx1, index: payload)
            } else {
                let descriptor = mut fx1.b.ireduce(clif::Type.Int32, x: payload)
                discard mut lo1.platform_call(mut fx1, name: "release", args: Array[Held, 1].filled(Held.Scalar(descriptor)).view())
            }
            return mem::List[clif::Value].empty(fx1.alloc)
        })
    }
    let holding = mut fx.load(PTR, addr: address, offset: 8)
    discard mut lo.call_routine(mut fx, routine: Routine.Unhold, args: Array[clif::Value, 1].filled(holding).view())
    return true
} sys_release

/// Whether moving a sys type into another domain's reach does anything, none for a type std
/// declares in full.
fn sys_transfers(owner_path: Str) -> Option[bool] {
    return match owner_path {
        "sys::fs::File" or "sys::net::Listener" or "sys::net::Conn" or "sys::Revoker" or "sys::Minter" => Some(true)
        else => None
    }
} sys_transfers

/// Moves a resource, revoker or minter into another domain's reach: its holding passes to
/// `owner`.
fn sys_transfer(mut lo: Lowering, mut fx: Fx, owner_path: Str, address: clif::Value, owner: clif::Value) -> bool {
    match owner_path {
        "sys::fs::File" or "sys::net::Listener" or "sys::net::Conn" => {
            let holding = mut fx.offset(address, offset: 8)
            rehome(mut lo, mut fx, address: holding, owner)
        }
        "sys::Revoker" or "sys::Minter" => rehome(mut lo, mut fx, address, owner)
        else => return false
    }
    return true
} sys_transfer

/// Whether releasing a sys type does anything, none for a type std declares in full.
fn sys_needs_release(owner_path: Str) -> Option[bool] {
    return match owner_path {
        "sys::fs::File" or "sys::net::Listener" => Some(true)
        "sys::net::Conn" or "sys::Revoker" or "sys::Minter" => Some(false)
        else => None
    }
} sys_needs_release

/// `sys::revocable`, `sys::Revoker.capability` and `sys::Revoker.revoke`: an allocator's
/// revoker keeps a new cell, any other capability's a new entry deriving from its entry.
fn revocation(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let capability_ty = supply.type_arg(lo, index: 0)
    let allocator = lo.ck.is_std(capability_ty, path: "mem::Alloc")
    match supply.member() {
        "" => {
            let capability = supply.param(0).address_value()
            let handle = mut fx.load(PTR, addr: capability, offset: 0)
            var derived = handle
            if allocator {
                let unlimited = mut fx.int(PTR, value: -1)
                var split_args = Array[clif::Value, 2].filled(handle)
                split_args[1] = unlimited
                let derived_values = mut lo.call_routine(mut fx, routine: Routine.Split, args: split_args.view())
                expect derived_values.len() == 1
                derived = derived_values[0]
            } else {
                sys_check(mut lo, mut fx, supply, capability)
                let word = mut fx.ptr(TABLES_ENTRY_STATE)
                let zero = mut fx.ptr(0)
                let derived_values = mut lo.call_routine(mut fx, routine: Routine.Derive, args: fx.list5(handle, b: word, c: zero, d: zero, e: zero).view())
                expect derived_values.len() == 1
                derived = derived_values[0]
                let stale = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: derived, y: -1)
                mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
                    fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
                })
            }
            var chosen_kind = HOLDINGS_KIND_REVOKE
            if allocator {
                chosen_kind = HOLDINGS_KIND_CLOSE_CELL
            }
            let kind_value = mut fx.ptr(u64.fit(chosen_kind))
            var hold_args = Array[clif::Value, 2].filled(kind_value)
            hold_args[1] = derived
            let holding_values = mut lo.call_routine(mut fx, routine: Routine.Hold, args: hold_args.view())
            expect holding_values.len() == 1
            let holding = holding_values[0]
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            mut fx.store(holding, addr: sret, offset: 0)
            supply.done(mut lo, mut fx)
        }
        "capability" => {
            let handle = holdings_payload(mut fx, address: supply.param(0).address_value())
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            mut fx.store(handle, addr: sret, offset: 0)
            supply.done(mut lo, mut fx)
        }
        "revoke" => {
            let revoker = supply.param(0).address_value()
            let handle = holdings_payload(mut fx, address: revoker)
            var routine = Routine.Revoke
            if allocator {
                routine = Routine.Close
            }
            discard mut lo.call_routine(mut fx, routine, args: Array[clif::Value, 1].filled(handle).view())
            let holding = mut fx.load(PTR, addr: revoker, offset: 0)
            discard mut lo.call_routine(mut fx, routine: Routine.Unhold, args: Array[clif::Value, 1].filled(holding).view())
            supply.done(mut lo, mut fx)
        }
        else => {
            expect false
        }
    }
} revocation

/// `host_platform::submit(entry)`: the operation's result once its completion arrives.
fn sys_submit(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let entry = supply.param(0).address_value()
    let results = mut lo.call_routine(mut fx, routine: Routine.IoSubmit, args: Array[clif::Value, 1].filled(entry).view())
    expect results.len() == 2
    let cancelled = results[0]
    let result = results[1]
    mut fx.if_true(cancelled, then: fn[mut lo](mut fx1: Fx) {
        let origin = tasks_origin(mut lo, fx: mut fx1)
        tasks_fail_cancelled(mut lo, fx: mut fx1, supply, origin)
    })
    supply.ret(mut lo, mut fx, held: Held.Scalar(result))
} sys_submit
