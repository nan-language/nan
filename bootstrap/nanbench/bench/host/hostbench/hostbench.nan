//! Times a box drawn through an allocator and a stale capability's generation check.

/// How many boxes each timing draws and how many checks it makes.
const ROUNDS: u64 = 10_000_000

pub closed enum BenchError derives Render {
    Revoked(sys::Revoked) from
    Stdio(sys::StdioError) from
    Cancelled(task::Cancelled) from
} BenchError

/// Writes the time of a box drawn through an allocator, every box kept so that the heap draws new
/// chunks and charges its cell, and of an operation failing at a stale capability's generation
/// check, each in picoseconds.
fn main(take world: host::World) fails BenchError uses wait {
    let clock = world.clock
    let alloc = world.alloc
    let heap = mem::Heap.of(alloc)
    var boxes = mem::List[mem::Box[u64]].empty(alloc)
    mut boxes.reserve(usize.widen(ROUNDS))
    let drawing = try clock.elapsed_ms()
    for round in 0..<ROUNDS {
        mut boxes.push(heap.boxed(round))
    }
    let drawn = try clock.elapsed_ms()
    let revoker = try sys::revocable(world.exec)
    let stale = revoker.capability()
    take revoker.revoke()
    let checking = try clock.elapsed_ms()
    for _ in 0..<ROUNDS {
        match attempt sys::revocable(stale) {
            Ok(derived) => take derived.revoke()
            Err(_) => {}
        }
    }
    let checked = try clock.elapsed_ms()
    var report = text::String.empty(alloc)
    mut report.write(text::fmt("alloc {ps}\n", ps: picoseconds(drawing, end: drawn)), budget: 64)
    mut report.write(text::fmt("generation {ps}\n", ps: picoseconds(checking, end: checked)), budget: 64)
    let written = take report.into_bytes()
    try await world.stdio.write_out(written.view())
} main

/// The picoseconds each of `ROUNDS` operations took between two clock readings in milliseconds.
fn picoseconds(start: u64, end: u64) -> u64 {
    return (end - start) * 1_000_000_000 / ROUNDS
} picoseconds
