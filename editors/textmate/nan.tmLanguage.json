{
  "name": "NaN",
  "scopeName": "source.nan",
  "fileTypes": ["nan"],
  "patterns": [
    {"include": "#rejected"},
    {"include": "#indentation"},
    {"include": "#trailing-whitespace"},
    {"include": "#line-start"},
    {"include": "#comment"},
    {"include": "#machine-records"},
    {"include": "#closing-labels"},
    {"include": "#directives"},
    {"include": "#member-lines"},
    {"include": "#item-head"},
    {"include": "#literals"},
    {"include": "#numbers"},
    {"include": "#declarations"},
    {"include": "#keywords"},
    {"include": "#generic-args"},
    {"include": "#members"},
    {"include": "#namespace"},
    {"include": "#identifier"},
    {"include": "#punctuation"},
    {"include": "#unexpected"}
  ],
  "repository": {
    "binding": {
      "patterns": [
        {
          "begin": "\\b(let)(?![A-Za-z0-9_])",
          "beginCaptures": {"1": {"name": "storage.type.nan"}},
          "end": "(?==(?!=))|$",
          "patterns": [
            {
              "begin": "(:)(?!:) *",
              "beginCaptures": {"1": {"name": "punctuation.separator.colon.nan"}},
              "end": "(?<=[A-Za-z0-9_\\]])(?! *(?:::|\\[))|(?=[^ A-Za-z0-9_:\\[])|$",
              "patterns": [{"include": "#type-body"}]
            },
            {"include": "#pattern"}
          ]
        },
        {
          "begin": "\\b(var) +([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {"1": {"name": "storage.type.nan"}, "2": {"name": "variable.other.nan"}},
          "end": "(?==(?!=))|$",
          "patterns": [
            {
              "begin": "(:)(?!:) *",
              "beginCaptures": {"1": {"name": "punctuation.separator.colon.nan"}},
              "end": "(?<=[A-Za-z0-9_\\]])(?! *(?:::|\\[))|(?=[^ A-Za-z0-9_:\\[])|$",
              "patterns": [{"include": "#type-body"}]
            },
            {"include": "#comment"}
          ]
        },
        {
          "begin": "\\b(for)(?![A-Za-z0-9_])",
          "beginCaptures": {"1": {"name": "keyword.control.nan"}},
          "end": "(?=\\bin(?![A-Za-z0-9_]))|$",
          "patterns": [{"include": "#pattern"}]
        }
      ]
    },
    "brackets": {
      "begin": "\\[",
      "beginCaptures": {"0": {"name": "punctuation.section.brackets.nan"}},
      "end": "\\]|$",
      "endCaptures": {"0": {"name": "punctuation.section.brackets.nan"}},
      "patterns": [{"include": "$self"}]
    },
    "bytes-escapes": {
      "patterns": [
        {"include": "#escape"},
        {"match": "\\\\x[0-9A-Fa-f]{2}", "name": "constant.character.escape.nan"},
        {"include": "#invalid-escape"}
      ]
    },
    "clauses": {
      "patterns": [
        {
          "match": "\\b(uses) +(wait)(?![A-Za-z0-9_])",
          "captures": {"1": {"name": "storage.modifier.nan"}, "2": {"name": "storage.modifier.nan"}}
        },
        {
          "begin": "\\b(limits)(?![A-Za-z0-9_])",
          "beginCaptures": {"1": {"name": "storage.modifier.nan"}},
          "end": "(?! *(?:, *)?(?:pure|notrap|terminates|noalloc|stack)(?![A-Za-z0-9_]))",
          "patterns": [
            {
              "match": "\\b(stack) +([0-9][0-9A-Za-z_]*)",
              "captures": {"1": {"name": "storage.modifier.nan"}, "2": {"patterns": [{"include": "#numbers"}]}}
            },
            {"match": "\\b(?:pure|notrap|terminates|noalloc)(?![A-Za-z0-9_])", "name": "storage.modifier.nan"},
            {"include": "#punctuation"}
          ]
        },
        {"match": "\\b(task)(?= +fn(?![A-Za-z0-9_]))", "captures": {"1": {"name": "storage.modifier.nan"}}},
        {
          "match": "\\b(waive) +(depth|length)(?![A-Za-z0-9_])",
          "captures": {"1": {"name": "keyword.other.nan"}, "2": {"name": "keyword.other.nan"}}
        },
        {"match": "\\b(convention)(?= +\\\")", "captures": {"1": {"name": "storage.modifier.nan"}}}
      ]
    },
    "closing-labels": {
      "patterns": [
        {
          "match": "^(\\}) +(?:([A-Za-z_][A-Za-z0-9_]*) *(::) *(?:([A-Za-z_][A-Za-z0-9_]*) *(::) *)?)?([A-Za-z_][A-Za-z0-9_]*) *(\\.)(?!\\.) *([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "punctuation.section.braces.nan"},
            "2": {"name": "entity.name.namespace.nan"},
            "3": {"name": "punctuation.separator.namespace.nan"},
            "4": {"name": "entity.name.namespace.nan"},
            "5": {"name": "punctuation.separator.namespace.nan"},
            "6": {"patterns": [{"include": "#type-name"}]},
            "7": {"name": "punctuation.accessor.nan"},
            "8": {"name": "entity.name.function.nan"}
          }
        },
        {
          "match": "^(\\}) +([A-Z][A-Za-z0-9_]*)",
          "captures": {"1": {"name": "punctuation.section.braces.nan"}, "2": {"name": "entity.name.type.nan"}}
        },
        {
          "match": "^(\\}) +([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {"1": {"name": "punctuation.section.braces.nan"}, "2": {"name": "entity.name.nan"}}
        },
        {
          "match": "^ +(\\}) +(?!(?:and|or|not)(?![A-Za-z0-9_]))([A-Za-z_][A-Za-z0-9_]*)(?= *(?://.*)?$)",
          "captures": {"1": {"name": "punctuation.section.braces.nan"}, "2": {"name": "entity.name.function.nan"}}
        }
      ]
    },
    "comment": {
      "begin": "//",
      "end": "$",
      "beginCaptures": {"0": {"name": "punctuation.definition.comment.nan"}},
      "name": "comment.line.double-slash.nan",
      "patterns": [{"include": "#rejected"}, {"include": "#trailing-whitespace"}]
    },
    "const-head": {
      "patterns": [
        {
          "begin": "\\b(const) +(?!assert(?![A-Za-z0-9_]))([A-Za-z_][A-Za-z0-9_]*) *(:)(?!:) *",
          "beginCaptures": {
            "1": {"name": "storage.type.nan"},
            "2": {"name": "entity.name.constant.nan"},
            "3": {"name": "punctuation.separator.colon.nan"}
          },
          "end": "(?<=[A-Za-z0-9_\\]])(?! *(?:::|\\[))|(?=[^ A-Za-z0-9_:\\[])|$",
          "patterns": [{"include": "#type-body"}]
        },
        {
          "match": "\\b(const) +(?!assert(?![A-Za-z0-9_]))([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {"1": {"name": "storage.type.nan"}, "2": {"name": "entity.name.constant.nan"}}
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "begin": "\\b(ensures)(?![A-Za-z0-9_])",
          "beginCaptures": {"1": {"name": "keyword.other.nan"}},
          "end": "$",
          "patterns": [
            {"include": "#quantifier"},
            {
              "match": "(?<![.:])(old)(?= *\\((?! *(?:mut|take|try|attempt|await)(?![A-Za-z0-9_]))(?! *[A-Za-z_][A-Za-z0-9_]* *:(?!:))(?:[^()\\[\\],\\\"']|\"(?:[^\"\\\\]|\\\\.)*\"|b?'(?:[^'\\\\]|\\\\.)*'|([(\\[](?:[^()\\[\\]\\\"']|\"(?:[^\"\\\\]|\\\\.)*\"|b?'(?:[^'\\\\]|\\\\.)*'|\\g<2>)*[)\\]]))+\\))",
              "captures": {"1": {"name": "keyword.other.nan"}}
            },
            {
              "match": "(?<![.:])(result)(?![A-Za-z0-9_])(?! *:)",
              "captures": {"1": {"name": "variable.language.result.nan"}}
            },
            {"include": "$self"}
          ]
        },
        {"include": "#quantifier"},
        {
          "match": "^ +(example)(?= +(?!(?:and|or|in)(?![A-Za-z0-9_]))[A-Za-z0-9_\\\"'~])",
          "captures": {"1": {"name": "keyword.other.nan"}}
        },
        {"match": "(?<=\\\")( +)(example)(?![A-Za-z0-9_])", "captures": {"2": {"name": "keyword.other.nan"}}},
        {"match": "\\b(because)(?= +\\\")", "captures": {"1": {"name": "keyword.other.nan"}}}
      ]
    },
    "declarations": {
      "patterns": [
        {"include": "#fn-head"},
        {"include": "#type-head"},
        {"include": "#layout-head"},
        {"include": "#registry-head"},
        {"include": "#const-head"},
        {"include": "#test-head"},
        {"include": "#impl-head"},
        {"include": "#retired-head"},
        {"include": "#binding"},
        {"include": "#field"},
        {"include": "#contracts"},
        {"include": "#labels"},
        {"include": "#clauses"},
        {"include": "#result-type"}
      ]
    },
    "directives": {
      "patterns": [
        {"match": "^ +(language) +(?=[0-9])", "captures": {"1": {"name": "keyword.other.nan"}}},
        {
          "begin": "^ +(targets) +(?=[A-Za-z_])",
          "beginCaptures": {"1": {"name": "keyword.other.nan"}},
          "end": "$",
          "patterns": [
            {"match": "[A-Za-z_][A-Za-z0-9_]*(?: *- *[A-Za-z_][A-Za-z0-9_]*)?", "name": "constant.other.target.nan"},
            {"include": "#comment"},
            {"include": "#punctuation"}
          ]
        },
        {
          "match": "^ +(entry) +([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {"1": {"name": "keyword.other.nan"}, "2": {"name": "entity.name.function.nan"}}
        },
        {
          "match": "^ +(dep) +([A-Za-z_][A-Za-z0-9_]*)(?= +\\\")",
          "captures": {"1": {"name": "keyword.other.nan"}, "2": {"name": "entity.name.namespace.nan"}}
        },
        {
          "begin": "^ +(allow) +(?:(device|priv|validate)|(trusted)) +(in)(?![A-Za-z0-9_])",
          "beginCaptures": {
            "1": {"name": "keyword.other.nan"},
            "2": {"name": "keyword.other.nan"},
            "3": {"name": "storage.modifier.nan"},
            "4": {"name": "keyword.control.nan"}
          },
          "end": "$",
          "patterns": [
            {"match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.namespace.nan"},
            {"include": "#comment"},
            {"include": "#punctuation"}
          ]
        },
        {
          "match": "^ +(allow) +(contribute) +((?:[A-Za-z_][A-Za-z0-9_]* *:: *)*)([A-Za-z_][A-Za-z0-9_]*) +(in)(?![A-Za-z0-9_])",
          "captures": {
            "1": {"name": "keyword.other.nan"},
            "2": {"name": "storage.type.nan"},
            "3": {"patterns": [{"include": "#namespace"}, {"include": "#punctuation"}]},
            "4": {"name": "entity.name.registry.nan"},
            "5": {"name": "keyword.control.nan"}
          }
        },
        {
          "match": "^ +(deny) +([A-Za-z_][A-Za-z0-9_]*) *(->) *([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "keyword.other.nan"},
            "2": {"name": "entity.name.namespace.nan"},
            "3": {"name": "keyword.operator.arrow.nan"},
            "4": {"name": "entity.name.namespace.nan"}
          }
        }
      ]
    },
    "escape": {"match": "\\\\[\\\\\"'nrt0]", "name": "constant.character.escape.nan"},
    "field": {
      "begin": "\\b(pub|pkg) +([A-Za-z_][A-Za-z0-9_]*) *(:)(?!:) *",
      "beginCaptures": {
        "1": {"name": "storage.modifier.nan"},
        "2": {"name": "variable.other.member.nan"},
        "3": {"name": "punctuation.separator.colon.nan"}
      },
      "end": "(?<=[A-Za-z0-9_\\]])(?! *(?:::|\\[))|(?=[^ A-Za-z0-9_:\\[])|$",
      "patterns": [{"include": "#type-body"}]
    },
    "fn-head": {
      "begin": "\\b(fn)(?![A-Za-z0-9_])(?: +(?:(?:([A-Za-z_][A-Za-z0-9_]*) *(::) *(?:([A-Za-z_][A-Za-z0-9_]*) *(::) *)?)?([A-Za-z_][A-Za-z0-9_]*) *(\\.)(?!\\.) *)?([A-Za-z_][A-Za-z0-9_]*))?",
      "beginCaptures": {
        "1": {"name": "storage.type.nan"},
        "2": {"name": "entity.name.namespace.nan"},
        "3": {"name": "punctuation.separator.namespace.nan"},
        "4": {"name": "entity.name.namespace.nan"},
        "5": {"name": "punctuation.separator.namespace.nan"},
        "6": {"patterns": [{"include": "#type-name"}]},
        "7": {"name": "punctuation.accessor.nan"},
        "8": {"name": "entity.name.function.nan"}
      },
      "end": "(?=[^ \\[(])|$",
      "patterns": [{"include": "#generic-params"}, {"include": "#params"}]
    },
    "generic-args": {
      "begin": "([A-Z](?:[A-Za-z0-9]*[a-z][A-Za-z0-9]*)?(?![A-Za-z0-9_])) *(\\[)",
      "beginCaptures": {"1": {"name": "entity.name.type.nan"}, "2": {"name": "punctuation.section.brackets.nan"}},
      "end": "\\]|$",
      "endCaptures": {"0": {"name": "punctuation.section.brackets.nan"}},
      "patterns": [{"include": "#numbers"}, {"include": "#type-body"}]
    },
    "generic-params": {
      "begin": "\\[",
      "beginCaptures": {"0": {"name": "punctuation.section.brackets.nan"}},
      "end": "\\]|$",
      "endCaptures": {"0": {"name": "punctuation.section.brackets.nan"}},
      "patterns": [{"include": "#generic-params-body"}]
    },
    "generic-params-body": {
      "patterns": [
        {
          "begin": "\\b(where)(?![A-Za-z0-9_])",
          "beginCaptures": {"1": {"name": "storage.modifier.nan"}},
          "end": "(?=[,\\]])|$",
          "patterns": [{"include": "#parens"}, {"include": "#brackets"}, {"include": "$self"}]
        },
        {
          "match": "(?<=[\\[,])( *)(?!(?:mut|take)(?![A-Za-z0-9_]))([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {"2": {"name": "entity.name.type.parameter.nan"}}
        },
        {
          "begin": "(:)(?!:) *",
          "beginCaptures": {"1": {"name": "punctuation.separator.colon.nan"}},
          "end": "(?<=[A-Za-z0-9_\\]])(?! *(?:::|\\[))|(?=[^ A-Za-z0-9_:\\[])|$",
          "patterns": [{"include": "#type-body"}]
        },
        {
          "begin": "\\b(and) +",
          "beginCaptures": {"1": {"name": "keyword.operator.logical.nan"}},
          "end": "(?<=[A-Za-z0-9_\\]])(?! *(?:::|\\[))|(?=[^ A-Za-z0-9_:\\[])|$",
          "patterns": [{"include": "#type-body"}]
        },
        {"include": "#comment"},
        {"include": "#keywords"},
        {"include": "#punctuation"},
        {"match": "[A-Za-z_][A-Za-z0-9_]*"}
      ]
    },
    "identifier": {"match": "[A-Za-z_][A-Za-z0-9_]*"},
    "impl-head": {
      "begin": "\\b(impl)(?![A-Za-z0-9_])",
      "beginCaptures": {"1": {"name": "storage.type.nan"}},
      "end": "$",
      "patterns": [
        {
          "begin": "(:)(?!:) *",
          "beginCaptures": {"1": {"name": "punctuation.separator.colon.nan"}},
          "end": "$",
          "patterns": [
            {"include": "#comment"},
            {"include": "#keywords"},
            {"include": "#generic-args"},
            {"include": "#namespace"},
            {"include": "#type-name"},
            {"include": "#punctuation"}
          ]
        },
        {"include": "#comment"},
        {"include": "#generic-params"},
        {"include": "#namespace"},
        {"include": "#type-name"},
        {"include": "#punctuation"}
      ]
    },
    "indentation": {"match": "^(?:    )*+ {1,3}(?! |$)", "name": "invalid.illegal.indentation.nan"},
    "invalid-escape": {"match": "\\\\(?:x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}|.)?", "name": "invalid.illegal.escape.nan"},
    "item-head": {
      "match": "^((?:(?:pub|pkg|closed|open|view|linear|proj|interrupt|landing|foreign|validator|stable|flexible|migrate|machine|protocol|ipc) +)+)",
      "captures": {
        "1": {
          "patterns": [
            {
              "match": "\\b(?:stable|flexible|migrate|machine|protocol|ipc)\\b",
              "name": "invalid.illegal.reserved-word.nan"
            },
            {"match": "\\b(?:closed|open|view)\\b", "name": "storage.modifier.nan"},
            {"include": "#keywords"}
          ]
        }
      }
    },
    "keywords": {
      "patterns": [
        {"match": "(?:true|false)(?![A-Za-z0-9_])", "name": "constant.language.boolean.nan"},
        {"match": "(?:self)(?![A-Za-z0-9_])", "name": "variable.language.self.nan"},
        {"match": "(?:_)(?![A-Za-z0-9_])", "name": "variable.language.wildcard.nan"},
        {"match": "(?:and|or|not)(?![A-Za-z0-9_])", "name": "keyword.operator.logical.nan"},
        {
          "match": "(?:attempt|await|break|continue|defer|discard|else|fail|first|for|if|in|loop|match|return|try|undefer|when|while)(?![A-Za-z0-9_])",
          "name": "keyword.control.nan"
        },
        {
          "match": "(?:const|contribute|enum|fn|impl|interface|layout|let|package|registers|registry|retired|struct|test|var)(?![A-Za-z0-9_])",
          "name": "storage.type.nan"
        },
        {
          "match": "(?:derives|fails|foreign|interrupt|landing|limits|linear|mut|pkg|proj|pub|take|trusted|uses|validator|where)(?![A-Za-z0-9_])",
          "name": "storage.modifier.nan"
        },
        {
          "match": "(?:assert|assume|dbg|decreases|ensures|expect|invariant|requires|todo|waive)(?![A-Za-z0-9_])",
          "name": "keyword.other.nan"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "\\b(loop) +(as) +([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {"name": "keyword.control.nan"},
            "2": {"name": "keyword.other.nan"},
            "3": {"name": "entity.name.label.nan"}
          }
        },
        {
          "match": "\\b(break|continue) +([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {"1": {"name": "keyword.control.nan"}, "2": {"name": "entity.name.label.nan"}}
        }
      ]
    },
    "layout-head": {
      "match": "\\b(layout) +([A-Za-z_][A-Za-z0-9_]*) *(:) *(?:(bytes) +([0-9][0-9A-Za-z_]*)|([A-Za-z_][A-Za-z0-9_]*))(?: +(le|be)(?![A-Za-z0-9_]))?(?: +(tags)(?![A-Za-z0-9_]))?",
      "captures": {
        "1": {"name": "storage.type.nan"},
        "2": {"name": "entity.name.type.nan"},
        "3": {"name": "punctuation.separator.colon.nan"},
        "4": {"name": "keyword.other.nan"},
        "5": {"patterns": [{"include": "#numbers"}]},
        "6": {"patterns": [{"include": "#type-name"}]},
        "7": {"name": "keyword.other.nan"},
        "8": {"name": "keyword.other.nan"}
      }
    },
    "line-start": {
      "patterns": [
        {
          "begin": "^ *+(//[/!])",
          "end": "$",
          "beginCaptures": {"1": {"name": "comment.line.documentation.nan punctuation.definition.comment.nan"}},
          "contentName": "comment.line.documentation.nan",
          "patterns": [{"include": "#rejected"}, {"include": "#trailing-whitespace"}]
        },
        {
          "begin": "^ *+(\\\\\\\\)",
          "end": "$",
          "beginCaptures": {"1": {"name": "string.unquoted.text-line.nan punctuation.definition.string.begin.nan"}},
          "contentName": "string.unquoted.text-line.nan",
          "patterns": [{"include": "#rejected"}, {"include": "#trailing-whitespace"}, {"include": "#text-escapes"}]
        },
        {"match": "(?://[/!]|\\\\\\\\).*", "name": "invalid.illegal.not-at-line-start.nan"}
      ]
    },
    "literals": {
      "patterns": [
        {
          "begin": "b\"(?=(?:[^\"\\\\]|\\\\.)*\")",
          "end": "\"",
          "name": "string.quoted.double.bytes.nan",
          "patterns": [{"include": "#rejected"}, {"include": "#non-ascii-byte"}, {"include": "#bytes-escapes"}]
        },
        {
          "begin": "b'(?=(?:[^'\\\\]|\\\\(?:x[0-9A-Fa-f]{2}|u\\{[^}']*\\}|.))')",
          "end": "'",
          "name": "string.quoted.single.byte.nan",
          "patterns": [{"include": "#rejected"}, {"include": "#non-ascii-byte"}, {"include": "#bytes-escapes"}]
        },
        {
          "begin": "\"(?=(?:[^\"\\\\]|\\\\.)*\")",
          "end": "\"",
          "name": "string.quoted.double.nan",
          "patterns": [{"include": "#rejected"}, {"include": "#text-escapes"}]
        },
        {
          "begin": "'(?=(?:[^'\\\\]|\\\\(?:x[0-9A-Fa-f]{2}|u\\{[^}']*\\}|.))')",
          "end": "'",
          "name": "string.quoted.single.char.nan",
          "patterns": [{"include": "#rejected"}, {"include": "#text-escapes"}]
        },
        {"match": "b?'(?:[^'\\\\]|\\\\.)*'", "name": "invalid.illegal.char-literal-size.nan"},
        {"match": "b?[\"'].*", "name": "invalid.illegal.unterminated-literal.nan"}
      ]
    },
    "machine-records": {
      "patterns": [
        {
          "match": "^(nan) +(lock|history|api) +(?=[0-9])",
          "captures": {"1": {"name": "keyword.other.machine.nan"}, "2": {"name": "keyword.other.machine.nan"}}
        },
        {
          "match": "^(dep) +([A-Za-z_][A-Za-z0-9_]*)(?: +(alias) +([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {"name": "keyword.other.machine.nan"},
            "2": {"name": "entity.name.namespace.nan"},
            "3": {"name": "keyword.other.machine.nan"},
            "4": {"name": "entity.name.namespace.nan"}
          }
        },
        {
          "match": "^(approved) +([A-Za-z_][A-Za-z0-9_]*) +(capability|alloc|device|priv|validator|escape)(?![A-Za-z0-9_])(?: +(trusted|assume|foreign|landing|validator|decoder|grant)(?![A-Za-z0-9_]))?",
          "captures": {
            "1": {"name": "keyword.other.machine.nan"},
            "2": {"name": "entity.name.namespace.nan"},
            "3": {"name": "keyword.other.machine.nan"},
            "4": {"name": "keyword.other.machine.nan"}
          }
        },
