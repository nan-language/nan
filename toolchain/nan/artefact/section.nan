//! The artefacts an image's `.nan` section holds, read from an ELF64 file.

/// The artefacts the one section named `.nan` of an ELF64 file holds; none when the file is no
/// little-endian ELF64 file or holds no such section, or several.
pkg fn image_section(image: Slice[u8], alloc: mem::Alloc) -> Option[mem::List[mem::Bytes]] {
    let Some(head) = image.prefix(6) else {
        return None
    }
    if head != b"\x7FELF\x02\x01" {
        return None
    }
    let Some(headers) = elf_number(image, at: 0x28, width: 8) else {
        return None
    }
    let Some(size) = elf_number(image, at: 0x3A, width: 2) else {
        return None
    }
    let Some(count) = elf_number(image, at: 0x3C, width: 2) else {
        return None
    }
    let Some(names) = elf_number(image, at: 0x3E, width: 2) else {
        return None
    }
    let table_at = ElfHeaders(start: headers, size: size)
    let Some(table) = section_span(image, headers: table_at, index: names) else {
        return None
    }
    var found = mem::List[ElfSpan].empty(alloc)
    for index in 0..<count {
        let Some(at) = table_at.header(index) else {
            return None
        }
        let Some(name) = elf_number(image, at, width: 4) else {
            return None
        }
        let Some(named) = nan_named(image, table, name) else {
            return None
        }
        if named {
            let Some(held) = section_span(image, headers: table_at, index) else {
                return None
            }
            mut found.push(held)
        }
    }
    if found.len() != 1 {
        return None
    }
    let Some(upto) = image.prefix(found[0].end) else {
        return None
    }
    let Some(parts) = upto.split_at(found[0].start) else {
        return None
    }
    return section_artefacts(parts.tail, alloc)
} image_section

/// Where the section headers of an ELF64 file lie: their offset and the size of each.
struct ElfHeaders derives Copy {
    start: usize
    size: usize
} ElfHeaders

/// The offset of the header of the section at an index.
fn ElfHeaders.header(self, index: usize) -> Option[usize] {
    let Some(skipped) = index.checked_mul(self.size) else {
        return None
    }
    return self.start.checked_add(skipped)
} ElfHeaders.header

/// Where bytes lie in a file: their offset and the offset after them.
struct ElfSpan derives Copy {
    start: usize
    end: usize
} ElfSpan

/// The little-endian unsigned number of `width` bytes at an offset of a file.
fn elf_number(image: Slice[u8], at: usize, width: usize) -> Option[usize] {
    let Some(end) = at.checked_add(width) else {
        return None
    }
    let Some(upto) = image.prefix(end) else {
        return None
    }
    let Some(parts) = upto.split_at(at) else {
        return None
    }
    var value: u64 = 0
    var shift: u32 = 0
    for byte in parts.tail {
        value = value | (u64.widen(byte) << shift)
        shift += 8
    }
    return Some(usize.widen(value))
} elf_number

/// The contents of the section at an index.
fn section_span(image: Slice[u8], headers: ElfHeaders, index: usize) -> Option[ElfSpan] {
    let Some(at) = headers.header(index) else {
        return None
    }
    let Some(offset_at) = at.checked_add(24) else {
        return None
    }
    let Some(size_at) = at.checked_add(32) else {
        return None
    }
    let Some(offset) = elf_number(image, at: offset_at, width: 8) else {
        return None
    }
    let Some(size) = elf_number(image, at: size_at, width: 8) else {
        return None
    }
    let Some(end) = offset.checked_add(size) else {
        return None
    }
    if end > image.len() {
        return None
    }
    return Some(ElfSpan(start: offset, end: end))
} section_span

/// Whether the name at an offset of a section name table, up to its NUL or the table's end, is
/// `.nan`; none when the offset lies past the table.
fn nan_named(image: Slice[u8], table: ElfSpan, name: usize) -> Option[bool] {
    let Some(start) = table.start.checked_add(name) else {
        return None
    }
    if start > table.end or table.end > image.len() {
        return None
    }
    var end = start
    while end < table.end and image[end] != 0 {
        end += 1
    }
    let Some(upto) = image.prefix(end) else {
        return None
    }
    let Some(parts) = upto.split_at(start) else {
        return None
    }
    return Some(parts.tail == b".nan")
} nan_named

/// The artefacts a `.nan` section holds: a uvar count, then each artefact's bytes; none when the
/// content holds anything else.
fn section_artefacts(content: Slice[u8], alloc: mem::Alloc) -> Option[mem::List[mem::Bytes]] {
    let Some(count) = read_uvar(content, at: 0) else {
        return None
    }
    let Some(total) = count.value.to_u64() else {
        return None
    }
    var artefacts = mem::List[mem::Bytes].empty(alloc)
    var at = count.next
    var index: u64 = 0
    while index < total {
        let Some(held) = read_bytes(content, at) else {
            return None
        }
        mut artefacts.push(held.copy(content, alloc))
        at = held.next
        index += 1
    }
    if at != content.len() {
        return None
    }
    return Some(take artefacts)
} section_artefacts
