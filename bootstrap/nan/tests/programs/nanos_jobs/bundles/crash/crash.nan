//! Divides a hundred by its input while holding a file, failing on one, spinning on two and sleeping a minute on three.

pub closed enum CrashError derives Render {
    One
    Fs(sys::fs::FsError) from
    Cancelled(task::Cancelled) from
} CrashError

fn main(take world: nanos::World, take input: u32) -> u32 fails CrashError uses wait limits stack 65_536 {
    let held = try await world.fs.open("held")
    if input == 1 {
        fail CrashError.One
    }
    if input == 2 {
        loop {
        }
    }
    if input == 3 {
        try await world.clock.sleep(60_000)
    }
    let quotient = 100 / input
    discard held
    return quotient
} main
