//! The allocation routines of `x86_64-linux`, each pool taking a lock of its own: `Alloc` and `AllocIn` carve a small allocation and `Free` frees one under its pool's lock, calling routines that take the lock of allocations only to add a pool, to draw or return chunks, for an allocation larger than a chunk or to free in a run of chunks no pool carves; `Lift` takes the pool's lock, then the lock of allocations, and copies an allocation holding neither. Each wakes the tasks waiting on charges it took out of their bands once it holds no lock. A routine taking both takes the pool's first. Each placement and charge is the one the lock of allocations alone gives.

/// How a routine carving or freeing draws and returns chunks: in place, holding the lock of
/// allocations, or through the routines taking it.
enum Draw derives Copy {
    Held
    Called
} Draw

/// A chunk drawn for a pool to carve, made the pool's chunk; zero on exhaustion.
fn Draw.pool_chunk(self, mut lo: Lowering, mut fx: Fx, pool: clif::Value, handle: clif::Value, domain: clif::Value) -> clif::Value {
    match self {
        Draw.Held => return pool_chunk(mut lo, mut fx, pool, handle, domain)
        Draw.Called => {
            let drawn = mut lo.call_routine(mut fx, routine: Routine.PoolDraw, args: fx.list3(pool, b: handle, c: domain).view())
            expect drawn.len() > 0
            return drawn[0]
        }
    }
} Draw.pool_chunk

/// Returns a run of chunks by its record.
fn Draw.chunk_return(self, mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    match self {
        Draw.Held => return_chunk(mut lo, mut fx, record)
        Draw.Called => {
            discard mut lo.call_routine(mut fx, routine: Routine.ChunkReturn, args: fx.list1(record).view())
        }
    }
} Draw.chunk_return

/// `Alloc`, `AllocIn`, `Free`, `Lift` and the routines they call on `x86_64-linux`.
fn pools_define(mut lo: Lowering, mut fx: Fx, routine: Routine) {
    let params = mut fx.entry()
    expect params.len() > 0
    match routine {
        Routine.PoolAdd => {
            expect params.len() > 1
            let lock = allocations_lock(mut lo, mut fx)
            locks_acquire(mut lo, mut fx, lock)
            let added = domain_pool(mut lo, mut fx, domain: params[0], handle: params[1])
            locks_release(mut lo, mut fx, lock)
            mut fx.b.ret(fx.list1(added).view())
        }
        Routine.PoolDraw => {
            expect params.len() > 2
            let lock = allocations_lock(mut lo, mut fx)
            locks_acquire(mut lo, mut fx, lock)
            let drawn = pool_chunk(mut lo, mut fx, pool: params[0], handle: params[1], domain: params[2])
            locks_release(mut lo, mut fx, lock)
            mut fx.b.ret(fx.list1(drawn).view())
        }
        Routine.AllocLarge => {
            expect params.len() > 2
            let lock = allocations_lock(mut lo, mut fx)
            locks_acquire(mut lo, mut fx, lock)
            let drawn = allocate_large(mut lo, mut fx, handle: params[0], size: params[1], domain: params[2])
            locks_release(mut lo, mut fx, lock)
            mut fx.b.ret(fx.list1(drawn).view())
        }
        Routine.ChunkReturn => {
            let lock = allocations_lock(mut lo, mut fx)
            locks_acquire(mut lo, mut fx, lock)
            return_chunk(mut lo, mut fx, record: params[0])
            locks_release(mut lo, mut fx, lock)
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.FreeUnpooled => {
            expect params.len() > 1
            let lock = allocations_lock(mut lo, mut fx)
            locks_acquire(mut lo, mut fx, lock)
            release_in_chunk(mut lo, mut fx, record: params[0], address: params[1], draw: Draw.Held)
            locks_release(mut lo, mut fx, lock)
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.LockWait => {
            wait_free(mut lo, mut fx, lock: params[0])
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.Alloc or Routine.AllocIn => {
            expect params.len() > 2
            let domain = match routine {
                Routine.Alloc => running_domain(mut lo, mut fx)
                else => params[3]
            }
            let address = pools_alloc(mut lo, mut fx, handle: params[0], size: params[1], align: params[2], domain)
            wake_left(mut lo, mut fx)
            mut fx.b.ret(fx.list1(address).view())
        }
        Routine.Free => {
            pools_free(mut lo, mut fx, address: params[0])
            wake_left(mut lo, mut fx)
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        else => {
            expect params.len() > 1
            let lock = allocations_lock(mut lo, mut fx)
            let lifted = pools_lift(mut lo, mut fx, lock, address: params[0], target: params[1])
            wake_left(mut lo, mut fx)
            mut fx.b.ret(fx.list1(lifted).view())
        }
    }
} pools_define

/// The address of the lock of allocations.
fn allocations_lock(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    return mut fx.offset(state_address, offset: STATE_LOCK)
} allocations_lock

/// `Alloc` and `AllocIn` on `x86_64-linux`: an allocation larger than a chunk through
/// `AllocLarge`, a smaller one under its pool's lock, the pool found without a lock and added
/// through `PoolAdd`.
fn pools_alloc(mut lo: Lowering, mut fx: Fx, handle: clif::Value, size: clif::Value, align: clif::Value, domain: clif::Value) -> clif::Value {
    let large = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThan, x: size, y: i64.fit(MEMORY_CHUNK))
    let allocated = mut fx.choose_in(mut lo, condition: large, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return mut lo1.call_routine(mut fx1, routine: Routine.AllocLarge, args: fx1.list3(handle, b: size, c: domain).view())
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let found = pool_search(mut fx1, domain, handle)
        let missing = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: found, y: 0)
        let pools = mut fx1.choose_in(mut lo1, condition: missing, results: fx1.types1(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return mut lo2.call_routine(mut fx2, routine: Routine.PoolAdd, args: fx2.list2(domain, b: handle).view())
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(found)
        })
        let pool = pools[0]
        let pool_lock = mut fx1.offset(pool, offset: MEMORY_POOL_LOCK)
        locks_acquire(mut lo1, fx: mut fx1, lock: pool_lock)
        let carved = memory_carve(mut lo1, fx: mut fx1, pool, handle, size, align, domain, draw: Draw.Called)
        locks_release(mut lo1, fx: mut fx1, lock: pool_lock)
        return fx1.list1(carved)
    })
    return allocated[0]
} pools_alloc

/// `Free` on `x86_64-linux`: under the lock of the pool carving the allocation's run of chunks,
/// read without a lock and again under it, or through `FreeUnpooled` for a run no pool carves.
fn pools_free(mut lo: Lowering, mut fx: Fx, address: clif::Value) {
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: address, y: 0)
    mut fx.if_true(present, then: fn[mut lo](mut fx1: Fx) {
        let record = chunk_of(mut lo, fx: mut fx1, address)
        discard mut fx1.repeat(mem::List[clif::Value].empty(fx1.alloc).view(), body: fn[mut lo](mut fx2: Fx, state: Slice[clif::Value]) -> Pass {
            let pool = mut fx2.load(PTR, addr: record, offset: CHUNK_POOL)
            let pooled = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: pool, y: 0)
            let moved = mut fx2.choose_in(mut lo, condition: pooled, results: fx2.types1(clif::Type.Int8).view(), then: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let pool_lock = mut fx3.offset(pool, offset: MEMORY_POOL_LOCK)
                locks_acquire(mut lo3, fx: mut fx3, lock: pool_lock)
                let held = mut fx3.load(PTR, addr: record, offset: CHUNK_POOL)
                let same = mut fx3.b.icmp(clif::IntCC.Equal, x: held, y: pool)
                discard mut fx3.choose_in(mut lo3, condition: same, results: mem::List[clif::Type].empty(fx3.alloc).view(), then: fn(mut lo4: Lowering, mut fx4: Fx) -> mem::List[clif::Value] {
                    release_in_chunk(mut lo4, fx: mut fx4, record, address, draw: Draw.Called)
                    return mem::List[clif::Value].empty(fx4.alloc)
                }, otherwise: fn(mut lo4: Lowering, mut fx4: Fx) -> mem::List[clif::Value] {
                    return mem::List[clif::Value].empty(fx4.alloc)
                })
                locks_release(mut lo3, fx: mut fx3, lock: pool_lock)
                let changed = mut fx3.b.bxor_imm_s(same, y: 1)
                return fx3.list1(changed)
            }, otherwise: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                discard mut lo3.call_routine(mut fx3, routine: Routine.FreeUnpooled, args: fx3.list2(record, b: address).view())
                let settled = mut fx3.int(clif::Type.Int8, value: 0)
                return fx3.list1(settled)
            })
            return Pass(again: moved[0], next: mem::List[clif::Value].empty(fx2.alloc))
        })
    })
} pools_free

/// `Lift` on `x86_64-linux`: settled under the locks `pools_settle` takes, a copy carved and the
/// original freed through the routines `Alloc` and `Free` run, holding no lock, and the run
/// passed under the locks again when no copy is carved.
fn pools_lift(mut lo: Lowering, mut fx: Fx, lock: clif::Value, address: clif::Value, target: clif::Value) -> clif::Value {
    let to = mut fx.b.band_imm_s(target, y: ~TRANSFER_COPY)
    let record = chunk_of(mut lo, mut fx, address)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
    let lifted = mut fx.choose_in(mut lo, condition: present, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let settled = pools_settle(mut lo1, fx: mut fx1, lock, record, address, target, to)
        let copying = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: settled[0], y: 0)
        return mut fx1.choose_in(mut lo1, condition: copying, results: fx1.types1(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let copy = pools_copy(mut lo2, fx: mut fx2, address, bytes: settled[0], cells: CopyCells(preferred: settled[1], own: settled[2]), to)
            let carved = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: copy, y: 0)
            return mut fx2.choose_in(mut lo2, condition: carved, results: fx2.types1(PTR).view(), then: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                return fx3.list1(copy)
            }, otherwise: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                discard pools_settle(mut lo3, fx: mut fx3, lock, record, address, target: to, to)
                return fx3.list1(address)
            })
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(address)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(address)
    })
    return lifted[0]
} pools_lift

/// Under the lock of the pool carving a run of chunks, when one does, then the lock of
/// allocations at `lock`, the pool read again under both: when a domain nested in `to` owns the
/// run, the bytes of the copy of the allocation at `address` that the target asks for, and the
/// cells it is carved for; otherwise zeros, the run passed to `to` when such a domain owns it.
fn pools_settle(mut lo: Lowering, mut fx: Fx, lock: clif::Value, record: clif::Value, address: clif::Value, target: clif::Value, to: clif::Value) -> mem::List[clif::Value] {
    let zero = mut fx.ptr(0)
    return mut fx.repeat(fx.list3(zero, b: zero, c: zero).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        let pool = mut fx1.load(PTR, addr: record, offset: CHUNK_POOL)
        let pooled = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: pool, y: 0)
        let pool_lock = mut fx1.offset(pool, offset: MEMORY_POOL_LOCK)
        mut fx1.if_true(pooled, then: fn[mut lo](mut fx2: Fx) {
            locks_acquire(mut lo, fx: mut fx2, lock: pool_lock)
        })
        locks_acquire(mut lo, fx: mut fx1, lock)
        let held = mut fx1.load(PTR, addr: record, offset: CHUNK_POOL)
        let same = mut fx1.b.icmp(clif::IntCC.Equal, x: held, y: pool)
        let outcome = mut fx1.choose_in(mut lo, condition: same, results: fx1.types3(PTR, b: PTR, c: PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let owner = mut fx2.load(PTR, addr: record, offset: CHUNK_DOMAIN)
            let inside = nested_in(mut fx2, inner: owner, outer: to)
            return mut fx2.choose_in(mut lo2, condition: inside, results: fx2.types3(PTR, b: PTR, c: PTR).view(), then: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let picked = pools_copy_size(mut lo3, fx: mut fx3, record, address, target, to)
                let passing = mut fx3.b.icmp_imm_s(clif::IntCC.Equal, x: picked[0], y: 0)
                mut fx3.if_true(passing, then: fn[mut lo3](mut fx4: Fx) {
                    pass_run(mut lo3, fx: mut fx4, record, to)
                })
                return picked
            }, otherwise: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let none = mut fx3.ptr(0)
                return fx3.list3(none, b: none, c: none)
            })
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let none = mut fx2.ptr(0)
            return fx2.list3(none, b: none, c: none)
        })
        locks_release(mut lo, fx: mut fx1, lock)
        mut fx1.if_true(pooled, then: fn[mut lo](mut fx2: Fx) {
            locks_release(mut lo, fx: mut fx2, lock: pool_lock)
        })
        let changed = mut fx1.b.bxor_imm_s(same, y: 1)
        return Pass(again: changed, next: take outcome)
    })
} pools_settle

/// The bytes of the copy out of a run that the target asks for, zero for none, and the cells it
/// is carved for.
fn pools_copy_size(mut lo: Lowering, mut fx: Fx, record: clif::Value, address: clif::Value, target: clif::Value, to: clif::Value) -> mem::List[clif::Value] {
    let wanted = copy_wanted(mut fx, record, target)
    return mut fx.choose_in(mut lo, condition: wanted, results: fx.types3(PTR, b: PTR, c: PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let index = carved_class(mut fx1, record, address)
        let classed = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: index, y: i64.fit(CLASSES))
        return mut fx1.choose_in(mut lo1, condition: classed, results: fx1.types3(PTR, b: PTR, c: PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let bytes = class_bytes(mut fx2, index)
            let cells = copy_cells(mut lo2, fx: mut fx2, record, to)
            return fx2.list3(bytes, b: cells.preferred, c: cells.own)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let none = mut fx2.ptr(0)
            return fx2.list3(none, b: none, c: none)
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let none = mut fx1.ptr(0)
        return fx1.list3(none, b: none, c: none)
    })
} pools_copy_size

/// The copy of `bytes` at `address` carved in a domain for the preferred cell, else for the run's
/// own, the original freed once it is filled; zero when none is carved.
fn pools_copy(mut lo: Lowering, mut fx: Fx, address: clif::Value, bytes: clif::Value, cells: CopyCells, to: clif::Value) -> clif::Value {
    let align = mut fx.ptr(GRANULE)
    let copy = pools_alloc(mut lo, mut fx, handle: cells.preferred, size: bytes, align, domain: to)
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: copy, y: 0)
    let other = mut fx.b.icmp(clif::IntCC.NotEqual, x: cells.preferred, y: cells.own)
    let retry = mut fx.b.band(missing, y: other)
    let copies = mut fx.choose_in(mut lo, condition: retry, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let again = pools_alloc(mut lo1, fx: mut fx1, handle: cells.own, size: bytes, align, domain: to)
        return fx1.list1(again)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(copy)
    })
    let carved = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: copies[0], y: 0)
    mut fx.if_true(carved, then: fn[mut lo](mut fx1: Fx) {
        discard mut lo.call_routine(mut fx1, routine: Routine.Copy, args: fx1.list3(copies[0], b: address, c: bytes).view())
        pools_free(mut lo, fx: mut fx1, address)
    })
    return copies[0]
} pools_copy
