//! Building input values for property tests.

pub interface Generate {
    fn generate(mut choices: Choices, alloc: mem::Alloc) -> Self limits terminates
} Generate

pub open struct Choices {
} Choices

pub fn Choices.draw(mut self, low: u64, high: u64) -> u64 limits notrap, terminates
    requires low <= high
    ensures low <= result and result <= high

pub fn Choices.draw_signed(mut self, low: i64, high: i64) -> i64 limits notrap, terminates
    requires low <= high
    ensures low <= result and result <= high

struct Roll derives Copy {
    face: u64
    offset: i64
} Roll

impl Roll: Generate

fn Roll.generate(mut choices: Choices, alloc: mem::Alloc) -> Roll limits terminates {
    let face = mut choices.draw(1, high: 6)
    let offset = mut choices.draw_signed(-3, high: 3)
    return Roll(face: face, offset: offset)
} Roll.generate

test draws_stay_within_their_bounds for Choices.draw (roll: Roll) {
    expect roll.face >= 1 and roll.face <= 6
} draws_stay_within_their_bounds

test signed_draws_stay_within_their_bounds for Choices.draw_signed (roll: Roll) {
    expect roll.offset >= -3 and roll.offset <= 3
} signed_draws_stay_within_their_bounds
