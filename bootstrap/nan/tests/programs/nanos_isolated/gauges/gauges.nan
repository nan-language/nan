//! Gauges and lines whose operations cross as bytes and handles: each gauge adds the amounts it is given to the total the gauges of its minter share, settles that total once its minter's clock has run on, and trades, writing the total through the log it is given and giving back a gauge deriving from it; each line dials the calls it is given, which its kernel admits while the credit the lines of its minter share lasts and a kernel's own call of reaches no instance; the gauges and lines of a minter keep the first byte of the header their last settling or admission ran under.

pub open struct Gauge {
} Gauge

/// What the gauges of a minter share: their total, the clock a settling waits on and the first byte
/// of the header their last settling ran under, 0 for none.
pub open struct Gauged derives Send {
    total: core::atomic::AtomicU64
    clock: sys::Clock
    headed: core::atomic::AtomicU64
} Gauged

impl Gauge: sys::Kind[Gauged, u64]

impl Gauge: sys::Crossing

/// The operations of a gauge: adding an amount and giving the total, settling the total, and
/// trading.
const ADD: u64 = 0

const SETTLE: u64 = 1

const TRADE: u64 = 2

/// The nanoseconds a settling waits.
const SETTLING_NS: u64 = 1_000_000

pub fn open(clock: sys::Clock, alloc: mem::Alloc) -> sys::Minter[Gauge, Gauged, u64] {
    return sys::Minter.of(Gauged(total: core::atomic::AtomicU64.of(0), clock: clock, headed: core::atomic::AtomicU64.of(0)), alloc)
} open

pub fn mint(minter: sys::Minter[Gauge, Gauged, u64]) -> Gauge {
    return minter.mint(0)
} mint

pub fn revoke(minter: sys::Minter[Gauge, Gauged, u64], gauge: Gauge) {
    minter.revoke(gauge)
} revoke

pub fn close(take minter: sys::Minter[Gauge, Gauged, u64]) {
    take minter.close()
} close

pub fn Gauge.add(self, amount: u64, alloc: mem::Alloc) -> u64 fails sys::CrossError {
    var args = mem::Bytes.empty(alloc)
    mem::wire::Codec[u64].encode(amount, out: mut args)
    let none = mem::List[sys::Handle].empty(alloc)
    return try total_of(try sys::Handle.of(self).invoke(ADD, args: args.view(), handles: none.view(), alloc), alloc)
} Gauge.add

pub fn Gauge.settled(self, alloc: mem::Alloc) -> u64 fails sys::CrossError uses wait {
    let none = mem::List[sys::Handle].empty(alloc)
    return try total_of(try await sys::Handle.of(self).call(SETTLE, args: b"", handles: none.view(), alloc), alloc)
} Gauge.settled

/// Has the gauge's kernel write its total through `log` and give back a gauge deriving from it.
pub fn Gauge.traded(self, log: sys::Log, alloc: mem::Alloc) -> Gauge fails sys::CrossError uses wait {
    let given = Array[sys::Handle, 1].filled(sys::Handle.of(log))
    let traded = try await sys::Handle.of(self).call(TRADE, args: b"", handles: given.view(), alloc)
    let Some(handle) = traded.handles.get(0) else {
        fail sys::CrossError.Refused
    }
    let Some(gauge) = sys::CapabilityId[Gauge](id: 0).of_handle(handle) else {
        fail sys::CrossError.Refused
    }
    return gauge
} Gauge.traded

pub fn Gauge.invoke(self, operation: u64, args: Untrusted[Slice[u8]], handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::CrossError limits stack 4_096 {
    let Ok(amount) = attempt mem::wire::Codec[u64].decode(args, alloc) else {
        fail sys::CrossError.Refused
    }
    if operation != ADD {
        fail sys::CrossError.Refused
    }
    let added = sys::reach(self, body: fn(state: Gauged, record: u64) => state.total.fetch_add(amount))
    let Some(Some(before)) = added else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    return encoded_total(before.wrapping_add(amount), alloc)
} Gauge.invoke

pub fn Gauge.call(self, operation: u64, args: Untrusted[Slice[u8]], handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::CrossError uses wait limits stack 4_096 {
    if operation == TRADE {
        return try traded_through(self, handles, alloc)
    }
    if operation != SETTLE {
        fail sys::CrossError.Refused
    }
    let Some(clock) = sys::reach(self, body: fn(state: Gauged, record: u64) -> sys::Clock {
        state.headed.store(header_mark())
        return state.clock
    }) else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    try await clock.sleep_ns(SETTLING_NS)
    let Some(total) = sys::reach(self, body: fn(state: Gauged, record: u64) => state.total.load()) else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    return encoded_total(total, alloc)
} Gauge.call

/// Writes the total of `gauge` through the log `handles` holds and gives a gauge deriving from it.
fn traded_through(gauge: Gauge, handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::CrossError {
    if handles.len() != 1 {
        fail sys::CrossError.Refused
    }
    let Some(log) = sys::CapabilityId[sys::Log](id: 0).of_handle(handles[0]) else {
        fail sys::CrossError.Refused
    }
    let Some(total) = sys::reach(gauge, body: fn(state: Gauged, record: u64) => state.total.load()) else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    log.info("traded", value: total)
    var traded = sys::Encoded.empty(alloc)
    mut traded.handles.push(sys::Handle.of(try sys::derive(gauge, narrow: fn(state: Gauged, record: u64) => record)))
    return traded
} traded_through

/// The first byte of the header of the last settling of a gauge's minter, 0 once it is revoked.
pub fn Gauge.headed(self) -> u64 {
    return sys::reach(self, body: fn(state: Gauged, record: u64) => state.headed.load()).value_or(0)
} Gauge.headed

/// The first byte of the running task's header, 0 for none.
fn header_mark() -> u64 {
    let Some(header) = sys::current_header() else {
        return 0
    }
    return u64.widen(header.bytes[0])
} header_mark

fn encoded_total(total: u64, alloc: mem::Alloc) -> sys::Encoded {
    var encoding = sys::Encoded.empty(alloc)
    mem::wire::Codec[u64].encode(total, out: mut encoding.bytes)
    return encoding
} encoded_total

fn total_of(encoding: sys::Encoded, alloc: mem::Alloc) -> u64 fails sys::CrossError {
    match attempt mem::wire::Codec[u64].decode(Untrusted.of(encoding.bytes.view()), alloc) {
        Ok(total) => return total
        Err(_) => fail sys::CrossError.Refused
    }
} total_of

pub open struct Line {
} Line

/// What the lines of a minter share: the calls they may still make, those their kernel admitted,
/// those it made itself and the first byte of the header their last admission ran under, 0 for
/// none.
pub open struct Lined derives Send {
    credit: core::atomic::AtomicU64
    admitted: core::atomic::AtomicU64
    relayed: core::atomic::AtomicU64
    headed: core::atomic::AtomicU64
} Lined

impl Line: sys::Kind[Lined, u64]

impl Line: sys::Crossing

/// The operation of a line: dialling a call.
pub const DIAL: u64 = 0

pub fn open_lines(credit: u64, alloc: mem::Alloc) -> sys::Minter[Line, Lined, u64] {
    return sys::Minter.of(Lined(credit: core::atomic::AtomicU64.of(credit), admitted: core::atomic::AtomicU64.of(0), relayed: core::atomic::AtomicU64.of(0), headed: core::atomic::AtomicU64.of(0)), alloc)
} open_lines

pub fn mint_line(minter: sys::Minter[Line, Lined, u64]) -> Line {
    return minter.mint(0)
} mint_line

pub fn revoke_line(minter: sys::Minter[Line, Lined, u64], line: Line) {
    minter.revoke(line)
} revoke_line

pub fn close_lines(take minter: sys::Minter[Line, Lined, u64]) {
    take minter.close()
} close_lines

pub fn Line.dial(self, call: Slice[u8], alloc: mem::Alloc) -> mem::Bytes fails sys::CrossError uses wait {
    let none = mem::List[sys::Handle].empty(alloc)
    let sys::Encoded(bytes: reply, handles: _) = try await sys::Handle.of(self).call(DIAL, args: call, handles: none.view(), alloc)
    return reply
} Line.dial

/// The calls the kernel of a line admitted, 0 once it is revoked.
pub fn Line.admitted(self) -> u64 {
    return sys::reach(self, body: fn(state: Lined, record: u64) => state.admitted.load()).value_or(0)
} Line.admitted

/// The first byte of the header of the last admission of a line's minter, 0 once it is revoked.
pub fn Line.headed(self) -> u64 {
    return sys::reach(self, body: fn(state: Lined, record: u64) => state.headed.load()).value_or(0)
} Line.headed

/// The calls the kernel of a line made itself, 0 once it is revoked.
pub fn Line.relayed(self) -> u64 {
    return sys::reach(self, body: fn(state: Lined, record: u64) => state.relayed.load()).value_or(0)
} Line.relayed

/// Admits a dialled call while the credit lasts.
pub fn Line.invoke(self, operation: u64, args: Untrusted[Slice[u8]], handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::CrossError limits stack 4_096 {
    if operation != DIAL {
        fail sys::CrossError.Refused
    }
    let spent = sys::reach(self, body: fn(state: Lined, record: u64) -> bool {
        state.headed.store(header_mark())
        if state.credit.fetch_sub(1).is_none() {
            return false
        }
        discard state.admitted.fetch_add(1)
        return true
    })
    let Some(admitted) = spent else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    if not admitted {
        fail sys::CrossError.Refused
    }
    return sys::Encoded.empty(alloc)
} Line.invoke

/// Counts a call its kernel makes itself, which reaches no instance.
pub fn Line.call(self, operation: u64, args: Untrusted[Slice[u8]], handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::CrossError limits stack 4_096 {
    let Some(_) = sys::reach(self, body: fn(state: Lined, record: u64) => state.relayed.fetch_add(1)) else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    fail sys::CrossError.Refused
} Line.call
