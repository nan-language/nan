//! Final builds: checking a program's final closure, lowering its reach and linking its image, and building a bundle against a kernel's interface.

/// The entry landing fn each platform package holds.
const LANDING: Str = "enter"

/// What a final build reports and the image it writes, relative to the workspace root, with a
/// kernel's interface file.
pkg struct Build {
    pkg diagnostics: mem::List[diagnostic::Diagnostic]
    pkg image: Option[text::String]
    pkg interface_file: Option[text::String]
} Build

/// A build writing nothing, with what it reports.
fn Build.failed(take diagnostics: mem::List[diagnostic::Diagnostic]) -> Build {
    return Build(diagnostics: take diagnostics, image: None, interface_file: None)
} Build.failed

/// An image whose code roots a final build compares with those of its own: its path, and how
/// the command line writes it.
pkg struct Compared {
    pkg path: text::String
    pkg written: text::String
} Compared

/// Performs the final build of the program at index `program` of the workspace, comparing its
/// code roots with those of the image `compared` gives, when given.
pkg fn build(session: check::Session, program: usize, compared: Option[Compared], alloc: mem::Alloc) -> Build fails platform::IoError {
    let held = session.workspace.contents()
    let Some(source) = held.package_at(program) else {
        expect false
        return Build.failed(mem::List[diagnostic::Diagnostic].empty(alloc))
    }
    if source.program_target().is_nanos() {
        var diagnostics = mem::List[diagnostic::Diagnostic].empty(alloc)
        mut diagnostics.push(interface_error(source, reason: "a nanos program builds only against a kernel's interface file", alloc))
        return Build.failed(take diagnostics)
    }
    if source.program_target().kind() == Some(workspace::Kind.Windows) {
        var diagnostics = mem::List[diagnostic::Diagnostic].empty(alloc)
        mut diagnostics.push(at_manifest(source, reported: diagnostic::Diagnostic.new(diagnostic::Code.TargetImageUnavailable, alloc), alloc))
        return Build.failed(take diagnostics)
    }
    let closures = session.check_closures_coding(program)
    var diagnostics = session.reported_by(closures, scope: scope::Scope.Workspace)
    let Some(checked) = held.closure_of(program) else {
        return Build.failed(take diagnostics)
    }
    let target = source.program_target()
    let program_checker = session.checker_in(take closures, package_index: program, target)
    let coding = program_checker.is_some() and session.codes_in_check(checked, package_index: program, target)
    let checker = match program_checker {
        Some(found) => found
        None => session.checked(checked, target)
    }
    let root = package_id(checker, program)
    let closure = checker.reached(root, alloc)
    mut diagnostics.retain(fn(reported: diagnostic::Diagnostic) -> bool {
        let Some(path) = reported.path else {
            return true
        }
        let Some(at) = held.file(path.as_str()) else {
            return false
        }
        return holds_source(checker, closure: closure.view(), package_index: at.package_index)
    })
    for reported in take checker.release_errors(root, alloc) {
        mut diagnostics.push(take reported)
    }
    if errors(diagnostics.view()) {
        return Build.failed(take diagnostics)
    }
    let name = text::String.of(checker.db().package_data(root).name.as_str(), alloc)
    let artefacts = artefacts_of(session, checker, root, coding, alloc)
    match compared {
        Some(image) => {
            for reported in take stage::compare(checker, artefacts, image: image.path.as_str(), written: image.written.as_str(), alloc) {
                mut diagnostics.push(take reported)
            }
            if errors(diagnostics.view()) {
                return Build.failed(take diagnostics)
            }
        }
        None => {}
    }
    let record = codes_record(session, checker, root, kind: "program", alloc)
    let program_lowering = lower_program(checker, root, artefacts, level: level_of(source, target), dumping: false, kept: kept_codes(session, record: record.as_str(), alloc), toolchain: session.toolchain_hash(), alloc)
    let lowered = program_lowering.lowered
    keep_codes(session, record: record.as_str(), lowered, alloc)
    for reported in take collisions(source, lowered, alloc) {
        mut diagnostics.push(take reported)
    }
    judge_stacks(checker, lowered, runtime: program_lowering.runtime, mut diagnostics, alloc)
    if errors(diagnostics.view()) {
        return Build.failed(take diagnostics)
    }
    var image = image_path(target, name: name.as_str(), suffix: target.image_suffix(), alloc)
    let written = platform::join(held.root.as_str(), name: image.as_str(), alloc)
    let Err(output) = try write_image(target, object: lowered.object.view(), image: written.as_str(), alloc) else {
        let Some(file) = program_lowering.interface_bytes else {
            return Build(diagnostics: take diagnostics, image: Some(take image), interface_file: None)
        }
        var interface_path = image_path(target, name: name.as_str(), suffix: ".nlif", alloc)
        try write_file(platform::join(held.root.as_str(), name: interface_path.as_str(), alloc).as_str(), contents: file.view(), alloc)
        return Build(diagnostics: take diagnostics, image: Some(take image), interface_file: Some(take interface_path))
    }
    mut diagnostics.push(link_failed(source, target, output: output.as_str(), alloc))
    return Build.failed(take diagnostics)
} build

/// The diagnostic of a failing run of the linker of a host target linking a program's image, on
/// the program's `entry` directive, quoting the linker's output.
fn link_failed(source: workspace::Package, target: workspace::Target, output: Str, alloc: mem::Alloc) -> diagnostic::Diagnostic {
    var reported = at_entry(source, code: diagnostic::Code.TargetLinkFailed, alloc)
    reported.envelope = Some(diagnostic::Envelope(origin: lower::host_linker(target, alloc), lines: lines_of(output, alloc)))
    return reported
} link_failed

/// The path of a file of a target's images directory, named after a package with a suffix.
fn image_path(target: workspace::Target, name: Str, suffix: Str, alloc: mem::Alloc) -> text::String {
    var path = text::String.of(".nan/images/", alloc)
    mut path.append(target.name())
    mut path.push('/')
    mut path.append(name)
    mut path.append(suffix)
    return path
} image_path

/// A diagnostic on a program's `entry` directive.
fn at_entry(source: workspace::Package, code: diagnostic::Code, alloc: mem::Alloc) -> diagnostic::Diagnostic {
    var line: u32 = 1
    match source.manifest {
        Some(manifest) => {
            line = manifest.line
            match manifest.entry {
                Some(entry) => {
                    line = entry.line
                }
                None => {}
            }
        }
        None => {
            expect false
        }
    }
    let Some(manifest_file) = source.files.get(0) else {
        expect false
        return diagnostic::Diagnostic.new(code, alloc)
    }
    return diagnostic::Diagnostic.at(code, path: manifest_file.path.as_str(), line, alloc)
} at_entry

/// The lines of a text: its parts between line feeds, a carriage return before a line feed
/// excluded, and no last empty part after a final line feed.
pkg fn lines_of(written: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var lines = mem::List[text::String].empty(alloc)
    let bytes = written.as_bytes()
    var start: usize = 0
    while start < bytes.len() {
        var end = start
        while end < bytes.len() and bytes[end] != b'\n' {
            end += 1
        }
        expect end <= bytes.len() and bytes.len() < ~0usize
        var content_end = end
        if end < bytes.len() and content_end > start and bytes[content_end - 1] == b'\r' {
            content_end -= 1
        }
        let Some(line) = written.slice_bytes(start, end: content_end) else {
            return lines
        }
        mut lines.push(text::String.of(line, alloc))
        start = end + 1
    }
    return lines
} lines_of

/// The codegen level a program's manifest gives for a target's architecture.
fn level_of(source: workspace::Package, target: workspace::Target) -> Option[workspace::Level] {
    let Some(manifest) = source.manifest else {
        return None
    }
    for level in manifest.levels {
        if target.arch() == Some(level.arch()) {
            return Some(level)
        }
    }
    return None
} level_of

/// Adds the reports of the stack demands of a program's lowering and of its runtime's.
fn judge_stacks(checker: check::Checker, lowered: lower::Lowered, runtime: Option[lower::Lowered], mut diagnostics: mem::List[diagnostic::Diagnostic], alloc: mem::Alloc) {
    for reported in take lower::stack_judge(checker, all_frames: lowered.frames.view(), demands: lowered.demands.view(), alloc) {
        mut diagnostics.push(take reported)
    }
    match runtime {
        Some(held) => {
            for reported in take lower::stack_judge(checker, all_frames: held.frames.view(), demands: held.demands.view(), alloc) {
                mut diagnostics.push(take reported)
            }
        }
        None => {}
    }
} judge_stacks

/// A program's lowering, the interface file of a kernel exporting the load ABI, and the lowering
/// of the user-mode runtime of a kernel running nanos jobs in isolated spaces, whose image the
/// program's holds.
struct ProgramLowering {
    lowered: lower::Lowered
    interface_bytes: Option[mem::Bytes]
    runtime: Option[lower::Lowered]
} ProgramLowering


/// The lowering of the program whose package is `root`, for the checker's target at a codegen
/// level, with the artefacts of its final closure; keeping the text of each function it defines
/// when `dumping`, and taking the code an earlier lowering compiled from `kept`; a kernel's
/// interface file names `toolchain`.
fn lower_program(checker: check::Checker, root: ty::PackageId, artefacts: mem::Map[text::String, mem::Bytes], level: Option[workspace::Level], dumping: bool, take kept: mem::Bytes, toolchain: hashing::HashValue, alloc: mem::Alloc) -> ProgramLowering {
    let db = checker.db()
    let target = db.target
    var entry: Option[ty::ItemId] = None
    match db.package_data(root).root {
        Some(module) => {
            entry = db.lookup(module, name: "main")
        }
        None => {}
    }
    var landing_item: Option[ty::ItemId] = None
    match target.platform_package() {
        Some(platform) => {
            for data in db.packages {
                if data.name.as_str() != platform {
                    continue
                }
                let Some(module) = data.root else {
                    break
                }
                landing_item = db.lookup(module, name: LANDING)
                break
            }
        }
        None => {}
    }
    let roots = code_roots(artefacts, alloc)
    let kernel = kernel_interface(checker, root, artefacts, level, toolchain, alloc)
    let entry_fn = entry.value_or(ty::ItemId(index: 0))
    let landing_fn = landing_item.value_or(ty::ItemId(index: 0))
    expect entry.is_some() and landing_item.is_some()
    var program = program_of(entry_fn, landing_fn, root, artefacts, roots: roots.view(), level, dumping, take kept, alloc)
    var interface_bytes: Option[mem::Bytes] = None
    var runtime: Option[lower::Lowered] = None
    match kernel {
        Some(found) => {
            program.kernel = Some(found.shared.share())
            program.loaded = found.loaded
            if found.isolates {
                let lowered_runtime = lower::lower_runtime(checker, program)
                let exported = found.shared.contents()
                program.runtime = Some(image::write_runtime(lowered_runtime.object.view(), hash: exported.hash.view(), exports: exported.exports.view(), start: lower::SPACE_START, stack: lower::SPACE_STACK, boot: lower::SPACE_BOOT, lines: lower::LINES_SYMBOL, alloc))
                runtime = Some(take lowered_runtime)
            }
            interface_bytes = Some(take found.file)
        }
        None => {}
    }
    if target.is_machine() {
        return ProgramLowering(lowered: lower::lower_machine(checker, program), interface_bytes: take interface_bytes, runtime: take runtime)
    }
    return ProgramLowering(lowered: lower::lower_lower(checker, program, tree: tree_of(roots.view(), alloc)), interface_bytes: take interface_bytes, runtime: take runtime)
} lower_program

/// What the final build of the program whose package is `root` lowers.
fn program_of(entry_fn: ty::ItemId, landing_fn: ty::ItemId, root: ty::PackageId, artefacts: mem::Map[text::String, mem::Bytes], roots: Slice[Option[mem::Bytes]], level: Option[workspace::Level], dumping: bool, take kept: mem::Bytes, alloc: mem::Alloc) -> lower::Program {
    var link_roots = mem::List[ty::PackageId].empty(alloc)
    mut link_roots.push(root)
    return lower::Program(entry: entry_fn, landing_fn: landing_fn, roots: take link_roots, prefixes: root_prefixes(artefacts, roots, alloc), section: section(artefacts, alloc), dump: dumping, kept: take kept, level: level, kernel: None, loaded: mem::List[ty::ItemId].empty(alloc), runtime: None)
} program_of

/// The symbol name and Cranelift text of each function the final build of the program package
/// named `package_name` of the workspace lowers, in order of definition, each text after a line
/// holding the symbol name and the text's length; nothing when its closure does not check.
pkg fn lowered_functions(session: check::Session, package_name: Str, alloc: mem::Alloc) -> mem::Bytes {
    var written = mem::Bytes.empty(alloc)
    let held = session.workspace.contents()
    let Some(program) = named_package(held, name: package_name) else {
        return written
    }
    let Some(checked) = held.closure_of(program) else {
        return written
    }
    let Some(source) = held.package_at(program) else {
        expect false
        return written
    }
    let checker = session.checked(checked, target: source.program_target())
    let root = package_id(checker, program)
    let artefacts = artefacts_of(session, checker, root, coding: false, alloc)
    let program_lowering = lower_program(checker, root, artefacts, level: level_of(source, target: source.program_target()), dumping: true, kept: mem::Bytes.empty(alloc), toolchain: session.toolchain_hash(), alloc)
    match program_lowering.runtime {
        Some(runtime) => dumped_into(mut written, functions: runtime.dumped.view(), alloc)
        None => {}
    }
    dumped_into(mut written, functions: program_lowering.lowered.dumped.view(), alloc)
    return written
} lowered_functions

/// Appends each function's text after a line holding its symbol name and the text's length.
fn dumped_into(mut written: mem::Bytes, functions: Slice[lower::LoweredFunction], alloc: mem::Alloc) {
    for function in functions {
        var header = text::String.of(function.name.as_str(), alloc)
        mut header.write(text::fmt(" {length}\n", length: function.text.byte_len()), budget: 100)
        mut written.append(header.as_bytes())
        mut written.append(function.text.as_bytes())
    }
} dumped_into

/// Writes the image of a lowered object at `image` through a staged file beside it, replacing
/// any earlier image at once: on a host target an executable the target's linker links, giving
/// the linker's output when it fails; on a machine target the image writer's, entered by the
/// program entry seam.
pkg fn write_image(target: workspace::Target, object: Slice[u8], image: Str, alloc: mem::Alloc) -> Result[Unit, text::String] fails platform::IoError {
    let Some(directory) = platform::parent(image, alloc) else {
        expect false
        fail platform::IoError.NotFound
    }
    try platform::create_dir_all(directory.as_str(), alloc)
    let Some(name) = platform::file_name(image, alloc) else {
        expect false
        fail platform::IoError.NotFound
    }
    let staged_new = staged(directory.as_str(), name: name.as_str(), extension: "new", alloc)
    if target.is_machine() {
        let bytes = image::write(target, object, entry: lower::MACHINE_ENTRY, alloc)
        try platform::write_file(staged_new.as_str(), contents: bytes.view())
    } else {
        let staged_object = staged(directory.as_str(), name: name.as_str(), extension: "o", alloc)
        try platform::write_file(staged_object.as_str(), contents: object)
        let linked = lower::host_link(target, object: staged_object.as_str(), image: staged_new.as_str(), alloc)
        try platform::remove_file(staged_object.as_str())
        let Ok(_) = linked else {
            return linked
        }
    }
    try platform::rename_path(staged_new.as_str(), to: image)
    return Ok(Unit)
} write_image

/// The path of a file staged beside an image: `.<name>.<process id>.<extension>` in its directory.
fn staged(directory: Str, name: Str, extension: Str, alloc: mem::Alloc) -> text::String {
    var file = text::String.of(".", alloc)
    mut file.append(name)
    mut file.write(text::fmt(".{id}.", id: platform::process_id()), budget: 32)
    mut file.append(extension)
    return platform::join(directory, name: file.as_str(), alloc)
} staged

/// The symbol collisions of a lowering for the image of a final-link root or tested package,
/// each reported on its `package` line, quoting both entities.
pkg fn collisions(source: workspace::Package, lowered: lower::Lowered, alloc: mem::Alloc) -> mem::List[diagnostic::Diagnostic] {
    var line: u32 = 1
    match source.manifest {
        Some(manifest) => {
            line = manifest.line
        }
        None => {}
    }
    var found = mem::List[diagnostic::Diagnostic].empty(alloc)
    for collision in lowered.collisions {
        let Some(manifest_file) = source.files.get(0) else {
            expect false
            return found
        }
        var reported = diagnostic::Diagnostic.at(diagnostic::Code.ArtefactSymbolCollision, path: manifest_file.path.as_str(), line, alloc)
        mut reported.because.push(diagnostic::Reason.note(collision.named.as_str(), alloc))
        mut reported.because.push(diagnostic::Reason.note(collision.colliding.as_str(), alloc))
        mut found.push(take reported)
    }
    return found
} collisions

fn errors(diagnostics: Slice[diagnostic::Diagnostic]) -> bool {
    for reported in diagnostics {
        if reported.code.class() == diagnostic::Class.Error {
            return true
        }
    }
    return false
} errors

/// The checker's id of the workspace package at an index.
fn package_id(checker: check::Checker, program: usize) -> ty::PackageId {
    let Some(id) = checker.db().package_of_member(workspace::Member.Source(program)) else {
        expect false
        return ty::PackageId(index: 0)
    }
    return id
} package_id

/// Whether the packages of a closure hold the workspace package at an index.
fn holds_source(checker: check::Checker, closure: Slice[ty::PackageId], package_index: usize) -> bool {
    let db = checker.db()
    for id in closure {
        if db.package_data(id).member == Some(workspace::Member.Source(package_index)) {
            return true
        }
    }
    return false
} holds_source

/// The artefact of each package lowered with the workspace package `root` of a checker's
/// closure, by package name: of the packages `root` reaches, a workspace package's of its current
/// state and a release's from the local store, and of each std package the toolchain's; `root`'s
/// code root from the checker when `coding`, the checker recording its reads.
pkg fn artefacts_of(session: check::Session, checker: check::Checker, root: ty::PackageId, coding: bool, alloc: mem::Alloc) -> mem::Map[text::String, mem::Bytes] {
    let db = checker.db()
    var packages = checker.reached(root, alloc)
    for index in 0..<db.packages.len() {
        if db.packages[index].std {
            mut packages.push(ty::PackageId(index: u32.fit(index)))
        }
    }
    let held = session.workspace.contents()
    let carried = session.over(session.carried.shared(session.grammar, given: session.home, alloc), alloc)
    var found = mem::Map[text::String, mem::Bytes].empty(alloc)
    for id in packages {
        let data = db.package_data(id)
        let built = match data.member {
            Some(workspace::Member.Release(index)) => released(held, index, alloc)
            Some(workspace::Member.Source(index)) => if coding and id == root {
                built_from(session, index, checker)
            } else {
                built_source(session, index)
            }
            None => built_carried(carried, name: data.name.as_str())
        }
        let Some(artefact) = built else {
            continue
        }
        discard mut found.insert(text::String.of(data.name.as_str(), alloc), value: take artefact)
    }
    return found
} artefacts_of

/// The artefact of the release at an index of a workspace's releases, from the local store.
fn released(held: workspace::Workspace, index: usize, alloc: mem::Alloc) -> Option[mem::Bytes] {
    var artefact = mem::Bytes.empty(alloc)
    let Some(release) = held.releases.get(index) else {
        expect false
        return None
    }
    mut artefact.append(release.entry.contents().artefact.view())
    return Some(take artefact)
} released

/// The artefact of the current state of the package at an index of a session's workspace, none
/// when no closure checks it.
fn built_source(session: check::Session, index: usize) -> Option[mem::Bytes] {
    let Some(closure) = session.workspace.contents().closure_of(index) else {
        return None
    }
    let built = session.build(closure, member: workspace::Member.Source(index))
    let check::Built(artefact: artefact, sources: _) = built
    return Some(take artefact)
} built_source

/// The artefact of the current state of the package at an index of a session's workspace, its
/// code root from a checker recording its reads.
fn built_from(session: check::Session, index: usize, checker: check::Checker) -> Option[mem::Bytes] {
    let Some(closure) = session.workspace.contents().closure_of(index) else {
        return None
    }
    let check::Built(artefact: artefact, sources: _) = session.build_from(closure, package_index: index, checked: checker)
    return Some(take artefact)
} built_from

/// The artefact of the std package of a name that the toolchain carries, from a session of the
/// std workspace.
fn built_carried(carried: check::Session, name: Str) -> Option[mem::Bytes] {
    let Some(index) = named_package(carried.workspace.contents(), name) else {
        expect false
        return None
    }
    return built_source(carried, index)
} built_carried

/// The index of the package of a workspace named `name`.
fn named_package(held: workspace::Workspace, name: Str) -> Option[usize] {
    for index in 0..<held.packages.len() {
        let Some(source) = held.package_at(index) else {
            expect false
            continue
        }
        let Some(found) = source.name() else {
            continue
        }
        if found == name {
            return Some(index)
        }
    }
    return None
} named_package

/// The prefix the symbols of each package carry, by package name: the first 12 characters of the
/// checksummed base32 of its code root hash's digest bytes.
pkg fn prefixes(artefacts: mem::Map[text::String, mem::Bytes], alloc: mem::Alloc) -> mem::HashMap[text::String, text::String] {
    let roots = code_roots(artefacts, alloc)
    return root_prefixes(artefacts, roots: roots.view(), alloc)
} prefixes

/// The code root of each artefact, in their order; none for one that does not decode.
fn code_roots(artefacts: mem::Map[text::String, mem::Bytes], alloc: mem::Alloc) -> mem::List[Option[mem::Bytes]] {
    var roots = mem::List[Option[mem::Bytes]].empty(alloc)
    for entry in artefacts {
        match artefact::decode(entry.value().view(), alloc) {
            Ok(decoded) => {
                var held = decoded
                mut roots.push(Some(take held.code_root))
            }
            Err(_) => mut roots.push(None)
        }
    }
    return roots
} code_roots

/// The prefixes `prefixes` gives, from the code roots of the artefacts, in their order.
fn root_prefixes(artefacts: mem::Map[text::String, mem::Bytes], roots: Slice[Option[mem::Bytes]], alloc: mem::Alloc) -> mem::HashMap[text::String, text::String] {
    var found = mem::HashMap[text::String, text::String].empty(seed: 0, alloc)
    var at: usize = 0
    for entry in artefacts {
        expect at < roots.len()
        let held = roots[at]
        at += 1
        let Some(code_root) = held else {
            continue
        }
        let root = hashing::HashValue.of(code_root.view())
        let Some(digest) = root.bytes.view().split_at(1) else {
            continue
        }
        let written = hashing::checksummed_base32(digest.tail, alloc)
        let Some(prefix) = written.as_str().slice_bytes(0, end: 12) else {
            continue
        }
        discard mut found.insert(text::String.of(entry.key().as_str(), alloc), value: text::String.of(prefix, alloc))
    }
    return found
} root_prefixes

/// The hash of the code roots of the artefacts of an image's `.nan` section, in its order.
fn tree_of(roots: Slice[Option[mem::Bytes]], alloc: mem::Alloc) -> hashing::HashValue {
    let Some(tree) = toolchain::roots_tree(roots, alloc) else {
        expect false
        return hashing::HashValue.of(b"")
    }
    return tree
} tree_of

/// The content of an image's `.nan` section: each package's artefact, in byte order of package
/// name.
fn section(artefacts: mem::Map[text::String, mem::Bytes], alloc: mem::Alloc) -> mem::Bytes {
    var out = mem::Bytes.empty(alloc)
    encoding::uvar(mut out, value: u64.widen(artefacts.len()))
    for entry in artefacts {
        encoding::bytes(mut out, value: entry.value().view())
    }
    return out
} section
