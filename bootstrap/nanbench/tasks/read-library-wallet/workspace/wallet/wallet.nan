//! Payments from a balance through holds.

pub closed struct Balance {
    pub cents: u64
} Balance

/// Funds set aside from a balance until they are settled or released.
pub closed linear struct Hold {
    pub cents: u64
} Hold

pub closed enum WalletError derives Eq, Render {
    Insufficient(needed: u64)
} WalletError

/// Sets `cents` aside from the balance.
pub fn Balance.reserve(mut self, cents: u64) -> Hold fails WalletError {
    if cents > self.cents {
        fail WalletError.Insufficient(needed: cents - self.cents)
    }
    self.cents -= cents
    return Hold(cents: cents)
} Balance.reserve

/// Returns a hold's funds to the balance.
pub fn Balance.release(mut self, take hold: Hold) {
    let Hold(cents: freed) = hold
    self.cents = self.cents.saturating_add(freed)
} Balance.release

/// Pays the hold out, giving the cents paid.
pub fn Hold.settle(take self) -> u64 {
    let Hold(cents: paid) = self
    return paid
} Hold.settle

/// Pays `price` from the balance and gives what remains.
pub fn pay(mut balance: Balance, price: u64) -> u64 fails WalletError {
    let hold = try mut balance.reserve(price)
    discard take hold.settle()
    return balance.cents
} pay

/// The share of the first of `parts` payees, who also takes what does not divide evenly.
pub fn first_share(cents: u64, parts: u64) -> u64 {
    return cents / parts + cents % parts
} first_share
