pub fn Cx.send_to[Q: Protocol](mut self, port: Port[Q], call: Encoded) fails RunnerError {
    try port.runner.send_to(port.id, hash: Wire[Q].hash(), bytes: call.bytes.view(), handles: call.handles.view())
} Cx.send_to

pub fn Cx.postpone(mut self) -> Option[u64]

pub fn Cx.reply(mut self, request: u64, reply: Encoded) fails RunnerError {
    try self.runner().reply(request, bytes: reply.bytes.view(), handles: reply.handles.view())
} Cx.reply

pub fn Cx.publish(mut self, summary: Slice[u8]) fails RunnerError {
    try self.runner().publish(summary)
} Cx.publish

pub fn Cx.sync(mut self) fails RunnerError {
    try self.runner().sync()
} Cx.sync

pub fn Cx.capability[C: Capability and Copy](mut self, id: CapabilityId[C]) -> C fails RunnerError {
    let handle = try self.runner().capability(id.id)
    let Some(capability) = id.of_handle(handle) else {
        fail RunnerError.Unknown
    }
    return capability
} Cx.capability

pub fn Cx.drop_capability[C: Capability and Copy](mut self, id: CapabilityId[C]) fails RunnerError {
    try self.runner().drop_capability(id.id)
} Cx.drop_capability

/// The runner capability attached to the stepper whose component context this is, a stale one
/// when none is.
fn Cx.runner(self) -> Runner

pub closed struct CapabilityId[C: Capability and Copy] derives Copy, Eq, Encode {
