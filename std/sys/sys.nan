} delivered_messages_are_handled_at_once

test steps_take_the_intake_oldest_first for Stepper.step {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    mut stepper.deliver(ProbeMessage.Echo)
    mut stepper.deliver(ProbeMessage.Echo)
    let earliest = mut stepper.step()
    let latest = mut stepper.step()
    let none = mut stepper.step()
    let last = try await take stepper.end()
    expect earliest and latest and not none
    expect last.state.handled == 2
} steps_take_the_intake_oldest_first

test incoming_waits_for_a_delayed_message for Stepper.incoming {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    defer take stepper.abandon()
    mut stepper.deliver(ProbeMessage.Delay)
    let early = mut stepper.step()
    try await stepper.incoming()
    let handled = mut stepper.step()
    undefer stepper
    let last = try await take stepper.end()
    expect not early and handled
    expect last.state.handled == 1
} incoming_waits_for_a_delayed_message

test pending_delays_keep_a_stepper_busy for Stepper.idle {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    defer take stepper.abandon()
    mut stepper.deliver(ProbeMessage.Delay)
    let busy = not stepper.idle()
    try await stepper.incoming()
    discard mut stepper.step()
    let idle = stepper.idle()
    undefer stepper
    discard try await take stepper.end()
    expect busy and idle
} pending_delays_keep_a_stepper_busy

test state_shows_what_the_handlers_did for Stepper.state {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    mut stepper.deliver(ProbeMessage.Count)
    let handled = stepper.state().handled
    discard try await take stepper.end()
    expect handled == 1
} state_shows_what_the_handlers_did

test posts_reach_the_stepper_through_its_outbox for Stepper.outbox {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    defer take stepper.abandon()
    let inbox = stepper.outbox()
    try await task::scope(world.exec, body: fn[mut stepper](s: task::Scope) fails task::Cancelled uses wait {
        discard s.spawn(fn[take inbox]() fails task::Cancelled uses wait {
            discard attempt await inbox.post(ProbeMessage.Count)
        })
        try await stepper.incoming()
        discard mut stepper.step()
    })
    undefer stepper
    let last = try await take stepper.end()
    expect last.state.handled == 1
} posts_reach_the_stepper_through_its_outbox

test abandoned_stepper_refuses_posts for Stepper.abandon {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    let inbox = stepper.outbox()
    take stepper.abandon()
    let outcome = attempt await inbox.post(ProbeMessage.Count)
    expect outcome.is_err()
} abandoned_stepper_refuses_posts
