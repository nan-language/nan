pub fn i16.overflowing_add(self, other: i16) -> Overflowing[i16] limits pure, notrap, terminates
    example (-1i16).overflowing_add(1) == Overflowing(value: 0, overflowed: false)
{
    let value = self.wrapping_add(other)
    let overflowed = (self >= 0) == (other >= 0) and (value >= 0) != (self >= 0)
    return Overflowing(value: value, overflowed: overflowed)
} i16.overflowing_add

pub fn i16.checked_add(self, other: i16) -> Option[i16] limits pure, notrap, terminates
    example (-1i16).checked_add(1) == Some(0)
{
    let sum = self.overflowing_add(other)
    if sum.overflowed {
        return None
    }
    return Some(sum.value)
} i16.checked_add

pub fn i16.saturating_add(self, other: i16) -> i16 limits pure, notrap, terminates
    example (-1i16).saturating_add(-1) == -2
{
    let sum = self.overflowing_add(other)
    if not sum.overflowed {
        return sum.value
    }
    if other > 0 {
        return 32_767
    }
    return -32_768
} i16.saturating_add

pub fn i16.overflowing_sub(self, other: i16) -> Overflowing[i16] limits pure, notrap, terminates
    example 0i16.overflowing_sub(1) == Overflowing(value: -1, overflowed: false)
{
    let value = self.wrapping_sub(other)
    let overflowed = (self >= 0) != (other >= 0) and (value >= 0) != (self >= 0)
    return Overflowing(value: value, overflowed: overflowed)
