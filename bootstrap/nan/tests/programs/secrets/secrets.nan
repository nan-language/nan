//! Each line shows a value computed on Secret values, revealed.

/// Swaps `a` and `b` when the low bit of `bit` is set, without a branch.
fn ladder_step(bit: core::Secret[u64], mut a: core::Secret[u64], mut b: core::Secret[u64]) {
    let swap = bit.bit_and(core::Secret.of(1)).eq(core::Secret.of(1))
    let mask = swap.select(core::Secret.of(~0u64), if_false: core::Secret.of(0))
    let flip = a.bit_xor(b).bit_and(mask)
    a = a.bit_xor(flip)
    b = b.bit_xor(flip)
} ladder_step

fn main(take world: host::World) fails task::Cancelled uses wait {
    var a = core::Secret.of(3u64)
    var b = core::Secret.of(9u64)
    ladder_step(core::Secret.of(5), mut a, mut b)
    world.log.info("swapped", value: a.reveal())
    let word = core::Secret.of(0x8000_0001u32)
    world.log.info("rotated", value: word.rotate_left(1).bit_or(word.rotate_right(31)).reveal())
    world.log.info("shifted", value: core::Secret.of(-8i16).shr(2).wrapping_sub(core::Secret.of(1i16).shl(3)).reveal())
    let all_ones = core::Secret.of(~0u64)
    world.log.info("high", value: all_ones.mul_high(core::Secret.of(3)).reveal())
    world.log.info("signed high", value: core::Secret.of(-3i64).mul_high(core::Secret.of(5)).reveal())
    world.log.info("low", value: all_ones.wrapping_mul(core::Secret.of(3)).bit_not().reveal())
    world.log.info("narrowed", value: core::Secret[i8].truncate(core::Secret.of(0x1FFu64)).reveal())
    world.log.info("widened", value: core::Secret[i64].widen(core::Secret.of(-2i8)).reveal())
    world.log.info("ordered", value: core::Secret.of(-1i32).lt(core::Secret.of(1)).bit_and(core::Secret.of(~0u32).gt(core::Secret.of(1))).reveal())
    world.log.info("bounds", value: core::Secret.of(7u8).le(core::Secret.of(7)).bit_xor(core::Secret.of(7u8).ge(core::Secret.of(8))).reveal())
    world.log.info("negated", value: core::Secret.of(true).bit_not().ne(core::Secret.of(false)).reveal())
    var tag = Array[core::Secret[u8], 4].filled(core::Secret.of(1))
    let expected = Array[core::Secret[u8], 4].filled(core::Secret.of(2))
    world.log.info("tags match", value: core::Secret.equal(tag.view(), b: expected.view()).reveal())
    core::Secret.copy_if(mut tag.view_mut(), source: expected.view(), choice: core::Secret.of(true))
    world.log.info("tags copied", value: core::Secret.equal(tag.view(), b: expected.view()).reveal())
} main
