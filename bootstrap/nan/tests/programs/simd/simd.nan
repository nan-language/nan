//! Lane operations of every lane type, logged as hashes of their results, which every codegen level computes alike.

/// A sequence of 16 words from a seed, by a linear congruential generator.
fn words(seed: u64) -> Array[u64, 16] {
    var state = seed
    var found = Array[u64, 16].filled(0)
    for index in 0..<16usize {
        state = state.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407)
        found[index] = state ^ (state >> 29)
    }
    return found
} words

/// The FNV-1a hash of 16 bytes.
fn hashed(bytes: core::simd::U8x16) -> u64 {
    var hash = 0xCBF2_9CE4_8422_2325u64
    for index in 0..<16usize {
        hash = (hash ^ u64.widen(bytes.lane(index))).wrapping_mul(0x100_0000_01B3)
    }
    return hash
} hashed

/// The bits of a mask's `bitmask`, `any` and `all`, packed in one word.
fn summary(bitmask: u16, any: bool, all: bool) -> u64 {
    var bits = u64.widen(bitmask)
    if any {
        bits = bits | 0x1_0000
    }
    if all {
        bits = bits | 0x2_0000
    }
    return bits
} summary

/// Lanes of `u8` from a seed, the first two the type's extremes when `extremes` holds.
fn lanes_u8(seed: u64, extremes: bool) -> core::simd::U8x16 {
    let source = words(seed)
    var lanes = Array[u8, 16].filled(0)
    for index in 0..<16usize {
        lanes[index] = u8.truncate(source[index])
    }
    if extremes {
        lanes[0] = ~0
        lanes[1] = 0
    }
    return core::simd::U8x16.of(lanes)
} lanes_u8

fn bytes_u8(lanes: core::simd::U8x16) -> core::simd::U8x16 {
    return lanes
} bytes_u8

fn mask_u8(mask: core::simd::Mask8x16) -> u64 {
    return summary(mask.bitmask(), any: mask.any(), all: mask.all())
} mask_u8

/// Lanes of `i8` from a seed, the first two the type's extremes when `extremes` holds.
fn lanes_i8(seed: u64, extremes: bool) -> core::simd::I8x16 {
    let source = words(seed)
    var lanes = Array[i8, 16].filled(0)
    for index in 0..<16usize {
        lanes[index] = i8.truncate(source[index])
    }
    if extremes {
        lanes[0] = 127
        lanes[1] = -128
    }
    return core::simd::I8x16.of(lanes)
} lanes_i8

fn bytes_i8(lanes: core::simd::I8x16) -> core::simd::U8x16 {
    return lanes.to_bytes()
} bytes_i8

fn mask_i8(mask: core::simd::Mask8x16) -> u64 {
    return summary(mask.bitmask(), any: mask.any(), all: mask.all())
} mask_i8

