//! Words posted to a signal and taken from it, and doorbells installed on one vector.

/// The vector both doorbells interrupt on.
const DOORBELL_VECTOR: u8 = 0x40

/// A doorbell device and the times it rang.
pub closed struct Doorbell {
    pub rings: u32
} Doorbell

/// Posts each of `words` to the signal, in order.
pub fn post_all(signal: hw::Signal[u32], words: Slice[u32]) {
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap {
        for word in words {
            signal.post(t, value: word)
        }
    })
} post_all

/// The next word the signal gives.
pub fn next_word(signal: hw::Signal[u32]) -> u32 fails task::Cancelled uses wait {
    return try await signal.wait()
} next_word

interrupt fn Doorbell.on_ring(mut self, take irq: hw::IrqContext) -> hw::IrqExit limits stack 512 {
    self.rings = self.rings.wrapping_add(1)
    take irq.complete()
    return hw::IrqExit.Resume
} Doorbell.on_ring

/// Installs both doorbells on the doorbell vector, then uninstalls them, giving their rings.
pub fn attach_both(take left: Doorbell, take right: Doorbell) -> u32 {
    let left_shared = hw::IrqShared.install(take left, vector: DOORBELL_VECTOR, on_irq: Doorbell.on_ring)
    let right_shared = hw::IrqShared.install(take right, vector: DOORBELL_VECTOR, on_irq: Doorbell.on_ring)
    let left_back = take left_shared.uninstall()
    let right_back = take right_shared.uninstall()
    return left_back.rings.wrapping_add(right_back.rings)
} attach_both
