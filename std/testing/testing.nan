//! The simulated world and structural comparison.

pub fn world() -> host::World
    example mem::Bytes.zeroed(3, alloc: world().alloc).len() == 3

pub fn same[T: Any](actual: T, expected: T) -> bool limits pure, notrap, terminates
    example same(Some(3u8), expected: Some(3))
    example not same(b"ab", expected: b"ac")
