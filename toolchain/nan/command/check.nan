//! The commands that check a scope and rewrite its files whole: `nan check`, `nan fix` and `nan fmt`.

/// Runs `nan check`, `nan fix` or `nan fmt` in a session's workspace.
fn check_run(invocation: Invocation, session: check::Session, current: Str, mut trace: Trace, alloc: mem::Alloc) -> output::Output fails platform::IoError {
    match invocation.value("--prefix") {
        Some(prefix) => return prefixed(invocation, session, current, written: prefix, alloc)
        None => {}
    }
    let Some(resolved) = scope::Scope.resolve(session.workspace.contents(), current, written: invocation.scope(), alloc) else {
        return invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: invocation.scope_written(), alloc)
    }
    trace.scope = Some(text::String.of(resolved.written.as_str(), alloc))
    let Some(agent) = invocation.agent_name() else {
        return invocation.tool_error(diagnostic::Code.ToolUsage, scope: resolved.written.as_str(), alloc)
    }
    let rewrite = rewritten(invocation, session, current, scope: resolved.scope, alloc)
    let checked = rewrite.checked.share()
    let held = checked.workspace.contents()
    try journal::write(held.root.as_str(), files: rewrite.files.view(), alloc)
    var diagnostics = checked.reported(resolved.scope)
    fix::offer(checked, current, written: invocation.scope(), diagnostics: mut diagnostics)
    let std = checked.std.contents()
    var errors: usize = 0
    var incomplete: usize = 0
    var failed = mem::List[diagnostic::At].empty(alloc)
    var records = mem::List[output::Record].empty(alloc)
    for index in 0..<diagnostics.len() {
        invariant errors <= index and incomplete <= index
        let reported = diagnostics[index]
        let class = reported.code.class()
        if class == diagnostic::Class.Error {
            errors += 1
            match reported.path {
                Some(path) => {
                    match reported.line {
                        Some(line) => {
                            mut failed.push(diagnostic::At(path: text::String.of(path.as_str(), alloc), line: line))
                        }
                        None => {}
                    }
                }
                None => {}
            }
        } else if class == diagnostic::Class.Incompleteness {
            incomplete += 1
        }
        mut records.push(record(held, std, scope: resolved.scope, reported, alloc))
    }
    if invocation.name == Name.Check {
        let green = try last_green(checked, scope: resolved.scope, agent, errors: failed.view(), alloc)
        for changed in take green {
            mut records.push(take changed)
        }
    }
    if invocation.flag("--radius") {
        let measured = radii(checked, scope: resolved.scope, alloc)
        for radius in take measured {
            mut records.push(take radius)
        }
    }
    for written in rewrite.files {
        var fields = mem::List[text::String].empty(alloc)
        mut fields.push(text::String.of(written.path.as_str(), alloc))
        mut records.push(output::Record(word: text::String.of("wrote", alloc), fields: take fields, lines: mem::List[text::String].empty(alloc)))
    }
    var verdict = output::Verdict.Ok
    if errors > 0 {
        verdict = output::Verdict.Failed
    }
    let summary = counted(invocation.name.counts(), files: rewrite.files.len(), errors, incomplete, alloc)
    return output::Output(command: invocation.command(resolved.written.as_str(), skip: true, alloc), elision: invocation.command(resolved.written.as_str(), skip: false, alloc), verdict: verdict, summary: take summary, records: take records)
} check_run

/// The scope operand, `.` when omitted.
proj fn Invocation.scope_written(self) -> Str {
    let Some(written) = self.scope() else {
        return "."
    }
    return written
} Invocation.scope_written

/// What `nan fix` and `nan fmt` write: the files, in path order, and the session of the workspace
/// checked after, the fixed one for `nan fix`.
struct Rewrite {
    files: mem::List[journal::FileWrite]
    checked: check::Session
} Rewrite

/// The files `nan fix` or `nan fmt` writes over a scope, and the session `nan fix` leaves.
fn rewritten(invocation: Invocation, session: check::Session, current: Str, scope: scope::Scope, alloc: mem::Alloc) -> Rewrite {
    var wrote = mem::Map[text::String, mem::Bytes].empty(alloc)
    var checked = session.share()
    if invocation.name == Name.Fix {
        match check_fixed(invocation, session, current, alloc) {
            Some(after) => {
                wrote = changed_files(session.workspace.contents(), fixed: after.workspace.contents(), alloc)
                checked = after.share()
            }
            None => {}
        }
    }
    if invocation.name == Name.Fmt {
        wrote = format::reformatted(session.workspace.contents(), scope, alloc)
    }
    var files = mem::List[journal::FileWrite].empty(alloc)
    for changed in wrote {
        var content = mem::Bytes.empty(alloc)
        mut content.append(changed.value().view())
        mut files.push(journal::FileWrite(path: text::String.of(changed.key().as_str(), alloc), content: take content))
    }
    return Rewrite(files: take files, checked: take checked)
} rewritten

/// A summary of the counts named by `counts`: files, errors and, for every other name,
/// incompleteness.
fn counted(counts: Str, files: usize, errors: usize, incomplete: usize, alloc: mem::Alloc) -> mem::List[output::Count] {
    var summary = mem::List[output::Count].empty(alloc)
    for name in take split_spaces(counts, alloc) {
        var value = incomplete
        if name.as_str() == "files" {
            value = files
        } else if name.as_str() == "errors" {
            value = errors
        }
        mut summary.push(output::Count(name: take name, value: value))
    }
    return summary
} counted

/// Whether `nan fix --propagate` keeps applying the fixes of diagnostics of a code.
fn is_propagated(code: diagnostic::Code) -> bool {
    return match code {
        diagnostic::Code.ItemWaitMissing or diagnostic::Code.ItemFailsMissing or diagnostic::Code.ErrorCancelUnmapped => true
        diagnostic::Code.ErrorUnconvertible or diagnostic::Code.EffectAwaitMissing or diagnostic::Code.ErrorUnhandled => true
        else => false
    }
} is_propagated

/// The session of the workspace once `nan fix` has made its fixes, none when it makes none: one
/// pass applying the fix of each diagnostic offering exactly one, then with `--propagate`, passes
/// applying those of the propagated codes until one applies none.
fn check_fixed(invocation: Invocation, session: check::Session, current: Str, alloc: mem::Alloc) -> Option[check::Session] {
    let written = invocation.scope()
    let Some(once) = pass(session, current, written, keep: fn(reported: diagnostic::Diagnostic, fix: diagnostic::Fix) => true, alloc) else {
        return propagated(invocation, base: session, current, alloc)
    }
    let Some(further) = propagated(invocation, base: once, current, alloc) else {
        return Some(take once)
    }
    return Some(take further)
} check_fixed

/// The session of the workspace once `nan fix --propagate` has made the fixes of the propagated
/// codes over `base`, pass after pass until one applies none; none when it makes none or without
/// `--propagate`.
fn propagated(invocation: Invocation, base: check::Session, current: Str, alloc: mem::Alloc) -> Option[check::Session] {
    if not invocation.flag("--propagate") {
        return None
    }
    let written = invocation.scope()
    var fixed = base.share()
    var made = false
    loop {
        let held = fixed.workspace.contents()
        let Some(next) = pass(fixed, current, written, keep: fn(reported: diagnostic::Diagnostic, fix: diagnostic::Fix) => is_propagated(reported.code) and not edits_interface(held, fix, alloc), alloc) else {
            break
        }
        fixed = next
        made = true
    }
    if not made {
        return None
    }
    return Some(take fixed)
} propagated

/// One pass of `nan fix`: the session of the workspace once the fixes `keep` accepts are made,
/// among the one fix of each diagnostic offering exactly one, in path and line order, a fix
/// sharing a line with an earlier one skipped; none when it makes none.
fn pass(session: check::Session, current: Str, written: Option[Str], keep: fn(reported: diagnostic::Diagnostic, fix: diagnostic::Fix) -> bool, alloc: mem::Alloc) -> Option[check::Session] {
    let held = session.workspace.contents()
    let Some(resolved) = scope::Scope.resolve(held, current, written, alloc) else {
        return None
    }
    var diagnostics = session.reported(resolved.scope)
    fix::offer(session, current, written, diagnostics: mut diagnostics)
    var taken = mem::List[diagnostic::At].empty(alloc)
    var chosen = mem::List[diagnostic::Fix].empty(alloc)
    for reported in diagnostics {
        if reported.fixes.len() != 1 {
            continue
        }
        let fix = reported.fixes[0]
        if not keep(reported, fix) {
            continue
        }
        let lines = fix::held_lines(held, fix, alloc)
        if lines.position(fn(line: diagnostic::At) => is_taken(taken.view(), line)).is_some() {
            continue
        }
        for line in take lines {
            mut taken.push(take line)
        }
        mut chosen.push(fix::copied_fix(fix, alloc))
    }
    if chosen.len() == 0 {
        return None
    }
    let fixed = held.overlaid(fix::apply(held, fixes: chosen.view(), alloc), grammar: session.grammar.contents(), alloc)
    return Some(check::Session.of(mem::Shared.of(take fixed, alloc: alloc), std: session.std.share(), grammar: session.grammar.share(), home: cache::copied_override(session.home, alloc), alloc))
} pass

/// Whether a line of a file is among those taken.
fn is_taken(taken: Slice[diagnostic::At], line: diagnostic::At) -> bool {
    for held in taken {
        if held.line == line.line and held.path.as_str() == line.path.as_str() {
            return true
        }
    }
    return false
} is_taken

/// Whether a fix edits the head of a `pkg` or `pub` function or a `pkg` or `pub` enum.
fn edits_interface(workspace: workspace::Workspace, fix: diagnostic::Fix, alloc: mem::Alloc) -> bool {
    for edit in fix.edits {
        let Some(at) = workspace.file(edit.path.as_str()) else {
            continue
        }
        let file = workspace.file_at(at).syntax
        let replacement = edit.replacement
        let Some(item) = file.items.position(fn(candidate: syntax::ItemSyntax) => holds_replacement(file, item: candidate, replacement)) else {
            continue
        }
        let Some(tree) = file.items[item].tree else {
            continue
        }
        if tree.visibility().is_none() {
            continue
        }
        let Some(kind) = tree.kind() else {
            continue
        }
        if kind.rule == syntax::Rule.EnumItem {
            return true
        }
        if kind.rule != syntax::Rule.FnItem {
            continue
        }
        let Some(end) = tree.head_end(alloc) else {
            return true
        }
        expect usize.widen(end) < file.tokens.len()
        if replacement.start <= file.tokens[usize.widen(end)].end {
            return true
        }
    }
    return false
} edits_interface

/// Whether a replacement lies within an item's tokens.
fn holds_replacement(file: syntax::SourceFile, item: syntax::ItemSyntax, replacement: diagnostic::Replacement) -> bool {
    expect item.head < file.tokens.len() and item.end > 0 and item.end <= file.tokens.len()
    return file.tokens[item.head].start <= replacement.start and replacement.end <= file.tokens[item.end - 1].end
} holds_replacement

/// The files whose sources differ between a workspace and the same workspace fixed, with their
/// new sources.
fn changed_files(workspace: workspace::Workspace, fixed: workspace::Workspace, alloc: mem::Alloc) -> mem::Map[text::String, mem::Bytes] {
    var changed = mem::Map[text::String, mem::Bytes].empty(alloc)
    for at in fixed.files() {
        let file = fixed.file_at(at)
        let Some(old) = workspace.file(file.path.as_str()) else {
            continue
        }
        if workspace.file_at(old).syntax.source.view() == file.syntax.source.view() {
            continue
        }
        var source = mem::Bytes.empty(alloc)
        mut source.append(file.syntax.source.view())
        discard mut changed.insert(text::String.of(file.path.as_str(), alloc), value: take source)
    }
    return changed
} changed_files

/// The agent `--agent` names, `default` without one; none for a name that is not one.
proj fn Invocation.agent_name(self) -> Option[Str] {
    let agent = match self.value("--agent") {
        Some(named) => named
        None => "default"
    }
    if agent.is_empty() {
        return None
    }
    for byte in agent.as_bytes() {
        let letter = (byte >= b'a' and byte <= b'z') or (byte >= b'A' and byte <= b'Z')
        if not letter and not (byte >= b'0' and byte <= b'9') and byte != b'_' and byte != b'-' {
            return None
        }
    }
    return Some(take agent)
} Invocation.agent_name

/// An entry of a last-green record: an item's location, interface hash and api lines.
struct GreenEntry {
    location: text::String
    hash: text::String
    api: mem::List[text::String]
} GreenEntry

/// The entries of an agent's last-green record, by item.
fn green_entries(root: Str, agent: Str, alloc: mem::Alloc) -> mem::Map[text::String, GreenEntry] {
    var entries = mem::Map[text::String, GreenEntry].empty(alloc)
    var relative = text::String.of(".nan/green/", alloc)
    mut relative.append(agent)
    let Ok(written) = attempt platform::read_text(platform::join(root, name: relative.as_str(), alloc).as_str(), alloc) else {
        return entries
    }
    var current = text::String.empty(alloc)
    var open = false
    for line in take text_lines(written.as_str(), alloc) {
        if open and line.starts_with("    ") {
            let Some(api) = line.as_str().slice_bytes(4, end: line.byte_len()) else {
                continue
            }
            var target = mut entries.at_mut(current)
            mut target.api.push(text::String.of(api, alloc))
            continue
        }
        open = false
        if not line.starts_with("item ") {
            continue
        }
        let Some(rest) = line.as_str().slice_bytes(5, end: line.byte_len()) else {
            continue
        }
        let fields = split_spaces(rest, alloc)
        if fields.len() < 3 {
            continue
        }
        current = text::String.of(fields[0].as_str(), alloc)
        let held = GreenEntry(location: text::String.of(fields[1].as_str(), alloc), hash: text::String.of(fields[2].as_str(), alloc), api: mem::List[text::String].empty(alloc))
        discard mut entries.insert(text::String.of(current.as_str(), alloc), value: take held)
        open = true
    }
    return entries
} green_entries

/// The lines of a text: split at each line feed, a carriage return ending one dropped, without a
/// last empty line after a final line feed.
fn text_lines(written: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var lines = mem::List[text::String].empty(alloc)
    let bytes = written.as_bytes()
    var start: usize = 0
    while start < bytes.len() {
        var end = bytes.len()
        var next = bytes.len()
        for at in start..<bytes.len() {
            if bytes[at] == b'\n' {
                end = at
                next = at + 1
                break
            }
        }
        if end > start and bytes[end - 1] == b'\r' {
            end -= 1
        }
        let Some(line) = written.slice_bytes(start, end) else {
            return lines
        }
        mut lines.push(text::String.of(line, alloc))
        start = next
    }
    return lines
} text_lines

/// The parts of a text between its spaces, each space separating two.
fn split_spaces(written: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var parts = mem::List[text::String].empty(alloc)
    let bytes = written.as_bytes()
    var start: usize = 0
    for at in 0..<bytes.len() {
        if bytes[at] != b' ' {
            continue
        }
        let Some(part) = written.slice_bytes(start, end: at) else {
            return parts
        }
        mut parts.push(text::String.of(part, alloc))
        start = at + 1
    }
    let Some(last) = written.slice_bytes(start, end: bytes.len()) else {
        return parts
    }
    mut parts.push(text::String.of(last, alloc))
    return parts
} split_spaces

fn green_interface(green: check::Green, alloc: mem::Alloc) -> text::String {
    let Some(hash) = green.interface_hash else {
        return text::String.of("-", alloc)
    }
    return hash.full(alloc)
} green_interface

/// A `changed` record per item whose interface hash differs from its last-green entry, merging
/// its entry's api lines with its current ones; an item without an entry has none.
fn changed_since(entries: mem::Map[text::String, GreenEntry], greens: Slice[check::Green], writer: Option[text::String], alloc: mem::Alloc) -> mem::List[output::Record] {
    var records = mem::List[output::Record].empty(alloc)
    for green in greens {
        let Some(known) = entries.get(green.path) else {
            continue
        }
        if known.hash.as_str() == green_interface(green, alloc).as_str() {
            continue
        }
        var fields = mem::List[text::String].empty(alloc)
        mut fields.push(written_for(green.path.as_str(), writer, alloc))
        mut fields.push(located(green.file.as_str(), line: green.line, alloc))
        mut records.push(output::Record(word: text::String.of("changed", alloc), fields: take fields, lines: diff::merged(known.api.view(), new: green.api.view(), alloc)))
    }
    return records
} changed_since

/// Keeps an agent's last-green record: after a check reporting no error, replaces the entries of
/// the items of its scope; after one reporting errors, returns a `changed` record per item of the
/// closure sets of the lines holding one whose interface hash differs from its entry.
fn last_green(session: check::Session, scope: scope::Scope, agent: Str, errors: Slice[diagnostic::At], alloc: mem::Alloc) -> mem::List[output::Record] fails platform::IoError {
    let held = session.workspace.contents()
    var entries = green_entries(held.root.as_str(), agent, alloc)
    if errors.len() > 0 {
        let greens = session.greens(None, lines: errors)
        return changed_since(entries, greens: greens.view(), writer: writer_of(held, scope, alloc), alloc)
    }
    mut entries.retain(fn(key: text::String, value: GreenEntry) => not located_in(scope, workspace: held, location: value.location.as_str()))
    let greens = session.greens(Some(scope.copied(alloc)), lines: mem::List[diagnostic::At].empty(alloc).view())
    for green in greens {
        var api = mem::List[text::String].empty(alloc)
        for line in green.api {
            mut api.push(text::String.of(line.as_str(), alloc))
        }
        let held_entry = GreenEntry(location: located(green.file.as_str(), line: green.line, alloc), hash: green_interface(green, alloc), api: take api)
        discard mut entries.insert(text::String.of(green.path.as_str(), alloc), value: take held_entry)
    }
    var written = text::String.empty(alloc)
    for item in entries {
        let kept = item.value()
        mut written.append("item ")
        mut written.append(item.key().as_str())
        mut written.push(' ')
        mut written.append(kept.location.as_str())
        mut written.push(' ')
        mut written.append(kept.hash.as_str())
        mut written.push('\n')
        for line in kept.api {
            mut written.append("    ")
            mut written.append(line.as_str())
            mut written.push('\n')
        }
    }
    var path = text::String.of(".nan/green/", alloc)
    mut path.append(agent)
    try journal::replace_alone(held.root.as_str(), path: path.as_str(), content: written.as_bytes(), alloc)
    return mem::List[output::Record].empty(alloc)
} last_green

/// Whether a scope holds the location `<file>:<line>` of a last-green entry.
fn located_in(scope: scope::Scope, workspace: workspace::Workspace, location: Str) -> bool {
    let Some(at) = last_colon(location) else {
        return scope.holds(workspace, path: "", line: None)
    }
    let Some(file) = location.slice_bytes(0, end: at) else {
        return false
    }
    let Some(line) = location.slice_bytes(at + 1, end: location.byte_len()) else {
        return false
    }
    return scope.holds(workspace, path: file, line: line_number(line))
} located_in

/// The position of the last `:` of a text.
fn last_colon(written: Str) -> Option[usize]
    ensures match result {
        Some(at) => at < written.as_bytes().len()
        None => true
    }
{
    let bytes = written.as_bytes()
    for step in 0..<bytes.len() {
        let at = bytes.len() - 1 - step
        if bytes[at] == b':' {
            return Some(at)
        }
    }
    return None
} last_colon

/// An item's closure radius as a `radius` record writes it.
struct Radius {
    radius: usize
    item: text::String
} Radius

/// A `radius` record per item of the scope with its closure radius, largest first, then by
/// path.
fn radii(session: check::Session, scope: scope::Scope, alloc: mem::Alloc) -> mem::List[output::Record] {
    let held = session.workspace.contents()
    let writer = writer_of(held, scope, alloc)
    var measured = mem::List[Radius].empty(alloc)
    let packs = session.contexts(scope, line: None)
    for pack in packs {
        let radius = output::units_of(pack_records(held, pack, writer, alloc).view(), alloc)
        mut measured.push(Radius(radius: radius, item: written_for(pack.path.as_str(), writer, alloc)))
    }
    mut measured.sort_by(fn(left: Radius, right: Radius) => radius_order(left, right))
    var records = mem::List[output::Record].empty(alloc)
    for each in measured {
        var fields = mem::List[text::String].empty(alloc)
        mut fields.push(text::String.of(each.item.as_str(), alloc))
        var written = text::String.empty(alloc)
        mut written.write(text::fmt("{radius}", radius: each.radius), budget: 100)
        mut fields.push(take written)
        mut records.push(output::Record(word: text::String.of("radius", alloc), fields: take fields, lines: mem::List[text::String].empty(alloc)))
    }
    return records
} radii

fn radius_order(left: Radius, right: Radius) -> core::Ordering {
    if left.radius != right.radius {
        return right.radius.cmp(left.radius)
    }
    return left.item.as_str().cmp(right.item.as_str())
} radius_order

/// Whether prefix checking reports a diagnostic of this code with an exact fix as pending
/// clauses.
fn is_pending(code: diagnostic::Code) -> bool {
    return match code {
        diagnostic::Code.ItemFailsMissing or diagnostic::Code.ItemWaitMissing or diagnostic::Code.ErrorCancelUnmapped or diagnostic::Code.ErrorUnconvertible => true
        else => false
    }
} is_pending

/// Whether prefix checking leaves out a diagnostic of this code when its construct holds a token
/// closing appends.
fn is_open_construct(code: diagnostic::Code) -> bool {
    return match code {
        diagnostic::Code.ClosureCaptureMode or diagnostic::Code.ClosureCaptureUnused or diagnostic::Code.ExprArgumentCount or diagnostic::Code.ExprBranchForm or diagnostic::Code.ExprMissingElse or diagnostic::Code.ExprNonExhaustive => true
        diagnostic::Code.GenericParameterUnused or diagnostic::Code.ItemFailsUnneeded or diagnostic::Code.ItemWaitUnneeded or diagnostic::Code.OwnLinearDropped or diagnostic::Code.StmtElseNotDiverging or diagnostic::Code.StmtMissingReturn => true
        diagnostic::Code.StmtUnusedLabel or diagnostic::Code.TextHoleUnbound or diagnostic::Code.ThresholdUnusedWaiver or diagnostic::Code.TypeMissingField or diagnostic::Code.TypePayloadShape or diagnostic::Code.UnusedLocal => true
        else => false
    }
} is_open_construct

/// The session of a workspace whose file at `path` holds `contents`.
fn overlaid_session(session: check::Session, path: Str, contents: Slice[u8], alloc: mem::Alloc) -> check::Session {
    var changed = mem::Map[text::String, mem::Bytes].empty(alloc)
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(contents)
    discard mut changed.insert(text::String.of(path, alloc), value: take bytes)
    let overlaid = session.workspace.contents().overlaid(changed, grammar: session.grammar.contents(), alloc)
    return check::Session.of(mem::Shared.of(take overlaid, alloc: alloc), std: session.std.share(), grammar: session.grammar.share(), home: cache::copied_override(session.home, alloc), alloc)
} overlaid_session

/// `nan check --prefix`: the error at the prefix's first dead token, the diagnostics of the
/// prefix closed, its pending clauses, and the typed holes and closers closing appends.
fn prefixed(invocation: Invocation, session: check::Session, current: Str, written: Str, alloc: mem::Alloc) -> output::Output {
    let held = session.workspace.contents()
    var path_end = written.byte_len()
    var line: Option[u32] = None
    match last_colon(written) {
        Some(at) => {
            let Some(left) = written.slice_bytes(0, end: at) else {
                return invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: written, alloc)
            }
            if left.ends_with(".nan") {
                path_end = at
                let Some(right) = written.slice_bytes(at + 1, end: written.byte_len()) else {
                    return invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: written, alloc)
                }
                line = line_number(right)
            }
        }
        None => {}
    }
    let Some(path) = written.slice_bytes(0, end: path_end) else {
        return invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: written, alloc)
    }
    let Some(at) = held.file(path) else {
        return invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: written, alloc)
    }
    let file = held.file_at(at).syntax
    let source = file.source.view()
    var end = source.len()
    match line {
        Some(number) => {
            let index = usize.widen(number)
            if index < file.lines.len() {
                end = usize.widen(file.lines[index].start)
            } else if index > file.lines.len() {
                return invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: written, alloc)
            }
        }
        None => {}
    }
    let Some(parts) = source.split_at(end) else {
        return invocation.tool_error(diagnostic::Code.ToolUnknownScope, scope: written, alloc)
    }
    return closed_prefix(invocation, session, current, written, path, prefix: parts.head, alloc)
} prefixed

/// Prefix checking of the bytes `prefix` of the file at `path`, given as `written`.
fn closed_prefix(invocation: Invocation, session: check::Session, current: Str, written: Str, path: Str, prefix: Slice[u8], alloc: mem::Alloc) -> output::Output {
    let closed = syntax::close_prefix(prefix, grammar: session.grammar.contents(), alloc)
    let fixed_session = overlaid_session(session, path, contents: closed.source.view(), alloc)
    let fixed = fixed_session.workspace.contents()
    let std = session.std.contents()
    let scope = scope::Scope.File(text::String.of(path, alloc))
    let scoped = text::String.of(path, alloc)
    var diagnostics = fixed_session.reported(scope)
    fix::offer(fixed_session, current, written: Some(scoped.as_str()), diagnostics: mut diagnostics)
    var records = mem::List[output::Record].empty(alloc)
    var dead: usize = 0
    match closed.dead {
        Some(failing) => {
            let prefix_session = overlaid_session(session, path, contents: prefix, alloc)
            let unclosed = prefix_session.reported(scope)
            for reported in unclosed {
                if reported.failing == Some(failing) {
                    mut records.push(record(prefix_session.workspace.contents(), std, scope, reported, alloc))
                    dead = 1
                    break
                }
            }
        }
        None => {}
    }
    var pending = mem::List[output::Record].empty(alloc)
    for reported in diagnostics {
        if appended(closed, reported) {
            continue
        }
        if is_pending(reported.code) and reported.fixes.len() > 0 {
            for clause in take pending_clauses(fixed, scope, reported, alloc) {
                mut pending.push(take clause)
            }
            continue
        }
        mut records.push(record(fixed, std, scope, reported, alloc))
    }
    var failed = dead > 0
    for shown in records {
        if shown.word.as_str() == "error" {
            failed = true
        }
    }
    let pending_count = pending.len()
    for clause in take pending {
        mut records.push(take clause)
    }
    let hole_count = piece_records(mut records, fixed_session, closed, path, scope, alloc)
    var summary = mem::List[output::Count].empty(alloc)
    mut summary.push(output::Count(name: text::String.of("dead", alloc), value: dead))
    mut summary.push(output::Count(name: text::String.of("pending", alloc), value: pending_count))
    mut summary.push(output::Count(name: text::String.of("holes", alloc), value: hole_count))
    var verdict = output::Verdict.Ok
    if failed {
        verdict = output::Verdict.Failed
    }
    return output::Output(command: invocation.command(written, skip: true, alloc), elision: invocation.command(written, skip: false, alloc), verdict: verdict, summary: take summary, records: take records)
} closed_prefix

/// Adds a `hole` record per typed hole closing appends, with the type it expects, and a `close`
/// record per other piece. Returns the number of holes.
fn piece_records(mut records: mem::List[output::Record], fixed_session: check::Session, closed: syntax::Closed, path: Str, scope: scope::Scope, alloc: mem::Alloc) -> usize {
    let fixed = fixed_session.workspace.contents()
    let holes = fixed_session.holes()
    let writer = writer_of(fixed, scope, alloc)
    var hole_count: usize = 0
    for index in 0..<closed.pieces.len() {
        invariant hole_count <= index
        let piece = closed.pieces[index]
        if not piece.hole {
            mut records.push(output::Record(word: text::String.of("close", alloc), fields: split_spaces(piece.text.as_str(), alloc), lines: mem::List[text::String].empty(alloc)))
            continue
        }
        hole_count += 1
        var expected = text::String.of("-", alloc)
        for hole in holes {
            if hole.path.as_str() == path and hole.line == piece.line {
                expected = text::String.of(hole.expected.as_str(), alloc)
                break
            }
        }
        var fields = mem::List[text::String].empty(alloc)
        mut fields.push(located(path, line: piece.line, alloc))
        mut fields.push(item_written(fixed, writer, path, line: piece.line, known: None, alloc))
        mut fields.push(take expected)
        mut records.push(output::Record(word: text::String.of("hole", alloc), fields: take fields, lines: mem::List[text::String].empty(alloc)))
    }
    return hole_count
} piece_records

/// Whether a diagnostic of the closed prefix lies on a line closing appends to, or is of a code
/// left out when its construct holds an appended token.
fn appended(closed: syntax::Closed, reported: diagnostic::Diagnostic) -> bool {
    match reported.line {
        Some(line) => {
            for piece in closed.pieces {
                if piece.line == line {
                    return true
                }
            }
        }
        None => {}
    }
    if not is_open_construct(reported.code) {
        return false
    }
    var construct = reported.span
    if reported.judged.is_some() {
        construct = reported.judged
    }
    let Some(span) = construct else {
        return false
    }
    for piece in closed.pieces {
        if piece.span.start < span.end and piece.span.end > span.start {
            return true
        }
    }
    return false
} appended

/// The `pending` records of a diagnostic whose fix adds clauses: one per clause, at its line.
fn pending_clauses(workspace: workspace::Workspace, scope: scope::Scope, reported: diagnostic::Diagnostic, alloc: mem::Alloc) -> mem::List[output::Record] {
    var records = mem::List[output::Record].empty(alloc)
    let Some(path) = reported.path else {
        return records
    }
    let Some(line) = reported.line else {
        return records
    }
    let Some(fix) = reported.fixes.get(0) else {
        expect false
        return records
    }
    let writer = writer_of(workspace, scope, alloc)
    let item = item_written(workspace, writer, path: path.as_str(), line, known: None, alloc)
    var added = text::String.empty(alloc)
    for index in 0..<fix.edits.len() {
        if index > 0 {
            mut added.push(' ')
        }
        let replaced = fix.edits[index].replacement.text.as_str()
        let kept = platform::trimmed_run(replaced)
        let Some(trimmed) = replaced.slice_bytes(kept.start, end: kept.end) else {
            continue
        }
        mut added.append(trimmed)
    }
    var clauses = mem::List[text::String].empty(alloc)
    match added.as_str().find(" uses wait") {
        Some(at) => {
            if at > 0 {
                let Some(failure) = added.as_str().slice_bytes(0, end: at) else {
                    return records
                }
                mut clauses.push(text::String.of(failure, alloc))
                mut clauses.push(text::String.of("uses wait", alloc))
            }
        }
        None => {}
    }
    if clauses.len() == 0 {
        mut clauses.push(take added)
    }
    for clause in clauses {
        var fields = mem::List[text::String].empty(alloc)
        mut fields.push(located(path.as_str(), line, alloc))
        mut fields.push(text::String.of(item.as_str(), alloc))
        for word in take split_spaces(clause.as_str(), alloc) {
            mut fields.push(take word)
        }
        mut records.push(output::Record(word: text::String.of("pending", alloc), fields: take fields, lines: mem::List[text::String].empty(alloc)))
    }
    return records
} pending_clauses
