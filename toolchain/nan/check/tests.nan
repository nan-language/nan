//! Tests of the sets of items the checker's searches keep.

test item_marks_hold_the_items_inserted for ItemMarks.insert {
    var marks = ItemMarks.empty(testing::world().alloc)
    for index in 0..<1_000u32 {
        let added = mut marks.insert(ty::ItemId(index: index * 3))
        expect added
    }
    let again = mut marks.insert(ty::ItemId(index: 999))
    expect not again
    for index in 0..<3_000u32 {
        expect marks.contains(ty::ItemId(index: index)) == (index % 3 == 0)
    }
} item_marks_hold_the_items_inserted
