//! Conversions of the converter's eight channels.

pub layout Control: u32 le {
    start: bit 0
    channel: bit 1..=3
    reserved: rest
} Control

pub layout Status: u32 le {
    done: bit 0
    overrun: bit 1
    reserved: rest
} Status

pub layout Sample: u32 le {
    value: bit 0..=11
    channel: bit 12..=14
    reserved: rest
} Sample

pub registers AdcRegs {
    control: Control at 0x0 write
    status: Status at 0x4 write_one_clear
    data: Sample at 0x8 read
} AdcRegs

pub closed enum AdcError derives Eq, Render {
    NoChannel(u8)
    Timeout
    Overrun
    WrongChannel(u8)
} AdcError
