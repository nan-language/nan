//! A kernel's clock: its counter, on x86_64 the time-stamp counter, the HPET or the PM timer and on AArch64 the virtual counter, in nanoseconds since the runtime started and never below what any CPU read before; the timers of the clock, which each CPU's timer interrupt expires once due, its timer programmed for the earliest of the end of a timer's window, the end of its task's slice and its next pacing tick, which it has while it runs a task or the final build binds the timer's vector; and the wall clock source a machine root grant reads once. On x86_64 the counter is the time-stamp counter where it is invariant, at the rate CPUID leaf `0x15` reports, else measured over 10 ms of the HPET or else the PM timer the ACPI tables name, else over the 10 ms the legacy PIT's channel 2 counts down from `PIT_LATCH`; elsewhere it is that HPET or PM timer, its count extended to 64 bits from the latest any CPU read. Each CPU's timer runs in TSC-deadline mode where it has that mode and the clock is the time-stamp counter, and otherwise one-shot, its local APIC timer's rate measured against the clock as it starts taking interrupts. The wall clock source is the CMOS clock on `x86_64-bare`, the PL031 the machine's discovery finds on `aarch64-bare` and the firmware's `GetTime` on the UEFI targets, its time read as UTC.

/// The nanoseconds between a CPU's pacing ticks.
const PACING_PERIOD: u64 = 10_000_000

/// The longest a CPU's timer waits, in nanoseconds, and the most ticks it counts down, which
/// AArch64's signed timer value holds.
const LONGEST_DELAY: u64 = 1_000_000_000

const MOST_TICKS: u64 = 0x7FFF_FFFF

/// The PIT's input clock, the count its channel 2 counts down while the time-stamp counter is
/// measured, and the nanoseconds that count takes; its ports: channel 2's data port, the mode
/// port and the system control port, whose bit 0 gates channel 2, bit 1 enables the speaker and
/// bit 5 reads channel 2's output; and the mode selecting channel 2, both bytes of its count,
/// its interrupt on terminal count and a binary count.
const PIT_HZ: u64 = 1_193_182

const PIT_LATCH: u64 = 11_932

const PIT_WINDOW: u64 = PIT_LATCH * 1_000_000_000 / PIT_HZ

const PIT_CHANNEL_2: u64 = 0x42

const PIT_MODE: u64 = 0x43

const SYSTEM_CONTROL: u64 = 0x61

const CHANNEL_2_ONE_SHOT: u64 = 0xB0

const PIT_GATE: i64 = 0x01

const SPEAKER: i64 = 0x02

const CHANNEL_2_OUT: i64 = 0x20

/// The clock's sources on x86_64: the time-stamp counter, the HPET and the PM timer.
const TSC_SOURCE: i64 = 0

const HPET_SOURCE: i64 = 1

const PM_TIMER_SOURCE: i64 = 2

/// The CPUID leaves giving the highest extended leaf and, in bit 8 of EDX, an invariant
/// time-stamp counter; and those giving the highest basic leaf and the time-stamp counter's
/// ratio to the core crystal, as EBX over EAX, with the crystal's frequency in ECX.
const EXTENDED_LEAVES: u32 = 0x8000_0000

const POWER_LEAF: u32 = 0x8000_0007

const INVARIANT_TSC: i64 = 0x100

const BASIC_LEAVES: u32 = 0

const TSC_LEAF: u32 = 0x15

/// The nanoseconds of the HPET or PM timer the time-stamp counter's rate is measured over.
const TSC_WINDOW: u64 = 10_000_000

/// The signature of the ACPI table naming the HPET; the offset of the HPET's registers in it,
/// and those in the FADT of the PM timer's port and of the flags whose bit 8 marks a 32-bit PM
/// timer.
const HPET_SIGNATURE: i64 = 0x5445_5048

const HPET_ADDRESS: u64 = 44

const FADT_PM_TIMER: u64 = 76

const FADT_FLAGS: u64 = 112

const PM_TIMER_32: i64 = 0x100

/// The HPET's registers past its capabilities at its base, whose bits 32 to 63 give its period in
/// femtoseconds and bit 13 a 64-bit counter: its configuration, whose bit 0 starts the counter,
/// and the counter; and the femtoseconds of a nanosecond.
const HPET_CONFIGURATION: u64 = 0x10

const HPET_COUNTER: u64 = 0xF0

const HPET_WIDE: i64 = 0x2000

const HPET_ENABLE: i64 = 0x1

const FS_PER_NS: u64 = 1_000_000

/// The PM timer's rate.
const PM_TIMER_HZ: u64 = 3_579_545

/// The CMOS clock's index and data ports, its registers of seconds, minutes, hours, day of the
/// month, month and year, and its status registers A, whose bit 7 is set during an update, and
/// B, whose bit 1 selects 24-hour hours and bit 2 binary values over BCD; and the bit of a
/// 12-hour hour set after noon.
const CMOS_INDEX: u64 = 0x70

const CMOS_DATA: u64 = 0x71

const CMOS_FIELDS: Array[u64, 6] = cmos_registers()

const CMOS_STATUS_A: u64 = 0x0A

const CMOS_STATUS_B: u64 = 0x0B

const CMOS_UPDATING: i64 = 0x80

const CMOS_24_HOUR: i64 = 0x02

const CMOS_BINARY: i64 = 0x04

const CMOS_AFTERNOON: i64 = 0x80

/// The nanoseconds of a second.
const NS_PER_SECOND: u64 = 1_000_000_000

fn cmos_registers() -> Array[u64, 6] {
    var fields = Array[u64, 6].filled(0x00)
    fields[1] = 0x02
    fields[2] = 0x04
    fields[3] = 0x07
    fields[4] = 0x08
    fields[5] = 0x09
    return fields
} cmos_registers

/// What a wall clock source gave: whether it gave a time, and that time in nanoseconds since
/// the Unix epoch.
struct WallSource derives Copy {
    valid: clif::Value
    now: clif::Value
} WallSource

/// Starts the clock in `Init`: its counter now is its base, and on x86_64 its source is chosen.
fn Lowering.start_clock(mut self, mut fx: Fx) {
    let state_address = mut self.state(mut fx)
    var base = state_address
    var scale = state_address
    match self.machine_arch() {
        workspace::Arch.Amd64 => {
            let started = mut self.start_x64_clock(mut fx)
            expect started.len() > 1
            base = started[0]
            scale = started[1]
        }
        workspace::Arch.Aarch64 => {
            let frequency = mut self.read_sysreg(mut fx, register: CNTFRQ_EL0)
            let second = mut fx.ptr(NS_PER_SECOND << 32)
            scale = mut fx.b.udiv(second, y: frequency)
            base = mut self.read_sysreg(mut fx, register: CNTVCT_EL0)
        }
    }
    mut fx.store(base, addr: state_address, offset: STATE_CLOCK_BASE)
    mut fx.store(scale, addr: state_address, offset: STATE_CLOCK_SCALE)
} Lowering.start_clock

/// Chooses the x86_64 clock's source, recording it: the time-stamp counter where it is invariant,
/// otherwise the HPET, else the PM timer, else the time-stamp counter. Gives the source's count
/// now and its scale.
fn Lowering.start_x64_clock(mut self, mut fx: Fx) -> mem::List[clif::Value] {
    let words = mut fx.slot(16, align: 4)
    let highest = mut self.cpuid(mut fx, words, leaf: EXTENDED_LEAVES)
    discard mut self.cpuid(mut fx, words, leaf: POWER_LEAF)
    let edx = mut fx.load(clif::Type.Int32, addr: words, offset: 12)
    let held = mut fx.b.band_imm_s(edx, y: INVARIANT_TSC)
    let steady = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: held, y: 0)
    let leaves = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: highest, y: i64.widen(POWER_LEAF))
    let stable = mut fx.b.band(steady, y: leaves)
    let platform = mut self.counter_source(mut fx)
    expect platform.len() > 3
    let kind = platform[0]
    let counter = platform[1]
    let counter_scale = platform[3]
    let counted = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: kind, y: TSC_SOURCE)
    let uncounted = mut fx.b.bxor_imm_s(counted, y: 1)
    let tsc = mut fx.b.bor(stable, y: uncounted)
    let tsc_kind = mut fx.int(PTR, value: TSC_SOURCE)
    let source = mut fx.b.select(tsc, x: tsc_kind, y: kind)
    let state_address = mut self.state(mut fx)
    mut fx.store(source, addr: state_address, offset: STATE_CLOCK_SOURCE)
    mut fx.store(counter, addr: state_address, offset: STATE_CLOCK_COUNTER)
    mut fx.store(platform[2], addr: state_address, offset: STATE_CLOCK_MASK)
    return mut fx.choose_in(mut self, condition: tsc, results: fx.types2(PTR, b: PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return mut lo1.tsc_rate(mut fx1, counted, platform: platform.view())
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let count = mut lo1.counter_reading(mut fx1, source: kind, counter)
        let ticks_state = mut lo1.state(mut fx1)
        mut fx1.store(count, addr: ticks_state, offset: STATE_CLOCK_TICKS)
        return fx1.list2(count, b: counter_scale)
    })
} Lowering.start_x64_clock

/// The time-stamp counter now and its scale: from the rate CPUID leaf `0x15` reports where it
/// gives both the ratio and the crystal's frequency, else measured against `platform`, the
/// source, counter, mask and scale of the HPET or PM timer, when `counted` holds, and against the
/// PIT otherwise.
fn Lowering.tsc_rate(mut self, mut fx: Fx, counted: clif::Value, platform: Slice[clif::Value]) -> mem::List[clif::Value] {
    let words = mut fx.slot(16, align: 4)
    let highest = mut self.cpuid(mut fx, words, leaf: BASIC_LEAVES)
    let denominator = mut self.cpuid(mut fx, words, leaf: TSC_LEAF)
    let ratio_word = mut fx.load(clif::Type.Int32, addr: words, offset: 4)
    let ratio = mut fx.b.uextend(PTR, x: ratio_word)
    let crystal_word = mut fx.load(clif::Type.Int32, addr: words, offset: 8)
    let crystal = mut fx.b.uextend(PTR, x: crystal_word)
    let listed = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: highest, y: i64.widen(TSC_LEAF))
    let ratio_given = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: ratio, y: 0)
    let ratio_listed = mut fx.b.band(listed, y: ratio_given)
    let crystal_given = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: crystal, y: 0)
    let reported = mut fx.b.band(ratio_listed, y: crystal_given)
    return mut fx.choose_in(mut self, condition: reported, results: fx.types2(PTR, b: PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let product = mut fx1.b.imul(crystal, y: ratio)
        let one = mut fx1.ptr(1)
        let divisor = mut fx1.b.umax(denominator, y: one)
        let quotient = mut fx1.b.udiv(product, y: divisor)
        let hz = mut fx1.b.umax(quotient, y: one)
        let second = mut fx1.ptr(NS_PER_SECOND << 32)
        let scale = mut fx1.b.udiv(second, y: hz)
        let read = mut lo1.call_stub(mut fx1, stub: Stub.ReadTsc, args: mem::List[clif::Value].empty(fx1.alloc).view())
        expect read.len() > 0
        return fx1.list2(read[0], b: scale)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return mut fx1.choose_in(mut lo1, condition: counted, results: fx1.types2(PTR, b: PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return mut lo2.counter_tsc_rate(mut fx2, platform)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return mut lo2.pit_tsc_rate(mut fx2)
        })
    })
} Lowering.tsc_rate

/// The time-stamp counter at the end of `TSC_WINDOW` of a platform counter, given as its source,
/// counter, mask and scale, and its scale over that window.
fn Lowering.counter_tsc_rate(mut self, mut fx: Fx, platform: Slice[clif::Value]) -> mem::List[clif::Value] {
    expect platform.len() > 3
    let source = platform[0]
    let counter = platform[1]
    let mask = platform[2]
    let scale = platform[3]
    let span = mut fx.ptr(TSC_WINDOW << 32)
    let window = mut fx.b.udiv(span, y: scale)
    let initial = mut self.counter_reading(mut fx, source, counter)
    let started = mut self.call_stub(mut fx, stub: Stub.ReadTsc, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect started.len() > 0
    let start = started[0]
    let zero = mut fx.ptr(0)
    let counted = mut fx.repeat(fx.list1(zero).view(), body: fn[mut self](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        let reading = mut self.counter_reading(mut fx1, source, counter)
        let difference = mut fx1.b.isub(reading, y: initial)
        let passed = mut fx1.b.band(difference, y: mask)
        let short = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: passed, y: window)
        return Pass(again: short, next: fx1.list1(passed))
    })
    expect counted.len() > 0
    let ended = mut self.call_stub(mut fx, stub: Stub.ReadTsc, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect ended.len() > 0
    let end = ended[0]
    let elapsed_ticks = mut fx.b.isub(end, y: start)
    let one = mut fx.ptr(1)
    let ticks = mut fx.b.umax(elapsed_ticks, y: one)
    let elapsed = mut fx.b.imul(counted[0], y: scale)
    let tsc_scale = mut fx.b.udiv(elapsed, y: ticks)
    return fx.list2(end, b: tsc_scale)
} Lowering.counter_tsc_rate

/// The HPET the ACPI `HPET` table names, its counter started, or else the PM timer the FADT
/// names, or else the time-stamp counter: the source, its counter's address or port, the mask of
/// the bits it counts and its scale.
fn Lowering.counter_source(mut self, mut fx: Fx) -> mem::List[clif::Value] {
    let rsdp = mut self.rsdp(mut fx)
    let hpet = mut self.acpi_table(mut fx, rsdp, signature: HPET_SIGNATURE)
    let found = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: hpet, y: 0)
    return mut fx.choose_in(mut self, condition: found, results: fx.types4(PTR, b: PTR, c: PTR, d: PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let base = load_u64(mut fx1, address: hpet, offset: HPET_ADDRESS)
        let capabilities = mut lo1.mmio_read(mut fx1, width: 8, address: base)
        let at = mut fx1.b.iadd_imm_s(base, y: i64.fit(HPET_CONFIGURATION))
        let configuration = mut lo1.mmio_read(mut fx1, width: 8, address: at)
        let enabled = mut fx1.b.bor_imm_s(configuration, y: HPET_ENABLE)
        mut lo1.mmio_write(mut fx1, width: 8, address: at, value: enabled)
        let period = mut fx1.b.ushr_imm_s(capabilities, y: 32)
        let shifted = mut fx1.b.ishl_imm_s(period, y: 32)
        let femtoseconds = mut fx1.ptr(FS_PER_NS)
        let scale = mut fx1.b.udiv(shifted, y: femtoseconds)
        let wide_bit = mut fx1.b.band_imm_s(capabilities, y: HPET_WIDE)
        let wide = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: wide_bit, y: 0)
        let all = mut fx1.int(PTR, value: -1)
        let low = mut fx1.ptr(0xFFFF_FFFF)
        let mask = mut fx1.b.select(wide, x: all, y: low)
        let counter = mut fx1.b.iadd_imm_s(base, y: i64.fit(HPET_COUNTER))
        let source = mut fx1.int(PTR, value: HPET_SOURCE)
        return fx1.list4(source, b: counter, c: mask, d: scale)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let fadt = mut lo1.acpi_table(mut fx1, rsdp, signature: FADT_SIGNATURE)
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: fadt, y: 0)
        let timer = mut fx1.choose(present, results: fx1.types2(PTR, b: PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let port = load_u32(mut fx2, address: fadt, offset: FADT_PM_TIMER)
            let flags = load_u32(mut fx2, address: fadt, offset: FADT_FLAGS)
            return fx2.list2(port, b: flags)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let zero = mut fx2.ptr(0)
            return fx2.list2(zero, b: zero)
        })
        expect timer.len() > 1
        let timed = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: timer[0], y: 0)
        let pm_timer = mut fx1.int(PTR, value: PM_TIMER_SOURCE)
        let tsc = mut fx1.int(PTR, value: TSC_SOURCE)
        let source = mut fx1.b.select(timed, x: pm_timer, y: tsc)
        let wide_bit = mut fx1.b.band_imm_s(timer[1], y: PM_TIMER_32)
        let wide = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: wide_bit, y: 0)
        let all = mut fx1.ptr(0xFFFF_FFFF)
        let low = mut fx1.ptr(0xFF_FFFF)
        let mask = mut fx1.b.select(wide, x: all, y: low)
        let scale = mut fx1.ptr((NS_PER_SECOND << 32) / PM_TIMER_HZ)
        return fx1.list4(source, b: timer[0], c: mask, d: scale)
    })
} Lowering.counter_source

/// The time-stamp counter at the end of the 10 ms the PIT's channel 2 counts down, and its scale
/// over those 10 ms.
fn Lowering.pit_tsc_rate(mut self, mut fx: Fx) -> mem::List[clif::Value] {
    let control_port = mut fx.ptr(SYSTEM_CONTROL)
    let control = mut self.port_in(mut fx, width: 1, port: control_port)
    let quiet = mut fx.b.band_imm_s(control, y: ~SPEAKER)
    let gated = mut fx.b.bor_imm_s(quiet, y: PIT_GATE)
    mut self.port_out(mut fx, width: 1, port: control_port, value: gated)
    let mode_port = mut fx.ptr(PIT_MODE)
    let mode = mut fx.ptr(CHANNEL_2_ONE_SHOT)
    mut self.port_out(mut fx, width: 1, port: mode_port, value: mode)
    for shift in 0u32..<2 {
        let data_port = mut fx.ptr(PIT_CHANNEL_2)
        let byte_value = mut fx.ptr((PIT_LATCH >> (8 * shift)) & 0xFF)
        mut self.port_out(mut fx, width: 1, port: data_port, value: byte_value)
    }
    let started = mut self.call_stub(mut fx, stub: Stub.ReadTsc, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect started.len() > 0
    let start = started[0]
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut self](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        let poll_port = mut fx1.ptr(SYSTEM_CONTROL)
        let polled = mut self.port_in(mut fx1, width: 1, port: poll_port)
        let out = mut fx1.b.band_imm_s(polled, y: CHANNEL_2_OUT)
        let low = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: out, y: 0)
        return Pass(again: low, next: mem::List[clif::Value].empty(fx1.alloc))
    })
    let ended = mut self.call_stub(mut fx, stub: Stub.ReadTsc, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect ended.len() > 0
    let end = ended[0]
    let counted = mut fx.b.isub(end, y: start)
    let one = mut fx.ptr(1)
    let ticks = mut fx.b.umax(counted, y: one)
    let window = mut fx.ptr(PIT_WINDOW << 32)
    let scale = mut fx.b.udiv(window, y: ticks)
    return fx.list2(end, b: scale)
} Lowering.pit_tsc_rate

/// A reading of the HPET's counter or the PM timer's, as `source` is one or the other.
fn Lowering.counter_reading(mut self, mut fx: Fx, source: clif::Value, counter: clif::Value) -> clif::Value {
    let hpet = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: source, y: HPET_SOURCE)
    let read = mut fx.choose_in(mut self, condition: hpet, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut lo1.mmio_read(mut fx1, width: 8, address: counter))
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut lo1.port_in(mut fx1, width: 4, port: counter))
    })
    expect read.len() > 0
    return read[0]
} Lowering.counter_reading

/// `ClockNow() -> nanoseconds`: the counter's ticks since the base, as nanoseconds, raised to the
/// latest reading of any CPU when they are fewer.
fn define_clock_now(mut lo: Lowering, mut fx: Fx) {
    discard mut fx.entry()
    let count = mut lo.clock_count(mut fx)
    let state_address = mut lo.state(mut fx)
    let base = mut fx.load(PTR, addr: state_address, offset: STATE_CLOCK_BASE)
    let scale = mut fx.load(PTR, addr: state_address, offset: STATE_CLOCK_SCALE)
    let before = mut fx.b.icmp(clif::IntCC.UnsignedLessThan, x: count, y: base)
    let elapsed = mut fx.b.isub(count, y: base)
    let zero = mut fx.ptr(0)
    let ticks = mut fx.b.select(before, x: zero, y: elapsed)
    let low = mut fx.b.imul(ticks, y: scale)
    let high = mut fx.b.umulhi(ticks, y: scale)
    let fraction = mut fx.b.ushr_imm_s(low, y: 32)
    let whole = mut fx.b.ishl_imm_s(high, y: 32)
    let read = mut fx.b.bor(whole, y: fraction)
    let last = mut fx.offset(state_address, offset: STATE_CLOCK_LAST)
    let now = mut fx.repeat(fx.list1(zero).view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        let latest = mut fx1.b.atomic_load(PTR, flags: clif::MemFlags.owned(), p: last)
        let behind = mut fx1.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: read, y: latest)
        let result = mut fx1.choose(behind, results: fx1.types2(clif::Type.Int8, b: PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let settled = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list2(settled, b: latest)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let seen = mut fx2.b.atomic_cas(clif::MemFlags.owned(), p: last, e: latest, x: read)
            let raced = mut fx2.b.icmp(clif::IntCC.NotEqual, x: seen, y: latest)
            return fx2.list2(raced, b: read)
        })
        expect result.len() > 1
        return Pass(again: result[0], next: fx1.list1(result[1]))
    })
    expect now.len() > 0
    mut fx.b.ret(fx.list1(now[0]).view())
} define_clock_now

/// Whether the x86_64 clock's source is the time-stamp counter.
fn Lowering.tsc_clocked(mut self, mut fx: Fx) -> clif::Value {
    let state_address = mut self.state(mut fx)
    let source = mut fx.load(PTR, addr: state_address, offset: STATE_CLOCK_SOURCE)
    return mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: source, y: TSC_SOURCE)
} Lowering.tsc_clocked

/// The clock's counter: on x86_64 the time-stamp counter, or the HPET's or PM timer's count
/// extended; on AArch64 the virtual counter.
fn Lowering.clock_count(mut self, mut fx: Fx) -> clif::Value {
    if self.machine_arch() == workspace::Arch.Aarch64 {
        return mut self.read_sysreg(mut fx, register: CNTVCT_EL0)
    }
    let state_address = mut self.state(mut fx)
    let source = mut fx.load(PTR, addr: state_address, offset: STATE_CLOCK_SOURCE)
    let tsc = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: source, y: TSC_SOURCE)
    let count = mut fx.choose_in(mut self, condition: tsc, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return mut lo1.call_stub(mut fx1, stub: Stub.ReadTsc, args: mem::List[clif::Value].empty(fx1.alloc).view())
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut lo1.extended_count(mut fx1, source))
    })
    expect count.len() > 0
    return count[0]
} Lowering.clock_count

/// The HPET's or PM timer's count extended to 64 bits from the latest count any CPU read, which a
/// reading less than half the counter's range behind it gives instead.
fn Lowering.extended_count(mut self, mut fx: Fx, source: clif::Value) -> clif::Value {
    let state_address = mut self.state(mut fx)
    let counter = mut fx.load(PTR, addr: state_address, offset: STATE_CLOCK_COUNTER)
    let mask = mut fx.load(PTR, addr: state_address, offset: STATE_CLOCK_MASK)
    let half = mut fx.b.ushr_imm_s(mask, y: 1)
    let ticks = mut fx.offset(state_address, offset: STATE_CLOCK_TICKS)
    let zero = mut fx.ptr(0)
    let count = mut fx.repeat(fx.list1(zero).view(), body: fn[mut self](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        let latest = mut fx1.b.atomic_load(PTR, flags: clif::MemFlags.owned(), p: ticks)
        let reading = mut self.counter_reading(mut fx1, source, counter)
        let difference = mut fx1.b.isub(reading, y: latest)
        let passed = mut fx1.b.band(difference, y: mask)
        let behind = mut fx1.b.icmp(clif::IntCC.UnsignedGreaterThan, x: passed, y: half)
        let result = mut fx1.choose(behind, results: fx1.types2(clif::Type.Int8, b: PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let settled = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list2(settled, b: latest)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let extended = mut fx2.b.iadd(latest, y: passed)
            let seen = mut fx2.b.atomic_cas(clif::MemFlags.owned(), p: ticks, e: latest, x: extended)
            let raced = mut fx2.b.icmp(clif::IntCC.NotEqual, x: seen, y: latest)
            return fx2.list2(raced, b: extended)
        })
        expect result.len() > 1
        return Pass(again: result[0], next: fx1.list1(result[1]))
    })
    expect count.len() > 0
    return count[0]
} Lowering.extended_count

/// Starts the running CPU's timer as it starts taking interrupts: its rate measured on x86_64,
/// its first pacing tick a period from now.
fn Lowering.start_timer(mut self, mut fx: Fx) {
    let rate = match self.machine_arch() {
        workspace::Arch.Amd64 => mut self.x64_timer_rate(mut fx)
        workspace::Arch.Aarch64 => mut self.aarch64_timer_rate(mut fx)
    }
    let record = mut self.running_cpu(mut fx)
    mut fx.store(rate, addr: record, offset: CPU_TIMER_RATE)
    let read = mut self.call_routine(mut fx, routine: Routine.ClockNow, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect read.len() > 0
    let pace = mut fx.b.iadd_imm_s(read[0], y: i64.fit(PACING_PERIOD))
    mut fx.store(pace, addr: record, offset: CPU_NEXT_PACE)
    mut self.reprogram_timer(mut fx)
} Lowering.start_timer

/// Programs the running CPU's timer again, under the timer lock.
fn Lowering.reprogram_timer(mut self, mut fx: Fx) {
    let state_address = mut self.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TIMER_LOCK)
    discard mut self.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    mut self.program_timer(mut fx)
    discard mut self.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
} Lowering.reprogram_timer

/// Programs the running CPU's timer to fire at the earliest of the end of a timer's window, the end
/// of its task's slice while that is ahead and, while it runs a task or the final build binds the
/// timer's vector, its next pacing tick; at once when that has passed. The caller holds the timer
/// lock.
fn Lowering.program_timer(mut self, mut fx: Fx) {
    let record = mut self.running_cpu(mut fx)
    let latest = mut fx.int(PTR, value: -1)
    let next_pace = mut fx.load(PTR, addr: record, offset: CPU_NEXT_PACE)
    let timer = self.vectors().timer
    let statically = mut self.statically_bound()
    var bound = false
    for vector in statically {
        if vector == timer {
            bound = true
        }
    }
    var pace = next_pace
    if not bound {
        let thread = mut fx.load(PTR, addr: record, offset: CPU_THREAD)
        let current = mut fx.load(PTR, addr: thread, offset: THREAD_CURRENT)
        let running = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: current, y: 0)
        pace = mut fx.b.select(running, x: next_pace, y: latest)
    }
    let read = mut self.call_routine(mut fx, routine: Routine.ClockNow, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect read.len() > 0
    let now = read[0]
    let slice_end = mut fx.load(PTR, addr: record, offset: CPU_SLICE_END)
    let sliced = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: slice_end, y: now)
    let end = mut fx.b.select(sliced, x: slice_end, y: latest)
    let due_first = mut fx.b.umin(pace, y: end)
    let target = mut self.windows_end(mut fx, bound: due_first)
    let ahead = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: target, y: now)
    let remaining = mut fx.b.isub(target, y: now)
    let zero = mut fx.ptr(0)
    let waited = mut fx.b.select(ahead, x: remaining, y: zero)
    let longest = mut fx.ptr(LONGEST_DELAY)
    let delay = mut fx.b.umin(waited, y: longest)
    let rate = mut fx.load(PTR, addr: record, offset: CPU_TIMER_RATE)
    let scaled = mut fx.b.imul(delay, y: rate)
    let per_ms = mut fx.ptr(NS_PER_MS)
    let counted = mut fx.b.udiv(scaled, y: per_ms)
    let one = mut fx.ptr(1)
    let least = mut fx.b.umax(counted, y: one)
    let most = mut fx.ptr(MOST_TICKS)
    let ticks = mut fx.b.umin(least, y: most)
    match self.machine_arch() {
        workspace::Arch.Amd64 => mut self.x64_set_timer(mut fx, ticks)
        workspace::Arch.Aarch64 => mut self.aarch64_set_timer(mut fx, ticks)
    }
} Lowering.program_timer

/// The earliest end of a timer's window, or `bound` when it is earlier. The timers are in the order
/// they are due and a window ends no sooner than its timer is due, so the walk stops at the first
/// timer due after the earliest end so far. The caller holds the timer lock.
fn Lowering.windows_end(mut self, mut fx: Fx, bound: clif::Value) -> clif::Value {
    let state_address = mut self.state(mut fx)
    let head = mut fx.load(PTR, addr: state_address, offset: STATE_TIMERS)
    let walked = mut fx.repeat(fx.list2(head, b: bound).view(), body: fn(mut fx1: Fx, walk: Slice[clif::Value]) -> Pass {
        expect walk.len() > 1
        let current = walk[0]
        let end = walk[1]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: current, y: 0)
        let next = mut fx1.choose(present, results: fx1.types3(PTR, b: PTR, c: clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let due = mut fx2.load(PTR, addr: current, offset: OPERATION_DUE)
            let within = mut fx2.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: due, y: end)
            let window = mut fx2.load(PTR, addr: current, offset: OPERATION_WINDOW_END)
            let following = mut fx2.load(PTR, addr: current, offset: OPERATION_NEXT)
            let earliest = mut fx2.b.umin(end, y: window)
            return fx2.list3(following, b: earliest, c: within)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let stop = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list3(current, b: end, c: stop)
        })
        expect next.len() > 2
        return Pass(again: next[2], next: fx1.list2(next[0], b: next[1]))
    })
    expect walked.len() > 1
    return walked[1]
} Lowering.windows_end

/// What the running CPU's timer interrupt does before any interrupt fn runs: the timers due
/// expire, a pacing tick that has come moves the next a period on, and the timer is programmed
/// again. Gives whether the interrupt is a pacing tick.
fn Lowering.timer_interrupt(mut self, mut fx: Fx) -> clif::Value {
    mut self.expire_timers(mut fx)
    let record = mut self.running_cpu(mut fx)
    let read = mut self.call_routine(mut fx, routine: Routine.ClockNow, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect read.len() > 0
    let now = read[0]
    let pace = mut fx.load(PTR, addr: record, offset: CPU_NEXT_PACE)
    let pacing = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThanOrEqual, x: now, y: pace)
    mut fx.if_true(pacing, then: fn(mut fx1: Fx) {
        let next = mut fx1.b.iadd_imm_s(pace, y: i64.fit(PACING_PERIOD))
        let late = mut fx1.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: next, y: now)
        let fresh = mut fx1.b.iadd_imm_s(now, y: i64.fit(PACING_PERIOD))
        let chosen = mut fx1.b.select(late, x: fresh, y: next)
        mut fx1.store(chosen, addr: record, offset: CPU_NEXT_PACE)
    })
    mut self.reprogram_timer(mut fx)
    return pacing
} Lowering.timer_interrupt

/// Takes each timer due out of the timers, one at a time under the timer lock, and delivers its
/// expiry outside it.
fn Lowering.expire_timers(mut self, mut fx: Fx) {
    let read = mut self.call_routine(mut fx, routine: Routine.ClockNow, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect read.len() > 0
    let now = read[0]
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut self](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        let state_address = mut self.state(mut fx1)
        let lock = mut fx1.offset(state_address, offset: STATE_TIMER_LOCK)
        discard mut self.call_routine(mut fx1, routine: Routine.Lock, args: fx1.list1(lock).view())
        let head = mut fx1.load(PTR, addr: state_address, offset: STATE_TIMERS)
        let armed = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
        let decided = mut fx1.choose(armed, results: fx1.types1(clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let due_at = mut fx2.load(PTR, addr: head, offset: OPERATION_DUE)
            let passed = mut fx2.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: due_at, y: now)
            return fx2.list1(passed)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(no)
        })
        let due = decided[0]
        mut fx1.if_true(due, then: fn[mut self](mut fx2: Fx) {
            disarm(mut self, fx: mut fx2, op: head)
            claim_timer(mut fx2, op: head)
        })
        discard mut self.call_routine(mut fx1, routine: Routine.Unlock, args: fx1.list1(lock).view())
        mut fx1.if_true(due, then: fn[mut self](mut fx2: Fx) {
            let expired = mut fx2.int(clif::Type.Int32, value: TASKS_EXPIRED)
            deliver(mut self, fx: mut fx2, op: head, result: expired)
        })
        return Pass(again: due, next: mem::List[clif::Value].empty(fx1.alloc))
    })
} Lowering.expire_timers

/// Arms a timer of the clock due `ns` nanoseconds from now through `TimerArm`, on whose stack the
/// policy's slack hook runs.
fn Lowering.kernel_arm(mut self, mut fx: Fx, op: clif::Value, ns: clif::Value) {
    discard mut self.call_routine(mut fx, routine: Routine.TimerArm, args: fx.list2(op, b: ns).view())
} Lowering.kernel_arm

/// Arms a timer of the clock due `ns` nanoseconds from now. On a kernel its window ends after the
/// slack the kernel's policy gives it, and when that window ends first the running CPU's timer is
/// programmed again; an isolated space's runtime waits for it as it idles.
fn Lowering.arm_clock(mut self, mut fx: Fx, op: clif::Value, ns: clif::Value) {
    let kernel_side = not self.user()
    var slack = op
    if kernel_side {
        slack = mut self.timer_slack(mut fx, delay: ns)
    }
    let state_address = mut self.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TIMER_LOCK)
    discard mut self.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let read = mut self.call_routine(mut fx, routine: Routine.ClockNow, args: mem::List[clif::Value].empty(fx.alloc).view())
    expect read.len() > 0
    let due = due_after(mut fx, now: read[0], delay: ns)
    arm(mut self, mut fx, op, due)
    if kernel_side {
        let window = due_after(mut fx, now: due, delay: slack)
        mut fx.store(window, addr: op, offset: OPERATION_WINDOW_END)
        let all = mut fx.int(PTR, value: -1)
        let end = mut self.windows_end(mut fx, bound: all)
        let earliest = mut fx.b.icmp(clif::IntCC.Equal, x: end, y: window)
        mut fx.if_true(earliest, then: fn[mut self](mut fx1: Fx) {
            mut self.program_timer(mut fx1)
        })
    }
    discard mut self.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
} Lowering.arm_clock

/// Cancels a timer of the clock that is armed and has not expired: it leaves the timers and
/// completes cancelled.
fn Lowering.kernel_cancel(mut self, mut fx: Fx, op: clif::Value) {
    let claimed = mut self.kernel_claim(mut fx, op)
    mut fx.if_true(claimed, then: fn[mut self](mut fx1: Fx) {
        mut self.kernel_cancelled(mut fx1, op)
    })
} Lowering.kernel_cancel

/// Takes a timer of the clock that is armed and has not expired out of the timers, giving
/// whether it did so; its cancelled completion is then the caller's to deliver.
fn Lowering.kernel_claim(mut self, mut fx: Fx, op: clif::Value) -> clif::Value {
    let state_address = mut self.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TIMER_LOCK)
    discard mut self.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let done = mut fx.load(PTR, addr: op, offset: OPERATION_DONE)
    let pending = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: done, y: 0)
    let order = mut fx.load(PTR, addr: op, offset: OPERATION_ORDER)
    let armed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: order, y: 0)
    let in_flight = mut fx.b.band(pending, y: armed)
    mut fx.if_true(in_flight, then: fn[mut self](mut fx1: Fx) {
        disarm(mut self, fx: mut fx1, op)
        claim_timer(mut fx1, op)
    })
    discard mut self.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    return in_flight
} Lowering.kernel_claim

/// Delivers the cancelled completion of a timer the caller claimed.
fn Lowering.kernel_cancelled(mut self, mut fx: Fx, op: clif::Value) {
    let cancelled = mut fx.int(clif::Type.Int32, value: CANCELED)
    deliver(mut self, mut fx, op, result: cancelled)
} Lowering.kernel_cancelled

/// Reads the target's wall clock source. The PL031's data register, at its base, counts the
/// seconds since the Unix epoch; an `aarch64-bare` machine without one gives no time.
fn Lowering.wall_source(mut self, mut fx: Fx) -> WallSource {
    match self.ck.db().target {
        workspace::Target.X64Bare => {
            let valid = mut fx.int(clif::Type.Int8, value: 1)
            let now = mut self.cmos_time(mut fx)
            return WallSource(valid: valid, now: now)
        }
        workspace::Target.Aarch64Bare => {
            let record = mut self.machine_record(mut fx)
            let rtc = mut fx.load(PTR, addr: record, offset: MACHINE_RTC)
            let valid = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: rtc, y: 0)
            let read = mut fx.choose_in(mut self, condition: valid, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
                return fx1.list1(mut lo1.mmio_read(mut fx1, width: 4, address: rtc))
            }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
                return fx1.list1(mut fx1.ptr(0))
            })
            let now = mut fx.b.imul_imm_s(read[0], y: i64.fit(NS_PER_SECOND))
            return WallSource(valid: valid, now: now)
        }
        else => {
            let time = firmware_time(mut self, mut fx)
            let seconds = civil_seconds(mut fx, civil: time.fields)
            let whole = mut fx.b.imul_imm_s(seconds, y: i64.fit(NS_PER_SECOND))
            let now = mut fx.b.iadd(whole, y: time.nanoseconds)
            return WallSource(valid: time.valid, now: now)
        }
    }
} Lowering.wall_source

/// The CMOS clock's time in nanoseconds since the Unix epoch, read once no update runs, its year
/// in the century from 2000.
fn Lowering.cmos_time(mut self, mut fx: Fx) -> clif::Value {
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut self](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        let status = mut self.cmos(mut fx1, register: CMOS_STATUS_A)
        let updating = mut fx1.b.band_imm_s(status, y: CMOS_UPDATING)
        let busy = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: updating, y: 0)
        return Pass(again: busy, next: mem::List[clif::Value].empty(fx1.alloc))
    })
    let earliest_field = mut self.cmos(mut fx, register: CMOS_FIELDS[0])
    var raw = Array[clif::Value, 6].filled(earliest_field)
    for index in 1usize..<6 {
        raw[index] = mut self.cmos(mut fx, register: CMOS_FIELDS[index])
    }
    let format = mut self.cmos(mut fx, register: CMOS_STATUS_B)
    let binary_bit = mut fx.b.band_imm_s(format, y: CMOS_BINARY)
    let binary = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: binary_bit, y: 0)
    let afternoon_bit = mut fx.b.band_imm_s(raw[2], y: CMOS_AFTERNOON)
    let afternoon = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: afternoon_bit, y: 0)
    var fields = raw
    for index in 0usize..<6 {
        let value = if index == 2 {
            mut fx.b.band_imm_s(raw[index], y: ~CMOS_AFTERNOON)
        } else {
            raw[index]
        }
        let low = mut fx.b.band_imm_s(value, y: 0x0F)
        let high = mut fx.b.ushr_imm_s(value, y: 4)
        let tens = mut fx.b.imul_imm_s(high, y: 10)
        let from_bcd = mut fx.b.iadd(low, y: tens)
        fields[index] = mut fx.b.select(binary, x: value, y: from_bcd)
    }
    let hours = mut fx.b.band_imm_s(format, y: CMOS_24_HOUR)
    let twelve = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: hours, y: 0)
    let noon = mut fx.ptr(12)
    let hour = mut fx.b.urem(fields[2], y: noon)
    let later = mut fx.b.iadd_imm_s(hour, y: 12)
    let clock_hour = mut fx.b.select(afternoon, x: later, y: hour)
    fields[2] = mut fx.b.select(twelve, x: clock_hour, y: fields[2])
    fields[5] = mut fx.b.iadd_imm_s(fields[5], y: 2000)
    var civil = Array[clif::Value, 6].filled(fields[5])
    civil[1] = fields[4]
    civil[2] = fields[3]
    civil[3] = fields[2]
    civil[4] = fields[1]
    civil[5] = fields[0]
    let seconds = civil_seconds(mut fx, civil)
    return mut fx.b.imul_imm_s(seconds, y: i64.fit(NS_PER_SECOND))
} Lowering.cmos_time

/// A register of the CMOS clock.
fn Lowering.cmos(mut self, mut fx: Fx, register: u64) -> clif::Value {
    let index = mut fx.ptr(CMOS_INDEX)
    let selected = mut fx.ptr(register)
    mut self.port_out(mut fx, width: 1, port: index, value: selected)
    let data = mut fx.ptr(CMOS_DATA)
    return mut self.port_in(mut fx, width: 1, port: data)
} Lowering.cmos

/// Marks a timer taken out of the timers as completed, so no other CPU delivers it.
fn claim_timer(mut fx: Fx, op: clif::Value) {
    let completed = mut fx.ptr(u64.fit(OPERATION_COMPLETED))
    mut fx.store(completed, addr: op, offset: OPERATION_DONE)
} claim_timer

/// The seconds since the Unix epoch of a time from 2000 on: its year, month, day, hour, minute
/// and second, counting days as the proleptic Gregorian calendar does.
fn civil_seconds(mut fx: Fx, civil: Array[clif::Value, 6]) -> clif::Value {
    let month = civil[1]
    let early = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThanOrEqual, x: month, y: 2)
    let borrow = mut fx.b.uextend(PTR, x: early)
    let year = mut fx.b.isub(civil[0], y: borrow)
    let era_length = mut fx.ptr(400)
    let era = mut fx.b.udiv(year, y: era_length)
    let start = mut fx.b.imul_imm_s(era, y: 400)
    let of_era = mut fx.b.isub(year, y: start)
    let shifted = mut fx.b.iadd_imm_s(month, y: -3)
    let wrapped = mut fx.b.iadd_imm_s(month, y: 9)
    let march_based = mut fx.b.select(early, x: wrapped, y: shifted)
    let spread = mut fx.b.imul_imm_s(march_based, y: 153)
    let rounded = mut fx.b.iadd_imm_s(spread, y: 2)
    let five = mut fx.ptr(5)
    let month_days = mut fx.b.udiv(rounded, y: five)
    let through = mut fx.b.iadd(month_days, y: civil[2])
    let of_year = mut fx.b.iadd_imm_s(through, y: -1)
    let years = mut fx.b.imul_imm_s(of_era, y: 365)
    let four = mut fx.ptr(4)
    let leap = mut fx.b.udiv(of_era, y: four)
    let hundred = mut fx.ptr(100)
    let centuries = mut fx.b.udiv(of_era, y: hundred)
    let with_leap = mut fx.b.iadd(years, y: leap)
    let in_era = mut fx.b.isub(with_leap, y: centuries)
    let of_days = mut fx.b.iadd(in_era, y: of_year)
    let eras = mut fx.b.imul_imm_s(era, y: 146_097)
    let total = mut fx.b.iadd(eras, y: of_days)
    let days = mut fx.b.iadd_imm_s(total, y: -719_468)
    let day_seconds = mut fx.b.imul_imm_s(days, y: 86_400)
    let hours = mut fx.b.imul_imm_s(civil[3], y: 3_600)
    let minutes = mut fx.b.imul_imm_s(civil[4], y: 60)
    let with_hours = mut fx.b.iadd(day_seconds, y: hours)
    let with_minutes = mut fx.b.iadd(with_hours, y: minutes)
    return mut fx.b.iadd(with_minutes, y: civil[5])
} civil_seconds
