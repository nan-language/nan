//! Entry of the gauge and the parsing of its level file.

pub closed enum LevelError derives Render {
    Empty
    BadDigit(u8)
    Fs(sys::fs::FsError) from
    Cancelled(task::Cancelled) from
} LevelError

/// Ends with the level of `level.txt` divided by 4 as the exit status.
fn main(take world: host::World) -> u8 fails LevelError uses wait {
    let raw = try await world.fs.read_all("level.txt", alloc: world.alloc)
    let level = try parse_level(raw.view())
    return u8.fit(level / 4)
} main

/// The decimal number `raw` holds.
validator fn parse_level(raw: Untrusted[Slice[u8]]) -> u32 fails LevelError {
    let digits = raw.inspect()
    if digits.is_empty() {
        fail LevelError.Empty
    }
    var level: u32 = 0
    for byte in digits {
        if byte < b'0' or byte > b'9' {
            fail LevelError.BadDigit(byte)
        }
        level = level * 10 + u32.widen(byte - b'0')
    }
    return level
} parse_level
