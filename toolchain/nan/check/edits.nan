//! The edits of the editing commands: an item's identity, and the replacements renaming or moving an item or member across the workspace.

/// The identity of the item holding a line of a workspace file: its name, or an impl line's
/// canonical path, a tombstone's old form or a const assert's item hash.
pkg fn Session.identity(self, path: Str, line: u32) -> Option[text::String] {
    let alloc = self.alloc
    let held = self.workspace.contents()
    let Some(at) = held.file(path) else {
        return None
    }
    let Some(closure) = held.closure_of(at.package_index) else {
        return None
    }
    let Some(source) = held.package_at(at.package_index) else {
        expect false
        return None
    }
    let Some(target) = check_targets(source, alloc).get(0) else {
        return None
    }
    let checker = self.unchecked(closure, target)
    let db = checker.db()
    var found: Option[ty::ItemId] = None
    for index in 0..<db.items.len() {
        let item = ty::ItemId(index: u32.fit(index))
        if db.item_file(item).path.as_str() != path {
            continue
        }
        let syntax = db.syntax(item)
        let data = db.item(item)
        expect data.index < syntax.items.len()
        if syntax.item_lines(syntax.items[data.index]).contains(line) {
            found = Some(item)
            break
        }
    }
    let Some(item) = found else {
        return None
    }
    return match db.ast(item).kind {
        ast::ItemKind.Impl(_) => checker.canonical_path(item)
        ast::ItemKind.Retired(_) => checker.own_path(item)
        ast::ItemKind.ConstAssert(_) => Some(checker.hashes(item).item.full(alloc))
        else => db.ast(item).name(alloc)
    }
} Session.identity

/// The edit renaming the item or member declared on lines of a workspace file, or named by a
/// location's line, to `name`: each
/// span writing its name rewritten, the rename tombstone it needs, or without one the old paths
/// of the tombstones retiring members of a type it renames, and each rename tombstone it then
/// takes removed.
pkg fn Session.renamed(self, path: Str, lines: core::Range[u32], located: Option[u32], name: Str) -> Option[diagnostic::Fix] {
    let alloc = self.alloc
    var spans = mem::Set[Span].empty(alloc)
    var tombstone: Option[diagnostic::Edit] = None
    var retaken = mem::List[diagnostic::Edit].empty(alloc)
    var found = false
    for held in self.closures_checked() {
        let checker = held.checker
        let Some(target) = checker.target_at(path, written: lines, located) else {
            continue
        }
        found = true
        for span in take checker.name_spans(target) {
            discard mut spans.insert(take span)
        }
        let written = checker.rename_tombstone(target, name)
        if written.is_none() {
            for span in take checker.member_tombstone_spans(target) {
                discard mut spans.insert(take span)
            }
        }
        if tombstone.is_none() {
            tombstone = written
        }
        if retaken.len() == 0 {
            retaken = checker.retaking(checker.db().package_of(target.item()), current: checker.target_form(target).as_str(), new: checker.renamed_form(target, name).as_str())
        }
    }
    if not found {
        return None
    }
    var edits = mem::List[diagnostic::Edit].empty(alloc)
    for span in spans {
        mut edits.push(diagnostic::Edit(path: text::String.of(span.path.as_str(), alloc), replacement: diagnostic::Replacement(start: span.start, end: span.end, text: text::String.of(name, alloc))))
    }
    match tombstone {
        Some(edit) => mut edits.push(take edit)
        None => {}
    }
    for removed in retaken {
        removing(mut edits, removed, alloc)
    }
    return Some(diagnostic::Fix(edits: take edits))
} Session.renamed

/// The canonical path of a target.
fn Checker.target_form(self, target: RenameTarget) -> text::String {
    let db = self.db()
    return match target {
        RenameTarget.Item(item) => db.canonical(item)
        RenameTarget.Field(owner: owner, name: member) or RenameTarget.Variant(owner: owner, name: member) or RenameTarget.Method(owner: owner, name: member) => form_of(db.canonical(owner), member: member.as_str())
    }
} Checker.target_form

/// The canonical path of a target once renamed to `name`.
fn Checker.renamed_form(self, target: RenameTarget, name: Str) -> text::String {
    let db = self.db()
    match target {
        RenameTarget.Item(item) => match db.owners.get(item) {
            Some(key) => return form_of(db.type_path(key), member: name)
            None => {
                var form = db.module_path(db.module_of(item))
                mut form.append("::")
                mut form.append(name)
                return form
            }
        }
        RenameTarget.Field(owner: owner, name: _) or RenameTarget.Variant(owner: owner, name: _) or RenameTarget.Method(owner: owner, name: _) => return form_of(db.canonical(owner), member: name)
    }
} Checker.renamed_form

/// The rename tombstone renaming a target to `name` writes after the item it retires, or the
/// type holding the member: none unless the package's history head has an item or member
/// visible to consumers at the target's canonical path, or the target is a field or variant
/// of a type deriving `Encode`.
fn Checker.rename_tombstone(self, target: RenameTarget, name: Str) -> Option[diagnostic::Edit] {
    let db = self.db()
    let alloc = self.alloc()
    match target {
        RenameTarget.Item(item) => {
            if not self.head_exports_form(db.package_of(item), form: self.target_form(target).as_str()) {
                return None
            }
            let Some(old) = db.ast(item).name(alloc) else {
                return None
            }
            var new = text::String.empty(alloc)
            match last_dot(old.as_str()) {
                Some(dot) => {
                    let Some(owner) = old.slice_bytes(0, end: dot + 1) else {
                        return None
                    }
                    mut new.append(owner)
                }
                None => {}
            }
            mut new.append(name)
            return Some(self.tombstone_after(item, old: old.as_str(), new: new.as_str()))
        }
        RenameTarget.Field(owner: owner, name: member) or RenameTarget.Variant(owner: owner, name: member) or RenameTarget.Method(owner: owner, name: member) => {
            let keeps_key = match db.ast(owner).kind {
                ast::ItemKind.Struct(structure) => names_encode(structure.derived.view())
                ast::ItemKind.Enum(enumeration) => names_encode(enumeration.derived.view())
                else => false
            }
            if not keeps_key and not self.head_exports_form(db.package_of(owner), form: self.target_form(target).as_str()) {
                return None
            }
            let owner_name = declared_name_of(db.ast(owner), alloc)
            var old = text::String.of(owner_name.as_str(), alloc)
            mut old.push('.')
            mut old.append(member.as_str())
            var new = text::String.of(owner_name.as_str(), alloc)
            mut new.push('.')
            mut new.append(name)
            return Some(self.tombstone_after(owner, old: old.as_str(), new: new.as_str()))
        }
    }
} Checker.rename_tombstone

/// The edit writing the rename tombstone `retired <old> => <new> preserves` after an item.
fn Checker.tombstone_after(self, item: ty::ItemId, old: Str, new: Str) -> diagnostic::Edit {
    let db = self.db()
    let alloc = self.alloc()
    let syntax = db.syntax(item)
    let data = db.item(item)
    expect data.index < syntax.items.len()
    let at = line_start_after(syntax, line: syntax.item_lines(syntax.items[data.index]).high)
    var written = text::String.of("\nretired ", alloc)
    mut written.append(old)
    mut written.append(" => ")
    mut written.append(new)
    mut written.append(" preserves\n")
    return diagnostic::Edit(path: text::String.of(db.item_file(item).path.as_str(), alloc), replacement: diagnostic::Replacement(start: at, end: at, text: take written))
} Checker.tombstone_after

/// The edit moving the item declared on lines of a workspace file, or named by a location's line,
/// into the module of its package named `module`: none when the lines declare nothing, an error
/// when the move is invalid.
pkg fn Session.moved(self, path: Str, lines: core::Range[u32], located: Option[u32], module: Str) -> Option[Result[Move, Unit]] {
    let held = self.workspace.contents()
    let Some(at) = held.file(path) else {
        return None
    }
    let Some(closure) = held.closure_of(at.package_index) else {
        return None
    }
    let Some(source) = held.package_at(at.package_index) else {
        expect false
        return None
    }
    let Some(target) = check_targets(source, alloc: self.alloc).get(0) else {
        return None
    }
    let checker = self.checked(closure, target)
    let Some(declared) = checker.target_at(path, written: lines, located) else {
        return None
    }
    let Some(made) = checker.moving(declared, module) else {
        return Some(Err(Unit))
    }
    return Some(Ok(take made))
} Session.moved
