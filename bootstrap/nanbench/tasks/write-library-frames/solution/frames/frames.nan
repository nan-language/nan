//! Validation of received frames.

/// Where a valid frame's payload lies in the received bytes.
pub closed struct Frame derives Eq, Render {
    pub urgent: bool
    pub start: usize
    pub length: usize
} Frame

pub closed enum FrameError derives Eq, Render {
    Truncated
    BadVersion(u8)
    Trailing
    BadChecksum
} FrameError

/// The version this link speaks.
const VERSION: u8 = 1

/// The bytes before the payload.
const HEADER_BYTES: usize = 4

/// The frame `raw` holds, checked whole.
pub validator fn decode_frame(raw: Untrusted[Slice[u8]]) -> Frame fails FrameError {
    let bytes = raw.inspect()
    let Some(head) = bytes.prefix(HEADER_BYTES) else {
        fail FrameError.Truncated
    }
    if head[0] != VERSION {
        fail FrameError.BadVersion(head[0])
    }
    let length = usize.widen(head.u16_be(2))
    let needed = HEADER_BYTES + length + 1
    if bytes.len() < needed {
        fail FrameError.Truncated
    }
    if bytes.len() > needed {
        fail FrameError.Trailing
    }
    var sum: u8 = 0
    for at in 0..<(HEADER_BYTES + length) {
        sum = sum.wrapping_add(bytes[at])
    }
    if sum != bytes[HEADER_BYTES + length] {
        fail FrameError.BadChecksum
    }
    return Frame(urgent: (head[1] & 1) == 1, start: HEADER_BYTES, length: length)
} decode_frame
