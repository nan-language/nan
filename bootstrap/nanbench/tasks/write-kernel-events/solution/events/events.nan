//! A bounded log of events, oldest first.

/// The events a log holds at most.
pub const CAPACITY: usize = 16

pub closed struct Event derives Copy, Eq, Render {
    pub source: u8
    pub code: u32
} Event

/// The events not yet taken, oldest first from slot `head`, and the number of events dropped
/// because the log was full.
pub open struct Log {
    events: Array[Event, 16]
    head: usize where head < CAPACITY
    count: usize where count <= CAPACITY
    drops: u64
} Log

pub fn Log.empty() -> Log = Log(events: Array[Event, 16].filled(Event(source: 0, code: 0)), head: 0, count: 0, drops: 0)

/// Appends `event`, or counts it dropped when the log is full.
pub fn Log.record(mut self, event: Event) limits notrap, terminates, noalloc {
    if self.count == CAPACITY {
        self.drops = self.drops.saturating_add(1)
        return
    }
    self.events[(self.head + self.count) % CAPACITY] = event
    self.count += 1
} Log.record

/// Removes and gives the oldest event.
pub fn Log.next(mut self) -> Option[Event] limits notrap, terminates, noalloc {
    if self.count == 0 {
        return None
    }
    let oldest = self.events[self.head]
    self.head = (self.head + 1) % CAPACITY
    self.count -= 1
    return Some(oldest)
} Log.next

/// The events dropped so far.
pub fn Log.dropped(self) -> u64 limits notrap, terminates, noalloc {
    return self.drops
} Log.dropped
