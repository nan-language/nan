test posted_messages_are_all_handled for Outbox.post {
    let world = testing::world()
    let last = try await host::Runner[Probe].run(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc, body: fn(inbox: Outbox[ProbeMessage]) fails task::SendError uses wait {
