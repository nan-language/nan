item "nan::hashing::full_block"
head "fn full_block(data: Slice[u8], start: usize) -> Words"
accepted "requires start <= data.len() and data.len() - start >= 64"
item "nan::hashing::put_word"
head "fn put_word(mut digest: Array[u8, 32], at: usize, word: u32)"
accepted "requires at <= 28"
item "nan::hashing::read_checksummed_base32"
head "pkg fn read_checksummed_base32(text: Str, length: usize, alloc: mem::Alloc) -> Option[mem::Bytes]"
accepted "ensures match result {         Some(bytes) => bytes.len() == length         None => true     }"
