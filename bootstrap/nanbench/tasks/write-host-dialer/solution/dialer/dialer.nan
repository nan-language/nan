//! Entry of the dialer and its retries.

pub closed enum ConnectError derives Render {
    GaveUp
    Net(sys::net::NetError) from
    Cancelled(task::Cancelled) from
} ConnectError

/// The local service's port.
const SERVICE_PORT: u16 = 4_200

/// The pause after the first refusal and the longest pause, in milliseconds.
const FIRST_PAUSE_MS: u64 = 100

const LONGEST_PAUSE_MS: u64 = 1_600

fn main(take world: host::World) fails ConnectError uses wait {
    let conn = try await connect_with_backoff(world.net, clock: world.clock, port: SERVICE_PORT, attempts: 6)
    world.log.info("connected", value: SERVICE_PORT)
    take conn.abandon()
} main

/// Connects to `port` on `localhost`, making at most `attempts` attempts and pausing after each
/// refused one but the last.
pub fn connect_with_backoff(net: sys::Net, clock: sys::Clock, port: u16, attempts: u32) -> sys::net::Conn fails ConnectError uses wait {
    var pause = FIRST_PAUSE_MS
    for made in 1..=attempts {
        match first attempt await net.connect("localhost", port) {
            Ok(conn) => return conn
            Err(sys::net::NetError.Refused) => {}
            Err(failure) => fail failure
        }
        if made < attempts {
            try await clock.sleep(pause)
            pause = pause * 2
            if pause > LONGEST_PAUSE_MS {
                pause = LONGEST_PAUSE_MS
            }
        }
    }
    fail ConnectError.GaveUp
} connect_with_backoff
