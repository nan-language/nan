//! An x86_64 bare kernel taking the MSI and INTx interrupts of PCI functions without MSI-X, and a platform device's line.

package x86_64_interrupts {
    language 1
    targets x86_64-bare
    entry main
    allow device in x86_64_interrupts
    allow trusted in x86_64_interrupts
} x86_64_interrupts
