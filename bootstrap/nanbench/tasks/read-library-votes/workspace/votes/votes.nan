//! The margin of a vote.

pub closed enum Vote derives Eq {
    Yes
    No
    Abstain
} Vote

/// The margin of yes votes over no votes, abstentions ignored, never below 0.
pub fn margin(votes: Slice[Vote]) -> u32 {
    var yes: u32 = 0
    var no: u32 = 0
    for vote in votes {
        match vote {
            Vote.Yes => {
                yes = yes.saturating_add(1)
            }
            Vote.No => {
                no = no.saturating_add(1)
            }
            Vote.Abstain => {}
        }
    }
    return yes.saturating_sub(no)
} margin
