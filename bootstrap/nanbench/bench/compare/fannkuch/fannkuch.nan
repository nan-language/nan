//! The most prefix reversals that sort a permutation of the size's elements, and a checksum of them all.

enum BenchError derives Render {
    Usage
    Stdio(sys::StdioError) from
    Cancelled(task::Cancelled) from
} BenchError

/// The number the first argument states in decimal, if it states one.
validator fn size(args: Untrusted[mem::List[mem::Bytes]]) -> Option[u64] {
    let Some(arg) = args.inspect().get(0) else {
        return None
    }
    var value: u64 = 0
    for digit in arg.view() {
        if digit < b'0' or digit > b'9' {
            return None
        }
        value = value * 10 + u64.widen(digit - b'0')
    }
    return Some(value)
} size

/// The most elements a permutation holds.
const MOST: usize = 16

/// The permutations' checksum and the most flips one takes.
struct Outcome {
    checksum: i64
    most_flips: u64
} Outcome

/// The flips that sort `permutation`: each reverses the prefix up to the position its first element names.
fn flips(permutation: Array[usize, MOST]) -> u64 {
    var order = permutation
    var count: u64 = 0
    loop {
        let leading = order[0]
        if leading == 0 {
            return count
        }
        var low: usize = 0
        var high = leading
        while low < high {
            let swapped = order[low]
            order[low] = order[high]
            order[high] = swapped
            low += 1
            high -= 1
        }
        count += 1
    }
} flips

/// The flips of every permutation of `n` elements, visited in the order of the counting rotations.
fn fannkuch(n: usize) -> Outcome {
    var permutation = Array[usize, MOST].filled(0)
    var counts = Array[usize, MOST].filled(0)
    for i in 0..<n {
        permutation[i] = i
    }
    var checksum: i64 = 0
    var most_flips: u64 = 0
    var even = true
    var rotated = n
    loop {
        while rotated != 1 {
            counts[rotated - 1] = rotated
            rotated -= 1
        }
        let count = flips(permutation)
        if count > most_flips {
            most_flips = count
        }
        if even {
            checksum += i64.fit(count)
        } else {
            checksum -= i64.fit(count)
        }
        even = not even
        loop {
            if rotated == n {
                return Outcome(checksum: checksum, most_flips: most_flips)
            }
            let head = permutation[0]
            for i in 0..<rotated {
                permutation[i] = permutation[i + 1]
            }
            permutation[rotated] = head
            counts[rotated] -= 1
            if counts[rotated] > 0 {
                break
            }
            rotated += 1
        }
    }
} fannkuch

fn main(take world: host::World) fails BenchError uses wait {
    let Some(n) = size(world.args) else {
        fail BenchError.Usage
    }
    let elements = usize.widen(n)
    if elements == 0 or elements > MOST {
        fail BenchError.Usage
    }
    let outcome = fannkuch(elements)
    var out = text::String.empty(world.alloc)
    mut out.write(text::fmt("{checksum} {most}\n", checksum: outcome.checksum, most: outcome.most_flips), budget: 64)
    let written = take out.into_bytes()
    try await world.stdio.write_out(written.view())
} main
