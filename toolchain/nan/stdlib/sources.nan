    \\
    \\test store_replaces_the_value_u32 for AtomicU32.store {
    \\    let value = AtomicU32.of(4)
    \\    value.store(5)
    \\    let loaded = value.load()
    \\    expect loaded == 5
    \\} store_replaces_the_value_u32
    \\
    \\pub open struct AtomicU64 {
    \\} AtomicU64
    \\
    \\pub fn AtomicU64.of(value: u64) -> AtomicU64 limits notrap, terminates, noalloc
    \\    example AtomicU64.of(4).load() == 4
    \\
    \\pub fn AtomicU64.load(self) -> u64 limits notrap, terminates, noalloc
    \\    example AtomicU64.of(4).load() == 4
    \\
    \\pub fn AtomicU64.store(self, value: u64) limits notrap, terminates, noalloc
    \\
    \\pub fn AtomicU64.swap(self, value: u64) -> u64 limits notrap, terminates, noalloc
    \\    example AtomicU64.of(4).swap(5) == 4
    \\
    \\pub fn AtomicU64.compare_swap(self, expected: u64, replacement: u64) -> Result[u64, u64] limits notrap, terminates, noalloc
    \\    example AtomicU64.of(4).compare_swap(4, replacement: 5) == Ok(4)
    \\
    \\pub fn AtomicU64.fetch_add(self, amount: u64) -> Option[u64] limits notrap, terminates, noalloc
    \\    example AtomicU64.of(~0u64).fetch_add(1) == None
    \\
    \\pub fn AtomicU64.fetch_sub(self, amount: u64) -> Option[u64] limits notrap, terminates, noalloc
    \\    example AtomicU64.of(4).fetch_sub(1) == Some(4)
    \\
    \\pub fn AtomicU64.fetch_and(self, mask: u64) -> u64 limits notrap, terminates, noalloc
    \\    example AtomicU64.of(6).fetch_and(3) == 6
    \\
    \\pub fn AtomicU64.fetch_or(self, mask: u64) -> u64 limits notrap, terminates, noalloc
    \\    example AtomicU64.of(6).fetch_or(3) == 6
    \\
    \\pub fn AtomicU64.fetch_xor(self, mask: u64) -> u64 limits notrap, terminates, noalloc
    \\    example AtomicU64.of(6).fetch_xor(3) == 6
    \\
    \\test store_replaces_the_value_u64 for AtomicU64.store {
    \\    let value = AtomicU64.of(4)
    \\    value.store(5)
    \\    let loaded = value.load()
    \\    expect loaded == 5
    \\} store_replaces_the_value_u64
    \\
    \\pub open struct AtomicUsize {
    \\} AtomicUsize
    \\
    \\pub fn AtomicUsize.of(value: usize) -> AtomicUsize limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(4).load() == 4
    \\
    \\pub fn AtomicUsize.load(self) -> usize limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(4).load() == 4
    \\
    \\pub fn AtomicUsize.store(self, value: usize) limits notrap, terminates, noalloc
    \\
    \\pub fn AtomicUsize.swap(self, value: usize) -> usize limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(4).swap(5) == 4
    \\
    \\pub fn AtomicUsize.compare_swap(self, expected: usize, replacement: usize) -> Result[usize, usize] limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(4).compare_swap(4, replacement: 5) == Ok(4)
    \\
    \\pub fn AtomicUsize.fetch_add(self, amount: usize) -> Option[usize] limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(~0usize).fetch_add(1) == None
    \\
    \\pub fn AtomicUsize.fetch_sub(self, amount: usize) -> Option[usize] limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(4).fetch_sub(1) == Some(4)
    \\
    \\pub fn AtomicUsize.fetch_and(self, mask: usize) -> usize limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(6).fetch_and(3) == 6
    \\
    \\pub fn AtomicUsize.fetch_or(self, mask: usize) -> usize limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(6).fetch_or(3) == 6
    \\
    \\pub fn AtomicUsize.fetch_xor(self, mask: usize) -> usize limits notrap, terminates, noalloc
    \\    example AtomicUsize.of(6).fetch_xor(3) == 6
    \\
    \\test store_replaces_the_value_usize for AtomicUsize.store {
    \\    let value = AtomicUsize.of(4)
    \\    value.store(5)
    \\    let loaded = value.load()
    \\    expect loaded == 5
    \\} store_replaces_the_value_usize
    \\
    \\pub open struct AtomicBool {
    \\} AtomicBool
    \\
    \\pub fn AtomicBool.of(value: bool) -> AtomicBool limits notrap, terminates, noalloc
    \\    example AtomicBool.of(true).load()
    \\
    \\pub fn AtomicBool.load(self) -> bool limits notrap, terminates, noalloc
    \\    example not AtomicBool.of(false).load()
    \\
    \\pub fn AtomicBool.store(self, value: bool) limits notrap, terminates, noalloc
    \\
