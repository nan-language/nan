//! The JSON format.

pub open struct Codec[T: Encode] {
} Codec

pub fn Codec.encode(value: T, mut out: text::String)

pub fn Codec.try_encode(value: T, mut out: text::String) fails mem::OutOfMemory

pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    example attempt Codec[u32].decode(Untrusted.of(b" 42 "), alloc: testing::world().alloc) == Ok(42)
    example attempt Codec[u32].decode(Untrusted.of(b"null"), alloc: testing::world().alloc) == Err(core::DecodeError.Malformed)

test encode_writes_compact_json for Codec.encode {
    var out = text::String.empty(testing::world().alloc)
    Codec[Option[u8]].encode(Some(3), mut out)
    expect out.as_str() == "{\"Some\":3}"
} encode_writes_compact_json

test try_encode_fails_without_memory for Codec.try_encode {
    let budget = testing::world().alloc.split(0)
    var out = text::String.empty(budget.alloc())
    let encoded = attempt Codec[bool].try_encode(true, mut out)
    take budget.close()
    expect encoded == Err(mem::OutOfMemory.Exhausted)
    expect out.is_empty()
} try_encode_fails_without_memory
