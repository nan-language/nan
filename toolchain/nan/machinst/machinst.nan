//! What the instruction sets share: their registers and sets of them, how an instruction accesses a register operand, what register allocation asks of an instruction, and the symbols and relocations of encoded code.

/// A register: a physical one by the number its instruction set gives it (below `PHYSICAL`), or
/// a virtual one, which register allocation replaces by a physical one.
pkg struct Reg derives Copy, Eq, Ord, Hash {
    pkg index: u32
} Reg

/// The number of physical register numbers.
pkg const PHYSICAL: u32 = 64

pkg fn Reg.virtual_number(number: u32) -> Reg {
    return Reg(index: PHYSICAL + number)
} Reg.virtual_number

pkg fn Reg.is_virtual(self) -> bool = self.index >= PHYSICAL

pkg fn Reg.is_physical(self) -> bool = self.index < PHYSICAL

/// The number of a virtual register.
pkg fn Reg.vreg(self) -> u32
    requires self.is_virtual()
{
    return self.index - PHYSICAL
} Reg.vreg

/// A set of physical registers.
pkg struct RegSet derives Copy, Eq {
    pkg bits: u64
} RegSet

pkg fn RegSet.empty() -> RegSet = RegSet(bits: 0)

pkg fn RegSet.of(reg: Reg) -> RegSet {
    return RegSet.empty().plus(reg)
} RegSet.of

pkg fn RegSet.plus(self, reg: Reg) -> RegSet {
    if reg.index >= PHYSICAL {
        return self
    }
    return RegSet(bits: self.bits | (1u64 << reg.index))
} RegSet.plus

pkg fn RegSet.union(self, other: RegSet) -> RegSet = RegSet(bits: self.bits | other.bits)

pkg fn RegSet.minus(self, other: RegSet) -> RegSet = RegSet(bits: self.bits & ~other.bits)

pkg fn RegSet.intersect(self, other: RegSet) -> RegSet = RegSet(bits: self.bits & other.bits)

pkg fn RegSet.contains(self, reg: Reg) -> bool {
    if reg.index >= PHYSICAL {
        return false
    }
    return (self.bits & (1u64 << reg.index)) != 0
} RegSet.contains

/// How an instruction accesses a register operand.
pkg enum Role derives Copy, Eq {
    /// Read before the instruction writes any register.
    Use
    /// Written after the instruction reads its uses.
    Def
    /// Read, then written.
    Mod
    /// Written before the instruction has read all its uses.
    EarlyDef
    /// Written and read only within the instruction.
    Temp
} Role

/// What register allocation and the removal of dead instructions ask of an instruction set's
/// instructions, and of its registers.
pkg interface MachInst {
    /// The instruction with each register operand replaced by what `visit` gives for it, visited
    /// in a fixed order. `visit` also sees the registers the instruction accesses implicitly;
    /// their replacements are ignored.
    fn map_regs(self, visit: fn(reg: Reg, role: Role) -> Reg) -> Self
    /// The registers the instruction changes beyond its operands.
    fn clobbers(self) -> RegSet
    /// Whether the instruction is a call, across which allocation may save the registers it
    /// clobbers.
    fn is_call(self) -> bool
    /// Whether the instruction only computes registers and flags.
    fn is_pure(self) -> bool
    fn reads_flags(self) -> bool
    /// Whether the instruction leaves the flags other than it found them.
    fn writes_flags(self) -> bool
    /// Whether a physical register is a floating-point one.
    fn is_float(reg: Reg) -> bool
    /// How many registers of a class allocation hands out.
    fn class_size(float: bool) -> u32
    /// The registers allocation hands out, by class in order of preference, `index` below the
    /// class's size.
    fn class_reg(float: bool, index: u32) -> Reg
    /// The registers a function must restore before it returns.
    fn callee_saved() -> RegSet
} MachInst

/// A symbol code refers to: a function or data object by its name, or the C library's
/// `__tls_get_addr`.
pkg enum Symbol derives Copy, Eq, Hash {
    Name(clif::ExternalName)
    TlsGetAddr
} Symbol

/// What a relocation writes at its offset. On x86-64: a 4- or 8-byte absolute address, a 4-byte
/// address relative to the end of the field, a call through the procedure linkage table, the
/// address of a global offset table entry, or the argument of a general-dynamic thread-local
/// access. On AArch64: the 26-bit branch of a `bl`, the page of a symbol or of its global offset
/// table entry for an `adrp`, the low 12 bits of a symbol's address for an `add` or of its entry's
/// for an `ldr`, an 8-byte absolute address, and the four fields of a thread-local descriptor
/// access.
pkg enum RelocKind derives Copy, Eq, Hash {
    Absolute4
    Absolute8
    Relative4
    CallPlt4
    GotRelative4
    TlsGeneralDynamic
    Arm64Call
    Arm64AdrPrel
    Arm64AddLo12
    Arm64Abs64
    Arm64AdrGotPage
    Arm64Ld64GotLo12
    Arm64TlsDescAdrPage
    Arm64TlsDescLd64Lo12
    Arm64TlsDescAddLo12
    Arm64TlsDescCall
} RelocKind

/// A relocation of encoded code: at `offset`, the value `kind` computes from the target's
/// address plus `addend`.
pkg struct Reloc derives Copy, Eq {
    pkg offset: u32
    pkg kind: RelocKind
    pkg target: Symbol
    pkg addend: i64
} Reloc
