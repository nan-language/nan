//! Raw gauge readings out of 1024 as percentages of full scale.

/// The percentage of full scale a raw reading stands for, saturating at 100.
pub fn percent(raw: u32) -> u32 {
    if raw >= 1_024 {
        return 100
    }
    return raw * 100 / 1_024
} percent

test half_scale_is_fifty_percent for percent {
    expect percent(512) == 50
    expect percent(4_096) == 100
} half_scale_is_fifty_percent
