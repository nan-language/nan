//! Paths as texts, joined and split as the system reads them.

/// `base` followed by `name`, a separator between them unless `base` is empty or ends with one;
/// `name` alone when it is absolute.
pkg fn join(base: Str, name: Str, alloc: mem::Alloc) -> text::String {
    if name.starts_with("/") or base.is_empty() {
        return text::String.of(name, alloc)
    }
    var joined = text::String.of(base, alloc)
    if not base.ends_with("/") {
        mut joined.push('/')
    }
    mut joined.append(name)
    return joined
} join

/// The path without its last component and the separators before it; none for the root and the
/// empty path, and empty for a single relative component.
pkg fn parent(path: Str, alloc: mem::Alloc) -> Option[text::String] {
    let bytes = path.as_bytes()
    let end = trimmed_end(bytes)
    if end == 0 or (end == 1 and bytes[0] == b'/') {
        return None
    }
    var cut = end
    while cut > 0 {
        invariant cut <= bytes.len()
        if bytes[cut - 1] == b'/' {
            break
        }
        cut -= 1
    }
    var stop = cut
    while stop > 1 {
        invariant stop <= bytes.len()
        if bytes[stop - 1] != b'/' {
            break
        }
        stop -= 1
    }
    let Some(above) = path.slice_bytes(0, end: stop) else {
        return None
    }
    return Some(text::String.of(above, alloc))
} parent

/// The last component of a path; none for the root, the empty path and a last component `.` or
/// `..`.
pkg fn file_name(path: Str, alloc: mem::Alloc) -> Option[text::String] {
    let bytes = path.as_bytes()
    let end = trimmed_end(bytes)
    var cut = end
    while cut > 0 {
        invariant cut <= bytes.len()
        if bytes[cut - 1] == b'/' {
            break
        }
        cut -= 1
    }
    let Some(last) = path.slice_bytes(cut, end: end) else {
        return None
    }
    if last.is_empty() or last == "." or last == ".." {
        return None
    }
    return Some(text::String.of(last, alloc))
} file_name

/// The end of a path's bytes before its trailing separators, a root's one kept.
fn trimmed_end(bytes: Slice[u8]) -> usize
    ensures result <= bytes.len()
{
    var end = bytes.len()
    loop {
        invariant end <= bytes.len()
        if end <= 1 or bytes[end - 1] != b'/' {
            return end
        }
        end -= 1
    }
} trimmed_end

/// What follows the components of `base` in `path`, compared component by component; none when
/// `base` is not a prefix of `path` that way.
pkg fn strip_prefix(path: Str, base: Str, alloc: mem::Alloc) -> Option[text::String] {
    let whole = path.as_bytes()
    let head = base.as_bytes()
    if path.starts_with("/") != base.starts_with("/") {
        return None
    }
    var at: usize = 0
    var from: usize = 0
    loop {
        let wanted = next_component(head, at: from)
        if wanted.start == head.len() {
            break
        }
        let found = next_component(whole, at)
        if found.start == whole.len() {
            return None
        }
        let Some(left) = path.slice_bytes(found.start, end: found.end) else {
            return None
        }
        let Some(right) = base.slice_bytes(wanted.start, end: wanted.end) else {
            return None
        }
        if left != right {
            return None
        }
        at = found.end
        from = wanted.end
    }
    let rest = next_component(whole, at)
    let end = trimmed_end(whole)
    if rest.start >= end {
        return Some(text::String.empty(alloc))
    }
    let Some(within) = path.slice_bytes(rest.start, end: end) else {
        return None
    }
    return Some(text::String.of(within, alloc))
} strip_prefix

/// The next component of a path from `at`, separators and `.` components skipped; empty at the
/// end of the path when there is none.
fn next_component(bytes: Slice[u8], at: usize) -> Run {
    var start = at
    loop {
        while start < bytes.len() and bytes[start] == b'/' {
            start += 1
        }
        if start == bytes.len() {
            return Run(start: start, end: start)
        }
        expect start < bytes.len()
        var end = start
        while end < bytes.len() and bytes[end] != b'/' {
            end += 1
        }
        if end != start + 1 or bytes[start] != b'.' {
            return Run(start: start, end: end)
        }
        start = end
    }
} next_component
