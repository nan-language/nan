//! The hardware operations interpreter runs reach on their one CPU, which has no maskable interrupts and no devices: user addresses, interrupt masking, signals, spin locks, shared devices bound to no vector, per-CPU values, and the simulated register blocks of `hw::sim` with the windows reaching them. A simulated block holds, for each register, a cell per array element or one cell, each holding its value's bits, its queue and its last written bits, which its windows and operations share.

/// The positions of a simulated block's parts: whether a window reaches it, its registers and
/// the cell its queues draw through.
const BLOCK_TAKEN: usize = 0

const BLOCK_REGISTERS: usize = 1

const BLOCK_CELL: usize = 2

/// The positions of a register cell's parts: its bits, its queue and its last written bits.
const CELL_HELD: usize = 0

const CELL_QUEUE: usize = 1

const CELL_LAST: usize = 2

/// A register of a block: the type of its values and its access kinds.
struct RegisterAccess derives Copy {
    ty: ty::Ty
    access: ast::Access
} RegisterAccess

/// A hardware operation an interpreter run can make; none for another.
fn Interpreter.hardware_member(
    mut self,
    owner: Str,
    member: Str,
    type_args: Slice[ty::Arg],
    args: Slice[Val],
    at: ItemSpan,
    site: RunSite,
    ) -> Option[InterpFlow] fails End {
    let alloc = self.alloc
    let option_item = self.ty_item("core", name: "Option")
    if owner == "hw::UserAddr" and member == "of" {
        let item = self.ty_item("hw", name: "UserAddr")
        return Some(InterpFlow.Return(Val.Struct(item: item, fields: mem::Shared.of(Val.single(args[0].copy(alloc), alloc), alloc))))
    }
    if owner == "hw::UserAddr" and member == "value" {
        let address = self.deref(args[0])
        return Some(InterpFlow.Return(address.fields()[0].copy(alloc)))
    }
    if owner == "hw::cpu_count" and member.is_empty() {
        return Some(InterpFlow.Return(Val.Int(wide::Wide.one())))
    }
    if owner == "hw::fence" and member.is_empty() {
        return Some(InterpFlow.Return(Val.Unit))
    }
    if owner == "hw::without_irqs" and member.is_empty() {
        let token = Val.Struct(item: self.ty_item("hw", name: "IrqsDisabled"), fields: mem::Shared.of(mem::List[Val].empty(alloc), alloc))
        return Some(try mut self.call_value(args[0], args: Val.single(take token, alloc), at, site))
    }
    if owner == "hw::Signal" and member == "empty" {
        let held = mut self.memory.alloc(Val.Absent, writable: true, size: 0)
        return Some(InterpFlow.Return(Val.Struct(item: self.ty_item("hw", name: "Signal"), fields: mem::Shared.of(Val.single(Val.extent_ref(held, alloc), alloc), alloc))))
    }
    if owner == "hw::Signal" and member == "post" {
        let signal = self.deref(args[0])
        let slot = signal.fields()[0].place().copy(alloc)
        let stored = self.memory.get(slot).copy(alloc)
        mut self.native_release(stored)
        mut self.memory.set(slot, stored: args[2].copy(alloc))
        return Some(InterpFlow.Return(Val.Unit))
    }
    let locks = owner == "hw::SpinLock" or owner == "hw::IrqShared"
    if locks and (member == "of" or member == "install") {
        let held = mut self.memory.alloc(args[0].copy(alloc), writable: true, size: 0)
        let Some(separator) = owner.find("::") else {
            expect false
            return None
        }
        let Some(module) = owner.slice_bytes(0, end: separator) else {
            expect false
            return None
        }
        let Some(name) = owner.slice_bytes(separator + 2, end: owner.byte_len()) else {
            expect false
            return None
        }
        return Some(InterpFlow.Return(Val.Struct(item: self.ty_item(module, name), fields: mem::Shared.of(Val.single(Val.extent_ref(held, alloc), alloc), alloc))))
    }
    if (locks or owner == "hw::PerCpu") and member == "with" {
        let wrapper = self.deref(args[0])
        let contents = wrapper.fields()[0].copy(alloc)
        return Some(try mut self.call_value(args[2], args: Val.single(take contents, alloc), at, site))
    }
    if owner == "hw::IrqShared" and member == "uninstall" {
        let wrapper = self.deref(args[0])
        return Some(InterpFlow.Return(self.deref(wrapper.fields()[0])))
    }
    if owner == "hw::PerCpu" and member == "of" {
        let flow = try mut self.call_value(args[0], args: Val.single(Val.Int(wide::Wide.zero()), alloc), at, site)
        let InterpFlow.Return(initial) = flow else {
            return Some(take flow)
        }
        let held = mut self.memory.alloc(take initial, writable: true, size: 0)
        return Some(InterpFlow.Return(Val.Struct(item: self.ty_item("hw", name: "PerCpu"), fields: mem::Shared.of(Val.single(Val.extent_ref(held, alloc), alloc), alloc))))
    }
    if owner == "hw::sim::Registers" {
        return try mut self.registers_member(member, type_args, args, at, option_item)
    }
    if owner == "hw::Mmio" or owner == "hw::Ports" {
        return try mut self.window_member(member, type_args, args, at)
    }
    return None
} Interpreter.hardware_member

fn Val.extent_ref(extent: u32, alloc: mem::Alloc) -> Val {
    return Val.Ref(Loc(extent: extent, path: mem::List[u32].empty(alloc)))
} Val.extent_ref

/// Calls a function value with arguments.
fn Interpreter.call_value(mut self, function: Val, take args: mem::List[Val], at: ItemSpan, site: RunSite) -> InterpFlow fails End {
    let callee = self.deref(function)
    let Val.Fn(shared) = callee else {
        expect false
        fail End.Missing
    }
    return try mut self.invoke(shared.contents(), take args, at, site)
} Interpreter.call_value

/// The registers block a sim or window's first type argument names.
fn Interpreter.block_of(self, type_args: Slice[ty::Arg]) -> ty::ItemId {
    if type_args.len() > 0 {
        match type_args[0].ty() {
            Some(leading) => match self.ck.types().kind(leading) {
                ty::TyKind.Registers(block) => return block
                else => {}
            }
            None => {}
        }
    }
    expect false
    return ty::ItemId(index: 0)
} Interpreter.block_of

/// The type and access kinds of each register of a block, in declaration order.
fn Interpreter.registers_of(self, block: ty::ItemId) -> mem::List[RegisterAccess] {
    var accesses = mem::List[RegisterAccess].empty(self.alloc)
    let sig = self.ck.sig(block)
    match sig.contents().kind {
        SigKind.Registers(members: members) => {
            for register in members {
                mut accesses.push(RegisterAccess(ty: register.ty, access: register.access))
            }
        }
        else => {
            expect false
        }
    }
    return accesses
} Interpreter.registers_of

/// The type of a register's values, of its elements for an indexed access.
fn Interpreter.element_ty(self, ty: ty::Ty, indexed: bool) -> ty::Ty {
    if not indexed {
        return ty
    }
    let types = self.ck.types()
    match types.kind(ty) {
        ty::TyKind.Item(item: _, args: args) => {
            let listed = types.arg_list(args)
            if listed.len() > 0 {
                match listed[0].ty() {
                    Some(element) => return element
                    None => {}
                }
            }
            return ty::Ty.unit()
        }
        else => return ty
    }
} Interpreter.element_ty

/// The place of a simulated block's state.
fn Interpreter.sim_state(self, sim: Val) -> Loc {
    let sim_value = self.deref(sim)
    return sim_value.fields()[0].place().copy(self.alloc)
} Interpreter.sim_state

/// The place of a register's cell, none past its elements.
fn Interpreter.register_cell(self, state: Loc, register: usize, index: usize) -> Option[Loc] {
    let alloc = self.alloc
    let cells = state.with(u32.fit(BLOCK_REGISTERS), alloc).with(u32.fit(register), alloc)
    if index < self.memory.get(cells).fields().len() {
        return Some(cells.with(u32.fit(index), alloc))
    }
    return None
} Interpreter.register_cell

/// The bits of a value of an `AnyBits` type.
fn Interpreter.value_bits(self, value: Val) -> wide::Wide {
    match value {
        Val.Struct(item: layout_item, fields: _) or Val.Variant(item: layout_item, index: _, fields: _) => return wide::Wide.of_u64(self.layout_bits(layout_item, value))
        Val.Float32(_) => return wide::Wide.of_u64(value.scalar_bits(ty::Scalar.Float32))
        Val.Float64(_) => return wide::Wide.of_u64(value.scalar_bits(ty::Scalar.Float64))
        else => return value.int_value()
    }
} Interpreter.value_bits

/// The value of an `AnyBits` type with bits.
fn Interpreter.value_of_bits(self, ty: ty::Ty, bits: u64) -> Val {
    match self.ck.types().kind(ty) {
        ty::TyKind.Scalar(scalar) => match Val.from_scalar_bits(bits, scalar) {
            Some(found) => return found
            None => {}
        }
        ty::TyKind.Item(item: layout_item, args: _) => match self.layout_value(layout_item, bits) {
            Some(found) => return found
            None => {}
        }
        else => {}
    }
    expect false
    return Val.Absent
} Interpreter.value_of_bits

/// An operation of a simulated register block: its windows, and `set`, `queue` and
/// `last_written` of a register or element; none for another.
fn Interpreter.registers_member(mut self, member: Str, type_args: Slice[ty::Arg], args: Slice[Val], at: ItemSpan, option_item: ty::ItemId) -> Option[InterpFlow] fails End {
    let alloc = self.alloc
    if member == "of" {
        return Some(InterpFlow.Return(mut self.new_sim(type_args, args)))
    }
    if member == "mmio" or member == "ports" {
        let state = self.sim_state(args[0])
        let taken = state.with(u32.fit(BLOCK_TAKEN), alloc)
        if self.memory.get(taken).bool_value() {
            fail self.trap("trap.duplicate-access", at)
        }
        mut self.memory.set(taken, stored: Val.Bool(true))
        let name = if member == "mmio" {
            "Mmio"
        } else {
            "Ports"
        }
        return Some(InterpFlow.Return(Val.Struct(item: self.ty_item("hw", name), fields: mem::Shared.of(Val.single(Val.Ref(take state), alloc), alloc))))
    }
    let state = self.sim_state(args[0])
    let block = self.block_of(type_args)
    let register = usize.widen(args[1].int_value().low_bits())
    let indexed = member.ends_with("_at")
    var index: usize = 0
    if indexed {
        index = usize.widen(args[2].int_value().low_bits())
    }
    let Some(cell) = self.register_cell(state, register, index) else {
        fail self.trap("trap.bounds", at)
    }
    let accesses = self.registers_of(block)
    let element = self.element_ty(accesses[register].ty, indexed)
    if names_operation(member, operation: "set") {
        let given = self.deref(args[args.len() - 1])
        mut self.memory.set(cell.with(u32.fit(CELL_HELD), alloc), stored: Val.Int(self.value_bits(given)))
        return Some(InterpFlow.Return(Val.Unit))
    }
    if names_operation(member, operation: "queue") {
        let sim_cell = u32.truncate(self.memory.get(state.with(u32.fit(BLOCK_CELL), alloc)).int_value().low_bits())
        let Some(_) = mut self.budgets.allocate(sim_cell, size: 8, align: 8) else {
            fail self.trap("trap.exhausted", at)
        }
        let given = self.deref(args[args.len() - 1])
        let bits = self.value_bits(given)
        let queue = cell.with(u32.fit(CELL_QUEUE), alloc)
        var queued = Val.copies(self.memory.get(queue).fields(), alloc)
        mut queued.push(Val.Int(bits))
        mut self.memory.set(queue, stored: Val.Array(mem::Shared.of(take queued, alloc)))
        return Some(InterpFlow.Return(Val.Unit))
    }
    if names_operation(member, operation: "last_written") {
        let last = self.memory.get(cell.with(u32.fit(CELL_LAST), alloc)).copy(alloc)
        if last.is_absent() {
            return Some(InterpFlow.Return(Val.none(option_item, alloc)))
        }
        let value = self.value_of_bits(element, bits: last.int_value().low_bits())
        return Some(InterpFlow.Return(Val.some(option_item, take value, alloc)))
    }
    return None
} Interpreter.registers_member

/// A new simulated register block: each register's cells, its queues drawing through the
/// allocator `args[0]` names.
fn Interpreter.new_sim(mut self, type_args: Slice[ty::Arg], args: Slice[Val]) -> Val {
    let alloc = self.alloc
    let block = self.block_of(type_args)
    var cells_of = mem::List[Val].empty(alloc)
    for register in self.registers_of(block) {
        var count: usize = 1
        let types = self.ck.types()
        match types.kind(register.ty) {
            ty::TyKind.Item(item: _, args: register_args) => {
                let listed = types.arg_list(register_args)
                if listed.len() > 1 {
                    match listed[1] {
                        ty::Arg.Const(ty::Const.Int(held)) => {
                            count = usize.widen(held.low_bits())
                        }
                        else => {}
                    }
                }
            }
            else => {}
        }
        var cells = mem::List[Val].empty(alloc)
        for _ in 0..<count {
            var parts = mem::List[Val].empty(alloc)
            mut parts.push(Val.Int(wide::Wide.zero()))
            mut parts.push(Val.Array(mem::Shared.of(mem::List[Val].empty(alloc), alloc)))
            mut parts.push(Val.Absent)
            mut cells.push(Val.Array(mem::Shared.of(take parts, alloc)))
        }
        mut cells_of.push(Val.Array(mem::Shared.of(take cells, alloc)))
    }
    let cell = self.cell_of(args[0])
    var state = mem::List[Val].empty(alloc)
    mut state.push(Val.Bool(false))
    mut state.push(Val.Array(mem::Shared.of(take cells_of, alloc)))
    mut state.push(Val.Int(wide::Wide.of_u64(u64.widen(cell))))
    let held = mut self.memory.alloc(Val.Array(mem::Shared.of(take state, alloc)), writable: true, size: 0)
    let item = self.ty_item("hw::sim", name: "Registers")
    return Val.Struct(item: item, fields: mem::Shared.of(Val.single(Val.extent_ref(held, alloc), alloc), alloc))
} Interpreter.new_sim

/// A read or write through a register window, or its `unmap`; none for another member or a
/// window of no simulated block.
fn Interpreter.window_member(mut self, member: Str, type_args: Slice[ty::Arg], args: Slice[Val], at: ItemSpan) -> Option[InterpFlow] fails End {
    let alloc = self.alloc
    let window = self.deref(args[0])
    let reaches_sim = window.fields().len() > 0 and is_ref(window.fields()[0])
    if member == "unmap" {
        if reaches_sim {
            return Some(InterpFlow.Return(Val.Unit))
        }
        return None
    }
    if member != "read" and member != "write" and member != "read_at" and member != "write_at" {
        return None
    }
    if not reaches_sim {
        return None
    }
    let state = window.fields()[0].place().copy(alloc)
    let block = self.block_of(type_args)
    let register = usize.widen(args[1].int_value().low_bits())
    let indexed = member.ends_with("_at")
    var index: usize = 0
    if indexed {
        index = usize.widen(args[2].int_value().low_bits())
    }
    let Some(cell) = self.register_cell(state, register, index) else {
        fail self.trap("trap.bounds", at)
    }
    let accesses = self.registers_of(block)
    let access = accesses[register]
    let element = self.element_ty(access.ty, indexed)
    if names_operation(member, operation: "read") {
        let queue = cell.with(u32.fit(CELL_QUEUE), alloc)
        var queued = Val.copies(self.memory.get(queue).fields(), alloc)
        var bits = wide::Wide.zero()
        if queued.len() == 0 {
            bits = self.memory.get(cell.with(u32.fit(CELL_HELD), alloc)).int_value()
        } else {
            let oldest = mut queued.remove(0)
            bits = oldest.int_value()
            mut self.memory.set(queue, stored: Val.Array(mem::Shared.of(take queued, alloc)))
        }
        return Some(InterpFlow.Return(self.value_of_bits(element, bits: bits.low_bits())))
    }
    let written = self.deref(args[args.len() - 1])
    let bits = self.value_bits(written)
    let held = cell.with(u32.fit(CELL_HELD), alloc)
    var kept = bits
    if access.access == ast::Access.WriteOneClear {
        kept = self.memory.get(held).int_value().bit_and(bits.bit_not())
    }
    mut self.memory.set(held, stored: Val.Int(kept))
    mut self.memory.set(cell.with(u32.fit(CELL_LAST), alloc), stored: Val.Int(bits))
    return Some(InterpFlow.Return(Val.Unit))
} Interpreter.window_member

/// Whether a member is an operation, or its indexed form written with `_at`.
fn names_operation(member: Str, operation: Str) -> bool {
    if member == operation {
        return true
    }
    return member.byte_len() == operation.byte_len() + 3 and member.starts_with(operation) and member.ends_with("_at")
} names_operation

/// Whether a value is a reference.
fn is_ref(value: Val) -> bool {
    match value {
        Val.Ref(_) => return true
        else => return false
    }
} is_ref
