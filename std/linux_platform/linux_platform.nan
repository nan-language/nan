//! The host entry landing fn and the submission of operations to the executor's io_uring.

/// One io_uring submission queue entry, which `submit` hands to the ring of the thread running
/// the task.
pkg layout Entry: bytes 64 le {
    opcode: u8 at 0
    flags: u8 at 1
    priority: u16 at 2
    fd: i32 at 4
    offset: u64 at 8
    address: u64 at 16
    len: u32 at 24
    op_flags: u32 at 28
    user_data: u64 at 32
    buffer_index: u16 at 40
    personality: u16 at 42
    file_index: u32 at 44
    address3: u64 at 48
    padding: u64 at 56
} Entry

/// Submits an operation on the io_uring of the executor thread running the task and returns
/// the result its completion carries, a negative error number on failure. Cancelling it
/// cancels the operation in flight and returns only once the kernel acknowledges.
pkg fn submit(entry: Entry) -> i32 fails task::Cancelled uses wait

pkg const OP_READ: u8 = 22

pkg const OP_WRITE: u8 = 23

pkg const OP_TIMEOUT: u8 = 11

pkg const OP_ACCEPT: u8 = 13

pkg const OP_CONNECT: u8 = 16

pkg const OP_STATX: u8 = 21

pkg const OP_SEND: u8 = 26

pkg const OP_RECV: u8 = 27

pkg const OP_OPENAT2: u8 = 28

pkg const OP_SHUTDOWN: u8 = 34

pkg const OP_UNLINKAT: u8 = 36

pkg const OP_MKDIRAT: u8 = 37

pkg const ENOENT: i32 = 2

pkg const EINTR: i32 = 4

pkg const EAGAIN: i32 = 11

pkg const EEXIST: i32 = 17

pkg const ETIME: i32 = 62

pkg const ECANCELED: i32 = 125

/// The entry of an operation `opcode` on `fd` with its address, length and offset, every other field zero.
pkg fn operation(
    opcode: u8,
    fd: i32,
    address: u64,
    len: u32,
    offset: u64,
    ) -> Entry {
    return Entry(
        opcode: opcode,
        flags: 0,
        priority: 0,
        fd: fd,
        offset: offset,
        address: address,
        len: len,
        op_flags: 0,
        user_data: 0,
        buffer_index: 0,
        personality: 0,
        file_index: 0,
        address3: 0,
        padding: 0,
    )
} operation

/// The address of a view's first byte.
pkg fn address_of(bytes: Slice[u8]) -> u64 {
    return u64.widen(hw::Ptr.of_view(bytes).addr())
} address_of

/// The host entry landing fn: mints the root grant and gives it the program's arguments and
/// environment, as Untrusted byte strings.
pub landing fn enter(count: i32, arguments: hw::Ptr[hw::Ptr[u8]], environment: hw::Ptr[hw::Ptr[u8]]) -> host::World limits stack 65_536 {
    var world = hw::mint_root()
    let alloc = world.alloc
    var args = mem::List[mem::Bytes].empty(alloc)
    var index: isize = 1
    while index < isize.widen(count) {
        let text = trusted "the C library passes `count` arguments, each a NUL-terminated text" { arguments.offset(index).read() }
        mut args.push(c_bytes(text, alloc))
        index += 1
    }
    world.args = Untrusted.of(take args)
    var variables = mem::Map[mem::Bytes, mem::Bytes].empty(alloc)
    var at: isize = 0
    loop {
        let text = trusted "the environment is a list of NUL-terminated texts ending with a zero address" { environment.offset(at).read() }
        if text.addr() == 0 {
            break
        }
        add_variable(mut variables, text: c_bytes(text, alloc), alloc)
        at += 1
    }
    world.environment = Untrusted.of(take variables)
    return world
} enter

/// The bytes of a NUL-terminated text, without the NUL.
fn c_bytes(text: hw::Ptr[u8], alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    var at: isize = 0
    loop {
        let byte = trusted "the text ends with a NUL" { text.offset(at).read() }
        if byte == 0 {
            return bytes
        }
        mut bytes.push(byte)
        at += 1
    }
} c_bytes

/// Adds a `NAME=value` environment entry, a text without `=` naming an empty value.
fn add_variable(mut variables: mem::Map[mem::Bytes, mem::Bytes], take text: mem::Bytes, alloc: mem::Alloc) {
    let view = text.view()
    var split = view.len()
    for at in 0..<view.len() {
        if view[at] == b'=' and split == view.len() {
            split = at
        }
    }
    var name = mem::Bytes.empty(alloc)
    var value = mem::Bytes.empty(alloc)
    for at in 0..<view.len() {
        if at < split {
            mut name.push(view[at])
        } else if at > split {
            mut value.push(view[at])
        }
    }
    discard mut variables.insert(take name, take value)
} add_variable
