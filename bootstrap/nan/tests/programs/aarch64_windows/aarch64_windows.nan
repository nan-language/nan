//! An AArch64 Windows program, which runs under Wine on an AArch64 machine.

fn depth(level: u64) -> u64 {
    if level == 0 {
        return 0
    }
    return depth(level + 1) + 1
} depth

fn main(take world: host::World) fails task::Cancelled uses wait {
    try await world.clock.sleep(10)
    let overflowed = try await sys::Domain.run(fn() -> u64 {
        return depth(1)
    }, exec: world.exec, alloc: world.alloc)
    match overflowed {
        Ok(_) => world.log.info("overflow returned", value: true)
        Err(trap) => world.log.info("overflow kind", value: trap.kind())
    }
} main
