//! Simulated register blocks.

pub open struct Registers[R] derives Copy, Send {
} Registers

pub fn Registers.of(alloc: mem::Alloc) -> Registers[R]
    example Registers[Probe].of(testing::world().alloc).last_written(Probe.status) == None

pub fn Registers.mmio(self) -> hw::Mmio[R]

pub fn Registers.ports(self) -> hw::Ports[R]

pub fn Registers.set[T: AnyBits](self, register: hw::Register[R, T], value: T)

pub fn Registers.queue[T: AnyBits](self, register: hw::Register[R, T], value: T)

pub fn Registers.last_written[T: AnyBits](self, register: hw::Register[R, T]) -> Option[T]
    example Registers[Probe].of(testing::world().alloc).last_written(Probe.control) == None

pub fn Registers.set_at[E: AnyBits, N: usize](self, register: hw::Register[R, Array[E, N]], index: usize, value: E)

pub fn Registers.queue_at[E: AnyBits, N: usize](self, register: hw::Register[R, Array[E, N]], index: usize, value: E)

pub fn Registers.last_written_at[E: AnyBits, N: usize](self, register: hw::Register[R, Array[E, N]], index: usize) -> Option[E]
    example Registers[Probe].of(testing::world().alloc).last_written_at(Probe.slots, index: 3) == None

registers Probe {
    status: u8 at 0x0 read write
    control: u16 at 0x2 read write
    pending: u32 at 0x4 write_one_clear
    slots: Array[u32, 4] at 0x10 stride 4 read write
} Probe

test mmio_window_reads_a_fresh_block_as_zero for Registers.mmio {
    let regs = Registers[Probe].of(testing::world().alloc)
    var window = regs.mmio()
    let control = mut window.read(Probe.control)
    let slot = mut window.read_at(Probe.slots, index: 2)
    take window.unmap()
    expect control == 0
    expect slot == 0
} mmio_window_reads_a_fresh_block_as_zero

test ports_reach_the_same_block for Registers.ports {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set(Probe.control, value: 0x0102)
    var window = regs.ports()
    let control = mut window.read(Probe.control)
    take window.unmap()
    expect control == 0x0102
} ports_reach_the_same_block

test set_replaces_the_held_value for Registers.set {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set(Probe.status, value: 9)
    var window = regs.mmio()
    let status = mut window.read(Probe.status)
    take window.unmap()
    expect status == 9
    expect regs.last_written(Probe.status) == None
} set_replaces_the_held_value

test queued_values_come_before_the_held_one for Registers.queue {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set(Probe.status, value: 1)
    regs.queue(Probe.status, value: 7)
    regs.queue(Probe.status, value: 8)
    var window = regs.mmio()
    let oldest = mut window.read(Probe.status)
    let newest = mut window.read(Probe.status)
    let held = mut window.read(Probe.status)
    take window.unmap()
    expect oldest == 7
    expect newest == 8
    expect held == 1
} queued_values_come_before_the_held_one

test last_written_records_writes for Registers.last_written {
    let regs = Registers[Probe].of(testing::world().alloc)
    var window = regs.mmio()
    mut window.write(Probe.control, value: 3)
    mut window.write(Probe.control, value: 4)
    take window.unmap()
    expect regs.last_written(Probe.control) == Some(4)
} last_written_records_writes

test set_at_replaces_one_element for Registers.set_at {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set_at(Probe.slots, index: 2, value: 40)
    var window = regs.mmio()
    let set = mut window.read_at(Probe.slots, index: 2)
    let other = mut window.read_at(Probe.slots, index: 1)
    take window.unmap()
    expect set == 40
    expect other == 0
} set_at_replaces_one_element

test queue_at_feeds_one_element for Registers.queue_at {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.queue_at(Probe.slots, index: 0, value: 3)
    var window = regs.mmio()
    let queued = mut window.read_at(Probe.slots, index: 0)
    let held = mut window.read_at(Probe.slots, index: 0)
    take window.unmap()
    expect queued == 3
    expect held == 0
} queue_at_feeds_one_element

test last_written_at_records_element_writes for Registers.last_written_at {
    let regs = Registers[Probe].of(testing::world().alloc)
    var window = regs.mmio()
    mut window.write_at(Probe.slots, index: 1, value: 6)
    take window.unmap()
    expect regs.last_written_at(Probe.slots, index: 1) == Some(6)
    expect regs.last_written_at(Probe.slots, index: 0) == None
} last_written_at_records_element_writes

test mmio_read_returns_the_held_value for hw::Mmio.read {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set(Probe.control, value: 0x0304)
    var window = regs.mmio()
    let control = mut window.read(Probe.control)
    take window.unmap()
    expect control == 0x0304
} mmio_read_returns_the_held_value

test mmio_write_clears_the_ones_written for hw::Mmio.write {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set(Probe.pending, value: 0b1011)
    var window = regs.mmio()
    mut window.write(Probe.pending, value: 0b0010)
    let pending = mut window.read(Probe.pending)
    take window.unmap()
    expect pending == 0b1001
    expect regs.last_written(Probe.pending) == Some(0b0010)
} mmio_write_clears_the_ones_written

test mmio_read_at_reads_one_element for hw::Mmio.read_at {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set_at(Probe.slots, index: 3, value: 12)
    var window = regs.mmio()
    let slot = mut window.read_at(Probe.slots, index: 3)
    take window.unmap()
    expect slot == 12
} mmio_read_at_reads_one_element

test mmio_write_at_writes_one_element for hw::Mmio.write_at {
    let regs = Registers[Probe].of(testing::world().alloc)
    var window = regs.mmio()
    mut window.write_at(Probe.slots, index: 2, value: 21)
    let slot = mut window.read_at(Probe.slots, index: 2)
    let other = mut window.read_at(Probe.slots, index: 3)
    take window.unmap()
    expect slot == 21
    expect other == 0
} mmio_write_at_writes_one_element

test mmio_unmap_keeps_the_block for hw::Mmio.unmap {
    let regs = Registers[Probe].of(testing::world().alloc)
    var window = regs.mmio()
    mut window.write(Probe.status, value: 2)
    take window.unmap()
    expect regs.last_written(Probe.status) == Some(2)
} mmio_unmap_keeps_the_block

test ports_read_returns_the_held_value for hw::Ports.read {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set(Probe.status, value: 0x41)
    var window = regs.ports()
    let status = mut window.read(Probe.status)
    take window.unmap()
    expect status == 0x41
} ports_read_returns_the_held_value

test ports_write_clears_the_ones_written for hw::Ports.write {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set(Probe.pending, value: 0b0110)
    var window = regs.ports()
    mut window.write(Probe.pending, value: 0b0100)
    let pending = mut window.read(Probe.pending)
    take window.unmap()
    expect pending == 0b0010
} ports_write_clears_the_ones_written

test ports_read_at_reads_one_element for hw::Ports.read_at {
    let regs = Registers[Probe].of(testing::world().alloc)
    regs.set_at(Probe.slots, index: 1, value: 5)
    var window = regs.ports()
    let slot = mut window.read_at(Probe.slots, index: 1)
    take window.unmap()
    expect slot == 5
} ports_read_at_reads_one_element

test ports_write_at_writes_one_element for hw::Ports.write_at {
    let regs = Registers[Probe].of(testing::world().alloc)
    var window = regs.ports()
    mut window.write_at(Probe.slots, index: 0, value: 17)
    take window.unmap()
    expect regs.last_written_at(Probe.slots, index: 0) == Some(17)
} ports_write_at_writes_one_element

test ports_unmap_keeps_the_block for hw::Ports.unmap {
    let regs = Registers[Probe].of(testing::world().alloc)
    var window = regs.ports()
    mut window.write(Probe.control, value: 8)
    take window.unmap()
    expect regs.last_written(Probe.control) == Some(8)
} ports_unmap_keeps_the_block
