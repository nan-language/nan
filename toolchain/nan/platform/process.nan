//! Programs started as child processes with their arguments, this process's environment, their standard streams and their working directory, waited for to their end or ended; and this process replaced by a program.

/// The flags of `posix_spawnattr_setflags` setting the signals a started program finds at their
/// default action, and its signal mask.
const POSIX_SPAWN_SETSIGDEF: i16 = 0x4

const POSIX_SPAWN_SETSIGMASK: i16 = 0x8

/// How `pthread_sigmask` changes the calling thread's signal mask.
const SIG_UNBLOCK: i32 = 1

const SIG_SETMASK: i32 = 2

const SIGKILL: i32 = 9

const SIGPIPE: i32 = 13

/// The bit standing for `SIGPIPE`, and those standing for the termination request signals
/// `SIGHUP`, `SIGINT` and `SIGTERM`, in the first word of a `sigset_t`.
const SIGPIPE_SET: u64 = 0x1000

const TERMINATION_SET: u64 = 0x4003

/// The option of `waitpid` returning at once while the process runs.
const WNOHANG: i32 = 1

/// The events of `poll`: data to read, and room to write.
const POLLIN: u64 = 0x1

const POLLOUT: u64 = 0x4

const CLOCK_MONOTONIC: i32 = 1

/// The most bytes one write passes to a pipe: a pipe `poll` finds writable takes them whole.
const PIPE_CHUNK: usize = 4_096

/// The most bytes one read takes from a pipe.
const PIPE_READ: usize = 65_536

foreign fn pipe2(fds: hw::Ptr[i32], flags: i32) -> i32 convention "sysv"

foreign fn poll(fds: hw::Ptr[u64], count: u64, timeout: i32) -> i32 convention "sysv"

foreign fn waitpid(pid: i32, wstatus: hw::Ptr[i32], options: i32) -> i32 convention "sysv"

foreign fn kill(pid: i32, number: i32) -> i32 convention "sysv"

foreign fn execv(path: hw::Ptr[u8], argv: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn pthread_sigmask(how: i32, set: hw::Ptr[u64], previous: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn signal(number: i32, handler: hw::Ptr[u8]) -> hw::Ptr[u8] convention "sysv"

foreign fn clock_gettime(clock: i32, time: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn sched_getaffinity(pid: i32, size: usize, mask: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn posix_spawnp(pid: hw::Ptr[i32], file: hw::Ptr[u8], actions: hw::Ptr[u64], attributes: hw::Ptr[u64], argv: hw::Ptr[u64], envp: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn posix_spawn_file_actions_init(actions: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn posix_spawn_file_actions_destroy(actions: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn posix_spawn_file_actions_adddup2(actions: hw::Ptr[u64], fd: i32, target: i32) -> i32 convention "sysv"

foreign fn posix_spawn_file_actions_addopen(actions: hw::Ptr[u64], fd: i32, path: hw::Ptr[u8], flags: i32, mode: u32) -> i32 convention "sysv"

foreign fn posix_spawn_file_actions_addchdir_np(actions: hw::Ptr[u64], path: hw::Ptr[u8]) -> i32 convention "sysv"

foreign fn posix_spawnattr_init(attributes: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn posix_spawnattr_destroy(attributes: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn posix_spawnattr_setflags(attributes: hw::Ptr[u64], flags: i16) -> i32 convention "sysv"

foreign fn posix_spawnattr_setsigmask(attributes: hw::Ptr[u64], mask: hw::Ptr[u64]) -> i32 convention "sysv"

foreign fn posix_spawnattr_setsigdefault(attributes: hw::Ptr[u64], defaults: hw::Ptr[u64]) -> i32 convention "sysv"

/// How a process ended: the status it exited with, or the number of the signal that ended it.
pkg enum Status derives Copy, Eq {
    Exited(i32)
    Signalled(i32)
} Status

/// Whether a process exited with status 0.
pkg fn Status.is_success(self) -> bool = self == Status.Exited(0)

/// What a program wrote to the pipes of its standard output and error, and how it ended.
pkg struct Output {
    pkg status: Status
    pkg stdout: mem::Bytes
    pkg stderr: mem::Bytes
} Output

/// What a standard stream of a program started is: this process's own, the null device, or a
/// pipe to this process.
enum Stream derives Copy, Eq {
    Inherited
    Null
    Piped
} Stream

/// The standard input, output and error of a program started.
struct Streams derives Copy {
    input: Stream
    out: Stream
    err: Stream
} Streams

/// A program started as a child of this process: its process id and this process's ends of the
/// pipes of its standard input, output and error, -1 for a stream without a pipe or once closed.
struct Child derives Copy {
    pid: i32
    input: i32
    out: i32
    err: i32
} Child

/// The descriptors of the pipes a program starts with: this process's end and the program's end
/// of each standard stream it pipes, -1 for one it does not.
struct Ends derives Copy {
    input: i32
    input_far: i32
    out: i32
    out_far: i32
    err: i32
    err_far: i32
} Ends

/// A pipe's descriptors: the end reading it and the end writing it.
struct Pipe derives Copy {
    reading: i32
    writing: i32
} Pipe

/// What a started program has written to the pipes of its standard output and error, how many
/// bytes of its input it has been given, and the bytes one read takes.
struct Gathered {
    stdout: mem::Bytes
    stderr: mem::Bytes
    written: usize
    scratch: mem::Bytes
} Gathered

fn Gathered.empty(alloc: mem::Alloc) -> Gathered {
    return Gathered(stdout: mem::Bytes.empty(alloc), stderr: mem::Bytes.empty(alloc), written: 0, scratch: mem::Bytes.zeroed(PIPE_READ, alloc))
} Gathered.empty

/// Runs a program the `PATH` finds, a name holding `/` being its path, given its arguments after
/// its name, to its end: its standard input a pipe fed `input` and then closed, or the null device
/// for none; its standard output captured; its standard error captured, or the null device unless
/// `capture_errors`. It starts with no signal blocked and `SIGPIPE` at its default action.
pkg fn run_output(program: Str, args: Slice[text::String], take input: Option[mem::Bytes], capture_errors: bool, alloc: mem::Alloc) -> Output fails IoError {
    var streams = Streams(input: Stream.Null, out: Stream.Piped, err: Stream.Null)
    if input.is_some() {
        streams.input = Stream.Piped
    }
    let given = input_bytes(take input, alloc)
    if capture_errors {
        streams.err = Stream.Piped
    }
    var child = try spawn(program, args, streams, dir: None, alloc)
    var gathered = Gathered.empty(alloc)
    loop {
        let pumped = attempt mut child.pump(mut gathered, input: given.view(), timeout: -1)
        match pumped {
            Ok(true) => break
            Ok(false) => {}
            Err(error) => {
                mut child.close_all()
                fail error
            }
        }
    }
    let Some(ended) = try waited(child.pid, options: 0) else {
        fail IoError.Other(0)
    }
    let Gathered(stdout: out_bytes, stderr: err_bytes, written: _, scratch: _) = gathered
    return Output(status: ended, stdout: take out_bytes, stderr: take err_bytes)
} run_output

/// The bytes given as a program's input, none for none.
fn input_bytes(take input: Option[mem::Bytes], alloc: mem::Alloc) -> mem::Bytes {
    let Some(bytes) = input else {
        return mem::Bytes.empty(alloc)
    }
    return bytes
} input_bytes

/// Runs a program the `PATH` finds, given its arguments after its name, in the directory `dir`, to
/// its end, its standard input the null device and its standard output and error captured; asks
/// `within` with its process id, between waits of `poll_ms` milliseconds for its output, whether
/// it may go on, and once that gives false or fails, kills it and gives none or the failure.
pkg fn run_bounded(program: Str, args: Slice[text::String], dir: Str, poll_ms: i32, within: fn(id: u32) -> bool fails IoError, alloc: mem::Alloc) -> Option[Output] fails IoError {
    var child = try spawn(program, args, streams: Streams(input: Stream.Null, out: Stream.Piped, err: Stream.Piped), dir: Some(dir), alloc)
    var gathered = Gathered.empty(alloc)
    var ended: Option[Status] = None
    loop {
        ended = try waited(child.pid, options: WNOHANG)
        if ended.is_some() {
            break
        }
        let going = attempt within(child.pid.to_bits())
        if going != Ok(true) {
            try checked(kill(child.pid, number: SIGKILL))
            discard try waited(child.pid, options: 0)
            try drain(mut child, mut gathered)
            let Err(error) = going else {
                return None
            }
            fail error
        }
        discard try mut child.pump(mut gathered, input: b"", timeout: poll_ms)
    }
    try drain(mut child, mut gathered)
    let Some(status_found) = ended else {
        return None
    }
    let Gathered(stdout: out_bytes, stderr: err_bytes, written: _, scratch: _) = gathered
    return Some(Output(status: status_found, stdout: take out_bytes, stderr: take err_bytes))
} run_bounded

/// Reads a started program's output pipes to their ends.
fn drain(mut child: Child, mut gathered: Gathered) fails IoError {
    loop {
        if try mut child.pump(mut gathered, input: b"", timeout: -1) {
            return
        }
    }
} drain

/// Runs a program the `PATH` finds, given its arguments after its name, with this process's
/// standard streams, in the directory `dir`, to its end. Meanwhile a termination request,
/// `SIGHUP`, `SIGINT` or `SIGTERM`, ends this process as the signal's default action does.
pkg fn run_attached(program: Str, args: Slice[text::String], dir: Str, alloc: mem::Alloc) -> Status fails IoError {
    var unblocked = Array[u64, 16].filled(0)
    unblocked[0] = TERMINATION_SET
    let changed = trusted "unblocked addresses a sigset_t, and a null pointer asks for no previous mask" { pthread_sigmask(SIG_UNBLOCK, set: hw::Ptr.of_view(unblocked.view()), previous: hw::Ptr.of_addr(0)) }
    if changed != 0 {
        fail error_of(changed)
    }
    let child = try spawn(program, args, streams: Streams(input: Stream.Inherited, out: Stream.Inherited, err: Stream.Inherited), dir: Some(dir), alloc)
    let Some(ended) = try waited(child.pid, options: 0) else {
        fail IoError.Other(0)
    }
    return ended
} run_attached

/// A program started in the background, until `end`.
pkg struct Background derives Copy {
    pid: i32
} Background

/// Starts a program the `PATH` finds, given its arguments after its name, in the directory `dir`,
/// with its standard streams the null device.
pkg fn start_background(program: Str, args: Slice[text::String], dir: Str, alloc: mem::Alloc) -> Background fails IoError {
    let child = try spawn(program, args, streams: Streams(input: Stream.Null, out: Stream.Null, err: Stream.Null), dir: Some(dir), alloc)
    return Background(pid: child.pid)
} start_background

/// Whether the program has not ended.
pkg fn Background.running(self) -> bool fails IoError {
    return (try waited(self.pid, options: WNOHANG)).is_none()
} Background.running

/// Kills the program and waits for its end.
pkg fn Background.end(self) {
    discard kill(self.pid, number: SIGKILL)
    discard attempt waited(self.pid, options: 0)
} Background.end

/// Waits a number of milliseconds.
pkg fn sleep_ms(milliseconds: i32) {
    discard trusted "poll waits on no descriptor, so it reads none" { poll(hw::Ptr.of_addr(0), count: 0, timeout: milliseconds) }
} sleep_ms

/// Replaces this process by a program at a path, given its arguments after its name, with this
/// process's environment and standard streams, no signal blocked and `SIGPIPE` at its default
/// action. Returns only when the system refuses, with the failure.
pkg fn replace_process(program: Str, args: Slice[text::String], alloc: mem::Alloc) -> IoError {
    let Ok(path) = attempt c_text(program.as_bytes()) else {
        return IoError.Other(EINVAL)
    }
    var texts = mem::Bytes.empty(alloc)
    let Ok(_) = attempt add_text(mut texts, written: program.as_bytes()) else {
        return IoError.Other(EINVAL)
    }
    for arg in args {
        let Ok(_) = attempt add_text(mut texts, written: arg.as_bytes()) else {
            return IoError.Other(EINVAL)
        }
    }
    let argv = pointers(texts.view(), alloc)
    let empty = Array[u64, 16].filled(0)
    discard trusted "empty addresses a sigset_t, and a null pointer asks for no previous mask" { pthread_sigmask(SIG_SETMASK, set: hw::Ptr.of_view(empty.view()), previous: hw::Ptr.of_addr(0)) }
    discard trusted "SIG_DFL is the null handler" { signal(SIGPIPE, handler: hw::Ptr.of_addr(0)) }
    discard trusted "path holds a NUL-terminated path and argv the addresses of the NUL-terminated texts of texts, then 0" { execv(hw::Ptr.of_view(path.bytes.view()), argv: hw::Ptr.of_view(argv.view())) }
    return last_error()
} replace_process

/// The number of processors in this process's affinity set, at least one.
pkg fn processors() -> usize {
    var mask = Array[u64, 16].filled(0)
    let status = trusted "mask addresses 128 bytes" { sched_getaffinity(0, size: 128, mask: hw::Ptr.of_view_mut(mut mask.view_mut())) }
    var count: usize = 0
    if status == 0 {
        for word in mask {
            count += usize.widen(word.count_ones())
        }
    }
    if count == 0 {
        return 1
    }
    return count
} processors

/// The nanoseconds of the system's monotonic clock.
pkg fn monotonic_nanos() -> u64 {
    var time = Array[u64, 2].filled(0)
    discard trusted "time addresses a struct timespec" { clock_gettime(CLOCK_MONOTONIC, time: hw::Ptr.of_view_mut(mut time.view_mut())) }
    return time[0].wrapping_mul(1_000_000_000).wrapping_add(time[1])
} monotonic_nanos

/// Starts a program the `PATH` finds, given its arguments after its name, with this process's
/// environment, its standard streams as `streams` gives, in the directory `dir` or this process's
/// for none, no signal blocked and `SIGPIPE` at its default action.
fn spawn(program: Str, args: Slice[text::String], streams: Streams, dir: Option[Str], alloc: mem::Alloc) -> Child fails IoError {
    let file = try c_text(program.as_bytes())
    var texts = mem::Bytes.empty(alloc)
    try add_text(mut texts, written: program.as_bytes())
    for arg in args {
        try add_text(mut texts, written: arg.as_bytes())
    }
    let argv = pointers(texts.view(), alloc)
    let environment = try read_file("/proc/self/environ", alloc)
    let envp = pointers(environment.view(), alloc)
    var ends = Ends(input: -1, input_far: -1, out: -1, out_far: -1, err: -1, err_far: -1)
    var directory: Option[CText] = None
    match dir {
        Some(path) => {
            directory = Some(try c_text(path.as_bytes()))
        }
        None => {}
    }
    let started = attempt started_with(mut ends, file, argv: argv.view(), envp: envp.view(), streams, directory)
    close_end(ends.input_far)
    close_end(ends.out_far)
    close_end(ends.err_far)
    match started {
        Ok(pid) => return Child(pid: pid, input: ends.input, out: ends.out, err: ends.err)
        Err(error) => {
            close_end(ends.input)
            close_end(ends.out)
            close_end(ends.err)
            fail error
        }
    }
} spawn

/// Opens the pipes of the streams `streams` pipes into `ends`, then starts the program `file` with
/// the texts `argv` and `envp` address, in the directory `directory` when given; gives its process
/// id.
fn started_with(mut ends: Ends, file: CText, argv: Slice[u64], envp: Slice[u64], streams: Streams, directory: Option[CText]) -> i32 fails IoError {
    var actions = Array[u64, 10].filled(0)
    let actions_at = hw::Ptr.of_view_mut(mut actions.view_mut())
    try spawn_checked(trusted "actions_at addresses a posix_spawn_file_actions_t" { posix_spawn_file_actions_init(actions_at) })
    defer destroy_actions(actions_at)
    var attributes = Array[u64, 42].filled(0)
    let attributes_at = hw::Ptr.of_view_mut(mut attributes.view_mut())
    try spawn_checked(trusted "attributes_at addresses a posix_spawnattr_t" { posix_spawnattr_init(attributes_at) })
    defer destroy_attributes(attributes_at)
    let empty = Array[u64, 16].filled(0)
    var defaults = Array[u64, 16].filled(0)
    defaults[0] = SIGPIPE_SET
    try spawn_checked(trusted "attributes_at addresses an initialised posix_spawnattr_t and empty a sigset_t" { posix_spawnattr_setsigmask(attributes_at, mask: hw::Ptr.of_view(empty.view())) })
    try spawn_checked(trusted "attributes_at addresses an initialised posix_spawnattr_t and defaults a sigset_t" { posix_spawnattr_setsigdefault(attributes_at, defaults: hw::Ptr.of_view(defaults.view())) })
    try spawn_checked(trusted "attributes_at addresses an initialised posix_spawnattr_t" { posix_spawnattr_setflags(attributes_at, flags: POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETSIGDEF) })
    match directory {
        Some(path) => try spawn_checked(trusted "actions_at addresses an initialised posix_spawn_file_actions_t, which copies the NUL-terminated path of path" { posix_spawn_file_actions_addchdir_np(actions_at, path: hw::Ptr.of_view(path.bytes.view())) })
        None => {}
    }
    match streams.input {
        Stream.Inherited => {}
        Stream.Null => try add_null(actions_at, fd: 0, flags: O_RDONLY)
        Stream.Piped => {
            let pipe = try open_pipe()
            ends.input = pipe.writing
            ends.input_far = pipe.reading
            try add_dup(actions_at, fd: pipe.reading, target: 0)
        }
    }
    match streams.out {
        Stream.Inherited => {}
        Stream.Null => try add_null(actions_at, fd: 1, flags: O_WRONLY)
        Stream.Piped => {
            let pipe = try open_pipe()
            ends.out = pipe.reading
            ends.out_far = pipe.writing
            try add_dup(actions_at, fd: pipe.writing, target: 1)
        }
    }
    match streams.err {
        Stream.Inherited => {}
        Stream.Null => try add_null(actions_at, fd: 2, flags: O_WRONLY)
        Stream.Piped => {
            let pipe = try open_pipe()
            ends.err = pipe.reading
            ends.err_far = pipe.writing
            try add_dup(actions_at, fd: pipe.writing, target: 2)
        }
    }
    var pid: i32 = 0
    let pid_at = hw::Ptr.of_mut(mut pid)
    try spawn_checked(trusted "pid_at addresses an int, file holds a NUL-terminated name, actions_at and attributes_at their initialised objects, and argv and envp the addresses of NUL-terminated texts, then 0" { posix_spawnp(pid_at, file: hw::Ptr.of_view(file.bytes.view()), actions: actions_at, attributes: attributes_at, argv: hw::Ptr.of_view(argv), envp: hw::Ptr.of_view(envp)) })
    return pid
} started_with

fn destroy_actions(actions: hw::Ptr[u64]) {
    discard trusted "actions addresses an initialised posix_spawn_file_actions_t, destroyed once" { posix_spawn_file_actions_destroy(actions) }
} destroy_actions

fn destroy_attributes(attributes: hw::Ptr[u64]) {
    discard trusted "attributes addresses an initialised posix_spawnattr_t, destroyed once" { posix_spawnattr_destroy(attributes) }
} destroy_attributes

/// Fails with the error number a `posix_spawn` function returned, unless 0.
fn spawn_checked(code: i32) fails IoError {
    if code != 0 {
        fail error_of(code)
    }
} spawn_checked

/// Makes a started program open the null device as the descriptor `fd`.
fn add_null(actions: hw::Ptr[u64], fd: i32, flags: i32) fails IoError {
    let device = try c_text(b"/dev/null")
    try spawn_checked(trusted "actions addresses an initialised posix_spawn_file_actions_t, which copies the NUL-terminated path of device" { posix_spawn_file_actions_addopen(actions, fd, path: hw::Ptr.of_view(device.bytes.view()), flags, mode: 0) })
} add_null

/// Makes a started program find the descriptor `fd` as `target`.
fn add_dup(actions: hw::Ptr[u64], fd: i32, target: i32) fails IoError {
    try spawn_checked(trusted "actions addresses an initialised posix_spawn_file_actions_t" { posix_spawn_file_actions_adddup2(actions, fd, target) })
} add_dup

/// A new pipe, both of its ends closed when this process starts a program.
fn open_pipe() -> Pipe fails IoError {
    var fds = Array[i32, 2].filled(-1)
    let done = trusted "fds addresses two ints" { pipe2(hw::Ptr.of_view_mut(mut fds.view_mut()), flags: O_CLOEXEC) }
    if done != 0 {
        fail last_error()
    }
    return Pipe(reading: fds[0], writing: fds[1])
} open_pipe

/// Closes a descriptor, unless it is -1.
fn close_end(fd: i32) {
    if fd >= 0 {
        discard close(fd)
    }
} close_end

/// Closes this process's ends of the pipes of a started program.
fn Child.close_all(mut self) {
    close_end(self.input)
    close_end(self.out)
    close_end(self.err)
    self.input = -1
    self.out = -1
    self.err = -1
} Child.close_all

/// Appends a text and a NUL; `EINVAL` when the text holds a NUL.
fn add_text(mut texts: mem::Bytes, written: Slice[u8]) fails IoError {
    for byte in written {
        if byte == 0 {
            fail IoError.Other(EINVAL)
        }
    }
    mut texts.append(written)
    mut texts.push(0)
} add_text

/// The address of each NUL-terminated text of `texts`, then 0, as the C library reads a list of
/// texts.
fn pointers(texts: Slice[u8], alloc: mem::Alloc) -> mem::List[u64] {
    var found = mem::List[u64].empty(alloc)
    let base = u64.widen(hw::Ptr.of_view(texts).addr())
    var start: usize = 0
    for at in 0..<texts.len() {
        if texts[at] == 0 {
            expect base <= ~0u64 - u64.widen(start)
            mut found.push(base + u64.widen(start))
            start = at + 1
        }
    }
    mut found.push(0)
    return found
} pointers

/// How the process `pid` ended once it has, with the options of `waitpid`; none while it runs,
/// with `WNOHANG`.
fn waited(pid: i32, options: i32) -> Option[Status] fails IoError {
    var raw: i32 = 0
    loop {
        let found = trusted "raw is an int waitpid writes" { waitpid(pid, wstatus: hw::Ptr.of_mut(mut raw), options) }
        if found == pid {
            let bits = raw.to_bits()
            let number = bits & 0x7F
            if number == 0 {
                return Some(Status.Exited(i32.fit((bits >> 8) & 0xFF)))
            }
            return Some(Status.Signalled(i32.fit(number)))
        }
        if found == 0 {
            return None
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} waited

/// Waits up to `timeout` milliseconds, -1 for no bound, for the pipes of a started program, then
/// writes the next part of `input` to its standard input, closed once it is all written or the
/// program reads no more, and reads what its standard output and error hold, each closed at its
/// end. Returns whether every pipe is closed.
fn Child.pump(mut self, mut gathered: Gathered, input: Slice[u8], timeout: i32) -> bool fails IoError {
    if self.input >= 0 and gathered.written >= input.len() {
        close_end(self.input)
        self.input = -1
    }
    var fds = Array[u64, 3].filled(0)
    var count: usize = 0
    if self.input >= 0 {
        fds[count] = polled(self.input, events: POLLOUT)
        count += 1
    }
    if self.out >= 0 {
        fds[count] = polled(self.out, events: POLLIN)
        count += 1
    }
    if self.err >= 0 {
        fds[count] = polled(self.err, events: POLLIN)
        count += 1
    }
    if count == 0 {
        return true
    }
    let ready = trusted "fds addresses count struct pollfd" { poll(hw::Ptr.of_view_mut(mut fds.view_mut()), count: u64.widen(count), timeout) }
    if ready < 0 {
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
        return false
    }
    for index in 0..<count {
        let word = fds[index]
        if (word >> 48) == 0 {
            continue
        }
        let fd = i32.from_bits(u32.truncate(word))
        if fd == self.input {
            if not try fed(fd, mut gathered, input) {
                close_end(fd)
                self.input = -1
            }
        } else if fd == self.out {
            if not try gather(fd, into: mut gathered.stdout, scratch: mut gathered.scratch) {
                close_end(fd)
                self.out = -1
            }
        } else if fd == self.err {
            if not try gather(fd, into: mut gathered.stderr, scratch: mut gathered.scratch) {
                close_end(fd)
                self.err = -1
            }
        }
    }
    return self.input < 0 and self.out < 0 and self.err < 0
} Child.pump

/// A `struct pollfd` as a word: the descriptor, then the events asked for.
fn polled(fd: i32, events: u64) -> u64 {
    return u64.widen(fd.to_bits()) | (events << 32)
} polled

/// Writes the next part of `input` to a pipe; false once all is written or the reader is gone.
fn fed(fd: i32, mut gathered: Gathered, input: Slice[u8]) -> bool fails IoError {
    let Some(parts) = input.split_at(gathered.written) else {
        return false
    }
    var size = parts.tail.len()
    if size > PIPE_CHUNK {
        size = PIPE_CHUNK
    }
    let count = trusted "the tail of input holds size bytes" { write(fd, buf: hw::Ptr.of_view(parts.tail), count: size) }
    if count > 0 {
        gathered.written += usize.fit(count)
        return gathered.written < input.len()
    }
    let code = last_code()
    if code == EPIPE {
        return false
    }
    if code != EINTR {
        fail error_of(code)
    }
    return true
} fed

/// Reads what a pipe holds into `into`; false at its end.
fn gather(fd: i32, mut into: mem::Bytes, mut scratch: mem::Bytes) -> bool fails IoError {
    let count = trusted "scratch holds PIPE_READ bytes" { read(fd, buf: hw::Ptr.of_view_mut(mut scratch.view_mut()), count: PIPE_READ) }
    if count == 0 {
        return false
    }
    if count > 0 {
        let Some(part) = scratch.view().prefix(usize.fit(count)) else {
            return false
        }
        mut into.append(part)
        return true
    }
    let code = last_code()
    if code != EINTR {
        fail error_of(code)
    }
    return true
} gather
