//! The ELF64 image of a bare kernel: its loadable segments, their placement and its entry.

/// The program header type of a loadable segment, and the sizes of an image's header and of a
/// program header.
const PT_LOAD: u32 = 1

const HEADER_BYTES: u64 = 64

const PROGRAM_HEADER_BYTES: u64 = 56

/// The memory the entry root maps, which segments must lie in.
const MAPPED: u64 = 0x1_0000_0000

pub closed enum ImageError derives Eq, Render {
    NotElf
    Truncated
    Inverted
    Unmapped
    Unusable
    Misplaced
    NoEntry
} ImageError

/// Where an image's program headers lie and how many there are.
struct Programs {
    offset: u64
    count: u16
} Programs

/// A segment of an image: its type, its bytes' offset in the image, its physical address, and
/// its sizes in the image and in memory.
struct Segment derives Copy {
    kind: u32
    offset: u64
    address: u64
    file_size: u64
    memory_size: u64
} Segment

/// The loadable segments of an image, each lying in the image and in the mapped memory.
fn loadable(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::List[Segment] fails ImageError {
    let programs = try header(raw)
    var segments = mem::List[Segment].empty(alloc)
    for index in 0u16..<programs.count {
        let segment = try program(raw, programs, index)
        if segment.kind == PT_LOAD {
            mut segments.push(segment)
        }
    }
    return segments
} loadable

/// Allocates the memory of each segment from the firmware and copies the segment there,
/// zero-filled to its size in memory, giving the regions in the segments' order; frees them
/// again when one cannot be placed.
fn place_all(services: boot::Services, raw: Untrusted[Slice[u8]], segments: Slice[Segment], alloc: mem::Alloc) -> mem::List[hw::Region] fails ImageError {
    var regions = mem::List[hw::Region].empty(alloc)
    for segment in segments {
        let Ok(region) = attempt services.allocate(segment.address, byte_len: segment.memory_size) else {
            release(services, take regions)
            fail ImageError.Unusable
        }
        let placed = place(raw, segment, region)
        mut regions.push(take region)
        if not placed {
            release(services, take regions)
            fail ImageError.Misplaced
        }
    }
    return regions
} place_all

/// Gives regions back to the firmware.
fn release(services: boot::Services, take regions: mem::List[hw::Region]) {
    for region in take regions {
        discard attempt services.free(take region)
    }
} release

/// The program headers of an ELF64 little-endian AArch64 executable.
validator fn header(raw: Untrusted[Slice[u8]]) -> Programs fails ImageError {
    let bytes = raw.inspect()
    if bytes.len() < 64 {
        fail ImageError.Truncated
    }
    if bytes.u32_le(0) != 0x464C_457F or bytes[4] != 2 or bytes[5] != 1 or bytes.u16_le(18) != 183 {
        fail ImageError.NotElf
    }
    let programs = Programs(offset: bytes.u64_le(32), count: bytes.u16_le(56))
    let table = u64.widen(programs.count) * PROGRAM_HEADER_BYTES
    if programs.offset < HEADER_BYTES or programs.offset > u64.widen(bytes.len()) or table > u64.widen(bytes.len()) - programs.offset {
        fail ImageError.Truncated
    }
    return programs
} header

/// Program header `index` of an image, which lies in the image; a loadable segment's bytes lie
/// in the image and its memory in the mapped memory.
validator fn program(raw: Untrusted[Slice[u8]], programs: Programs, index: u16) -> Segment fails ImageError {
    let bytes = raw.inspect()
    let Some(table) = bytes.split_at(usize.widen(programs.offset)) else {
        fail ImageError.Truncated
    }
    let Some(rest) = table.tail.split_at(usize.widen(u64.widen(index) * PROGRAM_HEADER_BYTES)) else {
        fail ImageError.Truncated
    }
    let Some(entry) = rest.tail.prefix(usize.widen(PROGRAM_HEADER_BYTES)) else {
        fail ImageError.Truncated
    }
    let segment = Segment(kind: entry.u32_le(0), offset: entry.u64_le(8), address: entry.u64_le(24), file_size: entry.u64_le(32), memory_size: entry.u64_le(40))
    if segment.kind != PT_LOAD {
        return segment
    }
    if segment.file_size > segment.memory_size {
        fail ImageError.Inverted
    }
    if segment.offset > u64.widen(bytes.len()) or segment.file_size > u64.widen(bytes.len()) - segment.offset {
        fail ImageError.Truncated
    }
    if segment.address > MAPPED or segment.memory_size > MAPPED - segment.address {
        fail ImageError.Unmapped
    }
    return segment
} program

/// The address the image is entered at.
validator fn entry_address(raw: Untrusted[Slice[u8]]) -> u64 fails ImageError {
    discard try header(raw)
    let address = raw.inspect().u64_le(24)
    if address == 0 {
        fail ImageError.NoEntry
    }
    return address
} entry_address

/// Copies a segment's bytes to its region and zero-fills it to its size in memory; gives whether
/// the region then holds the segment's bytes.
validator fn place(raw: Untrusted[Slice[u8]], segment: Segment, region: hw::Region) -> bool {
    let bytes = raw.inspect()
    let Some(parts) = bytes.split_at(usize.widen(segment.offset)) else {
        return false
    }
    let Some(source) = parts.tail.prefix(usize.widen(segment.file_size)) else {
        return false
    }
    if region.base() != segment.address or region.byte_len() < segment.memory_size {
        return false
    }
    let from = hw::Ptr.of_view(source)
    let to = hw::Ptr[u8].of_addr(usize.widen(region.base()))
    var same = true
    trusted "the region is the loader's, mapped at its physical address, and holds the segment's memory" {
        from.copy(to, count: source.len())
        var filled = segment.file_size
        while filled < segment.memory_size {
            to.offset(isize.fit(filled)).write(0)
            filled += 1
        }
        for index in 0..<source.len() {
            if to.offset(isize.fit(index)).read() != source[index] {
                same = false
            }
        }
    }
    return same
} place

test header_rejects_other_files for header {
    let bytes = Array[u8, 64].filled(0)
    let outcome = attempt header(Untrusted.of(bytes.view()))
    let rejected = match outcome {
        Err(error) => error == ImageError.NotElf
        Ok(_) => false
    }
    expect rejected
} header_rejects_other_files
