//! The emulator the machine targets' descriptors name: whether it can start, the invocation booting a machine image under it, and boots bounded in host processor time.

/// The emulator program.
const QEMU: Str = "qemu-system-x86_64"

/// The firmware an `x86_64-uefi` image boots through, and its fallbacks across distributions,
/// separated by spaces.
const OVMF: Str = "/usr/share/edk2/ovmf/OVMF_CODE.fd /usr/share/OVMF/OVMF_CODE.fd /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/edk2/x64/OVMF_CODE.4m.fd"

/// The status of a run under the emulator that ends other than by a write to the exit port.
pkg const OTHER_END: u8 = 70

/// The milliseconds of host processor time a bounded boot may use.
const PROCESSOR_TIME: u64 = 10_000

/// The nanoseconds a bounded boot lasts at most: only a machine that waits forever without using
/// its processor time reaches it.
const WALL_TIME: u64 = 120_000_000_000

/// The milliseconds between two readings of a bounded boot's processor time.
const POLL: i32 = 5

/// The clock ticks per second of the processor times `/proc` gives, USER_HZ.
const TICKS_PER_SECOND: u64 = 100

/// The positions of a process's user and system times among the fields of its `/proc` stat that
/// follow its command name.
const USER_TIME: usize = 11

const SYSTEM_TIME: usize = 12

/// The emulator arguments common to every machine run, separated by spaces: the machine,
/// accelerated by KVM where the host offers it, processors, memory, entropy device, exit port,
/// serial port on the standard streams, no display or reboot, and an end with the process that
/// starts it.
const BASE_ARGS: Str = "-run-with exit-with-parent=on -machine q35 -accel kvm -accel tcg -smp 4 -m 512M -device virtio-rng-pci -device isa-debug-exit,iobase=0xf4,iosize=0x01 -display none -no-reboot -nodefaults -serial stdio -monitor none"

/// The words of a text separated by spaces.
fn words_of(written: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var parts = mem::List[text::String].empty(alloc)
    let bytes = written.as_bytes()
    expect bytes.len() < ~0usize
    var start: usize = 0
    for at in 0..=bytes.len() {
        if at < bytes.len() and bytes[at] != b' ' {
            continue
        }
        let Some(part) = written.slice_bytes(start, end: at) else {
            return parts
        }
        mut parts.push(text::String.of(part, alloc))
        start = at + 1
    }
    return parts
} words_of

/// What `nan run` starts once it has built an image: the image on `x86_64-host`, the emulator
/// booting it on a machine target, and its arguments.
pkg struct Launch {
    pkg program: text::String
    pkg args: mem::List[text::String]
    /// Whether the program is the emulator, whose end gives the run's status.
    pkg emulated: bool
} Launch

/// Starts the program and gives the status the run ends with: the image replaces this process,
/// so that termination requests reach it and its status is the run's, the status being 101 when
/// the system refuses to start it; the emulator runs as a child, and the status the run ends with
/// is given once it ends.
pkg fn Launch.start(self, alloc: mem::Alloc) -> u8 {
    if self.emulated {
        return run(self, alloc)
    }
    discard platform::replace_process(self.program.as_str(), args: self.args.view(), alloc)
    return 101
} Launch.start

/// Whether the emulator of a machine target can start: the emulator program runs and can end
/// with the process that starts it, and OVMF is present for `x86_64-uefi`.
pkg fn available(target: workspace::Target, alloc: mem::Alloc) -> bool {
    let args = words_of("-run-with help", alloc)
    let runs = match attempt platform::run_output(QEMU, args: args.view(), input: None, capture_errors: false, alloc) {
        Ok(ran) => holds(ran.stdout.view(), wanted: b"exit-with-parent")
        Err(_) => false
    }
    return runs and (target != workspace::Target.Uefi or firmware(alloc).is_some())
} available

/// Whether bytes hold a run of bytes.
fn holds(bytes: Slice[u8], wanted: Slice[u8]) -> bool {
    if wanted.len() > bytes.len() {
        return false
    }
    for start in 0..=(bytes.len() - wanted.len()) {
        let Some(parts) = bytes.split_at(start) else {
            return false
        }
        let Some(window) = parts.tail.prefix(wanted.len()) else {
            return false
        }
        if window == wanted {
            return true
        }
    }
    return false
} holds

/// Boots the emulator as `given` gives, with the standard streams of this process, and gives the
/// status the run ends with once the emulator ends.
fn run(given: Launch, alloc: mem::Alloc) -> u8 {
    return run_status(attempt platform::run_attached(given.program.as_str(), args: given.args.view(), alloc))
} run

/// The status a run under the emulator ends with: v mod 128 when the machine wrote the byte v to
/// the exit port, which ends the emulator with status (2v + 1) mod 256, and `OTHER_END` for any
/// other end.
fn run_status(ended: Result[platform::Status, platform::IoError]) -> u8 {
    let Ok(platform::Status.Exited(code)) = ended else {
        return OTHER_END
    }
    let Some(value) = u32.checked_fit(code) else {
        return OTHER_END
    }
    if value % 2 != 1 {
        return OTHER_END
    }
    let Some(status) = u8.checked_fit((value - 1) / 2) else {
        return OTHER_END
    }
    return status
} run_status

/// The OVMF firmware present on the host.
fn firmware(alloc: mem::Alloc) -> Option[text::String] {
    for path in words_of(OVMF, alloc) {
        if platform::exists(path.as_str()) {
            return Some(text::String.of(path.as_str(), alloc))
        }
    }
    return None
} firmware

/// What becomes of what a machine writes to its boot volume.
pkg enum Writes derives Copy, Eq {
    /// The volume's directory keeps it.
    Kept
    /// It lasts until the emulator ends, so that every boot finds the volume as it was made.
    Dropped
} Writes

/// The emulator invocation that boots a machine image: an `x86_64-bare` image directly through
/// the PVH boot protocol, an `x86_64-uefi` image through OVMF from a FAT volume holding it as
/// `/EFI/BOOT/BOOTX64.EFI` and each of `files` at `/` followed by its name.
pkg fn launch(target: workspace::Target, image: Str, files: Slice[text::String], writes: Writes, alloc: mem::Alloc) -> Launch fails platform::IoError {
    var args = words_of(BASE_ARGS, alloc)
    if target == workspace::Target.Uefi {
        var chosen = text::String.empty(alloc)
        match firmware(alloc) {
            Some(found) => {
                chosen = found
            }
            None => {
                var paths = words_of(OVMF, alloc)
                chosen = mut paths.remove(0)
            }
        }
        let volume = try boot_volume(image, files, alloc)
        mut args.push(text::String.of("-drive", alloc))
        var drive = text::String.of("if=pflash,format=raw,unit=0,readonly=on,file=", alloc)
        mut drive.append(chosen.as_str())
        mut args.push(take drive)
        mut args.push(text::String.of("-drive", alloc))
        var disk = text::String.empty(alloc)
        match writes {
            Writes.Kept => {
                mut disk.append("format=raw,file=fat:rw:")
                mut disk.append(volume.as_str())
            }
            Writes.Dropped => {
                mut disk.append("format=raw,file=fat:")
                mut disk.append(volume.as_str())
                mut disk.append(",snapshot=on")
            }
        }
        mut args.push(take disk)
    } else {
        mut args.push(text::String.of("-kernel", alloc))
        mut args.push(text::String.of(image, alloc))
    }
    return Launch(program: text::String.of(QEMU, alloc), args: take args, emulated: true)
} launch

/// The FAT boot volume of a UEFI image: a directory beside it holding the image as the default
/// boot path the firmware loads, and each of `files` at its root.
fn boot_volume(image: Str, files: Slice[text::String], alloc: mem::Alloc) -> text::String fails platform::IoError {
    let directory = volume_of(image, alloc)
    if platform::exists(directory.as_str()) {
        try platform::remove_dir_all(directory.as_str(), alloc)
    }
    let boot_dir = platform::join(directory.as_str(), name: "EFI/BOOT", alloc)
    try platform::create_dir_all(boot_dir.as_str(), alloc)
    try copy_file(image, to: platform::join(boot_dir.as_str(), name: "BOOTX64.EFI", alloc).as_str(), alloc)
    for file in files {
        let Some(name) = platform::file_name(file.as_str(), alloc) else {
            expect false
            continue
        }
        try copy_file(file.as_str(), to: platform::join(directory.as_str(), name: name.as_str(), alloc).as_str(), alloc)
    }
    return directory
} boot_volume

/// Copies a file's contents to a path.
fn copy_file(from: Str, to: Str, alloc: mem::Alloc) fails platform::IoError {
    let contents = try platform::read_file(from, alloc)
    try platform::write_file(to, contents: contents.view())
} copy_file

/// The directory a launch makes the boot volume of an image in.
fn volume_of(image: Str, alloc: mem::Alloc) -> text::String {
    return platform::replaced_extension(image, extension: "boot", alloc)
} volume_of

/// Removes a machine image and any boot volume a launch made for it.
pkg fn remove_image(image: Str, alloc: mem::Alloc) fails platform::IoError {
    let volume = volume_of(image, alloc)
    if platform::exists(volume.as_str()) {
        try platform::remove_dir_all(volume.as_str(), alloc)
    }
    try platform::remove_file(image)
} remove_image

/// Boots the emulator as `given` gives, with the file at `path` as its configuration file `name`,
/// and gives how it ended, its serial output and its diagnostics; none once it has used more than
/// `PROCESSOR_TIME` of host processor time, or lasted `WALL_TIME`.
pkg fn boot(given: Launch, name: Str, path: Str, alloc: mem::Alloc) -> Option[platform::Output] fails platform::IoError {
    var args = mem::List[text::String].empty(alloc)
    for arg in given.args {
        mut args.push(text::String.of(arg.as_str(), alloc))
    }
    mut args.push(text::String.of("-fw_cfg", alloc))
    var configuration = text::String.of("name=", alloc)
    mut configuration.append(name)
    mut configuration.append(",file=")
    mut configuration.append(path)
    mut args.push(take configuration)
    let started = platform::monotonic_nanos()
    return try platform::run_bounded(given.program.as_str(), args: args.view(), poll_ms: POLL, within: fn(id: u32) -> bool fails platform::IoError {
        let used = try processor_time_of(id, alloc)
        return used <= PROCESSOR_TIME and platform::monotonic_nanos().wrapping_sub(started) < WALL_TIME
    }, alloc)
} boot

/// Whether a byte is ASCII white space.
fn is_space(byte: u8) -> bool = byte == b' ' or byte == b'\t' or byte == b'\n' or byte == b'\r' or byte == 0x0B or byte == 0x0C

/// The milliseconds of host processor time a process has used, its threads' in user and system
/// mode.
fn processor_time_of(pid: u32, alloc: mem::Alloc) -> u64 fails platform::IoError {
    var path = text::String.empty(alloc)
    mut path.write(text::fmt("/proc/{pid}/stat", pid), budget: 64)
    let stat = try platform::read_text(path.as_str(), alloc)
    let written = stat.as_str()
    let bytes = written.as_bytes()
    var after = bytes.len()
    for at in 0..<bytes.len() {
        if bytes[at] == b')' {
            after = at + 1
        }
    }
    var fields = mem::List[text::String].empty(alloc)
    var start = after
    expect bytes.len() < ~0usize
    for at in after..=bytes.len() {
        if at < bytes.len() and not is_space(bytes[at]) {
            continue
        }
        if at > start {
            let Some(field) = written.slice_bytes(start, end: at) else {
                fail platform::IoError.InvalidData
            }
            mut fields.push(text::String.of(field, alloc))
        }
        start = at + 1
    }
    var ticks: u64 = 0
    for at in 0..<2usize {
        var position = USER_TIME
        if at == 1 {
            position = SYSTEM_TIME
        }
        let Some(field) = fields.get(position) else {
            fail platform::IoError.Other(0)
        }
        let Some(value) = platform::parse_decimal(field.as_str()) else {
            fail platform::IoError.Other(0)
        }
        ticks = ticks.wrapping_add(value)
    }
    return ticks.wrapping_mul(1_000) / TICKS_PER_SECOND
} processor_time_of

test a_run_ends_with_the_byte_written_to_the_exit_port_and_otherwise_with_70 for run_status {
    expect run_status(Ok(platform::Status.Exited(1))) == 0
    expect run_status(Ok(platform::Status.Exited(141))) == 70
    expect run_status(Ok(platform::Status.Exited(255))) == 127
    expect run_status(Ok(platform::Status.Exited(0))) == OTHER_END
    expect run_status(Ok(platform::Status.Signalled(9))) == OTHER_END
    expect run_status(Err(platform::IoError.NotFound)) == OTHER_END
} a_run_ends_with_the_byte_written_to_the_exit_port_and_otherwise_with_70
