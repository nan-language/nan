//! An AArch64 bare kernel running user threads in one address space.

package aarch64_user_mode {
    language 1
    targets aarch64-bare
    entry main
    allow device in aarch64_user_mode
    allow priv in aarch64_user_mode
    allow trusted in aarch64_user_mode
    allow validate in aarch64_user_mode
} aarch64_user_mode
