//! What instruction selection knows of a function before it selects an instruction: which instruction defines each value and how often reachable code uses it, the blocks in the order emission lays them out with the blocks the edges of conditional branches go through, where jumps land, the chains of branches becoming jump tables, the stack slots' layout, and the values whose definitions selection folds: constants, the comparisons deciding a flag, and shifts.

/// What selection knows of a function before it selects an instruction.
struct Facts {
    alloc: mem::Alloc
    /// How many times live instructions use each value.
    use_counts: mem::List[u32]
    /// Whether each instruction is live, by instruction index: it has an effect, ends its block,
    /// or a live instruction reads one of its results.
    live: mem::List[bool]
    /// The index of the instruction defining each value, `NONE` for a block parameter.
    defs: mem::List[u32]
    /// The index of the block defining each value, `NONE` for one no reachable block defines.
    homes: mem::List[u32]
    /// Each block's index in the code, `NONE` for one no path from the entry reaches.
    positions: mem::List[u32]
    /// The reachable blocks in the order emission lays them out.
    sequence: mem::List[clif::Block]
    /// The block branching to each block when it is the only one, `NONE` otherwise.
    single: mem::List[u32]
    /// The block a jump to each block lands in: past the blocks holding only a jump without
    /// arguments.
    destinations: mem::List[u32]
    /// The chains of branches becoming jump tables.
    switches: Switches
    /// For each block ending in a conditional branch, the index of the block each edge passing
    /// arguments goes through, `NONE` for an edge without arguments.
    then_edges: mem::List[u32]
    else_edges: mem::List[u32]
    /// Whether each value is the flag of an overflowing operation that only the conditional
    /// branch ending its block tests, right after the operation, or the `bxor` with 1 inverting
    /// such a flag for the branch: the branch reads the processor's flags instead.
    fused: mem::List[bool]
    /// Whether some instruction reads each value in a way that can show a NaN's bits: any but
    /// an operand of `fadd`, `fsub`, `fmul`, `fdiv` or `sqrt`, whose result is a NaN whenever an
    /// operand is one, of a float comparison or of a conversion of a float to an integer.
    shown: mem::List[bool]
} Facts

fn Facts.of(func: clif::Function, alloc: mem::Alloc) -> Facts {
    let values = usize.widen(func.value_count())
    let blocks = block_count(func, alloc)
    var known = Facts(
        alloc: alloc,
        use_counts: filled(values, value: 0u32, alloc),
        live: mem::List[bool].empty(alloc),
        defs: filled(values, value: NONE, alloc),
        homes: filled(values, value: NONE, alloc),
        positions: filled(blocks, value: NONE, alloc),
        sequence: mem::List[clif::Block].empty(alloc),
        single: single_predecessors(func, alloc),
        destinations: destinations(func, count: blocks, alloc),
        switches: find_switches(func, count: blocks, alloc),
        then_edges: filled(blocks, value: NONE, alloc),
        else_edges: filled(blocks, value: NONE, alloc),
        fused: filled(values, value: false, alloc),
        shown: filled(values, value: false, alloc),
    )
    mut known.place_blocks(func)
    mut known.count_values(func)
    return known
} Facts.of

/// The stack slots of a function laid out above an outgoing argument area: each slot's offset
/// from the stack pointer, where the slots end, and the largest alignment one asks, at least 16.
struct SlotLayout {
    offsets: mem::List[u32]
    end: u32
    align: u32
} SlotLayout

/// Lays out the stack slots above `outgoing` bytes of arguments, each aligned as it asks and at
/// least to 8 bytes.
fn lay_out_slots(func: clif::Function, outgoing: u32, alloc: mem::Alloc) -> SlotLayout {
    var align: u32 = 16
    for index in 0u32..<func.stack_slot_count() {
        align = larger(align, other: slot_align(func.stack_slot_data(clif::StackSlot(index: index))))
    }
    var offsets = mem::List[u32].empty(alloc)
    var end = round_up(outgoing, to: align)
    for index in 0u32..<func.stack_slot_count() {
        let data = func.stack_slot_data(clif::StackSlot(index: index))
        let start = round_up(end, to: slot_align(data))
        mut offsets.push(start)
        end = start + data.size
    }
    return SlotLayout(offsets: take offsets, end: end, align: align)
} lay_out_slots

/// One more than the highest block index the layout holds.
fn block_count(func: clif::Function, alloc: mem::Alloc) -> usize {
    var count: usize = 0
    for block in func.layout_blocks(alloc) {
        if usize.widen(block.index) >= count {
            count = usize.widen(block.index) + 1
        }
    }
    return count
} block_count

/// The block a jump to each block lands in: the end of the chain of blocks other than the entry
/// that hold only a jump without arguments, or a block of the chain when it loops.
fn destinations(func: clif::Function, count: usize, alloc: mem::Alloc) -> mem::List[u32] {
    var next = filled(count, value: NONE, alloc)
    let entry = func.entry_block()
    for block in func.layout_blocks(alloc) {
        if entry == Some(block) or func.block_params(block, alloc).len() > 0 {
            continue
        }
        let insts = func.block_insts(block, alloc)
        if insts.len() != 1 {
            continue
        }
        let clif::InstructionData.Jump(opcode: _, destination: destination) = func.inst_data(insts[0]) else {
            continue
        }
        expect usize.widen(block.index) < next.len()
        if destination.args.len() == 0 and usize.widen(destination.block.index) < count {
            next[usize.widen(block.index)] = destination.block.index
        }
    }
    var found = filled(count, value: NONE, alloc)
    for index in 0..<count {
        invariant next.len() == count and found.len() == count
        var walk = u32.fit(index)
        var steps: usize = 0
        while next[usize.widen(walk)] != NONE and found[usize.widen(walk)] == NONE and steps < count {
            walk = next[usize.widen(walk)]
            steps += 1
        }
        if found[usize.widen(walk)] != NONE {
            found[index] = found[usize.widen(walk)]
        } else if next[usize.widen(walk)] == NONE {
            found[index] = walk
        } else {
            found[index] = u32.fit(index)
        }
    }
    return found
} destinations

/// The block a jump to a block lands in.
fn Facts.destination(self, block: clif::Block) -> clif::Block {
    let at = usize.widen(block.index)
    expect at < self.destinations.len()
    return clif::Block(index: self.destinations[at])
} Facts.destination

/// Whether both edges of a conditional branch land in one block without arguments.
fn Facts.merges(self, then_call: clif::BlockCall, else_call: clif::BlockCall) -> bool {
    return then_call.args.len() == 0 and else_call.args.len() == 0 and self.destination(then_call.block) == self.destination(else_call.block)
} Facts.merges

/// The blocks a block's terminator lands in.
fn Facts.successors(self, func: clif::Function, block: clif::Block) -> mem::List[clif::Block] {
    var found = mem::List[clif::Block].empty(self.alloc)
    let chain = self.switch_of(block)
    if chain != NONE {
        expect usize.widen(chain) < self.switches.chains.len()
        for target in self.switches.chains[usize.widen(chain)].targets {
            mut found.push(self.destination(target))
        }
        mut found.push(self.destination(self.switches.chains[usize.widen(chain)].default))
        return found
    }
    let insts = func.block_insts(block, alloc: self.alloc)
    if insts.len() == 0 {
        return found
    }
    match func.inst_data(insts[insts.len() - 1]) {
        clif::InstructionData.Jump(opcode: _, destination: destination) => mut found.push(self.destination(destination.block))
        clif::InstructionData.Brif(opcode: _, arg: _, then: then_call, otherwise: else_call) => {
            mut found.push(self.destination(then_call.block))
            mut found.push(self.destination(else_call.block))
        }
        else => {}
    }
    return found
} Facts.successors

/// Whether a path from the entry reaches each block.
fn Facts.reachable(self, func: clif::Function) -> mem::List[bool] {
    let alloc = self.alloc
    let count = self.positions.len()
    var seen = filled(count, value: false, alloc)
    var pending = mem::List[clif::Block].empty(alloc)
    let Some(entry) = func.entry_block() else {
        return seen
    }
    expect usize.widen(entry.index) < seen.len()
    seen[usize.widen(entry.index)] = true
    mut pending.push(entry)
    loop {
        let Some(block) = mut pending.pop() else {
            break
        }
        for next in self.successors(func, block) {
            let at = usize.widen(next.index)
            expect at < seen.len()
            if not seen[at] {
                seen[at] = true
                mut pending.push(next)
            }
        }
    }
    return seen
} Facts.reachable

/// The reachable blocks in the order emission lays them out.
fn Facts.order(self, func: clif::Function) -> mem::List[clif::Block] {
    var order = mem::List[clif::Block].empty(self.alloc)
    for block in self.sequence {
        mut order.push(block)
    }
    return order
} Facts.order

/// The reachable blocks in the order emission lays them out: those not cold in layout order with
/// the blocks of each loop together, each loop's header that tests whether the loop goes on moved
/// after the latch jumping back to it, each block that one jump alone lands in moved after that
/// jump when both lie in the same innermost loop, then the cold ones.
fn Facts.emission_order(self, func: clif::Function, seen: Slice[bool]) -> mem::List[clif::Block] {
    let alloc = self.alloc
    var hot = mem::List[clif::Block].empty(alloc)
    var cold = mem::List[clif::Block].empty(alloc)
    for block in func.layout_blocks(alloc) {
        let at = usize.widen(block.index)
        expect at < seen.len()
        if not seen[at] {
            continue
        }
        if func.is_cold(block) {
            mut cold.push(block)
        } else {
            mut hot.push(block)
        }
    }
    let loops = loops_of(func, alloc)
    var together = loops_together(order: hot.view(), loops, count: seen.len(), alloc)
    rotate_loops(func, loops, order: mut together, alloc)
    var order = self.chained(func, loops, order: together.view())
    for block in cold {
        mut order.push(block)
    }
    return order
} Facts.emission_order

/// The blocks of `order` in chains of blocks of one innermost loop: each block that the jump
/// ending one block alone lands in, of the blocks of `order`, right after that block, then each
/// block right after the one before it in `order` when that one branches to it; the chains in
/// the order of their first blocks.
fn Facts.chained(self, func: clif::Function, loops: Loops, order: Slice[clif::Block]) -> mem::List[clif::Block] {
    let alloc = self.alloc
    let count = self.positions.len()
    var placed = filled(count, value: false, alloc)
    var jumps = filled(count, value: 0u32, alloc)
    for block in order {
        expect usize.widen(block.index) < count
        placed[usize.widen(block.index)] = true
        let Some(target) = self.jump_target(func, block) else {
            continue
        }
        expect usize.widen(target.index) < count
        jumps[usize.widen(target.index)] += 1
    }
    var chains = Chains.of(count, alloc)
    for block in order {
        let Some(target) = self.jump_target(func, block) else {
            continue
        }
        let at = usize.widen(target.index)
        expect at < count
        if placed[at] and jumps[at] == 1 and loops.alike(block.index, other: target.index) and func.entry_block() != Some(target) {
            mut chains.link(block.index, after: target.index)
        }
    }
    for at in 1..<order.len() {
        let before = order[at - 1].index
        let after = order[at].index
        if loops.alike(before, other: after) and self.successors(func, block: order[at - 1]).position(fn(block: clif::Block) => block.index == after) != None {
            mut chains.link(before, after: after)
        }
    }
    var chained = mem::List[clif::Block].empty(alloc)
    for block in order {
        if chains.previous[usize.widen(block.index)] != NONE {
            continue
        }
        var walk = block.index
        while walk != NONE {
            mut chained.push(clif::Block(index: walk))
            expect usize.widen(walk) < chains.next.len()
            walk = chains.next[usize.widen(walk)]
        }
    }
    return chained
} Facts.chained

/// The blocks of `order` with the blocks of each loop together where its first block lies, in
/// the order of `order`, those of each loop it holds together alike.
fn loops_together(order: Slice[clif::Block], loops: Loops, count: usize, alloc: mem::Alloc) -> mem::List[clif::Block] {
    var members = mem::List[mem::List[clif::Block]].empty(alloc)
    for _ in 0..<loops.list.len() {
        mut members.push(mem::List[clif::Block].empty(alloc))
    }
    for block in order {
        expect usize.widen(block.index) < loops.innermost.len()
        var current = loops.innermost[usize.widen(block.index)]
        while current != NONE {
            expect usize.widen(current) < members.len() and usize.widen(current) < loops.list.len()
            mut members[usize.widen(current)].push(block)
            current = loops.list[usize.widen(current)].parent
        }
    }
    var placed = filled(count, value: false, alloc)
    var laid = mem::List[clif::Block].empty(alloc)
    lay_region(region: NONE, blocks: order, members: members.view(), loops, mut placed, mut laid)
    return laid
} loops_together

/// Lays out each of `blocks` not yet placed, the blocks of a loop `region` holds, or of the
/// function for `NONE`, together where the first of them lies.
fn lay_region(region: u32, blocks: Slice[clif::Block], members: Slice[mem::List[clif::Block]], loops: Loops, mut placed: mem::List[bool], mut laid: mem::List[clif::Block]) {
    for block in blocks {
        let at = usize.widen(block.index)
        expect at < placed.len()
        if placed[at] {
            continue
        }
        let child = loops.child_of(region, block: block.index)
        if child == NONE {
            placed[at] = true
            mut laid.push(block)
        } else {
            expect usize.widen(child) < members.len()
            lay_region(region: child, blocks: members[usize.widen(child)].view(), members, loops, mut placed, mut laid)
        }
    }
} lay_region

/// The block the jump ending a block lands in, if a jump ends it.
fn Facts.jump_target(self, func: clif::Function, block: clif::Block) -> Option[clif::Block] {
    let insts = func.block_insts(block, alloc: self.alloc)
    if insts.len() == 0 {
        return None
    }
    return match func.inst_data(insts[insts.len() - 1]) {
        clif::InstructionData.Jump(opcode: _, destination: destination) => Some(self.destination(destination.block))
        else => None
    }
} Facts.jump_target

/// Blocks laid out in chains: the block after and before each in its chain, `NONE` for none,
/// and each block's representative among the blocks of its chain.
struct Chains {
    next: mem::List[u32]
    previous: mem::List[u32]
    roots: mem::List[u32]
} Chains

fn Chains.of(count: usize, alloc: mem::Alloc) -> Chains {
    var roots = mem::List[u32].empty(alloc)
    for index in 0..<count {
        mut roots.push(u32.fit(index))
    }
    return Chains(next: filled(count, value: NONE, alloc), previous: filled(count, value: NONE, alloc), roots: take roots)
} Chains.of

/// The representative of a block's chain.
fn Chains.root(mut self, block: u32) -> u32 {
    var walk = block
    loop {
        expect usize.widen(walk) < self.roots.len()
        let up = self.roots[usize.widen(walk)]
        if up == walk {
            return walk
        }
        expect usize.widen(up) < self.roots.len()
        self.roots[usize.widen(walk)] = self.roots[usize.widen(up)]
        walk = up
    }
} Chains.root

/// Joins the chain ending in `block` and the chain starting with `after`, when they are two.
fn Chains.link(mut self, block: u32, after: u32) {
    let at = usize.widen(block)
    let to = usize.widen(after)
    expect at < self.next.len() and to < self.previous.len()
    if self.next[at] != NONE or self.previous[to] != NONE {
        return
    }
    let ending = mut self.root(block)
    let starting = mut self.root(after)
    if ending == starting {
        return
    }
    self.next[at] = after
    self.previous[to] = block
    expect usize.widen(starting) < self.roots.len()
    self.roots[usize.widen(starting)] = ending
} Chains.link

/// Moves each loop's header ending in a branch that leaves the loop or goes on in it right after
/// the one block of the loop jumping back to it, so that the jump falls through into the test.
fn rotate_loops(func: clif::Function, loops: Loops, mut order: mem::List[clif::Block], alloc: mem::Alloc) {
    for id in 0..<loops.list.len() {
        let header = loops.list[id].header
        let latch = jumping_back(func, loops, id: u32.fit(id), header, alloc)
        if latch == NONE or not tests_staying(func, loops, id: u32.fit(id), header, alloc) {
            continue
        }
        let Some(from) = order.position(fn(block: clif::Block) => block.index == header) else {
            continue
        }
        let Some(to) = order.position(fn(block: clif::Block) => block.index == latch) else {
            continue
        }
        if to <= from {
            continue
        }
        let moved = order[from]
        for at in from..<to {
            order[at] = order[at + 1]
        }
        order[to] = moved
    }
} rotate_loops

/// The one block of a loop branching to its header, when it ends with a jump; `NONE` otherwise.
fn jumping_back(func: clif::Function, loops: Loops, id: u32, header: u32, alloc: mem::Alloc) -> u32 {
    var latch = NONE
    for block in func.layout_blocks(alloc) {
        if not loops.holds(id, block: block.index) {
            continue
        }
        for target in targets_of(func, block, alloc) {
            if target.index == header {
                if latch != NONE {
                    return NONE
                }
                latch = block.index
            }
        }
    }
    if latch == NONE {
        return NONE
    }
    let insts = func.block_insts(clif::Block(index: latch), alloc)
    expect insts.len() > 0
    return match func.inst_data(insts[insts.len() - 1]) {
        clif::InstructionData.Jump(opcode: _, destination: _) => latch
        else => NONE
    }
} jumping_back

/// Whether a loop's header ends with a branch whose one target lies in the loop and the other
/// outside it.
fn tests_staying(func: clif::Function, loops: Loops, id: u32, header: u32, alloc: mem::Alloc) -> bool {
    let insts = func.block_insts(clif::Block(index: header), alloc)
    if insts.len() == 0 {
        return false
    }
    return match func.inst_data(insts[insts.len() - 1]) {
        clif::InstructionData.Brif(opcode: _, arg: _, then: then_call, otherwise: else_call) => loops.holds(id, block: then_call.block.index) != loops.holds(id, block: else_call.block.index)
        else => false
    }
} tests_staying

/// A block's index in the code, `NONE` for one no path from the entry reaches.
fn Facts.position_of(self, block: clif::Block) -> u32 {
    let at = usize.widen(block.index)
    expect at < self.positions.len()
    return self.positions[at]
} Facts.position_of

/// Numbers the reachable blocks in emission order, each followed by the blocks its conditional
/// branch's edges with arguments go through.
fn Facts.place_blocks(mut self, func: clif::Function) {
    let seen = self.reachable(func)
    for index in 0..<seen.len() {
        if seen[index] {
            expect index < self.positions.len()
            self.positions[index] = 0
        }
    }
    self.sequence = self.emission_order(func, seen: seen.view())
    var next: u32 = 0
    for block in self.order(func) {
        let at = usize.widen(block.index)
        expect at < self.positions.len() and at < self.then_edges.len() and at < self.else_edges.len()
        self.positions[at] = next
        next += 1
        let insts = func.block_insts(block, alloc: self.alloc)
        if insts.len() == 0 {
            continue
        }
        let clif::InstructionData.Brif(opcode: _, arg: _, then: then_call, otherwise: else_call) = func.inst_data(insts[insts.len() - 1]) else {
            continue
        }
        if self.merges(then_call, else_call) {
            continue
        }
        if then_call.args.len() > 0 {
            self.then_edges[at] = next
            next += 1
        }
        if else_call.args.len() > 0 {
            self.else_edges[at] = next
            next += 1
        }
    }
} Facts.place_blocks

/// Records which instruction of reachable code defines each value, which instructions are live,
/// and how often live instructions use each value.
fn Facts.count_values(mut self, func: clif::Function) {
    var count: usize = 0
    for block in self.order(func) {
        for param in func.block_params(block, alloc: self.alloc) {
            expect usize.widen(param.index) < self.homes.len()
            self.homes[usize.widen(param.index)] = block.index
        }
        for inst in func.block_insts(block, alloc: self.alloc) {
            for result in func.inst_results(inst, alloc: self.alloc) {
                expect usize.widen(result.index) < self.defs.len() and usize.widen(result.index) < self.homes.len()
                self.defs[usize.widen(result.index)] = inst.index
                self.homes[usize.widen(result.index)] = block.index
            }
            count = larger_index(count, index: inst.index)
        }
    }
    self.live = self.live_insts(func, count)
    for block in self.order(func) {
        for inst in func.block_insts(block, alloc: self.alloc) {
            if not self.is_live(inst) {
                continue
            }
            each_operand(func.inst_data(inst), visit: fn[mut self](value: clif::Value) {
                let at = usize.widen(func.resolve_aliases(value).index)
                expect at < self.use_counts.len()
                self.use_counts[at] += 1
            })
        }
    }
} Facts.count_values

/// The live instructions of reachable code, by instruction index: those with an effect or ending
/// their block, then each one a live instruction reads a result of.
fn Facts.live_insts(self, func: clif::Function, count: usize) -> mem::List[bool] {
    var live = filled(count, value: false, alloc: self.alloc)
    var pending = mem::List[u32].empty(self.alloc)
    for block in self.order(func) {
        for inst in func.block_insts(block, alloc: self.alloc) {
            if not only_computes(func, inst, alloc: self.alloc) {
                expect usize.widen(inst.index) < live.len()
                live[usize.widen(inst.index)] = true
                mut pending.push(inst.index)
            }
        }
    }
    loop {
        let Some(at) = mut pending.pop() else {
            return live
        }
        each_operand(func.inst_data(clif::Inst(index: at)), visit: fn[mut live, mut pending](value: clif::Value) {
            let value_at = usize.widen(func.resolve_aliases(value).index)
            expect value_at < self.defs.len()
            let def = self.defs[value_at]
            if def != NONE and not live[usize.widen(def)] {
                live[usize.widen(def)] = true
                mut pending.push(def)
            }
        })
    }
} Facts.live_insts

/// Whether an instruction only computes values, so that it is dead when nothing reads them: one
/// hoisting moves, a load that cannot fault, or the address of a stack slot, symbol or function.
fn only_computes(func: clif::Function, inst: clif::Inst, alloc: mem::Alloc) -> bool {
    if is_hoistable(func, inst, alloc) {
        return true
    }
    return match func.inst_data(inst) {
        clif::InstructionData.Load(opcode: clif::Opcode.Load, flags: flags, arg: _, offset: _) => flags.notrap
        clif::InstructionData.StackLoad(opcode: _, slot: _, offset: _) or clif::InstructionData.FuncAddr(opcode: _, func_ref: _) => true
        clif::InstructionData.UnaryGlobalValue(opcode: opcode, global_value: _) => opcode == clif::Opcode.SymbolValue
        else => false
    }
} only_computes

/// Whether an instruction is live.
fn Facts.is_live(self, inst: clif::Inst) -> bool {
    let at = usize.widen(inst.index)
    return at < self.live.len() and self.live[at]
} Facts.is_live

/// Shows `visit` each value an instruction reads, branch arguments included.
fn each_operand(data: clif::InstructionData, visit: fn(value: clif::Value)) {
    match data {
        clif::InstructionData.Unary(opcode: _, arg: arg) or clif::InstructionData.Load(opcode: _, flags: _, arg: arg, offset: _) or clif::InstructionData.LoadNoOffset(opcode: _, flags: _, arg: arg) => visit(arg)
        clif::InstructionData.Binary(opcode: _, x: x, y: y) or clif::InstructionData.IntCompare(opcode: _, cond: _, x: x, y: y) or clif::InstructionData.FloatCompare(opcode: _, cond: _, x: x, y: y) => {
            visit(x)
            visit(y)
        }
        clif::InstructionData.Store(opcode: _, flags: _, x: x, p: p, offset: _) or clif::InstructionData.StoreNoOffset(opcode: _, flags: _, x: x, p: p) or clif::InstructionData.AtomicRmw(opcode: _, flags: _, op: _, p: p, x: x) => {
            visit(x)
            visit(p)
        }
        clif::InstructionData.Ternary(opcode: _, x: x, y: y, z: z) or clif::InstructionData.AtomicCas(opcode: _, flags: _, p: x, e: y, x: z) => {
            visit(x)
            visit(y)
            visit(z)
        }
        clif::InstructionData.Call(opcode: _, func_ref: _, args: args) or clif::InstructionData.MultiAry(opcode: _, args: args) => each_value(args.view(), visit)
        clif::InstructionData.CallIndirect(opcode: _, sig_ref: _, callee: callee, args: args) => {
            visit(callee)
            each_value(args.view(), visit)
        }
        clif::InstructionData.Jump(opcode: _, destination: destination) => each_value(destination.args.view(), visit)
        clif::InstructionData.Brif(opcode: _, arg: arg, then: then_call, otherwise: else_call) => {
            visit(arg)
            each_value(then_call.args.view(), visit)
            each_value(else_call.args.view(), visit)
        }
        else => {}
    }
} each_operand

fn each_value(values: Slice[clif::Value], visit: fn(value: clif::Value)) {
    for value in values {
        visit(value)
    }
} each_value

fn filled[T: Copy](count: usize, value: T, alloc: mem::Alloc) -> mem::List[T] {
    var list = mem::List[T].empty(alloc)
    for _ in 0..<count {
        mut list.push(value)
    }
    return list
} filled

fn larger(value: u32, other: u32) -> u32
    ensures result >= value and result >= other
{
    if value > other {
        return value
    }
    return other
} larger

/// The least multiple of `to`, a power of two, at or above `value`.
fn round_up(value: u32, to: u32) -> u32
    requires to > 0 and value <= 0xFFFF_FFFF - to
{
    return (value + to - 1) & ~(to - 1)
} round_up

fn slot_align(data: clif::StackSlotData) -> u32
    ensures result >= 8
{
    return larger(8, other: 1u32 << u32.widen(data.align_shift))
} slot_align

/// Marks the flags of the overflowing operations each block's conditional branch tests right
/// after them, directly or through one `bxor` with 1, when nothing else reads them and only
/// constants come between, and those `bxor`s.
fn Facts.fuse_overflow_checks(mut self, func: clif::Function) {
    for block in self.order(func) {
        let insts = func.block_insts(block, alloc: self.alloc)
        let count = insts.len()
        if count < 2 {
            continue
        }
        let clif::InstructionData.Brif(opcode: _, arg: arg, then: _, otherwise: _) = func.inst_data(insts[count - 1]) else {
            continue
        }
        let tested = func.resolve_aliases(arg)
        let inverted = self.inverted_of(func, value: tested)
        let flag = match inverted {
            Some(value) => value
            None => tested
        }
        if self.is_overflow_flag_before(func, flag, tested, insts: insts.view()) {
            mut self.mark_fused(flag)
            mut self.mark_fused(tested)
        }
    }
} Facts.fuse_overflow_checks

/// The value a `bxor` with 1 inverts when it defines `value`, a value only a branch reads, and
/// nothing else reads what it inverts.
fn Facts.inverted_of(self, func: clif::Function, value: clif::Value) -> Option[clif::Value] {
    let at = usize.widen(value.index)
    expect at < self.defs.len() and at < self.use_counts.len()
    let def = self.defs[at]
    if def == NONE or self.use_counts[at] != 1 {
        return None
    }
    let clif::InstructionData.Binary(opcode: clif::Opcode.Bxor, x: x, y: y) = func.inst_data(clif::Inst(index: def)) else {
        return None
    }
    let inverted = func.resolve_aliases(x)
    let reads = usize.widen(inverted.index)
    expect reads < self.use_counts.len()
    if self.constant(y, func) != Some(1) or self.use_counts[reads] != 1 {
        return None
    }
    return Some(inverted)
} Facts.inverted_of

/// Whether `flag` is the flag of an overflowing operation that nothing but `tested`, the value a
/// block's last instruction tests, reads, and that only constants, dead instructions and the
/// definition of `tested` follow before that instruction.
fn Facts.is_overflow_flag_before(self, func: clif::Function, flag: clif::Value, tested: clif::Value, insts: Slice[clif::Inst]) -> bool {
    let at = usize.widen(flag.index)
    let tested_at = usize.widen(tested.index)
    expect at < self.defs.len() and at < self.use_counts.len() and tested_at < self.defs.len()
    let def = self.defs[at]
    if def == NONE or self.use_counts[at] != 1 or not overflows(func.inst_data(clif::Inst(index: def)).opcode()) {
        return false
    }
    let results = func.inst_results(clif::Inst(index: def), alloc: self.alloc)
    if results.len() != 2 or results[1] != flag {
        return false
    }
    var index = insts.len() - 1
    while index > 0 {
        index -= 1
        let inst = insts[index]
        if inst.index == def {
            return true
        }
        if inst.index != self.defs[tested_at] and not is_constant_inst(func.inst_data(inst)) and self.is_live(inst) {
            return false
        }
    }
    return false
} Facts.is_overflow_flag_before

/// Whether an instruction is an `iconst`, `f32const` or `f64const`, which selection emits nothing
/// for.
fn is_constant_inst(data: clif::InstructionData) -> bool {
    return match data {
        clif::InstructionData.UnaryImm(opcode: _, imm: _) or clif::InstructionData.UnaryIeee32(opcode: _, bits: _) or clif::InstructionData.UnaryIeee64(opcode: _, bits: _) => true
        else => false
    }
} is_constant_inst

/// Marks each value an instruction reads in a way that can show a NaN's bits.
fn Facts.mark_shown_values(mut self, func: clif::Function) {
    for block in self.order(func) {
        for inst in func.block_insts(block, alloc: self.alloc) {
            let data = func.inst_data(inst)
            if hides_nan_bits(data) or not self.is_live(inst) {
                continue
            }
            each_operand(data, visit: fn[mut self](value: clif::Value) {
                let at = usize.widen(func.resolve_aliases(value).index)
                expect at < self.shown.len()
                self.shown[at] = true
            })
        }
    }
} Facts.mark_shown_values

/// Whether an instruction reads its operands without showing a NaN operand's bits: float
/// arithmetic whose result is a NaN whenever an operand is one, a float comparison, or a
/// conversion of a float to an integer, which gives the same integer for every NaN.
fn hides_nan_bits(data: clif::InstructionData) -> bool {
    return match data {
        clif::InstructionData.Binary(opcode: opcode, x: _, y: _) => opcode == clif::Opcode.Fadd or opcode == clif::Opcode.Fsub or opcode == clif::Opcode.Fmul or opcode == clif::Opcode.Fdiv
        clif::InstructionData.Unary(opcode: opcode, arg: _) => opcode == clif::Opcode.Sqrt or opcode == clif::Opcode.FcvtToSintSat or opcode == clif::Opcode.FcvtToUintSat
        clif::InstructionData.FloatCompare(opcode: _, cond: _, x: _, y: _) => true
        else => false
    }
} hides_nan_bits

/// Whether some instruction can show the bits of a NaN a value holds.
fn Facts.is_shown(self, func: clif::Function, value: clif::Value) -> bool {
    let at = usize.widen(func.resolve_aliases(value).index)
    return at >= self.shown.len() or self.shown[at]
} Facts.is_shown

/// Whether an opcode is an arithmetic operation that also gives the flag of its overflow.
fn overflows(opcode: clif::Opcode) -> bool {
    return match opcode {
        clif::Opcode.UaddOverflow or clif::Opcode.SaddOverflow or clif::Opcode.UsubOverflow or clif::Opcode.SsubOverflow or clif::Opcode.UmulOverflow or clif::Opcode.SmulOverflow => true
        else => false
    }
} overflows

fn Facts.mark_fused(mut self, value: clif::Value) {
    let at = usize.widen(value.index)
    expect at < self.fused.len()
    self.fused[at] = true
} Facts.mark_fused

/// Whether a value is a flag the conditional branch ending its block reads from the processor's
/// flags, or the `bxor` inverting one for it.
fn Facts.fuses(self, func: clif::Function, value: clif::Value) -> bool {
    let at = usize.widen(func.resolve_aliases(value).index)
    return at < self.fused.len() and self.fused[at]
} Facts.fuses

/// The constant a value is, when an `iconst`, `f32const` or `f64const` defines it: its bits.
fn Facts.constant(self, value: clif::Value, func: clif::Function) -> Option[u64] {
    let at = usize.widen(func.resolve_aliases(value).index)
    expect at < self.defs.len()
    let def = self.defs[at]
    if def == NONE {
        return None
    }
    match func.inst_data(clif::Inst(index: def)) {
        clif::InstructionData.UnaryImm(opcode: _, imm: imm) => return Some(imm.to_bits())
        clif::InstructionData.UnaryIeee32(opcode: _, bits: bits) => return Some(u64.widen(bits))
        clif::InstructionData.UnaryIeee64(opcode: _, bits: bits) => return Some(bits)
        else => return None
    }
} Facts.constant

/// The overflowing addition or subtraction whose overflow alone sends to a cold block that traps
/// the branch ending the one block branching there.
fn Facts.overflow_sending(self, func: clif::Function, block: clif::Block) -> Option[clif::Inst] {
    let at = usize.widen(block.index)
    expect at < self.single.len()
    let from = self.single[at]
    if from == NONE or not is_trap_block(func, block, alloc: self.alloc) {
        return None
    }
    let insts = func.block_insts(clif::Block(index: from), alloc: self.alloc)
    expect insts.len() > 0
    let clif::InstructionData.Brif(opcode: _, arg: arg, then: then_call, otherwise: else_call) = func.inst_data(insts[insts.len() - 1]) else {
        return None
    }
    let Inverse(value: flag, inverted: inverted) = inverse_of(func, value: arg, alloc: self.alloc)
    let sent = if inverted {
        else_call.block
    } else {
        then_call.block
    }
    if sent != block or then_call.block == else_call.block {
        return None
    }
    let Some(def) = func.value_inst(flag) else {
        return None
    }
    let clif::InstructionData.Binary(opcode: opcode, x: _, y: _) = func.inst_data(def) else {
        return None
    }
    let rebuildable = opcode == clif::Opcode.UaddOverflow or opcode == clif::Opcode.SaddOverflow or opcode == clif::Opcode.UsubOverflow or opcode == clif::Opcode.SsubOverflow
    if not rebuildable or second_result_of(func, inst: def, alloc: self.alloc) != func.resolve_aliases(flag) {
        return None
    }
    return Some(def)
} Facts.overflow_sending

/// Whether a load gives an integer value, which selection writes zero-extended to the whole
/// register.
fn Facts.is_loaded(self, func: clif::Function, value: clif::Value) -> bool {
    let at = usize.widen(func.resolve_aliases(value).index)
    expect at < self.defs.len()
    let def = self.defs[at]
    if def == NONE or not func.value_type(value).is_int() {
        return false
    }
    return match func.inst_data(clif::Inst(index: def)) {
        clif::InstructionData.Load(opcode: clif::Opcode.Load, flags: _, arg: _, offset: _) => true
        else => false
    }
} Facts.is_loaded

/// Whether reachable code reads a value nowhere.
fn Facts.is_unread(self, func: clif::Function, value: clif::Value) -> bool {
    let at = usize.widen(func.resolve_aliases(value).index)
    expect at < self.use_counts.len()
    return self.use_counts[at] == 0
} Facts.is_unread

/// The first result of an instruction.
fn result_of(func: clif::Function, inst: clif::Inst, alloc: mem::Alloc) -> clif::Value {
    let results = func.inst_results(inst, alloc)
    expect results.len() > 0
    return results[0]
} result_of

/// The second result of an instruction.
fn second_result_of(func: clif::Function, inst: clif::Inst, alloc: mem::Alloc) -> clif::Value {
    let results = func.inst_results(inst, alloc)
    expect results.len() > 1
    return results[1]
} second_result_of

/// The operands of a commutative operation with a constant one last.
fn Facts.commuted(self, func: clif::Function, x: clif::Value, y: clif::Value) -> Operands {
    if self.constant(x, func).is_some() and self.constant(y, func).is_none() {
        return Operands(x: y, y: x)
    }
    return Operands(x: x, y: y)
} Facts.commuted

struct Operands derives Copy, Eq {
    x: clif::Value
    y: clif::Value
} Operands

/// A 32- or 64-bit multiplication by a constant an immediate holds, from 2 up: the other operand
/// and the constant.
struct Factor derives Copy, Eq {
    value: clif::Value
    factor: u64
} Factor

/// The operand and constant of a 32- or 64-bit multiplication by a constant from 2 below 2^31.
fn Facts.factor_of(self, func: clif::Function, x: clif::Value, y: clif::Value) -> Option[Factor] {
    let bits = func.value_type(x).bits()
    if bits != 32 and bits != 64 {
        return None
    }
    let operands = self.commuted(func, x, y)
    let Some(constant) = self.constant(operands.y, func) else {
        return None
    }
    let factor = constant & width_mask(bits)
    if factor < 2 or factor >= 0x8000_0000 {
        return None
    }
    return Some(Factor(value: operands.x, factor: factor))
} Facts.factor_of

/// Whether `kept` lives on past an instruction defining `result` from it and `spent` while
/// `spent` ends there: other instructions read `kept`, or another block defines it, while that
/// instruction alone reads `spent`, which its block defines.
fn Facts.outlives(self, func: clif::Function, kept: clif::Value, spent: clif::Value, result: clif::Value) -> bool {
    let kept_at = usize.widen(func.resolve_aliases(kept).index)
    let spent_at = usize.widen(func.resolve_aliases(spent).index)
    let result_at = usize.widen(func.resolve_aliases(result).index)
    expect kept_at < self.use_counts.len() and spent_at < self.use_counts.len() and result_at < self.homes.len()
    let home = self.homes[result_at]
    let kept_lives = self.use_counts[kept_at] > 1 or self.homes[kept_at] != home
    return kept_at != spent_at and kept_lives and self.use_counts[spent_at] == 1 and self.homes[spent_at] == home
} Facts.outlives

/// The value and amount of a right rotation `x | y` computes of a 32- or 64-bit integer, when
/// one operand shifts it right and the other left by the rest of the width, and only the `bor`
/// reads either.
fn Facts.rotation(self, func: clif::Function, x: clif::Value, y: clif::Value) -> Option[Shifted] {
    let width = func.value_type(x).bits()
    if width != 32 and width != 64 {
        return None
    }
    let Some(right) = self.shifted(func, value: x, opcode: clif::Opcode.Ushr) else {
        let Some(left_first) = self.shifted(func, value: x, opcode: clif::Opcode.Ishl) else {
            return None
        }
        let Some(right_second) = self.shifted(func, value: y, opcode: clif::Opcode.Ushr) else {
            return None
        }
        return rotation_of(func, right: right_second, left: left_first, width: width)
    }
    let Some(left) = self.shifted(func, value: y, opcode: clif::Opcode.Ishl) else {
        return None
    }
    return rotation_of(func, right, left, width: width)
} Facts.rotation

/// A right and a left shift of one value whose amounts add up to the width, as a right rotation.
fn rotation_of(func: clif::Function, right: Shifted, left: Shifted, width: u32) -> Option[Shifted] {
    if func.resolve_aliases(right.value) != func.resolve_aliases(left.value) or u32.widen(right.amount) + u32.widen(left.amount) != width {
        return None
    }
    return Some(right)
} rotation_of

/// The value a single-use shift by a constant between 1 and 63 of an opcode defining `value`
/// shifts, with the amount.
fn Facts.shifted(self, func: clif::Function, value: clif::Value, opcode: clif::Opcode) -> Option[Shifted] {
    let resolved = func.resolve_aliases(value)
    let at = usize.widen(resolved.index)
    expect at < self.defs.len() and at < self.use_counts.len()
    let def = self.defs[at]
    if def == NONE or self.use_counts[at] != 1 {
        return None
    }
    let clif::InstructionData.Binary(opcode: found, x: shifted, y: amount) = func.inst_data(clif::Inst(index: def)) else {
        return None
    }
    if found != opcode {
        return None
    }
    let Some(bits) = self.constant(amount, func) else {
        return None
    }
    if bits == 0 or bits > 63 {
        return None
    }
    return Some(Shifted(value: shifted, amount: u8.truncate(bits)))
} Facts.shifted

/// A value and a constant amount it is shifted or rotated by.
struct Shifted derives Copy, Eq {
    value: clif::Value
    amount: u8
} Shifted

/// The exponent of a power of two.
fn power_of_two(value: i32) -> Option[u8] {
    if value <= 0 {
        return None
    }
    let bits = value.to_bits()
    if (bits & (bits - 1)) != 0 {
        return None
    }
    return Some(u8.truncate(bits.trailing_zeros()))
} power_of_two

/// The comparison of the operands in the other order that holds exactly when `cond` does.
/// The comparison with 0 of a value of type `ty` taken as signed that answers an unsigned
/// comparison of the value with a constant, when the constant is the largest signed number of
/// that width and the comparison asks for at most it or above it, or the smallest and it asks for
/// below it or at least it.
fn sign_test(cond: clif::IntCC, constant: Option[u64], ty: clif::Type) -> Option[clif::IntCC] {
    let Some(bits) = constant else {
        return None
    }
    let width = ty.bits()
    let top = 1u64 << (width - 1)
    let value = if width >= 64 {
        bits
    } else {
        bits & ((1u64 << width) - 1)
    }
    if (cond == clif::IntCC.UnsignedLessThanOrEqual and value == top - 1) or (cond == clif::IntCC.UnsignedLessThan and value == top) {
        return Some(clif::IntCC.SignedGreaterThanOrEqual)
    }
    if (cond == clif::IntCC.UnsignedGreaterThan and value == top - 1) or (cond == clif::IntCC.UnsignedGreaterThanOrEqual and value == top) {
        return Some(clif::IntCC.SignedLessThan)
    }
    return None
} sign_test

fn swapped(cond: clif::IntCC) -> clif::IntCC {
    return match cond {
        clif::IntCC.SignedLessThan => clif::IntCC.SignedGreaterThan
        clif::IntCC.SignedGreaterThanOrEqual => clif::IntCC.SignedLessThanOrEqual
        clif::IntCC.SignedGreaterThan => clif::IntCC.SignedLessThan
        clif::IntCC.SignedLessThanOrEqual => clif::IntCC.SignedGreaterThanOrEqual
        clif::IntCC.UnsignedLessThan => clif::IntCC.UnsignedGreaterThan
        clif::IntCC.UnsignedGreaterThanOrEqual => clif::IntCC.UnsignedLessThanOrEqual
        clif::IntCC.UnsignedGreaterThan => clif::IntCC.UnsignedLessThan
        clif::IntCC.UnsignedLessThanOrEqual => clif::IntCC.UnsignedGreaterThanOrEqual
        else => cond
    }
} swapped

/// A comparison, or an overflowing operation whose flag is fused, deciding whether a value is not
/// zero, holding exactly then or, when `inverted`, exactly otherwise.
struct Decider derives Copy, Eq {
    compare: clif::Inst
    inverted: bool
} Decider

/// The comparison deciding whether a value is not zero: the one defining it, the one deciding a
/// value it extends or tests against zero or, when that value is a flag, masks by a `band` with 1
/// or inverts by a `bxor` with 1, or the one deciding the condition of a select of 1 and 0
/// defining it; or the overflowing operation whose fused flag, inverted by a fused `bxor` or not,
/// defines it.
fn Facts.decider(self, func: clif::Function, value: clif::Value) -> Option[Decider] {
    var current = value
    var inverted = false
    loop {
        let at = usize.widen(func.resolve_aliases(current).index)
        expect at < self.defs.len()
        let def = self.defs[at]
        if def == NONE {
            return None
        }
        let inst = clif::Inst(index: def)
        match func.inst_data(inst) {
            clif::InstructionData.IntCompare(opcode: _, cond: cond, x: x, y: y) => {
                if (cond == clif::IntCC.Equal or cond == clif::IntCC.NotEqual) and self.constant(y, func) == Some(0) and self.constant(x, func).is_none() and self.is_flag(func, value: x) {
                    current = x
                    inverted = inverted != (cond == clif::IntCC.Equal)
                    continue
                }
                return Some(Decider(compare: inst, inverted: inverted))
            }
            clif::InstructionData.FloatCompare(opcode: _, cond: _, x: _, y: _) => return Some(Decider(compare: inst, inverted: inverted))
            clif::InstructionData.Binary(opcode: opcode, x: x, y: y) => {
                let operands = self.commuted(func, x, y)
                if (opcode == clif::Opcode.Band or opcode == clif::Opcode.Bxor) and self.constant(operands.y, func) == Some(1) and self.is_flag(func, value: operands.x) {
                    current = operands.x
                    inverted = inverted != (opcode == clif::Opcode.Bxor)
                    continue
                }
                if not self.fuses(func, value: current) {
                    return None
                }
                if opcode != clif::Opcode.Bxor {
                    return Some(Decider(compare: inst, inverted: inverted))
                }
                current = x
                inverted = not inverted
            }
            clif::InstructionData.Unary(opcode: clif::Opcode.Uextend, arg: arg) => {
                current = arg
            }
            clif::InstructionData.Ternary(opcode: clif::Opcode.Select, x: c, y: chosen, z: other) => {
                let picked = self.constant(chosen, func)
                let left = self.constant(other, func)
                if picked == Some(1) and left == Some(0) {
                    current = c
                } else if picked == Some(0) and left == Some(1) {
                    current = c
                    inverted = not inverted
                } else {
                    return None
                }
            }
            else => return None
        }
    }
} Facts.decider

/// Whether a value is a comparison's flag or one extended or chosen from 1 and 0 by a select.
fn Facts.is_flag(self, func: clif::Function, value: clif::Value) -> bool {
    let at = usize.widen(func.resolve_aliases(value).index)
    expect at < self.defs.len()
    let def = self.defs[at]
    if def == NONE {
        return false
    }
    return match func.inst_data(clif::Inst(index: def)) {
        clif::InstructionData.IntCompare(opcode: _, cond: _, x: _, y: _) or clif::InstructionData.FloatCompare(opcode: _, cond: _, x: _, y: _) => true
        clif::InstructionData.Unary(opcode: clif::Opcode.Uextend, arg: arg) => self.is_flag(func, value: arg)
        clif::InstructionData.Ternary(opcode: clif::Opcode.Select, x: _, y: chosen, z: other) => (self.constant(chosen, func) == Some(1) and self.constant(other, func) == Some(0)) or (self.constant(chosen, func) == Some(0) and self.constant(other, func) == Some(1))
        else => false
    }
} Facts.is_flag

/// Where an edge of a conditional branch jumps: the block passing its arguments, or its target.
fn Facts.target_of(self, edge: u32, block: clif::Block) -> u32 {
    if edge != NONE {
        return edge
    }
    return self.position_of(self.destination(block))
} Facts.target_of

/// The index of the chain a block heads, `NONE` for one heading none.
fn Facts.switch_of(self, block: clif::Block) -> u32 {
    let at = usize.widen(block.index)
    expect at < self.switches.heads.len()
    return self.switches.heads[at]
} Facts.switch_of
