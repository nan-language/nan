//! The Advanced SIMD instructions on whole 128-bit vector registers, and `sdot` of FEAT_DotProd: their operations, with the words that encode them.

/// An operation of two vector registers' lanes, of the lane size its instruction gives where its
/// encoding has one: integer, bitwise, or on single-precision floats.
pkg enum VecOp derives Copy, Eq {
    Add
    Sub
    Mul
    Sqadd
    Uqadd
    Sqsub
    Uqsub
    Cmeq
    Cmgt
    Cmhi
    Sshl
    Ushl
    Addp
    And
    Orr
    Eor
    Fadd
    Fsub
    Fmul
    Fdiv
    Fmin
    Fmax
    Fcmeq
    Fcmgt
} VecOp

/// The word of an operation with Q set, its lane size field clear, for an integer operation of
/// sized lanes.
fn VecOp.word(self) -> u32 {
    return match self {
        VecOp.Add => 0x4E20_8400
        VecOp.Sub => 0x6E20_8400
        VecOp.Mul => 0x4E20_9C00
        VecOp.Sqadd => 0x4E20_0C00
        VecOp.Uqadd => 0x6E20_0C00
        VecOp.Sqsub => 0x4E20_2C00
        VecOp.Uqsub => 0x6E20_2C00
        VecOp.Cmeq => 0x6E20_8C00
        VecOp.Cmgt => 0x4E20_3400
        VecOp.Cmhi => 0x6E20_3400
        VecOp.Sshl => 0x4E20_4400
        VecOp.Ushl => 0x6E20_4400
        VecOp.Addp => 0x4E20_BC00
        VecOp.And => 0x4E20_1C00
        VecOp.Orr => 0x4EA0_1C00
        VecOp.Eor => 0x6E20_1C00
        VecOp.Fadd => 0x4E20_D400
        VecOp.Fsub => 0x4EA0_D400
        VecOp.Fmul => 0x6E20_DC00
        VecOp.Fdiv => 0x6E20_FC00
        VecOp.Fmin => 0x4EA0_F400
        VecOp.Fmax => 0x4E20_F400
        VecOp.Fcmeq => 0x4E20_E400
        VecOp.Fcmgt => 0x6EA0_E400
    }
} VecOp.word

/// Whether the operation's encoding has a lane size field.
fn VecOp.is_sized(self) -> bool {
    return match self {
        VecOp.And or VecOp.Orr or VecOp.Eor or VecOp.Fadd or VecOp.Fsub or VecOp.Fmul or VecOp.Fdiv or VecOp.Fmin or VecOp.Fmax or VecOp.Fcmeq or VecOp.Fcmgt => false
        else => true
    }
} VecOp.is_sized

/// An operation of one vector register's lanes: the bitwise negation, the comparison of each lane
/// with zero, the single-precision square root and conversions from and to 32-bit integers, and
/// the sign-extension of the low or high half's lanes to twice their width.
pkg enum VecUnary derives Copy, Eq {
    Not
    Cmeq0
    Fsqrt
    Scvtf
    Fcvtzs
    Sxtl
    Sxtl2
} VecUnary

/// The word of an operation, its lane size field clear for one comparing sized lanes, and for a
/// sign-extension that of 8-bit lanes.
fn VecUnary.word(self) -> u32 {
    return match self {
        VecUnary.Not => 0x6E20_5800
        VecUnary.Cmeq0 => 0x4E20_9800
        VecUnary.Fsqrt => 0x6EA1_F800
        VecUnary.Scvtf => 0x4E21_D800
        VecUnary.Fcvtzs => 0x4EA1_B800
        VecUnary.Sxtl => 0x0F08_A400
        VecUnary.Sxtl2 => 0x4F08_A400
    }
} VecUnary.word

/// The word of an operation on lanes of `1 << size` bytes, `size` below 4.
fn VecUnary.sized(self, size: u32) -> u32 {
    let lanes = size & 3
    return match self {
        VecUnary.Cmeq0 => self.word() | (lanes << 22)
        VecUnary.Sxtl or VecUnary.Sxtl2 => (self.word() & ~0x0078_0000u32) | (0x0008_0000u32 << lanes)
        else => self.word()
    }
} VecUnary.sized
