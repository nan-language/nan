//! Owned and inline text, interning and writers.

pub open struct String {
} String

pub fn String.empty(alloc: mem::Alloc) -> String
    ensures result.byte_len() == 0
    example String.empty(testing::world().alloc).is_empty()

pub fn String.of(text: Str, alloc: mem::Alloc) -> String
    example String.of("café", alloc: testing::world().alloc).as_str() == "café"
{
    var out = String.empty(alloc)
    mut out.append(text)
    return out
} String.of

pub fn String.try_of(text: Str, alloc: mem::Alloc) -> String fails mem::OutOfMemory
    example attempt String.try_of("ab", alloc: testing::world().alloc) == Ok(String.of("ab", alloc: testing::world().alloc))
{
    var out = String.empty(alloc)
    try mut out.try_append(text)
    return out
} String.try_of

pub fn String.try_from_utf8(bytes: Slice[u8], alloc: mem::Alloc) -> String fails utf8::Utf8Error
    example attempt String.try_from_utf8(b"ok\xFF", alloc: testing::world().alloc) == Err(utf8::Utf8Error.Invalid(at: 2))
    example attempt String.try_from_utf8(b"\xC3\xA9", alloc: testing::world().alloc) == Ok(String.of("é", alloc: testing::world().alloc))
{
    let valid = utf8::valid_prefix(bytes)
    if valid != bytes.len() {
        fail utf8::Utf8Error.Invalid(at: valid)
    }
    var out = String.empty(alloc)
    for at in 0..<bytes.len() {
        let Some(c) = utf8::char_at(bytes, at) else {
            continue
        }
        try mut out.try_push(c)
    }
    return out
} String.try_from_utf8

pub proj fn String.as_str(self) -> Str
    example String.of("ab", alloc: testing::world().alloc).as_str() == "ab"

pub fn String.push(mut self, c: char)
    ensures self.byte_len() >= c.utf8_len() and self.byte_len() - c.utf8_len() == old(self.byte_len())

pub fn String.try_push(mut self, c: char) fails mem::OutOfMemory
    ensures self.byte_len() >= c.utf8_len() and self.byte_len() - c.utf8_len() == old(self.byte_len())

pub fn String.append(mut self, text: Str)
    ensures self.byte_len() >= text.byte_len() and self.byte_len() - text.byte_len() == old(self.byte_len())

pub fn String.try_append(mut self, text: Str) fails mem::OutOfMemory
    ensures self.byte_len() >= text.byte_len() and self.byte_len() - text.byte_len() == old(self.byte_len())

pub fn String.clear(mut self)
    ensures self.byte_len() == 0

pub fn String.into_bytes(take self) -> mem::Bytes
    ensures result.len() == old(self.byte_len())
    example String.of("é", alloc: testing::world().alloc).into_bytes().len() == 2

pub open struct Fixed[N: usize where N > 0] {
} Fixed

pub fn Fixed.empty() -> Fixed[N] limits pure, notrap, terminates
    ensures result.byte_len() == 0
    ensures result.room() == N
    example Fixed[4].empty().is_empty()

pub fn Fixed.of(text: Str) -> Fixed[N] limits notrap
    requires text.byte_len() <= N
    example Fixed[8].of("café").as_str() == "café"
{
    var out = Fixed[N].empty()
    mut out.append(text)
    return out
} Fixed.of

pub fn Fixed.try_of(text: Str) -> Fixed[N] fails mem::OutOfMemory limits notrap
    example attempt Fixed[2].try_of("abc") == Err(mem::OutOfMemory.Exhausted)
{
    if text.byte_len() > N {
        fail mem::OutOfMemory.Exhausted
    }
    return Fixed[N].of(text)
} Fixed.try_of

pub proj fn Fixed.as_str(self) -> Str
    ensures result.byte_len() <= N
    example Fixed[4].of("ab").as_str() == "ab"

pub fn Fixed.room(self) -> usize limits pure, notrap, terminates
    ensures result == N - self.byte_len()
    example Fixed[8].of("abc").room() == 5
{
    return N - self.byte_len()
} Fixed.room

pub fn Fixed.push(mut self, c: char) limits notrap
    requires c.utf8_len() <= self.room()
    ensures self.byte_len() >= c.utf8_len() and self.byte_len() - c.utf8_len() == old(self.byte_len())

pub fn Fixed.try_push(mut self, c: char) fails mem::OutOfMemory limits notrap
    ensures self.byte_len() >= c.utf8_len() and self.byte_len() - c.utf8_len() == old(self.byte_len())
{
    if c.utf8_len() > self.room() {
        fail mem::OutOfMemory.Exhausted
    }
    mut self.push(c)
} Fixed.try_push

pub fn Fixed.append(mut self, text: Str) limits notrap
    requires text.byte_len() <= self.room()
    ensures self.byte_len() >= text.byte_len() and self.byte_len() - text.byte_len() == old(self.byte_len())

pub fn Fixed.try_append(mut self, text: Str) fails mem::OutOfMemory limits notrap
    ensures self.byte_len() >= text.byte_len() and self.byte_len() - text.byte_len() == old(self.byte_len())
{
    if text.byte_len() > self.room() {
        fail mem::OutOfMemory.Exhausted
    }
    mut self.append(text)
} Fixed.try_append

pub fn Fixed.clear(mut self)
    ensures self.byte_len() == 0

pub closed struct Symbol derives Copy, Eq, Ord, Hash, Render {
    pub index: u32
} Symbol

pub open struct Interner {
} Interner

pub fn Interner.empty(alloc: mem::Alloc) -> Interner
    example Interner.empty(testing::world().alloc).len() == 0

pub fn Interner.intern(self, text: Str) -> Symbol
    example Interner.empty(testing::world().alloc).intern("a") == Symbol(index: 0)

pub fn Interner.try_intern(self, text: Str) -> Symbol fails mem::OutOfMemory
    example attempt Interner.empty(testing::world().alloc).try_intern("a") == Ok(Symbol(index: 0))

pub fn Interner.lookup(self, text: Str) -> Option[Symbol]
    example Interner.empty(testing::world().alloc).lookup("a") == None

pub proj fn Interner.resolve(self, symbol: Symbol) -> Str

pub fn Interner.len(self) -> usize

pub interface Writer {
    fn write(mut self, value: Dyn[Render], budget: usize)
    fn try_write(mut self, value: Dyn[Render], budget: usize) fails mem::OutOfMemory
} Writer

impl String: Writer

pub fn String.write(mut self, value: Dyn[Render], budget: usize)

pub fn String.try_write(mut self, value: Dyn[Render], budget: usize) fails mem::OutOfMemory

impl Fixed: Writer

pub fn Fixed.write(mut self, value: Dyn[Render], budget: usize)

pub fn Fixed.try_write(mut self, value: Dyn[Render], budget: usize) fails mem::OutOfMemory

pub proj fn String.as_bytes(self) -> Slice[u8] limits pure, notrap, terminates
    example String.of("é", alloc: testing::world().alloc).as_bytes() == b"\xC3\xA9"
{
    return self.as_str().as_bytes()
} String.as_bytes

pub proj fn String.cursor(self) -> core::CharCursor limits pure, notrap, terminates {
    return self.as_str().cursor()
} String.cursor

pub fn String.is_empty(self) -> bool limits pure, notrap, terminates
    ensures result == self.as_str().is_empty()
    example not String.of("a", alloc: testing::world().alloc).is_empty()
{
    return self.as_str().is_empty()
} String.is_empty

pub fn String.starts_with(self, prefix: Str) -> bool limits pure, notrap, terminates
    ensures result == self.as_str().starts_with(prefix)
    example String.of("port=80", alloc: testing::world().alloc).starts_with("port")
{
    return self.as_str().starts_with(prefix)
} String.starts_with

pub fn String.ends_with(self, suffix: Str) -> bool limits pure, notrap, terminates
    ensures result == self.as_str().ends_with(suffix)
    example String.of("port=80", alloc: testing::world().alloc).ends_with("80")
{
    return self.as_str().ends_with(suffix)
} String.ends_with

pub fn String.find(self, needle: Str) -> Option[usize] limits pure, notrap, terminates
    example String.of("port=80", alloc: testing::world().alloc).find("=") == Some(4)
{
    return self.as_str().find(needle)
} String.find

pub fn String.byte_len(self) -> usize limits pure, notrap, terminates
    ensures result == self.as_str().byte_len()
    example String.of("café", alloc: testing::world().alloc).byte_len() == 5
{
    return self.as_str().byte_len()
} String.byte_len

pub fn String.char_count(self) -> usize limits pure, notrap, terminates
    ensures result == self.as_str().char_count()
    example String.of("café", alloc: testing::world().alloc).char_count() == 4
{
    return self.as_str().char_count()
} String.char_count

pub fn String.is_char_boundary(self, i: usize) -> bool limits pure, notrap, terminates
    ensures result == self.as_str().is_char_boundary(i)
    example not String.of("café", alloc: testing::world().alloc).is_char_boundary(4)
{
    return self.as_str().is_char_boundary(i)
} String.is_char_boundary

pub proj fn String.slice_bytes(self, start: usize, end: usize) -> Option[Str] limits pure, notrap, terminates
    example String.of("café", alloc: testing::world().alloc).slice_bytes(0, end: 3) == Some("caf")
{
    return self.as_str().slice_bytes(start, end)
} String.slice_bytes

pub proj fn Fixed.as_bytes(self) -> Slice[u8] limits pure, notrap, terminates
    example Fixed[4].of("é").as_bytes() == b"\xC3\xA9"
{
    return self.as_str().as_bytes()
} Fixed.as_bytes

pub proj fn Fixed.cursor(self) -> core::CharCursor limits pure, notrap, terminates {
    return self.as_str().cursor()
} Fixed.cursor

pub fn Fixed.is_empty(self) -> bool limits pure, notrap, terminates
    ensures result == self.as_str().is_empty()
    example not Fixed[4].of("a").is_empty()
{
    return self.as_str().is_empty()
} Fixed.is_empty

pub fn Fixed.starts_with(self, prefix: Str) -> bool limits pure, notrap, terminates
    ensures result == self.as_str().starts_with(prefix)
    example Fixed[8].of("port=80").starts_with("port")
{
    return self.as_str().starts_with(prefix)
} Fixed.starts_with

pub fn Fixed.ends_with(self, suffix: Str) -> bool limits pure, notrap, terminates
    ensures result == self.as_str().ends_with(suffix)
    example Fixed[8].of("port=80").ends_with("80")
{
    return self.as_str().ends_with(suffix)
} Fixed.ends_with

pub fn Fixed.find(self, needle: Str) -> Option[usize] limits pure, notrap, terminates
    example Fixed[8].of("port=80").find("=") == Some(4)
{
    return self.as_str().find(needle)
} Fixed.find

pub fn Fixed.byte_len(self) -> usize limits pure, notrap, terminates
    ensures result == self.as_str().byte_len()
    ensures result <= N
    example Fixed[8].of("café").byte_len() == 5
{
    return self.as_str().byte_len()
} Fixed.byte_len

pub fn Fixed.char_count(self) -> usize limits pure, notrap, terminates
    ensures result == self.as_str().char_count()
    example Fixed[8].of("café").char_count() == 4
{
    return self.as_str().char_count()
} Fixed.char_count

pub fn Fixed.is_char_boundary(self, i: usize) -> bool limits pure, notrap, terminates
    ensures result == self.as_str().is_char_boundary(i)
    example not Fixed[8].of("café").is_char_boundary(4)
{
    return self.as_str().is_char_boundary(i)
} Fixed.is_char_boundary

pub proj fn Fixed.slice_bytes(self, start: usize, end: usize) -> Option[Str] limits pure, notrap, terminates
    example Fixed[8].of("café").slice_bytes(0, end: 3) == Some("caf")
{
    return self.as_str().slice_bytes(start, end)
} Fixed.slice_bytes

test try_from_utf8_fails_without_memory for String.try_from_utf8 {
    let budget = testing::world().alloc.split(0)
    let copied = attempt String.try_from_utf8(b"ok", alloc: budget.alloc())
    take budget.close()
    expect copied == Err(utf8::Utf8Error.OutOfMemory(mem::OutOfMemory.Exhausted))
} try_from_utf8_fails_without_memory

test push_appends_utf8_bytes for String.push {
    var line = String.empty(testing::world().alloc)
    mut line.push('é')
    mut line.push('!')
    expect line.as_str() == "é!"
} push_appends_utf8_bytes

test try_push_fails_without_memory for String.try_push {
    let budget = testing::world().alloc.split(0)
    var line = String.empty(budget.alloc())
    let pushed = attempt mut line.try_push('a')
    take budget.close()
    expect pushed == Err(mem::OutOfMemory.Exhausted)
    expect line.is_empty()
} try_push_fails_without_memory

test append_adds_text_at_end for String.append {
    var line = String.of("port", alloc: testing::world().alloc)
    mut line.append("=80")
    expect line.as_str() == "port=80"
} append_adds_text_at_end

test try_append_fails_without_memory for String.try_append {
    let budget = testing::world().alloc.split(0)
    var line = String.empty(budget.alloc())
    let appended = attempt mut line.try_append("port")
    take budget.close()
    expect appended == Err(mem::OutOfMemory.Exhausted)
    expect line.is_empty()
} try_append_fails_without_memory

test clear_empties_text for String.clear {
    var line = String.of("port", alloc: testing::world().alloc)
    mut line.clear()
    expect line.is_empty()
} clear_empties_text

test string_cursor_yields_chars for String.cursor {
    let word = String.of("é!", alloc: testing::world().alloc)
    var count: u32 = 0
    for c in word {
        if c == 'é' or c == '!' {
            count += 1
        }
    }
    expect count == 2
} string_cursor_yields_chars

test write_elides_past_budget for String.write {
    let line = "a long line"
    var out = String.empty(testing::world().alloc)
    mut out.write(Dyn[Render].view(line), budget: 8)
    expect out.as_str() == "a lon..."
} write_elides_past_budget

test try_write_fails_without_memory for String.try_write {
    let budget = testing::world().alloc.split(0)
    var out = String.empty(budget.alloc())
    let seq: u32 = 7
    let written = attempt mut out.try_write(Dyn[Render].view(seq), budget: 64)
    take budget.close()
    expect written == Err(mem::OutOfMemory.Exhausted)
    expect out.is_empty()
} try_write_fails_without_memory

test fixed_push_appends_utf8_bytes for Fixed.push {
    var code = Fixed[4].empty()
    mut code.push('é')
    expect code.as_str() == "é"
    expect code.room() == 2
} fixed_push_appends_utf8_bytes

test fixed_try_push_fails_when_full for Fixed.try_push {
    var code = Fixed[2].of("ab")
    let pushed = attempt mut code.try_push('c')
    expect pushed == Err(mem::OutOfMemory.Exhausted)
    expect code.as_str() == "ab"
} fixed_try_push_fails_when_full

test fixed_append_adds_text_at_end for Fixed.append {
    var code = Fixed[8].of("port")
    mut code.append("=80")
    expect code.as_str() == "port=80"
} fixed_append_adds_text_at_end

test fixed_try_append_fails_when_text_does_not_fit for Fixed.try_append {
    var code = Fixed[4].of("ab")
    let appended = attempt mut code.try_append("cde")
    expect appended == Err(mem::OutOfMemory.Exhausted)
    expect code.as_str() == "ab"
} fixed_try_append_fails_when_text_does_not_fit

test fixed_clear_empties_text for Fixed.clear {
    var code = Fixed[4].of("ab")
    mut code.clear()
    expect code.is_empty()
} fixed_clear_empties_text

test fixed_cursor_yields_chars for Fixed.cursor {
    let word = Fixed[4].of("é!")
    var count: u32 = 0
    for c in word {
        if c == 'é' or c == '!' {
            count += 1
        }
    }
    expect count == 2
} fixed_cursor_yields_chars

test fixed_write_elides_past_room for Fixed.write {
    let count: u32 = 12_345
    var line = Fixed[4].empty()
    mut line.write(Dyn[Render].view(count), budget: 64)
    expect line.as_str() == "1..."
} fixed_write_elides_past_room

test fixed_try_write_never_fails for Fixed.try_write {
    let count: u32 = 12_345
    var line = Fixed[4].empty()
    let written = attempt mut line.try_write(Dyn[Render].view(count), budget: 64)
    expect written.is_ok()
    expect line.as_str() == "1..."
} fixed_try_write_never_fails

test intern_numbers_distinct_texts for Interner.intern {
    let names = Interner.empty(testing::world().alloc)
    let port = names.intern("port")
    let host = names.intern("host")
    expect port == Symbol(index: 0)
    expect host == Symbol(index: 1)
    let again = names.intern("port")
    expect again == port
} intern_numbers_distinct_texts

test lookup_finds_interned_text for Interner.lookup {
    let names = Interner.empty(testing::world().alloc)
    let port = names.intern("port")
    let found = names.lookup("port")
    expect found == Some(port)
} lookup_finds_interned_text

test resolved_text_outlives_later_interning for Interner.resolve {
    let names = Interner.empty(testing::world().alloc)
    let port = names.resolve(names.intern("port"))
    discard names.intern("host")
    expect port == "port"
} resolved_text_outlives_later_interning

test len_counts_distinct_texts for Interner.len {
    let names = Interner.empty(testing::world().alloc)
    discard names.intern("port")
    discard names.intern("host")
    discard names.intern("port")
    let count = names.len()
    expect count == 2
} len_counts_distinct_texts
