//! Arrays, slices, their cursors and ranges.

pub open struct Array[T: Any, N: usize] {
} Array

pub open view struct Slice[T: Any] {
} Slice

pub open view struct SliceMut[T: Any] {
} SliceMut

pub fn Array.len(self) -> usize = N

pub fn Array.filled(value: T) -> Array[T, N] limits pure, notrap, terminates
    example Array[u8, 3].filled(7)[2] == 7

pub proj fn Array.at(self, i: usize) -> T limits pure, notrap, terminates
    example Array[u8, 2].filled(5).at(1) == 5

pub proj fn Array.at_mut(mut self, i: usize) -> T limits pure, notrap, terminates
    example Array[u8, 2].filled(5).at_mut(1) == 5

pub proj fn Array.view(self) -> Slice[T] limits pure, notrap, terminates
    ensures result.len() == N
    example Array[u8, 3].filled(0).view().len() == 3

pub proj fn Array.view_mut(mut self) -> SliceMut[T] limits pure, notrap, terminates
    ensures result.len() == N
    example Array[u8, 3].filled(0).view_mut().len() == 3

pub proj fn Array.cursor(self) -> SliceCursor[T] limits pure, notrap, terminates

pub proj fn Array.cursor_mut(mut self) -> SliceCursorMut[T] limits pure, notrap, terminates

pub fn Array.into_cursor(take self) -> ArrayCursor[T, N] limits pure, notrap, terminates

pub fn Slice.len(self) -> usize limits pure, notrap, terminates
    example b"abc".len() == 3

pub fn Slice.is_empty(self) -> bool = self.len() == 0

pub proj fn Slice.at(self, i: usize) -> T limits pure, notrap, terminates
    example b"ab".at(1) == b'b'

pub proj fn Slice.prefix(self, count: usize) -> Option[Slice[T]] limits pure, notrap, terminates
    ensures match result {
        Some(head) => count <= self.len() and head.len() == count
        None => count > self.len()
    }
    example b"abc".prefix(2) == Some(b"ab")

pub proj fn Slice.split_at(self, at: usize) -> Option[core::Parts[Slice[T]]] limits pure, notrap, terminates
    ensures match result {
        Some(parts) => at <= self.len() and parts.head.len() == at and parts.tail.len() == self.len() - at
        None => at > self.len()
    }
    example b"abc".split_at(4).is_none()

pub proj fn Slice.cursor(self) -> SliceCursor[T] limits pure, notrap, terminates

pub fn Slice.u16_le(self, at: usize) -> u16 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 2
    example b"\x34\x12".u16_le(0) == 0x1234

pub fn Slice.u32_le(self, at: usize) -> u32 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 4
    example b"\x78\x56\x34\x12".u32_le(0) == 0x1234_5678

pub fn Slice.u64_le(self, at: usize) -> u64 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 8
    example b"\x01\x00\x00\x00\x00\x00\x00\x02".u64_le(0) == 0x0200_0000_0000_0001

pub fn Slice.u16_be(self, at: usize) -> u16 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 2
    example b"\x12\x34".u16_be(0) == 0x1234

pub fn Slice.u32_be(self, at: usize) -> u32 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 4
    example b"\x12\x34\x56\x78".u32_be(0) == 0x1234_5678

pub fn Slice.u64_be(self, at: usize) -> u64 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 8
    example b"\x02\x00\x00\x00\x00\x00\x00\x01".u64_be(0) == 0x0200_0000_0000_0001

pub fn SliceMut.len(self) -> usize limits pure, notrap, terminates
    example Array[u8, 3].filled(0).view_mut().len() == 3

pub fn SliceMut.is_empty(self) -> bool = self.len() == 0

pub proj fn SliceMut.at(self, i: usize) -> T limits pure, notrap, terminates
    example Array[u8, 2].filled(5).view_mut().at(0) == 5

pub proj fn SliceMut.at_mut(mut self, i: usize) -> T limits pure, notrap, terminates

pub proj fn SliceMut.view(self) -> Slice[T] limits pure, notrap, terminates
    ensures result.len() == self.len()
    example Array[u8, 2].filled(5).view_mut().view().len() == 2

pub proj fn SliceMut.prefix_mut(mut self, count: usize) -> Option[SliceMut[T]] limits pure, notrap, terminates
    ensures match result {
        Some(head) => count <= self.len() and head.len() == count
        None => count > self.len()
    }

pub proj fn SliceMut.split_at_mut(mut self, at: usize) -> Option[core::Parts[SliceMut[T]]] limits pure, notrap, terminates
    ensures match result {
        Some(parts) => at <= self.len() and parts.head.len() == at and parts.tail.len() == self.len() - at
        None => at > self.len()
    }

pub proj fn SliceMut.cursor(self) -> SliceCursor[T] limits pure, notrap, terminates

pub proj fn SliceMut.cursor_mut(mut self) -> SliceCursorMut[T] limits pure, notrap, terminates

pub fn SliceMut.fill(mut self, value: T) limits notrap, terminates

pub fn SliceMut.copy_from(mut self, source: Slice[T]) limits notrap, terminates
    requires source.len() == self.len()

pub fn SliceMut.u16_le(self, at: usize) -> u16 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 2
    example Array[u8, 2].filled(1).view_mut().u16_le(0) == 0x0101

pub fn SliceMut.u32_le(self, at: usize) -> u32 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 4
    example Array[u8, 4].filled(1).view_mut().u32_le(0) == 0x0101_0101

pub fn SliceMut.u64_le(self, at: usize) -> u64 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 8
    example Array[u8, 8].filled(1).view_mut().u64_le(0) == 0x0101_0101_0101_0101

pub fn SliceMut.u16_be(self, at: usize) -> u16 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 2
    example Array[u8, 2].filled(2).view_mut().u16_be(0) == 0x0202

pub fn SliceMut.u32_be(self, at: usize) -> u32 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 4
    example Array[u8, 4].filled(2).view_mut().u32_be(0) == 0x0202_0202

pub fn SliceMut.u64_be(self, at: usize) -> u64 limits pure, notrap, terminates
    requires at <= self.len() and self.len() - at >= 8
    example Array[u8, 8].filled(2).view_mut().u64_be(0) == 0x0202_0202_0202_0202

pub fn SliceMut.write_u16_le(mut self, at: usize, value: u16) limits notrap, terminates
    requires at <= self.len() and self.len() - at >= 2

pub fn SliceMut.write_u32_le(mut self, at: usize, value: u32) limits notrap, terminates
    requires at <= self.len() and self.len() - at >= 4

pub fn SliceMut.write_u64_le(mut self, at: usize, value: u64) limits notrap, terminates
    requires at <= self.len() and self.len() - at >= 8

pub fn SliceMut.write_u16_be(mut self, at: usize, value: u16) limits notrap, terminates
    requires at <= self.len() and self.len() - at >= 2

pub fn SliceMut.write_u32_be(mut self, at: usize, value: u32) limits notrap, terminates
    requires at <= self.len() and self.len() - at >= 4

pub fn SliceMut.write_u64_be(mut self, at: usize, value: u64) limits notrap, terminates
    requires at <= self.len() and self.len() - at >= 8

pub interface Cursor[T: Any] {
    proj fn next(mut self) -> Option[T]
} Cursor

pub open view struct SliceCursor[T: Any] {
} SliceCursor

impl SliceCursor: Cursor[T]

pub proj fn SliceCursor.next(mut self) -> Option[T] limits pure, notrap, terminates

pub open view struct SliceCursorMut[T: Any] {
} SliceCursorMut

impl SliceCursorMut: Cursor[T]

pub proj fn SliceCursorMut.next(mut self) -> Option[T] limits pure, notrap, terminates

pub open struct ArrayCursor[T: Any, N: usize] {
} ArrayCursor

impl ArrayCursor[T, N]: Cursor[T]

pub fn ArrayCursor.next(mut self) -> Option[T] limits pure, notrap, terminates

pub closed struct Range[T: Copy and Ord] derives Copy, Eq {
    pub low: T
    pub high: T
    pub inclusive: bool
} Range

pub fn Range.contains(self, value: T) -> bool limits pure, notrap, terminates
    ensures result == (self.low <= value and (value < self.high or (self.inclusive and value <= self.high)))
    example (0u8..<3).contains(2)
{
    if not (self.low <= value) {
        return false
    }
    if value < self.high {
        return true
    }
    if not self.inclusive {
        return false
    }
    if value <= self.high {
        return true
    }
    return false
} Range.contains

pub fn Range.is_empty(self) -> bool limits pure, notrap, terminates
    ensures result == (self.high < self.low or (not self.inclusive and self.high <= self.low))
    example (3u8..<3).is_empty()
{
    if self.high < self.low {
        return true
    }
    if self.inclusive {
        return false
    }
    if self.high <= self.low {
        return true
    }
    return false
} Range.is_empty

pub fn Range.next(mut self) -> Option[T] limits pure, notrap, terminates
    example (1u8..=2).next() == Some(1)

test empty_slice_is_empty for Slice.is_empty {
    expect b"".is_empty()
    expect not b"a".is_empty()
} empty_slice_is_empty

test array_len_is_its_parameter for Array.len {
    expect Array[u8, 4].filled(0).len() == 4
} array_len_is_its_parameter

test empty_view_mut_is_empty for SliceMut.is_empty {
    var bytes = Array[u8, 1].filled(0)
    let view = mut bytes.view_mut()
    expect not view.is_empty()
} empty_view_mut_is_empty

test fill_writes_every_element for SliceMut.fill {
    var bytes = Array[u8, 3].filled(0)
    var view = mut bytes.view_mut()
    mut view.fill(9)
    expect bytes == Array[u8, 3].filled(9)
} fill_writes_every_element

test copy_from_copies_in_order for SliceMut.copy_from {
    var bytes = Array[u8, 2].filled(0)
    var view = mut bytes.view_mut()
    mut view.copy_from(b"xy")
    expect bytes[0] == b'x'
    expect bytes[1] == b'y'
} copy_from_copies_in_order

test write_u16_le_stores_low_byte_first for SliceMut.write_u16_le {
    var bytes = Array[u8, 2].filled(0)
    var view = mut bytes.view_mut()
    mut view.write_u16_le(0, value: 0x1234)
    expect bytes[0] == 0x34
} write_u16_le_stores_low_byte_first

test write_u32_le_stores_low_byte_first for SliceMut.write_u32_le {
    var bytes = Array[u8, 4].filled(0)
    var view = mut bytes.view_mut()
    mut view.write_u32_le(0, value: 0x1234_5678)
    expect bytes[0] == 0x78
} write_u32_le_stores_low_byte_first

test write_u64_le_stores_low_byte_first for SliceMut.write_u64_le {
    var bytes = Array[u8, 8].filled(0)
    var view = mut bytes.view_mut()
    mut view.write_u64_le(0, value: 0x0102_0304_0506_0708)
    expect bytes[0] == 0x08
} write_u64_le_stores_low_byte_first

test write_u16_be_stores_high_byte_first for SliceMut.write_u16_be {
    var bytes = Array[u8, 2].filled(0)
    var view = mut bytes.view_mut()
    mut view.write_u16_be(0, value: 0x1234)
    expect bytes[0] == 0x12
} write_u16_be_stores_high_byte_first

test write_u32_be_stores_high_byte_first for SliceMut.write_u32_be {
    var bytes = Array[u8, 4].filled(0)
    var view = mut bytes.view_mut()
    mut view.write_u32_be(0, value: 0x1234_5678)
    expect bytes[0] == 0x12
} write_u32_be_stores_high_byte_first

test write_u64_be_stores_high_byte_first for SliceMut.write_u64_be {
    var bytes = Array[u8, 8].filled(0)
    var view = mut bytes.view_mut()
    mut view.write_u64_be(0, value: 0x0102_0304_0506_0708)
    expect bytes[0] == 0x01
} write_u64_be_stores_high_byte_first

test slice_cursor_yields_in_index_order for Slice.cursor {
    var total: u32 = 0
    for byte in b"ab" {
        total = total * 256 + u32.widen(byte)
    }
    expect total == 0x6162
} slice_cursor_yields_in_index_order

test slice_cursor_next_ends_with_none for SliceCursor.next {
    var cursor = b"a".cursor()
    let earlier = mut cursor.next()
    let later = mut cursor.next()
    expect earlier == Some(b'a')
    expect later == None
} slice_cursor_next_ends_with_none

test array_cursor_reads_elements for Array.cursor {
    var total: u32 = 0
    for value in Array[u8, 3].filled(2) {
        total += u32.widen(value)
    }
    expect total == 6
} array_cursor_reads_elements

test array_cursor_mut_writes_elements for Array.cursor_mut {
    var values = Array[u8, 3].filled(2)
    for value in mut values {
        value = 7
    }
    expect values == Array[u8, 3].filled(7)
} array_cursor_mut_writes_elements

test slice_cursor_mut_next_yields_writable_elements for SliceCursorMut.next {
    var values = Array[u8, 2].filled(0)
    for value in mut values {
        value = 9
    }
    expect values[0] == 9
} slice_cursor_mut_next_yields_writable_elements

test array_into_cursor_owns_elements for Array.into_cursor {
    var total: u32 = 0
    for value in take Array[u8, 2].filled(4) {
        total += u32.widen(value)
    }
    expect total == 8
} array_into_cursor_owns_elements

test array_cursor_next_ends_with_none for ArrayCursor.next {
    var cursor = Array[u8, 1].filled(4).into_cursor()
    let earlier = mut cursor.next()
    let later = mut cursor.next()
    expect earlier == Some(4)
    expect later == None
} array_cursor_next_ends_with_none

fn store_three(mut slot: u8) {
    slot = 3
} store_three

test slice_mut_at_mut_writes_element for SliceMut.at_mut {
    var values = Array[u8, 2].filled(0)
    var view = mut values.view_mut()
    store_three(mut view.at_mut(1))
    expect values[1] == 3
} slice_mut_at_mut_writes_element

test prefix_mut_keeps_leading_elements for SliceMut.prefix_mut {
    var values = Array[u8, 3].filled(0)
    var view = mut values.view_mut()
    let Some(head) = mut view.prefix_mut(2) else {
        return
    }
    expect head.len() == 2
} prefix_mut_keeps_leading_elements

test split_at_mut_divides_the_view for SliceMut.split_at_mut {
    var values = Array[u8, 3].filled(0)
    var view = mut values.view_mut()
    let Some(parts) = mut view.split_at_mut(1) else {
        return
    }
    expect parts.tail.len() == 2
} split_at_mut_divides_the_view

test slice_mut_cursor_reads_elements for SliceMut.cursor {
    var values = Array[u8, 2].filled(3)
    let view = mut values.view_mut()
    var total: u32 = 0
    for value in view {
        total += u32.widen(value)
    }
    expect total == 6
} slice_mut_cursor_reads_elements

test slice_mut_cursor_mut_writes_elements for SliceMut.cursor_mut {
    var values = Array[u8, 2].filled(3)
    var view = mut values.view_mut()
    for value in mut view {
        value = 1
    }
    expect values == Array[u8, 2].filled(1)
} slice_mut_cursor_mut_writes_elements

test range_next_steps_through_values for Range.next {
    var total: u32 = 0
    for value in 0u32..=3 {
        total += value
    }
    expect total == 6
} range_next_steps_through_values
