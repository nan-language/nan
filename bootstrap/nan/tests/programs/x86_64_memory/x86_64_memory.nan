//! Takes the 1 GiB frames of the highest usable memory, writes a word at each end of those above 4 GiB through the entry root, and reads the words back; splits one region at its middle; checks the regions against the memory map, the image's segments, the boot area, the entry root's tables and the start information, and the clock's registers against the HPET's.

/// The memory the entry root maps with the tables the image holds, and the bytes of a frame.
const MAPPED: u64 = 0x1_0000_0000

const GIGABYTE: u64 = 1_073_741_824

registers Uart {
    data: u8 at 0x0 write
} Uart

fn say(text: Str) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in text.as_bytes() {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say

/// The HPET's capabilities, whose bits 32 to 63 give its period.
registers Hpet {
    capabilities: u64 at 0x0 read
} Hpet

/// Whether the clock reads no registers, or the 1 KiB of an HPET's, whose period is not zero.
fn clock_registers_agree(k: boot::Kernel) -> bool {
    let read = k.clock_registers()
    if read.byte_len == 0 {
        return read.base == 0
    }
    var hpet = trusted "the clock's registers are the HPET's, which the entry root maps uncached, and nothing else maps them" { hw::Mmio[Hpet].map(read.base) }
    let period = mut hpet.read(Hpet.capabilities) >> 32
    take hpet.unmap()
    return read.byte_len == 1_024 and period > 0
} clock_registers_agree

fn put(mut word: u64, value: u64) {
    word = value
} put

/// Writes a word at each end of the frame and gives whether both read back.
fn written(mut frame: hw::PhysFrame[GIGABYTE]) -> bool {
    let low = hw::Offset[u64](bytes: 0)
    let high = hw::Offset[u64](bytes: GIGABYTE - 8)
    let base = frame.base()
    put(mut frame.contents_mut(low), value: ~base)
    put(mut frame.contents_mut(high), value: base)
    return mut frame.contents_mut(low) == ~base and mut frame.contents_mut(high) == base
} written

/// Whether what the kernel learns of its memory agrees with its regions: each lies inside a
/// usable range of the memory map, which lists one when `listed` holds, and outside the image's
/// segments, the boot area, the entry root's tables and the start information's extents; the
/// segments lie in address order, the first executable and read-only, one writable and not
/// executable; and the boot area is not empty.
fn layout_agrees(k: boot::Kernel, regions: mem::List[hw::Region], listed: bool, alloc: mem::Alloc) -> bool {
    let map = k.memory_map(alloc)
    let segments = k.image_segments(alloc)
    var held = k.start_extents(alloc)
    mut held.push(k.boot_area())
    mut held.push(k.entry_tables())
    for segment in segments {
        mut held.push(boot::Extent(base: segment.base, byte_len: segment.byte_len))
    }
    if listed != (map.len() > 0) {
        return false
    }
    for region in regions {
        let extent = boot::Extent(base: region.base(), byte_len: region.byte_len())
        if listed and not usable(map, extent) {
            return false
        }
        for other in held {
            if overlaps(other, right: extent) {
                return false
            }
        }
    }
    if segments.len() < 3 or not segments[0].executable or segments[0].writable {
        return false
    }
    var writable = false
    var previous: u64 = 0
    for segment in segments {
        if segment.base < previous {
            return false
        }
        previous = segment.base.saturating_add(segment.byte_len)
        writable = writable or (segment.writable and not segment.executable)
    }
    return writable and k.boot_area().byte_len > 0
} layout_agrees

/// Whether an extent lies inside a usable range of a memory map.
fn usable(map: mem::List[boot::MemoryRange], extent: boot::Extent) -> bool {
    for range in map {
        if range.kind == 1 and range.base <= extent.base and extent.base.saturating_add(extent.byte_len) <= range.base.saturating_add(range.byte_len) {
            return true
        }
    }
    return false
} usable

/// Whether two extents share a byte.
fn overlaps(left: boot::Extent, right: boot::Extent) -> bool = left.byte_len > 0 and right.byte_len > 0 and left.base < right.base.saturating_add(right.byte_len) and right.base < left.base.saturating_add(left.byte_len)

/// Whether splitting a region at an address gives nothing, keeping any part it gives.
fn refuses(mut region: hw::Region, at: u64, mut regions: mem::List[hw::Region]) -> bool {
    let Some(part) = mut region.split(at) else {
        return true
    }
    mut regions.push(take part)
    return false
} refuses

/// Splits a region at the 4 KiB boundary at or below its middle, keeping both parts, and gives
/// whether they cover it and its base or an unaligned address split nothing.
fn halved(take region: hw::Region, mut regions: mem::List[hw::Region]) -> bool {
    var lower = region
    let base = lower.base()
    let end = base + lower.byte_len()
    let at = (base + lower.byte_len() / 2) & ~0xFFF
    let refused = refuses(mut lower, at: base, mut regions) and refuses(mut lower, at: at + 8, mut regions)
    let Some(upper) = mut lower.split(at) else {
        mut regions.push(take lower)
        return false
    }
    let covered = lower.base() == base and lower.byte_len() == at - base and upper.base() == at and upper.byte_len() == end - at
    mut regions.push(take lower)
    mut regions.push(take upper)
    return refused and covered
} halved

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    var regions = mut k.regions()
    if layout_agrees(k, regions, listed: true, alloc: k.alloc()) {
        say(text: "layout agrees\n")
    }
    if clock_registers_agree(k) {
        say(text: "clock registers agree\n")
    }
    let split = match mut regions.pop() {
        Some(highest) => halved(take highest, mut regions)
        None => false
    }
    var frames = mem::List[hw::PhysFrame[GIGABYTE]].empty(k.alloc())
    match mut regions.pop() {
        Some(highest) => take highest.frames(mut frames)
        None => say(text: "no usable memory\n")
    }
    var high: u64 = 0
    var same = true
    for frame in take frames {
        if frame.base() >= MAPPED {
            high += 1
            same = written(mut frame) and same
        }
        mut regions.push(take frame.into_region())
    }
    if high > 0 and same {
        say(text: "frames above 4 GiB written and read back\n")
    }
    if split {
        say(text: "region split at its middle\n")
    }
    take k.anchor(take regions, run: fn(exec: task::Executor) limits stack 16_384 {
        say(text: "anchored\n")
    })
} main
