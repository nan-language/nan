    \\    example Map[u8, u8].empty(testing::world().alloc).get(1) == None
    \\{
    \\    return self.get_by(fn(stored: K) => stored.cmp(key))
    \\} Map.get
    \\
    \\pub proj fn Map.get_mut(mut self, key: K) -> Option[V] {
    \\    return mut self.get_by_mut(fn(stored: K) => stored.cmp(key))
