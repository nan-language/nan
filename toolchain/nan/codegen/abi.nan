//! Calling conventions: where a signature's parameters and results pass, in registers or on the stack.

/// Where a value passes: in a register, or on the stack at an offset from the stack pointer at the
/// call.
enum Place derives Copy, Eq {
    Reg(machinst::Reg)
    Stack(u32)
} Place

/// The places of a signature's parameters and results, two for a 128-bit integer (its low half
/// first), and the bytes its stack arguments take.
struct Places {
    params: mem::List[Place]
    returns: mem::List[Place]
    stack: u32
} Places

/// The registers of System V integer arguments, in order.
fn system_v_int(index: u32) -> machinst::Reg {
    return match index {
        0 => x64::RDI
        1 => x64::RSI
        2 => x64::RDX
        3 => x64::RCX
        4 => x64::R8
        else => x64::R9
    }
} system_v_int

/// The registers of Microsoft x64 integer arguments, by position.
fn windows_int(index: u32) -> machinst::Reg {
    return match index {
        0 => x64::RCX
        1 => x64::RDX
        2 => x64::R8
        else => x64::R9
    }
} windows_int

/// Whether a value of a type passes in an SSE register: a float, where code may use them.
fn in_xmm(ty: clif::Type, floats: bool) -> bool = floats and ty.is_float()

/// The places of a signature under its calling convention; without SSE registers a float passes
/// as an integer of its width does.
fn places(sig: clif::Signature, floats: bool, alloc: mem::Alloc) -> Places {
    return match sig.call_conv {
        clif::CallConv.SystemV => system_v(sig, floats, alloc)
        clif::CallConv.WindowsFastcall => windows(sig, floats, alloc)
    }
} places

/// System V: integers in `rdi`, `rsi`, `rdx`, `rcx`, `r8` and `r9`, a 128-bit one in two of them
/// or on the stack, floats in `xmm0` to `xmm7`, the rest in 8-byte stack slots in order; results
/// in `rax` and `rdx`, or `xmm0` and `xmm1`.
fn system_v(sig: clif::Signature, floats: bool, alloc: mem::Alloc) -> Places {
    var params = mem::List[Place].empty(alloc)
    var ints: u32 = 0
    var xmms: u32 = 0
    var stack: u32 = 0
    for param in sig.params {
        invariant ints <= 6
        let ty = param.value_type
        if ty == clif::Type.Int128 {
            if ints + 2 <= 6 {
                mut params.push(Place.Reg(system_v_int(ints)))
                mut params.push(Place.Reg(system_v_int(ints + 1)))
                ints += 2
            } else {
                mut params.push(Place.Stack(stack))
                mut params.push(Place.Stack(stack + 8))
                stack += 16
            }
        } else if in_xmm(ty, floats) and xmms < 8 {
            mut params.push(Place.Reg(x64::xmm(xmms)))
            xmms += 1
        } else if not in_xmm(ty, floats) and ints < 6 {
            mut params.push(Place.Reg(system_v_int(ints)))
            ints += 1
        } else {
            mut params.push(Place.Stack(stack))
            stack += 8
        }
    }
    var returns = mem::List[Place].empty(alloc)
    var int_results: u32 = 0
    var xmm_results: u32 = 0
    for result in sig.returns {
        invariant int_results <= 2 and xmm_results <= 2
        let ty = result.value_type
        if ty == clif::Type.Int128 {
            mut returns.push(Place.Reg(x64::RAX))
            mut returns.push(Place.Reg(x64::RDX))
            int_results += 2
        } else if in_xmm(ty, floats) {
            mut returns.push(Place.Reg(x64::xmm(xmm_results)))
            xmm_results += 1
        } else {
            var reg = x64::RAX
            if int_results > 0 {
                reg = x64::RDX
            }
            mut returns.push(Place.Reg(reg))
            int_results += 1
        }
    }
    expect int_results <= 2 and xmm_results <= 2
    return Places(params: take params, returns: take returns, stack: stack)
} system_v

/// Microsoft x64: the first four arguments in `rcx`, `rdx`, `r8` and `r9` or `xmm0` to `xmm3` by
/// position, the rest on the stack above the 32 bytes the caller reserves for them; the result in
/// `rax` or `xmm0`.
fn windows(sig: clif::Signature, floats: bool, alloc: mem::Alloc) -> Places {
    var params = mem::List[Place].empty(alloc)
    var index: u32 = 0
    for param in sig.params {
        expect param.value_type != clif::Type.Int128
        if index >= 4 {
            mut params.push(Place.Stack(32 + (8 * (index - 4))))
        } else if in_xmm(param.value_type, floats) {
            mut params.push(Place.Reg(x64::xmm(index)))
        } else {
            mut params.push(Place.Reg(windows_int(index)))
        }
        index += 1
    }
    var stack: u32 = 32
    if index > 4 {
        stack += 8 * (index - 4)
    }
    var returns = mem::List[Place].empty(alloc)
    expect sig.returns.len() <= 1
    for result in sig.returns {
        if in_xmm(result.value_type, floats) {
            mut returns.push(Place.Reg(x64::xmm(0)))
        } else {
            mut returns.push(Place.Reg(x64::RAX))
        }
    }
    return Places(params: take params, returns: take returns, stack: stack)
} windows
