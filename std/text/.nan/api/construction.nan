item "text::construction::Codec.decode"
text "pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError"
text "    example attempt Codec[Option[i16]].decode(Untrusted.of(b\" Some(-1_200) \"), alloc: testing::world().alloc) == Ok(Some(-1_200))"
text "    example attempt Codec[mem::List[u8]].decode(Untrusted.of(b\"[1, 2,]\"), alloc: testing::world().alloc) == Err(core::DecodeError.Malformed)"
text "    example attempt Codec[char].decode(Untrusted.of(b\"'\\\\u{D800}'\"), alloc: testing::world().alloc) == Err(core::DecodeError.InvalidText)"
interface "ah5msnn3tkgebf2agvxnioutccfucteugdsjvmdqyia6nw6gtlffkt3"
digest any "effects alloc | authority none | may-trap yes | terminates"
head "pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError"
accepted "example attempt Codec[Option[i16]].decode(Untrusted.of(b\" Some(-1_200) \"), alloc: testing::world().alloc) == Ok(Some(-1_200))"
accepted "example attempt Codec[mem::List[u8]].decode(Untrusted.of(b\"[1, 2,]\"), alloc: testing::world().alloc) == Err(core::DecodeError.Malformed)"
accepted "example attempt Codec[char].decode(Untrusted.of(b\"'\\\\u{D800}'\"), alloc: testing::world().alloc) == Err(core::DecodeError.InvalidText)"
