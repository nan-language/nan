    let alloc = testing::world().alloc
    let code = compile(chain_of_tests(alloc), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\x1f\x1c\x00\xf1\xa8\x00\x00\x54\xe1\x03\x00\x10\x22\x78\xa0\xb8\x21\x00\x02\x8b\x20\x00\x1f\xd6\x60\x0c\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\x00\x00\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\x40\x01\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\x80\x02\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\xc0\x03\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\x00\x05\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\x40\x06\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\x80\x07\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\xc0\x08\x80\xd2\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\xa0\xff\xff\xff\xac\xff\xff\xff\xb8\xff\xff\xff\xc4\xff\xff\xff\xd0\xff\xff\xff\xdc\xff\xff\xff\xe8\xff\xff\xff\xf4\xff\xff\xff"
} jumps_through_a_table_for_a_chain_of_tests_of_one_value_for_aarch64

test keeps_values_across_calls_in_callee_saved_registers_for_aarch64 for compile {
    let alloc = testing::world().alloc
    let code = compile(calls_through_a_pointer(alloc), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\xff\x83\x00\xd1\xb3\x53\x3f\xa9\xb5\x03\x1e\xf8\xf3\x03\x00\xaa\xf4\x03\x01\xaa\xe0\x03\x14\xaa\x60\x02\x3f\xd6\xf5\x03\x00\xaa\xa0\x02\x14\x8b\x60\x02\x3f\xd6\x61\x00\x80\xd2\x81\x7e\x01\x9b\xa2\x00\x80\xd2\xa2\x7e\x02\x9b\x21\x00\x02\x8b\x20\x00\x00\x8b\xb3\x53\x7f\xa9\xb5\x03\x5e\xf8\xbf\x03\x00\x91\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
    expect code.frame == 48
} keeps_values_across_calls_in_callee_saved_registers_for_aarch64

