pub fn I64x2.load(from: Slice[i64], at: usize) -> I64x2 limits pure, notrap, terminates
    requires at <= from.len() and from.len() - at >= 2
    example I64x2.load(Array[i64, 3].filled(3).view(), at: 1) == I64x2.splat(3)
{
    var lanes = Array[i64, 2].filled(0)
    for index in at..<(at + 2) {
        lanes[index - at] = from[index]
    }
    return I64x2(lanes: lanes)
} I64x2.load

pub fn I64x2.store(self, mut to: SliceMut[i64], at: usize) limits pure, notrap, terminates
    requires at <= to.len() and to.len() - at >= 2

pub fn I64x2.lane(self, index: usize) -> i64 limits pure, notrap, terminates
    requires index < 2
    example I64x2.splat(5).replace_lane(1, value: 6).lane(1) == 6
{
    return self.lanes[index]
} I64x2.lane

pub fn I64x2.replace_lane(self, index: usize, value: i64) -> I64x2 limits pure, notrap, terminates
    requires index < 2
    example I64x2.splat(5).replace_lane(0, value: 6).lane(1) == 5
{
    var lanes = self.lanes
    lanes[index] = value
    return I64x2(lanes: lanes)
} I64x2.replace_lane

pub fn I64x2.wrapping_add(self, other: I64x2) -> I64x2 limits pure, notrap, terminates
    example I64x2.splat(9223372036854775807).wrapping_add(I64x2.splat(1)) == I64x2.splat(-9223372036854775808)
{
    var lanes = self.lanes
    for index in 0..<2usize {
        lanes[index] = lanes[index].wrapping_add(other.lanes[index])
    }
    return I64x2(lanes: lanes)
} I64x2.wrapping_add

pub fn I64x2.wrapping_sub(self, other: I64x2) -> I64x2 limits pure, notrap, terminates
    example I64x2.splat(-9223372036854775808).wrapping_sub(I64x2.splat(1)) == I64x2.splat(9223372036854775807)
{
    var lanes = self.lanes
    for index in 0..<2usize {
        lanes[index] = lanes[index].wrapping_sub(other.lanes[index])
    }
    return I64x2(lanes: lanes)
} I64x2.wrapping_sub

pub fn I64x2.wrapping_mul(self, other: I64x2) -> I64x2 limits pure, notrap, terminates
    example I64x2.splat(-2).wrapping_mul(I64x2.splat(3)) == I64x2.splat(-6)
{
    var lanes = self.lanes
    for index in 0..<2usize {
        lanes[index] = lanes[index].wrapping_mul(other.lanes[index])
    }
    return I64x2(lanes: lanes)
} I64x2.wrapping_mul

pub fn I64x2.bit_and(self, other: I64x2) -> I64x2 limits pure, notrap, terminates
    example I64x2.splat(0b1100).bit_and(I64x2.splat(0b1010)) == I64x2.splat(0b1000)
{
    var lanes = self.lanes
    for index in 0..<2usize {
        lanes[index] = lanes[index] & other.lanes[index]
    }
    return I64x2(lanes: lanes)
} I64x2.bit_and

pub fn I64x2.bit_or(self, other: I64x2) -> I64x2 limits pure, notrap, terminates
    example I64x2.splat(0b1100).bit_or(I64x2.splat(0b1010)) == I64x2.splat(0b1110)
{
    var lanes = self.lanes
    for index in 0..<2usize {
        lanes[index] = lanes[index] | other.lanes[index]
    }
    return I64x2(lanes: lanes)
} I64x2.bit_or

pub fn I64x2.bit_xor(self, other: I64x2) -> I64x2 limits pure, notrap, terminates
    example I64x2.splat(0b1100).bit_xor(I64x2.splat(0b1010)) == I64x2.splat(0b0110)
{
    var lanes = self.lanes
    for index in 0..<2usize {
