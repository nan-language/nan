    \\    }
    \\    let window = word_at(record + RETIRED_FIRST + 8)
    \\    let pages = word_at(record + RETIRED_FIRST + 16)
    \\    for index in 0..<pages {
    \\        let slot = leaf_slot(table, address: window + index * PAGE)
    \\        if slot != 0 {
    \\            store_word(slot, value: 0)
    \\        }
    \\    }
    \\    let span = 1u64 << MEGABYTES_SHIFT
    \\    var region = window / span * span
    \\    while region < window + pages * PAGE {
    \\        prune(table, region)
    \\        region += span
    \\    }
    \\    discard retire(table, kind: RETIRED_MEMORY, content: word_at(record + RETIRED_FIRST))
    \\    let targets = word_at(record + RETIRED_FIRST + 32)
    \\    if targets != 0 {
    \\        release(targets)
    \\    }
    \\} detach
    \\
    \\/// Clears the window entries of the tables mapping the 2 MiB region at an address that it leaves
    \\/// empty, retiring those tables.
    \\fn prune(table: u64, region: u64) {
    \\    let top_slot = word_at(table + EXPORT_WINDOW) + index_of(region, shift: GIGABYTE_SHIFT) * 8
    \\    let middle = load_word(top_slot) & ADDRESS_BITS
    \\    if middle == 0 {
    \\        return
    \\    }
    \\    let middle_slot = middle + index_of(region, shift: MEGABYTES_SHIFT) * 8
    \\    let leaf = load_word(middle_slot) & ADDRESS_BITS
    \\    if leaf != 0 and holds_nothing(leaf) {
    \\        store_word(middle_slot, value: 0)
    \\        discard retire(table, kind: RETIRED_TABLE, content: leaf)
    \\    }
    \\    if holds_nothing(middle) {
    \\        store_word(top_slot, value: 0)
    \\        discard retire(table, kind: RETIRED_TABLE, content: middle)
    \\    }
    \\} prune
    \\
    \\/// Under the loader's lock, once translations of them are invalidated, frees the memory detached
    \\/// from the window and keeps the detached tables for later mappings.
    \\fn release_detached(table: u64) {
    \\    var link = table + EXPORT_RETIRED
    \\    loop {
    \\        let record = word_at(link)
    \\        if record == 0 {
    \\            return
    \\        }
    \\        let kind = word_at(record + RETIRED_KIND)
    \\        let content = word_at(record + RETIRED_FIRST)
    \\        if kind == RETIRED_MEMORY or kind == RETIRED_TABLE {
    \\            if kind == RETIRED_MEMORY {
    \\                release(content)
    \\            } else {
    \\                set_word(content, value: word_at(table + EXPORT_TABLES))
    \\                set_word(table + EXPORT_TABLES, value: content)
    \\            }
    \\            set_word(link, value: word_at(record))
    \\            release(record)
    \\        } else {
    \\            link = record
    \\        }
    \\    }
    \\} release_detached
    \\
    \\/// The retired placements not yet reclaimed.
    \\fn placements_left(table: u64) -> usize {
    \\    var left: usize = 0
    \\    var record = word_at(table + EXPORT_RETIRED)
    \\    while record != 0 {
    \\        if word_at(record + RETIRED_KIND) == RETIRED_PLACEMENT {
    \\            left += 1
    \\        }
    \\        record = word_at(record)
    \\    }
    \\    return left
    \\} placements_left
    \\
    \\/// The slot of the window entry mapping the page at an address, adding the tables it lacks.
    \\fn slot_for(table: u64, address: u64) -> u64 {
    \\    let middle = descend(table, at: word_at(table + EXPORT_WINDOW), address, shift: GIGABYTE_SHIFT)
    \\    let leaf = descend(table, at: middle, address, shift: MEGABYTES_SHIFT)
    \\    return leaf + index_of(address, shift: PAGE_SHIFT) * 8
    \\} slot_for
    \\
    \\/// The table an entry of the window table at `at` names for an address, a new one when it names
    \\/// none.
    \\fn descend(table: u64, at: u64, address: u64, shift: u32) -> u64 {
    \\    let slot = at + index_of(address, shift) * 8
    \\    let held = load_word(slot) & ADDRESS_BITS
    \\    if held != 0 {
    \\        return held
    \\    }
    \\    var fresh = word_at(table + EXPORT_TABLES)
    \\    if fresh != 0 {
    \\        set_word(table + EXPORT_TABLES, value: word_at(fresh))
    \\        set_word(fresh, value: 0)
    \\    } else {
    \\        fresh = aligned(reserve(2 * PAGE))
    \\    }
    \\    store_word(slot, value: window_entry(fresh, kind: KIND_TABLE))
    \\    return fresh
    \\} descend
    \\
    \\/// The slot of the window entry mapping the page at an address, zero when a table is missing.
    \\fn leaf_slot(table: u64, address: u64) -> u64 {
    \\    let middle = load_word(word_at(table + EXPORT_WINDOW) + index_of(address, shift: GIGABYTE_SHIFT) * 8) & ADDRESS_BITS
    \\    if middle == 0 {
    \\        return 0
    \\    }
    \\    let leaf = load_word(middle + index_of(address, shift: MEGABYTES_SHIFT) * 8) & ADDRESS_BITS
    \\    if leaf == 0 {
    \\        return 0
    \\    }
    \\    return leaf + index_of(address, shift: PAGE_SHIFT) * 8
    \\} leaf_slot
    \\
    \\/// The index in a window table of the entry for an address, its entries each covering
    \\/// `1 << shift` bytes.
    \\fn index_of(address: u64, shift: u32) -> u64 {
    \\    return (address >> shift) & (TABLE_ENTRIES - 1)
    \\} index_of
    \\
    \\/// Whether a window table holds no entry.
    \\fn holds_nothing(held: u64) -> bool {
    \\    for index in 0..<TABLE_ENTRIES {
    \\        if load_word(held + index * 8) != 0 {
    \\            return false
    \\        }
    \\    }
    \\    return true
    \\} holds_nothing
    \\
    \\/// How the field values of a form at two addresses compare: text by its bytes, then its length,
    \\/// integers by value.
    \\fn compare(form: u64, left: u64, right: u64) -> core::Ordering {
    \\    if form == TEXT {
    \\        return compare_text(left, right)
    \\    }
    \\    let width = width_of(form)
    \\    var a = read_le(left, width)
    \\    var b = read_le(right, width)
    \\    if form > SIGNED {
    \\        let flip = 1u64 << u32.fit(width * 8 - 1)
    \\        a = a ^ flip
    \\        b = b ^ flip
    \\    }
    \\    return a.cmp(b)
    \\} compare
    \\
    \\fn compare_text(left: u64, right: u64) -> core::Ordering {
    \\    let left_text = word_at(left)
    \\    let right_text = word_at(right)
    \\    let left_len = word_at(left + 8)
    \\    let right_len = word_at(right + 8)
    \\    var shorter = left_len
    \\    if right_len < shorter {
    \\        shorter = right_len
    \\    }
    \\    for index in 0..<shorter {
    \\        let order = byte_at(left_text + index).cmp(byte_at(right_text + index))
    \\        if order != core::Ordering.Equal {
    \\            return order
    \\        }
    \\    }
    \\    return left_len.cmp(right_len)
    \\} compare_text
    \\
    \\/// The little-endian integer of `width` bytes at an address.
    \\fn read_le(address: u64, width: u64) -> u64 {
    \\    var value: u64 = 0
    \\    for index in 0..<width {
    \\        value = value | (u64.widen(byte_at(address + index)) << u32.fit(index * 8))
    \\    }
    \\    return value
    \\} read_le
    \\
    \\/// An address rounded up to a page.
    \\fn aligned(address: u64) -> u64 {
    \\    return (address + PAGE - 1) / PAGE * PAGE
    \\} aligned
    \\
    \\/// Takes the loader's lock in the kernel's export table.
    \\fn lock(table: u64) {
    \\    let word = hw::Ptr[u64].of_addr(usize.widen(table + EXPORT_LOCK))
    \\    loop {
    \\        let taken = trusted "the export table's lock word lies in the kernel's writable data, aligned" { word.atomic_compare_swap(0, replacement: 1, order: hw::Order.Acquire) }
    \\        if taken.is_ok() {
    \\            return
    \\        }
    \\    }
    \\} lock
    \\
    \\/// Releases the loader's lock.
    \\fn unlock(table: u64) {
    \\    let word = hw::Ptr[u64].of_addr(usize.widen(table + EXPORT_LOCK))
    \\    trusted "the export table's lock word lies in the kernel's writable data, aligned" {
    \\        word.atomic_store(0, order: hw::Order.Release)
    \\    }
    \\} unlock
    \\
    \\/// Copies a span of a bundle's bytes into the runtime memory the loader reserved at `to`.
    \\fn copy_in(bundle: Slice[u8], from: Span, to: u64) {
    \\    let source = hw::Ptr.of_view(bundle)
    \\    trusted "the span lies inside the bundle, and the reserved memory at `to` holds the span's bytes" {
    \\        source.offset(isize.fit(from.start)).copy(hw::Ptr[u8].of_addr(usize.widen(to)), count: from.len)
    \\    }
    \\} copy_in
    \\
    \\/// Copies `len` bytes of an entry into a table version not yet published.
    \\fn copy_memory(from: u64, to: u64, len: u64) {
    \\    trusted "the entry lies in a placed image or a table version, and `to` in a version not yet published" {
    \\        hw::Ptr[u8].of_addr(usize.widen(from)).copy(hw::Ptr[u8].of_addr(usize.widen(to)), count: usize.widen(len))
    \\    }
    \\} copy_memory
    \\
    \\/// The byte at an address of the kernel's tables or of a placed image.
    \\fn byte_at(address: u64) -> u8 {
    \\    return trusted "the address lies in the kernel's export table, its tables, an image the loader placed or the text an entry's key views" { hw::Ptr[u8].of_addr(usize.widen(address)).read() }
    \\} byte_at
    \\
    \\/// The little-endian word at an address, whatever its alignment.
    \\fn word_at(address: u64) -> u64 {
    \\    return read_le(address, width: 8)
    \\} word_at
    \\
    \\/// Writes a little-endian word at an address of memory the loader reserved and has not
    \\/// published.
    \\fn set_word(address: u64, value: u64) {
    \\    for index in 0u64..<8 {
    \\        let byte = u8.truncate(value >> u32.fit(index * 8))
    \\        trusted "the address lies in an image or a table version the loader has not published" {
    \\            hw::Ptr[u8].of_addr(usize.widen(address + index)).write(byte)
    \\        }
    \\    }
    \\} set_word
    \\
    \\/// Reads an aligned word that other CPUs write: a table record's version or line-table link.
    \\fn load_word(address: u64) -> u64 {
    \\    return trusted "the word is an aligned table record or line-table link" { hw::Ptr[u64].of_addr(usize.widen(address)).atomic_load(hw::Order.Acquire) }
    \\} load_word
    \\
    \\/// Writes an aligned word that other CPUs read: a table record's version, a gate word or a
    \\/// line-table link.
    \\fn store_word(address: u64, value: u64) {
    \\    trusted "the word is an aligned table record, gate word or line-table link" {
    \\        hw::Ptr[u64].of_addr(usize.widen(address)).atomic_store(value, order: hw::Order.Release)
    \\    }
    \\} store_word
    \\
    \\/// Reads a uvar, failing past the reader's end.
    \\fn Reader.uvar(mut self, bytes: Slice[u8]) -> u64 fails LoadError {
    \\    var value: u64 = 0
    \\    var shift: u32 = 0
    \\    loop {
    \\        if self.at >= self.end or self.end > bytes.len() or shift > 63 {
    \\            fail LoadError.Malformed
    \\        }
    \\        let byte = bytes[self.at]
    \\        self.at += 1
    \\        value = value | (u64.widen(byte & 0x7F) << shift)
    \\        if (byte & 0x80) == 0 {
    \\            return value
    \\        }
    \\        shift += 7
    \\    }
    \\} Reader.uvar
    \\
    \\/// Reads bytes: their length, then the span they occupy.
    \\fn Reader.span(mut self, bytes: Slice[u8]) -> Span fails LoadError {
    \\    let len = try mut self.uvar(bytes)
    \\    if len > u64.widen(self.end - self.at) {
    \\        fail LoadError.Malformed
    \\    }
    \\    let span = Span(start: self.at, len: usize.widen(len))
    \\    self.at += usize.widen(len)
    \\    return span
    \\} Reader.span
    \\
    \\/// Reads a field: its offset, then its form.
    \\fn Reader.field(mut self, bytes: Slice[u8]) -> Field fails LoadError {
    \\    let offset = try mut self.uvar(bytes)
    \\    let form = try mut self.uvar(bytes)
    \\    return Field(offset: offset, form: form)
    \\} Reader.field
    \\
    \\/// Reads a list of fields into `found`.
    \\fn Reader.fields(mut self, bytes: Slice[u8], mut found: mem::List[Field]) fails LoadError {
    \\    let count = try mut self.uvar(bytes)
    \\    for _ in 0..<count {
    \\        mut found.push(try mut self.field(bytes))
    \\    }
    \\} Reader.fields
    \\
    \\/// Reads a list of function fields, each its offset, into `found` with the gate the table
    \\/// record at `record` names for it.
    \\fn Reader.gates(mut self, bytes: Slice[u8], mut found: mem::List[Gate], record: u64) fails LoadError {
    \\    let count = try mut self.uvar(bytes)
    \\    for _ in 0..<count {
    \\        let offset = try mut self.uvar(bytes)
    \\        let glue = glue_of(record, offset)
    \\        if record == 0 or glue == 0 {
    \\            fail LoadError.Malformed
    \\        }
    \\        mut found.push(Gate(offset: offset, glue: glue))
    \\    }
    \\} Reader.gates
    \\

const TEXT_SYS_LOAD_SPACES: Str =
    \\//! Isolated spaces: bundles verified for them, and spaces of 4 KiB frames mapped for user mode at the user window, where the kernel's user-mode runtime runs a bundle's job with the runtime's exports bound to its imports.
    \\
    \\/// The user window: its first address, the top-level entry mapping it, and the most pages a space
    \\/// maps there, those 512 tables of pages map.
    \\const USER_WINDOW: u64 = 0x80_0000_0000
    \\
    \\const USER_SLOT: u64 = 1
    \\
    \\const USER_PAGES: u64 = TABLE_ENTRIES * TABLE_ENTRIES
    \\
    \\/// The kinds of a user entry: a page of code, of read-only data, of writable data, and a table.
    \\const USER_CODE: u64 = 0
    \\
    \\const USER_READ_ONLY: u64 = 1
    \\
    \\const USER_WRITABLE: u64 = 2
    \\
    \\const USER_TABLE: u64 = 3
    \\
    \\/// The pages of a 64 KiB chunk, to which a space aligns its boot area.
    \\const CHUNK_PAGES: u64 = 16
    \\
    \\/// The pages a space keeps between its caller's data and its boot area for the user frames it
    \\/// shares.
    \\const SHARED_PAGES: u64 = 32
    \\
    \\/// A bundle verified for isolated spaces: its bytes and their parts, its component entries as
    \\/// every space places them, and the image of the kernel's user-mode runtime and its parts.
    \\pub open struct Isolated {
    \\    bundle: mem::Bytes
    \\    parts: Parts
    \\    components: mem::List[Exported]
    \\    runtime_image: mem::Bytes
    \\    runtime: Parts
    \\} Isolated
    \\
    \\/// An isolated space: its root, its other tables, the pages it maps from the start of the user
    \\/// window up to the user frames it shares, laid out as `plan` gives, the pages of its boot area
    \\/// it has drawn, in order of their index from the window's start, and how many user frames it
    \\/// shares; the tables mapping the entry area follow those of the window.
    \\pub open linear struct Space {
    \\    root: hw::PageTableRoot
    \\    tables: mem::List[hw::PhysFrame[4_096]]
    \\    pages: mem::List[hw::PhysFrame[4_096]]
    \\    drawn: mem::List[Drawn]
    \\    shared: u64
    \\    plan: Plan
    \\} Space
    \\
    \\/// A page of a space's boot area it has drawn: its index from the window's start, and its frame.
    \\linear struct Drawn {
    \\    index: u64
    \\    frame: hw::PhysFrame[4_096]
    \\} Drawn
    \\
    \\pub closed enum DrawError derives Copy, Eq, Render {
    \\    Outside
    \\    Exhausted
    \\} DrawError
    \\
    \\/// The pages of a range, by index from the window's start: the lowest, and the highest plus one.
    \\struct Pages derives Copy {
    \\    low: u64
    \\    end: u64
    \\} Pages
    \\
    \\/// The pages of the entry area, from `low` to `high`.
    \\struct Reach derives Copy {
    \\    low: u64
    \\    high: u64
    \\} Reach
    \\
    \\/// Where a space's pages lie, by index from the window's start: the runtime's image and the
    \\/// bundle's image, each with the first pages of its read-only and of its writable data from its
    \\/// start, the runtime's stack, the caller's data, the user frames it shares, the boot area and
    \\/// the end; and the offset of the runtime's start.
    \\struct Plan derives Copy {
    \\    runtime: Sections
    \\    image: u64
    \\    image_sections: Sections
    \\    stack: u64
    \\    data: u64
    \\    shared: u64
    \\    boot: u64
    \\    end: u64
    \\    start: u64
    \\} Plan
    \\
    \\/// The first pages of an image's read-only data and of its writable data.
    \\struct Sections derives Copy {
    \\    read_only: u64
    \\    writable: u64
    \\} Sections
    \\
    \\pub fn Loader.isolate(self, bundle: Slice[u8], keys: Slice[core::crypto::PublicKey], alloc: mem::Alloc) -> Isolated fails LoadError {
    \\    let body = try body_of(bundle)
    \\    if not verified(bundle, body, keys) {
    \\        fail LoadError.Signature
    \\    }
    \\    return try self.isolated_of(bundle, body, alloc)
    \\} Loader.isolate
    \\
    \\pub fn Loader.isolate_unverified(self, bundle: Slice[u8], alloc: mem::Alloc) -> Isolated fails LoadError {
    \\    return try self.isolated_of(bundle, body: try body_of(bundle), alloc)
    \\} Loader.isolate_unverified
    \\
    \\/// The isolated bundle of a bundle whose body `body` is.
    \\fn Loader.isolated_of(self, bundle: Slice[u8], body: Span, alloc: mem::Alloc) -> Isolated fails LoadError {
    \\    let parts = try placeable_parts(bundle, body)
    \\    let image = self.runtime()
    \\    let runtime = try placeable_parts(image, body: try body_of(image))
    \\    if not runtime.job or runtime.exports.len == 0 {
    \\        fail LoadError.Interface
    \\    }
    \\    let components = try components_of(bundle, parts, window: image_window(runtime), alloc)
    \\    var copy = mem::Bytes.empty(alloc)
    \\    mut copy.append(bundle)
    \\    var runtime_copy = mem::Bytes.empty(alloc)
    \\    mut runtime_copy.append(image)
    \\    return Isolated(bundle: take copy, parts: parts, components: take components, runtime_image: take runtime_copy, runtime: runtime)
    \\} Loader.isolated_of
    \\
    \\pub fn Isolated.job(self) -> Option[Job] {
    \\    if not self.parts.job {
    \\        return None
    \\    }
    \\    return Some(Job.at(image_window(self.runtime) + self.parts.entry, stack: self.parts.stack))
    \\} Isolated.job
    \\
    \\pub fn Isolated.component(self, name: Str) -> Option[Job] {
    \\    return component_in(self.components, name)
    \\} Isolated.component
    \\
    \\/// Where a space places the image of a bundle, after the runtime's of these parts.
    \\fn image_window(runtime: Parts) -> u64 {
    \\    return USER_WINDOW + pages_of(runtime.size) * PAGE
    \\} image_window
    \\
    \\pub fn Isolated.space(self, cpu: hw::Ring0, data: u64, mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> Space fails LoadError {
    \\    let plan = plan_of(self.runtime, image: self.parts, data)
    \\    let area = cpu.entry_area()
    \\    let reach = Reach(low: area.base / PAGE, high: (area.base + area.len - 1) / PAGE)
    \\    if area.len == 0 or plan.end > USER_PAGES or u64.widen(frames.len()) < 3 + tables_of(plan) + plan.shared + reach.tables() {
    \\        fail LoadError.Unplaceable
    \\    }
    \\    if reach.low / level_pages(0) <= USER_SLOT and reach.high / level_pages(0) >= USER_SLOT {
    \\        fail LoadError.Unplaceable
    \\    }
    \\    let image_base = image_window(self.runtime)
    \\    let runtime_copy = try relocated_copy(self.runtime_image.view(), parts: self.runtime, window: USER_WINDOW)
    \\    set_word(runtime_copy + self.runtime.lines + LINES_NEXT, value: image_base + self.parts.lines)
    \\    let image_copy = match attempt self.bound_copy(window: image_base) {
    \\        Ok(copy) => copy
    \\        Err(error) => {
    \\            release(runtime_copy)
    \\            fail error
    \\        }
    \\    }
    \\    var space = match attempt mapped(plan, reach, mut frames, alloc) {
    \\        Ok(space) => space
    \\        Err(error) => {
    \\            release(runtime_copy)
    \\            release(image_copy)
    \\            fail error
    \\        }
    \\    }
    \\    mut space.fill(at_page: 0, from: runtime_copy, len: self.runtime.size)
    \\    mut space.fill(at_page: plan.image, from: image_copy, len: self.parts.size)
    \\    release(runtime_copy)
    \\    release(image_copy)
    \\    sync(space.pages[0].base(), len: plan.stack * PAGE)
    \\    return space
    \\} Isolated.space
    \\
    \\/// The address at which the runtime starts, with the address of a start record and the boot
    \\/// area's.
    \\pub fn Space.start(self) -> u64 {
    \\    return USER_WINDOW + self.plan.start
    \\} Space.start
    \\
    \\/// The top of the stack the runtime starts on.
    \\pub fn Space.stack(self) -> u64 {
    \\    return USER_WINDOW + self.plan.data * PAGE
    \\} Space.stack
    \\
    \\/// The first address of the data the caller lays out, the start record among it.
    \\pub fn Space.data(self) -> u64 {
    \\    return USER_WINDOW + self.plan.data * PAGE
    \\} Space.data
    \\
    \\/// The first address of the boot area the runtime runs over.
    \\pub fn Space.boot_area(self) -> u64 {
    \\    return USER_WINDOW + self.plan.boot * PAGE
    \\} Space.boot_area
    \\
    \\pub fn Space.share(mut self, frame: hw::UserFrame) -> u64 fails LoadError {
    \\    let index = self.plan.shared + self.shared
    \\    if index >= self.plan.boot {
    \\        fail LoadError.Unplaceable
    \\    }
    \\    write_entry(self.entry_of(index), value: user_entry(frame.base(), kind: USER_WRITABLE))
    \\    self.shared += 1
    \\    return USER_WINDOW + index * PAGE
    \\} Space.share
    \\
    \\pub fn Space.run(self, cpu: hw::Ring0, mut state: hw::UserState, mut extended: Option[hw::ExtendedState]) -> hw::UserExit {
    \\    return trusted "the root maps the entry area page by page with the attributes the running root's walk gives it, and for user mode only the window, whose pages are frames the space owns, holding no value of the kernel, and user frames; the user path drops the translations cached under its tag" { cpu.run_user_split(mut state, mut extended, root: self.root) }
    \\} Space.run
    \\
    \\pub fn Space.read(self, address: u64, len: u64, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails hw::UserAddrError {
    \\    var bytes = mem::Bytes.zeroed(usize.widen(len), alloc)
    \\    if not self.covers(address, len, writing: false) {
    \\        fail hw::UserAddrError.Unmapped
    \\    }
    \\    let into = hw::Ptr.of_view_mut(mut bytes.view_mut())
    \\    self.each_part(address, len, body: fn(physical: u64, at: u64, count: u64) {
    \\        trusted "the frame at `physical` is the space's, and `into` holds `len` bytes" {
    \\            hw::Ptr[u8].of_addr(usize.widen(physical)).copy(into.offset(isize.fit(at)), count: usize.widen(count))
    \\        }
    \\    })
    \\    return Untrusted.of(take bytes)
    \\} Space.read
    \\
    \\pub fn Space.write(mut self, address: u64, bytes: Slice[u8]) fails hw::UserAddrError {
    \\    let len = u64.widen(bytes.len())
    \\    if not self.covers(address, len, writing: true) {
    \\        fail hw::UserAddrError.Unmapped
    \\    }
    \\    let from = hw::Ptr.of_view(bytes)
    \\    self.each_part(address, len, body: fn(physical: u64, at: u64, count: u64) {
    \\        trusted "the frame at `physical` is the space's, and `bytes` holds `len` bytes" {
    \\            from.offset(isize.fit(at)).copy(hw::Ptr[u8].of_addr(usize.widen(physical)), count: usize.widen(count))
    \\        }
    \\    })
    \\} Space.write
    \\
    \\pub fn Space.draw(mut self, address: u64, len: u64, mut frames: mem::List[hw::PhysFrame[4_096]]) -> u64 fails DrawError {
    \\    let range = try self.boot_pages(address, len)
    \\    var missing: u64 = 0
    \\    for index in range.low..<range.end {
    \\        if self.frame_of(index).is_none() {
    \\            missing += 1
    \\        }
    \\    }
    \\    if u64.widen(frames.len()) < missing {
    \\        fail DrawError.Exhausted
    \\    }
    \\    for index in range.low..<range.end {
    \\        let at = self.drawn_from(index)
    \\        if at == self.drawn.len() or self.drawn[at].index != index {
    \\            let Some(frame) = mut frames.pop() else {
    \\                fail DrawError.Exhausted
    \\            }
    \\            clear(frame.base())
    \\            write_entry(self.entry_of(index), value: user_entry(frame.base(), kind: USER_WRITABLE))
    \\            mut self.drawn.insert(at, value: Drawn(index: index, frame: take frame))
    \\        }
    \\    }
    \\    return missing
    \\} Space.draw
    \\
    \\pub fn Space.give_back(mut self, address: u64, len: u64, mut frames: mem::List[hw::PhysFrame[4_096]]) fails DrawError {
    \\    let range = try self.boot_pages(address, len)
    \\    for index in range.low..<range.end {
    \\        let at = self.drawn_from(index)
    \\        if at < self.drawn.len() and self.drawn[at].index == index {
    \\            write_entry(self.entry_of(index), value: 0)
    \\            let Drawn(index: _, frame: frame) = mut self.drawn.remove(at)
    \\            mut frames.push(take frame)
    \\        }
    \\    }
    \\} Space.give_back
    \\
    \\/// Gives back every frame the space took.
    \\pub fn Space.release(take self, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    \\    let Space(root: root, tables: tables, pages: pages, drawn: drawn, shared: _, plan: _) = self
    \\    mut frames.push(take root.into_frame())
    \\    given_back(take tables, mut frames)
    \\    given_back(take pages, mut frames)
    \\    for held in take drawn {
    \\        let Drawn(index: _, frame: frame) = held
    \\        mut frames.push(take frame)
    \\    }
    \\} Space.release
    \\
    \\/// The pages of the boot area a range of `len` bytes from `address` touches, failing for a range
    \\/// reaching outside the boot area.
    \\fn Space.boot_pages(self, address: u64, len: u64) -> Pages fails DrawError {
    \\    let start = USER_WINDOW + self.plan.boot * PAGE
    \\    let end = USER_WINDOW + self.plan.end * PAGE
    \\    if address < start or address > end or end - address < len {
    \\        fail DrawError.Outside
    \\    }
    \\    let offset = address - USER_WINDOW
    \\    return Pages(low: offset / PAGE, end: pages_of(offset + len))
    \\} Space.boot_pages
    \\
    \\/// The address of the entry of the table of pages mapping the page of an index.
    \\fn Space.entry_of(self, index: u64) -> u64 {
    \\    return self.tables[usize.widen(index / TABLE_ENTRIES) + 2].base() + index % TABLE_ENTRIES * 8
    \\} Space.entry_of
    \\
    \\/// The physical address of the frame the space owns at the page of an index, none for a page
    \\/// it does not map or maps a user frame at.
    \\fn Space.frame_of(self, index: u64) -> Option[u64] {
    \\    if index < self.plan.shared {
    \\        return Some(self.pages[usize.widen(index)].base())
    \\    }
    \\    if index < self.plan.boot {
    \\        return None
    \\    }
    \\    let at = self.drawn_from(index)
    \\    if at < self.drawn.len() and self.drawn[at].index == index {
    \\        return Some(self.drawn[at].frame.base())
    \\    }
    \\    return None
    \\} Space.frame_of
    \\
    \\/// The position in `drawn` of the first page drawn whose index is not below `index`.
    \\fn Space.drawn_from(self, index: u64) -> usize {
    \\    var low: usize = 0
    \\    var high = self.drawn.len()
    \\    while low < high {
    \\        let middle = low + (high - low) / 2
    \\        if self.drawn[middle].index < index {
    \\            low = middle + 1
    \\        } else {
    \\            high = middle
    \\        }
    \\    }
    \\    return low
    \\} Space.drawn_from
    \\
    \\/// The address of the runtime's export of an index, failing for one it does not define.
    \\fn runtime_export(image: Slice[u8], runtime: Parts, index: u64) -> u64 fails LoadError {
    \\    var reader = Reader(at: runtime.exports.start, end: runtime.exports.start + runtime.exports.len)
    \\    let count = try mut reader.uvar(image)
    \\    if index >= count {
    \\        fail LoadError.Interface
    \\    }
    \\    for _ in 0..<index {
    \\        discard try mut reader.uvar(image)
    \\    }
    \\    let offset = try mut reader.uvar(image)
    \\    if offset == 0 or offset > runtime.size {
    \\        fail LoadError.Interface
    \\    }
    \\    return USER_WINDOW + offset - 1
    \\} runtime_export
    \\
    \\/// A copy in runtime memory of an image, its whole size, relocated for its address `window`;
    \\/// `release` frees it.
    \\fn relocated_copy(bundle: Slice[u8], parts: Parts, window: u64) -> u64 fails LoadError {
    \\    let copy = reserve(parts.size)
    \\    copy_in(bundle, from: parts.image, to: copy)
    \\    match attempt relocate(bundle, parts, base: copy, window) {
    \\        Ok(_) => return copy
    \\        Err(error) => {
    \\            release(copy)
    \\            fail error
    \\        }
    \\    }
    \\} relocated_copy
    \\
    \\/// The pages of `bytes` bytes.
    \\fn pages_of(bytes: u64) -> u64 {
    \\    return (bytes + PAGE - 1) / PAGE
    \\} pages_of
    \\
    \\/// The plan of a space for a runtime and a bundle's image, with `data` bytes for the caller.
    \\fn plan_of(runtime: Parts, image: Parts, data: u64) -> Plan {
    \\    let at = pages_of(runtime.size)
    \\    let stack = at + pages_of(image.size)
    \\    let start = stack + pages_of(runtime.stack)
    \\    let shared = start + pages_of(data)
    \\    let boot = (shared + SHARED_PAGES + CHUNK_PAGES - 1) / CHUNK_PAGES * CHUNK_PAGES
    \\    return Plan(runtime: sections_of(runtime), image: at, image_sections: sections_of(image), stack: stack, data: start, shared: shared, boot: boot, end: boot + pages_of(runtime.boot), start: runtime.entry)
    \\} plan_of
    \\
    \\fn sections_of(parts: Parts) -> Sections {
    \\    return Sections(read_only: parts.read_only / PAGE, writable: parts.writable / PAGE)
    \\} sections_of
    \\
    \\/// The tables of pages a plan needs.
    \\fn tables_of(plan: Plan) -> u64 {
    \\    return (plan.end + TABLE_ENTRIES - 1) / TABLE_ENTRIES
    \\} tables_of
    \\
    \\/// A relocated copy of the bundle's image for its address `window`, its imports bound to the
    \\/// runtime's exports.
    \\fn Isolated.bound_copy(self, window: u64) -> u64 fails LoadError {
    \\    let copy = try relocated_copy(self.bundle.view(), parts: self.parts, window)
    \\    let image = self.runtime_image.view()
    \\    let bound = attempt bind(self.bundle.view(), parts: self.parts, base: copy, address: fn(index: u64) -> u64 fails LoadError {
    \\        return try runtime_export(image, runtime: self.runtime, index)
    \\    })
    \\    match bound {
    \\        Ok(_) => return copy
    \\        Err(error) => {
    \\            release(copy)
    \\            fail error
    \\        }
    \\    }
    \\} Isolated.bound_copy
    \\
    \\/// The space of a plan, its frames taken from `frames` and cleared: a root mapping the window and
    \\/// the pages of the entry area `reach` holds, a table of 1 GiB entries and one of 2 MiB entries
    \\/// mapping the window, the tables of its pages, its pages up to the user frames it shares, and
    \\/// the tables mapping the entry area.
    \\fn mapped(plan: Plan, reach: Reach, mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> Space fails LoadError {
    \\    let count = tables_of(plan)
    \\    var tables = cleared_frames(mut frames, count: count + 2 + reach.tables(), alloc)
    \\    var pages = cleared_frames(mut frames, count: plan.shared, alloc)
    \\    let Some(root) = mut frames.pop() else {
    \\        given_back(take tables, mut frames)
    \\        given_back(take pages, mut frames)
    \\        fail LoadError.Unplaceable
    \\    }
    \\    let top = root.base()
    \\    clear(top)
    \\    write_entry(top + USER_SLOT * 8, value: user_entry(tables[0].base(), kind: USER_TABLE))
    \\    write_entry(tables[0].base(), value: user_entry(tables[1].base(), kind: USER_TABLE))
    \\    for index in 0u64..<count {
    \\        write_entry(tables[1].base() + index * 8, value: user_entry(tables[usize.widen(index) + 2].base(), kind: USER_TABLE))
    \\    }
    \\    let space = Space(root: hw::PageTableRoot.of(take root), tables: take tables, pages: take pages, drawn: mem::List[Drawn].empty(alloc), shared: 0, plan: plan)
    \\    for index in 0u64..<plan.shared {
    \\        write_entry(space.entry_of(index), value: user_entry(space.pages[usize.widen(index)].base(), kind: space.kind_of(index)))
    \\    }
    \\    space.map_entry_area(root: top, reach, first_table: count + 2)
    \\    return space
    \\} mapped
    \\
    \\/// The number of tables mapping the pages of the entry area: at each level below the root, one
    \\/// per range of pages a table of that level maps.
    \\fn Reach.tables(self) -> u64 {
    \\    var count: u64 = 0
    \\    for level in 0usize..<3 {
    \\        count += self.high / level_pages(level) - self.low / level_pages(level) + 1
    \\    }
    \\    return count
    \\} Reach.tables
    \\
    \\/// The physical address of the table of a level below the root mapping the page of an index in
    \\/// the entry area, the tables of each level following those of the level above from `first_table`.
    \\fn Space.entry_table(self, reach: Reach, first_table: u64, level: usize, index: u64) -> u64 {
    \\    var at = first_table
    \\    for above in 0usize..<level {
    \\        at += reach.high / level_pages(above) - reach.low / level_pages(above) + 1
    \\    }
    \\    let pages = level_pages(level)
    \\    return self.tables[usize.widen(at + index / pages - reach.low / pages)].base()
    \\} Space.entry_table
    \\
    \\/// Maps each page of the entry area as the running root does, through the tables from
    \\/// `first_table` linked from the root at the physical address `root`.
    \\fn Space.map_entry_area(self, root: u64, reach: Reach, first_table: u64) {
    \\    for level in 0usize..<3 {
    \\        let pages = level_pages(level)
    \\        for unit in (reach.low / pages)..<(reach.high / pages + 1) {
    \\            let table = self.entry_table(reach, first_table, level, index: unit * pages)
    \\            var above = root
    \\            if level > 0 {
    \\                above = self.entry_table(reach, first_table, level: level - 1, index: unit * pages)
    \\            }
    \\            write_entry(above + unit % TABLE_ENTRIES * 8, value: user_entry(table, kind: USER_TABLE))
    \\        }
    \\    }
    \\    for index in reach.low..<(reach.high + 1) {
    \\        let table = self.entry_table(reach, first_table, level: 2, index)
    \\        write_entry(table + index % TABLE_ENTRIES * 8, value: running_page(index * PAGE))
    \\    }
    \\} Space.map_entry_area
    \\
    \\/// The entry of the 4 KiB page at `address` with the attributes the running root's walk gives
    \\/// it, its leaf's restricted by the tables above, zero where the running root maps nothing.
    \\fn running_page(address: u64) -> u64 {
    \\    var table = running_root()
    \\    var passed = Array[u64, 3].filled(0)
    \\    for level in 0u64..<4 {
    \\        let span = TABLE_ENTRIES * TABLE_ENTRIES * TABLE_ENTRIES * PAGE / pow_of(level)
    \\        let entry = table_word(table, index: address / span % TABLE_ENTRIES)
    \\        var leaf = page_of(entry, level, offset: address % span)
    \\        if leaf != 0 {
    \\            for at in 0u64..<level {
    \\                leaf = restricted_page(leaf, table: passed[usize.widen(at)])
    \\            }
    \\            return leaf
    \\        }
    \\        table = linked_table(entry, level)
    \\        if table == 0 {
    \\            return 0
    \\        }
    \\        passed[usize.widen(level)] = entry
    \\    }
    \\    return 0
    \\} running_page
    \\
    \\/// The pages a table of a level below the root maps: one of 1 GiB entries, of 2 MiB entries,
    \\/// and of pages.
    \\fn level_pages(level: usize) -> u64 {
    \\    return pow_of(3 - u64.widen(level))
    \\} level_pages
    \\
    \\/// 512 to the power of a level.
    \\fn pow_of(level: u64) -> u64 {
    \\    var power: u64 = 1
    \\    for _ in 0u64..<level {
    \\        power *= TABLE_ENTRIES
    \\    }
    \\    return power
    \\} pow_of
    \\
    \\/// Up to `count` frames taken from the end of `frames`, cleared.
    \\fn cleared_frames(mut frames: mem::List[hw::PhysFrame[4_096]], count: u64, alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    \\    var cleared = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    \\    for _ in 0u64..<count {
    \\        match mut frames.pop() {
    \\            Some(frame) => {
    \\                clear(frame.base())
    \\                mut cleared.push(take frame)
    \\            }
    \\            None => {}
    \\        }
    \\    }
    \\    return cleared
    \\} cleared_frames
    \\
    \\/// Gives back the frames of a list.
    \\fn given_back(take from: mem::List[hw::PhysFrame[4_096]], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    \\    for frame in take from {
    \\        mut frames.push(take frame)
    \\    }
    \\} given_back
    \\
    \\/// Clears the frame at a physical address.
    \\fn clear(base: u64) {
    \\    let zeros = Array[u8, 4_096].filled(0)
    \\    trusted "the frame is one the space takes, at its physical address, which the shared space maps" {
    \\        hw::Ptr.of_view(zeros.view()).copy(hw::Ptr[u8].of_addr(usize.widen(base)), count: 4_096)
    \\    }
    \\} clear
    \\
    \\/// The kind of the user entry mapping a page of a space, by its index.
    \\fn Space.kind_of(self, index: u64) -> u64 {
    \\    let plan = self.plan
    \\    if index < plan.image {
    \\        return image_kind(index, sections: plan.runtime)
    \\    }
    \\    if index < plan.stack {
    \\        return image_kind(index - plan.image, sections: plan.image_sections)
    \\    }
    \\    return USER_WRITABLE
    \\} Space.kind_of
    \\
    \\/// The kind of a page of an image, by its index there.
    \\fn image_kind(index: u64, sections: Sections) -> u64 {
    \\    if index < sections.read_only {
    \\        return USER_CODE
    \\    }
    \\    if index < sections.writable {
    \\        return USER_READ_ONLY
    \\    }
    \\    return USER_WRITABLE
    \\} image_kind
    \\
    \\/// Whether `len` bytes from `address` lie in pages the space maps, each writable for `writing`.
    \\fn Space.covers(self, address: u64, len: u64, writing: bool) -> bool {
    \\    let end = USER_WINDOW + self.plan.end * PAGE
    \\    if address < USER_WINDOW or address > end or end - address < len {
    \\        return false
    \\    }
    \\    let offset = address - USER_WINDOW
    \\    for index in (offset / PAGE)..<pages_of(offset + len) {
    \\        if self.frame_of(index).is_none() or (writing and self.kind_of(index) != USER_WRITABLE) {
    \\            return false
    \\        }
    \\    }
    \\    return true
    \\} Space.covers
    \\
    \\/// Calls `body` on each part of `len` bytes from `address` that one page holds: the part's
    \\/// physical address, its offset in the bytes and its length.
    \\fn Space.each_part(self, address: u64, len: u64, body: fn(physical: u64, at: u64, count: u64)) {
    \\    var at: u64 = 0
    \\    while at < len {
    \\        let offset = address - USER_WINDOW + at
    \\        let within = offset % PAGE
    \\        var count = PAGE - within
    \\        if len - at < count {
    \\            count = len - at
    \\        }
    \\        body(self.frame_of(offset / PAGE).value_or(0) + within, at: at, count: count)
    \\        at += count
    \\    }
    \\} Space.each_part
    \\
    \\/// Copies `len` bytes of runtime memory at `from` into the space's pages from `at_page`.
    \\fn Space.fill(mut self, at_page: u64, from: u64, len: u64) {
    \\    self.each_part(USER_WINDOW + at_page * PAGE, len, body: fn(physical: u64, at: u64, count: u64) {
    \\        copy_memory(from + at, to: physical, len: count)
    \\    })
    \\} Space.fill
    \\
    \\/// Writes an entry of a table the space holds.
    \\fn write_entry(address: u64, value: u64) {
    \\    trusted "the address lies in a table frame the space holds" {
    \\        hw::Ptr[u64].of_addr(usize.widen(address)).write(value)
    \\    }
    \\} write_entry
    \\
    \\/// The image of the kernel's user-mode runtime, empty in a kernel built without one.
    \\proj fn Loader.runtime(self) -> Slice[u8]
    \\
    \\/// The entry of a kind mapping a page or table at a physical address for user mode.
    \\fn user_entry(physical: u64, kind: u64) -> u64
    \\
    \\/// The physical address of the running root's top-level table.
    \\fn running_root() -> u64
    \\
    \\/// An entry of a table of the running root at its physical address.
    \\fn table_word(table: u64, index: u64) -> u64 {
    \\    return trusted "the running root's tables lie at their physical addresses, which the shared space maps" { hw::Ptr[u64].of_addr(usize.widen(table + index * 8)).read() }
    \\} table_word
    \\
    \\/// The physical address of the table an entry of a level links to, the root's level 0, or zero
    \\/// for an entry linking none.
    \\fn linked_table(entry: u64, level: u64) -> u64
    \\
    \\/// The entry of the 4 KiB page `offset` bytes into what an entry of a level maps, with its
    \\/// attributes, or zero for an entry mapping no memory there.
    \\fn page_of(entry: u64, level: u64, offset: u64) -> u64
    \\
    \\/// A page entry with the restrictions a table entry above it imposes.
    \\fn restricted_page(leaf: u64, table: u64) -> u64
    \\

const TEXT_SYS_NET_NET: Str =
    \\//! Listeners, connections and their errors.
    \\
    \\pub open struct Listener {
    \\} Listener
    \\
    \\pub fn Listener.accept(mut self) -> Conn fails NetError uses wait
    \\
    \\pub open linear struct Conn {
    \\} Conn
    \\
    \\pub fn Conn.read(mut self, mut buf: Untrusted[SliceMut[u8]]) -> usize fails NetError uses wait
    \\    ensures result <= buf.byte_len()
    \\
    \\pub fn Conn.write(mut self, data: Slice[u8]) -> usize fails NetError uses wait
    \\    ensures result <= data.len()
    \\    ensures data.is_empty() or result >= 1
    \\
    \\pub fn Conn.close(take self) fails NetError uses wait
    \\
    \\pub fn Conn.abandon(take self)
    \\
    \\pub open enum NetError derives Render {
    \\    Refused
    \\    Reset
    \\    Unreachable
    \\    AddressInUse
    \\    Denied
    \\    Revoked(sys::Revoked) from
    \\    Cancelled(task::Cancelled) from
    \\} NetError
    \\
    \\test accept_takes_a_loopback_connection for Listener.accept {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    var listener = try await loopback.listen(4_100)
    \\    try await task::scope(world.exec, body: fn[mut listener](s: task::Scope) fails NetError uses wait {
    \\        discard s.spawn(fn() fails NetError uses wait {
    \\            let client = try await loopback.connect("localhost", port: 4_100)
    \\            take client.abandon()
    \\        })
    \\        let server = try await mut listener.accept()
    \\        take server.abandon()
    \\    })
    \\} accept_takes_a_loopback_connection
    \\
    \\test read_receives_the_peer_bytes for Conn.read {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    let clock = world.clock
    \\    var listener = try await loopback.listen(4_100)
    \\    var count: usize = 0
    \\    try await task::scope(world.exec, body: fn[mut listener, mut count](s: task::Scope) fails NetError uses wait {
    \\        discard s.spawn(fn() fails NetError uses wait {
    \\            var client = try await loopback.connect("localhost", port: 4_100)
    \\            defer take client.abandon()
    \\            discard try await mut client.write(b"x")
    \\            try await clock.sleep(100)
    \\        })
    \\        var server = try await mut listener.accept()
    \\        defer take server.abandon()
    \\        var buf = Untrusted.of(Array[u8, 4].filled(0))
    \\        count = try await mut server.read(mut buf.view_mut())
    \\    })
    \\    expect count == 1
    \\} read_receives_the_peer_bytes
    \\
    \\test write_sends_part_of_the_data for Conn.write {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    var listener = try await loopback.listen(4_100)
    \\    var sent: usize = 0
    \\    try await task::scope(world.exec, body: fn[mut listener, mut sent](s: task::Scope) fails NetError uses wait {
    \\        let client = s.spawn(fn() -> usize fails NetError uses wait {
    \\            var conn = try await loopback.connect("localhost", port: 4_100)
    \\            defer take conn.abandon()
    \\            return try await mut conn.write(b"ping")
    \\        })
    \\        let server = try await mut listener.accept()
    \\        defer take server.abandon()
    \\        sent = try await take client.join()
    \\    })
    \\    expect sent >= 1
    \\} write_sends_part_of_the_data
    \\
    \\test close_shuts_the_connection_down for Conn.close {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    var listener = try await loopback.listen(4_100)
    \\    try await task::scope(world.exec, body: fn[mut listener](s: task::Scope) fails NetError uses wait {
    \\        let client = s.spawn(fn() fails NetError uses wait {
    \\            let conn = try await loopback.connect("localhost", port: 4_100)
    \\            try await take conn.close()
    \\        })
    \\        let server = try await mut listener.accept()
    \\        defer take server.abandon()
    \\        try await take client.join()
    \\    })
    \\} close_shuts_the_connection_down
    \\
    \\test abandon_resets_the_peer for Conn.abandon {
    \\    let world = testing::world()
    \\    let loopback = world.net
    \\    var listener = try await loopback.listen(4_100)
    \\    var reset = false
    \\    try await task::scope(world.exec, body: fn[mut listener, mut reset](s: task::Scope) fails NetError uses wait {
    \\        let client = s.spawn(fn() fails NetError uses wait {
    \\            let conn = try await loopback.connect("localhost", port: 4_100)
    \\            take conn.abandon()
    \\        })
    \\        var server = try await mut listener.accept()
    \\        defer take server.abandon()
    \\        try await take client.join()
    \\        var buf = Untrusted.of(Array[u8, 4].filled(0))
    \\        let outcome = attempt await mut server.read(mut buf.view_mut())
    \\        reset = match outcome {
    \\            Err(NetError.Reset) => true
    \\            else => false
    \\        }
    \\    })
    \\    expect reset
    \\} abandon_resets_the_peer
    \\

const TEXT_SYS_PACKAGE: Str =
    \\//! The sys capabilities, revocation, domains and components.
    \\
    \\package sys {
    \\    language 1
    \\    targets any
    \\} sys
    \\

const TEXT_SYS_SIM_SIM: Str =
    \\//! Simulated sys capabilities.
    \\
    \\pub fn fs(limit: usize, alloc: mem::Alloc) -> sys::Fs
    \\
    \\pub fn net() -> sys::Net
    \\
    \\pub fn random(seed: u64) -> sys::Random
    \\    example attempt random(7).next_u64() == Ok(14_742_688_630_346_610_928)
    \\
    \\pub fn stdio(input: Slice[u8], alloc: mem::Alloc) -> sys::Stdio
    \\
    \\test small_fs_refuses_a_large_write for fs {
    \\    let world = testing::world()
    \\    let small = fs(4, alloc: world.alloc)
    \\    let outcome = attempt await small.write_all("big", data: b"hello")
    \\    let full = match outcome {
    \\        Err(fs::FsError.NoSpace) => true
    \\        else => false
    \\    }
    \\    expect full
    \\} small_fs_refuses_a_large_write
    \\
    \\test loopback_reaches_no_other_host for net {
    \\    let loopback = net()
    \\    let outcome = attempt await loopback.connect("example.com", port: 80)
    \\    var unreachable = false
    \\    match outcome {
    \\        Ok(conn) => take conn.abandon()
    \\        Err(failure) => {
    \\            unreachable = match failure {
    \\                net::NetError.Unreachable => true
    \\                else => false
    \\            }
    \\        }
    \\    }
    \\    expect unreachable
    \\} loopback_reaches_no_other_host
    \\
    \\test random_yields_stream_two_of_its_seed for random {
    \\    let value = try random(7).next_u64()
    \\    expect value == 14_742_688_630_346_610_928
    \\} random_yields_stream_two_of_its_seed
    \\
    \\test input_is_read_then_ends for stdio {
    \\    let world = testing::world()
    \\    let input = stdio(b"hi", alloc: world.alloc)
    \\    var buf = Untrusted.of(Array[u8, 8].filled(0))
    \\    var total: usize = 0
    \\    loop {
    \\        let count = try await input.read_in(mut buf.view_mut())
    \\        if count == 0 {
    \\            break
    \\        }
    \\        total += count
    \\    }
    \\    expect total == 2
    \\} input_is_read_then_ends
    \\

