//! Sums the bytes of each module the kernel boots with, clears it and sums them again.

registers Uart {
    data: u8 at 0x0 write
} Uart

fn say(text: Slice[u8]) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in text {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say

/// The sum of a module's bytes.
validator fn sum(contents: Untrusted[Slice[u8]]) -> u64 {
    var total: u64 = 0
    for byte in contents.inspect() {
        total += u64.widen(byte)
    }
    return total
} sum

/// Appends a number in decimal.
fn decimal(value: u64, mut out: mem::Bytes) {
    var digits = Array[u8, 20].filled(b'0')
    var rest = value
    var leading: usize = 19
    for position in 0usize..<20 {
        let at = 19 - position
        digits[at] = b'0' + u8.fit(rest % 10)
        rest = rest / 10
        if digits[at] != b'0' {
            leading = at
        }
    }
    let Some(parts) = digits.view().split_at(leading) else {
        return
    }
    mut out.append(parts.tail)
} decimal

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    var modules = mut k.modules()
    var report = mem::Bytes.empty(alloc)
    for module in mut modules {
        mut report.append(b"module: ")
        decimal(u64.widen(module.contents().byte_len()), out: mut report)
        mut report.append(b" bytes summing to ")
        decimal(sum(module.contents()), out: mut report)
        mut module.clear()
        mut report.append(b", then to ")
        decimal(sum(module.contents()), out: mut report)
        mut report.push(b'\n')
    }
    say(report.view())
    take k.anchor(take modules, run: fn(exec: task::Executor) limits stack 16_384 {
    })
} main
