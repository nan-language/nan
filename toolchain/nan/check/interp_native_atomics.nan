//! The atomics the interpreter supplies: each holds a reference to an extent of its own, which its operations read and replace through a read receiver.

/// A member of a `core::atomic` type, by the type's name; none for another member.
fn Interpreter.atomic_member(mut self, name: Str, member: Str, args: Slice[Val]) -> Option[InterpFlow] {
    let alloc = self.alloc
    let scalar = match name {
        "AtomicU8" => ty::Scalar.Unsigned8
        "AtomicU16" => ty::Scalar.Unsigned16
        "AtomicU32" => ty::Scalar.Unsigned32
        "AtomicU64" => ty::Scalar.Unsigned64
        "AtomicUsize" => ty::Scalar.UnsignedSize
        "AtomicBool" => ty::Scalar.Bool
        else => return None
    }
    if member == "of" {
        let extent = mut self.memory.alloc(args[0].copy(alloc), writable: true, size: 0)
        let atomic = self.ty_item("core::atomic", name)
        let cell = Val.Ref(Loc(extent: extent, path: mem::List[u32].empty(alloc)))
        return Some(InterpFlow.Return(Val.Struct(item: atomic, fields: mem::Shared.of(Val.single(take cell, alloc), alloc))))
    }
    let held = self.deref(args[0])
    let Val.Ref(cell) = held.fields()[0] else {
        expect false
        return None
    }
    let previous = self.memory.get(cell).copy(alloc)
    let option = self.ty_item("core", name: "Option")
    var stored: Option[Val] = None
    var result = Val.Unit
    match member {
        "load" => {
            result = previous
        }
        "store" => {
            stored = Some(args[1].copy(alloc))
        }
        "swap" => {
            stored = Some(args[1].copy(alloc))
            result = previous
        }
        "compare_swap" => {
            let outcome = self.ty_item("core", name: "Result")
            if self.equal(previous, right: args[1]) {
                stored = Some(args[2].copy(alloc))
                result = Val.Variant(item: outcome, index: 0, fields: mem::Shared.of(Val.single(take previous, alloc), alloc))
            } else {
                result = Val.Variant(item: outcome, index: 1, fields: mem::Shared.of(Val.single(take previous, alloc), alloc))
            }
        }
        "fetch_add" or "fetch_sub" => {
            let amount = args[1].int_value()
            var exact = previous.int_value().wrapping_sub(amount)
            if member == "fetch_add" {
                exact = previous.int_value().wrapping_add(amount)
            }
            if fits_scalar(exact, scalar) {
                stored = Some(Val.Int(exact))
                result = Val.some(option, value: take previous, alloc)
            } else {
                result = Val.none(option, alloc)
            }
        }
        "fetch_and" or "fetch_or" or "fetch_xor" => {
            let a = previous.int_value()
            let b = args[1].int_value()
            var bits = a.bit_xor(b)
            if member == "fetch_and" {
                bits = a.bit_and(b)
            } else if member == "fetch_or" {
                bits = a.bit_or(b)
            }
            stored = Some(Val.Int(bits))
            result = previous
        }
        else => return None
    }
    match stored {
        Some(value) => mut self.memory.set(cell, stored: take value)
        None => {}
    }
    return Some(InterpFlow.Return(take result))
} Interpreter.atomic_member
