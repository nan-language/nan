    \\    var caps = Caps.empty(granted.alloc)
    \\    for index in channels_from..<record.port_count {
    \\        let port = port_at(record, index)
    \\        var key = mem::Bytes.zeroed(usize.widen(port.key_len), alloc: granted.alloc)
    \\        trusted "the kernel writes each channel's key of `key_len` bytes at `key`" {
    \\            hw::Ptr[u8].of_addr(usize.widen(port.key)).copy(hw::Ptr.of_view_mut(mut key.view_mut()), count: usize.widen(port.key_len))
    \\        }
    \\        let channel = try sys::Stdio.served(ports.mint(index))
    \\        let named = match attempt text::String.try_from_utf8(key.view(), alloc: granted.alloc) {
    \\            Ok(text) => text
    \\            Err(_) => text::String.empty(granted.alloc)
    \\        }
    \\        Cap[sys::Stdio].put(mut caps, key: named.as_str(), capability: channel)
    \\    }
    \\    return World(alloc: granted.alloc, exec: granted.exec, clock: granted.clock, random: source, log: logs, stdio: streams, fs: sys::Fs.denied(), net: sys::Net.denied(), caps: take caps)
    \\} remote_world
    \\
    \\/// The record of a channel of the space's link, by its index.
    \\fn port_at(record: Start, index: u64) -> PortRecord {
    \\    return trusted "the kernel writes the records of the link's channels at `ports`" { hw::Ptr[PortRecord].of_addr(usize.widen(record.ports + index * u64.widen(PORT_BYTES))).read() }
    \\} port_at
    \\
    \\/// Ends the space with how its job ended.
    \\fn end_with(how: Ended) {
    \\    match how {
    \\        Ended.Returned(bytes) => end(ENDS_RETURNED, detail: 0, bytes: bytes.view())
    \\        Ended.Failed(text) => end(ENDS_FAILED, detail: 0, bytes: text.as_str().as_bytes())
    \\        Ended.Cancelled => end(ENDS_CANCELLED, detail: 0, bytes: b"")
    \\        Ended.Abandoned => end(ENDS_TRAPPED, detail: ABANDONED, bytes: b"")
    \\        Ended.Trapped(trap) => end(ENDS_TRAPPED, detail: trap_number(trap), bytes: b"")
    \\        Ended.Undecodable => end(ENDS_UNDECODABLE, detail: 0, bytes: b"")
    \\    }
    \\} end_with
    \\
    \\/// What the capabilities a space's runtime holds by the kernel's handles share: the runtime's
    \\/// allocator, the handle of the capability minted for each handle of the space's table, and that
    \\/// handle by the capability's type tag and word.
    \\struct Spaced {
    \\    alloc: mem::Alloc
    \\    minted: mem::OnceMap[u64, sys::Handle]
    \\    handles: mem::OnceMap[Minted, u64]
    \\} Spaced
    \\
    \\/// A capability a space's runtime minted: the tag of its type and its word.
    \\struct Minted derives Copy, Eq, Hash {
    \\    tag: u64
    \\    word: u64
    \\} Minted
    \\
    \\/// The capability the runtime holds for the handle `handle` of the space's table, served through
    \\/// `serve` on a remote capability deriving from `base` the first time.
    \\fn Cap.held(base: Remote, handle: u64, serve: fn(remote: Remote) -> C fails sys::Revoked) -> C fails sys::Revoked {
    \\    match sys::reach(base, body: fn(state: Spaced, record: u64) => state.minted.get(handle)) {
    \\        Some(Some(minted)) => {
    \\            let Some(capability) = sys::CapabilityId[C](id: 0).of_handle(minted) else {
    \\                fail sys::Revoked.Stale
    \\            }
    \\            return capability
    \\        }
    \\        Some(None) => {}
    \\        None => fail sys::Revoked.Stale
    \\    }
    \\    let capability = try serve(try sys::derive(base, narrow: fn(state: Spaced, record: u64) => handle))
    \\    let kept = sys::reach(base, body: fn(state: Spaced, record: u64) -> sys::Handle {
    \\        discard state.handles.insert(Minted(tag: Cap[C].tag(), word: Cap[C].handle(capability)), value: handle)
    \\        return state.minted.insert(handle, value: sys::Handle.of(capability))
    \\    })
    \\    let Some(stored) = kept else {
    \\        fail sys::Revoked.Stale
    \\    }
    \\    let Some(held) = sys::CapabilityId[C](id: 0).of_handle(stored) else {
    \\        fail sys::Revoked.Stale
    \\    }
    \\    return held
    \\} Cap.held
    \\
    \\/// The handle of the space's table for which the runtime minted the capability of type C that
    \\/// `minted` holds, none for another.
    \\fn Cap.handle_in(base: Remote, minted: sys::Handle) -> Option[u64] {
    \\    let Some(capability) = sys::CapabilityId[C](id: 0).of_handle(minted) else {
    \\        return None
    \\    }
    \\    let key = Minted(tag: Cap[C].tag(), word: Cap[C].handle(capability))
    \\    return sys::reach(base, body: fn(state: Spaced, record: u64) => state.handles.get(key)).value_or(None)
    \\} Cap.handle_in
    \\
    \\fn served_log(remote: Remote) -> sys::Log fails sys::Revoked {
    \\    return try sys::Log.served(remote)
    \\} served_log
    \\
    \\fn served_stdio(remote: Remote) -> sys::Stdio fails sys::Revoked {
    \\    return try sys::Stdio.served(remote)
    \\} served_stdio
    \\
    \\fn served_random(remote: Remote) -> sys::Random fails sys::Revoked {
    \\    return try sys::Random.served(remote)
    \\} served_random
    \\
    \\/// The handle of the capability the runtime holds for what the kernel carried into the space's
    \\/// table, none once `base` is stale.
    \\fn minted_for(base: Remote, crossed: Carried) -> Option[sys::Handle] {
    \\    match crossed {
    \\        Carried.Log(handle) => {
    \\            let Ok(log) = attempt Cap[sys::Log].held(base, handle, serve: served_log) else {
    \\                return None
    \\            }
    \\            return Some(sys::Handle.of(log))
    \\        }
    \\        Carried.Stdio(handle) => {
    \\            let Ok(stdio) = attempt Cap[sys::Stdio].held(base, handle, serve: served_stdio) else {
    \\                return None
    \\            }
    \\            return Some(sys::Handle.of(stdio))
    \\        }
    \\        Carried.Random(handle) => {
    \\            let Ok(random) = attempt Cap[sys::Random].held(base, handle, serve: served_random) else {
    \\                return None
    \\            }
    \\            return Some(sys::Handle.of(random))
    \\        }
    \\    }
    \\} minted_for
    \\
    \\/// The handles of the space's table for which the runtime minted the capabilities `minted` holds,
    \\/// none when it minted none of one.
    \\fn handles_named(base: Remote, minted: Slice[sys::Handle], alloc: mem::Alloc) -> Option[mem::List[u64]] {
    \\    var indices = mem::List[u64].empty(alloc)
    \\    for handle in minted {
    \\        let Some(index) = handle_named(base, minted: handle) else {
    \\            return None
    \\        }
    \\        mut indices.push(index)
    \\    }
    \\    return Some(take indices)
    \\} handles_named
    \\
    \\/// The handle of the space's table for which the runtime minted the capability `minted` holds,
    \\/// none when it minted none.
    \\fn handle_named(base: Remote, minted: sys::Handle) -> Option[u64] {
    \\    match Cap[sys::Log].handle_in(base, minted) {
    \\        Some(index) => return Some(index)
    \\        None => {}
    \\    }
    \\    match Cap[sys::Stdio].handle_in(base, minted) {
    \\        Some(index) => return Some(index)
    \\        None => {}
    \\    }
    \\    return Cap[sys::Random].handle_in(base, minted)
    \\} handle_named
    \\
    \\/// The allocator and handle a remote capability's record names, none for a stale one.
    \\fn reached(remote: Remote) -> Option[Reach] {
    \\    return sys::reach(remote, body: fn(state: Spaced, handle: u64) => Reach(alloc: state.alloc, handle: handle))
    \\} reached
    \\
    \\/// What reaching a remote capability gives.
    \\struct Reach derives Copy {
    \\    alloc: mem::Alloc
    \\    handle: u64
    \\} Reach
    \\
    \\fn Remote.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
    \\    let Some(reach) = reached(self) else {
    \\        return
    \\    }
    \\    let rank: u8 = match level {
    \\        sys::LogLevel.Info => 0
    \\        sys::LogLevel.Warn => 1
    \\        sys::LogLevel.Error => 2
    \\    }
    \\    let line = LogLine(level: rank, message: text::String.of(message, alloc: reach.alloc), value: text::String.of(value, alloc: reach.alloc))
    \\    var nothing = mem::Bytes.empty(reach.alloc)
    \\    discard invoke(reach.handle, operation: LOG_LINE, args: encoded(line, alloc: reach.alloc).view(), result: mut nothing.view_mut())
    \\} Remote.log
    \\
    \\fn Remote.read_in(self, mut buf: SliceMut[u8]) -> usize fails sys::StdioError limits stack 4_096 {
    \\    let Some(reach) = reached(self) else {
    \\        fail sys::StdioError.Closed
    \\    }
    \\    let read = invoke(reach.handle, operation: READ_IN, args: b"", result: mut buf)
    \\    if read >= FAILURES {
    \\        fail sys::StdioError.Closed
    \\    }
    \\    return usize.widen(read)
    \\} Remote.read_in
    \\
    \\fn Remote.write_out(self, data: Slice[u8]) fails sys::StdioError limits stack 4_096 {
    \\    try wrote(self, operation: WRITE_OUT, data)
    \\} Remote.write_out
    \\
    \\fn Remote.write_err(self, data: Slice[u8]) fails sys::StdioError limits stack 4_096 {
    \\    try wrote(self, operation: WRITE_ERR, data)
    \\} Remote.write_err
    \\
    \\/// Writes bytes to a remote standard stream.
    \\fn wrote(remote: Remote, operation: u64, data: Slice[u8]) fails sys::StdioError {
    \\    let Some(reach) = reached(remote) else {
    \\        fail sys::StdioError.Closed
    \\    }
    \\    var bytes = mem::Bytes.empty(reach.alloc)
    \\    mut bytes.append(data)
    \\    var nothing = mem::Bytes.empty(reach.alloc)
    \\    if invoke(reach.handle, operation, args: encoded(bytes, alloc: reach.alloc).view(), result: mut nothing.view_mut()) >= FAILURES {
    \\        fail sys::StdioError.Closed
    \\    }
    \\} wrote
    \\
    \\fn Remote.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
    \\    let Some(reach) = reached(self) else {
    \\        return
    \\    }
    \\    discard invoke(reach.handle, operation: FILL, args: b"", result: mut buf)
    \\} Remote.fill
    \\
    \\/// The allocator, executor and clock of the runtime, minted for its first task.
    \\fn space_base() -> Base
    \\
    \\/// Makes an `CALL_INVOKE` call, giving its result.
    \\fn invoke(handle: u64, operation: u64, args: Slice[u8], mut result: SliceMut[u8]) -> u64
    \\
    \\/// Makes an `CALL_END` call, after which the space runs no more.
    \\fn end(how: u64, detail: u64, bytes: Slice[u8])
    \\
    \\/// The number of a trap's kind.
    \\fn trap_number(trap: sys::Trap) -> u64 limits pure, notrap, terminates
    \\

const TEXT_NANOS_LINK: Str =
    \\//! Links between a kernel and the isolated spaces it runs: the doorbell the kernel rings and the channels whose frames both sides share, the kernel's side of each and the runtime's, which serves a channel to its job as a standard stream.
    \\
    \\/// The offsets in a channel frame of the count of bytes its writer has written, of the count its
    \\/// reader has read, and of its data, a ring of `RING_BYTES` bytes.
    \\const RING_WRITTEN: u64 = 0
    \\
    \\const RING_READ: u64 = 8
    \\
    \\const RING_DATA: u64 = 64
    \\
    \\const RING_BYTES: u64 = 4_096 - RING_DATA
    \\
    \\/// The offset in the doorbell frame of the word the kernel sets bits of.
    \\const BELL_WORD: u64 = 0
    \\
    \\/// The operation of a channel's handle: telling the kernel the space wrote to or read from it.
    \\const NOTIFY: u64 = 0
    \\
    \\/// How long a space's reader or writer of a channel waits on the doorbell before looking at the
    \\/// channel again.
    \\const RECHECK_NS: u64 = 1_000_000_000
    \\
    \\pub open linear struct Link {
    \\    bell: hw::UserFrame
    \\    channels: mem::List[Channel]
    \\    rung: hw::Signal[u64]
    \\    alloc: mem::Alloc
    \\} Link
    \\
    \\/// A channel of a link: its key, the frame the kernel writes and the space reads, the frame the
    \\/// space writes and the kernel reads, the bytes the kernel has written to the first and read
    \\/// from the second, and the signals waking the kernel's receiver and its sender once the space
    \\/// tells it moved bytes.
    \\linear struct Channel {
    \\    key: text::String
    \\    inbound: hw::UserFrame
    \\    outbound: hw::UserFrame
    \\    sent: core::atomic::AtomicU64
    \\    taken: core::atomic::AtomicU64
    \\    heard: hw::Signal[u64]
    \\    room: hw::Signal[u64]
    \\} Channel
    \\
    \\pub closed enum LinkError derives Render {
    \\    NoChannel
    \\    Cancelled(task::Cancelled) from
    \\} LinkError
    \\
    \\pub fn Link.of(take bell: hw::PhysFrame[4_096], alloc: mem::Alloc) -> Link {
    \\    return Link(bell: cleared(take bell), channels: mem::List[Channel].empty(alloc), rung: hw::Signal[u64].empty(), alloc: alloc)
    \\} Link.of
    \\
    \\pub fn Link.open(mut self, key: Str, take inbound: hw::PhysFrame[4_096], take outbound: hw::PhysFrame[4_096]) -> usize {
    \\    mut self.channels.push(Channel(key: text::String.of(key, alloc: self.alloc), inbound: cleared(take inbound), outbound: cleared(take outbound), sent: core::atomic::AtomicU64.of(0), taken: core::atomic::AtomicU64.of(0), heard: hw::Signal[u64].empty(), room: hw::Signal[u64].empty()))
    \\    return self.channels.len() - 1
    \\} Link.open
    \\
    \\pub fn Link.ring(self, bits: u64) {
    \\    discard self.bell.fetch_or(hw::Offset[u64](bytes: BELL_WORD), bits)
    \\    hw::without_irqs(fn(t: hw::IrqsDisabled) {
    \\        self.rung.post(t, value: bits)
    \\    })
    \\} Link.ring
    \\
    \\pub fn Link.send(self, channel: usize, data: Slice[u8]) -> usize fails LinkError {
    \\    let Some(held) = self.channels.get(channel) else {
    \\        fail LinkError.NoChannel
    \\    }
    \\    let sent = held.sent.load()
    \\    let read = word_of(held.inbound.load(hw::Offset[u64](bytes: RING_READ)))
    \\    if read > sent or sent - read > RING_BYTES {
    \\        return 0
    \\    }
    \\    var count = RING_BYTES - (sent - read)
    \\    if u64.widen(data.len()) < count {
    \\        count = u64.widen(data.len())
    \\    }
    \\    let ring = held.inbound.base() + RING_DATA
    \\    each_piece(at: sent, count, body: fn(offset: u64, from: u64, len: u64) {
    \\        trusted "the inbound frame is the link's, and `data` holds `count` bytes" {
    \\            hw::Ptr.of_view(data).offset(isize.fit(from)).copy(hw::Ptr[u8].of_addr(usize.widen(ring + offset)), count: usize.widen(len))
    \\        }
    \\    })
    \\    held.inbound.store(hw::Offset[u64](bytes: RING_WRITTEN), value: sent + count)
    \\    held.sent.store(sent + count)
    \\    self.ring(channel_bit(channel))
    \\    return usize.widen(count)
    \\} Link.send
    \\
    \\pub fn Link.receive(self, channel: usize, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails LinkError uses wait {
    \\    let Some(held) = self.channels.get(channel) else {
    \\        fail LinkError.NoChannel
    \\    }
    \\    loop {
    \\        let taken = held.taken.load()
    \\        let written = word_of(held.outbound.load(hw::Offset[u64](bytes: RING_WRITTEN)))
    \\        if written > taken and written - taken <= RING_BYTES {
    \\            let count = written - taken
    \\            var bytes = mem::Bytes.zeroed(usize.widen(count), alloc)
    \\            let into = hw::Ptr.of_view_mut(mut bytes.view_mut())
    \\            let ring = held.outbound.base() + RING_DATA
    \\            each_piece(at: taken, count, body: fn(offset: u64, from: u64, len: u64) {
    \\                trusted "the outbound frame is the link's, and `into` holds `count` bytes" {
    \\                    hw::Ptr[u8].of_addr(usize.widen(ring + offset)).copy(into.offset(isize.fit(from)), count: usize.widen(len))
    \\                }
    \\            })
    \\            held.outbound.store(hw::Offset[u64](bytes: RING_READ), value: written)
    \\            held.taken.store(written)
    \\            self.ring(channel_bit(channel))
    \\            return Untrusted.of(take bytes)
    \\        }
    \\        discard try await held.heard.wait()
    \\    }
    \\} Link.receive
    \\
    \\pub fn Link.release(take self, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    \\    let Link(bell: bell, channels: channels, rung: _, alloc: _) = self
    \\    mut frames.push(freed(take bell))
    \\    for channel in take channels {
    \\        let Channel(key: _, inbound: inbound, outbound: outbound, sent: _, taken: _, heard: _, room: _) = channel
    \\        mut frames.push(freed(take inbound))
    \\        mut frames.push(freed(take outbound))
    \\    }
    \\} Link.release
    \\
    \\/// Sends the whole of `data` over a channel, waiting while its inbound ring has no room.
    \\fn Link.sent(self, channel: usize, data: Slice[u8]) fails LinkError uses wait {
    \\    let Some(held) = self.channels.get(channel) else {
    \\        fail LinkError.NoChannel
    \\    }
