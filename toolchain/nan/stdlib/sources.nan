    \\pub fn List.position(self, matches: fn(value: T) -> bool) -> Option[usize]
    \\    ensures match result {
    \\        Some(index) => index < self.len()
    \\        None => true
    \\    }
    \\    example List[u8].empty(testing::world().alloc).position(fn(value: u8) => value == 1) == None
    \\{
    \\    for i in 0..<self.len() {
    \\        if matches(self[i]) {
    \\            return Some(i)
    \\        }
    \\    }
    \\    return None
    \\} List.position
