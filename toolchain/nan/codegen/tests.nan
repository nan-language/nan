//! Tests of the code generator: the machine code, frames, relocations and source locations of functions as lowering builds them.

fn int_signature(count: u32, alloc: mem::Alloc) -> clif::Signature {
    var signature = clif::Signature.new(clif::CallConv.SystemV, alloc)
    for _ in 0u32..<count {
        mut signature.params.push(clif::AbiParam(value_type: clif::Type.Int64))
    }
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Int64))
    return signature
} int_signature

/// A builder of a function named `u0:0` of 64-bit integers, its entry block current.
fn builder_of(params: u32, alloc: mem::Alloc) -> clif::Builder {
    return named_builder(0, params, alloc)
} builder_of

/// A builder of a function named `u0:<index>` of 64-bit integers, its entry block current.
fn named_builder(index: u32, params: u32, alloc: mem::Alloc) -> clif::Builder {
    var b = clif::Builder.new(clif::Function.new(clif::ExternalName(namespace: 0, index: index), signature: int_signature(params, alloc), alloc), alloc)
    let entry = mut b.create_block()
    mut b.append_block_params_for_function_params(entry)
    mut b.switch_to_block(entry)
    mut b.seal_block(entry)
    return b
} named_builder

fn params_of(b: clif::Builder, alloc: mem::Alloc) -> mem::List[clif::Value] {
    let Some(entry) = b.current_block() else {
        return mem::List[clif::Value].empty(alloc)
    }
    return b.block_params(entry, alloc)
} params_of

fn one(value: clif::Value, alloc: mem::Alloc) -> mem::List[clif::Value] {
    var list = mem::List[clif::Value].empty(alloc)
    mut list.push(value)
    return list
} one

/// The one result of a call.
fn call_result(b: clif::Builder, call: clif::Inst, alloc: mem::Alloc) -> clif::Value {
    let results = b.inst_results(call, alloc)
    expect results.len() == 1
    return results[0]
} call_result

fn no_values(alloc: mem::Alloc) -> mem::List[clif::Value] = mem::List[clif::Value].empty(alloc)

fn host_isa() -> Isa = Isa(arch: workspace::Arch.Amd64, pic: true, probes: true, level: None)

fn arm_isa() -> Isa = Isa(arch: workspace::Arch.Aarch64, pic: true, probes: true, level: None)

fn arm_machine_isa() -> Isa = Isa(arch: workspace::Arch.Aarch64, pic: false, probes: false, level: None)

test compiles_an_addition_without_moves_for_aarch64 for compile {
    let alloc = testing::world().alloc
    var b = builder_of(2, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 2
    let sum = mut b.iadd(params[0], y: params[1])
    mut b.ret(one(sum, alloc).view())
    let code = compile(take b.finalize(), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\x00\x00\x01\x8b\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
    expect code.frame == 16
    expect code.relocs.len() == 0
    expect code.locations.len() == 0
} compiles_an_addition_without_moves_for_aarch64

test branches_on_the_comparison_deciding_a_tested_flag_for_aarch64 for compile {
    let alloc = testing::world().alloc
    let code = compile(tested_flag(alloc), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\xe2\x03\x00\xaa\x5f\x00\x01\xeb\x82\x00\x00\x54\xe0\x03\x01\xaa\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6\xe0\x03\x02\xaa\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
} branches_on_the_comparison_deciding_a_tested_flag_for_aarch64

