//! An isolated space's runtime: its one executor thread, which runs in user mode over a boot area its kernel maps as it is used, the system calls through which it reads its kernel's clock, names the account of each task it switches to, waits for its first timer, its doorbell or its kernel's orders and ends its jobs, its start, which runs `nanos::isolated` as its first task, and its fault routine, in which its kernel resumes its thread at an exception. A test image running alone in a space runs on such a runtime too, writing its standard streams and ending with its exit status through its kernel.

/// The numbers of the system calls the runtime makes: waiting until a deadline of the kernel's
/// clock, drawing and releasing pages of the boot area, reading the clock, invoking a capability
/// its kernel serves, telling how a job ended, naming the fault routine, and reading the clock
/// as it names the account of the task it switches to.
const SPACE_WAIT: u64 = 1

const SPACE_DRAW: u64 = 2

const SPACE_RELEASE: u64 = 3

const SPACE_NOW: u64 = 5

pkg const SPACE_INVOKE: u64 = 6

pkg const SPACE_END: u64 = 11

const SPACE_FAULT: u64 = 12

const SPACE_SWITCH: u64 = 13

/// How an `END` call tells a trap.
const SPACE_TRAPPED: u64 = 2

/// The symbols of the start routine, which the kernel enters with the addresses of the start record
/// and of the boot area, of the glue of the first task, and of the fault routine.
pkg const SPACE_START: Str = "_NSuser_start"

const SPACE_MAIN: Str = "_NSuser_main"

const SPACE_FAULT_ROUTINE: Str = "_NSuser_fault"

/// The most stack below a faulting thread's stack pointer that its kernel leaves above the fault
/// routine's frame.
const SPACE_FAULT_GAP: u64 = 32

/// The data holding the operation of the task waiting on the doorbell, zero when none waits.
pkg const SPACE_BELL: Str = "_NSspace_bell"

/// The data holding the operation of the task waiting for its kernel's orders, zero when none
/// waits.
pkg const SPACE_ORDERS: Str = "_NSspace_orders"

/// What a `WAIT` call gives: that the doorbell rang, and that the kernel has orders.
const SPACE_RUNG: i64 = 1

const SPACE_ORDERED: i64 = 2

/// A call's results from `SPACE_FAILURES` up are failures, as a `NOW` call's once the kernel's
/// clock is stale.
const SPACE_FAILURES: i64 = -4_096

/// The data holding the runtime's clock: the latest reading of the kernel's clock, nonzero once a
/// reading has failed, and the handle of the clock the first task's grants hold plus one, zero
/// before it is minted and once it is revoked.
const SPACE_CLOCK: Str = "_NSspace_clock"

const SPACE_CLOCK_SIZE: u64 = 24

const SPACE_CLOCK_READING: u64 = 0

const SPACE_CLOCK_FAILED: u64 = 8

const SPACE_CLOCK_ROOT: u64 = 16

/// The stack the start routine and the scheduler run on, and the boot area: the boot heap, then
/// the runtime tables, to a whole page.
pkg const SPACE_STACK: u64 = MACHINE_BOOT_STACK

pkg const SPACE_BOOT: u64 = next_multiple_of(SPACE_HEAP + RUNTIME_SYSTEM_TABLE_BYTES, multiple: PAGE_TABLE)

/// Makes a system call with up to six arguments, giving its result.
fn space_call(mut lo: Lowering, mut fx: Fx, number: u64, args: Slice[clif::Value]) -> clif::Value {
    var words = mem::List[clif::Value].empty(fx.alloc)
    for arg in args {
        mut words.push(arg)
    }
    while words.len() < 6 {
        let zero = mut fx.ptr(0)
        mut words.push(zero)
    }
    let call_number = mut fx.ptr(number)
    mut words.push(call_number)
    let results = mut lo.call_stub(mut fx, stub: Stub.Syscall, args: words.view())
    return results[0]
} space_call

/// The record of the runtime's one executor thread.
fn space_thread(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    let threads = mut fx.load(PTR, addr: state_address, offset: STATE_THREADS)
    return mut fx.load(PTR, addr: threads, offset: 0)
} space_thread

/// The executor of `Init`: one thread, whose record it draws.
fn space_init(mut lo: Lowering, mut fx: Fx) {
    let state_address = mut lo.state(mut fx)
    let one = mut fx.ptr(1)
    mut fx.store(one, addr: state_address, offset: STATE_THREAD_COUNT)
    let word = mut fx.ptr(8)
    let threads = mut lo.record_alloc(mut fx, size: word)
    unavailable_unless(mut fx, address: threads)
    mut fx.store(threads, addr: state_address, offset: STATE_THREADS)
    let size = mut fx.ptr(THREAD_SIZE)
    let record = mut lo.record_alloc(mut fx, size)
    unavailable_unless(mut fx, address: record)
    mut fx.store(record, addr: threads, offset: 0)
} space_init

/// `ClockNow` reads the kernel's clock, giving the latest reading once a reading fails; `Extended`
/// and `ExtendedOwn` give zero, the space's tasks sharing the extended state its kernel saves for
/// its thread.
fn space_define(mut lo: Lowering, mut fx: Fx, routine: Routine) {
    discard mut fx.entry()
    let result = if routine == Routine.ClockNow {
        space_clock_now(mut lo, mut fx)
    } else {
        mut fx.ptr(0)
    }
    mut fx.b.ret(fx.list1(result).view())
} space_define

/// A reading of the kernel's clock through a `NOW` call, the latest one once a reading fails.
fn space_clock_now(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let reading = space_call(mut lo, mut fx, number: SPACE_NOW, args: mem::List[clif::Value].empty(fx.alloc).view())
    return space_latest(mut lo, mut fx, reading)
} space_clock_now

/// A reading of the kernel's clock as the runtime switches to the task at `record`, through a
/// `SWITCH` call naming its account: the handle of the executor deriving directly from a root
/// executor that the task's executor is or derives from, zero for a task of a root executor or of
/// a stale one. Gives the latest reading once a reading fails.
fn space_switched(mut lo: Lowering, mut fx: Fx, record: clif::Value) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let handle = mut fx.load(PTR, addr: record, offset: TASK_EXECUTOR)
    let entry = live_entry(mut lo, mut fx, handle)
    let none = mut fx.ptr(0)
    let found = mut fx.repeat(fx.list3(handle, b: entry, c: none).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 1
        let current = state[0]
        let record1 = state[1]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: record1, y: 0)
        let next = mut fx1.choose_in(mut lo, condition: present, results: fx1.types4(clif::Type.Int8, b: PTR, c: PTR, d: PTR).view(), then: fn(mut lo1: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let source_word = mut fx2.load(clif::Type.Int32, addr: record1, offset: TABLES_ENTRY_SOURCE)
            let source = mut fx2.b.uextend(PTR, x: source_word)
            let derived = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: source, y: 0)
            return mut fx2.choose_in(mut lo1, condition: derived, results: fx2.types4(clif::Type.Int8, b: PTR, c: PTR, d: PTR).view(), then: fn(mut lo2: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let index = mut fx3.b.iadd_imm_s(source, y: -1)
                let parent = entry_at(mut lo2, fx: mut fx3, handle: index)
                let above = mut fx3.load(clif::Type.Int32, addr: parent, offset: TABLES_ENTRY_SOURCE)
                let deeper = mut fx3.b.icmp_imm_s(clif::IntCC.NotEqual, x: above, y: 0)
                let generation_word = mut fx3.load(clif::Type.Int32, addr: parent, offset: TABLES_ENTRY_GENERATION)
                let generation = mut fx3.b.uextend(PTR, x: generation_word)
                let shifted = mut fx3.b.ishl_imm_s(generation, y: 32)
                let parent_handle = mut fx3.b.bor(shifted, y: index)
                let next_handle = mut fx3.b.select(deeper, x: parent_handle, y: current)
                let next_record = mut fx3.b.select(deeper, x: parent, y: record1)
                let zero = mut fx3.ptr(0)
                let found_handle = mut fx3.b.select(deeper, x: zero, y: current)
                return fx3.list4(deeper, b: next_handle, c: next_record, d: found_handle)
            }, otherwise: fn(mut lo2: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let stop = mut fx3.int(clif::Type.Int8, value: 0)
                let unfound = mut fx3.ptr(0)
                return fx3.list4(stop, b: current, c: record1, d: unfound)
            })
        }, otherwise: fn(mut lo1: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let stop = mut fx2.int(clif::Type.Int8, value: 0)
            let unfound = mut fx2.ptr(0)
            return fx2.list4(stop, b: current, c: record1, d: unfound)
        })
        expect next.len() > 3
        return Pass(again: next[0], next: fx1.list3(next[1], b: next[2], c: next[3]))
    })
    expect found.len() > 2
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    let reading = space_call(mut lo, mut fx, number: SPACE_SWITCH, args: fx.list1(found[2]).view())
    return space_latest(mut lo, mut fx, reading)
} space_switched

/// `reading`, a call's reading of the kernel's clock, kept as the latest; the latest reading once
/// a reading fails, as every reading of a stale clock does.
fn space_latest(mut lo: Lowering, mut fx: Fx, reading: clif::Value) -> clif::Value {
    let held = mut lo.reserved(mut fx, data_name: SPACE_CLOCK, size: SPACE_CLOCK_SIZE, align: 8)
    let failed = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: reading, y: SPACE_FAILURES)
    let chosen = mut fx.choose(failed, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let one = mut fx1.ptr(1)
        mut fx1.store(one, addr: held, offset: SPACE_CLOCK_FAILED)
        let latest = mut fx1.load(PTR, addr: held, offset: SPACE_CLOCK_READING)
        return fx1.list1(latest)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(reading, addr: held, offset: SPACE_CLOCK_READING)
        return fx1.list1(reading)
    })
    return chosen[0]
} space_latest

/// Once a reading of the kernel's clock has failed, revokes the clock of the first task's grants,
/// and with it every clock deriving from it, and expires every timer armed: its time stands still
/// from then on.
fn space_settle(mut lo: Lowering, mut fx: Fx) {
    let held = mut lo.reserved(mut fx, data_name: SPACE_CLOCK, size: SPACE_CLOCK_SIZE, align: 8)
    let failed_word = mut fx.load(PTR, addr: held, offset: SPACE_CLOCK_FAILED)
    let failed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: failed_word, y: 0)
    let root = mut fx.load(PTR, addr: held, offset: SPACE_CLOCK_ROOT)
    let minted = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: root, y: 0)
    let settling = mut fx.b.band(failed, y: minted)
    mut fx.if_true(settling, then: fn[mut lo](mut fx1: Fx) {
        let zero = mut fx1.ptr(0)
        mut fx1.store(zero, addr: held, offset: SPACE_CLOCK_ROOT)
        let handle = mut fx1.b.iadd_imm_s(root, y: -1)
        discard mut lo.call_routine(mut fx1, routine: Routine.Revoke, args: fx1.list1(handle).view())
        let end = mut fx1.int(PTR, value: -1)
        mut lo.expire_timers_by(mut fx1, now: end)
    })
} space_settle

/// Waits until the first timer is due, or for good without one, or until the kernel rings the
/// doorbell, which wakes the task waiting on it, or has orders, which wakes the task waiting for
/// them; then expires the timers due.
fn space_idle(mut lo: Lowering, mut fx: Fx) {
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TIMER_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let head = mut fx.load(PTR, addr: state_address, offset: STATE_TIMERS)
    let armed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
    let deadline = mut fx.choose(armed, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let due = mut fx1.load(PTR, addr: head, offset: OPERATION_DUE)
        let one = mut fx1.ptr(1)
        let raised = mut fx1.b.umax(due, y: one)
        return fx1.list1(raised)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let none = mut fx1.ptr(0)
        return fx1.list1(none)
    })
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    let woke = space_call(mut lo, mut fx, number: SPACE_WAIT, args: fx.list1(deadline[0]).view())
    let ordered_bit = mut fx.b.band_imm_s(woke, y: SPACE_ORDERED)
    let ordered = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: ordered_bit, y: 0)
    mut fx.if_true(ordered, then: fn[mut lo](mut fx1: Fx) {
        let slot = mut lo.reserved(mut fx1, data_name: SPACE_ORDERS, size: 8, align: 8)
        let op = mut fx1.load(PTR, addr: slot, offset: 0)
        let waiting = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: op, y: 0)
        mut fx1.if_true(waiting, then: fn[mut lo](mut fx2: Fx) {
            let zero = mut fx2.ptr(0)
            mut fx2.store(zero, addr: slot, offset: 0)
            let done = mut fx2.int(clif::Type.Int32, value: 0)
            deliver(mut lo, fx: mut fx2, op, result: done)
        })
    })
    let rung_bit = mut fx.b.band_imm_s(woke, y: SPACE_RUNG)
    let woken = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: rung_bit, y: 0)
    mut fx.if_true(woken, then: fn[mut lo](mut fx1: Fx) {
        let slot = mut lo.reserved(mut fx1, data_name: SPACE_BELL, size: 8, align: 8)
        let op = mut fx1.load(PTR, addr: slot, offset: 0)
        let waiting = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: op, y: 0)
        mut fx1.if_true(waiting, then: fn[mut lo](mut fx2: Fx) {
            let zero = mut fx2.ptr(0)
            mut fx2.store(zero, addr: slot, offset: 0)
            let claimed = claim_armed(mut lo, fx: mut fx2, op)
            mut fx2.if_true(claimed, then: fn[mut lo](mut fx3: Fx) {
                let expired = mut fx3.int(clif::Type.Int32, value: TASKS_EXPIRED)
                deliver(mut lo, fx: mut fx3, op, result: expired)
            })
        })
    })
    mut lo.expire_timers(mut fx)
} space_idle

/// Expires the timers due, when any is armed.
fn space_reap(mut lo: Lowering, mut fx: Fx) {
    let state_address = mut lo.state(mut fx)
    let head = mut fx.load(PTR, addr: state_address, offset: STATE_TIMERS)
    let armed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
    mut fx.if_true(armed, then: fn[mut lo](mut fx1: Fx) {
        mut lo.expire_timers(mut fx1)
    })
} space_reap

/// `Exit`: ends a test image's space with its status, and another space as a trap abandoning it.
fn space_exit(mut lo: Lowering, mut fx: Fx, status: clif::Value) {
    if not lo.seeded() {
        space_abandon(mut lo, mut fx)
        return
    }
    discard space_call(mut lo, mut fx, number: SPACE_END, args: fx.list1(status).view())
    mut fx.b.trap(clif::TrapCode(user: 1))
} space_exit

/// Writes a byte range to a test image's standard stream `fd`, 1 or 2, through its kernel.
fn space_write_stream(mut lo: Lowering, mut fx: Fx, fd: i64, text: clif::Value, len: clif::Value) {
    let handle = mut fx.ptr(0)
    let operation = mut fx.ptr(u64.fit(fd))
    let none = mut fx.ptr(0)
    var args = fx.list4(handle, b: operation, c: text, d: len)
    mut args.push(none)
    mut args.push(none)
    discard space_call(mut lo, mut fx, number: SPACE_INVOKE, args: args.view())
} space_write_stream

/// Ends the space as a trap abandoning it.
fn space_abandon(mut lo: Lowering, mut fx: Fx) {
    let kind = mut fx.ptr(u64.fit(kind_number("trap.abandoned")))
    let none = mut fx.ptr(0)
    space_end_trapped(mut lo, mut fx, kind, report: none, len: none)
} space_abandon

/// Ends the space as a trap of a kind, with the report of `len` bytes at `report`.
fn space_end_trapped(mut lo: Lowering, mut fx: Fx, kind: clif::Value, report: clif::Value, len: clif::Value) {
    let how = mut fx.ptr(SPACE_TRAPPED)
    discard space_call(mut lo, mut fx, number: SPACE_END, args: fx.list4(how, b: kind, c: report, d: len).view())
    mut fx.b.trap(clif::TrapCode(user: 1))
} space_end_trapped

/// Names the fault routine to the kernel.
fn space_arm(mut lo: Lowering, mut fx: Fx, fault: object::FuncId) {
    let routine = mut lo.func_ref(mut fx, id: fault)
    let address = mut fx.b.func_addr(PTR, func_ref: routine)
    discard space_call(mut lo, mut fx, number: SPACE_FAULT, args: fx.list1(address).view())
} space_arm

/// Defines the start routine: it sets up the runtime over the boot area, names the fault routine
/// to the kernel, starts `nanos::isolated` on the record as the first task, with the stack its own
/// `limits stack N` demands, and runs the scheduler.
fn Lowering.space_start(mut self) {
    let Some(isolated) = self.ck.db().std_item("nanos", name: "isolated") else {
        expect false
        return
    }
    let Some(sig) = self.ck.fn_sig(isolated) else {
        expect false
        return
    }
    let Some(stack) = sig.limit_set.stack else {
        expect false
        return
    }
    let main = mut self.space_main(isolated, stack)
    let fault = mut self.space_fault()
    var signature = clif::Signature.new(CALL_CONV, alloc: self.alloc)
    for _ in 0usize..<2 {
        mut signature.params.push(clif::AbiParam.new(PTR))
    }
    let id = mut self.module.declare_function(SPACE_START, linkage: object::Linkage.Local, signature)
    mut self.define(id, take signature, flags: LINES_HIDDEN, build: fn(mut lo: Lowering, mut fx: Fx) {
        let params = mut fx.entry()
        let area = params[1]
        let state_address = mut lo.state(mut fx)
        mut fx.store(area, addr: state_address, offset: STATE_BOOT_AREA)
        system_start(mut lo, mut fx)
        space_arm(mut lo, mut fx, fault)
        let process = mut fx.load(PTR, addr: state_address, offset: STATE_PROCESS)
        let root = mut fx.load(PTR, addr: state_address, offset: STATE_ROOT)
        let glue_ref = mut lo.func_ref(mut fx, id: main)
        let glue = mut fx.b.func_addr(PTR, func_ref: glue_ref)
        let zero = mut fx.ptr(0)
        let usable = mut fx.ptr(stack)
        var spawn_args = fx.list4(glue, b: zero, c: zero, d: zero)
        mut spawn_args.push(usable)
        mut spawn_args.push(zero)
        mut spawn_args.push(process)
        mut spawn_args.push(root)
        let created = mut lo.call_routine(mut fx, routine: Routine.Spawn, args: spawn_args.view())
        let record = created[0]
        let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
        mut fx.if_true(missing, then: fn[mut lo](mut fx1: Fx) {
            space_abandon(mut lo, fx: mut fx1)
        })
        mut fx.store(record, addr: state_address, offset: STATE_ENTRY_TASK)
        discard mut lo.call_routine(mut fx, routine: Routine.Wake, args: fx.list1(record).view())
        discard mut lo.call_routine(mut fx, routine: Routine.Schedule, args: mem::List[clif::Value].empty(fx.alloc).view())
        mut fx.b.trap(clif::TrapCode(user: 1))
    })
} Lowering.space_start

/// Defines the fault routine, in which the kernel resumes the thread at an exception below the
/// stack pointer it faulted at, with the exception's vector, error code or syndrome and faulting
/// address and the address of the faulting instruction: it makes its frame return to that
/// instruction, names itself to the kernel again, and traps with `trap.exception` there.
fn Lowering.space_fault(mut self) -> object::FuncId {
    var signature = clif::Signature.new(CALL_CONV, alloc: self.alloc)
    for _ in 0usize..<4 {
        mut signature.params.push(clif::AbiParam.new(PTR))
    }
    let id = mut self.module.declare_function(SPACE_FAULT_ROUTINE, linkage: object::Linkage.Local, signature)
    mut self.define(id, take signature, flags: LINES_HIDDEN, build: fn(mut lo: Lowering, mut fx: Fx) {
        let params = mut fx.entry()
        let frame = mut fx.b.get_frame_pointer(PTR)
        let returned = mut fx.b.iadd_imm_s(params[3], y: 1)
        mut fx.store(returned, addr: frame, offset: 8)
        let operands = mut fx.slot(size: 3 * OPERAND_RECORD, align: 8)
        let page_fault = lo.page_fault(mut fx, vector: params[0])
        let count = mut lo.exception_operands(mut fx, operands, vector: params[0], code: params[1], address: params[2], page_fault)
        space_arm(mut lo, mut fx, fault: id)
        let kind = mut fx.ptr(u64.fit(kind_number("trap.exception")))
        let caller = mut fx.ptr(0)
        discard mut lo.call_routine(mut fx, routine: Routine.TrapRaise, args: fx.list4(kind, b: operands, c: count, d: caller).view())
        mut fx.b.trap(clif::TrapCode(user: 1))
    })
    self.fault_routine = Some(id)
    return id
} Lowering.space_fault

/// The glue of the first task, which calls `nanos::isolated`, its stack demanded at the function's
/// head.
fn Lowering.space_main(mut self, isolated: ty::ItemId, stack: u64) -> object::FuncId {
    let instance = Instance.Nir(item: isolated, role: nir::Role.Body, index: 0, args: ty::Args.none())
    var signature = clif::Signature.new(CALL_CONV, alloc: self.alloc)
    mut signature.params.push(clif::AbiParam.new(PTR))
    let id = mut self.module.declare_function(SPACE_MAIN, linkage: object::Linkage.Local, signature)
    mut self.define(id, take signature, flags: LINES_HIDDEN, build: fn(mut lo: Lowering, mut fx: Fx) {
        discard mut fx.entry()
        let abi = mut lo.abi(instance)
        let callee = mut lo.instance(instance.copy(lo.alloc))
        discard mut lo.invoke(mut fx, invoked: Invoked.Direct(callee), abi, args: mem::List[Held].empty(fx.alloc).view())
        mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
    })
    let head = nir::Span.at(self.ck.db().ast(isolated).token)
    mut self.demands.push(Demand(judged: Judged.Function(id), stack: stack, report: StackReport.Own(head: At(item: isolated, span: head))))
    return id
} Lowering.space_main
