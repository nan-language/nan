//! Probes from its first kernel task the APIC base register, which every x86_64 CPU has, and a register of the x2APIC range that names none, whose read raises a general-protection exception, then ends the run through the exit port.

registers Uart {
    data: u8 at 0x0 write
} Uart

registers Exit {
    code: u8 at 0x0 write
} Exit

/// The model-specific register holding the local APIC's base and mode, and one of the x2APIC
/// range that names no register.
const APIC_BASE: u32 = 0x1B

const NO_REGISTER: u32 = 0x801

fn say(text: Str) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in text.as_bytes() {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say

/// Ends the run with status 0, holding the CPU's privileges until then.
fn finish(take cpu: hw::Ring0) -> Never {
    var exit = trusted "the emulator decodes port 0xF4 to its exit port and nothing else maps it" { hw::Ports[Exit].map(0xF4) }
    mut exit.write(Exit.code, value: 0)
    loop {
    }
} finish

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let Some(cpu) = mut k.ring0() else {
        say(text: "ring0 missing\n")
        loop {
        }
    }
    take k.anchor(0u8, run: fn[take cpu](exec: task::Executor) limits stack 16_384 {
        let base = trusted "the APIC base register only reports the local APIC's base and mode" { cpu.read_msr(APIC_BASE) }
        let probed = trusted "the APIC base register only reports the local APIC's base and mode" { cpu.checked_read_msr(APIC_BASE) }
        if probed == Some(base) {
            say(text: "the APIC base register reads as it does without the probe\n")
        }
        let missing = trusted "reading a register the CPU lacks raises an exception and changes nothing" { cpu.checked_read_msr(NO_REGISTER) }
        if missing.is_none() {
            say(text: "the register naming nothing is missing\n")
        }
        finish(take cpu)
    })
} main
