//! Tests of comparing releases.

/// The exported items of a release holding one item of one interface line.
fn exported_one(path: Str, line: Str, alloc: mem::Alloc) -> mem::Map[text::String, machine::ApiEntry] {
    var entry = machine::ApiEntry.empty(path, alloc)
    mut entry.text.push(text::String.of(line, alloc))
    entry.interface_hash = Some(hashing::HashValue.of(line.as_bytes()))
    var exported_items = mem::Map[text::String, machine::ApiEntry].empty(alloc)
    discard mut exported_items.insert(text::String.of(path, alloc), value: take entry)
    return exported_items
} exported_one

/// The class of a release of `release_items` on the parent exporting `app::percent`, its
/// tombstones forwarding `app::percent` as `forward` gives.
fn renamed_class(release_items: mem::Map[text::String, machine::ApiEntry], take forward: Option[Forward], alloc: mem::Alloc) -> store::Class {
    let parent = exported_one("app::percent", line: "pub fn percent(raw: u32) -> u32", alloc)
    var forwarded = mem::Map[text::String, Forward].empty(alloc)
    let Some(held) = forward else {
        return release_class(classes(parent, release: release_items, epochs: fn(path: Str) => EpochPair(old: 0, new: 0), forwarded, compatible: mem::Set[text::String].empty(alloc), alloc), parented: true)
    }
    discard mut forwarded.insert(text::String.of("app::percent", alloc), value: take held)
    let found = classes(parent, release: release_items, epochs: fn(path: Str) => EpochPair(old: 0, new: 0), forwarded, compatible: mem::Set[text::String].empty(alloc), alloc)
    return release_class(found, parented: true)
} renamed_class

test a_removed_item_is_additive_only_while_a_preserves_tombstone_forwards_it for classes {
    let alloc = testing::world().alloc
    let renamed = exported_one("app::ratio", line: "pub fn ratio(raw: u32) -> u32", alloc)
    let changed = exported_one("app::ratio", line: "pub fn ratio(raw: u64) -> u32", alloc)
    let unforwarded = renamed_class(renamed, forward: None, alloc)
    let forwarded_rename = renamed_class(renamed, forward: Some(Forward.Path(text::String.of("app::ratio", alloc))), alloc)
    let forwarded_change = renamed_class(changed, forward: Some(Forward.Path(text::String.of("app::ratio", alloc))), alloc)
    let forwarded_head = renamed_class(changed, forward: Some(Forward.Head), alloc)
    expect unforwarded == store::Class.Breaking
    expect forwarded_rename == store::Class.Additive
    expect forwarded_change == store::Class.Breaking
    expect forwarded_head == store::Class.Additive
} a_removed_item_is_additive_only_while_a_preserves_tombstone_forwards_it
