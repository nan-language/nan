//! Where a task asked to stop may stop: at a point of its stack outside every frame of a function a stopping task completes before it stops.

/// The registers of a task interrupted on its stack: its instruction, stack and frame pointers,
/// its link register where the architecture has one, the bounds of its own stack's usable part,
/// and in an image keeping segments the newest segment it runs on, zero for none.
struct Interrupted derives Copy {
    ip: clif::Value
    sp: clif::Value
    fp: clif::Value
    link: Option[clif::Value]
    low: clif::Value
    high: clif::Value
    segment: Option[clif::Value]
} Interrupted

/// Whether a code address lies in a function a stopping task does not stop inside; an address
/// outside lowered code counts as one when `unknown` holds.
fn critical_at(mut lo: Lowering, mut fx: Fx, address: clif::Value, unknown: bool) -> clif::Value {
    let holding = function_at(mut lo, mut fx, address)
    let found = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: holding.start, y: 0)
    let critical_bits = mut fx.b.band_imm_s(holding.flags, y: i64.widen(LINES_CRITICAL))
    let is_critical = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: critical_bits, y: 0)
    var unknown_flag: i64 = 0
    if unknown {
        unknown_flag = 1
    }
    let outside = mut fx.int(clif::Type.Int8, value: unknown_flag)
    return mut fx.b.select(found, x: is_critical, y: outside)
} critical_at

/// Whether an interrupted task has no frame of a function it does not stop inside.
fn stoppable(mut lo: Lowering, mut fx: Fx, at: Interrupted) -> clif::Value {
    let in_ip = critical_at(mut lo, mut fx, address: at.ip, unknown: true)
    // The return address of a function interrupted in its prologue or epilogue, before its frame
    // pointer is set or after it is restored, lives in the link register where the architecture
    // has one, and otherwise in the two words at the stack pointer.
    var busy = in_ip
    match at.link {
        Some(link) => {
            let in_link = critical_at(mut lo, mut fx, address: link, unknown: false)
            busy = mut fx.b.bor(in_ip, y: in_link)
        }
        None => {
            let top = mut fx.load(PTR, addr: at.sp, offset: 0)
            let in_top = critical_at(mut lo, mut fx, address: top, unknown: false)
            let next = mut fx.load(PTR, addr: at.sp, offset: 8)
            let in_next = critical_at(mut lo, mut fx, address: next, unknown: false)
            let busy_top = mut fx.b.bor(in_ip, y: in_top)
            busy = mut fx.b.bor(busy_top, y: in_next)
        }
    }
    let free = mut fx.b.bxor_imm_s(busy, y: 1)
    let chosen = mut fx.choose_in(mut lo, condition: free, results: fx.types1(clif::Type.Int8).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let walked = match at.segment {
            None => mut fx1.repeat(fx1.list2(at.fp, b: free).view(), body: fn[mut lo1](mut pass_fx: Fx, current: Slice[clif::Value]) -> Pass {
                expect current.len() > 1
                let frame = current[0]
                let walk_free = current[1]
                let inside = frame_within(mut pass_fx, frame, low: at.low, high: at.high)
                let stepped = mut pass_fx.choose_in(mut lo1, condition: inside, results: pass_fx.types2(PTR, b: clif::Type.Int8).view(), then: fn(mut cx: Lowering, mut yes_fx: Fx) -> mem::List[clif::Value] {
                    return frame_free(mut cx, fx: mut yes_fx, frame)
                }, otherwise: fn(mut cx: Lowering, mut no_fx: Fx) -> mem::List[clif::Value] {
                    let none = mut no_fx.ptr(0)
                    return no_fx.list2(none, b: walk_free)
                })
                let more = mut pass_fx.b.band(inside, y: stepped[1])
                return Pass(again: more, next: take stepped)
            })
            // A frame outside the segment the walk is in lies on an older one, or on the task's
            // own stack once none is left.
            Some(segment) => mut fx1.repeat(fx1.list3(at.fp, b: free, c: segment).view(), body: fn[mut lo1](mut pass_fx: Fx, current: Slice[clif::Value]) -> Pass {
                expect current.len() > 2
                let frame = current[0]
                let walk_free = current[1]
                let walk_segment = current[2]
                let bounds = stack_bounds(mut pass_fx, segment: walk_segment, low: at.low, high: at.high)
                expect bounds.len() == 2
                let inside = frame_within(mut pass_fx, frame, low: bounds[0], high: bounds[1])
                let grown = mut pass_fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: walk_segment, y: 0)
                let stepped = mut pass_fx.choose_in(mut lo1, condition: inside, results: pass_fx.types4(PTR, b: clif::Type.Int8, c: PTR, d: clif::Type.Int8).view(), then: fn(mut cx: Lowering, mut yes_fx: Fx) -> mem::List[clif::Value] {
                    var stepped_free = frame_free(mut cx, fx: mut yes_fx, frame)
                    let still_free = stepped_free[1]
                    mut stepped_free.push(walk_segment)
                    mut stepped_free.push(still_free)
                    return stepped_free
                }, otherwise: fn(mut cx: Lowering, mut no_fx: Fx) -> mem::List[clif::Value] {
                    let olders = mut no_fx.choose(grown, results: no_fx.types1(PTR).view(), then: fn(mut older_fx: Fx) -> mem::List[clif::Value] {
                        let older = mut older_fx.load(PTR, addr: walk_segment, offset: 0)
                        return older_fx.list1(older)
                    }, otherwise: fn(mut older_fx: Fx) -> mem::List[clif::Value] {
                        let none = mut older_fx.ptr(0)
                        return older_fx.list1(none)
                    })
                    return no_fx.list4(frame, b: walk_free, c: olders[0], d: grown)
                })
                expect stepped.len() == 4
                return Pass(again: stepped[3], next: carried_walk(stepped.view(), alloc: pass_fx.alloc))
            })
        }
        return fx1.list1(walked[1])
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let none = mut fx1.int(clif::Type.Int8, value: 0)
        return fx1.list1(none)
    })
    return chosen[0]
} stoppable

/// Whether a frame record lies within the bounds of a stack.
fn frame_within(mut fx: Fx, frame: clif::Value, low: clif::Value, high: clif::Value) -> clif::Value {
    let frame_above = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThanOrEqual, x: frame, y: low)
    let end = mut fx.b.iadd_imm_s(frame, y: 16)
    let frame_below = mut fx.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: end, y: high)
    return mut fx.b.band(frame_above, y: frame_below)
} frame_within

/// The frame record a frame record links to, and whether its function is one a stopping task
/// may stop outside of, as the base frame's is.
fn frame_free(mut lo: Lowering, mut fx: Fx, frame: clif::Value) -> mem::List[clif::Value] {
    let address = mut fx.load(PTR, addr: frame, offset: 8)
    let at_base = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: address, y: 0)
    let frame_critical = critical_at(mut lo, mut fx, address, unknown: true)
    let is_free = mut fx.b.bxor_imm_s(frame_critical, y: 1)
    let free_or_base = mut fx.b.bor(at_base, y: is_free)
    let caller = mut fx.load(PTR, addr: frame, offset: 0)
    return fx.list2(caller, b: free_or_base)
} frame_free

/// The state a walk across segments carries from a step: its frame record, whether it is free
/// so far and its segment.
fn carried_walk(stepped: Slice[clif::Value], alloc: mem::Alloc) -> mem::List[clif::Value] {
    expect stepped.len() > 2
    var next = mem::List[clif::Value].empty(alloc)
    mut next.push(stepped[0])
    mut next.push(stepped[1])
    mut next.push(stepped[2])
    return next
} carried_walk
