        b"else" => Some(Keyword.Else)
        b"ensures" => Some(Keyword.Ensures)
        b"enum" => Some(Keyword.Enum)
        b"expect" => Some(Keyword.Expect)
        b"fail" => Some(Keyword.Fail)
        b"fails" => Some(Keyword.Fails)
        b"false" => Some(Keyword.False)
