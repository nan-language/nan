//! Tests of reversibility classes.

test irreversible_classes_join_and_meet_by_their_kinds for Class.meet {
    let emitting = Class.Irreversible(1)
    let erasing = Class.Irreversible(4)
    expect emitting.join(erasing) == Class.Irreversible(5)
    expect Class.Recorded.join(Class.Restorable) == Class.Restorable
    expect emitting.meet(erasing) == Class.Restorable
    expect Class.worst().meet(erasing) == erasing
    expect emitting.at_most(Class.Irreversible(5)) and not emitting.at_most(erasing)
    expect Class.Restorable.at_most(emitting) and not emitting.at_most(Class.Restorable)
} irreversible_classes_join_and_meet_by_their_kinds

test compensation_keeps_only_an_emission_irreversible for Class.compensated {
    expect Class.worst().compensated() == Class.Irreversible(1)
    expect Class.Irreversible(4).compensated() == Class.Restorable
    expect Class.Recorded.compensated() == Class.Recorded
} compensation_keeps_only_an_emission_irreversible

test a_class_reads_back_from_its_text for Class.parse {
    let alloc = testing::world().alloc
    let worst = Class.worst().text(alloc)
    expect worst.as_str() == "irreversible(emit, actuate, erase, spend)"
    expect Class.parse("traceless") == Some(Class.Traceless)
    expect Class.parse("recorded") == Some(Class.Recorded)
    expect Class.parse("irreversible(emit, erase)") == Some(Class.Irreversible(5))
    expect Class.parse(worst.as_str()) == Some(Class.worst())
} a_class_reads_back_from_its_text
