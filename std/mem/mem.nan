test removed_handles_are_stale for Pool.contains {
    var numbers = Pool[u8, Unit].empty(testing::world().alloc)
    let handle = mut numbers.insert(4)
    expect numbers.contains(handle)
    discard mut numbers.remove(handle)
    expect not numbers.contains(handle)
} removed_handles_are_stale

test insert_after_remove_keeps_old_handles_stale for Pool.insert {
    var numbers = Pool[u8, Unit].empty(testing::world().alloc)
    let stale = mut numbers.insert(4)
    discard mut numbers.remove(stale)
    let fresh = mut numbers.insert(5)
    expect not numbers.contains(stale)
    expect numbers[fresh] == 5
} insert_after_remove_keeps_old_handles_stale

test pool_try_insert_stores_the_value for Pool.try_insert {
