//! Runs the jobs of nanos bundles in isolated spaces, serving their logs and standard streams on the serial port, their random source from a counter and their file system from a disk writing each call it serves through system calls: a typed job using floats and lanes, an input it does not decode, a host program, jobs that trap, fail and return, with the reports of their traps, a job reading kernel memory, in a domain of its own and outside it, a job recursing past the stack it starts with, a job holding memory within the frames it lends its space, more than the space's own, and past them, a job alone in its space settling through a gauge its world holds while the space waits with no timer armed, a space drawing and giving back pages of its boot area, a job exchanging lines with the kernel over the channels of its link, woken by its doorbell, drawing from a random source and writing to standard streams revoked between its draws and writes, its standard input closed, a job reading its clock, sleeping on it and waiting on its link in a space whose clock is revoked while its kernel sleeps, two jobs of one space reading their clocks and sleeping on them once one's clock is revoked while a third holds more than the frames it lends, a job drawing from its random source over a link of many channels, in more placements of one isolation than its table holds the entries of at once, two jobs of one space charged to the accounts they were placed with, the one in a background class sleeping on while a foreground task spins, a space's runtime probing kernel memory, and a job spinning on floats while a job of the shared space does.

registers Uart {
    data: u8 at 0x0 write
} Uart

registers Selector {
    key: u16 at 0x0 write
} Selector

registers Data {
    byte: u8 at 0x0 read
} Data

/// The fw_cfg key of the file directory, and the bytes of a file's name in it.
const DIRECTORY: u16 = 0x19

const NAME_BYTES: usize = 56

/// The public key of the seed of 32 bytes 7, with which the harness signs the bundles.
const SIGNER: Slice[u8] = b"\xEA\x4A\x6C\x63\xE2\x9C\x52\x0A\xBE\xF5\x50\x7B\x13\x2E\xC5\xF9\x95\x47\x76\xAE\xBE\xBE\x7B\x92\x42\x1E\xEA\x69\x14\x46\xD2\x2C"

/// What the typed job is asked and what it answers, as it declares them.
pub closed struct Readings derives Encode {
    pub values: mem::List[u32]
} Readings

pub closed struct Summary derives Encode {
    pub mean_milli: u64
    pub lanes: u64
    pub entropy: u64
} Summary

pub closed enum Ask derives Encode {
    Average(Readings)
    Divide(u32)
    Sum(u64)
    Spin(u32)
    Hold(u32)
    Echo
    Probe
    Fill(u32)
    Gauge(u32)
    Draw
    Clocked
    Timed(u64)
} Ask

pub closed enum Answer derives Encode {
    Summary(Summary)
    Number(u64)
    Bytes(mem::Bytes)
} Answer

/// The serial port serving a job's log and standard streams, its state counting the bytes of
/// standard input it has given, its standard input closed once given.
struct Console {
} Console

impl Console: sys::Kind[core::atomic::AtomicU64, u64]

impl Console: sys::LogService

impl Console: sys::StdioService

/// A random source serving the bytes of a counter.
struct Counter {
} Counter

impl Counter: sys::Kind[core::atomic::AtomicU64, u64]

impl Counter: sys::RandomService

fn Console.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
    say(text: "log ")
    match level {
        sys::LogLevel.Info => say(text: "info ")
        sys::LogLevel.Warn => say(text: "warn ")
        sys::LogLevel.Error => say(text: "error ")
    }
    say(text: message)
    say(text: ": ")
    say(text: value)
    say(text: "\n")
} Console.log

fn Console.read_in(self, mut buf: SliceMut[u8]) -> usize fails sys::StdioError limits stack 4_096 {
    let input = b"from the kernel"
    let given = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(input.len())))
    let Some(Some(start)) = given else {
        fail sys::StdioError.Closed
    }
    if start > 0 {
        fail sys::StdioError.Closed
    }
    var count: usize = 0
    while count < buf.len() and count < input.len() {
        buf[count] = input[count]
        count += 1
    }
    return count
} Console.read_in

fn Console.write_out(self, data: Slice[u8]) limits stack 4_096 {
    say(text: "out ")
    say_bytes(data)
} Console.write_out

fn Console.write_err(self, data: Slice[u8]) limits stack 4_096 {
    say(text: "err ")
    say_bytes(data)
} Console.write_err

fn Counter.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
    let given = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(buf.len())))
    let start = given.value_or(None).value_or(0)
    for index in 0..<buf.len() {
        buf[index] = u8.truncate(start + u64.widen(index))
    }
} Counter.fill

/// A file system writing each call it serves to the serial port: every file it opens holds
/// `hello`, its root lists a directory and a file, and its state counts the reads it served.
struct Disk {
} Disk

impl Disk: sys::Kind[core::atomic::AtomicU64, u64]

impl Disk: sys::FsService

fn Disk.open(self, path: Str) -> u64 limits stack 4_096 {
    said(text: "disk open ", path)
    return 7
} Disk.open

fn Disk.create(self, path: Str) -> u64 limits stack 4_096 {
    said(text: "disk create ", path)
    return 8
} Disk.create

fn Disk.read_all(self, path: Str, alloc: mem::Alloc) -> mem::Bytes limits stack 4_096 {
    said(text: "disk read all ", path)
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(b"hello")
    return bytes
} Disk.read_all

fn Disk.write_all(self, path: Str, data: Slice[u8]) limits stack 4_096 {
    said(text: "disk write all ", path)
} Disk.write_all

fn Disk.remove(self, path: Str) fails sys::fs::FsError limits stack 4_096 {
    said(text: "disk remove ", path)
    fail sys::fs::FsError.NotFound
} Disk.remove

/// `hello` on every other read, the end of the file on the others.
fn Disk.read(self, file: u64, mut buf: SliceMut[u8]) -> usize limits stack 4_096 {
    let served = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(1))
    if served.value_or(None).value_or(1) % 2 == 1 {
        return 0
    }
    let contents = b"hello"
    var count: usize = 0
    while count < buf.len() and count < contents.len() {
        buf[count] = contents[count]
        count += 1
    }
    return count
} Disk.read

fn Disk.write(self, file: u64, data: Slice[u8]) -> usize limits stack 4_096 {
    say(text: "disk write ")
    say_bytes(data)
    say(text: "\n")
    return data.len()
} Disk.write

fn Disk.byte_len(self, file: u64) -> u64 limits stack 4_096 {
    return 5
} Disk.byte_len

fn Disk.release(self, file: u64) limits stack 4_096 {
    say(text: "disk release\n")
} Disk.release

fn Disk.create_dir(self, path: Str) limits stack 4_096 {
    said(text: "disk create dir ", path)
} Disk.create_dir

fn Disk.rename(self, from: Str, to: Str) limits stack 4_096 {
    say(text: "disk rename ")
    say(text: from)
    said(text: " ", path: to)
} Disk.rename

/// A directory for the empty path, a file for every other.
fn Disk.kind(self, path: Str) -> sys::fs::Kind limits stack 4_096 {
    if path.byte_len() == 0 {
        return sys::fs::Kind.Directory
    }
    return sys::fs::Kind.File
} Disk.kind

fn Disk.list(self, path: Str, alloc: mem::Alloc) -> mem::List[sys::fs::Entry] limits stack 4_096 {
    var entries = mem::List[sys::fs::Entry].empty(alloc)
    mut entries.push(sys::fs::Entry(name: text::String.of("logs", alloc), kind: sys::fs::Kind.Directory))
    mut entries.push(sys::fs::Entry(name: text::String.of("notes", alloc), kind: sys::fs::Kind.File))
    return entries
} Disk.list

/// Writes a text and a path, then a line feed.
fn said(text: Str, path: Str) {
    say(text)
    say(text: path)
    say(text: "\n")
} said

fn say(text: Str) {
    say_bytes(text.as_bytes())
} say

fn say_bytes(bytes: Slice[u8]) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in bytes {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say_bytes

fn say_number(value: u64) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var left = value
    loop {
        digits[count] = b'0' + u8.truncate(left % 10)
        count += 1
        left = left / 10
        if left == 0 {
            break
        }
    }
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    while count > 0 {
        count -= 1
        mut uart.write(Uart.data, value: digits[count])
    }
    take uart.unmap()
} say_number

/// Reads a big-endian number of `count` bytes from the fw_cfg data port.
fn read_be(mut data: hw::Ports[Data], count: u32) -> u64 {
    var value: u64 = 0
    for _ in 0..<count {
        value = (value << 8) | u64.widen(mut data.read(Data.byte))
    }
    return value
} read_be

/// The fw_cfg file of a name: its key and size, a zero key when there is none.
struct Found derives Copy {
    key: u16
    size: u64
} Found

fn find_file(mut data: hw::Ports[Data], name: Str) -> Found {
    var found = Found(key: 0, size: 0)
    for _ in 0..<read_be(mut data, count: 4) {
        let size = read_be(mut data, count: 4)
        let key = u16.truncate(read_be(mut data, count: 2))
        discard read_be(mut data, count: 2)
        var same = true
        for index in 0..<NAME_BYTES {
            let byte = mut data.read(Data.byte)
            var wanted: u8 = 0
            if index < name.as_bytes().len() {
                wanted = name.as_bytes()[index]
            }
            same = same and byte == wanted
        }
        if same {
            found = Found(key: key, size: size)
        }
    }
    return found
} find_file

/// The bytes of the fw_cfg file of a name, empty when there is none.
fn fw_file(name: Str, alloc: mem::Alloc) -> mem::Bytes {
    var selector = trusted "the board decodes port 0x510 to the fw_cfg selector" { hw::Ports[Selector].map(0x510) }
    var data = trusted "the board decodes port 0x511 to the fw_cfg data port" { hw::Ports[Data].map(0x511) }
    mut selector.write(Selector.key, value: DIRECTORY)
    let found = find_file(mut data, name)
    var bytes = mem::Bytes.empty(alloc)
    if found.key != 0 {
        mut selector.write(Selector.key, value: found.key)
        for _ in 0..<found.size {
            mut bytes.push(mut data.read(Data.byte))
        }
    }
    take selector.unmap()
    take data.unmap()
    return bytes
} fw_file

fn stop(text: Str) -> Never {
    say(text)
    loop {
    }
} stop

/// The kernel's policy, which keeps every task on CPU 0, a lesser class first, with 1 ms slices.
struct OneCpu {
} OneCpu

impl OneCpu: hw::Policy

fn OneCpu.place(self, t: hw::IrqsDisabled, task: hw::TaskView) -> hw::Placement limits notrap, terminates, noalloc, stack 4_096 {
    return hw::Placement(cpu: 0, key: u64.widen(task.share.class), bound: false)
} OneCpu.place

fn OneCpu.steal(self, t: hw::IrqsDisabled, cpu: u32, round: u32) -> Option[hw::Steal] limits notrap, terminates, noalloc, stack 4_096 {
    return None
} OneCpu.steal

fn OneCpu.slice(self, t: hw::IrqsDisabled, cpu: u32, task: hw::TaskView) -> u64 limits notrap, terminates, noalloc, stack 4_096 {
    return 1_000_000
} OneCpu.slice

fn OneCpu.idle(self, t: hw::IrqsDisabled, cpu: u32, until_ns: Option[u64]) -> hw::Idle limits notrap, terminates, noalloc, stack 4_096 {
    return hw::Idle.Halt
} OneCpu.idle

/// The frames each space takes and draws from for itself: 16 MiB, less than its runtime's boot area.
const SPACE_FRAMES: usize = 4_096

/// The frames each job or instance lends its space and draws from: 32 MiB, more than the space's
/// own, and those of a job exhausting them: 4 MiB.
const LOAN_FRAMES: usize = 8_192

const HOG_FRAMES: usize = 1_024

/// The bytes of usable memory the kernel's heap grows by, beyond its boot heap, for the lists of
/// frames its isolations pass around.
const HEAP_BYTES: u64 = 16_777_216

/// Kernel memory outside the entry area, which a space's root does not map.
const KERNEL_PROBE: u64 = 0x1000_0000

/// Runs the runtime of a space of a job with its stack in kernel memory outside the entry area,
/// so that its first store probes that memory, and writes whether the store faulted on a page
/// the space's root does not map.
fn probed(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    match attempt job.space(cpu, data: 64, tenant: 1, frames: mut held, alloc: grants.alloc) {
        Ok(space) => {
            var state = hw::UserState(regs: Array[Untrusted[u64], 31].filled(Untrusted.of(0)), sp: Untrusted.of(KERNEL_PROBE + 4_096), ip: Untrusted.of(space.start()), flags: Untrusted.of(0))
            var none: Option[hw::ExtendedState] = None
            var exit = hw::UserExit.Interrupted
            while exit == hw::UserExit.Interrupted {
                exit = space.run(cpu, mut state, extended: mut none)
            }
            match unmapped_fault(exit) {
                true => say(text: "probe faulted on a page the space does not map\n")
                false => say(text: "probe faulted otherwise\n")
            }
            returned(take none, mut frames)
            take space.release(frames: mut held)
        }
        Err(_) => say(text: "probe unplaced\n")
    }
    for frame in take held {
        mut frames.push(take frame)
    }
} probed

/// Whether an exit is a fault of a store to the page below `KERNEL_PROBE + 4_096` that the root
/// does not map.
fn unmapped_fault(exit: hw::UserExit) -> bool {
    let hw::UserExit.Fault(fault) = exit else {
        return false
    }
    // A user-mode write to a page the root does not map: present clear, write and user set.
    return fault.vector == 14 and fault.code == 6 and fault.address >= KERNEL_PROBE and fault.address < KERNEL_PROBE + 4_096
} unmapped_fault

/// Makes a space of a job, draws the first chunk of its boot area, writes there and gives the
/// chunk back, then draws past the frames left and outside the boot area, writing how many
/// frames each step takes or gives back.
fn drew(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    match attempt job.space(cpu, data: 64, tenant: 1, frames: mut held, alloc: grants.alloc) {
        Ok(made) => {
            var space = made
            let area = space.boot_area()
            let left = held.len()
            let Ok(pages) = attempt mut space.draw(area, len: 65_536, frames: mut held) else {
                stop(text: "chunk undrawn\n")
            }
            say(text: "drew ")
            say_number(pages)
            say(text: " pages from ")
            say_number(u64.widen(left - held.len()))
            say(text: " frames\n")
            let wrote = attempt mut space.write(area + 4_096, bytes: b"drawn")
            discard attempt mut space.give_back(area, len: 65_536, frames: mut held)
            say(text: "gave back ")
            say_number(u64.widen(held.len() + 16 - left))
            say(text: " frames, ")
            let unmapped = match attempt mut space.write(area + 4_096, bytes: b"drawn") {
                Err(hw::UserAddrError.Unmapped) => true
                else => false
            }
            match wrote.is_ok() and unmapped {
                true => say(text: "wrote while drawn only\n")
                false => say(text: "wrote otherwise\n")
            }
            let past = match attempt mut space.draw(area, len: u64.widen(held.len() + 1) * 4_096, frames: mut held) {
                Err(sys::load::DrawError.Exhausted) => true
                else => false
            }
            let outside = match attempt mut space.draw(space.data(), len: 1, frames: mut held) {
                Err(sys::load::DrawError.Outside) => true
                else => false
            }
            match past and outside {
                true => say(text: "refused past the frames and outside the boot area\n")
                false => say(text: "refused otherwise\n")
            }
            take space.release(frames: mut held)
        }
        Err(_) => say(text: "space unplaced\n")
    }
    for frame in take held {
        mut frames.push(take frame)
    }
} drew

/// A bundle verified for isolated spaces.
fn isolated(loader: sys::load::Loader, bytes: Slice[u8], alloc: mem::Alloc) -> sys::load::Isolated {
    let keys = Array[core::crypto::PublicKey, 1].filled(bundle_key())
    let Ok(job) = attempt loader.isolate(bytes, keys: keys.view(), alloc) else {
        stop(text: "unverified\n")
    }
    return job
} isolated

/// What the kernel serves every job.
struct Grants derives Copy {
    clock: sys::Clock
    console: Console
    counter: Counter
    disk: Disk
    exec: task::Executor
    alloc: mem::Alloc
} Grants

/// The services of an isolated job: the kernel's clock, its log and standard streams on the
/// console, its random source the counter and its file system the disk.
fn services(grants: Grants) -> nanos::Services {
    let Ok(log) = attempt sys::Log.served(grants.console) else {
        stop(text: "no log\n")
    }
    let Ok(stdio) = attempt sys::Stdio.served(grants.console) else {
        stop(text: "no stdio\n")
    }
    let Ok(random) = attempt sys::Random.served(grants.counter) else {
        stop(text: "no random\n")
    }
    let Ok(fs) = attempt sys::Fs.served(grants.disk) else {
        stop(text: "no fs\n")
    }
    return nanos::Services(clock: grants.clock, log: log, stdio: stdio, random: random, fs: fs)
} services

/// The frames a space takes, from the end of `frames`.
fn frames_for_space(mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    return frames_taken(mut frames, count: SPACE_FRAMES, alloc)
} frames_for_space

/// The frames a job or instance lends its space, from the end of `frames`.
fn frames_for_job(mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    return frames_taken(mut frames, count: LOAN_FRAMES, alloc)
} frames_for_job

/// `count` frames from the end of `frames`.
fn frames_taken(mut frames: mem::List[hw::PhysFrame[4_096]], count: usize, alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    var taken = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    for _ in 0..<count {
        let Some(frame) = mut frames.pop() else {
            stop(text: "out of frames\n")
        }
        mut taken.push(take frame)
    }
    return taken
} frames_taken

/// Gives back to `frames` every frame of `taken`.
fn given_back(take taken: mem::List[hw::PhysFrame[4_096]], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    for frame in take taken {
        mut frames.push(take frame)
    }
} given_back

/// Writes how a run ended, giving what it returned, empty for a run returning nothing.
fn report(name: Str, take outcome: Result[nanos::Ended, nanos::IsolatedError], alloc: mem::Alloc) -> mem::Bytes {
    say(text: name)
    match outcome {
        Ok(nanos::Ended.Returned(bytes)) => {
            say(text: " returned\n")
            return bytes
        }
        Ok(nanos::Ended.Failed(rendered)) => {
            say(text: " failed ")
            say(text: rendered.as_str())
            say(text: "\n")
        }
        Ok(nanos::Ended.Trapped(trap)) => {
            match trap.kind() {
                sys::TrapKind.DivisionByZero => say(text: " trapped trap.division-by-zero\n")
                sys::TrapKind.Exception => say(text: " trapped trap.exception\n")
                sys::TrapKind.Exhausted => say(text: " trapped trap.exhausted\n")
                else => say(text: " trapped otherwise\n")
            }
            say_trap(trap, alloc)
        }
        Ok(nanos::Ended.Cancelled) or Ok(nanos::Ended.Abandoned) => say(text: " stopped\n")
        Ok(nanos::Ended.Undecodable) => say(text: " undecodable\n")
        Err(_) => say(text: " did not run\n")
    }
    return mem::Bytes.empty(alloc)
} report

/// Runs the job of a bundle verified for isolated spaces in a space on each input, its world
/// holding `caps`, writing how each run ended, and gives what each run returned.
fn ran(cpu: hw::Ring0, job: sys::load::Isolated, name: Str, grants: Grants, caps: nanos::Caps, take inputs: mem::List[mem::Bytes], mut frames: mem::List[hw::PhysFrame[4_096]]) -> mem::List[mem::Bytes] fails task::Cancelled uses wait {
    var left = inputs
    var results = mem::List[mem::Bytes].empty(grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    let link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var loan = frames_for_job(mut frames, alloc: grants.alloc)
    discard attempt await nanos::isolate(cpu, tenant: 1, services: services(grants), frames: mut held, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut left, mut results, mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
        while left.len() > 0 {
            let input = mut left.remove(0)
            let outcome = attempt await nanos::run_isolated(space, job, link, services: services(grants), caps, take input, frames: mut loan, exec: grants.exec, alloc: grants.alloc)
            mut results.push(report(name, take outcome, alloc: grants.alloc))
        }
    })
    given_back(take held, mut frames)
    given_back(take loan, mut frames)
    returned(take extended, mut frames)
    take link.release(mut frames)
    return results
} ran

/// Runs the typed job adding and settling through a gauge its world holds alone in a space, which
/// waits with no timer armed while the gauge settles, and writes the settled total.
fn settled_alone(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let gauging = gauges::open(grants.clock, alloc: grants.alloc)
    defer gauges::close(take gauging)
    var caps = nanos::Caps.empty(grants.alloc)
    mut nanos::Cap[gauges::Gauge].put(mut caps, key: "gauge", capability: gauges::mint(gauging))
    var asks = mem::List[mem::Bytes].empty(grants.alloc)
    mut asks.push(encoded(Ask.Gauge(7), alloc: grants.alloc))
    var settled = try await ran(cpu, job, name: "alone", grants, caps, inputs: take asks, mut frames)
    say_answer(text: "alone settled ", bytes: mut settled.remove(0), alloc: grants.alloc)
} settled_alone

/// The placements of the job drawing from its random source in one isolation, and the channels of
/// its link: each placement takes an entry of its space's table for each channel besides those of
/// its services and runner, more entries over the placements than the table holds at once.
const PLACEMENTS: u64 = 20

const DRAW_CHANNELS: u64 = 12

/// Runs the typed job drawing a word from its random source `PLACEMENTS` times in one isolation,
/// over a link of `DRAW_CHANNELS` channels, writing how many draws returned.
fn reclaimed(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    for _ in 0u64..<DRAW_CHANNELS {
        discard mut link.open("draw", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    }
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var loan = frames_for_job(mut frames, alloc: grants.alloc)
    var drawn: u64 = 0
    discard attempt await nanos::isolate(cpu, tenant: 8, services: services(grants), frames: mut held, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut drawn, mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
        for _ in 0u64..<PLACEMENTS {
            match attempt await nanos::run_isolated(space, job, link, services: services(grants), caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Draw, alloc: grants.alloc), frames: mut loan, exec: grants.exec, alloc: grants.alloc) {
                Ok(nanos::Ended.Returned(_)) => {
                    drawn += 1
                }
                else => {}
            }
        }
    })
    given_back(take held, mut frames)
    given_back(take loan, mut frames)
    returned(take extended, mut frames)
    take link.release(mut frames)
    say(text: "drew in ")
    say_number(drawn)
    say(text: " of the placements of one isolation\n")
} reclaimed

/// The last frame of a list, or a stop when none is left.
fn next_frame(mut frames: mem::List[hw::PhysFrame[4_096]]) -> hw::PhysFrame[4_096] {
    let Some(frame) = mut frames.pop() else {
        stop(text: "out of frames\n")
    }
    return frame
} next_frame

/// Gives back the frame of an extended state.
fn returned(take extended: Option[hw::ExtendedState], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    match extended {
        Some(owned) => mut frames.push(take owned.into_frame())
        None => {}
    }
} returned

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    let clock = k.clock()
    let Some(loader) = k.loader() else {
        stop(text: "no loader\n")
    }
    let Some(cpu) = mut k.ring0() else {
        stop(text: "no ring0\n")
    }
    var regions = mut k.regions()
    var frames = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    let Some(region) = mut regions.pop() else {
        stop(text: "no usable memory\n")
    }
    var heap = region
    let Some(rest) = mut heap.split(at: heap.base() + HEAP_BYTES) else {
        stop(text: "too little memory\n")
    }
    k.grow_heap(take heap)
    take rest.frames(mut frames)
    mut k.policy(OneCpu())
    take k.anchor(0u8, run: fn[take loader, take cpu, take frames](exec: task::Executor) fails task::Cancelled uses wait limits stack 262_144 {
        discard cpu.enable_protection(hw::Protection.Pcid)
        let consoles = sys::Minter[Console, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let counters = sys::Minter[Counter, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let disks = sys::Minter[Disk, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let grants = Grants(clock: clock, console: consoles.mint(0), counter: counters.mint(0), disk: disks.mint(0), exec: exec, alloc: alloc)
        var pool = frames
        let served = attempt await serve(cpu, loader, grants, frames: mut pool)
        take consoles.close()
        take counters.close()
        take disks.close()
        let Some(last) = mut pool.pop() else {
            stop(text: "out of frames\n")
        }
        relinquished(take cpu, frame: take last)
        for frame in take pool {
            given_up(take frame)
        }
        discard served
    })
} main

/// Gives up the CPU's privileges, which a frame holds from now on, and the frame.
fn relinquished(take cpu: hw::Ring0, take frame: hw::PhysFrame[4_096]) {
    let base = frame.base()
    trusted "the frame holds the privileges, and no value owns them from now on" { hw::Ptr[hw::Ring0].of_addr(usize.widen(base + 8)).write(take cpu) }
    given_up(take frame)
} relinquished

/// Gives up an unused frame, which holds itself from now on.
fn given_up(take frame: hw::PhysFrame[4_096]) {
    let base = frame.base()
    trusted "the frame holds itself, and no value owns it from now on" { hw::Ptr[hw::PhysFrame[4_096]].of_addr(usize.widen(base)).write(take frame) }
} given_up

/// Runs the jobs: a typed job using floats, lanes and the served capabilities and an input it does
/// not decode, a host program, a job trapping, failing, returning and reading kernel memory, a job
/// without a stack bound recursing past the stack it starts with, a job holding memory within the
/// frames it lends its space, more than the space's own, and past them, a space drawing and giving
/// back pages, a job answering a line over its link, a job in a space whose clock is revoked, two
/// jobs sharing a space, one of whose clocks is revoked, with a third holding past the frames it
/// lends, a job drawing from its random source in more placements of one isolation than its table
/// holds the entries of at once, two jobs of one space charged to the accounts they were placed
/// with, a space's runtime probing kernel memory, then a job spinning on floats in a space while
/// the same job, verified once, spins in the shared space.
fn serve(cpu: hw::Ring0, loader: sys::load::Loader, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    var values = mem::List[u32].empty(grants.alloc)
    mut values.push(2)
    mut values.push(4)
    mut values.push(9)
    var averaged = mem::List[mem::Bytes].empty(grants.alloc)
    mut averaged.push(encoded(Ask.Average(Readings(values: take values)), alloc: grants.alloc))
    var garbage = mem::Bytes.empty(grants.alloc)
    mut garbage.push(0xFF)
    mut averaged.push(take garbage)
    let typed_bytes = fw_file(name: "opt/nan/typed", alloc: grants.alloc)
    let typed = isolated(loader, bytes: typed_bytes.view(), alloc: grants.alloc)
    let summaries = try await ran(cpu, job: typed, name: "average", grants, caps: nanos::Caps.empty(grants.alloc), inputs: take averaged, mut frames)
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(summaries[0].view()), alloc: grants.alloc) {
        Ok(Answer.Summary(summary)) => {
            say(text: "mean ")
            say_number(summary.mean_milli)
            say(text: " lanes ")
            say_number(summary.lanes)
            say(text: " entropy ")
            say_number(summary.entropy)
            say(text: "\n")
        }
        else => say(text: "summary undecodable\n")
    }
    var args = mem::List[mem::Bytes].empty(grants.alloc)
    mut args.push(mem::Bytes.empty(grants.alloc))
    let host = nanos::HostInput(args: take args, environment: mem::Map[mem::Bytes, mem::Bytes].empty(grants.alloc))
    var greeted = mem::List[mem::Bytes].empty(grants.alloc)
    mut greeted.push(encoded(host, alloc: grants.alloc))
    let greet = unverified(loader, bytes: fw_file(name: "opt/nan/greet", alloc: grants.alloc).view(), alloc: grants.alloc)
    discard try await ran(cpu, job: greet, name: "greet", grants, caps: nanos::Caps.empty(grants.alloc), inputs: take greeted, mut frames)
    var divisors = mem::List[mem::Bytes].empty(grants.alloc)
    mut divisors.push(encoded(Ask.Divide(0), alloc: grants.alloc))
    mut divisors.push(encoded(Ask.Divide(1), alloc: grants.alloc))
    mut divisors.push(encoded(Ask.Divide(4), alloc: grants.alloc))
    mut divisors.push(encoded(Ask.Divide(2), alloc: grants.alloc))
    mut divisors.push(encoded(Ask.Probe, alloc: grants.alloc))
    var quotients = try await ran(cpu, job: typed, name: "crash", grants, caps: nanos::Caps.empty(grants.alloc), inputs: take divisors, mut frames)
    say_answer(text: "quotient ", bytes: mut quotients.remove(2), alloc: grants.alloc)
    var depths = mem::List[mem::Bytes].empty(grants.alloc)
    mut depths.push(encoded(Ask.Sum(20_000), alloc: grants.alloc))
    var sums = try await ran(cpu, job: typed, name: "deep", grants, caps: nanos::Caps.empty(grants.alloc), inputs: take depths, mut frames)
    say_answer(text: "sum ", bytes: mut sums.remove(0), alloc: grants.alloc)
    var holdings = mem::List[mem::Bytes].empty(grants.alloc)
    mut holdings.push(encoded(Ask.Hold(20), alloc: grants.alloc))
    mut holdings.push(encoded(Ask.Hold(64), alloc: grants.alloc))
    mut holdings.push(encoded(Ask.Fill(1_100), alloc: grants.alloc))
    var holds = try await ran(cpu, job: typed, name: "hold", grants, caps: nanos::Caps.empty(grants.alloc), inputs: take holdings, mut frames)
    say_answer(text: "held pages ", bytes: mut holds.remove(0), alloc: grants.alloc)
    say_filled(mut holds.remove(1), alloc: grants.alloc)
    try await settled_alone(cpu, job: typed, grants, mut frames)
    drew(cpu, job: typed, grants, mut frames)
    try await linked(cpu, job: typed, grants, mut frames)
    try await unclocked(cpu, job: typed, grants, mut frames)
    try await clocked_apart(cpu, job: typed, grants, mut frames)
    try await reclaimed(cpu, job: typed, grants, mut frames)
    try await charged(cpu, job: typed, grants, mut frames)
    probed(cpu, job: typed, grants, mut frames)
    try await spun(cpu, loader, job: typed, bytes: typed_bytes.view(), grants, mut frames)
} serve

/// Runs the typed job spinning in a space and, in another task, in the shared space from the
/// bytes `job` was verified from, each from its own start, and writes the integer parts each
/// gives.
fn spun(cpu: hw::Ring0, loader: sys::load::Loader, job: sys::load::Isolated, bytes: Slice[u8], grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let Ok(prepared) = trusted "isolate verified these bytes" { attempt loader.prepare_unverified(bytes, alloc: grants.alloc) } else {
        stop(text: "malformed\n")
    }
    let Ok(bundle) = attempt take prepared.load() else {
        stop(text: "unloadable\n")
    }
    let load = bundle.share()
    var given = Some(Spun(result: mem::Bytes.empty(grants.alloc), frames: frames_for_space(mut frames, alloc: grants.alloc), loan: frames_for_job(mut frames, alloc: grants.alloc), extended: Some(hw::ExtendedState.of(next_frame(mut frames))), link: nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)))
    var in_shared = mem::Bytes.empty(grants.alloc)
    var runs = mem::List[Spun].empty(grants.alloc)
    discard attempt await task::scope(grants.exec, body: fn[mut given, mut in_shared, mut runs](s: task::Scope) fails task::Cancelled uses wait {
        let Some(taken) = mut given.extract() else {
            return
        }
        let isolated_run = s.spawn(fn[take taken]() -> Spun fails task::Cancelled uses wait limits stack 196_608 {
            let Spun(result: _, frames: held, loan: lending, extended: owned, link: link) = taken
            var pool = held
            var loan = lending
            var state = owned
            var result = mem::Bytes.empty(grants.alloc)
            discard attempt await nanos::isolate(cpu, tenant: 2, services: services(grants), frames: mut pool, extended: mut state, exec: grants.exec, alloc: grants.alloc, body: fn[mut result, mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
                result = result_of(attempt await nanos::run_isolated(space, job, link, services: services(grants), caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Spin(500_000), alloc: grants.alloc), frames: mut loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
            })
            return Spun(result: take result, frames: take pool, loan: take loan, extended: take state, link: take link)
        })
        let outcome = attempt await nanos::run(load, world: world_of(grants), input: encoded(Ask.Spin(1), alloc: grants.alloc), domain: sys::Abandoner.new(), exec: grants.exec, alloc: grants.alloc)
        in_shared = shared_result_of(take outcome, alloc: grants.alloc)
        mut runs.push(try await take isolated_run.join())
    })
    take bundle.unload()
    say_answer(text: "spun ", bytes: take in_shared, alloc: grants.alloc)
    for run in take runs {
        let Spun(result: result, frames: held, loan: loan, extended: owned, link: link) = run
        say_answer(text: "spun ", bytes: take result, alloc: grants.alloc)
        given_back(take held, mut frames)
        given_back(take loan, mut frames)
        returned(take owned, mut frames)
        take link.release(mut frames)
    }
    match given {
        Some(Spun(result: _, frames: held, loan: loan, extended: owned, link: link)) => {
            given_back(take held, mut frames)
            given_back(take loan, mut frames)
            returned(take owned, mut frames)
            take link.release(mut frames)
        }
        None => {}
    }
} spun

/// What a job's run in a space gives back: what it returned, and the frames of its space, those it
/// loan, the extended state and the link it took.
linear struct Spun {
    result: mem::Bytes
    frames: mem::List[hw::PhysFrame[4_096]]
    loan: mem::List[hw::PhysFrame[4_096]]
    extended: Option[hw::ExtendedState]
    link: nanos::Link
} Spun

/// Runs the typed job answering a line over a link of two channels, `ask` and `answer`: once
/// the job says it is ready, revokes its random source and standard streams, waits 100 ms and
/// sends it a line, then writes what the job sent and whether its read returned before the second
/// its runtime waits at most on the doorbell.
fn linked(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let served = services(grants)
    let Ok(random) = attempt sys::revocable(served.random) else {
        stop(text: "no random\n")
    }
    let Ok(stdio) = attempt sys::revocable(served.stdio) else {
        stop(text: "no stdio\n")
    }
    let drawn = nanos::Services(clock: served.clock, log: served.log, stdio: stdio.capability(), random: random.capability(), fs: served.fs)
    var revoking = Some(Revokers(random: take random, stdio: take stdio))
    var link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    let ask = mut link.open("ask", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let answer = mut link.open("answer", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var loan = frames_for_job(mut frames, alloc: grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var result = mem::Bytes.empty(grants.alloc)
    discard attempt await task::scope(grants.exec, body: fn[mut held, mut loan, mut extended, mut result, mut revoking](s: task::Scope) fails task::Cancelled uses wait {
        let run = s.spawn(fn[mut held, mut loan, mut extended, mut result]() fails task::Cancelled uses wait limits stack 196_608 {
            discard attempt await nanos::isolate(cpu, tenant: 3, services: services(grants), frames: mut held, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut result, mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
                result = result_of(attempt await nanos::run_isolated(space, job, link, services: drawn, caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Echo, alloc: grants.alloc), frames: mut loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
            })
        })
        say_received(text: "link said ", outcome: attempt await link.receive(answer, alloc: grants.alloc), alloc: grants.alloc)
        let Some(revoked) = mut revoking.extract() else {
            return
        }
        take revoked.revoke()
        try await grants.clock.sleep_ns(100_000_000)
        discard attempt link.send(ask, data: b"ping")
        say_received(text: "link answered ", outcome: attempt await link.receive(answer, alloc: grants.alloc), alloc: grants.alloc)
        try await take run.join()
    })
    match revoking {
        Some(unrevoked) => take unrevoked.revoke()
        None => {}
    }
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(result.view()), alloc: grants.alloc) {
        Ok(Answer.Number(waited)) => {
            match waited < 900_000_000 {
                true => say(text: "the doorbell woke the read\n")
                false => say(text: "the read woke otherwise\n")
            }
        }
        else => say(text: "echo answered nothing\n")
    }
    given_back(take held, mut frames)
    given_back(take loan, mut frames)
    returned(take extended, mut frames)
    take link.release(mut frames)
} linked

/// Runs a job whose clock and whose space's clock are revoked, on an executor of its own, which
/// reads its world's clock and its space's, sleeps on its world's and says so, then reads a line
/// its kernel sends after sleeping for 100 ms meanwhile, and writes whether the space's task ran for
/// less than half of that sleep.
fn unclocked(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let Ok(revoker) = attempt sys::revocable(grants.clock) else {
        stop(text: "no clock\n")
    }
    let served = services(grants)
    let stopped = nanos::Services(clock: revoker.capability(), log: served.log, stdio: served.stdio, random: served.random, fs: served.fs)
    take revoker.revoke()
    let account = grants.exec.split(task::Share(weight: 1, class: 0, reserve_ppm: 0))
    var link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    let ask = mut link.open("ask", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let answer = mut link.open("answer", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var loan = frames_for_job(mut frames, alloc: grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var result = mem::Bytes.empty(grants.alloc)
    var spent: u64 = 0
    discard attempt await task::scope(grants.exec, body: fn[mut held, mut loan, mut extended, mut result, mut spent](s: task::Scope) fails task::Cancelled uses wait {
        let run = s.spawn(fn[mut held, mut loan, mut extended, mut result]() fails task::Cancelled uses wait limits stack 196_608 {
            discard attempt await nanos::isolate(cpu, tenant: 9, services: stopped, frames: mut held, mut extended, exec: account.executor(), alloc: grants.alloc, body: fn[mut result, mut loan](space: nanos::Isolation) fails task::Cancelled uses wait {
                result = result_of(attempt await nanos::run_isolated(space, job, link, services: stopped, caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Clocked, alloc: grants.alloc), frames: mut loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
            })
        })
        say_received(text: "unclocked said ", outcome: attempt await link.receive(answer, alloc: grants.alloc), alloc: grants.alloc)
        let before = account.used_ns()
        try await grants.clock.sleep_ns(100_000_000)
        spent = account.used_ns().saturating_sub(before)
        discard attempt link.send(ask, data: b"ping")
        try await take run.join()
    })
    take account.close()
    match spent < 50_000_000 {
        true => say(text: "the unclocked space waited\n")
        false => say(text: "the unclocked space spun\n")
    }
    say_answer(text: "unclocked read ", bytes: take result, alloc: grants.alloc)
    given_back(take held, mut frames)
    given_back(take loan, mut frames)
    returned(take extended, mut frames)
    take link.release(mut frames)
} unclocked

/// Runs two jobs together in one space, each over a link of two channels, `ask` and `answer`, the
/// first with a clock its kernel revokes once both say they read their clocks: sends the first a
/// line, then the second once the first says it slept, and writes what each said and whether each
/// one's sleep returned at once; a third job of the space meanwhile holds more than the frames it
/// lends, and its run is written last.
fn clocked_apart(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let Ok(revoker) = attempt sys::revocable(grants.clock) else {
        stop(text: "no clock\n")
    }
    let served = services(grants)
    let revocable = nanos::Services(clock: revoker.capability(), log: served.log, stdio: served.stdio, random: served.random, fs: served.fs)
    var revoking = Some(take revoker)
    var revoked_link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    let revoked_ask = mut revoked_link.open("ask", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let revoked_answer = mut revoked_link.open("answer", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var live_link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    let live_ask = mut live_link.open("ask", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let live_answer = mut live_link.open("answer", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let hog_link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var revoked_loan = frames_for_job(mut frames, alloc: grants.alloc)
    var live_loan = frames_for_job(mut frames, alloc: grants.alloc)
    var hog_loan = frames_taken(mut frames, count: HOG_FRAMES, alloc: grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var revoked_slept = mem::Bytes.empty(grants.alloc)
    var live_slept = mem::Bytes.empty(grants.alloc)
    var hogged: Result[nanos::Ended, nanos::IsolatedError] = Ok(nanos::Ended.Cancelled)
    discard attempt await task::scope(grants.exec, body: fn[mut held, mut revoked_loan, mut live_loan, mut hog_loan, mut extended, mut revoked_slept, mut live_slept, mut hogged, mut revoking](s: task::Scope) fails task::Cancelled uses wait {
        let run = s.spawn(fn[mut held, mut revoked_loan, mut live_loan, mut hog_loan, mut extended, mut revoked_slept, mut live_slept, mut hogged]() fails task::Cancelled uses wait limits stack 196_608 {
            discard attempt await nanos::isolate(cpu, tenant: 10, services: served, frames: mut held, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut revoked_loan, mut live_loan, mut hog_loan, mut revoked_slept, mut live_slept, mut hogged](space: nanos::Isolation) fails task::Cancelled uses wait {
                try await task::scope(grants.exec, body: fn[mut revoked_loan, mut live_loan, mut hog_loan, mut revoked_slept, mut live_slept, mut hogged](t: task::Scope) fails task::Cancelled uses wait {
                    let revoked_run = t.spawn(fn[mut revoked_loan]() -> mem::Bytes fails task::Cancelled uses wait limits stack 65_536 {
                        return result_of(attempt await nanos::run_isolated(space, job, link: revoked_link, services: revocable, caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Timed(1_000_000_000), alloc: grants.alloc), frames: mut revoked_loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
                    })
                    let hog_run = t.spawn(fn[mut hog_loan]() -> Result[nanos::Ended, nanos::IsolatedError] fails task::Cancelled uses wait limits stack 65_536 {
                        return attempt await nanos::run_isolated(space, job, link: hog_link, services: served, caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Hold(8), alloc: grants.alloc), frames: mut hog_loan, exec: grants.exec, alloc: grants.alloc)
                    })
                    live_slept = result_of(attempt await nanos::run_isolated(space, job, link: live_link, services: served, caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Timed(1_000_000), alloc: grants.alloc), frames: mut live_loan, exec: grants.exec, alloc: grants.alloc), alloc: grants.alloc)
                    revoked_slept = try await take revoked_run.join()
                    hogged = try await take hog_run.join()
                })
            })
        })
        let revoked_read = attempt await revoked_link.receive(revoked_answer, alloc: grants.alloc)
        let live_read = attempt await live_link.receive(live_answer, alloc: grants.alloc)
        say_received(text: "revoked clock said ", outcome: take revoked_read, alloc: grants.alloc)
        say_received(text: "live clock said ", outcome: take live_read, alloc: grants.alloc)
        let Some(revoked) = mut revoking.extract() else {
            return
        }
        take revoked.revoke()
        discard attempt revoked_link.send(revoked_ask, data: b"go")
        say_received(text: "revoked clock said ", outcome: attempt await revoked_link.receive(revoked_answer, alloc: grants.alloc), alloc: grants.alloc)
        discard attempt live_link.send(live_ask, data: b"go")
        say_received(text: "live clock said ", outcome: attempt await live_link.receive(live_answer, alloc: grants.alloc), alloc: grants.alloc)
        try await take run.join()
    })
    match revoking {
        Some(unrevoked) => take unrevoked.revoke()
        None => {}
    }
    say_slept(text: "the revoked clock's sleep ", bytes: take revoked_slept, ns: 1_000_000_000, alloc: grants.alloc)
    say_slept(text: "the live clock's sleep ", bytes: take live_slept, ns: 1_000_000, alloc: grants.alloc)
    discard report("hog", outcome: take hogged, alloc: grants.alloc)
    given_back(take held, mut frames)
    given_back(take revoked_loan, mut frames)
    given_back(take live_loan, mut frames)
    given_back(take hog_loan, mut frames)
    returned(take extended, mut frames)
    take revoked_link.release(mut frames)
    take live_link.release(mut frames)
    take hog_link.release(mut frames)
} clocked_apart

/// Writes whether a sleep of `ns` whose nanoseconds a job returned ran its course or returned at
/// once.
fn say_slept(text: Str, take bytes: mem::Bytes, ns: u64, alloc: mem::Alloc) {
    say(text)
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(Answer.Number(slept)) => {
            match slept >= ns {
                true => say(text: "ran its course\n")
                false => say(text: "returned at once\n")
            }
        }
        else => say(text: "gave nothing\n")
    }
} say_slept

/// What revokes the random source and standard streams of a linked job.
linear struct Revokers {
    random: sys::Revoker[sys::Random]
    stdio: sys::Revoker[sys::Stdio]
} Revokers

fn Revokers.revoke(take self) {
    let Revokers(random: random, stdio: stdio) = self
    take random.revoke()
    take stdio.revoke()
} Revokers.revoke

/// Runs the typed job sleeping 200 ms on the executor of an account of a background class beside
/// the job dividing in the same space on the executor of one of the foreground class, a task of the
/// foreground class spinning on the kernel's clock for 250 ms from 50 ms after the sleeping job is
/// told to sleep, and writes whether that job's sleep ran on until the task stopped spinning and
/// each account ran some time.
fn charged(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let background = grants.exec.split(task::Share(weight: 1, class: 1, reserve_ppm: 0))
    let foreground = grants.exec.split(task::Share(weight: 1, class: 0, reserve_ppm: 0))
    let behind = background.executor()
    let ahead = foreground.executor()
    var sleep_link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    let ask = mut sleep_link.open("ask", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let answer = mut sleep_link.open("answer", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let divide_link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var sleep_loan = frames_for_job(mut frames, alloc: grants.alloc)
    var divide_loan = frames_for_job(mut frames, alloc: grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var slept = mem::Bytes.empty(grants.alloc)
    discard attempt await task::scope(grants.exec, body: fn[mut held, mut sleep_loan, mut divide_loan, mut extended, mut slept](s: task::Scope) fails task::Cancelled uses wait {
        let run = s.spawn(fn[mut held, mut sleep_loan, mut divide_loan, mut extended, mut slept]() fails task::Cancelled uses wait limits stack 196_608 {
            discard attempt await nanos::isolate(cpu, tenant: 13, services: services(grants), frames: mut held, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn[mut sleep_loan, mut divide_loan, mut slept](space: nanos::Isolation) fails task::Cancelled uses wait {
                try await task::scope(grants.exec, body: fn[mut sleep_loan, mut divide_loan, mut slept](t: task::Scope) fails task::Cancelled uses wait {
                    let sleep_run = t.spawn(fn[mut sleep_loan]() -> mem::Bytes fails task::Cancelled uses wait limits stack 65_536 {
                        return result_of(attempt await nanos::run_isolated(space, job, link: sleep_link, services: services(grants), caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Timed(200_000_000), alloc: grants.alloc), frames: mut sleep_loan, exec: behind, alloc: grants.alloc), alloc: grants.alloc)
                    })
                    discard attempt await nanos::run_isolated(space, job, link: divide_link, services: services(grants), caps: nanos::Caps.empty(grants.alloc), input: encoded(Ask.Divide(4), alloc: grants.alloc), frames: mut divide_loan, exec: ahead, alloc: grants.alloc)
                    slept = try await take sleep_run.join()
                })
            })
        })
        discard attempt await sleep_link.receive(answer, alloc: grants.alloc)
        discard attempt sleep_link.send(ask, data: b"go")
        try await grants.clock.sleep_ns(50_000_000)
        let start = now_ns(grants.clock)
        while now_ns(grants.clock) - start < 250_000_000 {
        }
        discard attempt await sleep_link.receive(answer, alloc: grants.alloc)
        try await take run.join()
    })
    let held_up = match attempt mem::wire::Codec[Answer].decode(Untrusted.of(slept.view()), alloc: grants.alloc) {
        Ok(Answer.Number(ns)) => ns >= 240_000_000
        else => false
    }
    match held_up and background.used_ns() > 0 and foreground.used_ns() > 0 {
        true => say(text: "the background job slept on until the foreground task spun, each account running\n")
        false => say(text: "the jobs ran otherwise\n")
    }
    take background.close()
    take foreground.close()
    given_back(take held, mut frames)
    given_back(take sleep_loan, mut frames)
    given_back(take divide_loan, mut frames)
    returned(take extended, mut frames)
    take sleep_link.release(mut frames)
    take divide_link.release(mut frames)
} charged

/// The nanoseconds `clock` reads.
fn now_ns(clock: sys::Clock) -> u64 {
    let Ok(now) = attempt clock.elapsed_ns() else {
        stop(text: "no clock\n")
    }
    return now
} now_ns

/// Writes the bytes a typed job answered.
fn say_filled(take bytes: mem::Bytes, alloc: mem::Alloc) {
    say(text: "filled ")
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(Answer.Bytes(given)) => {
            say_number(u64.widen(given.len()))
            say(text: "\n")
        }
        else => say(text: "nothing\n")
    }
} say_filled

/// Writes a trap's report.
fn say_trap(trap: sys::Trap, alloc: mem::Alloc) {
    var text = text::String.empty(alloc)
    mut text.write(Dyn[Render].view(trap), budget: 4_096)
    say(text: text.as_str())
} say_trap

/// Writes `text`, then the bytes a link received.
fn say_received(text: Str, take outcome: Result[Untrusted[mem::Bytes], nanos::LinkError], alloc: mem::Alloc) {
    say(text)
    match outcome {
        Ok(bytes) => say_bytes(shown(bytes.view(), alloc).view())
        Err(_) => say(text: "nothing")
    }
    say(text: "\n")
} say_received

/// The bytes a space sent, which the kernel writes as they are.
validator fn shown(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(raw.inspect())
    return bytes
} shown

/// What a run in a space returned, empty for a run ending otherwise.
fn result_of(take outcome: Result[nanos::Ended, nanos::IsolatedError], alloc: mem::Alloc) -> mem::Bytes {
    match outcome {
        Ok(nanos::Ended.Returned(bytes)) => return bytes
        else => return mem::Bytes.empty(alloc)
    }
} result_of

/// What a run in the shared space returned, empty for a run ending otherwise.
fn shared_result_of(take outcome: Result[nanos::Ended, nanos::RunError], alloc: mem::Alloc) -> mem::Bytes {
    match outcome {
        Ok(nanos::Ended.Returned(bytes)) => return bytes
        else => return mem::Bytes.empty(alloc)
    }
} shared_result_of

/// Writes `text`, then the number a typed job answered.
fn say_answer(text: Str, take bytes: mem::Bytes, alloc: mem::Alloc) {
    say(text)
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(Answer.Number(value)) => {
            say_number(value)
            say(text: "\n")
        }
        else => say(text: "nothing\n")
    }
} say_answer

/// The world of a shared job: its log, standard streams and random source served, its file
/// system and network denied.
fn world_of(grants: Grants) -> nanos::World {
    let served = services(grants)
    return nanos::World(alloc: grants.alloc, exec: grants.exec, clock: grants.clock, random: served.random, log: served.log, stdio: served.stdio, fs: sys::Fs.denied(), net: sys::Net.denied(), caps: nanos::Caps.empty(grants.alloc))
} world_of

fn encoded[T: Encode](value: T, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return bytes
} encoded

fn bundle_key() -> core::crypto::PublicKey {
    var bytes = Array[u8, 32].filled(0)
    mut bytes.view_mut().copy_from(SIGNER)
    return core::crypto::PublicKey(bytes: bytes)
} bundle_key

/// A bundle placed for isolated spaces without checking its signature, trusted as the harness
/// builds each bundle against this kernel's interface.
fn unverified(loader: sys::load::Loader, bytes: Slice[u8], alloc: mem::Alloc) -> sys::load::Isolated {
    let Ok(job) = trusted "the harness builds each bundle against this kernel's interface" { attempt loader.isolate_unverified(bytes, alloc) } else {
        stop(text: "unplaceable\n")
    }
    return job
} unverified
