//! Loads nanos bundles and runs their jobs in domains of their own, serving their logs, standard streams, files and network on the serial port and their random source from a counter: a typed job using floats and lanes, an input it does not decode, a host program, and jobs that trap, fail and return holding a file.

registers Uart {
    data: u8 at 0x0 write
} Uart

registers Selector {
    key: u16 at 0x0 write
} Selector

registers Data {
    byte: u8 at 0x0 read
} Data

/// The fw_cfg key of the file directory, and the bytes of a file's name in it.
const DIRECTORY: u16 = 0x19

const NAME_BYTES: usize = 56

/// The public key of the seed of 32 bytes 7, with which the harness signs the bundles.
const SIGNER: Slice[u8] = b"\xEA\x4A\x6C\x63\xE2\x9C\x52\x0A\xBE\xF5\x50\x7B\x13\x2E\xC5\xF9\x95\x47\x76\xAE\xBE\xBE\x7B\x92\x42\x1E\xEA\x69\x14\x46\xD2\x2C"

/// The readings the averaging job takes and the summary it gives, as it declares them.
pub closed struct Readings derives Encode {
    pub values: mem::List[u32]
} Readings

pub closed struct Summary derives Encode {
    pub mean_milli: u64
    pub lanes: u64
    pub entropy: u64
} Summary

/// The serial port serving a job's log and standard streams, its record counting the bytes of
/// standard input it has given.
struct Console {
} Console

impl Console: sys::Kind[core::atomic::AtomicU64, u64]

impl Console: sys::LogService

impl Console: sys::StdioService

/// A random source serving the bytes of a counter.
struct Counter {
} Counter

impl Counter: sys::Kind[core::atomic::AtomicU64, u64]

impl Counter: sys::RandomService

fn Console.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
    match level {
        sys::LogLevel.Info => say(text: "log info ")
        sys::LogLevel.Warn => say(text: "log warn ")
        sys::LogLevel.Error => say(text: "log error ")
    }
    say(text: message)
    say(text: ": ")
    say(text: value)
    say(text: "\n")
} Console.log

fn Console.read_in(self, mut buf: SliceMut[u8]) -> usize fails sys::StdioError limits stack 4_096 {
    let input = b"from the kernel"
    let given = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(input.len())))
    let Some(Some(start)) = given else {
        fail sys::StdioError.Closed
    }
    if start > 0 {
        return 0
    }
    var count: usize = 0
    while count < buf.len() and count < input.len() {
        buf[count] = input[count]
        count += 1
    }
    return count
} Console.read_in

fn Console.write_out(self, data: Slice[u8]) limits stack 4_096 {
    say(text: "out ")
    say_bytes(data)
} Console.write_out

fn Console.write_err(self, data: Slice[u8]) limits stack 4_096 {
    say(text: "err ")
    say_bytes(data)
} Console.write_err

/// A store directory serving a job's files on the serial port, each file numbered by the length
/// of its path.
struct Store {
} Store

impl Store: sys::Kind[core::atomic::AtomicU64, u64]

impl Store: sys::FsService

/// An egress gate serving a job's connections on the serial port, each connection numbered by
/// the length of its host.
struct Egress {
} Egress

impl Egress: sys::Kind[core::atomic::AtomicU64, u64]

impl Egress: sys::NetService

fn Store.open(self, path: Str) -> u64 limits stack 4_096 {
    say_line(text: "fs open ", detail: path)
    return u64.widen(path.byte_len())
} Store.open

fn Store.create(self, path: Str) -> u64 limits stack 4_096 {
    say_line(text: "fs create ", detail: path)
    return u64.widen(path.byte_len())
} Store.create

fn Store.read_all(self, path: Str, alloc: mem::Alloc) -> mem::Bytes limits stack 4_096 {
    say_line(text: "fs read_all ", detail: path)
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(b"2 4 9")
    return bytes
} Store.read_all

fn Store.write_all(self, path: Str, data: Slice[u8]) limits stack 4_096 {
    say(text: "fs write_all ")
    say(text: path)
    say(text: ": ")
    say_bytes(data)
    say(text: "\n")
} Store.write_all

fn Store.remove(self, path: Str) fails sys::fs::FsError limits stack 4_096 {
    fail sys::fs::FsError.NotFound
} Store.remove

fn Store.read(self, file: u64, mut buf: SliceMut[u8]) -> usize limits stack 4_096 {
    return 0
} Store.read

fn Store.write(self, file: u64, data: Slice[u8]) -> usize limits stack 4_096 {
    say_numbered(text: "fs write ", number: file, data)
    return data.len()
} Store.write

fn Store.byte_len(self, file: u64) -> u64 limits stack 4_096 {
    return file
} Store.byte_len

fn Store.release(self, file: u64) limits stack 4_096 {
    say_numbered(text: "fs release ", number: file, data: b"")
} Store.release

fn Egress.listen(self, port: u16) -> u64 fails sys::net::NetError limits stack 4_096 {
    fail sys::net::NetError.Denied
} Egress.listen

fn Egress.connect(self, host: Str, port: u16) -> u64 limits stack 4_096 {
    say_line(text: "net connect ", detail: host)
    return u64.widen(host.byte_len())
} Egress.connect

fn Egress.accept(self, listener: u64) -> u64 fails sys::net::NetError limits stack 4_096 {
    fail sys::net::NetError.Denied
} Egress.accept

fn Egress.read(self, conn: u64, mut buf: SliceMut[u8]) -> usize limits stack 4_096 {
    return 0
} Egress.read

fn Egress.write(self, conn: u64, data: Slice[u8]) -> usize limits stack 4_096 {
    say_numbered(text: "net write ", number: conn, data)
    return data.len()
} Egress.write

fn Egress.close(self, conn: u64) limits stack 4_096 {
    say_numbered(text: "net close ", number: conn, data: b"")
} Egress.close

fn Egress.reset(self, conn: u64) limits stack 4_096 {
    say_numbered(text: "net reset ", number: conn, data: b"")
} Egress.reset

fn Egress.release(self, listener: u64) limits stack 4_096 {
} Egress.release

fn Counter.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
    let given = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(buf.len())))
    let start = given.value_or(None).value_or(0)
    for index in 0..<buf.len() {
        buf[index] = u8.truncate(start + u64.widen(index))
    }
} Counter.fill

fn say(text: Str) {
    say_bytes(text.as_bytes())
} say

fn say_bytes(bytes: Slice[u8]) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in bytes {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say_bytes

fn say_line(text: Str, detail: Str) {
    say(text)
    say(text: detail)
    say(text: "\n")
} say_line

/// A line of `text`, `number` and, when there are any, `data`'s bytes.
fn say_numbered(text: Str, number: u64, data: Slice[u8]) {
    say(text)
    say_number(number)
    if data.len() > 0 {
        say(text: ": ")
        say_bytes(data)
    }
    say(text: "\n")
} say_numbered

fn say_number(value: u64) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var left = value
    loop {
        digits[count] = b'0' + u8.truncate(left % 10)
        count += 1
        left = left / 10
        if left == 0 {
            break
        }
    }
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    while count > 0 {
        count -= 1
        mut uart.write(Uart.data, value: digits[count])
    }
    take uart.unmap()
} say_number

/// Reads a big-endian number of `count` bytes from the fw_cfg data port.
fn read_be(mut data: hw::Ports[Data], count: u32) -> u64 {
    var value: u64 = 0
    for _ in 0..<count {
        value = (value << 8) | u64.widen(mut data.read(Data.byte))
    }
    return value
} read_be

/// The fw_cfg file of a name: its key and size, a zero key when there is none.
struct Found derives Copy {
    key: u16
    size: u64
} Found

fn find_file(mut data: hw::Ports[Data], name: Str) -> Found {
    var found = Found(key: 0, size: 0)
    for _ in 0..<read_be(mut data, count: 4) {
        let size = read_be(mut data, count: 4)
        let key = u16.truncate(read_be(mut data, count: 2))
        discard read_be(mut data, count: 2)
        var same = true
        for index in 0..<NAME_BYTES {
            let byte = mut data.read(Data.byte)
            var wanted: u8 = 0
            if index < name.as_bytes().len() {
                wanted = name.as_bytes()[index]
            }
            same = same and byte == wanted
        }
        if same {
            found = Found(key: key, size: size)
        }
    }
    return found
} find_file

/// The bytes of the fw_cfg file of a name, empty when there is none.
fn fw_file(name: Str, alloc: mem::Alloc) -> mem::Bytes {
    var selector = trusted "the board decodes port 0x510 to the fw_cfg selector" { hw::Ports[Selector].map(0x510) }
    var data = trusted "the board decodes port 0x511 to the fw_cfg data port" { hw::Ports[Data].map(0x511) }
    mut selector.write(Selector.key, value: DIRECTORY)
    let found = find_file(mut data, name)
    var bytes = mem::Bytes.empty(alloc)
    if found.key != 0 {
        mut selector.write(Selector.key, value: found.key)
        for _ in 0..<found.size {
            mut bytes.push(mut data.read(Data.byte))
        }
    }
    take selector.unmap()
    take data.unmap()
    return bytes
} fw_file

fn stop(text: Str) -> Never {
    say(text)
    loop {
    }
} stop

/// The bundle of a fw_cfg file, its signature checked when `verified`, loaded.
fn loaded(loader: sys::load::Loader, name: Str, verified: bool, alloc: mem::Alloc) -> sys::load::Bundle {
    let bytes = fw_file(name, alloc)
    let ready = prepared(loader, bytes: bytes.view(), verified, alloc)
    let Ok(bundle) = attempt take ready.load() else {
        stop(text: "unloadable\n")
    }
    return bundle
} loaded

/// What the kernel gives every job.
struct Grants derives Copy {
    clock: sys::Clock
    wall: Option[sys::WallClock]
    console: Console
    counter: Counter
    store: Store
    egress: Egress
    exec: task::Executor
    alloc: mem::Alloc
} Grants

/// The world of a job: its log, standard streams and random source served, its file system
/// served under `jobs`, its network served only towards 10.0.0.2, and the wall clock in its
/// table.
fn granted(grants: Grants) -> nanos::World {
    var caps = nanos::Caps.empty(grants.alloc)
    match grants.wall {
        Some(wall) => mut nanos::Cap[sys::WallClock].put(mut caps, key: "wall", capability: wall)
        None => {}
    }
    let Ok(log) = attempt sys::Log.served(grants.console) else {
        stop(text: "no log\n")
    }
    let Ok(stdio) = attempt sys::Stdio.served(grants.console) else {
        stop(text: "no stdio\n")
    }
    let Ok(random) = attempt sys::Random.served(grants.counter) else {
        stop(text: "no random\n")
    }
    let Ok(store) = attempt sys::Fs.served(grants.store) else {
        stop(text: "no store\n")
    }
    let Ok(fs) = attempt store.subdir("jobs") else {
        stop(text: "no jobs directory\n")
    }
    let Ok(egress) = attempt sys::Net.served(grants.egress) else {
        stop(text: "no egress\n")
    }
    let Ok(net) = attempt egress.only_host("10.0.0.2") else {
        stop(text: "no host\n")
    }
    return nanos::World(alloc: grants.alloc, exec: grants.exec, clock: grants.clock, random: random, log: log, stdio: stdio, fs: fs, net: net, caps: take caps)
} granted

/// Loads the bundle of a fw_cfg file, runs its job on each input and unloads it, writing a line
/// naming how each run ended, and gives what each run returned, empty for a run returning
/// nothing.
fn ran(loader: sys::load::Loader, name: Str, file: Str, verified: bool, grants: Grants, take inputs: mem::List[mem::Bytes]) -> mem::List[mem::Bytes] fails task::Cancelled uses wait {
    var left = inputs
    var results = mem::List[mem::Bytes].empty(grants.alloc)
    var stopped: Option[task::Cancelled] = None
    let bundle = loaded(loader, name: file, verified, alloc: grants.alloc)
    while left.len() > 0 {
        let input = mut left.remove(0)
        let outcome = attempt await nanos::run(bundle, world: granted(grants), take input, exec: grants.exec, alloc: grants.alloc)
        say(text: name)
        var returned = mem::Bytes.empty(grants.alloc)
        match outcome {
            Ok(nanos::Ended.Returned(bytes)) => {
                say(text: " returned\n")
                returned = bytes
            }
            Ok(nanos::Ended.Failed(rendered)) => {
                say(text: " failed ")
                say(text: rendered.as_str())
                say(text: "\n")
            }
            Ok(nanos::Ended.Trapped(trap)) => {
                match trap.kind() {
                    sys::TrapKind.DivisionByZero => say(text: " trapped trap.division-by-zero\n")
                    else => say(text: " trapped otherwise\n")
                }
            }
            Ok(nanos::Ended.Undecodable) => say(text: " undecodable\n")
            Err(nanos::RunError.NoJob) => say(text: " has no job\n")
            Err(nanos::RunError.Cancelled(cancelled)) => {
                stopped = Some(take cancelled)
                break
            }
        }
        mut results.push(take returned)
    }
    take bundle.unload()
    match stopped {
        Some(cancelled) => fail cancelled
        None => return results
    }
} ran

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    let clock = k.clock()
    let wall = k.wall_clock()
    let Some(loader) = k.loader() else {
        stop(text: "no loader\n")
    }
    take k.anchor(0u8, run: fn[take loader](exec: task::Executor) fails task::Cancelled uses wait limits stack 262_144 {
        let consoles = sys::Minter[Console, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let counters = sys::Minter[Counter, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let stores = sys::Minter[Store, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let gates = sys::Minter[Egress, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let grants = Grants(clock: clock, wall: wall, console: consoles.mint(0), counter: counters.mint(0), store: stores.mint(0), egress: gates.mint(0), exec: exec, alloc: alloc)
        let served = attempt await serve(loader, grants)
        take consoles.close()
        take counters.close()
        take stores.close()
        take gates.close()
        discard served
    })
} main

fn serve(loader: sys::load::Loader, grants: Grants) fails task::Cancelled uses wait {
    var values = mem::List[u32].empty(grants.alloc)
    mut values.push(2)
    mut values.push(4)
    mut values.push(9)
    var averaged = mem::List[mem::Bytes].empty(grants.alloc)
    mut averaged.push(encoded(Readings(values: take values), alloc: grants.alloc))
    var garbage = mem::Bytes.empty(grants.alloc)
    mut garbage.push(0xFF)
    mut averaged.push(take garbage)
    let summaries = try await ran(loader, name: "average", file: "opt/nan/average", verified: true, grants, inputs: take averaged)
    match attempt mem::wire::Codec[Summary].decode(Untrusted.of(summaries[0].view()), alloc: grants.alloc) {
        Ok(summary) => {
            say(text: "mean ")
            say_number(summary.mean_milli)
            say(text: " lanes ")
            say_number(summary.lanes)
            say(text: " entropy ")
            say_number(summary.entropy)
            say(text: "\n")
        }
        Err(_) => say(text: "summary undecodable\n")
    }
    var args = mem::List[mem::Bytes].empty(grants.alloc)
    var arg = mem::Bytes.empty(grants.alloc)
    for byte in b"kernel" {
        mut arg.push(byte)
    }
    mut args.push(take arg)
    let host = nanos::HostInput(args: take args, environment: mem::Map[mem::Bytes, mem::Bytes].empty(grants.alloc))
    var greeted = mem::List[mem::Bytes].empty(grants.alloc)
    mut greeted.push(encoded(host, alloc: grants.alloc))
    let statuses = try await ran(loader, name: "greet", file: "opt/nan/greet", verified: false, grants, inputs: take greeted)
    say(text: "status ")
    say_number(u64.widen(statuses[0][0]))
    say(text: "\n")
    var divisors = mem::List[mem::Bytes].empty(grants.alloc)
    mut divisors.push(encoded(0u32, alloc: grants.alloc))
    mut divisors.push(encoded(1u32, alloc: grants.alloc))
    mut divisors.push(encoded(4u32, alloc: grants.alloc))
    let quotients = try await ran(loader, name: "crash", file: "opt/nan/crash", verified: false, grants, inputs: take divisors)
    say(text: "quotient ")
    say_number(u64.widen(quotients[2][0]))
    say(text: "\n")
} serve

fn encoded[T: Encode](value: T, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return bytes
} encoded

fn bundle_key() -> core::crypto::PublicKey {
    var bytes = Array[u8, 32].filled(0)
    mut bytes.view_mut().copy_from(SIGNER)
    return core::crypto::PublicKey(bytes: bytes)
} bundle_key

/// The prepared bundle of `bytes`, verified with the signer's key when `verified`, and otherwise
/// trusted as the harness builds each bundle against this kernel's interface.
fn prepared(loader: sys::load::Loader, bytes: Slice[u8], verified: bool, alloc: mem::Alloc) -> sys::load::Prepared {
    let keys = Array[core::crypto::PublicKey, 1].filled(bundle_key())
    let outcome = match verified {
        true => attempt loader.prepare(bytes, keys: keys.view(), alloc)
        false => trusted "the harness builds each bundle against this kernel's interface" { attempt loader.prepare_unverified(bytes, alloc) }
    }
    let Ok(ready) = outcome else {
        stop(text: "unverified\n")
    }
    return ready
} prepared
