    \\pub fn Mask64x2.bit_xor(self, other: Mask64x2) -> Mask64x2 limits pure, notrap, terminates
    \\    example U64x2.splat(1).lanes_eq(U64x2.splat(1)).bit_xor(U64x2.splat(1).lanes_eq(U64x2.splat(2))).any()
    \\{
    \\    var lanes = self.lanes
    \\    for index in 0..<2usize {
    \\        lanes[index] = lanes[index] ^ other.lanes[index]
    \\    }
    \\    return Mask64x2(lanes: lanes)
    \\} Mask64x2.bit_xor
    \\
    \\pub fn Mask64x2.bit_not(self) -> Mask64x2 limits pure, notrap, terminates
    \\    example U64x2.splat(1).lanes_eq(U64x2.splat(2)).bit_not().all()
    \\{
    \\    var lanes = self.lanes
    \\    for index in 0..<2usize {
    \\        lanes[index] = ~lanes[index]
    \\    }
    \\    return Mask64x2(lanes: lanes)
    \\} Mask64x2.bit_not
    \\
    \\pub fn Mask64x2.any(self) -> bool limits pure, notrap, terminates
    \\    example U64x2.splat(1).replace_lane(1, value: 2).lanes_eq(U64x2.splat(2)).any()
    \\{
    \\    for index in 0..<2usize {
    \\        if self.lanes[index] != 0 {
    \\            return true
    \\        }
    \\    }
    \\    return false
    \\} Mask64x2.any
    \\
    \\pub fn Mask64x2.all(self) -> bool limits pure, notrap, terminates
    \\    example not U64x2.splat(1).replace_lane(1, value: 2).lanes_eq(U64x2.splat(2)).all()
    \\{
    \\    for index in 0..<2usize {
    \\        if self.lanes[index] == 0 {
    \\            return false
    \\        }
    \\    }
    \\    return true
    \\} Mask64x2.all
    \\
    \\pub fn Mask64x2.bitmask(self) -> u16 limits pure, notrap, terminates
    \\    example U64x2.splat(1).replace_lane(1, value: 2).lanes_eq(U64x2.splat(2)).bitmask() == 0b10
    \\{
    \\    var bits = 0u16
    \\    for index in 0..<2u32 {
    \\        if (self.lanes[usize.widen(index)] >> 63) == 1 {
    \\            bits = bits | (1u16 << index)
    \\        }
    \\    }
    \\    return bits
    \\} Mask64x2.bitmask
