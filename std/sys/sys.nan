test served_clocks_call_their_kind for Clock.served {
    let world = testing::world()
    let minter = tallies(0, alloc: world.alloc)
    let counter = minter.mint(0)
    let Ok(clock) = attempt Clock.served(minter.mint(0)) else {
        take minter.close()
        expect false
        return
    }
    let elapsed = attempt clock.elapsed_ns()
    let ms = attempt clock.elapsed_ms()
    let Ok(coarse) = attempt clock.coarse(1_000_000) else {
        take minter.close()
        expect false
        return
    }
    let coarse_elapsed = attempt coarse.elapsed_ns()
    let slept_ms = attempt await clock.sleep(3)
    let slept_ns = attempt await clock.sleep_ns(5)
    let slept = reach(counter, body: tally_count)
    take minter.close()
    let revoked = attempt clock.elapsed_ns()
    expect elapsed == Ok(1_234_567_891) and ms == Ok(1_234) and coarse_elapsed == Ok(1_234_000_000)
    expect slept_ms.is_ok() and slept_ns.is_ok() and slept == Some(3_000_005) and revoked == Err(Revoked.Stale)
} served_clocks_call_their_kind

test served_wall_clocks_call_their_kind for WallClock.served {
    let world = testing::world()
    let minter = tallies(0, alloc: world.alloc)
    let Ok(wall) = attempt WallClock.served(minter.mint(0)) else {
        take minter.close()
        expect false
        return
    }
    let now = attempt wall.now_ns()
    let Ok(coarse) = attempt wall.coarse(1_000) else {
        take minter.close()
        expect false
        return
    }
    let coarse_now = attempt coarse.now_ns()
    take minter.close()
    let revoked = attempt wall.now_ns()
    expect now == Ok(1_700_000_000_123_456_789) and coarse_now == Ok(1_700_000_000_123_456_000) and revoked == Err(Revoked.Stale)
} served_wall_clocks_call_their_kind

