test runner_lent_resources_leave_their_kind_until_put for Runner.resource {
    let world = testing::world()
    let shelf = shelves(world.alloc)
    defer take shelf.close()
    let shelved = shelf.mint(0)
    let held = try await noted(shelved, alloc: world.alloc)
