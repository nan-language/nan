/// The keys a keyring is sent.
const KEYRING_KEYS: u64 = 300

struct Tally {
} Tally

impl Tally: Kind[core::atomic::AtomicU64, u64]

fn tallies(start: u64, alloc: mem::Alloc) -> Minter[Tally, core::atomic::AtomicU64, u64] {
    return Minter.of(core::atomic::AtomicU64.of(start), alloc)
} tallies

fn tally_record(state: core::atomic::AtomicU64, record: u64) -> u64 = record

impl Tally: LogService

impl Tally: RandomService

impl Tally: StdioService

impl Tally: ClockService

impl Tally: WallClockService

/// Counts the bytes of a value logged through a tally.
fn Tally.log(self, level: LogLevel, message: Str, value: Str) limits stack 4_096 {
    discard reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(value.byte_len())))
} Tally.log

fn Tally.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
    for index in 0..<buf.len() {
        buf[index] = 7
    }
} Tally.fill

fn Tally.read_in(self, mut buf: SliceMut[u8]) -> usize fails StdioError limits stack 4_096 {
    fail StdioError.Closed
} Tally.read_in

/// Counts the bytes written through a tally.
fn Tally.write_out(self, data: Slice[u8]) limits stack 4_096 {
    discard reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(data.len())))
} Tally.write_out

fn Tally.write_err(self, data: Slice[u8]) limits stack 4_096 {
    self.write_out(data)
} Tally.write_err

fn Tally.elapsed_ns(self) -> u64 limits stack 4_096 {
    return 1_234_567_891
} Tally.elapsed_ns

/// Counts the nanoseconds slept through a tally.
fn Tally.sleep_ns(self, ns: u64) limits stack 4_096 {
    discard reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(ns))
} Tally.sleep_ns

fn Tally.now_ns(self) -> u64 limits stack 4_096 {
    return 1_700_000_000_123_456_789
} Tally.now_ns

fn tally_count(state: core::atomic::AtomicU64, record: u64) -> u64 {
    discard state.fetch_add(record)
    return state.load()
} tally_count

/// Files named by the length of their path, whose releases a shelf counts.
struct Shelf {
} Shelf

impl Shelf: Kind[core::atomic::AtomicU64, u64]

impl Shelf: FsService

fn shelves(alloc: mem::Alloc) -> Minter[Shelf, core::atomic::AtomicU64, u64] {
    return Minter.of(core::atomic::AtomicU64.of(0), alloc)
} shelves

fn Shelf.open(self, path: Str) -> u64 limits stack 4_096 {
    return u64.widen(path.byte_len())
} Shelf.open

fn Shelf.create(self, path: Str) -> u64 limits stack 4_096 {
    return self.open(path)
} Shelf.create

/// The bytes of the path itself.
fn Shelf.read_all(self, path: Str, alloc: mem::Alloc) -> mem::Bytes limits stack 4_096 {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(path.as_bytes())
    return bytes
} Shelf.read_all

fn Shelf.write_all(self, path: Str, data: Slice[u8]) limits stack 4_096 {
} Shelf.write_all

fn Shelf.remove(self, path: Str) fails fs::FsError limits stack 4_096 {
    fail fs::FsError.NotFound
} Shelf.remove

/// Claims more bytes than `buf` holds.
fn Shelf.read(self, file: u64, mut buf: SliceMut[u8]) -> usize limits stack 4_096 {
    return 9
} Shelf.read

fn Shelf.write(self, file: u64, data: Slice[u8]) -> usize limits stack 4_096 {
    return data.len()
} Shelf.write

fn Shelf.byte_len(self, file: u64) -> u64 limits stack 4_096 {
    return file
} Shelf.byte_len

fn Shelf.release(self, file: u64) limits stack 4_096 {
    discard reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(1))
} Shelf.release

/// Connections named by the length of their host or by their port, a line counting every call.
struct Line {
} Line

impl Line: Kind[core::atomic::AtomicU64, u64]

impl Line: NetService

fn lines(alloc: mem::Alloc) -> Minter[Line, core::atomic::AtomicU64, u64] {
    return Minter.of(core::atomic::AtomicU64.of(0), alloc)
} lines

fn Line.counted(self) {
    discard reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(1))
} Line.counted

fn Line.listen(self, port: u16) -> u64 limits stack 4_096 {
    self.counted()
    return u64.widen(port)
} Line.listen

fn Line.connect(self, host: Str, port: u16) -> u64 limits stack 4_096 {
    self.counted()
    return u64.widen(host.byte_len())
} Line.connect

fn Line.accept(self, listener: u64) -> u64 limits stack 4_096 {
    self.counted()
    return listener
} Line.accept

fn Line.read(self, conn: u64, mut buf: SliceMut[u8]) -> usize limits stack 4_096 {
    self.counted()
    return 0
} Line.read

fn Line.write(self, conn: u64, data: Slice[u8]) -> usize limits stack 4_096 {
    self.counted()
    return data.len()
} Line.write

fn Line.close(self, conn: u64) limits stack 4_096 {
    self.counted()
} Line.close

fn Line.reset(self, conn: u64) limits stack 4_096 {
    self.counted()
} Line.reset

fn Line.release(self, listener: u64) limits stack 4_096 {
    self.counted()
} Line.release

/// A runner counting what reaches it: the port of each send, a thousand per number of a reply, a
/// hundred per byte of a summary, ten thousand per sync, a hundred thousand per number of a
/// dropped capability and a million per number of a resource put, answering each call with its
/// port, holding itself as each capability but the one numbered 0 and holding resources by number
/// until they are lent or taken.
struct Board {
} Board

impl Board: Kind[Boarded, u64]

impl Board: RunnerService

struct Boarded {
    count: core::atomic::AtomicU64
    held: task::Cown[mem::Map[u64, Held]]
} Boarded

fn Board.counted(self, amount: u64) {
    discard reach(self, body: fn(state: Boarded, record: u64) => state.count.fetch_add(amount))
} Board.counted

fn Board.send_to(self, port: u64, hash: ProtocolHash, bytes: Slice[u8], handles: Slice[Handle]) limits stack 4_096 {
    self.counted(port)
} Board.send_to

fn Board.call(self, port: u64, hash: ProtocolHash, bytes: Slice[u8], handles: Slice[Handle], alloc: mem::Alloc) -> Encoded limits stack 4_096 {
    var reply = Encoded.empty(alloc)
    let answer: Result[u64, Full] = Ok(port)
    mem::wire::Codec[Result[u64, Full]].encode(answer, out: mut reply.bytes)
    return reply
} Board.call

fn Board.reply(self, request: u64, bytes: Slice[u8], handles: Slice[Handle]) limits stack 4_096 {
    self.counted(request * 1_000)
} Board.reply

fn Board.publish(self, summary: Slice[u8]) limits stack 4_096 {
    self.counted(u64.widen(summary.len()) * 100)
} Board.publish

fn Board.sync(self) limits stack 4_096 {
    self.counted(10_000)
} Board.sync

fn Board.capability(self, id: u64) -> Handle fails RunnerError limits stack 4_096 {
    if id == 0 {
        fail RunnerError.Unknown
    }
    return Handle.of(self)
} Board.capability

fn Board.drop_capability(self, id: u64) limits stack 4_096 {
    self.counted(id * 100_000)
} Board.drop_capability

fn Board.resource(self, id: u64) -> Held fails RunnerError uses wait limits stack 8_192 {
    return try await self.removed(id)
} Board.resource

fn Board.take_resource(self, id: u64) -> Held fails RunnerError uses wait limits stack 8_192 {
    return try await self.removed(id)
} Board.take_resource

fn Board.put_resource(self, id: u64, take resource: Held) fails RunnerError uses wait limits stack 8_192 {
    self.counted(id * 1_000_000)
    let Some(held) = reach(self, body: fn(state: Boarded, record: u64) => state.held.share()) else {
        return
    }
    await when mut held {
        discard mut held.insert(id, value: take resource)
    }
} Board.put_resource

/// The resource the board holds under `id`, which it no longer holds.
fn Board.removed(self, id: u64) -> Held fails RunnerError uses wait {
    let Some(held) = reach(self, body: fn(state: Boarded, record: u64) => state.held.share()) else {
        fail RunnerError.Unknown
    }
    let Some(resource) = await when mut held => mut held.remove(id) else {
        fail RunnerError.Unknown
    }
    return resource
} Board.removed

/// Boards holding `held` as their resources.
fn boards(take held: mem::Map[u64, Held], alloc: mem::Alloc) -> Minter[Board, Boarded, u64] {
    return Minter.of(Boarded(count: core::atomic::AtomicU64.of(0), held: task::Cown.of(take held, alloc)), alloc)
} boards

fn board_count(state: Boarded, record: u64) -> u64 {
    return state.count.load()
} board_count

/// What a relayer asks of its runner.
protocol Relay {
    pub fn send(port: u64) limits traceless
    pub fn answer(request: u64) limits traceless
    pub fn publish() limits traceless
    pub fn sync() limits traceless
    pub fn ask(port: u64) limits traceless
    pub fn hold(id: u64, typed: bool) limits traceless
    pub fn release(id: u64) limits traceless
    pub fn borrow(id: u64, typed: bool) limits traceless
    pub fn claim(id: u64) limits traceless
    fn answered(total: u64) limits traceless
    fn refuse() limits traceless
} Relay

struct RelayEnv {
    alloc: mem::Alloc
} RelayEnv

/// A component acting through its runner, counting the operations its runner refused and keeping
/// the last total a call through a port answered.
struct Relayer derives Encode {
    refused: u64
    total: u64
} Relayer

impl Relayer: Component[RelayEnv, Relay]

fn Relayer.start(mut env: RelayEnv) -> Relayer = Relayer(refused: 0, total: 0)

fn Relayer.send(mut self, take port: u64, mut env: RelayEnv, mut cx: Cx[Relay]) {
    var call = Encoded.empty(env.alloc)
    Wire[Meter].clear(mut call)
    let meter = Port[Meter].of(cx, id: port)
    mut self.counted(attempt mut cx.send_to(meter, call))
} Relayer.send

fn Relayer.answer(mut self, take request: u64, mut env: RelayEnv, mut cx: Cx[Relay]) {
    mut self.counted(attempt mut cx.reply(request, reply: Encoded.empty(env.alloc)))
} Relayer.answer

fn Relayer.publish(mut self, mut env: RelayEnv, mut cx: Cx[Relay]) {
    mut self.counted(attempt mut cx.publish(b"ab"))
} Relayer.publish

fn Relayer.sync(mut self, mut env: RelayEnv, mut cx: Cx[Relay]) {
    mut self.counted(attempt mut cx.sync())
} Relayer.sync

fn Relayer.ask(mut self, take port: u64, mut env: RelayEnv, mut cx: Cx[Relay]) {
    let meter = Port[Meter].of(cx, id: port)
    let alloc = env.alloc
    mut cx.spawn(key: 1, run: fn(out: Outbox[Relay]) fails task::Cancelled uses wait {
        var call = Encoded.empty(alloc)
        let added = Wire[Meter].add(mut call, amount: 1)
        let Ok(total) = attempt await meter.call(added, call, alloc) else {
            return
        }
        discard attempt await out.answered(total)
    })
} Relayer.ask

/// Takes the capability numbered `id` as a board when `typed`, as a clock otherwise, counting 7
/// through a board it takes.
fn Relayer.hold(mut self, take id: u64, take typed: bool, mut env: RelayEnv, mut cx: Cx[Relay]) {
    if typed {
        let Ok(board) = attempt mut cx.capability(CapabilityId[Board](id: id)) else {
            self.refused += 1
            return
        }
        board.counted(7)
        return
    }
    let Ok(_) = attempt mut cx.capability(CapabilityId[Clock](id: id)) else {
        self.refused += 1
        return
    }
} Relayer.hold

fn Relayer.release(mut self, take id: u64, mut env: RelayEnv, mut cx: Cx[Relay]) {
    mut self.counted(attempt mut cx.drop_capability(CapabilityId[Board](id: id)))
} Relayer.release

/// Borrows the resource numbered `id` as a file when `typed`, as a listener otherwise, answering
/// with a file's length once it puts it back.
fn Relayer.borrow(mut self, take id: u64, take typed: bool, mut env: RelayEnv, mut cx: Cx[Relay]) {
    let resources = Resources.of(cx)
    mut cx.spawn(key: 1, run: fn(out: Outbox[Relay]) fails task::Cancelled uses wait {
        if not typed {
            let Ok(listener) = attempt await resources.resource(ResourceId[net::Listener](id: id)) else {
                discard attempt await out.refuse()
                return
            }
            discard attempt await resources.put_resource(ResourceId[net::Listener](id: id), resource: take listener)
            return
        }
        let Ok(file) = attempt await resources.resource(ResourceId[fs::File](id: id)) else {
            discard attempt await out.refuse()
            return
        }
        let len = match attempt await file.byte_len() {
            Ok(len) => len
            Err(_) => 0
        }
        discard attempt await resources.put_resource(ResourceId[fs::File](id: id), resource: take file)
        discard attempt await out.answered(len)
    })
} Relayer.borrow

/// Takes the file numbered `id`, answering with its length before dropping it.
fn Relayer.claim(mut self, take id: u64, mut env: RelayEnv, mut cx: Cx[Relay]) {
    let resources = Resources.of(cx)
    mut cx.spawn(key: 1, run: fn(out: Outbox[Relay]) fails task::Cancelled uses wait {
        let Ok(file) = attempt await resources.take_resource(ResourceId[fs::File](id: id)) else {
            discard attempt await out.refuse()
            return
        }
        let len = match attempt await file.byte_len() {
            Ok(len) => len
            Err(_) => 0
        }
        discard attempt await out.answered(len)
    })
} Relayer.claim

fn Relayer.answered(mut self, take total: u64, mut env: RelayEnv, mut cx: Cx[Relay]) {
    self.total = total
} Relayer.answered

fn Relayer.refuse(mut self, mut env: RelayEnv, mut cx: Cx[Relay]) {
    self.refused += 1
} Relayer.refuse

fn Relayer.counted(mut self, outcome: Result[Unit, RunnerError]) {
    if outcome.is_err() {
        self.refused += 1
    }
} Relayer.counted

/// The count a board reaches, or the refusals of a relayer whose runner it does not serve, once a
/// relayer handles `message` and its keyed tasks end, the relayer's last state and the releases of
/// the file of length 4 the board holds as resource 1.
struct Relayed {
    count: u64
    last: Relayer
    released: u64
} Relayed

fn relayed(world: host::World, take message: Relay, attached: bool) -> Relayed fails task::Cancelled uses wait {
    let shelf = shelves(world.alloc)
    defer take shelf.close()
    let shelved = shelf.mint(0)
    let held = try await noted(shelved, alloc: world.alloc)
    let minter = boards(take held, alloc: world.alloc)
    defer take minter.close()
    let counter = minter.mint(0)
    var stepper = try Stepper[Relayer, RelayEnv, Relay].start(RelayEnv(alloc: world.alloc), exec: world.exec, alloc: world.alloc)
    defer take stepper.abandon()
    if attached {
        let Ok(runner) = attempt Runner.served(minter.mint(0)) else {
            return Relayed(count: 0, last: Relayer(refused: 0, total: 0), released: 0)
        }
        mut stepper.attach(runner)
    }
    mut stepper.deliver(take message)
    discard mut stepper.start_keyed()
    while try await stepper.ready() {
        discard mut stepper.step()
    }
    undefer stepper
    let Stopped(state: last, env: _) = try await take stepper.end()
    let count = reach(counter, body: board_count).value_or(0)
    let released = reach(shelved, body: tally_count).value_or(0)
    return Relayed(count: count, last: take last, released: released)
} relayed

/// Resources holding the file "note" a shelf serves as resource 1.
fn noted(shelf: Shelf, alloc: mem::Alloc) -> mem::Map[u64, Held] fails task::Cancelled uses wait {
    var held = mem::Map[u64, Held].empty(alloc)
    let Ok(fs) = attempt Fs.served(shelf) else {
        return held
    }
    let Ok(file) = attempt await fs.open("note") else {
        return held
    }
    discard mut held.insert(1, value: take file.held())
    return held
} noted

fn Probe.start(mut env: ProbeEnv) -> Probe = Probe(handled: 0, suspended: false)

/// The header the tests of headers mark messages with.
fn marked() -> Header = Header(bytes: Array[u8, 32].filled(7))

fn Traced.start(mut env: TracedEnv) -> Traced = Traced(marked: 0)

fn Traced.on(mut self, take message: Trace, mut env: TracedEnv, mut cx: Cx[Trace]) {
    if current_header() == Some(marked()) {
        self.marked += 1
    }
    match message {
        Trace.Begin => {
            mut cx.send(Trace.Sent)
            mut cx.spawn(key: 1, run: fn(out: Outbox[Trace]) fails task::Cancelled uses wait {
                discard attempt await out.post(Trace.Posted)
            })
        }
        Trace.Sent or Trace.Posted => {}
    }
} Traced.on

fn Probe.on(mut self, take message: ProbeMessage, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) {
    match message {
        ProbeMessage.Count => {
            self.handled += 1
            env.counted += 1
        }
        ProbeMessage.Echo => mut cx.send(ProbeMessage.Count)
        ProbeMessage.Delay => mut cx.after(ms: 10, send: ProbeMessage.Count)
        ProbeMessage.DelayNs => mut cx.after_ns(ns: 1_500, send: ProbeMessage.Count)
        ProbeMessage.Spawn(ms) => {
            let clock = env.clock
            mut cx.spawn(key: 1, run: fn(out: Outbox[ProbeMessage]) fails task::Cancelled uses wait {
                try await clock.sleep(ms)
                discard attempt await out.post(ProbeMessage.Count)
            })
        }
        ProbeMessage.Stop => mut cx.cancel(key: 1)
    }
} Probe.on

fn Probe.resume(mut self, reason: ResumeReason, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) {
    if reason == ResumeReason.Restored {
        mut cx.send(ProbeMessage.Count)
    }
} Probe.resume

fn Probe.pressure(mut self, level: u8, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) {
    env.counted += u64.widen(level)
} Probe.pressure

fn Probe.health(mut self, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) -> HealthReply {
    if self.suspended {
        return HealthReply.Unhealthy(text::Fixed[256].of("suspended"))
    }
    return HealthReply.Healthy
} Probe.health

fn Probe.suspend(mut self, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) {
    self.suspended = true
} Probe.suspend

fn Probe.wake(mut self, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) {
    self.suspended = false
} Probe.wake

fn Plain.start(mut env: ProbeEnv) -> Plain = Plain()

fn Linger.start(mut env: Lingered) -> Linger = Linger()

fn Linger.on(mut self, take message: ProbeMessage, mut env: Lingered, mut cx: Cx[ProbeMessage]) {
    let clock = env.clock
    let ended = env.ended.share()
    mut cx.spawn(key: 1, run: fn[take ended](out: Outbox[ProbeMessage]) fails task::Cancelled uses wait {
        let slept = attempt await clock.sleep(1_000)
        discard ended.contents().fetch_add(1)
        discard slept
    })
} Linger.on

fn Keyring.start(mut env: ProbeEnv) -> Keyring = Keyring(posted: 0, keys: 0)

fn Keyring.on(mut self, take message: KeyringMessage, mut env: ProbeEnv, mut cx: Cx[KeyringMessage]) {
    match message {
        KeyringMessage.Spawn(key) => {
            let clock = env.clock
            mut cx.spawn(key: key, run: fn(out: Outbox[KeyringMessage]) fails task::Cancelled uses wait {
                try await clock.sleep(100)
                discard attempt await out.post(KeyringMessage.Posted(key))
            })
        }
        KeyringMessage.Cancel(key) => mut cx.cancel(key: key)
        KeyringMessage.Posted(key) => {
            self.posted += 1
            self.keys += key
        }
    }
} Keyring.on

fn Plain.on(mut self, take message: ProbeMessage, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) {
    env.counted += 1
} Plain.on

test run_waits_for_the_keyed_tasks_an_abandoned_stepper_leaves for Domain.run {
    let world = testing::world()
    let clock = world.clock
    let exec = world.exec
    let alloc = world.alloc
    let ended = mem::Shared.of(core::atomic::AtomicU64.of(0), alloc)
    let given = ended.share()
    let outcome = try await Domain.run(fn[take given]() fails task::Cancelled {
        var stepper = try Stepper[Linger, Lingered, ProbeMessage].start(Lingered(clock: clock, ended: take given), exec, alloc)
        mut stepper.deliver(ProbeMessage.Count)
        discard mut stepper.step()
        discard mut stepper.start_keyed()
        take stepper.abandon()
    }, exec, alloc)
    let count = ended.contents().load()
    expect outcome.is_ok() and count == 1
} run_waits_for_the_keyed_tasks_an_abandoned_stepper_leaves

test trap_stays_inside_its_domain for Domain.run {
    let world = testing::world()
    let divisor: u32 = 0
    let outcome = try await Domain.run(fn() -> u32 {
        return 10 / divisor
    }, exec: world.exec, alloc: world.alloc)
    expect outcome.is_err()
} trap_stays_inside_its_domain

test sized_stack_holds_a_large_frame for Domain.run_sized {
    let world = testing::world()
    let outcome = try await Domain.run_sized(fn() -> u8 {
        let block = Array[u8, 200_000].filled(7)
        return block[199_999]
    }, stack: 1_048_576, exec: world.exec, alloc: world.alloc)
    let Ok(last) = outcome else {
        expect false
        return
    }
    expect last == 7
} sized_stack_holds_a_large_frame

test trap_renders_its_report for Trap.render {
    let world = testing::world()
    let divisor: u32 = 0
    let outcome = try await Domain.run(fn() -> u32 {
        return 10 / divisor
    }, exec: world.exec, alloc: world.alloc)
    let Err(trap) = outcome else {
        return
    }
    var report = text::String.empty(world.alloc)
    mut report.write(text::fmt("{trap}", trap), budget: 1_024)
    expect report.starts_with("trap.division-by-zero at ")
} trap_renders_its_report

test trap_names_its_kind for Trap.kind {
    let world = testing::world()
    let divisor: u32 = 0
    let outcome = try await Domain.run(fn() -> u32 {
        return 10 / divisor
    }, exec: world.exec, alloc: world.alloc)
    let Err(trap) = outcome else {
        return
    }
    let kind = trap.kind()
    expect kind == TrapKind.DivisionByZero
} trap_names_its_kind

test trigger_abandons_the_running_domain for Abandoner.trigger {
    let world = testing::world()
    let clock = world.clock
    let abandoner = mem::Shared.of(Abandoner.new(), alloc: world.alloc)
    var kind: Option[TrapKind] = None
    try await task::scope(world.exec, body: fn[mut kind](s: task::Scope) fails task::Cancelled uses wait {
        let watch = abandoner.share()
        discard s.spawn(fn[take watch]() fails task::Cancelled uses wait {
            try await clock.sleep(10)
            watch.contents().trigger()
        })
        let outcome = try await abandoner.contents().run(fn() fails task::Cancelled uses wait {
            loop {
                try await clock.sleep(1)
            }
        }, exec: world.exec, alloc: world.alloc)
        let Err(trap) = outcome else {
            return
        }
        kind = Some(trap.kind())
    })
    expect kind == Some(TrapKind.Abandoned)
} trigger_abandons_the_running_domain

test triggered_abandoner_runs_nothing for Abandoner.run {
    let world = testing::world()
    let abandoner = Abandoner.new()
    abandoner.trigger()
    let outcome = try await abandoner.run(fn() -> u32 {
        return 1
    }, exec: world.exec, alloc: world.alloc)
    let Err(trap) = outcome else {
        expect false
        return
    }
    expect trap.kind() == TrapKind.Abandoned
} triggered_abandoner_runs_nothing

test new_abandoner_runs_its_body for Abandoner.new {
