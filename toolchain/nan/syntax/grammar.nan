        Punct.Ge => 39
        Punct.DotDotLt => 40
        Punct.DotDotEq => 41
    }
} Punct.index

fn Punct.from_index(index: usize) -> Option[Punct] {
    return match index {
        0 => Some(Punct.LParen)
        1 => Some(Punct.RParen)
