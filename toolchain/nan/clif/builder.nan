} Builder.iconcat

pkg fn Builder.isplit(mut self, x: Value) -> Halves {
    let ty = self.value_type(x)
    let low = mut self.unary(Opcode.Isplit, ctrl_typevar: ty, arg: x)
    expect low.index < 0xFFFF_FFFF
    return Halves(low: low, high: Value(index: low.index + 1))
} Builder.isplit

pkg fn Builder.bitcast(mut self, ty: Type, flags: MemFlags, x: Value) -> Value {
    return mut self.build_value(InstructionData.LoadNoOffset(opcode: Opcode.Bitcast, flags: flags, arg: x), ctrl_typevar: Some(ty))
} Builder.bitcast

