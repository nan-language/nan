//! Fixed-width lane types of 128 bits: integer, binary32 and binary16 lanes with their masks.

/// 16 lanes of `u8`.
pub open struct U8x16 derives Copy, Eq {
    lanes: Array[u8, 16]
} U8x16

pub fn U8x16.splat(value: u8) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(7).lane(15) == 7
{
    return U8x16(lanes: Array[u8, 16].filled(value))
} U8x16.splat

pub fn U8x16.of(lanes: Array[u8, 16]) -> U8x16 limits pure, notrap, terminates
    example U8x16.of(Array[u8, 16].filled(2)) == U8x16.splat(2)
{
    return U8x16(lanes: lanes)
} U8x16.of

pub fn U8x16.to_array(self) -> Array[u8, 16] limits pure, notrap, terminates
    example U8x16.splat(2).to_array()[0] == 2
{
    return self.lanes
} U8x16.to_array

pub fn U8x16.load(from: Slice[u8], at: usize) -> U8x16 limits pure, notrap, terminates
    requires at <= from.len() and from.len() - at >= 16
    example U8x16.load(Array[u8, 17].filled(3).view(), at: 1) == U8x16.splat(3)
{
    var lanes = Array[u8, 16].filled(0)
    for index in at..<(at + 16) {
        lanes[index - at] = from[index]
    }
    return U8x16(lanes: lanes)
} U8x16.load

pub fn U8x16.store(self, mut to: SliceMut[u8], at: usize) limits pure, notrap, terminates
    requires at <= to.len() and to.len() - at >= 16

pub fn U8x16.lane(self, index: usize) -> u8 limits pure, notrap, terminates
    requires index < 16
    example U8x16.splat(5).replace_lane(1, value: 6).lane(1) == 6
{
    return self.lanes[index]
} U8x16.lane

pub fn U8x16.replace_lane(self, index: usize, value: u8) -> U8x16 limits pure, notrap, terminates
    requires index < 16
    example U8x16.splat(5).replace_lane(0, value: 6).lane(1) == 5
{
    var lanes = self.lanes
    lanes[index] = value
    return U8x16(lanes: lanes)
} U8x16.replace_lane

pub fn U8x16.wrapping_add(self, other: U8x16) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(~0).wrapping_add(U8x16.splat(2)) == U8x16.splat(1)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].wrapping_add(other.lanes[index])
    }
    return U8x16(lanes: lanes)
} U8x16.wrapping_add

pub fn U8x16.wrapping_sub(self, other: U8x16) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(0).wrapping_sub(U8x16.splat(1)) == U8x16.splat(~0)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].wrapping_sub(other.lanes[index])
    }
    return U8x16(lanes: lanes)
} U8x16.wrapping_sub

pub fn U8x16.saturating_add(self, other: U8x16) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(~0).saturating_add(U8x16.splat(1)) == U8x16.splat(~0)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].saturating_add(other.lanes[index])
    }
    return U8x16(lanes: lanes)
} U8x16.saturating_add

pub fn U8x16.saturating_sub(self, other: U8x16) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(0).saturating_sub(U8x16.splat(1)) == U8x16.splat(0)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].saturating_sub(other.lanes[index])
    }
    return U8x16(lanes: lanes)
} U8x16.saturating_sub

pub fn U8x16.bit_and(self, other: U8x16) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(0b1100).bit_and(U8x16.splat(0b1010)) == U8x16.splat(0b1000)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index] & other.lanes[index]
    }
    return U8x16(lanes: lanes)
} U8x16.bit_and

pub fn U8x16.bit_or(self, other: U8x16) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(0b1100).bit_or(U8x16.splat(0b1010)) == U8x16.splat(0b1110)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index] | other.lanes[index]
    }
    return U8x16(lanes: lanes)
} U8x16.bit_or

pub fn U8x16.bit_xor(self, other: U8x16) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(0b1100).bit_xor(U8x16.splat(0b1010)) == U8x16.splat(0b0110)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index] ^ other.lanes[index]
    }
    return U8x16(lanes: lanes)
} U8x16.bit_xor

pub fn U8x16.bit_not(self) -> U8x16 limits pure, notrap, terminates
    example U8x16.splat(0).bit_not() == U8x16.splat(~0)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = ~lanes[index]
    }
    return U8x16(lanes: lanes)
} U8x16.bit_not

pub fn U8x16.shl(self, amount: u32) -> U8x16 limits pure, notrap, terminates
    requires amount < 8
    example U8x16.splat(3).shl(7) == U8x16.splat(0x80)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index] << amount
    }
    return U8x16(lanes: lanes)
} U8x16.shl

pub fn U8x16.shr(self, amount: u32) -> U8x16 limits pure, notrap, terminates
    requires amount < 8
    example U8x16.splat(0x80).shr(7) == U8x16.splat(1)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index] >> amount
    }
    return U8x16(lanes: lanes)
} U8x16.shr

pub fn U8x16.lanes_eq(self, other: U8x16) -> Mask8x16 limits pure, notrap, terminates
    example U8x16.splat(1).replace_lane(0, value: 2).lanes_eq(U8x16.splat(1)).bitmask() == 0b1111111111111110
{
    var lanes = Array[u8, 16].filled(0)
    for index in 0..<16usize {
        if self.lanes[index] == other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask8x16(lanes: lanes)
} U8x16.lanes_eq

pub fn U8x16.lanes_lt(self, other: U8x16) -> Mask8x16 limits pure, notrap, terminates
    example U8x16.splat(1).lanes_lt(U8x16.splat(2)).all()
{
    var lanes = Array[u8, 16].filled(0)
    for index in 0..<16usize {
        if self.lanes[index] < other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask8x16(lanes: lanes)
} U8x16.lanes_lt

pub fn U8x16.lanes_gt(self, other: U8x16) -> Mask8x16 limits pure, notrap, terminates
    example not U8x16.splat(1).lanes_gt(U8x16.splat(1)).any()
{
    var lanes = Array[u8, 16].filled(0)
    for index in 0..<16usize {
        if self.lanes[index] > other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask8x16(lanes: lanes)
} U8x16.lanes_gt

pub fn U8x16.select(mask: Mask8x16, if_true: U8x16, if_false: U8x16) -> U8x16 limits pure, notrap, terminates
    example U8x16.select(U8x16.splat(1).lanes_lt(U8x16.splat(2)), if_true: U8x16.splat(3), if_false: U8x16.splat(4)) == U8x16.splat(3)
{
    var lanes = if_false.lanes
    for index in 0..<16usize {
        let chosen = mask.lanes[index]
        lanes[index] = (if_true.lanes[index] & chosen) | (if_false.lanes[index] & ~chosen)
    }
    return U8x16(lanes: lanes)
} U8x16.select

pub fn U8x16.wrapping_sum(self) -> u8 limits pure, notrap, terminates
    example U8x16.splat(3).wrapping_sum() == 48
{
    var total = self.lanes[0]
    for index in 1..<16usize {
        total = total.wrapping_add(self.lanes[index])
    }
    return total
} U8x16.wrapping_sum

/// 16 lanes of `i8`.
pub open struct I8x16 derives Copy, Eq {
    lanes: Array[i8, 16]
} I8x16

pub fn I8x16.splat(value: i8) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(7).lane(15) == 7
{
    return I8x16(lanes: Array[i8, 16].filled(value))
} I8x16.splat

pub fn I8x16.of(lanes: Array[i8, 16]) -> I8x16 limits pure, notrap, terminates
    example I8x16.of(Array[i8, 16].filled(2)) == I8x16.splat(2)
{
    return I8x16(lanes: lanes)
} I8x16.of

pub fn I8x16.to_array(self) -> Array[i8, 16] limits pure, notrap, terminates
    example I8x16.splat(2).to_array()[0] == 2
{
    return self.lanes
} I8x16.to_array

pub fn I8x16.load(from: Slice[i8], at: usize) -> I8x16 limits pure, notrap, terminates
    requires at <= from.len() and from.len() - at >= 16
    example I8x16.load(Array[i8, 17].filled(3).view(), at: 1) == I8x16.splat(3)
{
    var lanes = Array[i8, 16].filled(0)
    for index in at..<(at + 16) {
        lanes[index - at] = from[index]
    }
    return I8x16(lanes: lanes)
} I8x16.load

pub fn I8x16.store(self, mut to: SliceMut[i8], at: usize) limits pure, notrap, terminates
    requires at <= to.len() and to.len() - at >= 16

pub fn I8x16.lane(self, index: usize) -> i8 limits pure, notrap, terminates
    requires index < 16
    example I8x16.splat(5).replace_lane(1, value: 6).lane(1) == 6
{
    return self.lanes[index]
} I8x16.lane

pub fn I8x16.replace_lane(self, index: usize, value: i8) -> I8x16 limits pure, notrap, terminates
    requires index < 16
    example I8x16.splat(5).replace_lane(0, value: 6).lane(1) == 5
{
    var lanes = self.lanes
    lanes[index] = value
    return I8x16(lanes: lanes)
} I8x16.replace_lane

pub fn I8x16.wrapping_add(self, other: I8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(127).wrapping_add(I8x16.splat(1)) == I8x16.splat(-128)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].wrapping_add(other.lanes[index])
    }
    return I8x16(lanes: lanes)
} I8x16.wrapping_add

pub fn I8x16.wrapping_sub(self, other: I8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(-128).wrapping_sub(I8x16.splat(1)) == I8x16.splat(127)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].wrapping_sub(other.lanes[index])
    }
    return I8x16(lanes: lanes)
} I8x16.wrapping_sub

pub fn I8x16.saturating_add(self, other: I8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(127).saturating_add(I8x16.splat(1)) == I8x16.splat(127)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].saturating_add(other.lanes[index])
    }
    return I8x16(lanes: lanes)
} I8x16.saturating_add

pub fn I8x16.saturating_sub(self, other: I8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(-128).saturating_sub(I8x16.splat(1)) == I8x16.splat(-128)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].saturating_sub(other.lanes[index])
    }
    return I8x16(lanes: lanes)
} I8x16.saturating_sub

pub fn I8x16.bit_and(self, other: I8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(0b1100).bit_and(I8x16.splat(0b1010)) == I8x16.splat(0b1000)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index] & other.lanes[index]
    }
    return I8x16(lanes: lanes)
} I8x16.bit_and

pub fn I8x16.bit_or(self, other: I8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(0b1100).bit_or(I8x16.splat(0b1010)) == I8x16.splat(0b1110)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index] | other.lanes[index]
    }
    return I8x16(lanes: lanes)
} I8x16.bit_or

pub fn I8x16.bit_xor(self, other: I8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(0b1100).bit_xor(I8x16.splat(0b1010)) == I8x16.splat(0b0110)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index] ^ other.lanes[index]
    }
    return I8x16(lanes: lanes)
} I8x16.bit_xor

pub fn I8x16.bit_not(self) -> I8x16 limits pure, notrap, terminates
    example I8x16.splat(0).bit_not() == I8x16.splat(-1)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = ~lanes[index]
    }
    return I8x16(lanes: lanes)
} I8x16.bit_not

pub fn I8x16.shl(self, amount: u32) -> I8x16 limits pure, notrap, terminates
    requires amount < 8
    example I8x16.splat(3).shl(7) == I8x16.splat(-128)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].wrapping_shl(amount)
    }
    return I8x16(lanes: lanes)
} I8x16.shl

pub fn I8x16.shr(self, amount: u32) -> I8x16 limits pure, notrap, terminates
    requires amount < 8
    example I8x16.splat(-8).shr(1) == I8x16.splat(-4)
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = lanes[index].shr_arith(amount)
    }
    return I8x16(lanes: lanes)
} I8x16.shr

pub fn I8x16.lanes_eq(self, other: I8x16) -> Mask8x16 limits pure, notrap, terminates
    example I8x16.splat(1).replace_lane(0, value: 2).lanes_eq(I8x16.splat(1)).bitmask() == 0b1111111111111110
{
    var lanes = Array[u8, 16].filled(0)
    for index in 0..<16usize {
        if self.lanes[index] == other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask8x16(lanes: lanes)
} I8x16.lanes_eq

pub fn I8x16.lanes_lt(self, other: I8x16) -> Mask8x16 limits pure, notrap, terminates
    example I8x16.splat(-1).lanes_lt(I8x16.splat(0)).all()
{
    var lanes = Array[u8, 16].filled(0)
    for index in 0..<16usize {
        if self.lanes[index] < other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask8x16(lanes: lanes)
} I8x16.lanes_lt

pub fn I8x16.lanes_gt(self, other: I8x16) -> Mask8x16 limits pure, notrap, terminates
    example not I8x16.splat(1).lanes_gt(I8x16.splat(1)).any()
{
    var lanes = Array[u8, 16].filled(0)
    for index in 0..<16usize {
        if self.lanes[index] > other.lanes[index] {
            lanes[index] = ~0
        }
    }
    return Mask8x16(lanes: lanes)
} I8x16.lanes_gt

pub fn I8x16.select(mask: Mask8x16, if_true: I8x16, if_false: I8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.select(I8x16.splat(1).lanes_lt(I8x16.splat(2)), if_true: I8x16.splat(3), if_false: I8x16.splat(4)) == I8x16.splat(3)
{
    var lanes = if_false.lanes
    for index in 0..<16usize {
        let chosen = mask.lanes[index]
        lanes[index] = i8.from_bits((if_true.lanes[index].to_bits() & chosen) | (if_false.lanes[index].to_bits() & ~chosen))
    }
    return I8x16(lanes: lanes)
} I8x16.select

pub fn I8x16.wrapping_sum(self) -> i8 limits pure, notrap, terminates
    example I8x16.splat(3).wrapping_sum() == 48
{
    var total = self.lanes[0]
    for index in 1..<16usize {
        total = total.wrapping_add(self.lanes[index])
    }
    return total
} I8x16.wrapping_sum

pub fn I8x16.to_bytes(self) -> U8x16 limits pure, notrap, terminates
    example I8x16.splat(1).to_bytes().lane(0) == 1
{
    var bytes = Array[u8, 16].filled(0)
    for index in 0..<16usize {
        bytes[index] = self.lanes[index].to_bits()
    }
    return U8x16(lanes: bytes)
} I8x16.to_bytes

pub fn I8x16.from_bytes(bytes: U8x16) -> I8x16 limits pure, notrap, terminates
    example I8x16.from_bytes(U8x16.splat(0)) == I8x16.splat(0)
{
    var lanes = Array[i8, 16].filled(0)
    for index in 0..<16usize {
        lanes[index] = i8.from_bits(bytes.lanes[index])
    }
    return I8x16(lanes: lanes)
} I8x16.from_bytes

pub fn I8x16.dot(self, other: I8x16, acc: I32x4) -> I32x4 limits pure, notrap, terminates
    example I8x16.splat(-128).dot(I8x16.splat(-128), acc: I32x4.splat(1)) == I32x4.splat(65_537)
{
    var lanes = acc.lanes
    for index in 0..<4usize {
        var sum = 0i32
        for term in 0..<4usize {
            let product = i32.widen(self.lanes[4 * index + term]) * i32.widen(other.lanes[4 * index + term])
            sum = sum.wrapping_add(product)
        }
        lanes[index] = lanes[index].wrapping_add(sum)
    }
    return I32x4(lanes: lanes)
} I8x16.dot

/// 8 lanes of `u16`.
pub open struct U16x8 derives Copy, Eq {
    lanes: Array[u16, 8]
} U16x8

pub fn U16x8.splat(value: u16) -> U16x8 limits pure, notrap, terminates
    example U16x8.splat(7).lane(7) == 7
{
    return U16x8(lanes: Array[u16, 8].filled(value))
} U16x8.splat

pub fn U16x8.of(lanes: Array[u16, 8]) -> U16x8 limits pure, notrap, terminates
    example U16x8.of(Array[u16, 8].filled(2)) == U16x8.splat(2)
{
    return U16x8(lanes: lanes)
} U16x8.of

pub fn U16x8.to_array(self) -> Array[u16, 8] limits pure, notrap, terminates
    example U16x8.splat(2).to_array()[0] == 2
{
    return self.lanes
} U16x8.to_array

pub fn U16x8.load(from: Slice[u16], at: usize) -> U16x8 limits pure, notrap, terminates
    requires at <= from.len() and from.len() - at >= 8
    example U16x8.load(Array[u16, 9].filled(3).view(), at: 1) == U16x8.splat(3)
{
    var lanes = Array[u16, 8].filled(0)
    for index in at..<(at + 8) {
        lanes[index - at] = from[index]
    }
    return U16x8(lanes: lanes)
} U16x8.load

pub fn U16x8.store(self, mut to: SliceMut[u16], at: usize) limits pure, notrap, terminates
    requires at <= to.len() and to.len() - at >= 8

pub fn U16x8.lane(self, index: usize) -> u16 limits pure, notrap, terminates
    requires index < 8
    example U16x8.splat(5).replace_lane(1, value: 6).lane(1) == 6
{
    return self.lanes[index]
} U16x8.lane

pub fn U16x8.replace_lane(self, index: usize, value: u16) -> U16x8 limits pure, notrap, terminates
    requires index < 8
    example U16x8.splat(5).replace_lane(0, value: 6).lane(1) == 5
{
    var lanes = self.lanes
    lanes[index] = value
    return U16x8(lanes: lanes)
} U16x8.replace_lane

pub fn U16x8.wrapping_add(self, other: U16x8) -> U16x8 limits pure, notrap, terminates
    example U16x8.splat(~0).wrapping_add(U16x8.splat(2)) == U16x8.splat(1)
{
    var lanes = self.lanes
    for index in 0..<8usize {
        lanes[index] = lanes[index].wrapping_add(other.lanes[index])
    }
    return U16x8(lanes: lanes)
} U16x8.wrapping_add

pub fn U16x8.wrapping_sub(self, other: U16x8) -> U16x8 limits pure, notrap, terminates
    example U16x8.splat(0).wrapping_sub(U16x8.splat(1)) == U16x8.splat(~0)
{
    var lanes = self.lanes
    for index in 0..<8usize {
        lanes[index] = lanes[index].wrapping_sub(other.lanes[index])
    }
    return U16x8(lanes: lanes)
} U16x8.wrapping_sub

pub fn U16x8.wrapping_mul(self, other: U16x8) -> U16x8 limits pure, notrap, terminates
    example U16x8.splat(~0).wrapping_mul(U16x8.splat(2)) == U16x8.splat(~1)
{
    var lanes = self.lanes
    for index in 0..<8usize {
        lanes[index] = lanes[index].wrapping_mul(other.lanes[index])
    }
    return U16x8(lanes: lanes)
} U16x8.wrapping_mul

pub fn U16x8.saturating_add(self, other: U16x8) -> U16x8 limits pure, notrap, terminates
    example U16x8.splat(~0).saturating_add(U16x8.splat(1)) == U16x8.splat(~0)
{
    var lanes = self.lanes
    for index in 0..<8usize {
        lanes[index] = lanes[index].saturating_add(other.lanes[index])
    }
