    \\
    \\/// Swaps the limbs of two elements when `swap` is 1, in time independent of it.
    \\fn swapped(mut p: Array[i64, 16], mut q: Array[i64, 16], swap: i64) {
    \\    let mask = ~(swap.wrapping_sub(1))
