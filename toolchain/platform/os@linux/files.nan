//! Files, directories and their metadata.

const O_RDONLY: i32 = 0

const O_WRONLY: i32 = 1

const O_RDWR: i32 = 2

const O_CREAT: i32 = 0x40

const O_EXCL: i32 = 0x80

const O_TRUNC: i32 = 0x200

const O_CLOEXEC: i32 = 0x8_0000

/// The directory `openat` and `unlinkat` resolve relative paths in when given no descriptor.
const AT_FDCWD: i32 = -100

const AT_SYMLINK_NOFOLLOW: i32 = 0x100

const AT_REMOVEDIR: i32 = 0x200

const AT_EMPTY_PATH: i32 = 0x1000

/// The fields `statx` is asked for: the file's type and mode, its owner and its size.
const STATX_FIELDS: u32 = 0x20B

const LOCK_SH: i32 = 1

const LOCK_EX: i32 = 2

const LOCK_UN: i32 = 8

const S_IFMT: u32 = 0xF000

const S_IFDIR: u32 = 0x4000

const S_IFREG: u32 = 0x8000

const S_IFLNK: u32 = 0xA000

const DT_UNKNOWN: u8 = 0

const DT_DIR: u8 = 4

const DT_REG: u8 = 8

const DT_LNK: u8 = 10

const STDIN: i32 = 0

const STDOUT: i32 = 1

const STDERR: i32 = 2

/// The bytes a read asks for at least, before the file's size is known.
const READ_CHUNK: usize = 8_192

/// Linux's `struct statx`, the same on every architecture.
layout Statx: bytes 256 le {
    mask: u32 at 0
    blksize: u32 at 4
    attributes: u64 at 8
    nlink: u32 at 16
    uid: u32 at 20
    gid: u32 at 24
    mode: u16 at 28
    spare: u16 at 30
    ino: u64 at 32
    size: u64 at 40
    blocks: u64 at 48
    attributes_mask: u64 at 56
    times: Array[u64, 8] at 64
    devices: Array[u32, 4] at 128
    reserved: Array[u64, 14] at 144
} Statx

/// The fixed part of glibc's `struct dirent` on 64-bit Linux, which its NUL-terminated name
/// follows.
layout Dirent: bytes 19 le {
    ino: u64 at 0
    off: u64 at 8
    reclen: u16 at 16
    kind: u8 at 18
} Dirent

const DIRENT_NAME: isize = 19

foreign fn open(path: hw::Ptr[u8], flags: i32, mode: u32) -> i32 convention "sysv"

foreign fn openat(dir: i32, path: hw::Ptr[u8], flags: i32, mode: u32) -> i32 convention "sysv"

foreign fn close(fd: i32) -> i32 convention "sysv"

foreign fn read(fd: i32, buf: hw::Ptr[u8], count: usize) -> isize convention "sysv"

foreign fn pread(fd: i32, buf: hw::Ptr[u8], count: usize, offset: i64) -> isize convention "sysv"

foreign fn write(fd: i32, buf: hw::Ptr[u8], count: usize) -> isize convention "sysv"

foreign fn fsync(fd: i32) -> i32 convention "sysv"

foreign fn ftruncate(fd: i32, length: i64) -> i32 convention "sysv"

foreign fn flock(fd: i32, operation: i32) -> i32 convention "sysv"

foreign fn statx(dir: i32, path: hw::Ptr[u8], flags: i32, mask: u32, buf: hw::Ptr[Statx]) -> i32 convention "sysv"

foreign fn rename(from: hw::Ptr[u8], to: hw::Ptr[u8]) -> i32 convention "sysv"

foreign fn unlink(path: hw::Ptr[u8]) -> i32 convention "sysv"

foreign fn unlinkat(dir: i32, path: hw::Ptr[u8], flags: i32) -> i32 convention "sysv"

foreign fn mkdir(path: hw::Ptr[u8], mode: u32) -> i32 convention "sysv"

foreign fn opendir(path: hw::Ptr[u8]) -> hw::Ptr[u8] convention "sysv"

foreign fn fdopendir(fd: i32) -> hw::Ptr[u8] convention "sysv"

foreign fn dirfd(dir: hw::Ptr[u8]) -> i32 convention "sysv"

foreign fn readdir(dir: hw::Ptr[u8]) -> hw::Ptr[Dirent] convention "sysv"

foreign fn closedir(dir: hw::Ptr[u8]) -> i32 convention "sysv"

foreign fn getcwd(buf: hw::Ptr[u8], size: usize) -> hw::Ptr[u8] convention "sysv"

foreign fn realpath(path: hw::Ptr[u8], resolved: hw::Ptr[u8]) -> hw::Ptr[u8] convention "sysv"

/// What the system records of a file: its kind, and who else may reach it.
pub open struct Metadata derives Copy {
    pub kind: platform::FileKind
    uid: u32
    mode: u32
} Metadata

/// Whether a user other than `user` owns the file or may write it, as its owner and mode say on
/// Linux; never on Windows, whose access control lists the toolchain does not read.
pub fn Metadata.writable_by_others(self, user: u32) -> bool {
    return self.uid != user or (self.mode & 0b000_010_010) != 0
} Metadata.writable_by_others

/// Whether a user other than `user` owns the file or may access it, as its owner and mode say on
/// Linux; never on Windows, whose access control lists the toolchain does not read.
pub fn Metadata.accessible_by_others(self, user: u32) -> bool {
    return self.uid != user or (self.mode & 0b000_111_111) != 0
} Metadata.accessible_by_others

pub fn Metadata.is_file(self) -> bool = self.kind == platform::FileKind.Regular

pub fn Metadata.is_dir(self) -> bool = self.kind == platform::FileKind.Directory

pub fn Metadata.is_symlink(self) -> bool = self.kind == platform::FileKind.Symlink

/// A file this process holds open, until `close`.
pub open linear struct File {
    fd: i32
} File

/// Opens a file for reading.
pub fn File.open(path: Str) -> File fails platform::IoError {
    return try open_file(path, flags: O_RDONLY, mode: 0)
} File.open

/// Opens a file for writing, creating it when it is missing, with `mode` where the system gives
/// files one, and emptying it otherwise.
pub fn File.create(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, flags: O_WRONLY | O_CREAT | O_TRUNC, mode)
} File.create

/// Creates a file, with `mode` where the system gives files one, and opens it for writing;
/// `AlreadyExists` when the path names one.
pub fn File.create_new(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, flags: O_WRONLY | O_CREAT | O_EXCL, mode)
} File.create_new

/// Opens a file for writing without changing it, creating it when it is missing, with `mode` where
/// the system gives files one.
pub fn File.open_or_create(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, flags: O_WRONLY | O_CREAT, mode)
} File.open_or_create

fn open_file(path: Str, flags: i32, mode: u32) -> File fails platform::IoError {
    let name = try c_text(path.as_bytes())
    loop {
        let fd = trusted "name holds a NUL-terminated path" { open(hw::Ptr.of_view(name.bytes.view()), flags: flags | O_CLOEXEC, mode) }
        if fd >= 0 {
            return File(fd: fd)
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} open_file

pub fn File.close(take self) {
    let File(fd: fd) = self
    discard close(fd)
} File.close

/// Writes all of `data` at the file's position.
pub fn File.write_all(self, data: Slice[u8]) fails platform::IoError {
    try write_fd(self.fd, data)
} File.write_all

/// Returns once the file's contents and metadata are on disk.
pub fn File.sync_all(self) fails platform::IoError {
    loop {
        if fsync(self.fd) == 0 {
            return
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} File.sync_all

/// Returns once the entries of the directory `path` are on disk, as renames into it leave them: on
/// Linux by syncing the directory, and on Windows, whose file systems journal their entries in
/// order, once it finds that `path` names a directory.
pub fn sync_dir(path: Str) fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    try file.sync_all()
} sync_dir

/// Waits for the exclusive lock of the file.
pub fn File.lock(self) fails platform::IoError {
    try checked(flock(self.fd, operation: LOCK_EX))
} File.lock

/// Waits for a shared lock of the file.
pub fn File.lock_shared(self) fails platform::IoError {
    try checked(flock(self.fd, operation: LOCK_SH))
} File.lock_shared

/// Releases the lock the file holds.
pub fn File.unlock(self) fails platform::IoError {
    try checked(flock(self.fd, operation: LOCK_UN))
} File.unlock

/// The rest of the file from its position.
pub fn File.read_to_end(self, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    return try read_rest(self.fd, alloc)
} File.read_to_end

/// What standard input holds up to its end.
pub fn read_stdin(alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    return try read_rest(STDIN, alloc)
} read_stdin

/// The rest of an open descriptor's file from its position.
fn read_rest(fd: i32, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    var room = READ_CHUNK
    let held = fd_status(fd)
    if held.size > 0 {
        room = usize.widen(held.size).saturating_add(1)
    }
    var data = mem::Bytes.zeroed(room, alloc)
    var filled: usize = 0
    loop {
        if filled == data.len() {
            let extra = mem::Bytes.zeroed(data.len(), alloc)
            mut data.append(extra.view())
        }
        let start = hw::Ptr.of_view_mut(mut data.view_mut())
        let count = trusted "start addresses the len bytes of data, of which filled are behind" { read(fd, buf: start.offset(isize.fit(filled)), count: data.len() - filled) }
        if count == 0 {
            mut data.truncate(filled)
            return data
        }
        if count > 0 {
            filled += usize.fit(count)
            continue
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} read_rest

/// The status of an open file, all zero when the system gives none.
fn fd_status(fd: i32) -> Statx {
    var raw = Statx.from_bits(Array[u8, 256].filled(0))
    let buffer = hw::Ptr.of_mut(mut raw)
    let empty = Array[u8, 1].filled(0)
    let done = trusted "empty holds a NUL-terminated empty path and buffer addresses a struct statx" { statx(fd, path: hw::Ptr.of_view(empty.view()), flags: AT_EMPTY_PATH, mask: STATX_FIELDS, buf: buffer) }
    if done != 0 {
        return raw
    }
    return trusted "statx wrote a struct statx at buffer" { buffer.read() }
} fd_status

/// Writes all of `data` to an open descriptor.
fn write_fd(fd: i32, data: Slice[u8]) fails platform::IoError {
    var written: usize = 0
    while written < data.len() {
        let start = hw::Ptr.of_view(data)
        let count = trusted "start addresses the len bytes of data, of which written are behind" { write(fd, buf: start.offset(isize.fit(written)), count: data.len() - written) }
        if count > 0 {
            written += usize.fit(count)
            continue
        }
        if count == 0 {
            fail platform::IoError.Other(0)
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
} write_fd

/// Fails with the last error when a call of the C library reported failure with -1.
fn checked(status: i32) fails platform::IoError {
    if status == -1 {
        fail last_error()
    }
} checked

/// Writes all of `data` to standard output.
pub fn write_stdout(data: Slice[u8]) fails platform::IoError {
    try write_fd(STDOUT, data)
} write_stdout

/// Writes all of `data` to standard error.
pub fn write_stderr(data: Slice[u8]) fails platform::IoError {
    try write_fd(STDERR, data)
} write_stderr

/// The contents of a file.
pub fn read_all(path: Str, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    return try file.read_to_end(alloc)
} read_all

/// The `length` bytes of a file at an offset, fewer when the file ends before them.
pub fn read_at(path: Str, at: usize, length: usize, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    var data = mem::Bytes.zeroed(length, alloc)
    var filled: usize = 0
    while filled < length {
        let start = hw::Ptr.of_view_mut(mut data.view_mut())
        let count = trusted "start addresses the length bytes of data, of which filled are behind" { pread(file.fd, buf: start.offset(isize.fit(filled)), count: length - filled, offset: i64.fit(at + filled)) }
        if count == 0 {
            break
        }
        if count > 0 {
            filled += usize.fit(count)
            continue
        }
        let code = last_code()
        if code != EINTR {
            fail error_of(code)
        }
    }
    mut data.truncate(filled)
    return data
} read_at

/// The contents of a file, which hold text; `InvalidData` when they are not well-formed UTF-8.
pub fn read_text(path: Str, alloc: mem::Alloc) -> text::String fails platform::IoError {
    let data = try read_all(path, alloc)
    let Ok(decoded) = attempt text::String.try_from_utf8(data.view(), alloc) else {
        fail platform::IoError.InvalidData
    }
    return decoded
} read_text

/// Writes a file whole, creating it when it is missing, with mode rw-rw-rw- where the system gives
/// files one.
pub fn write_all(path: Str, contents: Slice[u8]) fails platform::IoError {
    let file = try File.create(path, mode: 0b110_110_110)
    defer take file.close()
    try file.write_all(contents)
} write_all

/// Writes a file of `bytes` zero bytes, replacing any file `path` names; on Linux the system
/// allocates them only as they are written.
pub fn write_sized(path: Str, bytes: u64) fails platform::IoError {
    let file = try File.create(path, mode: 0b110_110_110)
    defer take file.close()
    let Some(length) = i64.checked_fit(bytes) else {
        fail platform::IoError.Other(EINVAL)
    }
    try checked(ftruncate(file.fd, length))
} write_sized

/// Whether this process may open a file for reading and writing.
pub fn may_read_write(path: Str) -> bool {
    let Ok(file) = attempt open_file(path, flags: O_RDWR, mode: 0) else {
        return false
    }
    take file.close()
    return true
} may_read_write

/// Renames a file or directory, replacing the file `to` names.
pub fn rename_path(from: Str, to: Str) fails platform::IoError {
    let old = try c_text(from.as_bytes())
    let new = try c_text(to.as_bytes())
    try checked(trusted "old and new hold NUL-terminated paths" { rename(hw::Ptr.of_view(old.bytes.view()), to: hw::Ptr.of_view(new.bytes.view())) })
} rename_path

/// Removes a file, a read-only one too.
pub fn remove_file(path: Str) fails platform::IoError {
    let name = try c_text(path.as_bytes())
    try checked(trusted "name holds a NUL-terminated path" { unlink(hw::Ptr.of_view(name.bytes.view())) })
} remove_file

/// Creates a directory, with `mode` where the system gives directories one, its parent existing.
pub fn create_dir(path: Str, mode: u32) fails platform::IoError {
    let name = try c_text(path.as_bytes())
    try checked(trusted "name holds a NUL-terminated path" { mkdir(hw::Ptr.of_view(name.bytes.view()), mode) })
} create_dir

/// Creates a directory and every missing parent, with mode rwxrwxrwx where the system gives
/// directories one; succeeds when the path names a directory.
pub fn create_dir_all(path: Str, alloc: mem::Alloc) fails platform::IoError {
    if path.is_empty() {
        return
    }
    let made = attempt create_dir(path, mode: 0b111_111_111)
    match first made {
        Ok(_) => return
        Err(platform::IoError.NotFound) => {}
        Err(error) => {
            if is_dir(path) {
                return
            }
            fail error
        }
    }
    let Some(above) = platform::parent(path, alloc) else {
        fail platform::IoError.Other(0)
    }
    try create_dir_all(above.as_str(), alloc)
    let Err(error) = attempt create_dir(path, mode: 0b111_111_111) else {
        return
    }
    if is_dir(path) {
        return
    }
    fail error
} create_dir_all

/// The metadata of what a path names, a symbolic link or junction followed.
pub fn metadata(path: Str) -> Metadata fails platform::IoError {
    return try metadata_with(path, flags: 0)
} metadata

/// The metadata of what a path names, a symbolic link or junction itself.
pub fn symlink_metadata(path: Str) -> Metadata fails platform::IoError {
    return try metadata_with(path, flags: AT_SYMLINK_NOFOLLOW)
} symlink_metadata

/// The metadata `statx` gives with `flags` of what a path names.
fn metadata_with(path: Str, flags: i32) -> Metadata fails platform::IoError {
    let name = try c_text(path.as_bytes())
    var raw = Statx.from_bits(Array[u8, 256].filled(0))
    let buffer = hw::Ptr.of_mut(mut raw)
    try checked(trusted "name holds a NUL-terminated path and buffer addresses a struct statx" { statx(AT_FDCWD, path: hw::Ptr.of_view(name.bytes.view()), flags, mask: STATX_FIELDS, buf: buffer) })
    return metadata_of(trusted "statx wrote a struct statx at buffer" { buffer.read() })
} metadata_with

fn metadata_of(held: Statx) -> Metadata {
    let mode = u32.widen(held.mode)
    let kind = match mode & S_IFMT {
        S_IFREG => platform::FileKind.Regular
        S_IFDIR => platform::FileKind.Directory
        S_IFLNK => platform::FileKind.Symlink
        else => platform::FileKind.Other
    }
    return Metadata(kind: kind, uid: held.uid, mode: mode)
} metadata_of

/// Whether a path names something, a symbolic link followed.
pub fn exists(path: Str) -> bool {
    let Ok(_) = attempt metadata(path) else {
        return false
    }
    return true
} exists

/// Whether a path names a directory, a symbolic link followed.
pub fn is_dir(path: Str) -> bool {
    let Ok(held) = attempt metadata(path) else {
        return false
    }
    return held.is_dir()
} is_dir

/// The entries of a directory but `.` and `..`, in the order the system gives them.
pub fn list_dir(path: Str, alloc: mem::Alloc) -> mem::List[platform::DirEntry] fails platform::IoError {
    let name = try c_text(path.as_bytes())
    let stream = trusted "name holds a NUL-terminated path" { opendir(hw::Ptr.of_view(name.bytes.view())) }
    if stream.addr() == 0 {
        fail last_error()
    }
    defer close_stream(stream)
    return try stream_entries(stream, alloc)
} list_dir

fn close_stream(stream: hw::Ptr[u8]) {
    discard trusted "stream is a directory stream this process opened and closes once" { closedir(stream) }
} close_stream

/// The entries a directory stream gives but `.` and `..`, each entry whose type the stream does
/// not give read with `statx`.
fn stream_entries(stream: hw::Ptr[u8], alloc: mem::Alloc) -> mem::List[platform::DirEntry] fails platform::IoError {
    var found = mem::List[platform::DirEntry].empty(alloc)
    loop {
        clear_code()
        let entry = trusted "stream is an open directory stream" { readdir(stream) }
        if entry.addr() == 0 {
            let code = last_code()
            if code != 0 {
                fail error_of(code)
            }
            return found
        }
        let fixed = trusted "readdir returned a struct dirent that lives until the next readdir of stream" { entry.read() }
        let start = trusted "a cast accesses no memory" { hw::Ptr[u8].cast(entry).offset(DIRENT_NAME) }
        let name = copied_text(start, alloc)
        if name.view() == b"." or name.view() == b".." {
            continue
        }
        var kind = match fixed.kind {
            DT_REG => platform::FileKind.Regular
            DT_DIR => platform::FileKind.Directory
            DT_LNK => platform::FileKind.Symlink
            else => platform::FileKind.Other
        }
        if fixed.kind == DT_UNKNOWN {
            kind = try entry_kind(stream, start)
        }
        mut found.push(platform::DirEntry(name: take name, kind: kind))
    }
} stream_entries

/// The kind of the file a directory stream's entry names, its name at `start`.
fn entry_kind(stream: hw::Ptr[u8], start: hw::Ptr[u8]) -> platform::FileKind fails platform::IoError {
    let dir = trusted "stream is an open directory stream" { dirfd(stream) }
    var raw = Statx.from_bits(Array[u8, 256].filled(0))
    let buffer = hw::Ptr.of_mut(mut raw)
    try checked(trusted "start addresses the NUL-terminated name of an entry of dir and buffer a struct statx" { statx(dir, path: start, flags: AT_SYMLINK_NOFOLLOW, mask: STATX_FIELDS, buf: buffer) })
    return metadata_of(trusted "statx wrote a struct statx at buffer" { buffer.read() }).kind
} entry_kind

/// Removes a directory with everything in it, or a symbolic link or junction itself; a link inside
/// is removed, never followed.
pub fn remove_dir_all(path: Str, alloc: mem::Alloc) fails platform::IoError {
    let held = try symlink_metadata(path)
    if held.is_symlink() {
        try remove_file(path)
        return
    }
    let name = try c_text(path.as_bytes())
    try remove_tree(AT_FDCWD, name, alloc)
} remove_dir_all

/// The `open` flags `O_DIRECTORY | O_NOFOLLOW`, whose values differ between architectures.
fn directory_nofollow() -> i32 {
    if on_aarch64() {
        return 0x4000 | 0x8000
    }
    return 0x1_0000 | 0x2_0000
} directory_nofollow

/// Removes the directory `name` of the directory open as `dir`, after what it holds; `name`
/// itself when it is not a directory and lies in a removed directory.
fn remove_tree(dir: i32, name: CText, alloc: mem::Alloc) fails platform::IoError {
    let fd = trusted "name holds a NUL-terminated path" { openat(dir, path: hw::Ptr.of_view(name.bytes.view()), flags: O_RDONLY | directory_nofollow() | O_CLOEXEC, mode: 0) }
    if fd < 0 {
        let code = last_code()
        if (code == ENOTDIR or code == ELOOP) and dir != AT_FDCWD {
            try checked(trusted "name holds a NUL-terminated path" { unlinkat(dir, path: hw::Ptr.of_view(name.bytes.view()), flags: 0) })
            return
        }
        fail error_of(code)
    }
    let stream = trusted "fd is a directory this process opened" { fdopendir(fd) }
    if stream.addr() == 0 {
        let error = last_error()
        discard close(fd)
        fail error
    }
    defer close_stream(stream)
    let inner = trusted "stream is an open directory stream" { dirfd(stream) }
    for entry in try stream_entries(stream, alloc) {
        let child = try c_text(entry.name.view())
        let removed = attempt remove_child(inner, name: child, kind: entry.kind, alloc)
        let Err(error) = removed else {
            continue
        }
        if error != platform::IoError.NotFound {
            fail error
        }
    }
    let gone = trusted "name holds a NUL-terminated path" { unlinkat(dir, path: hw::Ptr.of_view(name.bytes.view()), flags: AT_REMOVEDIR) }
    if gone == -1 {
        let error = last_error()
        if error != platform::IoError.NotFound {
            fail error
        }
    }
} remove_tree

fn remove_child(dir: i32, name: CText, kind: platform::FileKind, alloc: mem::Alloc) fails platform::IoError {
    if kind == platform::FileKind.Directory {
        try remove_tree(dir, name, alloc)
        return
    }
    try checked(trusted "name holds a NUL-terminated path" { unlinkat(dir, path: hw::Ptr.of_view(name.bytes.view()), flags: 0) })
} remove_child

/// The current directory of this process, with `/` separators: the bytes Linux gives, or the UTF-8
/// of the path Windows gives.
pub fn current_dir(alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    var size: usize = 512
    loop {
        var buffer = mem::Bytes.zeroed(size, alloc)
        let start = hw::Ptr.of_view_mut(mut buffer.view_mut())
        let found = trusted "start addresses the size bytes of buffer" { getcwd(start, size) }
        if found.addr() != 0 {
            return copied_text(start, alloc)
        }
        let code = last_code()
        if code != ERANGE {
            fail error_of(code)
        }
        size = size * 2
    }
} current_dir

/// The absolute path naming what a path names, once every link and every `.` and `..` component is
/// resolved, with `/` separators; `InvalidData` when the system's path is not well-formed Unicode.
pub fn canonicalize(path: Str, alloc: mem::Alloc) -> text::String fails platform::IoError {
    let name = try c_text(path.as_bytes())
    var buffer = mem::Bytes.zeroed(PATH_MAX, alloc)
    let start = hw::Ptr.of_view_mut(mut buffer.view_mut())
    let found = trusted "name holds a NUL-terminated path and start addresses PATH_MAX bytes" { realpath(hw::Ptr.of_view(name.bytes.view()), resolved: start) }
    if found.addr() == 0 {
        fail last_error()
    }
    let resolved = copied_text(start, alloc)
    let Ok(written) = attempt text::String.try_from_utf8(resolved.view(), alloc) else {
        fail platform::IoError.InvalidData
    }
    return written
} canonicalize
