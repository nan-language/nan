//! Attaches two functions of one device without ACS to one domain, draws entropy through a confined driver, into a pool its domain maps through a 2 MiB page too, counts its MSI-X interrupts, aims its device at an unmapped bus address and receives the IOMMU's fault, then abandons a second driver mid-request and reuses its memory.

registers Uart {
    data: u8 at 0x0 write
} Uart

/// The byte filling the memory the devices must not reach, the nanoseconds the kernel waits for
/// writes that must not happen, and the polls of an interrupt count before it gives up; the
/// bytes of an IOMMU page.
const FILL: u8 = 0x5A

const PAUSE_NS: u64 = 20_000_000

const INTERRUPT_POLLS: u32 = 1_000_000

const PAGE: u64 = 4_096

/// The bytes of a 2 MiB page.
const LARGE: u64 = 2_097_152

/// A block of memory of the size the abandoned driver's buffers took.
layout Block: bytes 4096 le {
    data: Array[u8, 4096] at 0
} Block

fn say(text: Str) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in text.as_bytes() {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say

fn rate(level: u32) -> u32 {
    return 1_000 / level
} rate

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    let clock = k.clock()
    let functions = mut k.pci_functions()
    let Some(iommu) = mut k.iommu() else {
        say(text: "iommu: none\n")
        loop {
        }
    }
    say(text: "iommu: enabled\n")
    let drawing = new_domain(iommu)
    let abandoning = new_domain(iommu)
    take k.anchor(0u8, run: fn[take iommu, take functions, take drawing, take abandoning](exec: task::Executor) fails task::Cancelled uses wait limits stack 2_228_224 {
        let faults = watched(iommu)
        var entropy = mem::List[hw::PciFunction].empty(alloc)
        var others = mem::List[hw::PciFunction].empty(alloc)
        for function in take functions {
            if rng::is_entropy(function) {
                mut entropy.push(take function)
            } else {
                mut others.push(take function)
            }
        }
        grouped(take others, iommu, alloc)
        match mut entropy.pop() {
            Some(function) => confined(take function, domain: take drawing, alloc, iommu, faults)
            None => {
                say(text: "pci: no entropy function\n")
                take drawing.close()
            }
        }
        let next = mut entropy.pop()
        release(take entropy)
        match next {
            Some(function) => {
                discard attempt await abandoned(take function, domain: take abandoning, exec, alloc, clock)
            }
            None => {
                say(text: "pci: no second entropy function\n")
                take abandoning.close()
            }
        }
        discard take faults.uninstall()
        take iommu.release()
    })
} main

/// A domain of the IOMMU; the kernel stops here when it has none.
fn new_domain(iommu: hw::Iommu) -> hw::IoDomain {
    match attempt iommu.domain() {
        Ok(created) => return created
        Err(_) => {
            say(text: "iommu: no domain\n")
            loop {
            }
        }
    }
} new_domain

/// A count of the IOMMU's fault interrupts installed on it; the kernel stops here when the IOMMU
/// refuses it.
fn watched(iommu: hw::Iommu) -> hw::IrqShared[u64] {
    match iommu.fault_irq(dev: 0u64, on_irq: faulted) {
        Ok(shared) => return shared
        Err(_) => {
            say(text: "iommu: no fault interrupt\n")
            loop {
            }
        }
    }
} watched

interrupt fn faulted(mut count: u64, take irq: hw::IrqContext) -> hw::IrqExit limits stack 1_024 {
    count = count.wrapping_add(1)
    take irq.complete()
    return hw::IrqExit.Resume
} faulted

/// The interrupts an installed count has counted.
fn count_of(shared: hw::IrqShared[u64]) -> u64 {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> u64 limits notrap, terminates {
        return shared.with(t, body: fn(mut count: u64) -> u64 limits notrap, terminates, noalloc {
            return count
        })
    })
} count_of

fn release(take functions: mem::List[hw::PciFunction]) {
    for function in take functions {
        take function.release()
    }
} release

/// Takes the first two functions of one device, which has no ACS capability and so makes them
/// one group: once the first is attached to a domain, the second is refused another and attaches
/// to the first's.
fn grouped(take functions: mem::List[hw::PciFunction], iommu: hw::Iommu, alloc: mem::Alloc) {
    var pair = mem::List[hw::PciFunction].empty(alloc)
    var device = hw::PciAddress(segment: 0, bus: 0, device: 0, function: 0)
    for function in take functions {
        let at = function.address()
        let of = hw::PciAddress(segment: at.segment, bus: at.bus, device: at.device, function: 0)
        if pair.len() == 1 and of == device {
            mut pair.push(take function)
        } else if pair.len() == 2 {
            take function.release()
        } else {
            release(take pair)
            pair = mem::List[hw::PciFunction].empty(alloc)
            mut pair.push(take function)
            device = of
        }
    }
    let Some(two) = mut pair.pop() else {
        say(text: "pci: no two functions of one device\n")
        release(take pair)
        return
    }
    let Some(one) = mut pair.pop() else {
        say(text: "pci: no two functions of one device\n")
        take two.release()
        release(take pair)
        return
    }
    release(take pair)
    var earlier = one
    var later = two
    let held = new_domain(iommu)
    let other = new_domain(iommu)
    let shared = earlier.group() == later.group()
    let attached = (attempt mut earlier.attach(held.space())).is_ok()
    let refused = attempt mut later.attach(other.space())
    let joined = (attempt mut later.attach(held.space())).is_ok()
    if shared and attached and refused == Err(hw::IommuError.Grouped) and joined {
        say(text: "group: a device's functions without ACS attach to one domain, which holds the group alone\n")
    }
    take earlier.release()
    take later.release()
    take held.close()
    take other.close()
} grouped

/// Draws entropy through a buffer of its domain, counts the queue's MSI-X interrupt, then aims
/// the device at a buffer outside the domain.
fn confined(take function: hw::PciFunction, take domain: hw::IoDomain, alloc: mem::Alloc, iommu: hw::Iommu, faults: hw::IrqShared[u64]) {
    let space = domain.space()
    let address = function.address()
    match rng::start(take function, space, alloc) {
        Ok(started) => {
            var device = started
            if (attempt mut device.draw(space, alloc)).is_ok() {
                say(text: "rng: drew 32 bytes through a domain buffer\n")
            }
            pooled(mut device, space, alloc)
            interrupted(mut device, space, alloc)
            outside(mut device, alloc, iommu, faults, address)
            let stopped = take device.stop()
            take stopped.release()
        }
        Err(refused) => {
            say(text: "rng: did not start\n")
            take refused.release()
        }
    }
    take domain.close()
} confined

/// Draws entropy into a pool of the domain at the end of its first 2 MiB and the start of the
/// page after them, then into its start once the pool is unmapped, and restarts the device.
fn pooled(mut device: rng::Rng, space: hw::IoSpace, alloc: mem::Alloc) {
    let heap = mem::Heap.of(alloc)
    let pool = hw::Dma.of(heap.boxed(Array[u8, 2_101_248].filled(FILL)), space)
    let bus = pool.bus_addr().value
    let ends = (attempt mut device.request(bus + LARGE - u64.widen(rng::DRAWN))).is_ok() and (attempt mut device.request(bus + LARGE)).is_ok()
    let kept = take pool.into_box()
    let bytes = kept.contents().view()
    if bus % LARGE == 0 and ends and drawn(bytes, at: LARGE - u64.widen(rng::DRAWN)) and drawn(bytes, at: LARGE) {
        say(text: "pool: drew into both sides of the 2 MiB boundary of a 2 MiB-aligned domain buffer\n")
    }
    if (attempt mut device.request(bus)).is_ok() and not drawn(bytes, at: 0) {
        say(text: "pool: the device's write to the unmapped pool changed nothing\n")
    }
    discard attempt mut device.reset()
} pooled

/// Whether the device wrote any of the `rng::DRAWN` bytes from `at`.
fn drawn(bytes: Slice[u8], at: u64) -> bool {
    for index in 0..<u64.widen(rng::DRAWN) {
        if bytes[usize.widen(at + index)] != FILL {
            return true
        }
    }
    return false
} drawn

/// Draws entropy with the queue's completions raising MSI-X entry 0, and reports whether the
/// interrupt arrived within `INTERRUPT_POLLS` polls of its count.
fn interrupted(mut device: rng::Rng, space: hw::IoSpace, alloc: mem::Alloc) {
    let Some(shared) = mut device.count_interrupts() else {
        say(text: "msi-x: refused\n")
        return
    }
    mut device.signal_used()
    discard attempt mut device.draw(space, alloc)
    var counted: u64 = 0
    for _ in 0..<INTERRUPT_POLLS {
        counted = count_of(shared)
        if counted > 0 {
            break
        }
    }
    if counted > 0 {
        say(text: "msi-x: the queue's interrupt arrived from the confined driver\n")
    }
    discard take shared.uninstall()
} interrupted

/// Restarts the device and asks it to write a buffer of physical memory its domain does not
/// map, then checks the buffer kept its contents once the device has served the request, and
/// that the IOMMU's fault interrupt arrived with the write as the first fault since the earlier
/// ones, under the device's requester id or, below a PCIe-to-PCI bridge, the one the bridge
/// gives its secondary bus.
fn outside(mut device: rng::Rng, alloc: mem::Alloc, iommu: hw::Iommu, faults: hw::IrqShared[u64], address: hw::PciAddress) {
    while iommu.fault().is_some() {
    }
    let before = count_of(faults)
    let heap = mem::Heap.of(alloc)
    let target = hw::Dma.of(heap.boxed(rng::Entropy.from_bits(Array[u8, 32].filled(FILL))), space: hw::IoSpace.physical())
    let bus = target.bus_addr().value
    var served = false
    if (attempt mut device.reset()).is_ok() {
        served = (attempt mut device.request(bus)).is_ok()
    }
    let kept = take target.into_box()
    if served and untouched(kept.contents().data.view()) {
        say(text: "fault: the device's write to an unmapped bus address changed nothing\n")
    }
    var signalled = false
    for _ in 0..<INTERRUPT_POLLS {
        if count_of(faults) > before {
            signalled = true
            break
        }
    }
    let touched = bus - bus % PAGE
    let bridged = hw::PciAddress(segment: address.segment, bus: address.bus, device: 0, function: 0)
    let fault = iommu.fault()
    if signalled and (fault == Some(hw::DmaFault(function: address, address: touched, write: true)) or fault == Some(hw::DmaFault(function: bridged, address: touched, write: true))) {
        say(text: "fault: the IOMMU's interrupt reported the write with the device's requester id and the page it reached\n")
    }
} outside

/// Starts a second driver in a domain of the kernel that traps once its request is posted, then
/// fills memory the settlement freed and checks it keeps its contents.
fn abandoned(take function: hw::PciFunction, take domain: hw::IoDomain, exec: task::Executor, alloc: mem::Alloc, clock: sys::Clock) fails task::Cancelled uses wait {
    let level = hw::cpu_count() / 8
    let ended = try await sys::Domain.run(fn[take function, take domain]() -> u32 limits stack 16_384 {
        let space = domain.space()
        var device = match rng::start(take function, space, alloc) {
            Ok(started) => started
            Err(refused) => {
                take refused.release()
                take domain.close()
                return 0
            }
        }
        let heap = mem::Heap.of(alloc)
        let buffer = hw::Dma.of(heap.boxed(rng::Entropy.from_bits(Array[u8, 32].filled(0))), space)
        mut device.post(buffer.bus_addr().value)
        let rated = rate(level)
        discard take buffer.into_box()
        let stopped = take device.stop()
        take stopped.release()
        take domain.close()
        return rated
    }, exec, alloc)
    if ended.is_ok() {
        say(text: "abandoned: the domain returned\n")
        return
    }
    let heap = mem::Heap.of(alloc)
    var blocks = mem::List[mem::Box[Block]].empty(alloc)
    for _ in 0u32..<16 {
        mut blocks.push(heap.boxed(Block.from_bits(Array[u8, 4096].filled(FILL))))
    }
    try await clock.sleep_ns(PAUSE_NS)
    var kept = true
    for block in blocks.view() {
        kept = kept and untouched(block.contents().data.view())
    }
    if kept {
        say(text: "abandoned: settlement cut the device off and its memory kept what it was reused for\n")
    }
} abandoned

/// Whether every byte of a view is `FILL`.
fn untouched(bytes: Slice[u8]) -> bool {
    for byte in bytes {
        if byte != FILL {
            return false
        }
    }
    return true
} untouched
