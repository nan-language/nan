//! Tests of the lowering.

/// The shape of the expression returned by the first statement of the first item of `source`, a
/// function.
fn returned_shape(source: Str, grammar: syntax::Grammar, alloc: mem::Alloc) -> text::String {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append("//! Test.\n\n".as_bytes())
    mut bytes.append(source.as_bytes())
    let file = syntax::parse(take bytes, grammar, alloc)
    expect file.diagnostics.len() == 0
    var shape = text::String.empty(alloc)
    for item in file.items {
        let Some(tree) = item.tree else {
            continue
        }
        let Some(lowered) = lower(file, tree, alloc) else {
            continue
        }
        let ItemKind.Fn(function) = lowered.kind else {
            expect false
            return shape
        }
        let FnBody.Block(block) = function.body else {
            expect false
            return shape
        }
        expect block.stmts.len() > 0
        let StmtKind.Expr(Expr(token: _, last: _, kind: ExprKind.Return(Some(value)))) = block.stmts[0].kind else {
            expect false
            return shape
        }
        write_shape(value.contents(), out: mut shape, alloc)
        return shape
    }
    expect false
    return shape
} returned_shape

/// Writes the expression's operators by name and its operands as paths or `lit`.
fn write_shape(expr: Expr, mut out: text::String, alloc: mem::Alloc) {
    match expr.kind {
        ExprKind.Binary(op: op, op_token: _, left: left, right: right) => {
            mut out.push('(')
            write_shape(left.contents(), mut out, alloc)
            mut out.push(' ')
            write_binary(op, mut out)
            mut out.push(' ')
            write_shape(right.contents(), mut out, alloc)
            mut out.push(')')
        }
        ExprKind.Unary(op: op, operand: operand) => {
            mut out.push('(')
            write_unary(op, mut out)
            mut out.push(' ')
            write_shape(operand.contents(), mut out, alloc)
            mut out.push(')')
        }
        ExprKind.Path(path: path, args: _) => {
            let written = path.written(alloc)
            mut out.append(written.as_str())
        }
        ExprKind.Literal(_) => mut out.append("lit")
        ExprKind.Paren(inner) => write_shape(inner.contents(), mut out, alloc)
        else => mut out.append("?")
    }
} write_shape

fn write_binary(op: BinaryOp, mut out: text::String) {
    match op {
        BinaryOp.Mul => mut out.append("Mul")
        BinaryOp.Div => mut out.append("Div")
        BinaryOp.Rem => mut out.append("Rem")
        BinaryOp.Add => mut out.append("Add")
        BinaryOp.Sub => mut out.append("Sub")
        BinaryOp.Eq => mut out.append("Eq")
        BinaryOp.Ne => mut out.append("Ne")
        BinaryOp.Lt => mut out.append("Lt")
        BinaryOp.Le => mut out.append("Le")
        BinaryOp.Gt => mut out.append("Gt")
        BinaryOp.Ge => mut out.append("Ge")
        BinaryOp.And => mut out.append("And")
        BinaryOp.Or => mut out.append("Or")
        BinaryOp.BitAnd => mut out.append("BitAnd")
        BinaryOp.BitOr => mut out.append("BitOr")
        BinaryOp.BitXor => mut out.append("BitXor")
        BinaryOp.Shl => mut out.append("Shl")
        BinaryOp.Shr => mut out.append("Shr")
        BinaryOp.RangeExclusive => mut out.append("RangeExclusive")
        BinaryOp.RangeInclusive => mut out.append("RangeInclusive")
    }
} write_binary

fn write_unary(op: UnaryOp, mut out: text::String) {
    match op {
        UnaryOp.Neg => mut out.append("Neg")
        UnaryOp.BitNot => mut out.append("BitNot")
        UnaryOp.Not => mut out.append("Not")
    }
} write_unary

/// Expects the expression `written` returns from a function to have the shape `expected`.
fn expect_shape(written: Str, expected: Str, grammar: syntax::Grammar, alloc: mem::Alloc) {
    var source = text::String.of("pub fn f() -> bool {\n    return ", alloc)
    mut source.append(written)
    mut source.append("\n} f\n")
    let shape = returned_shape(source.as_str(), grammar, alloc)
    expect shape.as_str() == expected
} expect_shape

test operators_bind_by_their_precedence for lower {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_shape("a * b + c * a < b", expected: "(((a Mul b) Add (c Mul a)) Lt b)", grammar, alloc)
    expect_shape("a < b and b < c and not d", expected: "(((a Lt b) And (b Lt c)) And (Not d))", grammar, alloc)
    expect_shape("a - b - c", expected: "((a Sub b) Sub c)", grammar, alloc)
    expect_shape("a & b & c", expected: "((a BitAnd b) BitAnd c)", grammar, alloc)
    expect_shape("a + b * c - d", expected: "((a Add (b Mul c)) Sub d)", grammar, alloc)
    expect_shape("(a or d) and -a < b", expected: "((a Or d) And ((Neg a) Lt b))", grammar, alloc)
} operators_bind_by_their_precedence
