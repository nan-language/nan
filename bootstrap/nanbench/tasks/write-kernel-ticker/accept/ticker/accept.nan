//! Acceptance tests of the ticker.

/// A timer status showing `expired`.
fn expiry() -> TimerStatus = TimerStatus(expired: true, reserved: 0)

test every_period_th_tick_is_posted for Ticker.tick {
    let world = testing::world()
    let block = hw::sim::Registers[TimerRegs].of(world.alloc)
    let wake = mem::Shared.of(hw::Signal[u64].empty(), alloc: world.alloc)
    var ticker = Ticker.of(block.mmio(), period: 3, wake)
    var posts: u32 = 0
    for _ in 0..<7u32 {
        block.set(TimerRegs.status, value: expiry())
        let posted = hw::without_irqs(fn[mut ticker](t: hw::IrqsDisabled) -> bool limits notrap {
            return mut ticker.tick(t)
        })
        if posted {
            posts += 1
        }
    }
    let acknowledged = block.last_written(TimerRegs.status)
    let quiet = hw::without_irqs(fn[mut ticker](t: hw::IrqsDisabled) -> bool limits notrap {
        return mut ticker.tick(t)
    })
    detach(attach(take ticker))
    let latest = try await wake.contents().wait()
    expect posts == 2
    expect latest == 6
    expect acknowledged == Some(expiry())
    expect not quiet
} every_period_th_tick_is_posted

test only_expiries_count_as_ticks for Ticker.tick {
    let world = testing::world()
    let block = hw::sim::Registers[TimerRegs].of(world.alloc)
    let wake = mem::Shared.of(hw::Signal[u64].empty(), alloc: world.alloc)
    var ticker = Ticker.of(block.mmio(), period: 2, wake)
    var posts: u32 = 0
    for round in 0..<6u32 {
        if round % 3 != 2 {
            block.set(TimerRegs.status, value: expiry())
        }
        let posted = hw::without_irqs(fn[mut ticker](t: hw::IrqsDisabled) -> bool limits notrap {
            return mut ticker.tick(t)
        })
        if posted {
            posts += 1
        }
    }
    detach(attach(take ticker))
    let latest = try await wake.contents().wait()
    expect posts == 2
    expect latest == 4
} only_expiries_count_as_ticks

test a_zero_period_never_posts for Ticker.tick {
    let world = testing::world()
    let block = hw::sim::Registers[TimerRegs].of(world.alloc)
    let wake = mem::Shared.of(hw::Signal[u64].empty(), alloc: world.alloc)
    var ticker = Ticker.of(block.mmio(), period: 0, wake)
    var posts: u32 = 0
    for _ in 0..<5u32 {
        block.set(TimerRegs.status, value: expiry())
        let posted = hw::without_irqs(fn[mut ticker](t: hw::IrqsDisabled) -> bool limits notrap {
            return mut ticker.tick(t)
        })
        if posted {
            posts += 1
        }
    }
    detach(attach(take ticker))
    let woken = try await task::within(world.clock, ms: 10, body: fn() -> u64 fails task::Cancelled uses wait {
        return try await wake.contents().wait()
    })
    expect posts == 0
    expect woken == None
} a_zero_period_never_posts
