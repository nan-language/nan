//! The Windows entry landing fn, the requests a task waits for and system library functions.

foreign fn GetCommandLineW() -> hw::Ptr[u16] limits stack 256 convention "win64"

foreign fn GetEnvironmentStringsW() -> hw::Ptr[u16] limits stack 16_384 convention "win64"

foreign fn FreeEnvironmentStringsW(block: hw::Ptr[u16]) -> i32 limits stack 16_384 convention "win64"

foreign fn LoadLibraryExW(name: hw::Ptr[u16], file: u64, flags: u32) -> u64 convention "win64"

foreign fn GetProcAddress(module: u64, name: hw::Ptr[u8]) -> u64 convention "win64"

foreign fn GetLastError() -> u32 limits stack 256 convention "win64"

/// The flag of `LoadLibraryExW` searching only the system directory.
const SEARCH_SYSTEM32: u32 = 0x800

/// The most bytes of a system library's or function's name, its NUL excluded.
const NAME_LIMIT: usize = 31

/// Calls the function at an address with nine arguments under the system's calling convention,
/// and gives its result; a function taking fewer arguments ignores the others, and one giving
/// a narrower result leaves the other bits unspecified.
pkg fn call(function: u64, a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, i: u64) -> u64

/// Fills `len` bytes at `buffer` from the system's random generator, `ProcessPrng`, which
/// never fails.
pkg fn generate(buffer: u64, len: usize)

/// Associates a handle opened for overlapped I/O with the completion port, through which the
/// requests on it complete: whether the system accepted.
pkg fn associate(handle: u64) -> bool

/// Reads at most `len` bytes into `buffer` from a handle, or writes `len` bytes from it when
/// `writes`, and gives the count or the negated system error code: through the completion port,
/// or, `blocking`, synchronously on a thread of its own for a handle not opened for overlapped
/// I/O. Cancelling it cancels the transfer and returns only once the system acknowledges.
pkg fn transfer(handle: u64, buffer: u64, len: u32, writes: bool, blocking: bool) -> i64 fails task::Cancelled uses wait

/// Accepts a connection on `listener` into `socket` through the `AcceptEx` at `function`, which
/// writes the connection's addresses in the 88 bytes at `buffer`: 0 or the negated system error
/// code, cancelled as `transfer` is.
pkg fn accept(function: u64, listener: u64, socket: u64, buffer: u64) -> i64 fails task::Cancelled uses wait

/// Connects the bound `socket` to the socket address of `len` bytes at `address` through the
/// `ConnectEx` at `function`: 0 or the negated system error code, cancelled as `transfer` is.
pkg fn connect(function: u64, socket: u64, address: u64, len: u32) -> i64 fails task::Cancelled uses wait

/// The address of the function `name` that the system library `library` exports, the library
/// loaded from the system directory; zero when either is missing.
pkg fn library_function(library: Str, name: Str) -> u64 {
    let wide = wide_name(library)
    let narrow = narrow_name(name)
    let module = LoadLibraryExW(hw::Ptr.of_view(wide.view()), file: 0, flags: SEARCH_SYSTEM32)
    if module == 0 {
        return 0
    }
    return GetProcAddress(module, name: hw::Ptr.of_view(narrow.view()))
} library_function

/// An ASCII name as a NUL-terminated UTF-16 text, empty when it is longer than `NAME_LIMIT`.
pkg fn wide_name(name: Str) -> Array[u16, 32] {
    var wide = Array[u16, 32].filled(0)
    let bytes = name.as_bytes()
    if bytes.len() <= NAME_LIMIT {
        for at in 0..<bytes.len() {
            wide[at] = u16.widen(bytes[at])
        }
    }
    return wide
} wide_name

/// An ASCII name as a NUL-terminated text, empty when it is longer than `NAME_LIMIT`.
fn narrow_name(name: Str) -> Array[u8, 32] {
    var narrow = Array[u8, 32].filled(0)
    let bytes = name.as_bytes()
    if bytes.len() <= NAME_LIMIT {
        for at in 0..<bytes.len() {
            narrow[at] = bytes[at]
        }
    }
    return narrow
} narrow_name

/// The negated code of the calling thread's last error.
pkg fn last_error() -> i64 {
    return -i64.widen(GetLastError())
} last_error

/// A handle the system gives as a word, as the descriptor the runtime keeps: its low 32 bits,
/// which are all that are significant.
pkg fn descriptor(handle: u64) -> i32 = i32.truncate(handle)

/// The handle a descriptor keeps.
pkg fn handle_of(fd: i32) -> u64 = i64.widen(fd).to_bits()

/// The address of a view's first byte.
pkg fn address_of(bytes: Slice[u8]) -> u64 {
    return u64.widen(hw::Ptr.of_view(bytes).addr())
} address_of

/// The host entry landing fn: mints the root grant and gives it the program's arguments and
/// environment, as Untrusted byte strings in UTF-8.
pub landing fn enter() -> host::World limits stack 65_536 {
    var world = hw::mint_root()
    let alloc = world.alloc
    world.args = Untrusted.of(arguments(GetCommandLineW(), alloc))
    var variables = mem::Map[mem::Bytes, mem::Bytes].empty(alloc)
    let block = GetEnvironmentStringsW()
    if block.addr() != 0 {
        var at: isize = 0
        while unit_at(block, at) != 0 {
            var text = mem::Bytes.empty(alloc)
            while unit_at(block, at) != 0 {
                push_char(mut text, text: block, at: mut at)
            }
            add_variable(mut variables, text: take text, alloc)
            at += 1
        }
        discard FreeEnvironmentStringsW(block)
    }
    world.environment = Untrusted.of(take variables)
    return world
} enter

/// The UTF-16 code unit at an index of a NUL-terminated text.
fn unit_at(text: hw::Ptr[u16], at: isize) -> u16 {
    return trusted "the text ends with a NUL unit, which no read passes" { text.offset(at).read() }
} unit_at

/// Whether a code unit is a space or a tab, which separate the command line's arguments.
fn is_blank(unit: u16) -> bool = unit == 0x20 or unit == 0x09

/// The arguments of a command line after the program's name, which ends at the first space or
/// tab outside quotes. Within an argument, a quote toggles quoting and two quotes within quotes
/// are one; 2n backslashes before a quote are n backslashes, 2n + 1 are n and the quote, and
/// backslashes before anything else stay.
fn arguments(line: hw::Ptr[u16], alloc: mem::Alloc) -> mem::List[mem::Bytes] {
    var args = mem::List[mem::Bytes].empty(alloc)
    var at: isize = 0
    var quoted = false
    loop {
        let unit = unit_at(line, at)
        if unit == 0 or (is_blank(unit) and not quoted) {
            break
        }
        if unit == 0x22 {
            quoted = not quoted
        }
        at += 1
    }
    loop {
        while is_blank(unit_at(line, at)) {
            at += 1
        }
        if unit_at(line, at) == 0 {
            return args
        }
        var arg = mem::Bytes.empty(alloc)
        quoted = false
        loop {
            let unit = unit_at(line, at)
            if unit == 0 or (is_blank(unit) and not quoted) {
                break
            }
            if unit == 0x5C {
                var slashes: usize = 0
                while unit_at(line, at) == 0x5C {
                    slashes += 1
                    at += 1
                }
                var kept = slashes
                if unit_at(line, at) == 0x22 {
                    kept = slashes / 2
                }
                for _ in 0..<kept {
                    mut arg.push(b'\\')
                }
                if unit_at(line, at) == 0x22 and slashes % 2 == 1 {
                    mut arg.push(b'"')
                    at += 1
                }
            } else if unit == 0x22 {
                if quoted and unit_at(line, at: at + 1) == 0x22 {
                    mut arg.push(b'"')
                    at += 2
                } else {
                    quoted = not quoted
                    at += 1
                }
            } else {
                push_char(mut arg, text: line, at: mut at)
            }
        }
        mut args.push(take arg)
    }
} arguments

/// Appends to bytes the UTF-8 encoding of the character a UTF-16 text holds at `at`, which it
/// moves past it: a surrogate pair as one code point, an unpaired surrogate as its own three
/// bytes.
fn push_char(mut bytes: mem::Bytes, text: hw::Ptr[u16], mut at: isize) {
    let unit = u32.widen(unit_at(text, at))
    at += 1
    var point = unit
    if unit >= 0xD800 and unit < 0xDC00 {
        let low = u32.widen(unit_at(text, at))
        if low >= 0xDC00 and low < 0xE000 {
            point = 0x1_0000 + ((unit - 0xD800) << 10) + (low - 0xDC00)
            at += 1
        }
    }
    if point < 0x80 {
        mut bytes.push(u8.truncate(point))
    } else if point < 0x800 {
        mut bytes.push(u8.truncate(0xC0 | (point >> 6)))
        mut bytes.push(u8.truncate(0x80 | (point & 0x3F)))
    } else if point < 0x1_0000 {
        mut bytes.push(u8.truncate(0xE0 | (point >> 12)))
        mut bytes.push(u8.truncate(0x80 | ((point >> 6) & 0x3F)))
        mut bytes.push(u8.truncate(0x80 | (point & 0x3F)))
    } else {
        mut bytes.push(u8.truncate(0xF0 | (point >> 18)))
        mut bytes.push(u8.truncate(0x80 | ((point >> 12) & 0x3F)))
        mut bytes.push(u8.truncate(0x80 | ((point >> 6) & 0x3F)))
        mut bytes.push(u8.truncate(0x80 | (point & 0x3F)))
    }
} push_char

/// Adds a `NAME=value` environment entry, split at its first `=` after its first byte, which
/// may be one; a text without such a `=` names an empty value.
fn add_variable(mut variables: mem::Map[mem::Bytes, mem::Bytes], take text: mem::Bytes, alloc: mem::Alloc) {
    let view = text.view()
    var split = view.len()
    for at in 1..<view.len() {
        if view[at] == b'=' and split == view.len() {
            split = at
        }
    }
    var name = mem::Bytes.empty(alloc)
    var value = mem::Bytes.empty(alloc)
    for at in 0..<view.len() {
        if at < split {
            mut name.push(view[at])
        } else if at > split {
            mut value.push(view[at])
        }
    }
    discard mut variables.insert(take name, take value)
} add_variable
