test pool_get_mut_reaches_live_entries for Pool.get_mut {
    let world = testing::world()
    var buffers = Pool[Bytes, Unit].empty(world.alloc)
    let handle = mut buffers.insert(Bytes.empty(world.alloc))
    match mut buffers.get_mut(handle) {
        Some(found) => {
