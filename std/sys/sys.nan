        try await inbox.post(ProbeMessage.DelayNs)
        try await clock.sleep_ns(1_700)
    })
    let patient = try await host::Runner[Probe].run(ProbeEnv(clock: clock, counted: 0), exec, alloc: world.alloc, body: fn(inbox: Outbox[ProbeMessage]) fails task::SendError uses wait {
        try await inbox.post(ProbeMessage.DelayNs)
        try await clock.sleep_ns(2_150)
    })
    expect hurried.handled == 0
    expect patient.handled == 1
} coarse_executor_delays_to_its_resolution

