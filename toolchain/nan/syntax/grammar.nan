/// The punctuation and operator tokens, in the order the grammar lists them.
pkg enum Punct derives Copy, Eq {
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    ColonColon
    Dot
    Arrow
    FatArrow
    Eq
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    AmpEq
    PipeEq
    CaretEq
    ShlEq
    ShrEq
    Plus
    Minus
    Star
    Slash
    Percent
    Amp
    Pipe
    Caret
    Tilde
    Shl
    Shr
    EqEq
    NotEq
    Lt
    Le
    Gt
    Ge
    DotDotLt
    DotDotEq
} Punct

/// The token as source spells it.
pkg proj fn Punct.spelling(self) -> Str {
    return match self {
        Punct.LParen => "("
        Punct.RParen => ")"
        Punct.LBracket => "["
        Punct.RBracket => "]"
        Punct.LBrace => "{"
        Punct.RBrace => "}"
        Punct.Comma => ","
        Punct.Colon => ":"
        Punct.ColonColon => "::"
        Punct.Dot => "."
        Punct.Arrow => "->"
        Punct.FatArrow => "=>"
        Punct.Eq => "="
        Punct.PlusEq => "+="
        Punct.MinusEq => "-="
        Punct.StarEq => "*="
        Punct.SlashEq => "/="
        Punct.PercentEq => "%="
        Punct.AmpEq => "&="
        Punct.PipeEq => "|="
        Punct.CaretEq => "^="
        Punct.ShlEq => "<<="
        Punct.ShrEq => ">>="
        Punct.Plus => "+"
        Punct.Minus => "-"
        Punct.Star => "*"
        Punct.Slash => "/"
        Punct.Percent => "%"
        Punct.Amp => "&"
        Punct.Pipe => "|"
        Punct.Caret => "^"
        Punct.Tilde => "~"
        Punct.Shl => "<<"
        Punct.Shr => ">>"
        Punct.EqEq => "=="
        Punct.NotEq => "!="
        Punct.Lt => "<"
        Punct.Le => "<="
        Punct.Gt => ">"
        Punct.Ge => ">="
        Punct.DotDotLt => "..<"
        Punct.DotDotEq => "..="
    }
} Punct.spelling

/// The position of the token in the order the grammar lists them.
fn Punct.index(self) -> usize {
    return match self {
        Punct.LParen => 0
        Punct.RParen => 1
        Punct.LBracket => 2
        Punct.RBracket => 3
        Punct.LBrace => 4
        Punct.RBrace => 5
        Punct.Comma => 6
        Punct.Colon => 7
