//! Averages readings with floats and lanes, in its own task and in tasks it starts, and reports through its world's log, random source, standard output, file system and network, finding the hosts its network does not reach denied.

pub closed struct Readings derives Encode {
    pub values: mem::List[u32]
} Readings

pub closed struct Summary derives Encode {
    pub mean_milli: u64
    pub lanes: u64
    pub entropy: u64
} Summary

pub closed enum AverageError derives Render {
    Empty
    Revoked(sys::Revoked) from
    Stdio(sys::StdioError) from
    Fs(sys::fs::FsError) from
    Net(sys::net::NetError) from
    Cancelled(task::Cancelled) from
} AverageError

/// The sum of `count` steps of a float series, pausing between steps so that other tasks run.
fn series(clock: sys::Clock, step: f64, count: u32) -> f64 fails task::Cancelled uses wait {
    var total: f64 = 0.0
    for _ in 0..<count {
        total += step
        try await clock.sleep_ns(10_000)
    }
    return total
} series

/// Whether `net` denies a connection to `host`, abandoning one it opens.
fn denies(net: sys::Net, host: Str) -> bool fails task::Cancelled uses wait {
    let outcome = attempt await net.connect(host, port: 7)
    var denied = false
    match outcome {
        Ok(conn) => take conn.abandon()
        Err(failure) => {
            denied = match failure {
                sys::net::NetError.Denied => true
                else => false
            }
        }
    }
    return denied
} denies

/// Sends `data` to `host` and closes the connection.
fn send(net: sys::Net, host: Str, data: Slice[u8]) fails sys::net::NetError uses wait {
    var conn = try await net.connect(host, port: 7)
    defer take conn.abandon()
    discard try await mut conn.write(data)
    undefer conn
    try await take conn.close()
} send

fn main(take world: nanos::World, take input: Readings) -> Summary fails AverageError uses wait limits stack 65_536 {
    if input.values.len() == 0 {
        fail AverageError.Empty
    }
    var total: f64 = 0.0
    for value in input.values {
        total += f64.widen(value)
    }
    let mean = total / f64.fit(input.values.len())
    let lanes = core::simd::F32x4.splat(1.5).mul(core::simd::F32x4.of(Array[f32, 4].filled(2.0))).sum()
    let clock = world.clock
    let log = world.log
    try await task::scope(world.exec, body: fn(s: task::Scope) fails task::Cancelled uses wait {
        let quarters = s.spawn(fn() -> f64 fails task::Cancelled uses wait limits stack 16_384 {
            return try await series(clock, step: 0.25, count: 20)
        })
        let halves = s.spawn(fn() -> f64 fails task::Cancelled uses wait limits stack 16_384 {
            return try await series(clock, step: 0.5, count: 20)
        })
        let quartered = try await take quarters.join()
        let halved = try await take halves.join()
        log.info("series", value: u64.saturate((quartered + halved) * 100.0))
    })
    var bytes = Array[u8, 8].filled(0)
    try world.random.fill(mut bytes.view_mut())
    world.log.info("mean", value: u64.fit(mean))
    let readings = try await world.fs.read_all("readings", alloc: world.alloc)
    world.log.info("fs read", value: readings.byte_len())
    var summary = try await world.fs.create("summary")
    discard try await mut summary.write(b"mean")
    let elsewhere = try await denies(world.net, host: "10.0.0.3")
    world.log.warn("net denied", value: elsewhere)
    try await send(world.net, host: "10.0.0.2", data: b"ping")
    try await world.stdio.write_out(b"averaged\n")
    return Summary(mean_milli: u64.saturate(mean * 1000.0), lanes: u64.fit(lanes), entropy: bytes.view().u64_le(0))
} main
