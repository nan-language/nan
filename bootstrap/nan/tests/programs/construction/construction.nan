//! Encodes and renders a number through its named schema within a stack limit.

pub fn encoded(text: Str, alloc: mem::Alloc) -> usize limits stack 65_536 {
    let schema = mem::wire::NamedSchema(tree: mem::wire::Codec[u32].schema(alloc), names: mem::List.empty(alloc))
    return match attempt text::construction::encode_as(schema, raw: Untrusted.of(text.as_bytes()), alloc) {
        Ok(bytes) => bytes.len()
        Err(_) => 0
    }
} encoded

pub fn rendered(take raw: Slice[u8], alloc: mem::Alloc) -> usize limits stack 65_536 {
    let schema = mem::wire::NamedSchema(tree: mem::wire::Codec[u32].schema(alloc), names: mem::List.empty(alloc))
    var out = text::String.empty(alloc)
    return match attempt text::construction::render_as(schema, raw: Untrusted.of(take raw), alloc, mut out) {
        Ok(_) => out.byte_len()
        Err(_) => 0
    }
} rendered

fn main(take world: host::World) fails task::Cancelled uses wait {
    world.log.info("encoded", value: encoded("300", alloc: world.alloc))
    world.log.info("rendered", value: rendered(b"\xAC\x02", alloc: world.alloc))
} main
