//! The principals file `.nan/principals.nan`: the public key each principal of a package signs its seals with.

pkg struct Principals derives Eq {
    /// In byte order of principal.
    pkg keys: mem::List[Trusted]
} Principals

/// A principal and the public key the file gives it.
pkg struct Trusted derives Eq {
    pkg principal: text::String
    pkg key: core::crypto::PublicKey
} Trusted

pkg fn Principals.empty(alloc: mem::Alloc) -> Principals = Principals(keys: mem::List[Trusted].empty(alloc))

/// Whether a text is a principal: 1 to 64 characters, each an ASCII letter, digit, `.`, `_`, `-`
/// or `@`.
pkg fn is_principal(written: Str) -> bool {
    let bytes = written.as_bytes()
    if bytes.len() == 0 or bytes.len() > 64 {
        return false
    }
    for byte in bytes {
        let letter = (byte >= b'a' and byte <= b'z') or (byte >= b'A' and byte <= b'Z')
        let digit = byte >= b'0' and byte <= b'9'
        if not letter and not digit and byte != b'.' and byte != b'_' and byte != b'-' and byte != b'@' {
            return false
        }
    }
    return true
} is_principal

/// The public key the file gives a principal.
pkg fn Principals.key(self, principal: Str) -> Option[core::crypto::PublicKey] {
    for held in self.keys {
        if held.principal.as_str() == principal {
            return Some(held.key)
        }
    }
    return None
} Principals.key

/// The file giving a principal a key, replacing the key it gave it.
pkg fn Principals.trusting(self, principal: Str, key: core::crypto::PublicKey, alloc: mem::Alloc) -> Principals {
    var keys = mem::List[Trusted].empty(alloc)
    var placed = false
    for held in self.keys {
        if not placed and principal < held.principal.as_str() {
            mut keys.push(Trusted(principal: text::String.of(principal, alloc), key: key))
            placed = true
        }
        if held.principal.as_str() != principal {
            mut keys.push(Trusted(principal: text::String.of(held.principal.as_str(), alloc), key: held.key))
        }
    }
    if not placed {
        mut keys.push(Trusted(principal: text::String.of(principal, alloc), key: key))
    }
    return Principals(keys: take keys)
} Principals.trusting

pkg fn Principals.bytes(self, grammar: syntax::Grammar, alloc: mem::Alloc) -> Option[mem::Bytes] {
    var lines = mem::List[text::String].empty(alloc)
    for held in self.keys {
        var line = keyed("principal", value: escaped(held.principal.as_str(), grammar, alloc).as_str(), alloc)
        mut line.push(' ')
        mut line.append(escaped(sign::key_form(held.key, alloc).as_str(), grammar, alloc).as_str())
        mut lines.push(take line)
    }
    return write(Kind.Principals, lines: lines.view(), alloc)
} Principals.bytes

pkg fn Principals.read(bytes: Slice[u8], grammar: syntax::Grammar, alloc: mem::Alloc) -> Result[Principals, Invalid] {
    let parsed = match read(Kind.Principals, bytes, grammar, alloc) {
        Ok(found) => found
        Err(invalid) => return Err(invalid)
    }
    var principals = Principals.empty(alloc)
    for record in parsed.records {
        let invalid = Invalid.at(record.line)
        var cursor = record.cursor(alloc)
        let taken = mut cursor.takes("principal")
        if not taken {
            return Err(invalid)
        }
        let Some(principal) = mut cursor.text() else {
            return Err(invalid)
        }
        let Some(written) = mut cursor.text() else {
            return Err(invalid)
        }
        let Some(key) = sign::read_key(written.as_str(), alloc) else {
            return Err(invalid)
        }
        let count = principals.keys.len()
        let after = count == 0 or principals.keys[count - 1].principal < principal
        if not is_principal(principal.as_str()) or not cursor.done() or not after {
            return Err(invalid)
        }
        mut principals.keys.push(Trusted(principal: take principal, key: key))
    }
    return parsed.checked(take principals)
} Principals.read
