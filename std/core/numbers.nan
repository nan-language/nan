//! Integer overflow alternatives, division, shifts, bit counts and wide products, and floats.

pub closed struct Overflowing[T: Copy and Eq] derives Copy, Eq {
    pub value: T
    pub overflowed: bool
} Overflowing

pub closed struct WideProduct[T: Copy and Eq] derives Copy, Eq {
    pub high: T
    pub low: u64
} WideProduct

pub fn u8.wrapping_add(self, other: u8) -> u8 limits pure, notrap, terminates
    example (~0u8).wrapping_add(1) == 0

pub fn u8.wrapping_sub(self, other: u8) -> u8 limits pure, notrap, terminates
    example 0u8.wrapping_sub(1) == (~0u8)

pub fn u8.wrapping_mul(self, other: u8) -> u8 limits pure, notrap, terminates
    example (~0u8).wrapping_mul(2) == (~1u8)

pub fn u8.overflowing_add(self, other: u8) -> Overflowing[u8] limits pure, notrap, terminates
    example (~0u8).overflowing_add(1) == Overflowing(value: 0, overflowed: true)
{
    let value = self.wrapping_add(other)
    return Overflowing(value: value, overflowed: value < self)
} u8.overflowing_add

pub fn u8.checked_add(self, other: u8) -> Option[u8] limits pure, notrap, terminates
    example (~0u8).checked_add(1) == None
{
    let sum = self.overflowing_add(other)
    if sum.overflowed {
        return None
    }
    return Some(sum.value)
} u8.checked_add

pub fn u8.saturating_add(self, other: u8) -> u8 limits pure, notrap, terminates
    example (~0u8).saturating_add(1) == (~0u8)
{
    let sum = self.overflowing_add(other)
    if sum.overflowed {
        return ~0u8
    }
    return sum.value
} u8.saturating_add

pub fn u8.overflowing_sub(self, other: u8) -> Overflowing[u8] limits pure, notrap, terminates
    example 0u8.overflowing_sub(1) == Overflowing(value: ~0u8, overflowed: true)
{
    return Overflowing(value: self.wrapping_sub(other), overflowed: other > self)
} u8.overflowing_sub

pub fn u8.checked_sub(self, other: u8) -> Option[u8] limits pure, notrap, terminates
    example 0u8.checked_sub(1) == None
{
    if other > self {
        return None
    }
    return Some(self - other)
} u8.checked_sub

pub fn u8.saturating_sub(self, other: u8) -> u8 limits pure, notrap, terminates
    example 0u8.saturating_sub(1) == 0
{
    if other > self {
        return 0
    }
    return self - other
} u8.saturating_sub

pub fn u8.overflowing_mul(self, other: u8) -> Overflowing[u8] limits pure, notrap, terminates
    example (~0u8).overflowing_mul(2) == Overflowing(value: ~1u8, overflowed: true)
{
    let wide = u64.widen(self).wide_mul(u64.widen(other))
    return Overflowing(value: u8.truncate(wide.low), overflowed: wide.low > 255)
} u8.overflowing_mul

pub fn u8.checked_mul(self, other: u8) -> Option[u8] limits pure, notrap, terminates
    example (~0u8).checked_mul(2) == None
{
    let product = self.overflowing_mul(other)
    if product.overflowed {
        return None
    }
    return Some(product.value)
} u8.checked_mul

pub fn u8.saturating_mul(self, other: u8) -> u8 limits pure, notrap, terminates
    example (~0u8).saturating_mul(2) == (~0u8)
{
    let product = self.overflowing_mul(other)
    if product.overflowed {
        return ~0u8
    }
    return product.value
} u8.saturating_mul

pub fn u8.count_ones(self) -> u32 limits pure, notrap, terminates
    ensures result <= 8
    example 0b1011u8.count_ones() == 3

pub fn u8.leading_zeros(self) -> u32 limits pure, notrap, terminates
    ensures result <= 8
    example 0u8.leading_zeros() == 8

pub fn u8.trailing_zeros(self) -> u32 limits pure, notrap, terminates
    ensures result <= 8
    example 8u8.trailing_zeros() == 3

