    return -32_768
} i16.saturating_sub

pub fn i16.overflowing_mul(self, other: i16) -> Overflowing[i16] limits pure, notrap, terminates
    example (-2i16).overflowing_mul(3) == Overflowing(value: -6, overflowed: false)
{
    let exact = i64.from_bits(i64.widen(self).wide_mul(i64.widen(other)).low)
    let overflowed = exact < -32_768 or exact > 32_767
    return Overflowing(value: i16.truncate(exact), overflowed: overflowed)
} i16.overflowing_mul

pub fn i16.checked_mul(self, other: i16) -> Option[i16] limits pure, notrap, terminates
    example (-2i16).checked_mul(3) == Some(-6)
