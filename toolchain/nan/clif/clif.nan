/// A branch's target block with the values its parameters receive.
pkg struct BlockCall derives Eq, Hash {
    pkg block: Block
    pkg args: mem::List[Value]
} BlockCall

/// An instruction, in the format its opcode has.
pkg enum InstructionData derives Eq, Hash {
    UnaryImm(opcode: Opcode, imm: i64)
    UnaryIeee32(opcode: Opcode, bits: u32)
    UnaryIeee64(opcode: Opcode, bits: u64)
    Unary(opcode: Opcode, arg: Value)
    Binary(opcode: Opcode, x: Value, y: Value)
    Ternary(opcode: Opcode, x: Value, y: Value, z: Value)
    IntCompare(opcode: Opcode, cond: IntCC, x: Value, y: Value)
    FloatCompare(opcode: Opcode, cond: FloatCC, x: Value, y: Value)
    Load(opcode: Opcode, flags: MemFlags, arg: Value, offset: i32)
    Store(opcode: Opcode, flags: MemFlags, x: Value, p: Value, offset: i32)
    LoadNoOffset(opcode: Opcode, flags: MemFlags, arg: Value)
    StoreNoOffset(opcode: Opcode, flags: MemFlags, x: Value, p: Value)
    AtomicRmw(opcode: Opcode, flags: MemFlags, op: AtomicRmwOp, p: Value, x: Value)
    AtomicCas(opcode: Opcode, flags: MemFlags, p: Value, e: Value, x: Value)
    NullAry(opcode: Opcode)
    StackLoad(opcode: Opcode, slot: StackSlot, offset: i32)
    UnaryGlobalValue(opcode: Opcode, global_value: GlobalValue)
    FuncAddr(opcode: Opcode, func_ref: FuncRef)
    Call(opcode: Opcode, func_ref: FuncRef, args: mem::List[Value])
    CallIndirect(opcode: Opcode, sig_ref: SigRef, callee: Value, args: mem::List[Value])
    MultiAry(opcode: Opcode, args: mem::List[Value])
    Jump(opcode: Opcode, destination: BlockCall)
    Brif(opcode: Opcode, arg: Value, then: BlockCall, otherwise: BlockCall)
    Trap(opcode: Opcode, code: TrapCode)
} InstructionData

pkg fn InstructionData.opcode(self) -> Opcode {
    return match self {
        InstructionData.UnaryImm(opcode: opcode, imm: _) => opcode
        InstructionData.UnaryIeee32(opcode: opcode, bits: _) => opcode
        InstructionData.UnaryIeee64(opcode: opcode, bits: _) => opcode
        InstructionData.Unary(opcode: opcode, arg: _) => opcode
        InstructionData.Binary(opcode: opcode, x: _, y: _) => opcode
        InstructionData.Ternary(opcode: opcode, x: _, y: _, z: _) => opcode
        InstructionData.IntCompare(opcode: opcode, cond: _, x: _, y: _) => opcode
        InstructionData.FloatCompare(opcode: opcode, cond: _, x: _, y: _) => opcode
        InstructionData.Load(opcode: opcode, flags: _, arg: _, offset: _) => opcode
        InstructionData.Store(opcode: opcode, flags: _, x: _, p: _, offset: _) => opcode
        InstructionData.LoadNoOffset(opcode: opcode, flags: _, arg: _) => opcode
        InstructionData.StoreNoOffset(opcode: opcode, flags: _, x: _, p: _) => opcode
        InstructionData.AtomicRmw(opcode: opcode, flags: _, op: _, p: _, x: _) => opcode
        InstructionData.AtomicCas(opcode: opcode, flags: _, p: _, e: _, x: _) => opcode
        InstructionData.NullAry(opcode: opcode) => opcode
        InstructionData.StackLoad(opcode: opcode, slot: _, offset: _) => opcode
        InstructionData.UnaryGlobalValue(opcode: opcode, global_value: _) => opcode
        InstructionData.FuncAddr(opcode: opcode, func_ref: _) => opcode
        InstructionData.Call(opcode: opcode, func_ref: _, args: _) => opcode
        InstructionData.CallIndirect(opcode: opcode, sig_ref: _, callee: _, args: _) => opcode
        InstructionData.MultiAry(opcode: opcode, args: _) => opcode
        InstructionData.Jump(opcode: opcode, destination: _) => opcode
        InstructionData.Brif(opcode: opcode, arg: _, then: _, otherwise: _) => opcode
        InstructionData.Trap(opcode: opcode, code: _) => opcode
    }
} InstructionData.opcode

/// The operand whose type is the controlling type of a polymorphic opcode, when the format
/// designates one.
fn InstructionData.typevar_operand(self) -> Option[Value] {
    return match self {
        InstructionData.Unary(opcode: _, arg: arg) => Some(arg)
        InstructionData.Load(opcode: _, flags: _, arg: arg, offset: _) => Some(arg)
        InstructionData.LoadNoOffset(opcode: _, flags: _, arg: arg) => Some(arg)
        InstructionData.Brif(opcode: _, arg: arg, then: _, otherwise: _) => Some(arg)
        InstructionData.Binary(opcode: _, x: x, y: _) => Some(x)
        InstructionData.IntCompare(opcode: _, cond: _, x: x, y: _) => Some(x)
        InstructionData.FloatCompare(opcode: _, cond: _, x: x, y: _) => Some(x)
        InstructionData.Store(opcode: _, flags: _, x: x, p: _, offset: _) => Some(x)
        InstructionData.StoreNoOffset(opcode: _, flags: _, x: x, p: _) => Some(x)
        InstructionData.AtomicRmw(opcode: _, flags: _, op: _, p: p, x: _) => Some(p)
        InstructionData.Ternary(opcode: _, x: _, y: y, z: _) => Some(y)
        InstructionData.AtomicCas(opcode: _, flags: _, p: _, e: _, x: x) => Some(x)
        InstructionData.CallIndirect(opcode: _, sig_ref: _, callee: callee, args: _) => Some(callee)
        else => None
    }
} InstructionData.typevar_operand

/// The values the instruction reads: its arguments, then those it passes to its branch targets.
fn InstructionData.values(self, alloc: mem::Alloc) -> mem::List[Value] {
    var values = mem::List[Value].empty(alloc)
    match self {
        InstructionData.Unary(opcode: _, arg: arg) => mut values.push(arg)
        InstructionData.Load(opcode: _, flags: _, arg: arg, offset: _) => mut values.push(arg)
        InstructionData.LoadNoOffset(opcode: _, flags: _, arg: arg) => mut values.push(arg)
        InstructionData.Binary(opcode: _, x: x, y: y) or InstructionData.IntCompare(opcode: _, cond: _, x: x, y: y) or InstructionData.FloatCompare(opcode: _, cond: _, x: x, y: y) => {
            mut values.push(x)
            mut values.push(y)
        }
        InstructionData.Store(opcode: _, flags: _, x: x, p: p, offset: _) or InstructionData.StoreNoOffset(opcode: _, flags: _, x: x, p: p) => {
            mut values.push(x)
            mut values.push(p)
        }
        InstructionData.AtomicRmw(opcode: _, flags: _, op: _, p: p, x: x) => {
            mut values.push(p)
            mut values.push(x)
        }
        InstructionData.Ternary(opcode: _, x: x, y: y, z: z) or InstructionData.AtomicCas(opcode: _, flags: _, p: x, e: y, x: z) => {
            mut values.push(x)
            mut values.push(y)
            mut values.push(z)
        }
        InstructionData.Call(opcode: _, func_ref: _, args: args) or InstructionData.MultiAry(opcode: _, args: args) => {
            for arg in args {
                mut values.push(arg)
            }
        }
        InstructionData.CallIndirect(opcode: _, sig_ref: _, callee: callee, args: args) => {
            mut values.push(callee)
            for arg in args {
                mut values.push(arg)
            }
        }
        InstructionData.Jump(opcode: _, destination: destination) => {
            for arg in destination.args {
                mut values.push(arg)
            }
        }
        InstructionData.Brif(opcode: _, arg: arg, then: then, otherwise: otherwise) => {
            mut values.push(arg)
            for passed in then.args {
                mut values.push(passed)
            }
            for passed in otherwise.args {
                mut values.push(passed)
            }
        }
        else => {}
    }
    return values
} InstructionData.values

/// A stack area of a function: its size in bytes and the log2 of its alignment.
pkg struct StackSlotData derives Copy, Eq, Hash {
    pkg size: u32
    pkg align_shift: u8
} StackSlotData

/// A name a function or data object is linked by: a user name, by namespace and index.
pkg struct ExternalName derives Copy, Eq, Hash {
    pkg namespace: u32
    pkg index: u32
} ExternalName

/// A symbol's address as a global value: its name, whether it is defined in the same image
/// and reached directly, and whether it is thread-local.
pkg struct GlobalValueData derives Copy, Eq, Hash {
    pkg name: ExternalName
    pkg colocated: bool
    pkg tls: bool
} GlobalValueData

/// A function a function calls or takes the address of: its name, signature, and whether it
/// is defined in the same image and reached directly.
pkg struct ExtFuncData derives Copy, Eq, Hash {
    pkg name: ExternalName
    pkg signature: SigRef
    pkg colocated: bool
} ExtFuncData
