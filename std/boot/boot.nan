    pub entry: u64
    pub segments: mem::List[hw::Region]
    pub modules: mem::List[ModuleSource]
    pub command_line: mem::Bytes
} Image

pub closed struct ModuleSource {
    pub name: mem::Bytes
    pub contents: Untrusted[mem::Bytes]
} ModuleSource

