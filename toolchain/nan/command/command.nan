//! The `nan` command line: reading it, running the command it names, and printing the result.

/// A command this implementation runs.
enum Name derives Copy, Eq {
    Check
    Fix
    Fmt
    Find
    Holes
    Show
    Read
    Context
    Explain
    Expand
    EditReplace
    EditRename
    EditMove
    Primer
    Build
    Run
    Test
    ApiUpdate
    DepAdd
    DepSync
    DepApprove
    Verify
    Publish
    Merge
    Upgrade
    Diff
    Seal
} Name

/// A command a command line names, and how many of its words name it.
struct Named derives Copy {
    name: Name
    taken: usize
} Named

/// The command named by the words a command line starts with, and how many it takes.
fn Name.read(args: Slice[text::String]) -> Option[Named] {
    if args.len() == 0 {
        return None
    }
    let leading = args[0].as_str()
    if leading == "edit" or leading == "api" or leading == "dep" {
        if args.len() < 2 {
            return None
        }
        let Some(name) = paired(leading, second: args[1].as_str()) else {
            return None
        }
        return Some(Named(name: name, taken: 2))
    }
    let name = match leading {
        "check" => Name.Check
        "fix" => Name.Fix
        "fmt" => Name.Fmt
        "find" => Name.Find
        "holes" => Name.Holes
        "show" => Name.Show
        "read" => Name.Read
        "context" => Name.Context
        "explain" => Name.Explain
        "expand" => Name.Expand
        "primer" => Name.Primer
        "build" => Name.Build
        "run" => Name.Run
        "test" => Name.Test
        "verify" => Name.Verify
        "publish" => Name.Publish
        "merge" => Name.Merge
        "upgrade" => Name.Upgrade
        "diff" => Name.Diff
        "seal" => Name.Seal
        else => return None
    }
    return Some(Named(name: name, taken: 1))
} Name.read

/// The command named by two words, the first being `edit`, `api` or `dep`.
fn paired(leading: Str, second: Str) -> Option[Name] {
    if leading == "edit" {
        return match second {
            "replace" => Some(Name.EditReplace)
            "rename" => Some(Name.EditRename)
            "move" => Some(Name.EditMove)
            else => None
        }
    }
    if leading == "api" {
        if second == "update" {
            return Some(Name.ApiUpdate)
        }
        return None
    }
    return match second {
        "add" => Some(Name.DepAdd)
        "sync" => Some(Name.DepSync)
        "approve" => Some(Name.DepApprove)
        else => None
    }
} paired

/// The command's name words.
proj fn Name.words(self) -> Str {
    return match self {
        Name.Check => "check"
        Name.Fix => "fix"
        Name.Fmt => "fmt"
        Name.Find => "find"
        Name.Holes => "holes"
        Name.Show => "show"
        Name.Read => "read"
        Name.Context => "context"
        Name.Explain => "explain"
        Name.Expand => "expand"
        Name.EditReplace => "edit replace"
        Name.EditRename => "edit rename"
        Name.EditMove => "edit move"
        Name.Primer => "primer"
        Name.Build => "build"
        Name.Run => "run"
        Name.Test => "test"
        Name.ApiUpdate => "api update"
        Name.DepAdd => "dep add"
        Name.DepSync => "dep sync"
        Name.DepApprove => "dep approve"
        Name.Verify => "verify"
        Name.Publish => "publish"
        Name.Merge => "merge"
        Name.Upgrade => "upgrade"
        Name.Diff => "diff"
        Name.Seal => "seal"
    }
} Name.words

/// The flags the command accepts, separated by spaces.
proj fn Name.flags(self) -> Str {
    return match self {
        Name.Check => "--radius"
        Name.Show => "--api"
        Name.Find => "--contributors"
        Name.Fix => "--propagate"
        Name.Test => "--affected"
        Name.Diff => "--green"
        else => ""
    }
} Name.flags

/// The options the command accepts that take a value, separated by spaces.
proj fn Name.valued(self) -> Str {
    return match self {
        Name.Check => "--prefix --agent"
        Name.Build => "--compare-with"
        Name.EditReplace => "--expect --from"
        Name.Test => "--replay"
        Name.Publish => "--local --name"
        Name.Merge => "--path"
        Name.Upgrade => "--language"
        Name.Diff => "--path --agent"
        Name.Seal => "--as"
        else => ""
    }
} Name.valued

/// Whether an argument is the option taking every argument after it up to the next option.
fn Name.is_listing(self, arg: Str) -> bool {
    return match self {
        Name.ApiUpdate => arg == "--confirm-docs"
        Name.Publish => arg == "--breaking"
        else => false
    }
} Name.is_listing

/// The most operands the command takes.
fn Name.operands(self) -> usize {
    return match self {
        Name.Find or Name.EditRename or Name.EditMove or Name.DepAdd or Name.Diff => 2
        Name.Merge => 3
        else => 1
    }
} Name.operands

/// The option of its form taking no scope and no other option of its own.
proj fn Name.alone(self) -> Option[Str] {
    return match self {
        Name.Check => Some("--prefix")
        Name.Test => Some("--replay")
        else => None
    }
} Name.alone

/// Whether its first operand is a scope, which may be omitted.
fn Name.scoped(self) -> bool {
    return match self {
        Name.Find or Name.Show or Name.Read or Name.Context or Name.Explain or Name.Expand or Name.EditReplace or Name.EditRename => false
        Name.EditMove or Name.Primer or Name.DepAdd or Name.Publish or Name.Merge or Name.Diff or Name.Seal => false
        else => true
    }
} Name.scoped

/// Whether the command writes source or machine files.
fn Name.writes(self) -> bool {
    return match self {
        Name.Check or Name.Find or Name.Holes or Name.Show or Name.Read or Name.Context or Name.Explain or Name.Expand => false
        Name.Primer or Name.Diff => false
        else => true
    }
} Name.writes

/// The names of the counts its summary gives, separated by spaces.
proj fn Name.counts(self) -> Str {
    return match self {
        Name.Check or Name.Fix => "errors incomplete"
        Name.Test or Name.Verify => "errors incomplete tests failed"
        Name.Fmt or Name.EditReplace or Name.EditRename or Name.EditMove or Name.Build or Name.Run or Name.ApiUpdate => "files errors incomplete"
        Name.DepAdd or Name.DepSync or Name.DepApprove or Name.Publish or Name.Upgrade or Name.Seal => "files errors incomplete"
        Name.Find or Name.Holes or Name.Show or Name.Read or Name.Explain or Name.Expand or Name.Primer or Name.Diff => "records"
        Name.Context => "entries radius"
        Name.Merge => "files conflicts errors"
    }
} Name.counts

/// Whether a text of words separated by spaces holds a word.
fn holds_word(words: Str, word: Str) -> bool {
    if word.is_empty() {
        return false
    }
    let bytes = words.as_bytes()
    expect bytes.len() < ~0usize
    var start: usize = 0
    for at in 0..=bytes.len() {
        if at < bytes.len() and bytes[at] != b' ' {
            continue
        }
        let Some(part) = words.slice_bytes(start, end: at) else {
            return false
        }
        if part == word {
            return true
        }
        start = at + 1
    }
    return false
} holds_word

/// A command line this implementation runs.
struct Invocation {
    name: Name
    /// The arguments after the name words.
    args: mem::List[text::String]
    operands: mem::List[text::String]
    /// The arguments after `--`, which `nan run` passes to the program.
    passed: mem::List[text::String]
    flags: mem::List[text::String]
    values: mem::List[Valued]
    format: output::Format
} Invocation

/// An option given with a value.
struct Valued {
    option: text::String
    value: text::String
} Valued

/// The scope operand, when the command takes one first.
proj fn Invocation.scope(self) -> Option[Str] {
    if not self.name.scoped() {
        return None
    }
    let Some(operand) = self.operands.get(0) else {
        return None
    }
    return Some(operand.as_str())
} Invocation.scope

fn Invocation.flag(self, name: Str) -> bool {
    for given in self.flags {
        if given.as_str() == name {
            return true
        }
    }
    return false
} Invocation.flag

/// The value given to an option.
proj fn Invocation.value(self, option: Str) -> Option[Str] {
    for given in self.values {
        if given.option.as_str() == option {
            return Some(given.value.as_str())
        }
    }
    return None
} Invocation.value

/// The values a listing option was given, in order.
fn Invocation.listed(self, option: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var listed = mem::List[text::String].empty(alloc)
    for given in self.values {
        if given.option.as_str() == option {
            mut listed.push(text::String.of(given.value.as_str(), alloc))
        }
    }
    return listed
} Invocation.listed

/// The arguments after the name words, separated by single spaces.
fn Invocation.joined_args(self, alloc: mem::Alloc) -> text::String {
    var joined = text::String.empty(alloc)
    for index in 0..<self.args.len() {
        if index > 0 {
            mut joined.push(' ')
        }
        mut joined.append(self.args[index].as_str())
    }
    return joined
} Invocation.joined_args

/// Whether the command line is the form of the option taking no scope and no other option.
fn Invocation.is_alone(self) -> bool {
    let Some(option) = self.name.alone() else {
        return false
    }
    return self.value(option).is_some()
} Invocation.is_alone

/// The names of the counts its summary gives: prefix checking's own, or the command's.
proj fn Invocation.counts(self) -> Str {
    if self.value("--prefix").is_some() {
        return "dead pending holes"
    }
    return self.name.counts()
} Invocation.counts

/// The command line without `nan`, an omitted scope written after the name words, without
/// `--skip` unless `skip` keeps it.
fn Invocation.command(self, scope: Str, skip: bool, alloc: mem::Alloc) -> text::String {
    var words = text::String.of(self.name.words(), alloc)
    if self.name.scoped() and self.scope().is_none() and not self.is_alone() {
        mut words.push(' ')
        mut words.append(output::argument(scope, alloc).as_str())
    }
    var dropping_value = false
    for arg in self.args {
        if dropping_value {
            dropping_value = false
            continue
        }
        if arg.as_str() == "--skip" and not skip {
            dropping_value = true
            continue
        }
        mut words.push(' ')
        mut words.append(output::argument(arg.as_str(), alloc).as_str())
    }
    return words
} Invocation.command

/// A summary of each count the command gives, `errors` and `records` 1 and the others 0.
fn tool_summary(counts: Str, alloc: mem::Alloc) -> mem::List[output::Count] {
    var summary = mem::List[output::Count].empty(alloc)
    for name in take split_spaces(counts, alloc) {
        var value: usize = 0
        if name.as_str() == "errors" or name.as_str() == "records" {
            value = 1
        }
        mut summary.push(output::Count(name: take name, value: value))
    }
    return summary
} tool_summary

/// The output of a command that reported a `tool` error and did nothing else.
fn Invocation.tool_error(self, code: diagnostic::Code, scope: Str, alloc: mem::Alloc) -> output::Output {
    var records = mem::List[output::Record].empty(alloc)
    mut records.push(unlocated(code, lines: mem::List[text::String].empty(alloc), alloc))
    return output::Output(command: self.command(scope, skip: true, alloc), elision: self.command(scope, skip: false, alloc), verdict: output::Verdict.Invalid, summary: tool_summary(self.counts(), alloc), records: take records)
} Invocation.tool_error

/// Reads the command line, or `None` when it is outside every synopsis this implementation runs.
fn read_command(args: Slice[text::String], alloc: mem::Alloc) -> Option[Invocation] {
    let Some(named) = Name.read(args) else {
        return None
    }
    let name = named.name
    var invocation = Invocation(name: name, args: mem::List[text::String].empty(alloc), operands: mem::List[text::String].empty(alloc), passed: mem::List[text::String].empty(alloc), flags: mem::List[text::String].empty(alloc), values: mem::List[Valued].empty(alloc), format: output::Format(json: false, budget: None, skip: 0))
    for at in named.taken..<args.len() {
        mut invocation.args.push(text::String.of(args[at].as_str(), alloc))
    }
    var index = named.taken
    while index < args.len() {
        let arg = args[index].as_str()
        if arg == "--" and name == Name.Run {
            for at in (index + 1)..<args.len() {
                mut invocation.passed.push(text::String.of(args[at].as_str(), alloc))
            }
            break
        }
        if arg == "--json" {
            invocation.format.json = true
        } else if arg == "--budget" or arg == "--skip" {
            index += 1
            if index >= args.len() {
                return None
            }
            let Some(value) = decimal(args[index].as_str()) else {
                return None
            }
            if arg == "--skip" {
                invocation.format.skip = value
            } else if value < 100 {
                return None
            } else {
                invocation.format.budget = Some(value)
            }
        } else if holds_word(name.flags(), word: arg) and not invocation.flag(arg) {
            mut invocation.flags.push(text::String.of(arg, alloc))
        } else if name.is_listing(arg) and invocation.value(arg).is_none() {
            let listed = listed_values(args, from: index + 1)
            if listed == 0 {
                return None
            }
            expect index < ~0usize - listed
            for at in (index + 1)..<(index + 1 + listed) {
                expect at < args.len()
                mut invocation.values.push(Valued(option: text::String.of(arg, alloc), value: text::String.of(args[at].as_str(), alloc)))
            }
            expect index <= ~0usize - listed
            index += listed
        } else if holds_word(name.valued(), word: arg) and invocation.value(arg).is_none() {
            index += 1
            if index >= args.len() {
                return None
            }
            mut invocation.values.push(Valued(option: text::String.of(arg, alloc), value: text::String.of(args[index].as_str(), alloc)))
        } else if arg.starts_with("--") or invocation.operands.len() == name.operands() {
            return None
        } else {
            mut invocation.operands.push(text::String.of(arg, alloc))
        }
        expect index < args.len()
        index += 1
    }
    expect invocation.operands.len() <= ~0usize - invocation.flags.len() and invocation.operands.len() + invocation.flags.len() <= ~0usize - invocation.values.len()
    let others = invocation.operands.len() + invocation.flags.len() + invocation.values.len()
    if invocation.is_alone() and others != 1 {
        return None
    }
    return Some(take invocation)
} read_command

/// How many arguments from `from` on precede the next option or the end.
fn listed_values(args: Slice[text::String], from: usize) -> usize
    requires from <= args.len()
    ensures result <= args.len() - from
{
    let Some(parts) = args.split_at(from) else {
        expect false
        return 0
    }
    var count: usize = 0
    for arg in parts.tail {
        invariant count < parts.tail.len()
        if arg.starts_with("--") {
            break
        }
        count += 1
    }
    return count
} listed_values

/// The value of an argument of decimal digits alone.
fn decimal(arg: Str) -> Option[usize] {
    if arg.is_empty() {
        return None
    }
    var value: usize = 0
    for byte in arg.as_bytes() {
        if byte < b'0' or byte > b'9' {
            return None
        }
        let Some(scaled) = value.checked_mul(10) else {
            return None
        }
        let Some(next) = scaled.checked_add(usize.widen(byte - b'0')) else {
            return None
        }
        value = next
    }
    return Some(value)
} decimal

/// The value of a text as an unsigned integer: decimal digits after an optional `+`, none when
/// the value does not fit.
fn line_number(written: Str) -> Option[u32] {
    var start: usize = 0
    if written.starts_with("+") {
        start = 1
    }
    let Some(digits) = written.slice_bytes(start, end: written.byte_len()) else {
        return None
    }
    let Some(value) = decimal(digits) else {
        return None
    }
    return u32.checked_fit(value)
} line_number

/// What a run printed and the status it ends with, or for `nan run` of a built program, the
/// program to start in its place.
struct Ran {
    output: text::String
    status: u8
    launch: Option[emulator::Launch]
} Ran

/// The output of a command line outside every synopsis: `tool.usage`.
fn usage(args: Slice[text::String], alloc: mem::Alloc) -> Ran {
    var command = text::String.empty(alloc)
    var json = false
    for at in 0..<args.len() {
        if at > 0 {
            mut command.push(' ')
        }
        mut command.append(output::argument(args[at].as_str(), alloc).as_str())
        if args[at].as_str() == "--json" {
            json = true
        }
    }
    let counts = match Name.read(args) {
        Some(named) => named.name.counts()
        None => "records"
    }
    var records = mem::List[output::Record].empty(alloc)
    mut records.push(unlocated(diagnostic::Code.ToolUsage, lines: mem::List[text::String].empty(alloc), alloc))
    let elision = text::String.of(command.as_str(), alloc)
    let written = output::Output(command: take command, elision: take elision, verdict: output::Verdict.Invalid, summary: tool_summary(counts, alloc), records: take records)
    return Ran(output: written.render(output::Format(json: json, budget: None, skip: 0), alloc), status: output::Verdict.Invalid.status(), launch: None)
} usage

/// What a command has learnt by the time it may fail: its workspace root, its scope as the
/// verdict line writes it, and the workspace files it read.
struct Trace {
    root: Option[text::String]
    scope: Option[text::String]
    read: mem::List[text::String]
} Trace

/// Runs the command line the program was given in its working directory and prints its output,
/// or starts the program `nan run` launches; `home` replaces the user directory, as a harness
/// gives one. Returns the status the program ends with.
pkg fn entry(take world: host::World, home: Option[cache::HomeOverride]) -> u8 {
    let alloc = world.alloc
    let Some(args) = platform::arguments(world.args, alloc) else {
        return 101
    }
    let Ok(directory) = attempt platform::current_dir(alloc) else {
        return 101
    }
    let Ok(current) = attempt text::String.try_from_utf8(directory.view(), alloc) else {
        return 101
    }
    let ran = run(args.view(), current: current.as_str(), home, alloc)
    match ran.launch {
        Some(launch) => return launch.start(alloc)
        None => {}
    }
    discard attempt platform::write_stdout(ran.output.as_bytes())
    return ran.status
} entry

/// What a command line prints run in `current`, and the status it ends with, or the program it
/// starts.
fn run(args: Slice[text::String], current: Str, home: Option[cache::HomeOverride], alloc: mem::Alloc) -> Ran {
    let Some(invocation) = read_command(args, alloc) else {
        return usage(args, alloc)
    }
    var trace = Trace(root: None, scope: None, read: mem::List[text::String].empty(alloc))
    let outcome = match attempt execute(invocation, current, home, trace: mut trace, alloc) {
        Ok(done) => done
        Err(_) => Outcome.Output(internal_error(invocation, args, trace, alloc))
    }
    return match outcome {
        Outcome.Output(written) => Ran(output: written.render(invocation.format, alloc), status: written.verdict.status(), launch: None)
        Outcome.Launch(launch) => Ran(output: text::String.empty(alloc), status: 0, launch: Some(take launch))
        Outcome.Ended(status) => Ran(output: text::String.empty(alloc), status: status, launch: None)
    }
} run

/// The output of a command whose implementation failed, after writing its reproducer.
fn internal_error(invocation: Invocation, args: Slice[text::String], trace: Trace, alloc: mem::Alloc) -> output::Output {
    var scope = text::String.of(".", alloc)
    match trace.scope {
        Some(written) => {
            scope = text::String.of(written.as_str(), alloc)
        }
        None => {
            match invocation.scope() {
                Some(operand) => {
                    scope = text::String.of(operand, alloc)
                }
                None => {}
            }
        }
    }
    var lines = mem::List[text::String].empty(alloc)
    match trace.root {
        Some(root) => {
            match attempt reproducer(root.as_str(), args, read: trace.read.view(), alloc) {
                Ok(path) => {
                    var line = text::String.of("reproducer ", alloc)
                    mut line.append(path.as_str())
                    mut lines.push(take line)
                }
                Err(_) => {}
            }
        }
        None => {}
    }
    var summary = mem::List[output::Count].empty(alloc)
    mut summary.push(output::Count(name: text::String.of("records", alloc), value: 1))
    var records = mem::List[output::Record].empty(alloc)
    mut records.push(unlocated(diagnostic::Code.InternalInvariant, lines: take lines, alloc))
    return output::Output(command: invocation.command(scope.as_str(), skip: true, alloc), elision: invocation.command(scope.as_str(), skip: false, alloc), verdict: output::Verdict.InternalError, summary: take summary, records: take records)
} internal_error

/// Writes `.nan/repro/<n>` for the least positive `n` naming no directory: the command line, the
/// toolchain hashes and every workspace file the command read. Returns its path.
fn reproducer(root: Str, args: Slice[text::String], read: Slice[text::String], alloc: mem::Alloc) -> text::String fails platform::IoError {
    let repro = platform::join(root, name: ".nan/repro", alloc)
    try platform::create_dir_all(repro.as_str(), alloc)
    var number: u32 = 1
    var dir = numbered(repro.as_str(), number, alloc)
    while platform::exists(dir.as_str()) {
        expect number < 0xFFFF_FFFF
        number += 1
        dir = numbered(repro.as_str(), number, alloc)
    }
    try platform::create_dir(dir.as_str(), mode: 0b111_111_111)
    var command = text::String.empty(alloc)
    for arg in args {
        mut command.append(arg.as_str())
        mut command.push('\n')
    }
    try platform::write_file(platform::join(dir.as_str(), name: "command", alloc).as_str(), contents: command.as_bytes())
    let tree = try toolchain::source_tree(alloc)
    var hashes = text::String.empty(alloc)
    for language in toolchain::LANGUAGES {
        mut hashes.append(toolchain::hash(language, tree, alloc).full(alloc).as_str())
        mut hashes.push('\n')
    }
    try platform::write_file(platform::join(dir.as_str(), name: "toolchain", alloc).as_str(), contents: hashes.as_bytes())
    for path in read {
        let target = platform::join(dir.as_str(), name: path.as_str(), alloc)
        match platform::parent(target.as_str(), alloc) {
            Some(directory) => {
                try platform::create_dir_all(directory.as_str(), alloc)
            }
            None => {}
        }
        let content = try platform::read_file(platform::join(root, name: path.as_str(), alloc).as_str(), alloc)
        try platform::write_file(target.as_str(), contents: content.view())
    }
    var written = text::String.of(".nan/repro/", alloc)
    mut written.write(text::fmt("{number}", number), budget: 100)
    return written
} reproducer

/// The directory `<repro>/<number>`.
fn numbered(repro: Str, number: u32, alloc: mem::Alloc) -> text::String {
    var name = text::String.empty(alloc)
    mut name.write(text::fmt("{number}", number), budget: 100)
    return platform::join(repro, name: name.as_str(), alloc)
} numbered

/// Runs the command: `nan merge` and the workspace form of `nan diff` outside a workspace, every
/// other command in the session of the workspace holding `current`, under the workspace lock.
fn execute(invocation: Invocation, current: Str, home: Option[cache::HomeOverride], mut trace: Trace, alloc: mem::Alloc) -> Outcome fails platform::IoError {
    if invocation.name == Name.Merge {
        return Outcome.Output(try merge_run(invocation, current, home, trace: mut trace, alloc))
    }
    if invocation.name == Name.Diff and invocation.value("--path").is_none() and not invocation.flag("--green") {
        return Outcome.Output(try diff_workspaces(invocation, current, home, trace: mut trace, alloc))
    }
    let root = workspace::root_of(current, alloc)
    if not try workspace::holds_package(root.as_str(), alloc) {
        return Outcome.Output(invocation.tool_error(diagnostic::Code.ToolNoWorkspace, scope: ".", alloc))
    }
    trace.root = Some(text::String.of(root.as_str(), alloc))
    let lock = try journal::Lock.acquire(root.as_str(), exclusive: invocation.name.writes(), alloc)
    defer take lock.release()
    let grammar = syntax::Grammar.load(alloc)
    let loaded = try workspace::Workspace.load(root.as_str(), read: mut trace.read, given: home, grammar, alloc)
    let std = workspace::Workspace.of_std(grammar, alloc)
    let session = check::Session.of(mem::Shared.of(take loaded, alloc: alloc), std: mem::Shared.of(take std, alloc: alloc), grammar: mem::Shared.of(take grammar, alloc: alloc), home: cache::copied_override(home, alloc), alloc)
    if invocation.name == Name.Upgrade and invocation.value("--language").is_some() {
        return Outcome.Output(upgrade_language(invocation, session, current, trace: mut trace, alloc))
    }
    let written = match invocation.name {
        Name.Build or Name.Run => return try build_run(invocation, session, current, trace: mut trace, alloc)
        Name.Check or Name.Fix or Name.Fmt => try check_run(invocation, session, current, trace: mut trace, alloc)
        Name.Test => try test_run(invocation, session, current, trace: mut trace, alloc)
        Name.Holes => read_holes(invocation, session, current, trace: mut trace, alloc)
        Name.Find => read_find(invocation, session, current, alloc)
        Name.Show or Name.Read => read_show(invocation, session, current, trace: mut trace, alloc)
        Name.Context => read_context(invocation, session, current, trace: mut trace, alloc)
        Name.Explain => read_explain(invocation, session, current, trace: mut trace, alloc)
        Name.Expand => read_expand(invocation, session, current, trace: mut trace, alloc)
        Name.EditReplace => try edit_replace(invocation, session, current, trace: mut trace, alloc)
        Name.EditRename => try edit_rename(invocation, session, current, trace: mut trace, alloc)
        Name.EditMove => try edit_move_item(invocation, session, current, trace: mut trace, alloc)
        Name.Primer => read_primer(invocation, alloc)
        Name.ApiUpdate => try api_update(invocation, session, current, trace: mut trace, alloc)
        Name.DepAdd => try dep_add(invocation, session, current, trace: mut trace, alloc)
        Name.DepSync => try dep_sync(invocation, session, current, trace: mut trace, alloc)
        Name.DepApprove => try dep_approve(invocation, session, current, trace: mut trace, alloc)
        Name.Verify => try verify_run(invocation, session, current, trace: mut trace, alloc)
        Name.Publish => try publish_run(invocation, session, current, trace: mut trace, alloc)
        Name.Merge => {
            expect false
            return Outcome.Output(invocation.tool_error(diagnostic::Code.ToolUsage, scope: ".", alloc))
        }
        Name.Upgrade => try dep_upgrade(invocation, session, current, trace: mut trace, alloc)
        Name.Diff => diff_run(invocation, session, current, trace: mut trace, alloc)
        Name.Seal => try seal_run(invocation, session, current, trace: mut trace, alloc)
    }
    return Outcome.Output(take written)
} execute

/// The record of a diagnostic without location or item.
fn unlocated(code: diagnostic::Code, take lines: mem::List[text::String], alloc: mem::Alloc) -> output::Record {
    var fields = mem::List[text::String].empty(alloc)
    mut fields.push(text::String.of(code.name(), alloc))
    mut fields.push(text::String.of("-", alloc))
    mut fields.push(text::String.of("-", alloc))
    return output::Record(word: text::String.of(code.class().word(), alloc), fields: take fields, lines: take lines)
} unlocated

/// The name of the package a scope lies in, by which records write paths.
fn writer_of(workspace: workspace::Workspace, scope: scope::Scope, alloc: mem::Alloc) -> Option[text::String] {
    let Some(index) = scope.package_index(workspace) else {
        return None
    }
    let Some(pack) = workspace.packages.get(index) else {
        expect false
        return None
    }
    let Some(name) = pack.name() else {
        return None
    }
    return Some(text::String.of(name, alloc))
} writer_of

/// A canonical path as records write it for the scope's package `writer`: without the package
/// name when it lies in another module of that package.
fn written_for(path: Str, writer: Option[text::String], alloc: mem::Alloc) -> text::String {
    let Some(owner) = writer else {
        return text::String.of(path, alloc)
    }
    let length = owner.byte_len()
    if not path.starts_with(owner.as_str()) {
        return text::String.of(path, alloc)
    }
    let Some(rest) = path.slice_bytes(length, end: path.byte_len()) else {
        return text::String.of(path, alloc)
    }
    if not rest.starts_with("::") {
        return text::String.of(path, alloc)
    }
    let Some(below) = rest.slice_bytes(2, end: rest.byte_len()) else {
        return text::String.of(path, alloc)
    }
    let Some(at) = below.find("::") else {
        return text::String.of(path, alloc)
    }
    let Some(module) = below.slice_bytes(0, end: at) else {
        return text::String.of(path, alloc)
    }
    if module.find(".") != None or module.find("[") != None {
        return text::String.of(path, alloc)
    }
    return text::String.of(below, alloc)
} written_for

/// The item holding a line of a workspace file as records write it for the scope's package: by
/// the canonical path `known` when the checker gave one, else by the path its syntax gives.
fn item_written(workspace: workspace::Workspace, writer: Option[text::String], path: Str, line: u32, known: Option[text::String], alloc: mem::Alloc) -> text::String {
    match known {
        Some(item) => {
            return written_for(item.as_str(), writer, alloc)
        }
        None => {}
    }
    let Some(item) = workspace.item_at(path, line, alloc) else {
        return text::String.of("-", alloc)
    }
    return written_for(item.canonical(alloc).as_str(), writer, alloc)
} item_written

/// `<path>:<line>`.
fn located(path: Str, line: u32, alloc: mem::Alloc) -> text::String {
    var written = text::String.of(path, alloc)
    mut written.write(text::fmt(":{line}", line), budget: 100)
    return written
} located

/// A diagnostic as its record prints it; reasons outside the workspace lie in `std`.
fn record(workspace: workspace::Workspace, std: workspace::Workspace, scope: scope::Scope, reported: diagnostic::Diagnostic, alloc: mem::Alloc) -> output::Record {
    let writer = writer_of(workspace, scope, alloc)
    var location = text::String.of("-", alloc)
    var item = text::String.of("-", alloc)
    var lines = mem::List[text::String].empty(alloc)
    match reported.path {
        Some(path) => {
            match reported.line {
                Some(line) => {
                    location = located(path.as_str(), line, alloc)
                    item = item_written(workspace, writer, path: path.as_str(), line, known: reported.item, alloc)
                    let Some(quoted) = workspace.line_text(path.as_str(), line) else {
                        expect false
                        return output::Record(word: text::String.empty(alloc), fields: mem::List[text::String].empty(alloc), lines: take lines)
                    }
                    mut lines.push(output::printable(quoted, alloc))
                }
                None => {
                    location = text::String.of(path.as_str(), alloc)
                }
            }
        }
        None => {}
    }
    stated(mut lines, label: "expected: ", value: reported.expected, alloc)
    stated(mut lines, label: "found: ", value: reported.found, alloc)
    match reported.envelope {
        Some(envelope) => {
            var header = text::String.of("envelope ", alloc)
            mut header.append(envelope.origin.as_str())
            mut header.write(text::fmt(" {count}", count: envelope.lines.len()), budget: 100)
            mut lines.push(take header)
            for quoted in envelope.lines {
                var line = text::String.of("| ", alloc)
                mut line.append(output::printable(quoted.as_bytes(), alloc).as_str())
                mut lines.push(take line)
            }
        }
        None => {}
    }
    for reason in reported.because {
        because(mut lines, workspace, std, writer, reason, alloc)
    }
    for line in take fix::shown(workspace, fixes: reported.fixes.view(), alloc) {
        mut lines.push(take line)
    }
    var fields = mem::List[text::String].empty(alloc)
    mut fields.push(text::String.of(reported.code.name(), alloc))
    mut fields.push(take location)
    mut fields.push(take item)
    return output::Record(word: text::String.of(reported.code.class().word(), alloc), fields: take fields, lines: take lines)
} record

/// Adds the line `<label><value>` of a stated value, when there is one.
fn stated(mut lines: mem::List[text::String], label: Str, value: Option[text::String], alloc: mem::Alloc) {
    let Some(written) = value else {
        return
    }
    var line = text::String.of(label, alloc)
    mut line.append(output::printable(written.as_bytes(), alloc).as_str())
    mut lines.push(take line)
} stated

/// Adds the lines of a reason: `because <role> <location> <item> <subject>`, then the line it
/// lies on, in the workspace or else in `std`.
fn because(mut lines: mem::List[text::String], workspace: workspace::Workspace, std: workspace::Workspace, writer: Option[text::String], reason: diagnostic::Reason, alloc: mem::Alloc) {
    let Some(at) = reason.at else {
        var line = text::String.of("because ", alloc)
        mut line.append(reason.role.word())
        mut line.append(" - - ")
        mut line.append(reason.subject.as_str())
        mut lines.push(take line)
        return
    }
    if workspace.file(at.path.as_str()).is_some() {
        located_because(mut lines, home: workspace, writer, reason, at, alloc)
    } else {
        located_because(mut lines, home: std, writer, reason, at, alloc)
    }
} because

/// Adds the lines of a reason lying at `at` in a file of `home`.
fn located_because(mut lines: mem::List[text::String], home: workspace::Workspace, writer: Option[text::String], reason: diagnostic::Reason, at: diagnostic::At, alloc: mem::Alloc) {
    var line = text::String.of("because ", alloc)
    mut line.append(reason.role.word())
    mut line.push(' ')
    mut line.append(located(at.path.as_str(), line: at.line, alloc).as_str())
    mut line.push(' ')
    mut line.append(item_written(home, writer, path: at.path.as_str(), line: at.line, known: None, alloc).as_str())
    mut line.push(' ')
    mut line.append(reason.subject.as_str())
    mut lines.push(take line)
    let Some(file) = home.file(at.path.as_str()) else {
        expect false
        return
    }
    mut lines.push(output::printable(home.file_at(file).syntax.line_text(at.line), alloc))
} located_because
