//! An AArch64 bare kernel its firmware enters at EL2, finding PSCI's secure monitor conduit.

package aarch64_discovery_el2 {
    language 1
    targets aarch64-bare
    entry main
    allow device in aarch64_discovery_el2
    allow priv in aarch64_discovery_el2
    allow trusted in aarch64_discovery_el2
} aarch64_discovery_el2
