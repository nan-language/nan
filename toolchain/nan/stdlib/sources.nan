    \\test dma_buffer_holds_the_boxed_value for Dma.of {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    let buffer = Dma.of(heap.boxed(Array[u8, 4].filled(7)))
    \\    let contents = take buffer.into_box()
    \\    expect contents.contents()[3] == 7
    \\} dma_buffer_holds_the_boxed_value
    \\
    \\test bus_address_is_the_contents_address_on_the_host for Dma.bus_addr {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    let buffer = Dma.of(heap.boxed(Array[u8, 4].filled(0)))
    \\    let start = Ptr.of_view(buffer.contents().view())
    \\    let bus = buffer.bus_addr()
    \\    expect bus.value == u64.widen(start.addr())
    \\    discard take buffer.into_box()
    \\} bus_address_is_the_contents_address_on_the_host
    \\
    \\test contents_reads_the_buffer for Dma.contents {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    let buffer = Dma.of(heap.boxed(Array[u8, 4].filled(3)))
    \\    let first_byte = buffer.contents()[0]
    \\    expect first_byte == 3
    \\    discard take buffer.into_box()
    \\} contents_reads_the_buffer
    \\
    \\test contents_mut_writes_the_buffer for Dma.contents_mut {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    var buffer = Dma.of(heap.boxed(Array[u8, 4].filled(0)))
    \\    var bytes = mut buffer.contents_mut().view_mut()
    \\    bytes[1] = 9
    \\    let written = buffer.contents()[1]
    \\    expect written == 9
    \\    discard take buffer.into_box()
    \\} contents_mut_writes_the_buffer
    \\
    \\test into_box_returns_the_written_contents for Dma.into_box {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    var buffer = Dma.of(heap.boxed(Array[u8, 4].filled(0)))
    \\    var bytes = mut buffer.contents_mut().view_mut()
    \\    bytes[2] = 4
    \\    let contents = take buffer.into_box()
    \\    expect contents.contents()[2] == 4
    \\} into_box_returns_the_written_contents
    \\
    \\test shared_buffer_reaches_its_fields for DmaShared.of {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    var ring = DmaShared.of(heap.boxed(Descriptor(length: 0, flags: 0, next: 0)))
    \\    mut ring.write_release(Descriptor.length, value: 512)
    \\    let length = mut ring.read_acquire(Descriptor.length)
    \\    expect length == 512
    \\    discard take ring.into_box()
    \\} shared_buffer_reaches_its_fields
    \\
    \\test shared_bus_address_is_the_contents_address_on_the_host for DmaShared.bus_addr {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    let ring = DmaShared.of(heap.boxed(Array[u8, 8].filled(0)))
    \\    let bus = ring.bus_addr()
    \\    let contents = take ring.into_box()
    \\    expect bus.value == u64.widen(Ptr.of_view(contents.contents().view()).addr())
    \\} shared_bus_address_is_the_contents_address_on_the_host
    \\
    \\test shared_into_box_returns_the_released_fields for DmaShared.into_box {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    var ring = DmaShared.of(heap.boxed(Descriptor(length: 0, flags: 0, next: 0)))
    \\    mut ring.write_release(Descriptor.next, value: 3)
    \\    let contents = take ring.into_box()
    \\    expect contents.contents().next == 3
    \\} shared_into_box_returns_the_released_fields
    \\
    \\test dma_fence_keeps_earlier_writes for dma_fence {
    \\    let heap = mem::Heap.of(testing::world().alloc)
    \\    var ring = DmaShared.of(heap.boxed(Descriptor(length: 0, flags: 0, next: 0)))
    \\    mut ring.write_release(Descriptor.length, value: 64)
    \\    dma_fence()
    \\    mut ring.write_release(Descriptor.flags, value: 1)
    \\    let length = mut ring.read_acquire(Descriptor.length)
    \\    expect length == 64
    \\    discard take ring.into_box()
    \\} dma_fence_keeps_earlier_writes
    \\
