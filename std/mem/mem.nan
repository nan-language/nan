test sort_by_is_stable for List.sort_by {
    let world = testing::world()
    var pairs = List[Bytes].empty(world.alloc)
    mut pairs.push(Bytes.zeroed(2, alloc: world.alloc))
    mut pairs.push(Bytes.zeroed(1, alloc: world.alloc))
    mut pairs.push(Bytes.zeroed(2, alloc: world.alloc))
    pairs[2][1] = 1
    mut pairs.sort_by(fn(left: Bytes, right: Bytes) => left.len().cmp(right.len()))
    expect pairs[0].len() == 1
    expect pairs[1][1] == 0
    expect pairs[2][1] == 1
} sort_by_is_stable

