//! Boots with `board.dtb`, which describes the virt board's devices with 2 CPUs, a PL011 at `0x0904_0000` first and, behind a bus whose `ranges` translate its address 0 to `0x0900_0000`, the PL011 its `stdout-path` names through an alias: the halt report reaches the serial port only through that PL011.

registers Pl011 {
    data: u8 at 0x0 write
} Pl011

/// Writes a text to the PL011 the emulator connects to the serial port.
fn say(text: Str) {
    var port = trusted "the virt board maps its first PL011 at 0x0900_0000 and nothing else maps it" { hw::Mmio[Pl011].map(0x0900_0000) }
    for byte in text.as_bytes() {
        mut port.write(Pl011.data, value: byte)
    }
    take port.unmap()
} say

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    if hw::cpu_count() == 2 {
        say(text: "2 cpus\n")
    }
    if k.wall_clock().is_some() {
        say(text: "wall clock\n")
    }
    take k.anchor(0u8, run: fn(exec: task::Executor) limits stack 16_384 {
        say(text: "anchored\n")
    })
} main
