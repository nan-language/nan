//! The start information a bare image may enter with, in the layout of the PVH boot protocol's: its magic number, module list, command line, RSDP and memory map.

/// The offsets in a start information of its magic number, version, module count, module list's
/// address, command line's address, RSDP's address, memory map's address and memory map's entry
/// count, which version 1 adds; its size and its magic number.
const START_INFO_MAGIC: u64 = 0

const START_INFO_VERSION: u64 = 4

const START_INFO_MODULE_COUNT: u64 = 12

const START_INFO_MODULES: u64 = 16

const START_INFO_COMMAND_LINE: u64 = 24

const START_INFO_RSDP: u64 = 32

const START_INFO_MAP: u64 = 40

const START_INFO_MAP_COUNT: u64 = 48

const START_INFO_BYTES: i64 = 56

const START_INFO_MAGIC_NUMBER: i64 = 0x336E_C578

/// The offsets in a module list entry of the module's address, size and NUL-terminated name, and
/// an entry's size.
const START_MODULE_ADDRESS: u64 = 0

const START_MODULE_SIZE: u64 = 8

const START_MODULE_NAME: u64 = 16

const START_MODULE_BYTES: i64 = 32

/// The offsets in a memory map entry of its address, size and type, an entry's size, and the
/// type of usable memory.
const START_MAP_BASE: u64 = 0

const START_MAP_SIZE: u64 = 8

const START_MAP_KIND: u64 = 16

const START_MAP_BYTES: i64 = 24

const START_MAP_USABLE: i64 = 1

/// The address of the start information the image entered with, zero when it entered with
/// none: the PVH protocol's on `x86_64-bare` and the one in `x1` on `aarch64-bare`, each when
/// it holds the magic number.
fn Lowering.start_info(mut self, mut fx: Fx) -> clif::Value {
    let given = match self.ck.db().target {
        workspace::Target.X64Bare => STATE_PLATFORM
        workspace::Target.Aarch64Bare => STATE_PLATFORM_TABLE
        else => {
            return mut fx.ptr(0)
        }
    }
    let state_address = mut self.state(mut fx)
    let candidate = mut fx.load(PTR, addr: state_address, offset: given)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: candidate, y: 0)
    let chosen = mut fx.choose(present, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let magic = mut fx1.load(clif::Type.Int32, addr: candidate, offset: START_INFO_MAGIC)
        let valid = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: magic, y: START_INFO_MAGIC_NUMBER)
        let zero_value = mut fx1.ptr(0)
        return fx1.list1(mut fx1.b.select(valid, x: candidate, y: zero_value))
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut fx1.ptr(0))
    })
    return chosen[0]
} Lowering.start_info

/// The 32-bit count at an offset of a start information, zero-extended.
fn start_count(mut fx: Fx, info: clif::Value, offset: u64) -> clif::Value {
    let count = mut fx.load(clif::Type.Int32, addr: info, offset)
    return mut fx.b.uextend(PTR, x: count)
} start_count

/// The address past the NUL ending the text at an address, the address itself when it is zero.
fn start_text_end(mut fx: Fx, text: clif::Value) -> clif::Value {
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: text, y: 0)
    let chosen = mut fx.choose(present, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return mut fx1.repeat(fx1.list1(text).view(), body: fn(mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() > 0
            let byte = mut fx2.load(clif::Type.Int8, addr: current[0], offset: 0)
            let next = mut fx2.b.iadd_imm_s(current[0], y: 1)
            let more = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: byte, y: 0)
            return Pass(again: more, next: fx2.list1(next))
        })
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(text)
    })
    return chosen[0]
} start_text_end
