//! A virtio entropy driver confined to an I/O domain: its device reaches the domain's buffers alone.

/// The vendor and device ids of a modern virtio entropy device.
const VIRTIO_VENDOR: u32 = 0x1AF4

const ENTROPY_DEVICE: u32 = 0x1044

/// The vendor-specific capability id, the virtio configuration kinds the driver uses, the BAR
/// holding them and where the registers below expect them.
const VENDOR_CAPABILITY: u32 = 0x09

const COMMON_KIND: u32 = 1

const NOTIFY_KIND: u32 = 2

const NOTIFY_AT: u32 = 0x3000

/// The device status bits a driver sets as it initialises the device, and the feature bits, in
/// the second feature word, of virtio 1 and of a device whose DMA the platform translates.
const ACKNOWLEDGE: u8 = 1

const DRIVER: u8 = 2

const DRIVER_OK: u8 = 4

const FEATURES_OK: u8 = 8

const VERSION_1: u32 = 1

const ACCESS_PLATFORM: u32 = 2

/// The entries of the queue, the descriptor flag of a buffer the device writes, the MSI-X
/// vector of no interrupt, and the polls of the used ring before the driver gives up.
const QUEUE_SIZE: u16 = 4

const DEVICE_WRITES: u16 = 2

const NO_VECTOR: u16 = 0xFFFF

const USED_POLLS: u32 = 2_000_000

/// The bytes the driver draws.
pub const DRAWN: u32 = 32

/// The common configuration and the notification register of the BAR QEMU's virtio devices
/// lay them out in.
registers Virtio {
    device_feature_select: u32 at 0x0 read write
    device_feature: u32 at 0x4 read
    driver_feature_select: u32 at 0x8 read write
    driver_feature: u32 at 0xC read write
    config_vector: u16 at 0x10 read write
    status: u8 at 0x14 read write
    queue_select: u16 at 0x16 read write
    queue_size: u16 at 0x18 read write
    queue_vector: u16 at 0x1A read write
    queue_enable: u16 at 0x1C read write
    queue_desc_low: u32 at 0x20 read write
    queue_desc_high: u32 at 0x24 read write
    queue_driver_low: u32 at 0x28 read write
    queue_driver_high: u32 at 0x2C read write
    queue_device_low: u32 at 0x30 read write
    queue_device_high: u32 at 0x34 read write
    notify: u16 at 0x3000 write
} Virtio

pub layout Descriptor: bytes 16 le {
    address: u64 at 0
    length: u32 at 8
    flags: u16 at 12
    next: u16 at 14
} Descriptor

pub layout UsedEntry: bytes 8 le {
    id: u32 at 0
    length: u32 at 4
} UsedEntry

/// The queue: its descriptor table, driver area and device area at the alignments virtio
/// requires of them.
pub layout Queue: bytes 128 le {
    descriptors: Array[Descriptor, 4] at 0
    avail_flags: u16 at 64
    avail_index: u16 at 66
    avail_ring: Array[u16, 4] at 68
    avail_pad: Array[u8, 4] at 76
    used_flags: u16 at 80
    used_index: u16 at 82
    used_ring: Array[UsedEntry, 4] at 84
    used_pad: Array[u8, 12] at 116
} Queue

/// The offsets in a `Queue` of the driver and device areas.
const DRIVER_AREA: u64 = 64

const DEVICE_AREA: u64 = 80

pub layout Entropy: bytes 32 le {
    data: Array[u8, 32] at 0
} Entropy

pub closed enum RngError derives Render {
    Unsupported
    NoResponse
} RngError

/// A started entropy device: its function, the window of its registers and its queue.
pub open linear struct Rng {
    function: hw::PciFunction
    regs: hw::Mmio[Virtio]
    queue: hw::DmaShared[Queue]
    used: u16
} Rng

/// Whether a function is a modern virtio entropy device.
pub fn is_entropy(function: hw::PciFunction) -> bool {
    let ids = function.config_read(0)
    return (ids & 0xFFFF) == VIRTIO_VENDOR and (ids >> 16) == ENTROPY_DEVICE
} is_entropy

/// Attaches a function to a space and starts its device with a queue in that space.
pub fn start(take function: hw::PciFunction, space: hw::IoSpace, alloc: mem::Alloc) -> Result[Rng, hw::PciFunction] {
    var attached = function
    let Some(bar) = registers_bar(attached) else {
        return Err(take attached)
    }
    match attempt mut attached.attach(space) {
        Ok(_) => {}
        Err(_) => return Err(take attached)
    }
    let regs = match attempt hw::Mmio[Virtio].of_bar(mut attached, index: bar) {
        Ok(regs) => regs
        Err(_) => return Err(take attached)
    }
    let heap = mem::Heap.of(alloc)
    let queue = hw::DmaShared.of(heap.boxed(Queue.from_bits(Array[u8, 128].filled(0))), space)
    var rng = Rng(function: take attached, regs: take regs, queue: take queue, used: 0)
    match attempt mut rng.reset() {
        Ok(_) => return Ok(take rng)
        Err(_) => return Err(take rng.stop())
    }
} start

/// The BAR holding the common configuration at its start and the queue's notification
/// register where `Virtio` expects it, none when the device lays them out otherwise.
fn registers_bar(function: hw::PciFunction) -> Option[u8] {
    var at = function.config_read(0x34) & 0xFC
    var common: u32 = 6
    var notify: u32 = 7
    for _ in 0u32..<48 {
        invariant at <= 0xFC
        if at == 0 {
            break
        }
        let head = function.config_read(u8.truncate(at))
        let kind = (head >> 24) & 0xFF
        let bar = function.config_read(u8.truncate(at + 4)) & 0xFF
        let offset = function.config_read(u8.truncate(at + 8))
        if (head & 0xFF) == VENDOR_CAPABILITY and kind == COMMON_KIND and offset == 0 {
            common = bar
        }
        if (head & 0xFF) == VENDOR_CAPABILITY and kind == NOTIFY_KIND and offset == NOTIFY_AT {
            notify = bar
        }
        at = (head >> 8) & 0xFC
    }
    if common != notify {
        return None
    }
    return Some(u8.truncate(common))
} registers_bar

/// Resets the device, negotiates virtio 1 and the platform's translation of its DMA, and sets up
/// queue 0, leaving the device running without interrupts.
pub fn Rng.reset(mut self) fails RngError {
    mut self.regs.write(Virtio.status, value: 0)
    mut self.regs.write(Virtio.status, value: ACKNOWLEDGE | DRIVER)
    mut self.regs.write(Virtio.device_feature_select, value: 1)
    let wanted = VERSION_1 | ACCESS_PLATFORM
    if (mut self.regs.read(Virtio.device_feature) & wanted) != wanted {
        fail RngError.Unsupported
    }
    mut self.regs.write(Virtio.driver_feature_select, value: 0)
    mut self.regs.write(Virtio.driver_feature, value: 0)
    mut self.regs.write(Virtio.driver_feature_select, value: 1)
    mut self.regs.write(Virtio.driver_feature, value: wanted)
    mut self.regs.write(Virtio.status, value: ACKNOWLEDGE | DRIVER | FEATURES_OK)
    if (mut self.regs.read(Virtio.status) & FEATURES_OK) == 0 {
        fail RngError.Unsupported
    }
    mut self.regs.write(Virtio.config_vector, value: NO_VECTOR)
    mut self.regs.write(Virtio.queue_select, value: 0)
    if mut self.regs.read(Virtio.queue_size) < QUEUE_SIZE {
        fail RngError.Unsupported
    }
    let ring = self.queue.bus_addr().value
    mut self.regs.write(Virtio.queue_size, value: QUEUE_SIZE)
    mut self.regs.write(Virtio.queue_vector, value: NO_VECTOR)
    mut self.regs.write(Virtio.queue_desc_low, value: u32.truncate(ring))
    mut self.regs.write(Virtio.queue_desc_high, value: u32.truncate(ring >> 32))
    mut self.regs.write(Virtio.queue_driver_low, value: u32.truncate(ring + DRIVER_AREA))
    mut self.regs.write(Virtio.queue_driver_high, value: u32.truncate((ring + DRIVER_AREA) >> 32))
    mut self.regs.write(Virtio.queue_device_low, value: u32.truncate(ring + DEVICE_AREA))
    mut self.regs.write(Virtio.queue_device_high, value: u32.truncate((ring + DEVICE_AREA) >> 32))
    mut self.queue.write_release(Queue.avail_index, value: 0)
    mut self.queue.write_release(Queue.used_index, value: 0)
    mut self.regs.write(Virtio.queue_enable, value: 1)
    mut self.regs.write(Virtio.status, value: ACKNOWLEDGE | DRIVER | FEATURES_OK | DRIVER_OK)
    self.used = 0
} Rng.reset

/// Asks the device for `DRAWN` bytes written at bus address `target` and waits until it has
/// used the request.
pub fn Rng.request(mut self, target: u64) fails RngError {
    mut self.post(target)
    for _ in 0..<USED_POLLS {
        if mut self.queue.read_acquire(Queue.used_index) == self.used {
            return
        }
    }
    fail RngError.NoResponse
} Rng.request

/// Posts a request for `DRAWN` bytes written at bus address `target` and notifies the device.
pub fn Rng.post(mut self, target: u64) {
    self.used = self.used.wrapping_add(1)
    let slot = usize.widen(self.used.wrapping_sub(1) % QUEUE_SIZE)
    mut self.queue.write_release_at(Queue.descriptors, index: slot, value: Descriptor(address: target, length: DRAWN, flags: DEVICE_WRITES, next: 0))
    mut self.queue.write_release_at(Queue.avail_ring, index: slot, value: u16.truncate(slot))
    mut self.queue.write_release(Queue.avail_index, value: self.used)
    mut self.regs.write(Virtio.notify, value: 0)
} Rng.post

/// Makes the queue's completions raise MSI-X vector 0.
pub fn Rng.signal_used(mut self) {
    mut self.regs.write(Virtio.queue_select, value: 0)
    mut self.regs.write(Virtio.queue_vector, value: 0)
} Rng.signal_used

/// Installs a count of the queue's interrupts on MSI-X entry 0 of the function, for CPU 0.
pub fn Rng.count_interrupts(mut self) -> Option[hw::IrqShared[u64]] {
    match mut self.function.msix(entry: 0, cpu: 0, dev: 0u64, on_irq: count) {
        Ok(shared) => return Some(take shared)
        Err(_) => return None
    }
} Rng.count_interrupts

interrupt fn count(mut counted: u64, take irq: hw::IrqContext) -> hw::IrqExit limits stack 1_024 {
    counted = counted.wrapping_add(1)
    take irq.complete()
    return hw::IrqExit.Resume
} count

/// Resets the device and releases its function.
pub fn Rng.stop(take self) -> hw::PciFunction {
    let Rng(function: function, regs: regs, queue: queue, used: _) = self
    var window = regs
    mut window.write(Virtio.status, value: 0)
    take window.unmap()
    discard take queue.into_box()
    return function
} Rng.stop

/// Draws `DRAWN` bytes into a buffer of the space and gives them, Untrusted as the device wrote
/// them.
pub fn Rng.draw(mut self, space: hw::IoSpace, alloc: mem::Alloc) -> Untrusted[mem::Box[Entropy]] fails RngError {
    let heap = mem::Heap.of(alloc)
    let buffer = hw::Dma.of(heap.boxed(Entropy.from_bits(Array[u8, 32].filled(0))), space)
    let target = buffer.bus_addr().value
    let outcome = attempt mut self.request(target)
    let written = take buffer.into_box()
    let Ok(_) = outcome else {
        fail RngError.NoResponse
    }
    return Untrusted.of(take written)
} Rng.draw
