pub open struct Trap derives Send {
} Trap

impl Trap: Render

pub fn Trap.render(self, mut out: core::Renderer)

pub fn Trap.kind(self) -> TrapKind

pub closed enum TrapKind derives Copy, Eq, Render {
    Bounds
    Overflow
    DivisionByZero
    Shift
    Conversion
    StaleHandle
    Exhausted
    Predicate
    Requires
    Ensures
    Expect
    Todo
    StackOverflow
    DuplicateAccess
    Poisoned
    Exception
    Abandoned
} TrapKind

