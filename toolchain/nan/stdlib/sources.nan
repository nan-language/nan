    \\        return try await signal.wait()
    \\    })
    \\    let later = try await task::within(world.clock, ms: 10, body: fn() -> u32 fails task::Cancelled uses wait {
    \\        return try await signal.wait()
    \\    })
    \\    expect stored == Some(4) and later == None
    \\} deadline_wait_after_a_stored_value_waits_again
