//! The AArch64 machine an image runs on, discovered in `Init` from the flattened device tree the image entered with, or a UEFI image's configuration table lists, or else from the ACPI tables: the UART halt reports are written to, the wall clock's PL031, the GICv3's distributor, redistributor regions and ITS, the PSCI conduit, and the CPUs with each one's redistributor. The machine record holds what it finds; a field is zero for what the machine lacks.

/// The offsets of the machine record's fields: the UART's base, kind, register shift and access
/// width; the PL031's base; the PSCI conduit; the number of CPUs found; the distributor's base;
/// the ITS's base; and the number of redistributor regions, then each region's base and length.
const MACHINE_UART: u64 = 0

const MACHINE_UART_KIND: u64 = 8

const MACHINE_UART_SHIFT: u64 = 16

const MACHINE_UART_WIDTH: u64 = 24

const MACHINE_RTC: u64 = 32

const MACHINE_CONDUIT: u64 = 40

const MACHINE_CPUS: u64 = 48

const MACHINE_GICD: u64 = 56

const MACHINE_ITS: u64 = 64

const MACHINE_REGIONS: u64 = 72

const MACHINE_REGION: u64 = 80

const MACHINE_REGION_BYTES: u64 = 16

const MACHINE_MOST_REGIONS: u64 = 4

const MACHINE_SIZE: u64 = MACHINE_REGION + MACHINE_REGION_BYTES * MACHINE_MOST_REGIONS

/// The kinds of UART: a PL011, an SBSA generic UART, which the halt path does not program, and a
/// memory-mapped 16550 whose registers lie `1 << shift` bytes apart.
const UART_PL011: i64 = 1

const UART_SBSA: i64 = 2

const UART_NS16550: i64 = 3

/// The PSCI conduits: the hypervisor call and the secure monitor call.
const CONDUIT_HVC: i64 = 1

const CONDUIT_SMC: i64 = 2

/// The PSCI status a call gives when the machine has no conduit.
const PSCI_NOT_SUPPORTED: i64 = -1

/// The `MPIDR_EL1` encoding the `ReadSysReg` stub reads the boot CPU's affinity through, and the
/// affinity fields of an `MPIDR_EL1` value.
const MPIDR_EL1: u16 = 0x4005

const MPIDR_AFFINITY: i64 = 0xFF_00FF_FFFF

/// The device tree's magic number, and the depths of nodes whose cells, ranges and path a walk
/// tracks: deeper nodes are passed over.
const DEVICE_TREE_MAGIC: i64 = 0xD00D_FEED

const DEVICE_TREE_DEPTHS: u64 = 16

/// The offsets of the fields a walk keeps per depth: the cells of an address and a size in the
/// node's children, its `ranges` property's value, zero without one, and length, and the place
/// in the UART's path past the node's name when the path runs through the node, zero otherwise.
const LEVEL_ADDRESS_CELLS: u64 = 0

const LEVEL_SIZE_CELLS: u64 = 8

const LEVEL_RANGES: u64 = 16

const LEVEL_RANGES_LEN: u64 = 24

const LEVEL_PATH: u64 = 32

const LEVEL_SIZE: u64 = 40

/// The bits among a node's kinds of the compatible strings a walk recognises.
const COMPATIBLE_PL011: i64 = 1

const COMPATIBLE_SBSA: i64 = 2

const COMPATIBLE_NS16550: i64 = 4

const COMPATIBLE_GIC: i64 = 8

const COMPATIBLE_ITS: i64 = 16

const COMPATIBLE_RTC: i64 = 32

const COMPATIBLE_PSCI: i64 = 64

/// The MADT entries a discovery reads: a GIC CPU interface, with its flags, redistributor base
/// and affinity, a distributor with its base, a redistributor region with its base and length,
/// and an ITS with its base; and the flag of a usable CPU interface.
const MADT_GICC: i64 = 0x0B

const MADT_GICC_FLAGS: u64 = 12

const MADT_GICC_GICR: u64 = 60

const MADT_GICC_MPIDR: u64 = 68

const MADT_GICD: i64 = 0x0C

const MADT_GICD_BASE: u64 = 8

const MADT_GICR: i64 = 0x0E

const MADT_GICR_BASE: u64 = 4

const MADT_GICR_LENGTH: u64 = 12

const MADT_ITS: i64 = 0x0F

const MADT_ITS_BASE: u64 = 8

const MADT_ENABLED: i64 = 1

/// The FADT's length that holds the boot architecture flags, their offset, and their flags
/// saying PSCI is implemented and is reached by `hvc`.
const FADT_ARM_LENGTH: i64 = 131

const FADT_ARM_BOOT: u64 = 129

const PSCI_COMPLIANT: i64 = 1

const PSCI_USE_HVC: i64 = 2

/// The SPCR's signature, the offsets of its interface type and of its base address's space,
/// access size and address, the system memory space, and the interface types of a PL011, of the
/// SBSA generic UARTs and of the 16550s; an access size of 4 bytes.
const SPCR_SIGNATURE: i64 = 0x5243_5053

const SPCR_TYPE: u64 = 36

const SPCR_SPACE: u64 = 40

const SPCR_ACCESS: u64 = 43

const SPCR_ADDRESS: u64 = 44

const SPCR_PL011: i64 = 0x03

const SPCR_SBSA: Array[i64, 2] = listed_spcr_sbsa()

fn listed_spcr_sbsa() -> Array[i64, 2] {
    var listed = Array[i64, 2].filled(0x0D)
    listed[1] = 0x0E
    return listed
} listed_spcr_sbsa

const SPCR_16550: Array[i64, 2] = listed_spcr_16550()

fn listed_spcr_16550() -> Array[i64, 2] {
    var listed = Array[i64, 2].filled(0x00)
    listed[1] = 0x12
    return listed
} listed_spcr_16550

const SPCR_DWORD: i64 = 3

/// The last-frame and virtual-LPI bits of a redistributor frame's type register and the position
/// of its affinity there; and the strides of a frame without and with virtual LPIs.
const GICR_LAST: i64 = 1i64 << 4

const GICR_VLPIS: i64 = 1i64 << 1

const GICR_AFFINITY: i64 = 32

const GICR_FRAME: i64 = 0x2_0000

const GICR_VLPI_FRAME: i64 = 0x4_0000

/// The device tree's token that holds no data.
const DEVICE_TREE_NOP: i64 = 4

/// The helper functions of a device tree walk.
struct TreeHelpers derives Copy {
    listed: object::FuncId
    named: object::FuncId
    translate: object::FuncId
} TreeHelpers

/// What a walk records of the node whose properties it reads: its `reg` property's value and
/// length, its kinds, whether its `device_type` is `cpu`, its `reg-shift` and `reg-io-width`, its
/// PSCI method's conduit, its `#redistributor-regions`, and whether its `status` disables it.
struct TreeNode derives Copy {
    reg: clif::Variable
    reg_len: clif::Variable
    kinds: clif::Variable
    cpu: clif::Variable
    shift: clif::Variable
    width: clif::Variable
    method: clif::Variable
    regions: clif::Variable
    disabled: clif::Variable
} TreeNode

/// A property of a device tree's structure block: its name, value, value's length and the
/// address after it.
struct TreeProperty derives Copy {
    name: clif::Value
    value: clif::Value
    len: clif::Value
    after: clif::Value
} TreeProperty

/// The address of the machine record.
fn Lowering.machine_record(mut self, mut fx: Fx) -> clif::Value {
    return mut self.reserved(mut fx, data_name: "_NSmachine", size: MACHINE_SIZE, align: 8)
} Lowering.machine_record

/// The number of CPUs discovery found.
fn Lowering.discovered_cpus(mut self, mut fx: Fx) -> clif::Value {
    let record = mut self.machine_record(mut fx)
    return mut fx.load(PTR, addr: record, offset: MACHINE_CPUS)
} Lowering.discovered_cpus

/// Discovers the machine, recording the boot CPU's affinity first: from the device tree, else
/// from the ACPI tables. Without a PSCI conduit only the boot CPU runs. On a kernel, each CPU
/// gets its redistributor, a CPU other than the boot CPU without one being left out, and `Init`
/// returns 1 when the machine has no distributor or the boot CPU no redistributor.
fn Lowering.discover_machine(mut self, mut fx: Fx) {
    let record = mut self.machine_record(mut fx)
    let mpidr = mut self.read_sysreg(mut fx, register: MPIDR_EL1)
    let boot = mut fx.b.band_imm_s(mpidr, y: MPIDR_AFFINITY)
    let boot_record = mut self.cpu_records(mut fx)
    mut fx.store(boot, addr: boot_record, offset: CPU_HARDWARE_ID)
    let one = mut fx.ptr(1)
    mut fx.store(one, addr: record, offset: MACHINE_CPUS)
    let tree = mut self.entered_tree(mut fx)
    let walk = mut self.tree_discovery()
    let walk_ref = mut self.call_ref(mut fx, id: walk)
    let call = mut fx.b.call(walk_ref, args: fx.list2(tree, b: boot).view())
    let found = fx.b.inst_results(call, alloc: fx.alloc)
    let absent = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: found[0], y: 0)
    mut fx.if_true(absent, then: fn[mut self](mut fx1: Fx) {
        let rsdp = mut self.rsdp(mut fx1)
        mut self.acpi_discovery(mut fx1, rsdp, boot)
    })
    if not self.kernel() {
        return
    }
    let conduit = mut fx.load(PTR, addr: record, offset: MACHINE_CONDUIT)
    let none = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: conduit, y: 0)
    mut fx.if_true(none, then: fn(mut fx1: Fx) {
        let only = mut fx1.ptr(1)
        mut fx1.store(only, addr: record, offset: MACHINE_CPUS)
    })
    let count = mut fx.load(PTR, addr: record, offset: MACHINE_CPUS)
    let kept = mut fx.variable(PTR, initial: one)
    let zero_value = mut fx.ptr(0)
    mut fx.each(zero_value, end: count, body: fn[mut self](mut fx1: Fx, index: clif::Value) {
        let from = mut self.cpu_record(mut fx1, index)
        let given = mut fx1.load(PTR, addr: from, offset: CPU_REDISTRIBUTOR)
        let missing = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: given, y: 0)
        let affinity = mut fx1.load(PTR, addr: from, offset: CPU_HARDWARE_ID)
        let chosen = mut fx1.choose_in(mut self, condition: missing, results: fx1.types1(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(mut lo2.find_redistributor(mut fx2, affinity))
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(given)
        })
        let redistributor = chosen[0]
        let is_boot = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: index, y: 0)
        mut fx1.if_true(is_boot, then: fn(mut fx2: Fx) {
            mut fx2.store(redistributor, addr: from, offset: CPU_REDISTRIBUTOR)
        })
        let other = mut fx1.b.bxor_imm_s(is_boot, y: 1)
        let found_one = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: redistributor, y: 0)
        let taken = mut fx1.b.band(other, y: found_one)
        mut fx1.if_true(taken, then: fn[mut self](mut fx2: Fx) {
            let at = mut fx2.b.use_var(kept)
            let to = mut self.cpu_record(mut fx2, index: at)
            mut fx2.store(affinity, addr: to, offset: CPU_HARDWARE_ID)
            mut fx2.store(redistributor, addr: to, offset: CPU_REDISTRIBUTOR)
            let next = mut fx2.b.iadd_imm_s(at, y: 1)
            mut fx2.b.def_var(kept, val: next)
        })
    })
    let kept_cpus = mut fx.b.use_var(kept)
    mut fx.store(kept_cpus, addr: record, offset: MACHINE_CPUS)
    let gicd = mut fx.load(PTR, addr: record, offset: MACHINE_GICD)
    let redistributor = mut fx.load(PTR, addr: boot_record, offset: CPU_REDISTRIBUTOR)
    let no_gicd = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: gicd, y: 0)
    let no_redistributor = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: redistributor, y: 0)
    let lacking = mut fx.b.bor(no_gicd, y: no_redistributor)
    unavailable_if(mut fx, condition: lacking)
} Lowering.discover_machine

/// The device tree the image entered with: the one in `x0` on a bare target, the one the
/// configuration table lists on a UEFI target.
fn Lowering.entered_tree(mut self, mut fx: Fx) -> clif::Value {
    let state_address = mut self.state(mut fx)
    if self.ck.db().target.kind() == Some(workspace::Kind.Uefi) {
        let table = mut fx.load(PTR, addr: state_address, offset: STATE_PLATFORM_TABLE)
        return mut self.configured(mut fx, table, guids: Array[GuidWords, 1].filled(DEVICE_TREE_TABLE).view())
    }
    return mut fx.load(PTR, addr: state_address, offset: STATE_PLATFORM)
} Lowering.entered_tree

/// The redistributor frame whose affinity is a CPU's, found by walking each redistributor
/// region's frames until one is the last; zero when none is.
fn Lowering.find_redistributor(mut self, mut fx: Fx, affinity: clif::Value) -> clif::Value {
    let shifted = mut fx.b.ushr_imm_s(affinity, y: 32)
    let high = mut fx.b.ishl_imm_s(shifted, y: 24)
    let low = mut fx.b.band_imm_s(affinity, y: 0xFF_FFFF)
    let wanted = mut fx.b.bor(high, y: low)
    let record = mut self.machine_record(mut fx)
    let region_count = mut fx.load(PTR, addr: record, offset: MACHINE_REGIONS)
    let zero_value = mut fx.ptr(0)
    let found = mut fx.variable(PTR, initial: zero_value)
    mut fx.each(zero_value, end: region_count, body: fn[mut self](mut fx1: Fx, index: clif::Value) {
        let region_offset = mut fx1.b.imul_imm_s(index, y: i64.fit(MACHINE_REGION_BYTES))
        let region = mut fx1.b.iadd(record, y: region_offset)
        let base = mut fx1.load(PTR, addr: region, offset: MACHINE_REGION)
        let len = mut fx1.load(PTR, addr: region, offset: MACHINE_REGION + 8)
        let end = mut fx1.b.iadd(base, y: len)
        discard mut fx1.repeat(fx1.list1(base).view(), body: fn[mut self](mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() > 0
            let at = current[0]
            let inside = mut fx2.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: end)
            let held = mut fx2.b.use_var(found)
            let open = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: held, y: 0)
            let looking = mut fx2.b.band(inside, y: open)
            let next = mut fx2.choose_in(mut self, condition: looking, results: fx2.types2(clif::Type.Int8, b: PTR).view(), then: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let typer_at = mut fx3.b.iadd_imm_s(at, y: i64.fit(GICR_TYPER))
                let typer = mut lo3.mmio_read(mut fx3, width: 8, address: typer_at)
                let frame = mut fx3.b.ushr_imm_s(typer, y: GICR_AFFINITY)
                let same = mut fx3.b.icmp(clif::IntCC.Equal, x: frame, y: wanted)
                mut fx3.if_true(same, then: fn(mut fx4: Fx) {
                    mut fx4.b.def_var(found, val: at)
                })
                let last_bit = mut fx3.b.band_imm_s(typer, y: GICR_LAST)
                let last = mut fx3.b.icmp_imm_s(clif::IntCC.NotEqual, x: last_bit, y: 0)
                let vlpi_bit = mut fx3.b.band_imm_s(typer, y: GICR_VLPIS)
                let virtual_lpis = mut fx3.b.icmp_imm_s(clif::IntCC.NotEqual, x: vlpi_bit, y: 0)
                let wide = mut fx3.ptr(u64.fit(GICR_VLPI_FRAME))
                let narrow = mut fx3.ptr(u64.fit(GICR_FRAME))
                let stride = mut fx3.b.select(virtual_lpis, x: wide, y: narrow)
                let after = mut fx3.b.iadd(at, y: stride)
                let done = mut fx3.b.bor(same, y: last)
                let again = mut fx3.b.bxor_imm_s(done, y: 1)
                return fx3.list2(again, b: after)
            }, otherwise: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                return fx3.list2(mut fx3.int(clif::Type.Int8, value: 0), b: at)
            })
            return Pass(again: next[0], next: fx2.list1(next[1]))
        })
    })
    return mut fx.b.use_var(found)
} Lowering.find_redistributor

/// Makes a PSCI call through the machine's conduit with a function identifier and three
/// arguments, giving its result, `PSCI_NOT_SUPPORTED` without a conduit.
fn Lowering.psci_call(mut self, mut fx: Fx, function: clif::Value, args: Slice[clif::Value]) -> clif::Value {
    expect args.len() > 2
    let record = mut self.machine_record(mut fx)
    let conduit = mut fx.load(PTR, addr: record, offset: MACHINE_CONDUIT)
    let hvc = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: conduit, y: CONDUIT_HVC)
    let smc = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: conduit, y: CONDUIT_SMC)
    let call = fx.list4(function, b: args[0], c: args[1], d: args[2])
    let result = mut fx.choose_in(mut self, condition: hvc, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return mut lo1.call_stub(mut fx1, stub: Stub.Hvc, args: call.view())
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return mut fx1.choose_in(mut lo1, condition: smc, results: fx1.types1(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return mut lo2.call_stub(mut fx2, stub: Stub.Smc, args: call.view())
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(mut fx2.ptr(PSCI_NOT_SUPPORTED.to_bits()))
        })
    })
    return result[0]
} Lowering.psci_call

/// The machine's description in the ACPI tables the RSDP reaches: the MADT's CPU interfaces,
/// usable ones other than the boot CPU's becoming CPUs, each with the redistributor it names, its
/// distributor, redistributor regions and first ITS; the FADT's PSCI conduit; and the SPCR's UART.
fn Lowering.acpi_discovery(mut self, mut fx: Fx, rsdp: clif::Value, boot: clif::Value) {
    let record = mut self.machine_record(mut fx)
    mut self.madt_entries(mut fx, rsdp, visit: fn(mut lo1: Lowering, mut fx1: Fx, at: clif::Value, kind: clif::Value) {
        let gicc = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: MADT_GICC)
        mut fx1.if_true(gicc, then: fn[mut lo1](mut fx2: Fx) {
            let flags = load_u32(mut fx2, address: at, offset: MADT_GICC_FLAGS)
            let enabled_bit = mut fx2.b.band_imm_s(flags, y: MADT_ENABLED)
            let enabled = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: enabled_bit, y: 0)
            let mpidr = load_u64(mut fx2, address: at, offset: MADT_GICC_MPIDR)
            let affinity = mut fx2.b.band_imm_s(mpidr, y: MPIDR_AFFINITY)
            let redistributor = load_u64(mut fx2, address: at, offset: MADT_GICC_GICR)
            let own = mut fx2.b.icmp(clif::IntCC.Equal, x: affinity, y: boot)
            mut fx2.if_true(own, then: fn[mut lo1](mut fx3: Fx) {
                let boot_record = mut lo1.cpu_records(mut fx3)
                mut fx3.store(redistributor, addr: boot_record, offset: CPU_REDISTRIBUTOR)
            })
            let other = mut fx2.b.bxor_imm_s(own, y: 1)
            let taken = mut fx2.b.band(enabled, y: other)
            mut fx2.if_true(taken, then: fn[mut lo1](mut fx3: Fx) {
                mut lo1.add_cpu(mut fx3, affinity, redistributor)
            })
        })
        let gicd = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: MADT_GICD)
        mut fx1.if_true(gicd, then: fn(mut fx2: Fx) {
            let base = load_u64(mut fx2, address: at, offset: MADT_GICD_BASE)
            first_field(mut fx2, record, field: MACHINE_GICD, value: base)
        })
        let gicr = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: MADT_GICR)
        mut fx1.if_true(gicr, then: fn(mut fx2: Fx) {
            let base = load_u64(mut fx2, address: at, offset: MADT_GICR_BASE)
            let len = load_u32(mut fx2, address: at, offset: MADT_GICR_LENGTH)
            add_region(mut fx2, record, base, len)
        })
        let its = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: MADT_ITS)
        mut fx1.if_true(its, then: fn(mut fx2: Fx) {
            let base = load_u64(mut fx2, address: at, offset: MADT_ITS_BASE)
            first_field(mut fx2, record, field: MACHINE_ITS, value: base)
        })
    })
    mut self.acpi_conduit(mut fx, rsdp, record)
    mut self.acpi_uart(mut fx, rsdp, record)
} Lowering.acpi_discovery

/// Records the PSCI conduit the FADT's boot architecture flags name.
fn Lowering.acpi_conduit(mut self, mut fx: Fx, rsdp: clif::Value, record: clif::Value) {
    let fadt = mut self.acpi_table(mut fx, rsdp, signature: FADT_SIGNATURE)
    let fadt_present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: fadt, y: 0)
    mut fx.if_true(fadt_present, then: fn(mut fx1: Fx) {
        let length = load_u32(mut fx1, address: fadt, offset: 4)
        let long = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: length, y: FADT_ARM_LENGTH)
        mut fx1.if_true(long, then: fn(mut fx2: Fx) {
            let flags_half = mut fx2.load_ordered(clif::Type.Int16, addr: fadt, offset: FADT_ARM_BOOT, unaligned_access: true, big: false)
            let flags = mut fx2.b.uextend(PTR, x: flags_half)
            let compliant_bit = mut fx2.b.band_imm_s(flags, y: PSCI_COMPLIANT)
            let compliant = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: compliant_bit, y: 0)
            let hvc_bit = mut fx2.b.band_imm_s(flags, y: PSCI_USE_HVC)
            let hvc = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: hvc_bit, y: 0)
            let by_hvc = mut fx2.ptr(u64.fit(CONDUIT_HVC))
            let by_smc = mut fx2.ptr(u64.fit(CONDUIT_SMC))
            let conduit = mut fx2.b.select(hvc, x: by_hvc, y: by_smc)
            mut fx2.if_true(compliant, then: fn(mut fx3: Fx) {
                mut fx3.store(conduit, addr: record, offset: MACHINE_CONDUIT)
            })
        })
    })
} Lowering.acpi_conduit

/// Records the UART the SPCR names.
fn Lowering.acpi_uart(mut self, mut fx: Fx, rsdp: clif::Value, record: clif::Value) {
    let spcr = mut self.acpi_table(mut fx, rsdp, signature: SPCR_SIGNATURE)
    let spcr_present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: spcr, y: 0)
    mut fx.if_true(spcr_present, then: fn(mut fx1: Fx) {
        let address_space = mut fx1.load_ordered(clif::Type.Int8, addr: spcr, offset: SPCR_SPACE, unaligned_access: true, big: false)
        let memory = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: address_space, y: 0)
        let interface_type = mut fx1.load_ordered(clif::Type.Int8, addr: spcr, offset: SPCR_TYPE, unaligned_access: true, big: false)
        let access = mut fx1.load_ordered(clif::Type.Int8, addr: spcr, offset: SPCR_ACCESS, unaligned_access: true, big: false)
        let base = load_u64(mut fx1, address: spcr, offset: SPCR_ADDRESS)
        let pl011 = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: interface_type, y: SPCR_PL011)
        var sbsa = mut fx1.int(clif::Type.Int8, value: 0)
        for listed_kind in SPCR_SBSA {
            let same = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: interface_type, y: listed_kind)
            sbsa = mut fx1.b.bor(sbsa, y: same)
        }
        var ns16550 = mut fx1.int(clif::Type.Int8, value: 0)
        for listed_kind in SPCR_16550 {
            let same = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: interface_type, y: listed_kind)
            ns16550 = mut fx1.b.bor(ns16550, y: same)
        }
        let kind = uart_kind(mut fx1, pl011, sbsa, ns16550)
        let dword = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: access, y: SPCR_DWORD)
        let two = mut fx1.ptr(2)
        let zero_value = mut fx1.ptr(0)
        let shift = mut fx1.b.select(dword, x: two, y: zero_value)
        let four = mut fx1.ptr(4)
        let one = mut fx1.ptr(1)
        let narrow = mut fx1.b.select(dword, x: four, y: one)
        let width = mut fx1.b.select(ns16550, x: narrow, y: four)
        let known = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: kind, y: 0)
        let placed = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: base, y: 0)
        let in_memory = mut fx1.b.band(memory, y: known)
        let usable = mut fx1.b.band(in_memory, y: placed)
        mut fx1.if_true(usable, then: fn(mut fx2: Fx) {
            set_uart(mut fx2, record, base, kind, shift, width)
        })
    })
} Lowering.acpi_uart

/// Records a CPU of an affinity and redistributor after those found, unless `MAX_CPUS` are.
fn Lowering.add_cpu(mut self, mut fx: Fx, affinity: clif::Value, redistributor: clif::Value) {
    let record = mut self.machine_record(mut fx)
    let count = mut fx.load(PTR, addr: record, offset: MACHINE_CPUS)
    let room = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: count, y: i64.fit(MAX_CPUS))
    mut fx.if_true(room, then: fn[mut self](mut fx1: Fx) {
        let at = mut self.cpu_record(mut fx1, index: count)
        mut fx1.store(affinity, addr: at, offset: CPU_HARDWARE_ID)
        mut fx1.store(redistributor, addr: at, offset: CPU_REDISTRIBUTOR)
        let next = mut fx1.b.iadd_imm_s(count, y: 1)
        mut fx1.store(next, addr: record, offset: MACHINE_CPUS)
    })
} Lowering.add_cpu

/// The function discovering the machine from a device tree at its first argument, the boot CPU's
/// affinity its second: it gives 0 when no device tree lies there and 1 otherwise. It finds the
/// UART the `/chosen` node's `stdout-path` names, directly or through `/aliases`, or else the
/// first PL011; the first GICv3, ITS and PL031; the PSCI node's method; and each node of
/// `device_type` `cpu` other than the boot CPU. A device's `reg` is translated through its
/// ancestors' `ranges`, and a node whose `status` is neither `okay` nor `ok` is passed over, but
/// for a PL031, which UEFI firmware disables on taking it for its runtime services.
fn Lowering.tree_discovery(mut self) -> object::FuncId {
    let listed = mut self.listed_helper()
    let named = mut self.named_helper()
    let translate = mut self.translate_helper()
    let helpers = TreeHelpers(listed: listed, named: named, translate: translate)
    var signature = clif::Signature.new(CALL_CONV, alloc: self.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    mut signature.returns.push(clif::AbiParam(value_type: PTR))
    let id = mut self.module.declare_function("_NSdiscover_tree", linkage: object::Linkage.Local, signature)
    mut self.define(id, take signature, flags: LINES_HIDDEN, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        let params = mut fx1.entry()
        expect params.len() > 1
        let tree = params[0]
        let boot = params[1]
        let given = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: tree, y: 0)
        let magic = mut fx1.choose(given, results: fx1.types1(PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(tree_cell(mut fx2, at: tree, offset: 0))
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(mut fx2.ptr(0))
        })
        let valid = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: magic[0], y: DEVICE_TREE_MAGIC)
        mut fx1.if_true(valid, then: fn[mut lo1](mut fx2: Fx) {
            let path = mut lo1.stdout_path(mut fx2, tree, helpers)
            mut lo1.walk_tree(mut fx2, tree, path, boot, helpers)
            let one = mut fx2.ptr(1)
            mut fx2.b.ret(fx2.list1(one).view())
        })
        let zero_value = mut fx1.ptr(0)
        mut fx1.b.ret(fx1.list1(zero_value).view())
    })
    return id
} Lowering.tree_discovery

/// The path of the node the `/chosen` node's `stdout-path` or `linux,stdout-path` names, an alias
/// resolved through `/aliases`; zero when it names none.
fn Lowering.stdout_path(mut self, mut fx: Fx, tree: clif::Value, helpers: TreeHelpers) -> clif::Value {
    let structure = tree_address(mut fx, tree, field: DEVICE_TREE_STRUCTURE)
    let strings = tree_address(mut fx, tree, field: DEVICE_TREE_STRINGS)
    let zero_value = mut fx.ptr(0)
    let depth = mut fx.variable(PTR, initial: zero_value)
    let chosen = mut fx.variable(PTR, initial: zero_value)
    let aliases = mut fx.variable(PTR, initial: zero_value)
    let stdout = mut fx.variable(PTR, initial: zero_value)
    discard mut fx.repeat(fx.list1(structure).view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() > 0
        let at = current[0]
        let token = tree_cell(mut fx1, at, offset: 0)
        let name = mut fx1.b.iadd_imm_s(at, y: 4)
        let next = mut fx1.variable(PTR, initial: name)
        let open = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: token, y: DEVICE_TREE_BEGIN_NODE)
        mut fx1.if_true(open, then: fn(mut fx2: Fx) {
            let outer = mut fx2.b.use_var(depth)
            let inner = mut fx2.b.iadd_imm_s(outer, y: 1)
            mut fx2.b.def_var(depth, val: inner)
            let child = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: inner, y: 2)
            let after = name_end(mut fx2, name)
            mut fx2.b.def_var(next, val: after)
            let chosen_named = starts_with(mut fx2, at: name, text: b"chosen\0")
            let inside_byte = mut fx2.b.band(child, y: chosen_named)
            let inside = mut fx2.b.uextend(PTR, x: inside_byte)
            mut fx2.b.def_var(chosen, val: inside)
            let aliases_named = starts_with(mut fx2, at: name, text: b"aliases\0")
            let found = mut fx2.b.band(child, y: aliases_named)
            mut fx2.if_true(found, then: fn(mut fx3: Fx) {
                mut fx3.b.def_var(aliases, val: after)
            })
        })
        let close = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: token, y: DEVICE_TREE_END_NODE)
        mut fx1.if_true(close, then: fn(mut fx2: Fx) {
            let inner = mut fx2.b.use_var(depth)
            let outer = mut fx2.b.iadd_imm_s(inner, y: -1)
            mut fx2.b.def_var(depth, val: outer)
            let none = mut fx2.ptr(0)
            mut fx2.b.def_var(chosen, val: none)
        })
        let property = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: token, y: DEVICE_TREE_PROPERTY)
        mut fx1.if_true(property, then: fn(mut fx2: Fx) {
            let read = structure_property(mut fx2, at, strings)
            mut fx2.b.def_var(next, val: read.after)
            let inside_word = mut fx2.b.use_var(chosen)
            let inside = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: inside_word, y: 0)
            let plain = starts_with(mut fx2, at: read.name, text: b"stdout-path\0")
            let linux = starts_with(mut fx2, at: read.name, text: b"linux,stdout-path\0")
            let named = mut fx2.b.bor(plain, y: linux)
            let found = mut fx2.b.band(inside, y: named)
            mut fx2.if_true(found, then: fn(mut fx3: Fx) {
                mut fx3.b.def_var(stdout, val: read.value)
            })
        })
        let more = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: token, y: DEVICE_TREE_END)
        return Pass(again: more, next: fx1.list1(mut fx1.b.use_var(next)))
    })
    let stdout_value = mut fx.b.use_var(stdout)
    let given = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: stdout_value, y: 0)
    let path = mut fx.choose_in(mut self, condition: given, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let leading = mut fx1.load(clif::Type.Int8, addr: stdout_value, offset: 0)
        let full = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: leading, y: i64.widen(b'/'))
        return mut fx1.choose_in(mut lo1, condition: full, results: fx1.types1(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(stdout_value)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let aliases_at = mut fx2.b.use_var(aliases)
            return fx2.list1(mut lo2.alias(mut fx2, aliases: aliases_at, strings, name: stdout_value, helpers))
        })
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut fx1.ptr(0))
    })
    return path[0]
} Lowering.stdout_path

/// The value of the property of the `/aliases` node, whose properties start at `aliases`, named
/// as the alias at `name` before any `:`; zero when there is none.
fn Lowering.alias(mut self, mut fx: Fx, aliases: clif::Value, strings: clif::Value, name: clif::Value, helpers: TreeHelpers) -> clif::Value {
    let zero_value = mut fx.ptr(0)
    let found = mut fx.variable(PTR, initial: zero_value)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: aliases, y: 0)
    mut fx.if_true(present, then: fn[mut self](mut fx1: Fx) {
        discard mut fx1.repeat(fx1.list1(aliases).view(), body: fn[mut self](mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() > 0
            let at = current[0]
            let token = tree_cell(mut fx2, at, offset: 0)
            let property = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: token, y: DEVICE_TREE_PROPERTY)
            let next = mut fx2.choose_in(mut self, condition: property, results: fx2.types1(PTR).view(), then: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                let read = structure_property(mut fx3, at, strings)
                let named = mut lo3.call_helper(mut fx3, helper: helpers.named, args: fx3.list2(read.name, b: name).view())
                let same = mut fx3.b.icmp_imm_s(clif::IntCC.NotEqual, x: named, y: 0)
                mut fx3.if_true(same, then: fn(mut fx4: Fx) {
                    mut fx4.b.def_var(found, val: read.value)
                })
                return fx3.list1(read.after)
            }, otherwise: fn(mut lo3: Lowering, mut fx3: Fx) -> mem::List[clif::Value] {
                return fx3.list1(mut fx3.b.iadd_imm_s(at, y: 4))
            })
            let nop = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: token, y: DEVICE_TREE_NOP)
            let more = mut fx2.b.bor(property, y: nop)
            return Pass(again: more, next: fx2.list1(next[0]))
        })
    })
    return mut fx.b.use_var(found)
} Lowering.alias

/// Walks the device tree's structure block, recording into the machine record what each node
/// describes once its properties end.
fn Lowering.walk_tree(mut self, mut fx: Fx, tree: clif::Value, path: clif::Value, boot: clif::Value, helpers: TreeHelpers) {
    let structure = tree_address(mut fx, tree, field: DEVICE_TREE_STRUCTURE)
    let strings = tree_address(mut fx, tree, field: DEVICE_TREE_STRINGS)
    let levels = mut fx.slot(DEVICE_TREE_DEPTHS * LEVEL_SIZE, align: 8)
    let zero_value = mut fx.ptr(0)
    let depth = mut fx.variable(PTR, initial: zero_value)
    let pending = mut fx.variable(PTR, initial: zero_value)
    let fixed = mut fx.variable(PTR, initial: zero_value)
    let reg = mut fx.variable(PTR, initial: zero_value)
    let reg_len = mut fx.variable(PTR, initial: zero_value)
    let kinds = mut fx.variable(PTR, initial: zero_value)
    let cpu = mut fx.variable(PTR, initial: zero_value)
    let shift = mut fx.variable(PTR, initial: zero_value)
    let width = mut fx.variable(PTR, initial: zero_value)
    let method = mut fx.variable(PTR, initial: zero_value)
    let stated_regions = mut fx.variable(PTR, initial: zero_value)
    let disabled = mut fx.variable(PTR, initial: zero_value)
    let node = TreeNode(reg: reg, reg_len: reg_len, kinds: kinds, cpu: cpu, shift: shift, width: width, method: method, regions: stated_regions, disabled: disabled)
    discard mut fx.repeat(fx.list1(structure).view(), body: fn[mut self](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() > 0
        let at = current[0]
        let token = tree_cell(mut fx1, at, offset: 0)
        let after = mut fx1.b.iadd_imm_s(at, y: 4)
        let next = mut fx1.variable(PTR, initial: after)
        let open = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: token, y: DEVICE_TREE_BEGIN_NODE)
        let close = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: token, y: DEVICE_TREE_END_NODE)
        let either = mut fx1.b.bor(open, y: close)
        let waiting_word = mut fx1.b.use_var(pending)
        let waiting = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: waiting_word, y: 0)
        let ends = mut fx1.b.band(either, y: waiting)
        mut fx1.if_true(ends, then: fn[mut self](mut fx2: Fx) {
            let inner = mut fx2.b.use_var(depth)
            mut self.tree_node(mut fx2, levels, depth: inner, node, fixed, boot, helpers)
            let none = mut fx2.ptr(0)
            mut fx2.b.def_var(pending, val: none)
        })
        mut fx1.if_true(open, then: fn[mut self](mut fx2: Fx) {
            mut self.open_node(mut fx2, walk: TreeWalkState(levels: levels, depth: depth, pending: pending, next: next, node: node), name: after, path, helpers)
        })
        mut fx1.if_true(close, then: fn(mut fx2: Fx) {
            let inner = mut fx2.b.use_var(depth)
            let outer = mut fx2.b.iadd_imm_s(inner, y: -1)
            mut fx2.b.def_var(depth, val: outer)
        })
        let property = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: token, y: DEVICE_TREE_PROPERTY)
        mut fx1.if_true(property, then: fn[mut self](mut fx2: Fx) {
            let read = structure_property(mut fx2, at, strings)
            mut fx2.b.def_var(next, val: read.after)
            let inner = mut fx2.b.use_var(depth)
            let tracked = mut fx2.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: inner, y: i64.fit(DEVICE_TREE_DEPTHS))
            mut fx2.if_true(tracked, then: fn[mut self](mut fx3: Fx) {
                let entry_offset = mut fx3.b.imul_imm_s(inner, y: i64.fit(LEVEL_SIZE))
                let entry = mut fx3.b.iadd(levels, y: entry_offset)
                mut self.read_property(mut fx3, entry, node, read, helpers)
            })
        })
        let more = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: token, y: DEVICE_TREE_END)
        return Pass(again: more, next: fx1.list1(mut fx1.b.use_var(next)))
    })
} Lowering.walk_tree

/// The variables and storage of a walk of a device tree's structure block: the level entries,
/// the depth of the node it is in, whether that node's properties are yet to be recorded, the
/// address of the next token, and the node's record.
struct TreeWalkState derives Copy {
    levels: clif::Value
    depth: clif::Variable
    pending: clif::Variable
    next: clif::Variable
    node: TreeNode
} TreeWalkState

/// Enters the node named at `name`: a level deeper, its level entry, while tracked, given the
/// default cells, no `ranges` and its place in the UART's path, and its record cleared.
fn Lowering.open_node(mut self, mut fx: Fx, walk: TreeWalkState, name: clif::Value, path: clif::Value, helpers: TreeHelpers) {
    let outer = mut fx.b.use_var(walk.depth)
    let inner = mut fx.b.iadd_imm_s(outer, y: 1)
    mut fx.b.def_var(walk.depth, val: inner)
    let end = name_end(mut fx, name)
    mut fx.b.def_var(walk.next, val: end)
    let tracked = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: inner, y: i64.fit(DEVICE_TREE_DEPTHS))
    mut fx.if_true(tracked, then: fn[mut self](mut fx1: Fx) {
        let entry_offset = mut fx1.b.imul_imm_s(inner, y: i64.fit(LEVEL_SIZE))
        let entry = mut fx1.b.iadd(walk.levels, y: entry_offset)
        let address_cells = mut fx1.ptr(DEVICE_TREE_ADDRESS_CELLS)
        mut fx1.store(address_cells, addr: entry, offset: LEVEL_ADDRESS_CELLS)
        let size_cells = mut fx1.ptr(DEVICE_TREE_SIZE_CELLS)
        mut fx1.store(size_cells, addr: entry, offset: LEVEL_SIZE_CELLS)
        let none = mut fx1.ptr(0)
        mut fx1.store(none, addr: entry, offset: LEVEL_RANGES)
        mut fx1.store(none, addr: entry, offset: LEVEL_RANGES_LEN)
        let root = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: inner, y: 1)
        let place = mut fx1.choose_in(mut self, condition: root, results: fx1.types1(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let given = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: path, y: 0)
            let past = mut fx2.b.iadd_imm_s(path, y: 1)
            let unset = mut fx2.ptr(0)
            return fx2.list1(mut fx2.b.select(given, x: past, y: unset))
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let parent = mut fx2.b.iadd_imm_s(entry, y: -i64.fit(LEVEL_SIZE))
            let from = mut fx2.load(PTR, addr: parent, offset: LEVEL_PATH)
            return fx2.list1(mut lo2.path_step(mut fx2, from, name, helpers))
        })
        mut fx1.store(place[0], addr: entry, offset: LEVEL_PATH)
    })
    let cleared = mut fx.ptr(0)
    mut fx.b.def_var(walk.node.reg, val: cleared)
    mut fx.b.def_var(walk.node.reg_len, val: cleared)
    mut fx.b.def_var(walk.node.kinds, val: cleared)
    mut fx.b.def_var(walk.node.cpu, val: cleared)
    mut fx.b.def_var(walk.node.shift, val: cleared)
    mut fx.b.def_var(walk.node.method, val: cleared)
    mut fx.b.def_var(walk.node.disabled, val: cleared)
    let one = mut fx.ptr(1)
    mut fx.b.def_var(walk.node.width, val: one)
    mut fx.b.def_var(walk.node.regions, val: one)
    mut fx.b.def_var(walk.pending, val: one)
} Lowering.open_node

/// The place in a path past the component at `from` when it names the node `name`, past its `/`
/// when one follows; zero when `from` is zero or the component names another node.
fn Lowering.path_step(mut self, mut fx: Fx, from: clif::Value, name: clif::Value, helpers: TreeHelpers) -> clif::Value {
    let given = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: from, y: 0)
    let step = mut fx.choose_in(mut self, condition: given, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let end = mut lo1.call_helper(mut fx1, helper: helpers.named, args: fx1.list2(name, b: from).view())
        let matched = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: end, y: 0)
        let stop = mut fx1.choose(matched, results: fx1.types1(clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(mut fx2.load(clif::Type.Int8, addr: end, offset: 0))
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(mut fx2.int(clif::Type.Int8, value: 0))
        })
        let slash = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: stop[0], y: i64.widen(b'/'))
        let past = mut fx1.b.iadd_imm_s(end, y: 1)
        return fx1.list1(mut fx1.b.select(slash, x: past, y: end))
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut fx1.ptr(0))
    })
    return step[0]
} Lowering.path_step

/// Reads a property of the node whose level entry is `entry` into that entry or the node's
/// record.
fn Lowering.read_property(mut self, mut fx: Fx, entry: clif::Value, node: TreeNode, read: TreeProperty, helpers: TreeHelpers) {
    let first_cell = mut fx.choose(read.len, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(tree_cell(mut fx1, at: read.value, offset: 0))
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut fx1.ptr(0))
    })
    let cell = first_cell[0]
    let address_named = starts_with(mut fx, at: read.name, text: b"#address-cells\0")
    mut fx.if_true(address_named, then: fn(mut fx1: Fx) {
        mut fx1.store(cell, addr: entry, offset: LEVEL_ADDRESS_CELLS)
    })
    let size_named = starts_with(mut fx, at: read.name, text: b"#size-cells\0")
    mut fx.if_true(size_named, then: fn(mut fx1: Fx) {
        mut fx1.store(cell, addr: entry, offset: LEVEL_SIZE_CELLS)
    })
    let ranges_named = starts_with(mut fx, at: read.name, text: b"ranges\0")
    mut fx.if_true(ranges_named, then: fn(mut fx1: Fx) {
        mut fx1.store(read.value, addr: entry, offset: LEVEL_RANGES)
        mut fx1.store(read.len, addr: entry, offset: LEVEL_RANGES_LEN)
    })
    let reg_named = starts_with(mut fx, at: read.name, text: b"reg\0")
    mut fx.if_true(reg_named, then: fn(mut fx1: Fx) {
        mut fx1.b.def_var(node.reg, val: read.value)
        mut fx1.b.def_var(node.reg_len, val: read.len)
    })
    let shift_named = starts_with(mut fx, at: read.name, text: b"reg-shift\0")
    mut fx.if_true(shift_named, then: fn(mut fx1: Fx) {
        mut fx1.b.def_var(node.shift, val: cell)
    })
    let width_named = starts_with(mut fx, at: read.name, text: b"reg-io-width\0")
    mut fx.if_true(width_named, then: fn(mut fx1: Fx) {
        mut fx1.b.def_var(node.width, val: cell)
    })
    let regions_named = starts_with(mut fx, at: read.name, text: b"#redistributor-regions\0")
    mut fx.if_true(regions_named, then: fn(mut fx1: Fx) {
        mut fx1.b.def_var(node.regions, val: cell)
    })
    let compatible_named = starts_with(mut fx, at: read.name, text: b"compatible\0")
    mut fx.if_true(compatible_named, then: fn[mut self](mut fx1: Fx) {
        mut self.compatible(mut fx1, node, read, helpers, string: b"arm,pl011\0", bit: COMPATIBLE_PL011)
        mut self.compatible(mut fx1, node, read, helpers, string: b"arm,sbsa-uart\0", bit: COMPATIBLE_SBSA)
        mut self.compatible(mut fx1, node, read, helpers, string: b"ns16550a\0", bit: COMPATIBLE_NS16550)
        mut self.compatible(mut fx1, node, read, helpers, string: b"ns16550\0", bit: COMPATIBLE_NS16550)
        mut self.compatible(mut fx1, node, read, helpers, string: b"snps,dw-apb-uart\0", bit: COMPATIBLE_NS16550)
        mut self.compatible(mut fx1, node, read, helpers, string: b"arm,gic-v3\0", bit: COMPATIBLE_GIC)
        mut self.compatible(mut fx1, node, read, helpers, string: b"arm,gic-v3-its\0", bit: COMPATIBLE_ITS)
        mut self.compatible(mut fx1, node, read, helpers, string: b"arm,pl031\0", bit: COMPATIBLE_RTC)
        mut self.compatible(mut fx1, node, read, helpers, string: b"arm,psci\0", bit: COMPATIBLE_PSCI)
        mut self.compatible(mut fx1, node, read, helpers, string: b"arm,psci-0.2\0", bit: COMPATIBLE_PSCI)
        mut self.compatible(mut fx1, node, read, helpers, string: b"arm,psci-1.0\0", bit: COMPATIBLE_PSCI)
    })
    let type_named = starts_with(mut fx, at: read.name, text: b"device_type\0")
    mut fx.if_true(type_named, then: fn(mut fx1: Fx) {
        let cpu_named = starts_with(mut fx1, at: read.value, text: b"cpu\0")
        let cpu = mut fx1.b.uextend(PTR, x: cpu_named)
        mut fx1.b.def_var(node.cpu, val: cpu)
    })
    let method_named = starts_with(mut fx, at: read.name, text: b"method\0")
    mut fx.if_true(method_named, then: fn(mut fx1: Fx) {
        let hvc = starts_with(mut fx1, at: read.value, text: b"hvc\0")
        let smc = starts_with(mut fx1, at: read.value, text: b"smc\0")
        let by_hvc = mut fx1.ptr(u64.fit(CONDUIT_HVC))
        let by_smc = mut fx1.ptr(u64.fit(CONDUIT_SMC))
        let none = mut fx1.ptr(0)
        let by_smc_or_none = mut fx1.b.select(smc, x: by_smc, y: none)
        let method = mut fx1.b.select(hvc, x: by_hvc, y: by_smc_or_none)
        mut fx1.b.def_var(node.method, val: method)
    })
    let status_named = starts_with(mut fx, at: read.name, text: b"status\0")
    mut fx.if_true(status_named, then: fn(mut fx1: Fx) {
        let okay = starts_with(mut fx1, at: read.value, text: b"okay\0")
        let ok = starts_with(mut fx1, at: read.value, text: b"ok\0")
        let enabled = mut fx1.b.bor(okay, y: ok)
        let disabled_byte = mut fx1.b.bxor_imm_s(enabled, y: 1)
        let disabled = mut fx1.b.uextend(PTR, x: disabled_byte)
        mut fx1.b.def_var(node.disabled, val: disabled)
    })
} Lowering.read_property

/// Adds `bit` to the node's kinds when its `compatible` property lists `string`.
fn Lowering.compatible(mut self, mut fx: Fx, node: TreeNode, read: TreeProperty, helpers: TreeHelpers, string: Slice[u8], bit: i64) {
    let wanted_data = mut self.bytes_data(string)
    let wanted = mut self.data_address(mut fx, id: wanted_data)
    let held = mut self.call_helper(mut fx, helper: helpers.listed, args: fx.list3(read.value, b: read.len, c: wanted).view())
    let kind_bit = mut fx.b.imul_imm_s(held, y: bit)
    let before = mut fx.b.use_var(node.kinds)
    let after = mut fx.b.bor(before, y: kind_bit)
    mut fx.b.def_var(node.kinds, val: after)
} Lowering.compatible

/// Whether a node whose properties have ended is read: its `status` does not disable it, or it
/// is a PL031.
fn node_enabled(mut fx: Fx, disabled: clif::Value, kinds: clif::Value) -> clif::Value {
    let clock_bit = mut fx.b.band_imm_s(kinds, y: COMPATIBLE_RTC)
    let clock = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: clock_bit, y: 0)
    let status_enabled = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: disabled, y: 0)
    return mut fx.b.bor(status_enabled, y: clock)
} node_enabled

/// Records what the node at `depth`, whose properties have ended, describes: a CPU's affinity,
/// the GICv3's distributor and redistributor regions, the ITS's, PL031's and UART's bases, and
/// the PSCI conduit.
fn Lowering.tree_node(mut self, mut fx: Fx, levels: clif::Value, depth: clif::Value, node: TreeNode, fixed: clif::Variable, boot: clif::Value, helpers: TreeHelpers) {
    let disabled = mut fx.b.use_var(node.disabled)
    let kinds = mut fx.b.use_var(node.kinds)
    let enabled = node_enabled(mut fx, disabled, kinds)
    let nested = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: depth, y: 2)
    let tracked = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: depth, y: i64.fit(DEVICE_TREE_DEPTHS))
    let enabled_nested = mut fx.b.band(enabled, y: nested)
    let usable = mut fx.b.band(enabled_nested, y: tracked)
    mut fx.if_true(usable, then: fn[mut self](mut fx1: Fx) {
        let record = mut self.machine_record(mut fx1)
        let entry_offset = mut fx1.b.imul_imm_s(depth, y: i64.fit(LEVEL_SIZE))
        let entry = mut fx1.b.iadd(levels, y: entry_offset)
        let parent = mut fx1.b.iadd_imm_s(entry, y: -i64.fit(LEVEL_SIZE))
        let address_cells = mut fx1.load(PTR, addr: parent, offset: LEVEL_ADDRESS_CELLS)
        let size_cells = mut fx1.load(PTR, addr: parent, offset: LEVEL_SIZE_CELLS)
        let reg = mut fx1.b.use_var(node.reg)
        let reg_len = mut fx1.b.use_var(node.reg_len)
        let cells = mut fx1.b.iadd(address_cells, y: size_cells)
        let pair = mut fx1.b.ishl_imm_s(cells, y: 2)
        let one = mut fx1.ptr(1)
        let none = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: pair, y: 0)
        let divisor = mut fx1.b.select(none, x: one, y: pair)
        let quotient = mut fx1.b.udiv(reg_len, y: divisor)
        let zero_value = mut fx1.ptr(0)
        let count = mut fx1.b.select(none, x: zero_value, y: quotient)
        let has_reg = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: count, y: 0)
        let cpu_flag = mut fx1.b.use_var(node.cpu)
        let cpu_named = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: cpu_flag, y: 0)
        let cpu = mut fx1.b.band(cpu_named, y: has_reg)
        mut fx1.if_true(cpu, then: fn[mut self](mut fx2: Fx) {
            let mpidr = tree_number(mut fx2, at: reg, count: address_cells)
            let affinity = mut fx2.b.band_imm_s(mpidr, y: MPIDR_AFFINITY)
            let other = mut fx2.b.icmp(clif::IntCC.NotEqual, x: affinity, y: boot)
            mut fx2.if_true(other, then: fn[mut self](mut fx3: Fx) {
                let no_redistributor = mut fx3.ptr(0)
                mut self.add_cpu(mut fx3, affinity, redistributor: no_redistributor)
            })
        })
        let psci_bit = mut fx1.b.band_imm_s(kinds, y: COMPATIBLE_PSCI)
        let psci = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: psci_bit, y: 0)
        mut fx1.if_true(psci, then: fn(mut fx2: Fx) {
            let method = mut fx2.b.use_var(node.method)
            mut fx2.store(method, addr: record, offset: MACHINE_CONDUIT)
        })
        mut fx1.if_true(has_reg, then: fn[mut self](mut fx2: Fx) {
            let size_offset = mut fx2.b.ishl_imm_s(address_cells, y: 2)
            let reg_at = RegEntries(reg: reg, pair: pair, address_cells: address_cells, size_cells: size_cells, size_offset: size_offset, depth: depth, levels: levels, translate: helpers.translate)
            let first_index = mut fx2.ptr(0)
            let leading = mut self.reg_entry(mut fx2, entries: reg_at, index: first_index)
            let base = leading.start
            let its_bit = mut fx2.b.band_imm_s(kinds, y: COMPATIBLE_ITS)
            let its = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: its_bit, y: 0)
            mut fx2.if_true(its, then: fn(mut fx3: Fx) {
                first_field(mut fx3, record, field: MACHINE_ITS, value: base)
            })
            let rtc_bit = mut fx2.b.band_imm_s(kinds, y: COMPATIBLE_RTC)
            let rtc = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: rtc_bit, y: 0)
            mut fx2.if_true(rtc, then: fn(mut fx3: Fx) {
                first_field(mut fx3, record, field: MACHINE_RTC, value: base)
            })
            let gic_bit = mut fx2.b.band_imm_s(kinds, y: COMPATIBLE_GIC)
            let gic_named = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: gic_bit, y: 0)
            let held = mut fx2.load(PTR, addr: record, offset: MACHINE_GICD)
            let unset_gicd = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: held, y: 0)
            let gic = mut fx2.b.band(gic_named, y: unset_gicd)
            mut fx2.if_true(gic, then: fn[mut self](mut fx3: Fx) {
                mut fx3.store(base, addr: record, offset: MACHINE_GICD)
                let stated = mut fx3.b.use_var(node.regions)
                let listed = mut fx3.b.iadd_imm_s(count, y: -1)
                let region_count = mut fx3.b.umin(stated, y: listed)
                let step = mut fx3.ptr(1)
                mut fx3.each(first_index, end: region_count, body: fn[mut self](mut fx4: Fx, index: clif::Value) {
                    let at = mut fx4.b.iadd(index, y: step)
                    let region = mut self.reg_entry(mut fx4, entries: reg_at, index: at)
                    add_region(mut fx4, record, base: region.start, len: region.end)
                })
            })
            tree_uart(mut fx2, record, entry, node, fixed, kinds, base)
        })
    })
} Lowering.tree_node

/// Records the UART of a node of `kinds` at `base` whose level entry is `entry`: the one the
/// UART's path ends at, or else the first PL011.
fn tree_uart(mut fx: Fx, record: clif::Value, entry: clif::Value, node: TreeNode, fixed: clif::Variable, kinds: clif::Value, base: clif::Value) {
    let pl011_bit = mut fx.b.band_imm_s(kinds, y: COMPATIBLE_PL011)
    let pl011 = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: pl011_bit, y: 0)
    let sbsa_bit = mut fx.b.band_imm_s(kinds, y: COMPATIBLE_SBSA)
    let sbsa = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: sbsa_bit, y: 0)
    let ns16550_bit = mut fx.b.band_imm_s(kinds, y: COMPATIBLE_NS16550)
    let ns16550 = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: ns16550_bit, y: 0)
    let kind = uart_kind(mut fx, pl011, sbsa, ns16550)
    let place = mut fx.load(PTR, addr: entry, offset: LEVEL_PATH)
    let on_path = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: place, y: 0)
    let stop = mut fx.choose(on_path, results: fx.types1(clif::Type.Int8).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut fx1.load(clif::Type.Int8, addr: place, offset: 0))
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut fx1.int(clif::Type.Int8, value: i64.widen(b'/')))
    })
    let ended = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: stop[0], y: 0)
    let options = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: stop[0], y: i64.widen(b':'))
    let named = mut fx.b.bor(ended, y: options)
    let fixed_word = mut fx.b.use_var(fixed)
    let open = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: fixed_word, y: 0)
    let current = mut fx.load(PTR, addr: record, offset: MACHINE_UART)
    let unset = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: current, y: 0)
    let open_unset = mut fx.b.band(open, y: unset)
    let fallback = mut fx.b.band(open_unset, y: pl011)
    let chosen = mut fx.b.bor(named, y: fallback)
    let known = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: kind, y: 0)
    let taken = mut fx.b.band(chosen, y: known)
    mut fx.if_true(taken, then: fn(mut fx1: Fx) {
        let stated_shift = mut fx1.b.use_var(node.shift)
        let stated_width = mut fx1.b.use_var(node.width)
        let none_shift = mut fx1.ptr(0)
        let shift = mut fx1.b.select(ns16550, x: stated_shift, y: none_shift)
        let four = mut fx1.ptr(4)
        let width = mut fx1.b.select(ns16550, x: stated_width, y: four)
        set_uart(mut fx1, record, base, kind, shift, width)
        let named_word = mut fx1.b.uextend(PTR, x: named)
        let before = mut fx1.b.use_var(fixed)
        let after = mut fx1.b.bor(before, y: named_word)
        mut fx1.b.def_var(fixed, val: after)
    })
} tree_uart

/// The `reg` property of a node and what reading its entries takes: the cells of an entry's
/// address and size and its bytes, the offset of its size, and the node's depth with the level
/// entries and helper translating its addresses.
struct RegEntries derives Copy {
    reg: clif::Value
    pair: clif::Value
    address_cells: clif::Value
    size_cells: clif::Value
    size_offset: clif::Value
    depth: clif::Value
    levels: clif::Value
    translate: object::FuncId
} RegEntries

/// Entry `index` of a `reg` property: its address translated into the root's space, as `start`,
/// and its size, as `end`.
fn Lowering.reg_entry(mut self, mut fx: Fx, entries: RegEntries, index: clif::Value) -> Extent {
    let offset = mut fx.b.imul(index, y: entries.pair)
    let at = mut fx.b.iadd(entries.reg, y: offset)
    let address = tree_number(mut fx, at, count: entries.address_cells)
    let translated = mut self.call_helper(mut fx, helper: entries.translate, args: fx.list3(address, b: entries.depth, c: entries.levels).view())
    let size_at = mut fx.b.iadd(at, y: entries.size_offset)
    let size = tree_number(mut fx, at: size_at, count: entries.size_cells)
    return Extent(start: translated, end: size)
} Lowering.reg_entry

/// Calls a helper function, giving its result.
fn Lowering.call_helper(mut self, mut fx: Fx, helper: object::FuncId, args: Slice[clif::Value]) -> clif::Value {
    let reference = mut self.call_ref(mut fx, id: helper)
    let call = mut fx.b.call(reference, args)
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    return results[0]
} Lowering.call_helper

/// Declares a helper function of `params` words giving a word, and defines it with `body`, which
/// receives the parameters and gives the result.
fn Lowering.helper(mut self, name: Str, params: u64, body: fn(mut lo: Lowering, mut fx: Fx, params: Slice[clif::Value]) -> clif::Value) -> object::FuncId {
    var signature = clif::Signature.new(CALL_CONV, alloc: self.alloc)
    for _ in 0..<params {
        mut signature.params.push(clif::AbiParam(value_type: PTR))
    }
    mut signature.returns.push(clif::AbiParam(value_type: PTR))
    let id = mut self.module.declare_function(name, linkage: object::Linkage.Local, signature)
    mut self.define(id, take signature, flags: LINES_HIDDEN, build: fn(mut lo1: Lowering, mut fx1: Fx) {
        let entry_params = mut fx1.entry()
        let result = body(mut lo1, fx: mut fx1, params: entry_params.view())
        mut fx1.b.ret(fx1.list1(result).view())
    })
    return id
} Lowering.helper

/// The helper giving 1 when the string list of a length at its first argument holds the
/// NUL-terminated string at its third, 0 otherwise.
fn Lowering.listed_helper(mut self) -> object::FuncId {
    return mut self.helper("_NSdt_listed", params: 3, body: fn(mut lo1: Lowering, mut fx1: Fx, params: Slice[clif::Value]) -> clif::Value {
        expect params.len() > 2
        let list = params[0]
        let len = params[1]
        let wanted = params[2]
        let end = mut fx1.b.iadd(list, y: len)
        let no = mut fx1.int(clif::Type.Int8, value: 0)
        let found = mut fx1.repeat(fx1.list2(list, b: no).view(), body: fn(mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() > 0
            let at = current[0]
            let inside = mut fx2.b.icmp(clif::IntCC.UnsignedLessThan, x: at, y: end)
            let next = mut fx2.choose(inside, results: fx2.types2(PTR, b: clif::Type.Int8).view(), then: fn(mut fx3: Fx) -> mem::List[clif::Value] {
                let same = same_text(mut fx3, left: at, right: wanted)
                let after = start_text_end(mut fx3, text: at)
                return fx3.list2(after, b: same)
            }, otherwise: fn(mut fx3: Fx) -> mem::List[clif::Value] {
                return fx3.list2(at, b: mut fx3.int(clif::Type.Int8, value: 0))
            })
            let missing = mut fx2.b.bxor_imm_s(next[1], y: 1)
            let more = mut fx2.b.band(inside, y: missing)
            return Pass(again: more, next: take next)
        })
        return mut fx1.b.uextend(PTR, x: found[1])
    })
} Lowering.listed_helper

/// The helper giving, when the NUL-terminated name at its first argument is the path component at
/// its second, which a NUL, `:` or `/` ends, the address of that end; zero otherwise.
fn Lowering.named_helper(mut self) -> object::FuncId {
    return mut self.helper("_NSdt_named", params: 2, body: fn(mut lo1: Lowering, mut fx1: Fx, params: Slice[clif::Value]) -> clif::Value {
        expect params.len() > 1
        let name = params[0]
        let at = params[1]
        let zero_value = mut fx1.ptr(0)
        let ended = mut fx1.repeat(fx1.list2(zero_value, b: zero_value).view(), body: fn(mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() > 0
            let index = current[0]
            let left_at = mut fx2.b.iadd(name, y: index)
            let left = mut fx2.load(clif::Type.Int8, addr: left_at, offset: 0)
            let right_at = mut fx2.b.iadd(at, y: index)
            let right = mut fx2.load(clif::Type.Int8, addr: right_at, offset: 0)
            var stop = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: right, y: 0)
            let colon = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: right, y: i64.widen(b':'))
            stop = mut fx2.b.bor(stop, y: colon)
            let slash = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: right, y: i64.widen(b'/'))
            stop = mut fx2.b.bor(stop, y: slash)
            let last = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: left, y: 0)
            let both_byte = mut fx2.b.band(last, y: stop)
            let both = mut fx2.b.uextend(PTR, x: both_byte)
            let same = mut fx2.b.icmp(clif::IntCC.Equal, x: left, y: right)
            let either = mut fx2.b.bor(last, y: stop)
            let neither = mut fx2.b.bxor_imm_s(either, y: 1)
            let more = mut fx2.b.band(same, y: neither)
            let stepped = mut fx2.b.iadd_imm_s(index, y: 1)
            let next = mut fx2.b.select(more, x: stepped, y: index)
            return Pass(again: more, next: fx2.list2(next, b: both))
        })
        let matched = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: ended[1], y: 0)
        let end = mut fx1.b.iadd(at, y: ended[0])
        return mut fx1.b.select(matched, x: end, y: zero_value)
    })
} Lowering.named_helper

/// The helper translating an address in the space of the parent of the node at a depth, its
/// second argument, into the root's, through the `ranges` of each ancestor below the root, from
/// the level entries at its third. An ancestor without `ranges`, with an empty one, or with none
/// covering the address leaves it as it is.
fn Lowering.translate_helper(mut self) -> object::FuncId {
    return mut self.helper("_NSdt_translate", params: 3, body: fn(mut lo1: Lowering, mut fx1: Fx, params: Slice[clif::Value]) -> clif::Value {
        expect params.len() > 2
        let address = params[0]
        let depth = params[1]
        let levels = params[2]
        let bus = mut fx1.b.iadd_imm_s(depth, y: -1)
        let translated = mut fx1.repeat(fx1.list2(address, b: bus).view(), body: fn(mut fx2: Fx, current: Slice[clif::Value]) -> Pass {
            expect current.len() > 1
            let current_address = current[0]
            let current_bus = current[1]
            let more = mut fx2.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: current_bus, y: 2)
            let next = mut fx2.choose(more, results: fx2.types1(PTR).view(), then: fn(mut fx3: Fx) -> mem::List[clif::Value] {
                return fx3.list1(translate_once(mut fx3, levels, bus: current_bus, address: current_address))
            }, otherwise: fn(mut fx3: Fx) -> mem::List[clif::Value] {
                return fx3.list1(current_address)
            })
            let outer = mut fx2.b.iadd_imm_s(current_bus, y: -1)
            return Pass(again: more, next: fx2.list2(next[0], b: outer))
        })
        return translated[0]
    })
} Lowering.translate_helper

/// An address in the space of a bus node's children translated by the bus's `ranges` into its
/// parent's space.
fn translate_once(mut fx: Fx, levels: clif::Value, bus: clif::Value, address: clif::Value) -> clif::Value {
    let entry_offset = mut fx.b.imul_imm_s(bus, y: i64.fit(LEVEL_SIZE))
    let entry = mut fx.b.iadd(levels, y: entry_offset)
    let parent = mut fx.b.iadd_imm_s(entry, y: -i64.fit(LEVEL_SIZE))
    let ranges = mut fx.load(PTR, addr: entry, offset: LEVEL_RANGES)
    let len = mut fx.load(PTR, addr: entry, offset: LEVEL_RANGES_LEN)
    let child_cells = mut fx.load(PTR, addr: entry, offset: LEVEL_ADDRESS_CELLS)
    let size_cells = mut fx.load(PTR, addr: entry, offset: LEVEL_SIZE_CELLS)
    let parent_cells = mut fx.load(PTR, addr: parent, offset: LEVEL_ADDRESS_CELLS)
    let pair_cells = mut fx.b.iadd(child_cells, y: parent_cells)
    let cells = mut fx.b.iadd(pair_cells, y: size_cells)
    let bytes = mut fx.b.ishl_imm_s(cells, y: 2)
    let one = mut fx.ptr(1)
    let none = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: bytes, y: 0)
    let divisor = mut fx.b.select(none, x: one, y: bytes)
    let quotient = mut fx.b.udiv(len, y: divisor)
    let zero_value = mut fx.ptr(0)
    let given = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: ranges, y: 0)
    let given_count = mut fx.b.select(given, x: quotient, y: zero_value)
    let count = mut fx.b.select(none, x: zero_value, y: given_count)
    let result = mut fx.variable(PTR, initial: address)
    let done = mut fx.variable(PTR, initial: zero_value)
    let parent_at = mut fx.b.ishl_imm_s(child_cells, y: 2)
    let size_cells_at = mut fx.b.iadd(child_cells, y: parent_cells)
    let size_at = mut fx.b.ishl_imm_s(size_cells_at, y: 2)
    mut fx.each(zero_value, end: count, body: fn(mut fx1: Fx, index: clif::Value) {
        let range_offset = mut fx1.b.imul(index, y: bytes)
        let at = mut fx1.b.iadd(ranges, y: range_offset)
        let child = tree_number(mut fx1, at, count: child_cells)
        let target_at = mut fx1.b.iadd(at, y: parent_at)
        let target = tree_number(mut fx1, at: target_at, count: parent_cells)
        let size_from = mut fx1.b.iadd(at, y: size_at)
        let size = tree_number(mut fx1, at: size_from, count: size_cells)
        let above = mut fx1.b.icmp(clif::IntCC.UnsignedGreaterThanOrEqual, x: address, y: child)
        let offset = mut fx1.b.isub(address, y: child)
        let below = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: offset, y: size)
        let held = mut fx1.b.use_var(done)
        let open = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: held, y: 0)
        let inside = mut fx1.b.band(above, y: below)
        let within = mut fx1.b.band(inside, y: open)
        mut fx1.if_true(within, then: fn(mut fx2: Fx) {
            let moved = mut fx2.b.iadd(target, y: offset)
            mut fx2.b.def_var(result, val: moved)
            let once = mut fx2.ptr(1)
            mut fx2.b.def_var(done, val: once)
        })
    })
    return mut fx.b.use_var(result)
} translate_once

/// The name, value, value's length and following address of the property at `at` of a device
/// tree's structure block whose strings block lies at `strings`.
fn structure_property(mut fx: Fx, at: clif::Value, strings: clif::Value) -> TreeProperty {
    let len = tree_cell(mut fx, at, offset: DEVICE_TREE_LEN)
    let offset = tree_cell(mut fx, at, offset: DEVICE_TREE_NAME)
    let name = mut fx.b.iadd(strings, y: offset)
    let value = mut fx.b.iadd_imm_s(at, y: DEVICE_TREE_VALUE)
    let bumped = mut fx.b.iadd_imm_s(len, y: 3)
    let padded = mut fx.b.band_imm_s(bumped, y: -4)
    return TreeProperty(name: name, value: value, len: len, after: mut fx.b.iadd(value, y: padded))
} structure_property

/// Whether the NUL-terminated strings at two addresses are the same, as a byte.
fn same_text(mut fx: Fx, left: clif::Value, right: clif::Value) -> clif::Value {
    let zero_value = mut fx.ptr(0)
    let no = mut fx.int(clif::Type.Int8, value: 0)
    let compared = mut fx.repeat(fx.list2(zero_value, b: no).view(), body: fn(mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() > 0
        let index = current[0]
        let one_at = mut fx1.b.iadd(left, y: index)
        let one = mut fx1.load(clif::Type.Int8, addr: one_at, offset: 0)
        let other_at = mut fx1.b.iadd(right, y: index)
        let other = mut fx1.load(clif::Type.Int8, addr: other_at, offset: 0)
        let same = mut fx1.b.icmp(clif::IntCC.Equal, x: one, y: other)
        let ended = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: one, y: 0)
        let equal = mut fx1.b.band(same, y: ended)
        let going = mut fx1.b.bxor_imm_s(ended, y: 1)
        let more = mut fx1.b.band(same, y: going)
        let next = mut fx1.b.iadd_imm_s(index, y: 1)
        return Pass(again: more, next: fx1.list2(next, b: equal))
    })
    return compared[1]
} same_text

/// The kind of a UART that is a PL011, an SBSA generic UART or a 16550, zero for none.
fn uart_kind(mut fx: Fx, pl011: clif::Value, sbsa: clif::Value, ns16550: clif::Value) -> clif::Value {
    let zero_value = mut fx.ptr(0)
    let ns16550_kind = mut fx.ptr(u64.fit(UART_NS16550))
    let kind = mut fx.b.select(ns16550, x: ns16550_kind, y: zero_value)
    let sbsa_kind = mut fx.ptr(u64.fit(UART_SBSA))
    let sbsa_or_kind = mut fx.b.select(sbsa, x: sbsa_kind, y: kind)
    let pl011_kind = mut fx.ptr(u64.fit(UART_PL011))
    return mut fx.b.select(pl011, x: pl011_kind, y: sbsa_or_kind)
} uart_kind

/// Records the UART halt reports are written to.
fn set_uart(mut fx: Fx, record: clif::Value, base: clif::Value, kind: clif::Value, shift: clif::Value, width: clif::Value) {
    mut fx.store(base, addr: record, offset: MACHINE_UART)
    mut fx.store(kind, addr: record, offset: MACHINE_UART_KIND)
    mut fx.store(shift, addr: record, offset: MACHINE_UART_SHIFT)
    mut fx.store(width, addr: record, offset: MACHINE_UART_WIDTH)
} set_uart

/// Stores `value` in a field of the machine record that still holds zero.
fn first_field(mut fx: Fx, record: clif::Value, field: u64, value: clif::Value) {
    let held = mut fx.load(PTR, addr: record, offset: field)
    let unset = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: held, y: 0)
    mut fx.if_true(unset, then: fn(mut fx1: Fx) {
        mut fx1.store(value, addr: record, offset: field)
    })
} first_field

/// Records a redistributor region after those recorded, unless `MACHINE_MOST_REGIONS` are.
fn add_region(mut fx: Fx, record: clif::Value, base: clif::Value, len: clif::Value) {
    let count = mut fx.load(PTR, addr: record, offset: MACHINE_REGIONS)
    let room = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedLessThan, x: count, y: i64.fit(MACHINE_MOST_REGIONS))
    mut fx.if_true(room, then: fn(mut fx1: Fx) {
        let at_offset = mut fx1.b.imul_imm_s(count, y: i64.fit(MACHINE_REGION_BYTES))
        let at = mut fx1.b.iadd(record, y: at_offset)
        mut fx1.store(base, addr: at, offset: MACHINE_REGION)
        mut fx1.store(len, addr: at, offset: MACHINE_REGION + 8)
        let next = mut fx1.b.iadd_imm_s(count, y: 1)
        mut fx1.store(next, addr: record, offset: MACHINE_REGIONS)
    })
} add_region
