item "nan::codegen::larger"
head "fn larger(value: u32, other: u32) -> u32"
accepted "ensures result >= value and result >= other"
item "nan::codegen::pushed_bytes"
head "fn pushed_bytes(saved: machinst::RegSet) -> u32"
accepted "ensures result <= 40"
item "nan::codegen::round_up"
