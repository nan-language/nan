item "platform::os::run_bounded"
text "pub fn run_bounded("
text "    program: Str,"
text "    args: Slice[text::String],"
text "    dir: Str,"
text "    poll_ms: i32,"
text "    within: fn(id: u32) -> bool fails platform::IoError,"
text "    alloc: mem::Alloc,"
text "    ) -> Option[platform::Output] fails platform::IoError"
interface "ah7js55xrcge5b3abt5yss2vxmfndd2gxoyno55ijfsxix3rjsrs4ou"
digest aarch64-linux "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest aarch64-windows "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest x86_64-linux "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest x86_64-windows "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
doc "ah7js55xrcge5b3abt5yss2vxmfndd2gxoyno55ijfsxix3rjsrs4ou" "Runs a program the system's search finds, given its arguments after its name, in the directory\n`dir`, to its end, its standard input the null device and its standard output and error\ncaptured; asks `within` with its process id, between waits of `poll_ms` milliseconds, whether it\nmay go on, and once that gives false or fails, kills it and gives none or the failure."
item "platform::os::run_output"
text "pub fn run_output("
text "    program: Str,"
text "    args: Slice[text::String],"
text "    take input: Option[mem::Bytes],"
text "    capture_errors: bool,"
text "    alloc: mem::Alloc,"
text "    ) -> platform::Output fails platform::IoError"
interface "ahxgy4spirtbojvbls4kozcpwtao4nhd7x77h6fdh7cdz5ycg2f7ev7"
digest aarch64-linux "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest aarch64-windows "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest x86_64-linux "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest x86_64-windows "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
doc "ahxgy4spirtbojvbls4kozcpwtao4nhd7x77h6fdh7cdz5ycg2f7ev7" "Runs a program the system's search finds, a name holding `/` being its path, given its arguments\nafter its name, to its end: its standard input `input`, or the null device for none; its\nstandard output captured; its standard error captured, or the null device unless\n`capture_errors`. On Linux it starts with no signal blocked and `SIGPIPE` at its default action."
item "platform::os::run_output_with"
text "pub fn run_output_with("
text "    program: Str,"
text "    args: Slice[text::String],"
text "    env: Slice[text::String],"
text "    take input: Option[mem::Bytes],"
text "    capture_errors: bool,"
text "    alloc: mem::Alloc,"
text "    ) -> platform::Output fails platform::IoError"
interface "agqqscrvxncx6yhljrltqjpsgcimzz263hipe4taq36esedslpis6lf"
digest aarch64-linux "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest aarch64-windows "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest x86_64-linux "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest x86_64-windows "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
doc "agqqscrvxncx6yhljrltqjpsgcimzz263hipe4taq36esedslpis6lf" "Runs a program as `run_output` does, with this process's environment with the variables that\nthe `NAME=VALUE` entries of `env` give set."
