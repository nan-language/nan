test taken_resources_settle_with_their_taker for Runner.take_resource {
    let world = testing::world()
    let shelf = shelves(world.alloc)
    defer take shelf.close()
    let shelved = shelf.mint(0)
    let held = try await noted(shelved, alloc: world.alloc)
    let minter = boards(take held, alloc: world.alloc)
    defer take minter.close()
    let runner = try Runner.served(minter.mint(0))
    let divisor: u64 = 0
    let outcome = try await Domain.run(fn() -> u64 fails RunnerError uses wait {
        let file = try await runner.take_resource(1)
        let quotient = 10 / divisor
        discard file
        return quotient
    }, exec: world.exec, alloc: world.alloc)
    let released = reach(shelved, body: tally_count)
    expect outcome.is_err() and released == Some(1)
} taken_resources_settle_with_their_taker

/// The count a board holding no resources reaches once `act` acts through a runner it serves.
fn board_reached(world: host::World, act: fn(runner: Runner) fails RunnerError) -> u64 fails RunnerError {
    let minter = boards(mem::Map[u64, Held].empty(world.alloc), alloc: world.alloc)
    defer take minter.close()
    let counter = minter.mint(0)
    try act(try Runner.served(minter.mint(0)))
    return reach(counter, body: board_count).value_or(0)
} board_reached

test runner_sends_reach_their_kind_with_their_port for Runner.send_to {
    let world = testing::world()
