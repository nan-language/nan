const TEXT_CORE_CRYPTO_TESTS: Str =
    \\//! Signatures against the test vectors of RFC 8032.
    \\
    \\test keys_and_signatures_match_rfc_8032 for SecretKey.sign {
    \\    expect signs(b"\\x9D\\x61\\xB1\\x9D\\xEF\\xFD\\x5A\\x60\\xBA\\x84\\x4A\\xF4\\x92\\xEC\\x2C\\xC4\\x44\\x49\\xC5\\x69\\x7B\\x32\\x69\\x19\\x70\\x3B\\xAC\\x03\\x1C\\xAE\\x7F\\x60", key: b"\\xD7\\x5A\\x98\\x01\\x82\\xB1\\x0A\\xB7\\xD5\\x4B\\xFE\\xD3\\xC9\\x64\\x07\\x3A\\x0E\\xE1\\x72\\xF3\\xDA\\xA6\\x23\\x25\\xAF\\x02\\x1A\\x68\\xF7\\x07\\x51\\x1A", message: b"", signature: b"\\xE5\\x56\\x43\\x00\\xC3\\x60\\xAC\\x72\\x90\\x86\\xE2\\xCC\\x80\\x6E\\x82\\x8A\\x84\\x87\\x7F\\x1E\\xB8\\xE5\\xD9\\x74\\xD8\\x73\\xE0\\x65\\x22\\x49\\x01\\x55\\x5F\\xB8\\x82\\x15\\x90\\xA3\\x3B\\xAC\\xC6\\x1E\\x39\\x70\\x1C\\xF9\\xB4\\x6B\\xD2\\x5B\\xF5\\xF0\\x59\\x5B\\xBE\\x24\\x65\\x51\\x41\\x43\\x8E\\x7A\\x10\\x0B")
    \\    expect signs(b"\\x4C\\xCD\\x08\\x9B\\x28\\xFF\\x96\\xDA\\x9D\\xB6\\xC3\\x46\\xEC\\x11\\x4E\\x0F\\x5B\\x8A\\x31\\x9F\\x35\\xAB\\xA6\\x24\\xDA\\x8C\\xF6\\xED\\x4F\\xB8\\xA6\\xFB", key: b"\\x3D\\x40\\x17\\xC3\\xE8\\x43\\x89\\x5A\\x92\\xB7\\x0A\\xA7\\x4D\\x1B\\x7E\\xBC\\x9C\\x98\\x2C\\xCF\\x2E\\xC4\\x96\\x8C\\xC0\\xCD\\x55\\xF1\\x2A\\xF4\\x66\\x0C", message: b"\\x72", signature: b"\\x92\\xA0\\x09\\xA9\\xF0\\xD4\\xCA\\xB8\\x72\\x0E\\x82\\x0B\\x5F\\x64\\x25\\x40\\xA2\\xB2\\x7B\\x54\\x16\\x50\\x3F\\x8F\\xB3\\x76\\x22\\x23\\xEB\\xDB\\x69\\xDA\\x08\\x5A\\xC1\\xE4\\x3E\\x15\\x99\\x6E\\x45\\x8F\\x36\\x13\\xD0\\xF1\\x1D\\x8C\\x38\\x7B\\x2E\\xAE\\xB4\\x30\\x2A\\xEE\\xB0\\x0D\\x29\\x16\\x12\\xBB\\x0C\\x00")
    \\    expect signs(b"\\xC5\\xAA\\x8D\\xF4\\x3F\\x9F\\x83\\x7B\\xED\\xB7\\x44\\x2F\\x31\\xDC\\xB7\\xB1\\x66\\xD3\\x85\\x35\\x07\\x6F\\x09\\x4B\\x85\\xCE\\x3A\\x2E\\x0B\\x44\\x58\\xF7", key: b"\\xFC\\x51\\xCD\\x8E\\x62\\x18\\xA1\\xA3\\x8D\\xA4\\x7E\\xD0\\x02\\x30\\xF0\\x58\\x08\\x16\\xED\\x13\\xBA\\x33\\x03\\xAC\\x5D\\xEB\\x91\\x15\\x48\\x90\\x80\\x25", message: b"\\xAF\\x82", signature: b"\\x62\\x91\\xD6\\x57\\xDE\\xEC\\x24\\x02\\x48\\x27\\xE6\\x9C\\x3A\\xBE\\x01\\xA3\\x0C\\xE5\\x48\\xA2\\x84\\x74\\x3A\\x44\\x5E\\x36\\x80\\xD7\\xDB\\x5A\\xC3\\xAC\\x18\\xFF\\x9B\\x53\\x8D\\x16\\xF2\\x90\\xAE\\x67\\xF7\\x60\\x98\\x4D\\xC6\\x59\\x4A\\x7C\\x15\\xE9\\x71\\x6E\\xD2\\x8D\\xC0\\x27\\xBE\\xCE\\xEA\\x1E\\xC4\\x0A")
    \\} keys_and_signatures_match_rfc_8032
    \\
    \\test seeds_give_their_rfc_8032_keys for SecretKey.of_seed {
    \\    let secret = SecretKey.of_seed(array32(b"\\x9D\\x61\\xB1\\x9D\\xEF\\xFD\\x5A\\x60\\xBA\\x84\\x4A\\xF4\\x92\\xEC\\x2C\\xC4\\x44\\x49\\xC5\\x69\\x7B\\x32\\x69\\x19\\x70\\x3B\\xAC\\x03\\x1C\\xAE\\x7F\\x60"))
    \\    expect secret.public_key().bytes == array32(b"\\xD7\\x5A\\x98\\x01\\x82\\xB1\\x0A\\xB7\\xD5\\x4B\\xFE\\xD3\\xC9\\x64\\x07\\x3A\\x0E\\xE1\\x72\\xF3\\xDA\\xA6\\x23\\x25\\xAF\\x02\\x1A\\x68\\xF7\\x07\\x51\\x1A")
    \\} seeds_give_their_rfc_8032_keys
    \\
    \\test public_keys_verify_their_secret_keys_signatures for SecretKey.public_key {
    \\    let secret = SecretKey.of_seed(array32(b"\\x4C\\xCD\\x08\\x9B\\x28\\xFF\\x96\\xDA\\x9D\\xB6\\xC3\\x46\\xEC\\x11\\x4E\\x0F\\x5B\\x8A\\x31\\x9F\\x35\\xAB\\xA6\\x24\\xDA\\x8C\\xF6\\xED\\x4F\\xB8\\xA6\\xFB"))
    \\    expect secret.public_key().verify(b"\\x72", signature: secret.sign(b"\\x72"))
    \\    expect not secret.public_key().verify(b"\\x73", signature: secret.sign(b"\\x72"))
    \\} public_keys_verify_their_secret_keys_signatures
    \\
    \\test verification_rejects_tampering_malleability_and_weak_keys for PublicKey.verify {
    \\    let key = PublicKey(bytes: array32(b"\\xD7\\x5A\\x98\\x01\\x82\\xB1\\x0A\\xB7\\xD5\\x4B\\xFE\\xD3\\xC9\\x64\\x07\\x3A\\x0E\\xE1\\x72\\xF3\\xDA\\xA6\\x23\\x25\\xAF\\x02\\x1A\\x68\\xF7\\x07\\x51\\x1A"))
    \\    let signature = Signature(bytes: array64(b"\\xE5\\x56\\x43\\x00\\xC3\\x60\\xAC\\x72\\x90\\x86\\xE2\\xCC\\x80\\x6E\\x82\\x8A\\x84\\x87\\x7F\\x1E\\xB8\\xE5\\xD9\\x74\\xD8\\x73\\xE0\\x65\\x22\\x49\\x01\\x55\\x5F\\xB8\\x82\\x15\\x90\\xA3\\x3B\\xAC\\xC6\\x1E\\x39\\x70\\x1C\\xF9\\xB4\\x6B\\xD2\\x5B\\xF5\\xF0\\x59\\x5B\\xBE\\x24\\x65\\x51\\x41\\x43\\x8E\\x7A\\x10\\x0B"))
    \\    expect key.verify(b"", signature)
    \\    expect not key.verify(b"x", signature)
    \\    var flipped = signature
    \\    flipped.bytes[0] = flipped.bytes[0] ^ 1
    \\    expect not key.verify(b"", signature: flipped)
    \\    expect not key.verify(b"", signature: Signature(bytes: array64(b"\\xE5\\x56\\x43\\x00\\xC3\\x60\\xAC\\x72\\x90\\x86\\xE2\\xCC\\x80\\x6E\\x82\\x8A\\x84\\x87\\x7F\\x1E\\xB8\\xE5\\xD9\\x74\\xD8\\x73\\xE0\\x65\\x22\\x49\\x01\\x55\\x4C\\x8C\\x78\\x72\\xAA\\x06\\x4E\\x04\\x9D\\xBB\\x30\\x13\\xFB\\xF2\\x93\\x80\\xD2\\x5B\\xF5\\xF0\\x59\\x5B\\xBE\\x24\\x65\\x51\\x41\\x43\\x8E\\x7A\\x10\\x1B")))
    \\    expect not PublicKey(bytes: array32(b"\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00")).verify(b"", signature)
    \\    expect decoded(array32(b"\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x80")).is_none()
    \\    expect decoded(array32(b"\\x05\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00")).is_some()
    \\    expect decoded(array32(b"\\xF2\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\xFF\\x7F")).is_none()
    \\} verification_rejects_tampering_malleability_and_weak_keys
    \\
    \\/// Whether the key of a seed is `key` and signs `message` as `signature`, which it verifies.
    \\fn signs(seed: Slice[u8], key: Slice[u8], message: Slice[u8], signature: Slice[u8]) -> bool {
    \\    let secret = SecretKey.of_seed(array32(seed))
    \\    let signed = secret.sign(message)
    \\    return secret.public_key().bytes == array32(key) and signed.bytes == array64(signature) and secret.public_key().verify(message, signature: signed)
    \\} signs
    \\
    \\fn array32(held: Slice[u8]) -> Array[u8, 32] {
    \\    var bytes = Array[u8, 32].filled(0)
    \\    mut bytes.view_mut().copy_from(held)
    \\    return bytes
    \\} array32
    \\
    \\fn array64(held: Slice[u8]) -> Array[u8, 64] {
    \\    var bytes = Array[u8, 64].filled(0)
    \\    mut bytes.view_mut().copy_from(held)
    \\    return bytes
    \\} array64
    \\

const TEXT_CORE_ENCODE: Str =
    \\//! Converting values to and from structured data: the encode interface, encoders and decoders.
    \\
    \\pub interface Encode {
    \\    fn encode[E: Encoder](self, mut e: E) limits terminates
    \\    fn decode[D: Decoder](mut d: D, alloc: mem::Alloc) -> Self fails DecodeError limits terminates
    \\} Encode
    \\
    \\pub interface Encoder {
    \\    fn write_bool(mut self, value: bool) limits terminates
    \\    fn write_unsigned(mut self, value: u64) limits terminates
    \\    fn write_signed(mut self, value: i64) limits terminates
    \\    fn write_float(mut self, value: f64) limits terminates
    \\    fn write_char(mut self, value: char) limits terminates
    \\    fn write_text(mut self, value: Str) limits terminates
    \\    fn write_bytes(mut self, value: Slice[u8]) limits terminates
    \\    fn begin_sequence(mut self, count: usize) limits terminates
    \\    fn begin_map(mut self, count: usize) limits terminates
    \\    fn begin_record(mut self, count: usize) limits terminates
    \\    fn write_key(mut self, key: Str) limits terminates
    \\    fn begin_variant(mut self, key: Str, payload: bool) limits terminates
    \\    fn end(mut self) limits terminates
    \\} Encoder
    \\
    \\pub interface Decoder {
    \\    fn read_bool(mut self) -> bool fails DecodeError limits terminates
    \\    fn read_unsigned(mut self) -> u64 fails DecodeError limits terminates
    \\    fn read_signed(mut self) -> i64 fails DecodeError limits terminates
    \\    fn read_float(mut self) -> f64 fails DecodeError limits terminates
    \\    fn read_char(mut self) -> char fails DecodeError limits terminates
    \\    fn begin_text(mut self) -> usize fails DecodeError limits terminates
    \\    fn begin_bytes(mut self) -> usize fails DecodeError limits terminates
    \\    fn read_chunk(mut self, mut out: SliceMut[u8]) fails DecodeError limits terminates
    \\    fn begin_sequence(mut self) fails DecodeError limits terminates
    \\    fn begin_map(mut self) fails DecodeError limits terminates
    \\    fn begin_record(mut self) fails DecodeError limits terminates
    \\    fn next_follows(mut self) -> bool fails DecodeError limits terminates
    \\    fn read_key(mut self, keys: Slice[Str]) -> Option[usize] fails DecodeError limits terminates
    \\    fn read_variant(mut self, keys: Slice[Str]) -> Option[usize] fails DecodeError limits terminates
    \\    fn payload_follows(mut self) -> bool fails DecodeError limits terminates
    \\    fn skip(mut self) fails DecodeError limits terminates
    \\    fn end(mut self) fails DecodeError limits terminates
    \\} Decoder
    \\
    \\pub open enum DecodeError derives Copy, Eq, Hash, Render {
    \\    Truncated
    \\    Malformed
    \\    Trailing
    \\    TooDeep
    \\    UnknownKey
    \\    DuplicateKey
    \\    MissingField
    \\    UnknownVariant
    \\    OutOfRange
    \\    InvalidText
    \\    Invalid
    \\    OutOfMemory
    \\    UnknownSchema
    \\} DecodeError
    \\

const TEXT_CORE_FLOATS: Str =
    \\//! The decimal text of floats, in integer arithmetic over their bit patterns.
    \\
    \\/// The limbs of the naturals reading a decimal: room for the greatest, below 2^2600, that a
    \\/// decimal of 769 significant digits gives.
    \\const READ_LIMBS: usize = 88
    \\
    \\/// The limbs of the naturals writing a float's digits: room for the greatest, below 2^1140, that
    \\/// scaling an `f64` gives.
    \\const WRITE_LIMBS: usize = 40
    \\
    \\/// The significant digits of a decimal that reading keeps: a halfway point between two `f64`
    \\/// values has at most 767, so the nonzero digits past them only count as one further digit 1.
    \\const KEPT: u64 = 768
    \\
    \\const F64_INFINITY: u64 = 0x7FF0_0000_0000_0000
    \\
    \\/// A natural number over a view of 32-bit limbs, least significant first: the first `count` in
    \\/// use, the highest in use not zero.
    \\view struct Natural {
    \\    limbs: SliceMut[u32]
    \\    count: usize
    \\} Natural
    \\
    \\/// Makes the number `value`.
    \\fn Natural.set(mut self, value: u64) {
    \\    self.limbs[0] = u32.truncate(value)
    \\    self.limbs[1] = u32.truncate(value >> 32)
    \\    self.count = 2
    \\    mut self.trim()
    \\} Natural.set
    \\
    \\/// Makes the number a copy of another.
    \\fn Natural.assign(mut self, other: Natural) {
    \\    for index in 0..<other.count {
    \\        self.limbs[index] = other.limbs[index]
    \\    }
    \\    self.count = other.count
    \\} Natural.assign
    \\
    \\/// Drops the zero limbs at the high end.
    \\fn Natural.trim(mut self) {
    \\    while self.count > 0 and self.limbs[self.count - 1] == 0 {
    \\        self.count -= 1
    \\    }
    \\} Natural.trim
    \\
    \\/// The number of bits up to the highest set one.
    \\fn Natural.bits(self) -> i64 {
    \\    if self.count == 0 {
    \\        return 0
    \\    }
    \\    return i64.fit(self.count - 1) * 32 + i64.widen(32 - self.limbs[self.count - 1].leading_zeros())
    \\} Natural.bits
    \\
    \\/// Multiplies the number by a nonzero `factor` and adds `addend`.
    \\fn Natural.mul_add(mut self, factor: u32, addend: u32) {
    \\    var carry = u64.widen(addend)
    \\    for index in 0..<self.count {
    \\        let product = u64.widen(self.limbs[index]) * u64.widen(factor) + carry
    \\        self.limbs[index] = u32.truncate(product)
    \\        carry = product >> 32
    \\    }
    \\    if carry > 0 {
    \\        self.limbs[self.count] = u32.truncate(carry)
    \\        self.count += 1
    \\    }
    \\} Natural.mul_add
    \\
    \\/// Multiplies the number by 5 to the power `power`.
    \\fn Natural.mul_pow5(mut self, power: u64) {
    \\    var rest = power
    \\    while rest >= 13 {
    \\        mut self.mul_add(1_220_703_125, addend: 0)
    \\        rest -= 13
    \\    }
    \\    var factor: u32 = 1
    \\    while rest > 0 {
    \\        factor *= 5
    \\        rest -= 1
    \\    }
    \\    mut self.mul_add(factor, addend: 0)
    \\} Natural.mul_pow5
    \\
    \\/// Multiplies the number by 10 to the power `power`.
    \\fn Natural.mul_pow10(mut self, power: u64) {
    \\    mut self.mul_pow5(power)
    \\    mut self.shl(usize.widen(power))
    \\} Natural.mul_pow10
    \\
    \\/// Multiplies the number by 2 to the power `power`.
    \\fn Natural.shl(mut self, power: usize) {
    \\    let count = self.count
    \\    if count == 0 {
    \\        return
    \\    }
    \\    let whole = power / 32
    \\    let part = u32.truncate(power % 32)
    \\    if part == 0 {
    \\        var index = count
    \\        while index > 0 {
    \\            index -= 1
    \\            self.limbs[index + whole] = self.limbs[index]
    \\        }
    \\        self.count = count + whole
    \\    } else {
    \\        self.limbs[count + whole] = self.limbs[count - 1] >> (32 - part)
    \\        var index = count - 1
    \\        while index > 0 {
    \\            self.limbs[index + whole] = (self.limbs[index] << part) | (self.limbs[index - 1] >> (32 - part))
    \\            index -= 1
    \\        }
    \\        self.limbs[whole] = self.limbs[0] << part
    \\        self.count = count + whole + 1
    \\    }
    \\    for index in 0..<whole {
    \\        self.limbs[index] = 0
    \\    }
    \\    mut self.trim()
    \\} Natural.shl
    \\
    \\fn Natural.compare(self, other: Natural) -> Ordering {
    \\    if self.count != other.count {
    \\        return self.count.cmp(other.count)
    \\    }
    \\    var index = self.count
    \\    while index > 0 {
    \\        index -= 1
    \\        if self.limbs[index] != other.limbs[index] {
    \\            return self.limbs[index].cmp(other.limbs[index])
    \\        }
    \\    }
    \\    return Ordering.Equal
    \\} Natural.compare
    \\
    \\fn Natural.add(mut self, other: Natural) {
    \\    var carry: u64 = 0
    \\    var index: usize = 0
    \\    while index < self.count or index < other.count {
    \\        var sum = carry
    \\        if index < self.count {
    \\            sum += u64.widen(self.limbs[index])
    \\        }
    \\        if index < other.count {
    \\            sum += u64.widen(other.limbs[index])
    \\        }
    \\        self.limbs[index] = u32.truncate(sum)
    \\        carry = sum >> 32
    \\        index += 1
    \\    }
    \\    if carry > 0 {
    \\        self.limbs[index] = u32.truncate(carry)
    \\        index += 1
    \\    }
    \\    self.count = index
    \\} Natural.add
    \\
    \\/// Subtracts a number no greater than this one.
    \\fn Natural.subtract(mut self, other: Natural) {
    \\    var borrow: u64 = 0
    \\    for index in 0..<self.count {
    \\        var subtrahend = borrow
    \\        if index < other.count {
    \\            subtrahend += u64.widen(other.limbs[index])
    \\        }
    \\        let minuend = u64.widen(self.limbs[index])
    \\        if minuend < subtrahend {
    \\            self.limbs[index] = u32.truncate(minuend + 0x1_0000_0000 - subtrahend)
    \\            borrow = 1
    \\        } else {
    \\            self.limbs[index] = u32.truncate(minuend - subtrahend)
    \\            borrow = 0
    \\        }
    \\    }
    \\    mut self.trim()
