//! Entry of the dialer and its retries.

pub closed enum ConnectError derives Render {
    GaveUp
    Net(sys::net::NetError) from
    Cancelled(task::Cancelled) from
} ConnectError

/// The local service's port.
const SERVICE_PORT: u16 = 4_200

fn main(take world: host::World) fails ConnectError uses wait {
    let conn = try await connect_with_backoff(world.net, clock: world.clock, port: SERVICE_PORT, attempts: 6)
    world.log.info("connected", value: SERVICE_PORT)
    take conn.abandon()
} main
