//! The timers of the clocks the runtime keeps itself, the seeded scheduler's virtual clock and a kernel's clock: one list of operations ordered by the nanosecond each is due, then by the order in which they were armed. A kernel's CPUs share the list behind the timer lock.

/// The nanoseconds of a millisecond.
const NS_PER_MS: u64 = 1_000_000

/// Arms a timer due at nanosecond `due`, after every timer due no later.
fn arm(mut lo: Lowering, mut fx: Fx, op: clif::Value, due: clif::Value) {
    mut fx.store(due, addr: op, offset: OPERATION_DUE)
    let order = next_order(mut lo, mut fx)
    mut fx.store(order, addr: op, offset: OPERATION_ORDER)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: op, offset: OPERATION_WITHDRAW)
    mut fx.store(zero, addr: op, offset: OPERATION_DONE)
    let state_address = mut lo.state(mut fx)
    let head = mut fx.load(PTR, addr: state_address, offset: STATE_TIMERS)
    let found = mut fx.repeat(fx.list2(head, b: zero).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 1
        let current = state[0]
        let previous = state[1]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: current, y: 0)
        let compared = mut fx1.choose(present, results: fx1.types1(clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let other = mut fx2.load(PTR, addr: current, offset: OPERATION_DUE)
            let no_later = mut fx2.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: other, y: due)
            return fx2.list1(no_later)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(no)
        })
        let earlier = compared[0]
        let next = mut fx1.choose(earlier, results: fx1.types2(PTR, b: PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let following = mut fx2.load(PTR, addr: current, offset: OPERATION_NEXT)
            return fx2.list2(following, b: current)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list2(current, b: previous)
        })
        return Pass(again: earlier, next: take next)
    })
    let after = found[0]
    let before = found[1]
    mut fx.store(after, addr: op, offset: OPERATION_NEXT)
    mut fx.store(before, addr: op, offset: OPERATION_PREVIOUS)
    let has_after = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: after, y: 0)
    mut fx.if_true(has_after, then: fn(mut fx1: Fx) {
        mut fx1.store(op, addr: after, offset: OPERATION_PREVIOUS)
    })
    let at_head = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: before, y: 0)
    discard mut fx.choose(at_head, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(op, addr: state_address, offset: STATE_TIMERS)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(op, addr: before, offset: OPERATION_NEXT)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} arm

/// Takes a timer out of the timers.
fn disarm(mut lo: Lowering, mut fx: Fx, op: clif::Value) {
    let state_address = mut lo.state(mut fx)
    let next = mut fx.load(PTR, addr: op, offset: OPERATION_NEXT)
    let previous = mut fx.load(PTR, addr: op, offset: OPERATION_PREVIOUS)
    let at_head = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: previous, y: 0)
    discard mut fx.choose(at_head, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(next, addr: state_address, offset: STATE_TIMERS)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(next, addr: previous, offset: OPERATION_NEXT)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    let has_next = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: next, y: 0)
    mut fx.if_true(has_next, then: fn(mut fx1: Fx) {
        mut fx1.store(previous, addr: next, offset: OPERATION_PREVIOUS)
    })
} disarm

/// The nanosecond `delay` after `now`, the latest one when that is past it.
fn due_after(mut fx: Fx, now: clif::Value, delay: clif::Value) -> clif::Value {
    let sum = mut fx.b.uadd_overflow(now, y: delay)
    let latest = mut fx.int(PTR, value: -1)
    return mut fx.b.select(sum.flag, x: latest, y: sum.value)
} due_after

/// The delay from `now` until `ns` nanoseconds have passed and the time elapsed since `origin` is
/// a multiple of `resolution`, zero standing for one, saturating.
fn on_grid(mut fx: Fx, now: clif::Value, origin: clif::Value, resolution: clif::Value, ns: clif::Value) -> clif::Value {
    let one = mut fx.ptr(1)
    let step = mut fx.b.umax(resolution, y: one)
    let elapsed = mut fx.b.isub(now, y: origin)
    let end = due_after(mut fx, now: elapsed, delay: ns)
    let rest = mut fx.b.urem(end, y: step)
    let short = mut fx.b.isub(step, y: rest)
    let rounded = due_after(mut fx, now: end, delay: short)
    let exact = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: rest, y: 0)
    let ended = mut fx.b.select(exact, x: end, y: rounded)
    return mut fx.b.isub(ended, y: elapsed)
} on_grid

/// The nanoseconds of `ms` milliseconds, the most a word holds when they are more.
fn from_ms(mut fx: Fx, ms: clif::Value) -> clif::Value {
    let per_ms = mut fx.ptr(NS_PER_MS)
    let low = mut fx.b.imul(ms, y: per_ms)
    let high = mut fx.b.umulhi(ms, y: per_ms)
    let overflow = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: high, y: 0)
    let latest = mut fx.int(PTR, value: -1)
    return mut fx.b.select(overflow, x: latest, y: low)
} from_ms
