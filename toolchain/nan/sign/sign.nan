//! The text forms of public keys and signatures, the checksummed base32 of their bytes, and the message a seal signs.

/// The text form of a public key: the checksummed base32 of its 32 bytes, 54 characters.
pkg fn key_form(key: core::crypto::PublicKey, alloc: mem::Alloc) -> text::String {
    return hashing::checksummed_base32(key.bytes.view(), alloc)
} key_form

/// The public key a text form writes.
pkg fn read_key(written: Str, alloc: mem::Alloc) -> Option[core::crypto::PublicKey] {
    let Some(read) = hashing::read_checksummed_base32(written, length: 32, alloc) else {
        return None
    }
    var bytes = Array[u8, 32].filled(0)
    mut bytes.view_mut().copy_from(read.view())
    return Some(core::crypto::PublicKey(bytes: bytes))
} read_key

/// The text form of a signature: the checksummed base32 of its 64 bytes, 105 characters.
pkg fn signature_form(signature: core::crypto::Signature, alloc: mem::Alloc) -> text::String {
    return hashing::checksummed_base32(signature.bytes.view(), alloc)
} signature_form

/// The signature a text form writes.
pkg fn read_signature(written: Str, alloc: mem::Alloc) -> Option[core::crypto::Signature] {
    let Some(read) = hashing::read_checksummed_base32(written, length: 64, alloc) else {
        return None
    }
    var bytes = Array[u8, 64].filled(0)
    mut bytes.view_mut().copy_from(read.view())
    return Some(core::crypto::Signature(bytes: bytes))
} read_signature

/// The bytes a principal signs to seal an item: `nan seal 1`, the principal, the item's canonical
/// path and the full forms of its sealed item hash and closure hash, each followed by LF.
pkg fn seal_message(principal: Str, path: Str, sealed: hashing::HashValue, closure: hashing::HashValue, alloc: mem::Alloc) -> text::String {
    var written = text::String.of("nan seal 1\n", alloc)
    mut written.append(principal)
    mut written.push('\n')
    mut written.append(path)
    mut written.push('\n')
    mut written.append(sealed.full(alloc).as_str())
    mut written.push('\n')
    mut written.append(closure.full(alloc).as_str())
    mut written.push('\n')
    return written
} seal_message
