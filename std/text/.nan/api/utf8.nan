item "text::utf8::is_valid"
text "pub fn is_valid(bytes: Slice[u8]) -> bool limits pure, notrap, terminates"
text "    ensures result == (valid_prefix(bytes) == bytes.len())"
text "    example not is_valid(b\"\\xC3\")"
