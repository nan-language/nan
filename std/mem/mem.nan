    example Map[u8, u8].empty(testing::world().alloc).get_by(fn(key: u8) => key.cmp(1)) == None

pub proj fn Map.get_by_mut(mut self, order: fn(key: K) -> core::Ordering) -> Option[V]

pub fn Set.contains_by(self, order: fn(value: T) -> core::Ordering) -> bool
    example not Set[u8].empty(testing::world().alloc).contains_by(fn(value: u8) => value.cmp(1))

test contents_mut_writes_the_contents for Box.contents_mut {
    let world = testing::world()
    var boxed = Heap.of(world.alloc).boxed(Bytes.empty(world.alloc))
    var contents = mut boxed.contents_mut()
    mut contents.push(1)
    expect boxed.contents().len() == 1
} contents_mut_writes_the_contents

test split_limits_draws for Alloc.split {
    let budget = testing::world().alloc.split(65_536)
    var bytes = Bytes.empty(budget.alloc())
    let grown = attempt mut bytes.try_reserve(65_537)
    take budget.close()
    expect grown.is_err()
} split_limits_draws

test budget_alloc_draws_through_the_budget for Budget.alloc {
    let budget = testing::world().alloc.split(65_536)
    var bytes = Bytes.empty(budget.alloc())
    mut bytes.push(1)
    let charge = budget.charged()
    take budget.close()
    expect charge == 65_536
} budget_alloc_draws_through_the_budget

test limit_is_the_split_limit for Budget.limit {
    let budget = testing::world().alloc.split(65_536)
    let limit = budget.limit()
    take budget.close()
    expect limit == 65_536
} limit_is_the_split_limit

test charged_starts_at_zero for Budget.charged {
    let budget = testing::world().alloc.split(65_536)
    let charge = budget.charged()
    take budget.close()
    expect charge == 0
} charged_starts_at_zero

test close_ends_draws for Budget.close {
    let budget = testing::world().alloc.split(65_536)
    var bytes = Bytes.empty(budget.alloc())
    take budget.close()
    let pushed = attempt mut bytes.try_push(1)
    expect pushed.is_err()
} close_ends_draws

test heap_alloc_draws_through_the_heap for Heap.alloc {
    let budget = testing::world().alloc.split(65_536)
    var bytes = Bytes.empty(Heap.of(budget.alloc()).alloc())
    mut bytes.push(1)
    let charge = budget.charged()
    take budget.close()
    expect charge == 65_536
} heap_alloc_draws_through_the_heap

test try_boxed_fails_when_exhausted for Heap.try_boxed {
    let budget = testing::world().alloc.split(65_536)
    let heap = Heap.of(budget.alloc())
    take budget.close()
    let boxed = attempt heap.try_boxed(7u8)
    expect boxed.is_err()
} try_boxed_fails_when_exhausted

test arena_len_counts_entries for Arena.len {
    let numbers = Arena[u8].empty(testing::world().alloc)
    discard numbers.push(4)
    let count = numbers.len()
    expect count == 1
} arena_len_counts_entries

test arena_push_returns_ids_in_order for Arena.push {
    let numbers = Arena[u8].empty(testing::world().alloc)
    let earlier = numbers.push(4)
    let later = numbers.push(5)
    expect earlier.index() == 0
    expect later.index() == 1
} arena_push_returns_ids_in_order

test arena_try_push_stores_the_value for Arena.try_push {
    let numbers = Arena[u8].empty(testing::world().alloc)
    let id = try numbers.try_push(4)
    let stored = numbers[id]
    expect stored == 4
} arena_try_push_stores_the_value

test arena_at_reaches_the_entry for Arena.at {
    let numbers = Arena[u8].empty(testing::world().alloc)
    let id = numbers.push(4)
    let stored = numbers.at(id)
    expect stored == 4
} arena_at_reaches_the_entry

test arena_at_mut_writes_the_entry for Arena.at_mut {
    let world = testing::world()
    var buffers = Arena[Bytes].empty(world.alloc)
    let id = buffers.push(Bytes.empty(world.alloc))
    var buffer = mut buffers.at_mut(id)
    mut buffer.push(9)
    let count = buffers[id].len()
    expect count == 1
} arena_at_mut_writes_the_entry

test arena_get_reaches_pushed_entries for Arena.get {
    let numbers = Arena[u8].empty(testing::world().alloc)
    let id = numbers.push(4)
    let found = numbers.get(id)
    expect found == Some(4)
} arena_get_reaches_pushed_entries

test arena_cursor_yields_in_push_order for Arena.cursor {
    let numbers = Arena[u8].empty(testing::world().alloc)
    discard numbers.push(1)
    discard numbers.push(2)
    var digits: u32 = 0
    for value in numbers {
        digits = digits * 10 + u32.widen(value)
    }
    expect digits == 12
} arena_cursor_yields_in_push_order

test pool_len_counts_entries for Pool.len {
