//! Capability kinds: minters, reaches and derivations, the operations of crossing kinds through the handles holding their capabilities, and the handles of the capabilities a space's runtime holds for its kernel's. A minter is the holding of its state's record, which is a shared value's whose count holds one for the minter and one for each reach or derivation in flight, and which the outermost domain reaches. An entry of a kind holds that record, its own record, which the capability table keeps given its address and size, and the kind's method table for `sys::Crossing`; a reach pins the state under the table lock, which copies the record out, and calls its body outside it.

/// The fewest bytes of the slot a pin copies a record into: the two words a record its entry's
/// state words hold fills.
const KINDS_RECORD_SLOT: u64 = 16

fn kinds_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) -> bool {
    match supply.path.as_str() {
        "sys::Minter.of" => kinds_of(mut lo, mut fx, supply)
        "sys::Minter.mint" => {
            let minter = holdings_payload(mut fx, address: supply.param(0).address_value())
            let given = kinds_record_at(mut lo, mut fx, record: supply.param(1), record_ty: supply.type_arg(lo, index: 2))
            let table = kinds_crossing_table(mut lo, mut fx, kind: supply.type_arg(lo, index: 0))
            var args = fx.list3(minter, b: given.address, c: given.size)
            mut args.push(table)
            let minted = mut lo.call_routine(mut fx, routine: Routine.KindMint, args: args.view())
            expect minted.len() == 1
            let Some(sret) = supply.sret else {
                expect false
                return true
            }
            mut fx.store(minted[0], addr: sret, offset: 0)
            supply.done(mut lo, mut fx)
        }
        "sys::Minter.revoke" => {
            let minter = holdings_payload(mut fx, address: supply.param(0).address_value())
            let handle = mut fx.load(PTR, addr: supply.param(1).address_value(), offset: 0)
            discard mut lo.call_routine(mut fx, routine: Routine.KindRevoke, args: fx.list2(handle, b: minter).view())
            supply.done(mut lo, mut fx)
        }
        "sys::Minter.close" => {
            let holding = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
            let minter = holdings_payload(mut fx, address: supply.param(0).address_value())
            discard mut lo.call_routine(mut fx, routine: Routine.KindClose, args: fx.list1(minter).view())
            discard mut lo.call_routine(mut fx, routine: Routine.Unhold, args: fx.list1(holding).view())
            kinds_unpin(mut lo, mut fx, state_ty: supply.type_arg(lo, index: 1), minter)
            supply.done(mut lo, mut fx)
        }
        "sys::reach" => kinds_reach(mut lo, mut fx, supply)
        "sys::derive" => kinds_derive(mut lo, mut fx, supply)
        "sys::Handle.crosses" => {
            let word = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: HANDLE_HANDLE)
            let crossing = tables_crossing(mut lo, mut fx, handle: word)
            let crosses_table = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: crossing.table, y: 0)
            let crosses = mut fx.b.band(crossing.live, y: crosses_table)
            supply.ret(mut lo, mut fx, held: Held.Scalar(crosses))
        }
        "sys::Handle.invoke" or "sys::Handle.call" => kinds_crossed_operation(mut lo, mut fx, supply)
        "nanos::crossing_handle" => kinds_crossing_handle(mut lo, mut fx, supply)
        "nanos::handle_word" => {
            let word = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: HANDLE_HANDLE)
            supply.ret(mut lo, mut fx, held: Held.Scalar(word))
        }
        "nanos::handle_hash" => {
            let hash = mut fx.offset(supply.param(0).address_value(), offset: HANDLE_HASH)
            supply.ret(mut lo, mut fx, held: Held.Address(hash))
        }
        else => return false
    }
    return true
} kinds_lower

/// The method table of a kind for `sys::Crossing`, zero for a kind that does not cross.
fn kinds_crossing_table(mut lo: Lowering, mut fx: Fx, kind: ty::Ty) -> clif::Value {
    let crossing = served_interface(lo, name: "Crossing")
    if not lo.ck.implements(kind, interface_item: crossing) {
        return mut fx.ptr(0)
    }
    let DynTable(id: table_id, methods: _) = mut lo.dyn_table(kind, interface_item: crossing, args: ty::Args.none())
    let table_global = mut lo.data_ref(mut fx, id: table_id)
    return mut fx.b.symbol_value(PTR, global_value: table_global)
} kinds_crossing_table

/// `handle.invoke(operation, args, alloc)` or `call`: the method of its name of the kind through
/// which the capability `handle` holds crosses, its failure becoming the operation's;
/// `Revoked.Stale` for a stale capability and `Refused` for one that does not cross.
fn kinds_crossed_operation(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let word = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: HANDLE_HANDLE)
    let crossing = tables_crossing(mut lo, mut fx, handle: word)
    let stale = mut fx.b.bxor_imm_s(crossing.live, y: 1)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    let refused = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: crossing.table, y: 0)
    mut fx.if_true(refused, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Refused")
    })
    var args = mem::List[Held].empty(lo.alloc)
    for position in 1..<supply.params.len() {
        mut args.push(supply.params[position])
    }
    let called = served_call(mut lo, mut fx, interface_name: "Crossing", method: supply.member(), kind: ServingKind(service: crossing.service, table: crossing.table), args: args.view())
    supply.forward_failure(mut lo, mut fx, called)
    supply.ret(mut lo, mut fx, held: called.result)
} kinds_crossed_operation

/// `nanos::crossing_handle(service, hash)`: a handle holding a capability of the crossing kind
/// whose handle hash is `hash`, served by the kind `service` through `sys::Crossing`, its entry
/// deriving from `service`'s; `Revoked.Stale` when `service` is stale.
fn kinds_crossing_handle(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let service_ty = supply.type_arg(lo, index: 0)
    let service = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
    let crossing = served_interface(lo, name: "Crossing")
    let DynTable(id: table_id, methods: _) = mut lo.dyn_table(service_ty, interface_item: crossing, args: ty::Args.none())
    let table_global = mut lo.data_ref(mut fx, id: table_id)
    let table = mut fx.b.symbol_value(PTR, global_value: table_global)
    let derived = tables_served(mut lo, mut fx, kind: TABLES_KIND_CROSSED, service, table)
    let stale = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: derived, y: -1)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    mut fx.store(derived, addr: sret, offset: HANDLE_HANDLE)
    let at = mut fx.offset(sret, offset: HANDLE_HASH)
    mut lo.copy(mut fx, dst: at, src: supply.param(1).address_value(), size: 33, align: 1)
    supply.done(mut lo, mut fx)
} kinds_crossing_handle

/// `sys::Minter.of(state, alloc)`: the state moves into a shared record drawn through `alloc`,
/// which passes to the outermost domain, and the minter holds it.
fn kinds_of(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let state_ty = supply.type_arg(lo, index: 1)
    let cell = mut fx.load(PTR, addr: supply.param(1).address_value(), offset: 0)
    let record = new_shared(mut lo, mut fx, cell, value_ty: state_ty, value: supply.param(0))
    let failed = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
    mut fx.if_true(failed, then: fn[mut lo](mut fx1: Fx) {
        supply.exhausted(mut lo, fx: mut fx1, taken: mem::List[Taken].empty(fx1.alloc).view())
    })
    let state_address = mut lo.state(mut fx)
    let process = mut fx.load(PTR, addr: state_address, offset: STATE_PROCESS)
    let held = mut fx.slot(8, align: 8)
    mut fx.store(record, addr: held, offset: 0)
    transfer_shared(mut lo, mut fx, value_ty: state_ty, address: held, target: process)
    let kind = mut fx.ptr(u64.fit(HOLDINGS_KIND_MINTER))
    let holdings = mut lo.call_routine(mut fx, routine: Routine.Hold, args: fx.list2(kind, b: record).view())
    expect holdings.len() == 1
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    mut fx.store(holdings[0], addr: sret, offset: 0)
    supply.done(mut lo, mut fx)
} kinds_of

/// `sys::reach(c, body)`: `None` for a stale handle, else `Some` of what `body` returns given
/// the pinned state and the entry's record, its failure becoming the operation's.
fn kinds_reach(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let option = supply.abi.result
    let state_ty = supply.type_arg(lo, index: 1)
    let handle = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
    let record = kinds_pin_slot(mut lo, mut fx, record_ty: supply.type_arg(lo, index: 2))
    let pinned = mut lo.call_routine(mut fx, routine: Routine.KindPin, args: fx.list2(handle, b: record).view())
    expect pinned.len() == 1
    let minter = pinned[0]
    let live = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: minter, y: 0)
    mut fx.if_true(live, then: fn[mut lo](mut fx1: Fx) {
        let called = kinds_call_pinned(mut lo, fx: mut fx1, supply, state_ty, minter, record)
        kinds_unpin(mut lo, fx: mut fx1, state_ty, minter)
        supply.forward_failure(mut lo, fx: mut fx1, called)
        let some = mut lo.variant_value(mut fx1, ty: option, variant: "Some", payload_values: Array[Held, 1].filled(called.result).view(), wrapped: None)
        supply.ret(mut lo, fx: mut fx1, held: some)
    })
    let none = mut lo.none_value(mut fx, option)
    supply.ret(mut lo, mut fx, held: none)
} kinds_reach

/// `sys::derive(c, narrow)`: an entry deriving from `c`'s, recording what `narrow` returns given
/// the pinned state and `c`'s record; `Revoked.Stale` when `c` is stale before or after.
fn kinds_derive(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let state_ty = supply.type_arg(lo, index: 1)
    let record_ty = supply.type_arg(lo, index: 2)
    let handle = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
    let record = kinds_pin_slot(mut lo, mut fx, record_ty)
    let pinned = mut lo.call_routine(mut fx, routine: Routine.KindPin, args: fx.list2(handle, b: record).view())
    expect pinned.len() == 1
    let minter = pinned[0]
    let stale = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: minter, y: 0)
    mut fx.if_true(stale, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    let called = kinds_call_pinned(mut lo, mut fx, supply, state_ty, minter, record)
    kinds_unpin(mut lo, mut fx, state_ty, minter)
    let narrowed = kinds_record_at(mut lo, mut fx, record: called.result, record_ty)
    let derived = mut lo.call_routine(mut fx, routine: Routine.KindDerive, args: fx.list3(handle, b: narrowed.address, c: narrowed.size).view())
    expect derived.len() == 1
    let refused = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: derived[0], y: -1)
    mut fx.if_true(refused, then: fn[mut lo](mut fx1: Fx) {
        fail_with(mut lo, fx: mut fx1, supply, variant: "Revoked")
    })
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    mut fx.store(derived[0], addr: sret, offset: 0)
    supply.done(mut lo, mut fx)
} kinds_derive

/// Calls the operation's function argument with the state of a pinned minter and the record the
/// pin wrote.
fn kinds_call_pinned(mut lo: Lowering, mut fx: Fx, supply: Supply, state_ty: ty::Ty, minter: clif::Value, record: clif::Value) -> Called {
    let at = contents_at(mut lo, value: state_ty)
    let state = mut fx.offset(minter, offset: at)
    let body_ty = fn_param(lo, supply, index: 1)
    var args = Array[Held, 2].filled(Held.Address(state))
    args[1] = Held.Address(record)
    return mut lo.call_value(mut fx, fn_ty: body_ty, function: supply.param(1).address_value(), args: args.view())
} kinds_call_pinned

/// Ends one holder of a minter's state: the last releases the state and frees its record.
fn kinds_unpin(mut lo: Lowering, mut fx: Fx, state_ty: ty::Ty, minter: clif::Value) {
    let held = mut fx.slot(8, align: 8)
    mut fx.store(minter, addr: held, offset: 0)
    release_shared(mut lo, mut fx, value_ty: state_ty, address: held)
} kinds_unpin

/// The address of a slot holding a record, and the record's size.
struct RecordAt derives Copy {
    address: clif::Value
    size: clif::Value
} RecordAt

/// The address of a slot holding a record held one way or another, and its size.
fn kinds_record_at(mut lo: Lowering, mut fx: Fx, record: Held, record_ty: ty::Ty) -> RecordAt {
    let laid = mut lo.layout_of(record_ty)
    let slot = mut fx.slot(laid.contents().size, align: laid.contents().align)
    mut lo.store_held(mut fx, address: slot, held: record, ty: record_ty)
    let size = mut fx.ptr(laid.contents().size)
    return RecordAt(address: slot, size: size)
} kinds_record_at

/// A slot a pin copies a record of a type into.
fn kinds_pin_slot(mut lo: Lowering, mut fx: Fx, record_ty: ty::Ty) -> clif::Value {
    let laid = mut lo.layout_of(record_ty)
    var size = laid.contents().size
    if size < KINDS_RECORD_SLOT {
        size = KINDS_RECORD_SLOT
    }
    var align = laid.contents().align
    if align < 8 {
        align = 8
    }
    return mut fx.slot(size, align: align)
} kinds_pin_slot
