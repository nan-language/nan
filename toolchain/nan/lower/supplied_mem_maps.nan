//! Maps and sets over vectors of their entries: a map's `mem::KeyValue` entries sorted by key, a hash map's in insertion order found through its hash index, a set's values sorted; their entries and cursors. A viewing cursor is the address of its next entry and the count left.

/// How a container finds a key.
enum Order derives Copy, Eq {
    /// By binary search through `cmp`.
    Sorted
    /// Through its hash index, comparing by `eq`.
    Hashed
} Order

/// Where a hash map holds its seed and its index's table record, after its vector.
const MAPS_SEED: u64 = 32

const MAPS_INDEX: u64 = 40

/// The values of a map's entries: their offset in an entry.
struct ValuePart derives Copy {
    at: u64
} ValuePart

/// The entries of a container: their type, the type of the key each holds and where.
struct Entries derives Copy {
    entry: ty::Ty
    key: ty::Ty
    key_at: u64
    value: Option[ValuePart]
    shape: Element
} Entries

/// Where a key lies among a container's entries, with its hash fragment for a hash map.
struct KeyLookup derives Copy {
    index: clif::Value
    found: clif::Value
    fragment: Option[clif::Value]
} KeyLookup

fn Entries.of_map(mut lo: Lowering, key: ty::Ty, value: ty::Ty) -> Entries {
    var parts = mem::List[ty::Ty].empty(lo.alloc)
    mut parts.push(key)
    mut parts.push(value)
    let entry = lo.std_ty("mem", type_name: "KeyValue", args: take parts)
    let key_field = mut lo.layouts.field(lo.ck, ty: entry, variant: None, label: "key")
    let value_field = mut lo.layouts.field(lo.ck, ty: entry, variant: None, label: "value")
    let shape = Element.of(mut lo, ty: entry)
    return Entries(entry: entry, key: key, key_at: key_field.offset, value: Some(ValuePart(at: value_field.offset)), shape: shape)
} Entries.of_map

fn Entries.of_set(mut lo: Lowering, value: ty::Ty) -> Entries {
    let shape = Element.of(mut lo, ty: value)
    return Entries(entry: value, key: value, key_at: 0, value: None, shape: shape)
} Entries.of_set

fn Entries.map_value(self) -> ValuePart {
    let Some(part) = self.value else {
        expect false
        return ValuePart(at: 0)
    }
    return part
} Entries.map_value

/// Where a key held at an address lies among a container's entries: the index of the entry
/// holding it and 1, or the index where it would go and 0, with the key's hash fragment for a
/// hash map.
fn maps_find(mut lo: Lowering, mut fx: Fx, entries: Entries, order: Order, address: clif::Value, key: clif::Value) -> KeyLookup {
    let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
    let len = mut fx.load(PTR, addr: address, offset: VECTOR_LEN)
    match order {
        Order.Hashed => {
            let seed = mut fx.load(clif::Type.Int64, addr: address, offset: MAPS_SEED)
            let fragment = index_fragment(mut lo, mut fx, key: entries.key, at: key, seed)
            let record = mut fx.offset(address, offset: MAPS_INDEX)
            let looked = index_find(mut lo, mut fx, record, fragment, matches: fn(mut lo1: Lowering, mut fx1: Fx, index: clif::Value) -> clif::Value {
                let entry = entries.shape.at(mut fx1, data, index)
                let stored = mut fx1.offset(entry, offset: entries.key_at)
                return mut lo1.equal(mut fx1, ty: entries.key, left_at: stored, right_at: key)
            })
            let index = mut fx.b.select(looked.found, x: looked.index, y: len)
            return KeyLookup(index: index, found: looked.found, fragment: Some(fragment))
        }
        Order.Sorted => {
            let searched = search(mut lo, mut fx, entries, data, len, compare: fn(mut lo1: Lowering, mut fx1: Fx, stored: clif::Value) -> clif::Value {
                return mut lo1.order(mut fx1, ty: entries.key, left_at: stored, right_at: key)
            })
            return KeyLookup(index: searched.index, found: searched.found, fragment: None)
        }
    }
} maps_find

/// The binary search its section states: `compare` gives the order of the key held at an
/// address against the sought one, as an ordering index. Gives the index found or where it
/// would go, and whether it was found.
fn search(mut lo: Lowering, mut fx: Fx, entries: Entries, data: clif::Value, len: clif::Value, compare: fn(mut lo: Lowering, mut fx: Fx, stored: clif::Value) -> clif::Value) -> Lookup {
    let zero = mut fx.ptr(0)
    let no = mut fx.int(clif::Type.Int8, value: 0)
    let initial = fx.list3(zero, b: len, c: no)
    let state = mut fx.repeat(initial.view(), body: fn[mut lo](mut fx1: Fx, current: Slice[clif::Value]) -> Pass {
        expect current.len() == 3
        let low = current[0]
        let high = current[1]
        let found = current[2]
        let open = mut fx1.b.icmp(clif::IntCC.UnsignedLessThan, x: low, y: high)
        let results = fx1.types4(PTR, b: PTR, c: clif::Type.Int8, d: clif::Type.Int8)
        let next = mut fx1.choose(open, results: results.view(), then: fn[mut lo](mut fx2: Fx) -> mem::List[clif::Value] {
            let sum = mut fx2.b.iadd(low, y: high)
            let middle = mut fx2.b.ushr_imm_s(sum, y: 1)
            let at = entries.shape.at(mut fx2, data, index: middle)
            let stored = mut fx2.offset(at, offset: entries.key_at)
            let ordering = compare(mut lo, fx: mut fx2, stored)
            let less = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: ordering, y: 0)
            let equal = mut fx2.b.icmp_imm_s(clif::IntCC.Equal, x: ordering, y: 1)
            let above = mut fx2.b.iadd_imm_s(middle, y: 1)
            let raised = mut fx2.b.select(less, x: above, y: low)
            let next_low = mut fx2.b.select(equal, x: middle, y: raised)
            let next_high = mut fx2.b.select(less, x: high, y: middle)
            let again = mut fx2.b.bxor_imm_s(equal, y: 1)
            return fx2.list4(next_low, b: next_high, c: equal, d: again)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let stop = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list4(low, b: high, c: found, d: stop)
        })
        expect next.len() == 4
        return Pass(again: next[3], next: fx1.list3(next[0], b: next[1], c: next[2]))
    })
    expect state.len() == 3
    return Lookup(index: state[0], found: state[2])
} search

/// A member of `mem::Map[K, V]` or `mem::HashMap[K, V]`.
fn maps_map(mut lo: Lowering, mut fx: Fx, supply: Supply, order: Order)
    waive length "one arm per member of the map types, as they are dispatched"
{
    let key = supply.type_arg(lo, index: 0)
    let value = supply.type_arg(lo, index: 1)
    let entries = Entries.of_map(mut lo, key, value)
    let value_at = entries.map_value().at
    match supply.member() {
        "empty" => {
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            if supply.params.len() == 0 {
                expect false
                return
            }
            let alloc_at = supply.params[supply.params.len() - 1].address_value()
            let alloc = mut fx.load(PTR, addr: alloc_at, offset: 0)
            vector_empty(mut fx, address: sret, alloc, element: entries.shape)
            if order == Order.Hashed {
                let seed = supply.param(0).scalar_value()
                mut fx.store(seed, addr: sret, offset: MAPS_SEED)
                let zero = mut fx.ptr(0)
                mut fx.store(zero, addr: sret, offset: MAPS_INDEX)
                mut fx.store(zero, addr: sret, offset: MAPS_INDEX + 8)
            }
            supply.done(mut lo, mut fx)
        }
        "len" => {
            let len = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: VECTOR_LEN)
            supply.ret(mut lo, mut fx, held: Held.Scalar(len))
        }
        "insert" or "try_insert" => {
            let address = supply.param(0).address_value()
            let key_held = supply.param(1)
            let value_held = supply.param(2)
            let sought = held_address(mut lo, mut fx, ty: key, held: key_held)
            let place = maps_find(mut lo, mut fx, entries, order, address, key: sought)
            let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
            let len = mut fx.load(PTR, addr: address, offset: VECTOR_LEN)
            let option = supply.abi.result
            let laid = mut lo.layout_of(option)
            let result = match supply.sret {
                Some(sret) => sret
                None => mut fx.slot(laid.contents().size, align: laid.contents().align)
            }
            let no_results = mem::List[clif::Type].empty(fx.alloc)
            discard mut fx.choose_in(mut lo, condition: place.found, results: no_results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
                let at = entries.shape.at(mut fx1, data, index: place.index)
                let old = mut fx1.offset(at, offset: value_at)
                let one = mut fx1.int(clif::Type.Int8, value: 1)
                let held = mut lo1.held_at(mut fx1, ty: value, address: old)
                mut lo1.write_option(mut fx1, option, address: result, presence: one, value: held)
                mut lo1.store_held(mut fx1, address: old, held: value_held, ty: value)
                mut lo1.release(mut fx1, ty: key, address: sought)
                return mem::List[clif::Value].empty(fx1.alloc)
            }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
                let needed = mut fx1.b.iadd_imm_s(len, y: 1)
                let room = vector_reserve(mut lo1, fx: mut fx1, address, needed, element: entries.shape)
                let failed = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: room, y: 0)
                var taken = Array[Taken, 2].filled(Taken(held: key_held, ty: key))
                taken[1] = Taken(held: value_held, ty: value)
                mut fx1.if_true(failed, then: fn[mut lo1](mut fx2: Fx) {
                    supply.exhausted(mut lo1, fx: mut fx2, taken: taken.view())
                })
                match place.fragment {
                    Some(fragment) => {
                        let record = mut fx1.offset(address, offset: MAPS_INDEX)
                        let alloc = mut fx1.load(PTR, addr: address, offset: VECTOR_ALLOC)
                        let indexed = index_reserve(mut lo1, fx: mut fx1, record, alloc, needed)
                        let unindexed = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: indexed, y: 0)
                        mut fx1.if_true(unindexed, then: fn[mut lo1](mut fx2: Fx) {
                            supply.exhausted(mut lo1, fx: mut fx2, taken: taken.view())
                        })
                        index_insert(mut fx1, record, fragment, index: place.index)
                    }
                    None => {}
                }
                let at = open_gap(mut lo1, fx: mut fx1, address, index: place.index, element: entries.shape)
                let key_slot = mut fx1.offset(at, offset: entries.key_at)
                mut lo1.store_held(mut fx1, address: key_slot, held: key_held, ty: key)
                let value_slot = mut fx1.offset(at, offset: value_at)
                mut lo1.store_held(mut fx1, address: value_slot, held: value_held, ty: value)
                let zero = mut fx1.int(clif::Type.Int8, value: 0)
                mut lo1.write_option(mut fx1, option, address: result, presence: zero, value: Held.Empty)
                return mem::List[clif::Value].empty(fx1.alloc)
            })
            let held = mut lo.held_at(mut fx, ty: option, address: result)
            supply.ret(mut lo, mut fx, held)
        }
        "remove" => {
            let address = supply.param(0).address_value()
            let sought = held_address(mut lo, mut fx, ty: key, held: supply.param(1))
            let place = maps_find(mut lo, mut fx, entries, order, address, key: sought)
            let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
            let option = supply.abi.result
            let laid = mut lo.layout_of(option)
            let result = match supply.sret {
                Some(sret) => sret
                None => mut fx.slot(laid.contents().size, align: laid.contents().align)
            }
            mut lo.write_option_with(mut fx, layout_ty: option, address: result, presence: place.found, write_payload: fn(mut lo1: Lowering, mut fx1: Fx, payload: clif::Value) {
                let at = entries.shape.at(mut fx1, data, index: place.index)
                let stored = mut fx1.offset(at, offset: value_at)
                let held = mut lo1.held_at(mut fx1, ty: value, address: stored)
                mut lo1.store_held(mut fx1, address: payload, held, ty: value)
                let stored_key = mut fx1.offset(at, offset: entries.key_at)
                mut lo1.release(mut fx1, ty: key, address: stored_key)
                close_gap(mut lo1, fx: mut fx1, address, index: place.index, element: entries.shape)
                match place.fragment {
                    Some(fragment) => {
                        let record = mut fx1.offset(address, offset: MAPS_INDEX)
                        index_remove(mut fx1, record, fragment, removed: place.index)
                    }
                    None => {}
                }
            })
            let held = mut lo.held_at(mut fx, ty: option, address: result)
            supply.ret(mut lo, mut fx, held)
        }
        "at" or "at_mut" or "get" or "get_mut" => {
            let address = supply.param(0).address_value()
            let sought = held_address(mut lo, mut fx, ty: key, held: supply.param(1))
            let place = maps_find(mut lo, mut fx, entries, order, address, key: sought)
            let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
            let at = entries.shape.at(mut fx, data, index: place.index)
            let stored = mut fx.offset(at, offset: value_at)
            match supply.member() {
                "at" or "at_mut" => supply.ret(mut lo, mut fx, held: Held.Address(stored))
                else => projected_option(mut lo, mut fx, supply, value, found: place.found, stored)
            }
        }
        "get_by" or "get_by_mut" => {
            let address = supply.param(0).address_value()
            let compare = supply.param(1).address_value()
            let fn_ty = fn_param(lo, supply, index: 1)
            let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
            let len = mut fx.load(PTR, addr: address, offset: VECTOR_LEN)
            let searched = search_by(mut lo, mut fx, entries, data, len, fn_ty, compare)
            let at = entries.shape.at(mut fx, data, index: searched.index)
            let stored = mut fx.offset(at, offset: value_at)
            projected_option(mut lo, mut fx, supply, value, found: searched.found, stored)
        }
        "cursor" or "cursor_mut" => {
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            vector_write_view(mut fx, view: sret, address: supply.param(0).address_value())
            supply.done(mut lo, mut fx)
        }
        "into_cursor" => {
            if order == Order.Hashed {
                let record = mut fx.offset(supply.param(0).address_value(), offset: MAPS_INDEX)
                index_free(mut lo, mut fx, record)
            }
            maps_into_cursor(mut lo, mut fx, supply)
        }
        "retain" => {
            let address = supply.param(0).address_value()
            let keep = supply.param(1).address_value()
            let fn_ty = fn_param(lo, supply, index: 1)
            retain(mut lo, mut fx, address, element: entries.entry, keep: fn(mut lo1: Lowering, mut fx1: Fx, at: clif::Value) -> clif::Value {
                let stored_key = mut fx1.offset(at, offset: entries.key_at)
                let stored_value = mut fx1.offset(at, offset: value_at)
                let key_held = mut lo1.held_at(mut fx1, ty: key, address: stored_key)
                let value_held = mut lo1.held_at(mut fx1, ty: value, address: stored_value)
                var kept = Array[Held, 2].filled(key_held)
                kept[1] = value_held
                let called = mut lo1.call_value(mut fx1, fn_ty, function: keep, args: kept.view())
                return called.result.scalar_value()
            })
            if order == Order.Hashed {
                reindex(mut lo, mut fx, entries, address)
            }
            supply.done(mut lo, mut fx)
        }
        else => {
            expect false
        }
    }
} maps_map

/// Records each entry of a hash map afresh in its index, after entries were dropped.
fn reindex(mut lo: Lowering, mut fx: Fx, entries: Entries, address: clif::Value) {
    let record = mut fx.offset(address, offset: MAPS_INDEX)
    index_clear(mut lo, mut fx, record)
    let seed = mut fx.load(clif::Type.Int64, addr: address, offset: MAPS_SEED)
    let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
    let len = mut fx.load(PTR, addr: address, offset: VECTOR_LEN)
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: len, body: fn[mut lo](mut fx1: Fx, position: clif::Value) {
        let entry = entries.shape.at(mut fx1, data, index: position)
        let stored = mut fx1.offset(entry, offset: entries.key_at)
        let fragment = index_fragment(mut lo, fx: mut fx1, key: entries.key, at: stored, seed)
        index_insert(mut fx1, record, fragment, index: position)
    })
} reindex

/// Frees a hash map's index, before its vector is released.
fn free_index(mut lo: Lowering, mut fx: Fx, address: clif::Value) {
    let record = mut fx.offset(address, offset: MAPS_INDEX)
    index_free(mut lo, mut fx, record)
} free_index

/// Moves a hash map's index into another domain's reach.
fn lift_index(mut lo: Lowering, mut fx: Fx, address: clif::Value, lift: clif::Value) {
    let record = mut fx.offset(address, offset: MAPS_INDEX)
    index_lift(mut lo, mut fx, record, lift)
} lift_index

/// A binary search calling a function value with each key it visits, which gives the key's
/// order against the sought one.
fn search_by(mut lo: Lowering, mut fx: Fx, entries: Entries, data: clif::Value, len: clif::Value, fn_ty: ty::FnTy, compare: clif::Value) -> Lookup {
    return search(mut lo, mut fx, entries, data, len, compare: fn(mut lo1: Lowering, mut fx1: Fx, stored: clif::Value) -> clif::Value {
        let held = mut lo1.held_at(mut fx1, ty: entries.key, address: stored)
        let called = mut lo1.call_value(mut fx1, fn_ty, function: compare, args: Array[Held, 1].filled(held).view())
        return mut lo1.ordering_index(mut fx1, ordering: called.result)
    })
} search_by

/// Returns the projection's `Option`: `Some` of the part at `stored` when `found`, else
/// `None`.
fn projected_option(mut lo: Lowering, mut fx: Fx, supply: Supply, value: ty::Ty, found: clif::Value, stored: clif::Value) {
    let layout_ty = supply.abi.result
    let laid = mut lo.layout_of(layout_ty)
    let result = match supply.sret {
        Some(sret) => sret
        None => mut fx.slot(laid.contents().size, align: laid.contents().align)
    }
    let part = match supply.wrap {
        Some(wrap) => lo.is_part(value, wrap)
        None => false
    }
    mut lo.write_option_with(mut fx, layout_ty, address: result, presence: found, write_payload: fn(mut lo1: Lowering, mut fx1: Fx, payload: clif::Value) {
        if part {
            mut fx1.store(stored, addr: payload, offset: 0)
        } else {
            let held = mut lo1.held_at(mut fx1, ty: value, address: stored)
            mut lo1.store_held(mut fx1, address: payload, held, ty: value)
        }
    })
    let held = mut lo.held_at(mut fx, ty: layout_ty, address: result)
    supply.ret(mut lo, mut fx, held)
} projected_option

/// The address of a key held one way or another, in a new slot for a scalar.
fn held_address(mut lo: Lowering, mut fx: Fx, ty: ty::Ty, held: Held) -> clif::Value {
    match held {
        Held.Address(address) => return address
        else => {
            let laid = mut lo.layout_of(ty)
            let slot = mut fx.slot(laid.contents().size, align: laid.contents().align)
            mut lo.store_held(mut fx, address: slot, held, ty)
            return slot
        }
    }
} held_address

/// `into_cursor`: the vector, then the position 0.
fn maps_into_cursor(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    let source = supply.param(0).address_value()
    mut lo.copy(mut fx, dst: sret, src: source, size: 32, align: 8)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: sret, offset: 32)
    supply.done(mut lo, mut fx)
} maps_into_cursor

/// A member of `mem::Set[T]`.
fn maps_set(mut lo: Lowering, mut fx: Fx, supply: Supply)
    waive length "one arm per member of `mem::Set`, as they are dispatched"
{
    let value = supply.type_arg(lo, index: 0)
    let entries = Entries.of_set(mut lo, value)
    match supply.member() {
        "empty" => {
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            let alloc = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
            vector_empty(mut fx, address: sret, alloc, element: entries.shape)
            supply.done(mut lo, mut fx)
        }
        "len" => {
            let len = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: VECTOR_LEN)
            supply.ret(mut lo, mut fx, held: Held.Scalar(len))
        }
        "insert" or "try_insert" or "remove" => {
            let address = supply.param(0).address_value()
            let held = supply.param(1)
            let sought = held_address(mut lo, mut fx, ty: value, held)
            let place = maps_find(mut lo, mut fx, entries, order: Order.Sorted, address, key: sought)
            let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
            let len = mut fx.load(PTR, addr: address, offset: VECTOR_LEN)
            var changed = place.found
            if supply.member() == "remove" {
                mut fx.if_true(place.found, then: fn[mut lo](mut fx1: Fx) {
                    let at = entries.shape.at(mut fx1, data, index: place.index)
                    mut lo.release(mut fx1, ty: value, address: at)
                    close_gap(mut lo, fx: mut fx1, address, index: place.index, element: entries.shape)
                })
            } else {
                let results = fx.types1(clif::Type.Int8)
                let inserted = mut fx.choose_in(mut lo, condition: place.found, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
                    mut lo1.release(mut fx1, ty: value, address: sought)
                    let unchanged = mut fx1.int(clif::Type.Int8, value: 0)
                    return fx1.list1(unchanged)
                }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
                    let needed = mut fx1.b.iadd_imm_s(len, y: 1)
                    let room = vector_reserve(mut lo1, fx: mut fx1, address, needed, element: entries.shape)
                    let failed = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: room, y: 0)
                    mut fx1.if_true(failed, then: fn[mut lo1](mut fx2: Fx) {
                        let taken = Array[Taken, 1].filled(Taken(held: held, ty: value))
                        supply.exhausted(mut lo1, fx: mut fx2, taken: taken.view())
                    })
                    let at = open_gap(mut lo1, fx: mut fx1, address, index: place.index, element: entries.shape)
                    mut lo1.store_held(mut fx1, address: at, held, ty: value)
                    let added = mut fx1.int(clif::Type.Int8, value: 1)
                    return fx1.list1(added)
                })
                expect inserted.len() == 1
                changed = inserted[0]
            }
            supply.ret(mut lo, mut fx, held: Held.Scalar(changed))
        }
        "contains_by" => {
            let address = supply.param(0).address_value()
            let compare = supply.param(1).address_value()
            let fn_ty = fn_param(lo, supply, index: 1)
            let data = mut fx.load(PTR, addr: address, offset: VECTOR_DATA)
            let len = mut fx.load(PTR, addr: address, offset: VECTOR_LEN)
            let searched = search_by(mut lo, mut fx, entries, data, len, fn_ty, compare)
            supply.ret(mut lo, mut fx, held: Held.Scalar(searched.found))
        }
        "cursor" => {
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            vector_write_view(mut fx, view: sret, address: supply.param(0).address_value())
            supply.done(mut lo, mut fx)
        }
        "into_cursor" => maps_into_cursor(mut lo, mut fx, supply)
        "retain" => {
            let address = supply.param(0).address_value()
            let keep = supply.param(1).address_value()
            let fn_ty = fn_param(lo, supply, index: 1)
            retain(mut lo, mut fx, address, element: value, keep: fn(mut lo1: Lowering, mut fx1: Fx, at: clif::Value) -> clif::Value {
                let held = mut lo1.held_at(mut fx1, ty: value, address: at)
                let called = mut lo1.call_value(mut fx1, fn_ty, function: keep, args: Array[Held, 1].filled(held).view())
                return called.result.scalar_value()
            })
            supply.done(mut lo, mut fx)
        }
        else => {
            expect false
        }
    }
} maps_set

/// The parts of `mem::Entry[K, V]`: the address of its key, then of its value.
fn maps_entry(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let entry = supply.param(0).address_value()
    let offset = match supply.member() {
        "key" => 0u64
        else => 8u64
    }
    let part = mut fx.load(PTR, addr: entry, offset)
    supply.ret(mut lo, mut fx, held: Held.Address(part))
} maps_entry

/// `next` of a cursor viewing entries: an `Entry` of the next key-value entry, or of the next
/// set value.
fn view_next(mut lo: Lowering, mut fx: Fx, supply: Supply, entries: Entries) {
    let cursor = supply.param(0).address_value()
    let next = mut fx.load(PTR, addr: cursor, offset: 0)
    let left = mut fx.load(PTR, addr: cursor, offset: 8)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: left, y: 0)
    let layout_ty = supply.abi.result
    let laid = mut lo.layout_of(layout_ty)
    let result = match supply.sret {
        Some(sret) => sret
        None => mut fx.slot(laid.contents().size, align: laid.contents().align)
    }
    let element = entries.entry
    let part = match supply.wrap {
        Some(wrap) => lo.is_part(element, wrap)
        None => false
    }
    let shape = entries.shape
    mut lo.write_option_with(mut fx, layout_ty, address: result, presence: present, write_payload: fn(mut lo1: Lowering, mut fx1: Fx, payload: clif::Value) {
        match entries.value {
            Some(value_part) => {
                mut fx1.store(next, addr: payload, offset: 0)
                let value = mut fx1.offset(next, offset: value_part.at)
                mut fx1.store(value, addr: payload, offset: 8)
            }
            None => {
                if part {
                    mut fx1.store(next, addr: payload, offset: 0)
                } else {
                    let held = mut lo1.held_at(mut fx1, ty: element, address: next)
                    mut lo1.store_held(mut fx1, address: payload, held, ty: element)
                }
            }
        }
        let after = mut fx1.b.iadd_imm_s(next, y: i64.from_bits(shape.size))
        mut fx1.store(after, addr: cursor, offset: 0)
        let rest = mut fx1.b.iadd_imm_s(left, y: -1)
        mut fx1.store(rest, addr: cursor, offset: 8)
    })
    let held = mut lo.held_at(mut fx, ty: layout_ty, address: result)
    supply.ret(mut lo, mut fx, held)
} view_next
