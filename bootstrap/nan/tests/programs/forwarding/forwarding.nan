//! Forwarded calls through failure conversions, `take` arguments, generic heads and closures.

pub closed enum Low derives Render {
    Empty
} Low

pub closed enum Fault derives Render {
    Wrapped(Low) from
} Fault

pub fn checked(value: u32) -> u32 fails Low {
    if value == 0 {
        fail Low.Empty
    }
    return value
} checked

retired verified(value: u32) -> u32 fails Fault => checked(value) preserves

pub fn reading(value: u32) -> u32 {
    return match attempt verified(value) {
        Ok(found) => found
        Err(Fault.Wrapped(Low.Empty)) => 99
    }
} reading

pub fn strict(value: u32) -> u32 fails Fault {
    return try verified(value)
} strict

pub closed struct Token {
    pub size: u32
} Token

pub fn Token.weight(take self) -> u32 = self.size

retired measure(take token: Token) -> u32 => take token.weight() preserves

pub fn pick[T: Copy](left: T, right: T, leftmost: bool) -> T {
    if leftmost {
        return left
    }
    return right
} pick

retired choose[T: Copy](leftmost: bool, left: T, right: T) -> T => pick(left, right, leftmost) preserves

pub fn apply(value: u32, step: fn(x: u32) -> u32) -> u32 = step(value)

retired doubled(value: u32) -> u32 => apply(value, step: fn(x: u32) => x.saturating_add(x)) preserves

fn main(take world: host::World) -> u8 fails task::Cancelled uses wait {
    world.log.info("verified", value: reading(7))
    world.log.info("empty", value: reading(0))
    let strictly = match attempt strict(0) {
        Ok(found) => found
        Err(Fault.Wrapped(Low.Empty)) => 98
    }
    world.log.info("strict", value: strictly)
    world.log.info("measured", value: measure(Token(size: 5)))
    world.log.info("chosen", value: choose(false, left: 1u32, right: 2u32))
    world.log.info("doubled", value: doubled(21))
    return 0
} main
