item "nan::artefact::read_bytes"
head "pkg fn read_bytes(bytes: Slice[u8], at: usize) -> Option[Chunk]"
accepted "ensures match result {         Some(chunk) => chunk.start <= chunk.next and chunk.next <= bytes.len()         None => true     }"
