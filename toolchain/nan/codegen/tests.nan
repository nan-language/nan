    expect code.frame == 224
} spills_what_the_registers_cannot_hold_into_the_frame_for_aarch64

test relocates_symbols_by_where_they_are_defined_and_locates_calls_for_aarch64 for compile {
    let alloc = testing::world().alloc
    let code = compile(symbols(alloc), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\xff\x43\x00\xd1\xb3\x03\x1f\xf8\x00\x00\x00\x94\xf3\x03\x00\xaa\x00\x00\x00\x90\x00\x00\x40\xf9\x00\x00\x3f\xd6\xe1\x03\x00\xaa\x02\x00\x00\x90\x42\x00\x00\x91\x03\x00\x00\x90\x63\x00\x40\xf9\x00\x00\x00\x90\x04\x00\x40\xf9\x00\x00\x00\x91\x80\x00\x3f\xd6\x44\xd0\x3b\xd5\x00\x00\x04\x8b\x04\x00\x00\x90\x84\x00\x40\xf9\x61\x02\x01\x8b\x21\x00\x02\x8b\x21\x00\x03\x8b\x20\x00\x00\x8b\x00\x00\x04\x8b\xb3\x03\x5f\xf8\xbf\x03\x00\x91\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
    expect code.relocs.len() == 13
    expect code.relocs[0] == machinst::Reloc(offset: 16, kind: machinst::RelocKind.Arm64Call, target: named(0, index: 3), addend: 0)
    expect code.relocs[1] == machinst::Reloc(offset: 24, kind: machinst::RelocKind.Arm64AdrGotPage, target: named(0, index: 4), addend: 0)
    expect code.relocs[3] == machinst::Reloc(offset: 40, kind: machinst::RelocKind.Arm64AdrPrel, target: named(1, index: 5), addend: 0)
    expect code.relocs[4] == machinst::Reloc(offset: 44, kind: machinst::RelocKind.Arm64AddLo12, target: named(1, index: 5), addend: 0)
    expect code.relocs[7] == machinst::Reloc(offset: 56, kind: machinst::RelocKind.Arm64TlsDescAdrPage, target: named(1, index: 7), addend: 0)
    expect code.relocs[10] == machinst::Reloc(offset: 68, kind: machinst::RelocKind.Arm64TlsDescCall, target: named(1, index: 7), addend: 0)
    expect code.relocs[12] == machinst::Reloc(offset: 84, kind: machinst::RelocKind.Arm64Ld64GotLo12, target: named(0, index: 4), addend: 0)
    expect code.locations.len() == 2
    expect code.locations[0] == Located(offset: 16, loc: clif::SourceLoc(bits: 7))
    expect code.locations[1] == Located(offset: 24, loc: clif::SourceLoc(bits: 9))
    let fixed = compile(symbols(alloc), isa: arm_machine_isa(), leaves: Leaves.empty(alloc), alloc)
    expect fixed.relocs.len() == 10
    expect fixed.relocs[1] == machinst::Reloc(offset: 32, kind: machinst::RelocKind.Arm64Abs64, target: named(0, index: 4), addend: 0)
    expect fixed.relocs[4] == machinst::Reloc(offset: 64, kind: machinst::RelocKind.Arm64Abs64, target: named(1, index: 6), addend: 0)
    expect fixed.relocs[9] == machinst::Reloc(offset: 104, kind: machinst::RelocKind.Arm64Abs64, target: named(0, index: 4), addend: 0)
} relocates_symbols_by_where_they_are_defined_and_locates_calls_for_aarch64

test probes_frames_reaching_the_guard_page_on_the_host_and_aligns_slots_for_aarch64 for compile {
    let alloc = testing::world().alloc
    let probed = compile(large_frame(alloc), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    expect probed.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\x10\x00\x80\xd2\x11\xd0\x89\xd2\x10\x06\x40\xd1\xff\x6b\x30\xb8\x1f\x02\x11\xab\xac\xff\xff\x54\xff\x13\x40\xd1\xff\x43\x39\xd1\xf0\x03\x00\x91\x10\xe6\x7a\x92\x1f\x02\x00\x91\xe0\x0f\x27\xf9\xe0\x0f\x67\xf9\xe1\x13\x40\x91\x21\x00\x39\x91\x00\x00\x01\xca\xe1\x03\x00\x91\x00\x00\x01\xca\xbf\x03\x00\x91\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
    let unprobed = compile(large_frame(alloc), isa: arm_machine_isa(), leaves: Leaves.empty(alloc), alloc)
    expect unprobed.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\xff\x13\x40\xd1\xff\x43\x39\xd1\xf0\x03\x00\x91\x10\xe6\x7a\x92\x1f\x02\x00\x91\xe0\x0f\x27\xf9\xe0\x0f\x67\xf9\xe1\x13\x40\x91\x21\x00\x39\x91\x00\x00\x01\xca\xe1\x03\x00\x91\x00\x00\x01\xca\xbf\x03\x00\x91\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
    expect probed.frame == unprobed.frame
    expect probed.frame == 20112
} probes_frames_reaching_the_guard_page_on_the_host_and_aligns_slots_for_aarch64

test canonicalizes_float_results_and_loops_atomics_for_aarch64 for compile {
    let alloc = testing::world().alloc
    var signature = clif::Signature.new(clif::CallConv.SystemV, alloc)
    mut signature.params.push(clif::AbiParam(value_type: clif::Type.Float64))
    mut signature.params.push(clif::AbiParam(value_type: clif::Type.Float64))
    mut signature.returns.push(clif::AbiParam(value_type: clif::Type.Float64))
    var b = clif::Builder.new(clif::Function.new(clif::ExternalName(namespace: 0, index: 0), signature: take signature, alloc), alloc)
    let entry = mut b.create_block()
    mut b.append_block_params_for_function_params(entry)
    mut b.switch_to_block(entry)
    mut b.seal_block(entry)
    let params = params_of(b, alloc)
    expect params.len() == 2
    let sum = mut b.fadd(params[0], y: params[1])
    mut b.ret(one(sum, alloc).view())
    let code = compile(take b.finalize(), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\x00\x28\x61\x1e\x00\x20\x60\x1e\x67\x00\x00\x54\x00\xff\xef\xd2\x00\x00\x67\x9e\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
    var atomic = builder_of(2, alloc)
    let pointer_and_addend = params_of(atomic, alloc)
    expect pointer_and_addend.len() == 2
    let old = mut atomic.atomic_rmw(clif::Type.Int64, flags: clif::MemFlags.owned(), op: clif::AtomicRmwOp.Add, p: pointer_and_addend[0], x: pointer_and_addend[1])
    mut atomic.ret(one(old, alloc).view())
    let looped = compile(take atomic.finalize(), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    expect looped.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\x02\xfc\x5f\xc8\x43\x00\x01\x8b\x03\xfc\x04\xc8\xa4\xff\xff\x35\xe0\x03\x02\xaa\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
} canonicalizes_float_results_and_loops_atomics_for_aarch64

test locates_traps_at_their_instructions_for_aarch64 for compile {
    let alloc = testing::world().alloc
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let failing = mut b.create_block()
    let passing = mut b.create_block()
    mut b.brif(params[0], then: failing, then_args: no_values(alloc).view(), otherwise: passing, otherwise_args: no_values(alloc).view())
    mut b.switch_to_block(failing)
    mut b.set_srcloc(clif::SourceLoc(bits: 5))
    mut b.trap(clif::TrapCode(user: 1))
    mut b.switch_to_block(passing)
    mut b.set_srcloc(clif::DEFAULT_LOC)
    mut b.ret(one(params[0], alloc).view())
    mut b.seal_all_blocks()
    let code = compile(take b.finalize(), isa: arm_machine_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\xfd\x7b\xbf\xa9\xfd\x03\x00\x91\x40\x00\x00\xb4\x1f\xc1\x00\x00\xfd\x7b\xc1\xa8\xc0\x03\x5f\xd6"
    expect code.locations.len() == 1
    expect code.locations[0] == Located(offset: 12, loc: clif::SourceLoc(bits: 5))
} locates_traps_at_their_instructions_for_aarch64

fn machine_isa() -> Isa = Isa(arch: workspace::Arch.Amd64, pic: false, probes: false, level: None)

test compiles_an_addition_without_moves for compile {
    let alloc = testing::world().alloc
    var b = builder_of(2, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 2
    let sum = mut b.iadd(params[0], y: params[1])
    mut b.ret(one(sum, alloc).view())
    let code = compile(take b.finalize(), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x48\x8d\x04\x37\x5d\xc3"
    expect code.frame == 16
    expect code.relocs.len() == 0
    expect code.locations.len() == 0
} compiles_an_addition_without_moves

/// The sum of the counter's values below the parameter, its loop's values in their parameters'
/// registers.
test carries_loop_values_in_the_registers_of_their_parameters for compile {
    let alloc = testing::world().alloc
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let n = params[0]
    let head = mut b.create_block()
    let i = mut b.append_block_param(head, ty: clif::Type.Int64)
    let acc = mut b.append_block_param(head, ty: clif::Type.Int64)
    let body = mut b.create_block()
    let exit = mut b.create_block()
    let total = mut b.append_block_param(exit, ty: clif::Type.Int64)
    let zero = mut b.iconst(clif::Type.Int64, imm: 0)
    var start = one(zero, alloc)
    mut start.push(zero)
    mut b.jump(head, args: start.view())
    mut b.switch_to_block(head)
    let more = mut b.icmp(clif::IntCC.UnsignedLessThan, x: i, y: n)
    mut b.brif(more, then: body, then_args: no_values(alloc).view(), otherwise: exit, otherwise_args: one(acc, alloc).view())
    mut b.switch_to_block(body)
    let grown = mut b.iadd(acc, y: i)
    let next = mut b.iadd_imm_s(i, y: 1)
    var back = one(next, alloc)
    mut back.push(grown)
    mut b.jump(head, args: back.view())
    mut b.switch_to_block(exit)
    mut b.ret(one(total, alloc).view())
    mut b.seal_all_blocks()
    let code = compile(take b.finalize(), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\x55\x48\x89\xe5\xb8\x00\x00\x00\x00\xb9\x00\x00\x00\x00\x48\x39\xf8\x72\x05\x48\x89\xc8\xeb\x0a\x48\x8d\x0c\x01\x48\x8d\x40\x01\xeb\xec\x5d\xc3"
} carries_loop_values_in_the_registers_of_their_parameters

/// The parameter, after branches on it to blocks that only jump on to where the other edge
/// goes, as a derived equality of a fieldless enum branches.
test drops_branches_whose_edges_land_in_one_block for compile {
    let alloc = testing::world().alloc
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    for k in 0i64..<3 {
        let tag = mut b.iconst(clif::Type.Int64, imm: k)
        let hit = mut b.icmp(clif::IntCC.Equal, x: params[0], y: tag)
        let forward = mut b.create_block()
        let next = mut b.create_block()
        mut b.brif(hit, then: forward, then_args: no_values(alloc).view(), otherwise: next, otherwise_args: no_values(alloc).view())
        mut b.switch_to_block(forward)
        mut b.jump(next, args: no_values(alloc).view())
        mut b.switch_to_block(next)
    }
    mut b.ret(one(params[0], alloc).view())
    mut b.seal_all_blocks()
    let code = compile(take b.finalize(), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x48\x89\xf8\x5d\xc3"
} drops_branches_whose_edges_land_in_one_block

/// `u0:1(x, y) = x - y` and `u0:2(x, y)`, the larger of `x` and `y` through a branch, as leaves
/// whose calls take their bodies in place.
fn two_leaves(alloc: mem::Alloc) -> Leaves {
    var held = Leaves.empty(alloc)
    var sub_body = named_builder(1, params: 2, alloc)
    let pair = params_of(sub_body, alloc)
    expect pair.len() == 2
    let less = mut sub_body.isub(pair[0], y: pair[1])
    mut sub_body.ret(one(less, alloc).view())
    mut held.offer(take sub_body.finalize(), alloc)
    var max_body = named_builder(2, params: 2, alloc)
    let both = params_of(max_body, alloc)
    expect both.len() == 2
    let keep = mut max_body.create_block()
    let replace = mut max_body.create_block()
    let below = mut max_body.icmp(clif::IntCC.UnsignedLessThan, x: both[0], y: both[1])
    mut max_body.brif(below, then: replace, then_args: no_values(alloc).view(), otherwise: keep, otherwise_args: no_values(alloc).view())
    mut max_body.switch_to_block(keep)
    mut max_body.ret(one(both[0], alloc).view())
    mut max_body.switch_to_block(replace)
    mut max_body.ret(one(both[1], alloc).view())
    mut max_body.seal_all_blocks()
    mut held.offer(take max_body.finalize(), alloc)
    return held
} two_leaves

/// `u0:2(u0:1(b, a), a)`: both calls take their callees' bodies in place.
test takes_the_bodies_of_leaves_in_place_of_their_calls for compile {
    let alloc = testing::world().alloc
    var b = builder_of(2, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 2
    let sig_ref = mut b.import_signature(int_signature(2, alloc))
    let subtract = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 1), signature: sig_ref, colocated: true))
    let maximum = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 2), signature: sig_ref, colocated: true))
    var reversed = one(params[1], alloc)
    mut reversed.push(params[0])
    let first_call = mut b.call(subtract, args: reversed.view())
    var pair = one(call_result(b, call: first_call, alloc), alloc)
    mut pair.push(params[0])
    let second_call = mut b.call(maximum, args: pair.view())
    mut b.ret(one(call_result(b, call: second_call, alloc), alloc).view())
    let code = compile(take b.finalize(), isa: host_isa(), leaves: two_leaves(alloc), alloc)
    expect code.relocs.len() == 0
    expect code.frame == 16
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x48\x29\xfe\x48\x39\xfe\x72\x05\x48\x89\xf0\xeb\x03\x48\x89\xf8\x5d\xc3"
} takes_the_bodies_of_leaves_in_place_of_their_calls

/// A call of `u0:1(p)`, a load from `p` that may fault, as a hardware pointer's read does: the
/// call stays, so that a fault happens in the leaf, as without its body taken in place.
test keeps_calls_of_leaves_whose_loads_may_fault for compile {
    let alloc = testing::world().alloc
    var held = Leaves.empty(alloc)
    var read_body = named_builder(1, params: 1, alloc)
    let address = params_of(read_body, alloc)
    expect address.len() == 1
    let read = mut read_body.load(clif::Type.Int64, flags: clif::MemFlags(aligned: true, notrap: false), p: address[0], offset: 0)
    mut read_body.ret(one(read, alloc).view())
    mut held.offer(take read_body.finalize(), alloc)
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let sig_ref = mut b.import_signature(int_signature(1, alloc))
    let reader = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 1), signature: sig_ref, colocated: true))
    let call = mut b.call(reader, args: one(params[0], alloc).view())
    mut b.ret(one(call_result(b, call: call, alloc), alloc).view())
    let code = compile(take b.finalize(), isa: host_isa(), leaves: held, alloc)
    expect code.relocs.len() == 1
    expect code.relocs[0].kind == machinst::RelocKind.Relative4
} keeps_calls_of_leaves_whose_loads_may_fault

/// A parameter stored into a stack slot through a leaf, `u0:3(p, x)` storing `x` 8 bytes past
/// `p` and giving 0, then read back: the slot is held in a value once the leaf's body takes the
/// call's place.
test holds_slots_only_loads_and_stores_reach_in_values for compile {
    let alloc = testing::world().alloc
    let flags = clif::MemFlags.owned()
    var held = Leaves.empty(alloc)
    var store_body = named_builder(3, params: 2, alloc)
    let pair = params_of(store_body, alloc)
    expect pair.len() == 2
    mut store_body.store(flags, x: pair[1], p: pair[0], offset: 8)
    let zero = mut store_body.iconst(clif::Type.Int64, imm: 0)
    mut store_body.ret(one(zero, alloc).view())
    mut held.offer(take store_body.finalize(), alloc)
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let sig_ref = mut b.import_signature(int_signature(2, alloc))
    let keep = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 3), signature: sig_ref, colocated: true))
    let slot = mut b.create_sized_stack_slot(clif::StackSlotData(size: 16, align_shift: 3))
    let place = mut b.stack_addr(clif::Type.Int64, slot, offset: 0)
    var args = one(place, alloc)
    mut args.push(params[0])
    discard mut b.call(keep, args: args.view())
    let back = mut b.load(clif::Type.Int64, flags, p: place, offset: 8)
    mut b.ret(one(back, alloc).view())
    let code = compile(take b.finalize(), isa: host_isa(), leaves: held, alloc)
    expect code.frame == 16
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x48\x89\xf8\x5d\xc3"
} holds_slots_only_loads_and_stores_reach_in_values

/// `b` when `a < b`, else `a`, branching on whether the tag a select of 0 and 1 gives on that
/// comparison is 0, as an `Option` returned through a slot is tested: one comparison decides.
fn tested_flag(alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(2, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 2
    let below = mut b.icmp(clif::IntCC.UnsignedLessThan, x: params[0], y: params[1])
    let empty_tag = mut b.iconst(clif::Type.Int8, imm: 0)
    let full_tag = mut b.iconst(clif::Type.Int8, imm: 1)
    let tag = mut b.select(below, x: empty_tag, y: full_tag)
    let absent = mut b.icmp_imm_s(clif::IntCC.Equal, x: tag, y: 0)
    let take_second = mut b.create_block()
    let take_first = mut b.create_block()
    mut b.brif(absent, then: take_second, then_args: no_values(alloc).view(), otherwise: take_first, otherwise_args: no_values(alloc).view())
    mut b.switch_to_block(take_second)
    mut b.ret(one(params[1], alloc).view())
    mut b.switch_to_block(take_first)
    mut b.ret(one(params[0], alloc).view())
    mut b.seal_all_blocks()
    return take b.finalize()
} tested_flag

test branches_on_the_comparison_deciding_a_tested_flag for compile {
    let alloc = testing::world().alloc
    let code = compile(tested_flag(alloc), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x48\x39\xf7\x73\x05\x48\x89\xf0\x5d\xc3\x48\x89\xf8\x5d\xc3"
} branches_on_the_comparison_deciding_a_tested_flag

/// `10k` for a parameter `k` below 8, else 99, through a chain of tests of the parameter.
fn chain_of_tests(alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    var returning = mem::List[clif::Block].empty(alloc)
    for k in 0i64..<8 {
        let key = mut b.iconst(clif::Type.Int64, imm: k)
        let hit = mut b.icmp(clif::IntCC.Equal, x: params[0], y: key)
        let found = mut b.create_block()
        let next = mut b.create_block()
        mut b.brif(hit, then: found, then_args: no_values(alloc).view(), otherwise: next, otherwise_args: no_values(alloc).view())
        mut returning.push(found)
        mut b.switch_to_block(next)
    }
    let missing = mut b.iconst(clif::Type.Int64, imm: 99)
    mut b.ret(one(missing, alloc).view())
    for k in 0..<returning.len() {
        mut b.switch_to_block(returning[k])
        let result = mut b.iconst(clif::Type.Int64, imm: 10 * i64.fit(k))
        mut b.ret(one(result, alloc).view())
    }
    mut b.seal_all_blocks()
    return take b.finalize()
} chain_of_tests

/// A jump through a table of the returning blocks.
test jumps_through_a_table_for_a_chain_of_tests_of_one_value for compile {
    let alloc = testing::world().alloc
    let code = compile(chain_of_tests(alloc), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x48\x83\xff\x07\x77\x10\x48\x8d\x05\x4b\x00\x00\x00\x48\x63\x0c\xb8\x48\x01\xc8\xff\xe0\xb8\x63\x00\x00\x00\x5d\xc3\xb8\x00\x00\x00\x00\x5d\xc3\xb8\x0a\x00\x00\x00\x5d\xc3\xb8\x14\x00\x00\x00\x5d\xc3\xb8\x1e\x00\x00\x00\x5d\xc3\xb8\x28\x00\x00\x00\x5d\xc3\xb8\x32\x00\x00\x00\x5d\xc3\xb8\x3c\x00\x00\x00\x5d\xc3\xb8\x46\x00\x00\x00\x5d\xc3\xcc\xcc\xcc\xc5\xff\xff\xff\xcc\xff\xff\xff\xd3\xff\xff\xff\xda\xff\xff\xff\xe1\xff\xff\xff\xe8\xff\xff\xff\xef\xff\xff\xff\xf6\xff\xff\xff"
} jumps_through_a_table_for_a_chain_of_tests_of_one_value

/// `3x + 5f(x) + f(f(x) + x)` through a function pointer, `x`, `f` and `f(x)` live across calls.
fn calls_through_a_pointer(alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(2, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 2
    let sig_ref = mut b.import_signature(int_signature(1, alloc))
    let first_call = mut b.call_indirect(sig_ref, callee: params[0], args: one(params[1], alloc).view())
    let once = call_result(b, call: first_call, alloc)
    let again = mut b.iadd(once, y: params[1])
    let second_call = mut b.call_indirect(sig_ref, callee: params[0], args: one(again, alloc).view())
    let twice = call_result(b, call: second_call, alloc)
    let x3 = mut b.imul_imm_s(params[1], y: 3)
    let y5 = mut b.imul_imm_s(once, y: 5)
    let partial = mut b.iadd(x3, y: y5)
    let total = mut b.iadd(partial, y: twice)
    mut b.ret(one(total, alloc).view())
    return take b.finalize()
} calls_through_a_pointer

test keeps_values_across_calls_in_callee_saved_registers for compile {
    let alloc = testing::world().alloc
    let code = compile(calls_through_a_pointer(alloc), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x53\x41\x54\x41\x55\x48\x83\xec\x08\x48\x89\xfb\x49\x89\xf4\x4c\x89\xe7\xff\xd3\x49\x89\xc5\x4b\x8d\x7c\x25\x00\xff\xd3\x49\x6b\xcc\x03\x49\x6b\xd5\x05\x48\x8d\x0c\x11\x48\x8d\x04\x01\x48\x83\xc4\x08\x41\x5d\x41\x5c\x5b\x5d\xc3"
    expect code.frame == 48
} keeps_values_across_calls_in_callee_saved_registers

/// `count` values of the parameter all live at once, summed.
fn live_values(count: u32, alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let a = params[0]
    var values = mem::List[clif::Value].empty(alloc)
    for k in 0i64..<i64.widen(count) {
        let scaled = mut b.imul_imm_s(a, y: k + 3)
        let value = mut b.iadd_imm_s(scaled, y: k)
        mut values.push(value)
    }
    var sum = mut b.iconst(clif::Type.Int64, imm: 0)
    for value in values {
        let times = mut b.imul_imm_s(sum, y: 31)
        sum = mut b.iadd(times, y: value)
    }
    mut b.ret(one(sum, alloc).view())
    return take b.finalize()
} live_values

/// 24 values all live at once: five callee-saved registers pushed and 13 spill slots.
test spills_what_the_registers_cannot_hold_into_the_frame for compile {
    let alloc = testing::world().alloc
    let code = compile(live_values(24, alloc), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.frame == 160
} spills_what_the_registers_cannot_hold_into_the_frame

/// Calls of a colocated and an imported function at source locations 7 and 9, then the addresses
/// of a colocated, an imported and a thread-local data object and of the imported function.
fn symbols(alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(0, alloc)
    let local_sig = mut b.import_signature(int_signature(0, alloc))
    let imported_sig = mut b.import_signature(int_signature(0, alloc))
    let local = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 3), signature: local_sig, colocated: true))
    let imported = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 4), signature: imported_sig, colocated: false))
    let data = mut b.create_global_value(clif::GlobalValueData(name: clif::ExternalName(namespace: 1, index: 5), colocated: true, tls: false))
    let extern_data = mut b.create_global_value(clif::GlobalValueData(name: clif::ExternalName(namespace: 1, index: 6), colocated: false, tls: false))
    let thread = mut b.create_global_value(clif::GlobalValueData(name: clif::ExternalName(namespace: 1, index: 7), colocated: true, tls: true))
    mut b.set_srcloc(clif::SourceLoc(bits: 7))
    let first_call = mut b.call(local, args: no_values(alloc).view())
    let first_value = call_result(b, call: first_call, alloc)
    mut b.set_srcloc(clif::SourceLoc(bits: 9))
    let second_call = mut b.call(imported, args: no_values(alloc).view())
    let second_value = call_result(b, call: second_call, alloc)
    mut b.set_srcloc(clif::DEFAULT_LOC)
    let data_address = mut b.symbol_value(clif::Type.Int64, global_value: data)
    let extern_address = mut b.symbol_value(clif::Type.Int64, global_value: extern_data)
    let thread_address = mut b.tls_value(clif::Type.Int64, global_value: thread)
    let function_address = mut b.func_addr(clif::Type.Int64, func_ref: imported)
    let s1 = mut b.iadd(first_value, y: second_value)
    let s2 = mut b.iadd(s1, y: data_address)
    let s3 = mut b.iadd(s2, y: extern_address)
    let s4 = mut b.iadd(s3, y: thread_address)
    let s5 = mut b.iadd(s4, y: function_address)
    mut b.ret(one(s5, alloc).view())
    return take b.finalize()
} symbols

fn named(namespace: u32, index: u32) -> machinst::Symbol = machinst::Symbol.Name(clif::ExternalName(namespace: namespace, index: index))

test relocates_symbols_by_where_they_are_defined_and_locates_calls for compile {
    let alloc = testing::world().alloc
    let code = compile(symbols(alloc), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.relocs.len() == 7
    expect code.relocs[0] == machinst::Reloc(offset: 12, kind: machinst::RelocKind.Relative4, target: named(0, index: 3), addend: -4)
    expect code.relocs[1] == machinst::Reloc(offset: 20, kind: machinst::RelocKind.CallPlt4, target: named(0, index: 4), addend: -4)
    expect code.relocs[2] == machinst::Reloc(offset: 30, kind: machinst::RelocKind.Relative4, target: named(1, index: 5), addend: -4)
    expect code.relocs[3] == machinst::Reloc(offset: 37, kind: machinst::RelocKind.GotRelative4, target: named(1, index: 6), addend: -4)
    expect code.relocs[4] == machinst::Reloc(offset: 45, kind: machinst::RelocKind.TlsGeneralDynamic, target: named(1, index: 7), addend: -4)
    expect code.relocs[5] == machinst::Reloc(offset: 53, kind: machinst::RelocKind.CallPlt4, target: machinst::Symbol.TlsGetAddr, addend: -4)
    expect code.relocs[6] == machinst::Reloc(offset: 60, kind: machinst::RelocKind.GotRelative4, target: named(0, index: 4), addend: -4)
    expect code.locations.len() == 2
    expect code.locations[0] == Located(offset: 11, loc: clif::SourceLoc(bits: 7))
    expect code.locations[1] == Located(offset: 19, loc: clif::SourceLoc(bits: 9))
    let fixed = compile(symbols(alloc), isa: machine_isa(), leaves: Leaves.empty(alloc), alloc)
    expect fixed.relocs.len() == 7
    expect fixed.relocs[3] == machinst::Reloc(offset: 36, kind: machinst::RelocKind.Absolute8, target: named(1, index: 6), addend: 0)
    expect fixed.relocs[6] == machinst::Reloc(offset: 62, kind: machinst::RelocKind.Absolute8, target: named(0, index: 4), addend: 0)
} relocates_symbols_by_where_they_are_defined_and_locates_calls

/// A 20000-byte slot and an 8-byte one aligned to 64, the result mixing a word of the first with
/// both slots' addresses.
fn large_frame(alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let a = params[0]
    let flags = clif::MemFlags.owned()
    let big = mut b.create_sized_stack_slot(clif::StackSlotData(size: 20000, align_shift: 3))
    let aligned = mut b.create_sized_stack_slot(clif::StackSlotData(size: 8, align_shift: 6))
    let start = mut b.stack_addr(clif::Type.Int64, slot: big, offset: 0)
    mut b.store(flags, x: a, p: start, offset: 19992)
    let word = mut b.load(clif::Type.Int64, flags, p: start, offset: 19992)
    let place = mut b.stack_addr(clif::Type.Int64, slot: aligned, offset: 0)
    let mixed = mut b.bxor(word, y: place)
    let both = mut b.bxor(mixed, y: start)
    mut b.ret(one(both, alloc).view())
    return take b.finalize()
} large_frame

test probes_frames_reaching_the_guard_page_on_the_host_and_aligns_slots for compile {
    let alloc = testing::world().alloc
    let probed = compile(large_frame(alloc), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    let Some(head) = probed.bytes.view().prefix(18) else {
        expect false
        return
    }
    expect head == b"\x55\x48\x89\xe5\x48\x81\xec\x00\x10\x00\x00\xc7\x04\x24\x00\x00\x00\x00"
    let unprobed = compile(large_frame(alloc), isa: machine_isa(), leaves: Leaves.empty(alloc), alloc)
    let Some(start) = unprobed.bytes.view().prefix(15) else {
        expect false
        return
    }
    expect start == b"\x55\x48\x89\xe5\x48\x81\xec\x50\x4e\x00\x00\x48\x83\xe4\xc0"
    expect probed.frame == unprobed.frame
    expect probed.frame == 20112
} probes_frames_reaching_the_guard_page_on_the_host_and_aligns_slots

/// `stack_switch(store, load, payload) + 2 * payload`: the payload in `rdi` and spilled across
/// the switch, every callee-saved register saved.
test saves_every_callee_saved_register_around_a_stack_switch for compile {
    let alloc = testing::world().alloc
    var b = builder_of(3, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 3
    let received = mut b.stack_switch(params[0], load_context_ptr: params[1], in_payload0: params[2])
    let doubled = mut b.iadd(params[2], y: params[2])
    let total = mut b.iadd(received, y: doubled)
    mut b.ret(one(total, alloc).view())
    let code = compile(take b.finalize(), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    let Some(head) = code.bytes.view().prefix(17) else {
        expect false
        return
    }
    expect head == b"\x55\x48\x89\xe5\x53\x41\x54\x41\x55\x41\x56\x41\x57\x48\x83\xec\x08"
    expect code.frame == 64
} saves_every_callee_saved_register_around_a_stack_switch

/// `9`, through a block testing whether its parameter is 0 that the entry reaches with 1: the
/// edge goes straight to the block returning 9.
test threads_an_edge_whose_argument_decides_the_branch for compile {
    let alloc = testing::world().alloc
    var b = builder_of(0, alloc)
    let test_block = mut b.create_block()
    let flag = mut b.append_block_param(test_block, ty: clif::Type.Int64)
    let zero_block = mut b.create_block()
    let other_block = mut b.create_block()
    let one_value = mut b.iconst(clif::Type.Int64, imm: 1)
    mut b.jump(test_block, args: one(one_value, alloc).view())
    mut b.switch_to_block(test_block)
    let empty = mut b.icmp_imm_s(clif::IntCC.Equal, x: flag, y: 0)
    mut b.brif(empty, then: zero_block, then_args: no_values(alloc).view(), otherwise: other_block, otherwise_args: no_values(alloc).view())
    mut b.switch_to_block(zero_block)
    let seven = mut b.iconst(clif::Type.Int64, imm: 7)
    mut b.ret(one(seven, alloc).view())
    mut b.switch_to_block(other_block)
    let nine = mut b.iconst(clif::Type.Int64, imm: 9)
    mut b.ret(one(nine, alloc).view())
    mut b.seal_all_blocks()
    let code = compile(take b.finalize(), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    expect code.bytes.view() == b"\x55\x48\x89\xe5\xb8\x09\x00\x00\x00\x5d\xc3"
} threads_an_edge_whose_argument_decides_the_branch

/// The parameter, after a copy by `u0:1`, noted as copying, into a slot nothing else reaches;
/// the copy stays when a load reads the slot.
test leaves_out_copies_into_slots_nothing_reads for compile {
    let alloc = testing::world().alloc
    var noted = Leaves.empty(alloc)
    mut noted.note_copier(1)
    let unread = compile(copy_into_slot(read: false, alloc), isa: host_isa(), leaves: noted, alloc)
    expect unread.relocs.len() == 0 and unread.frame == 16
    expect unread.bytes.view() == b"\x55\x48\x89\xe5\x48\x89\xf8\x5d\xc3"
    let read = compile(copy_into_slot(read: true, alloc), isa: host_isa(), leaves: noted, alloc)
    expect read.relocs.len() == 1
} leaves_out_copies_into_slots_nothing_reads

/// A function copying 16 bytes from its parameter into a slot by calling `u0:1`, returning the
/// slot's first word when `read`, else the parameter.
fn copy_into_slot(read: bool, alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let sig_ref = mut b.import_signature(int_signature(3, alloc))
    let copier = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 1), signature: sig_ref, colocated: true))
    let slot = mut b.create_sized_stack_slot(clif::StackSlotData(size: 16, align_shift: 3))
    let place = mut b.stack_addr(clif::Type.Int64, slot, offset: 0)
    let length = mut b.iconst(clif::Type.Int64, imm: 16)
    var args = one(place, alloc)
    mut args.push(params[0])
    mut args.push(length)
    discard mut b.call(copier, args: args.view())
    var returned = params[0]
    if read {
        returned = mut b.load(clif::Type.Int64, flags: clif::MemFlags.owned(), p: place, offset: 0)
    }
    mut b.ret(one(returned, alloc).view())
    return take b.finalize()
} copy_into_slot

/// The parameter, after a call of `u0:1` whose result nothing reads, `u0:1` being noted as a
/// function whose calls can be left out.
test leaves_out_unread_calls_of_functions_noted_removable for compile {
    let alloc = testing::world().alloc
    var noted = Leaves.empty(alloc)
    mut noted.note_removable(1)
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let sig_ref = mut b.import_signature(int_signature(1, alloc))
    let callee = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 1), signature: sig_ref, colocated: true))
    discard mut b.call(callee, args: one(params[0], alloc).view())
    mut b.ret(one(params[0], alloc).view())
    let code = compile(take b.finalize(), isa: host_isa(), leaves: noted, alloc)
    expect code.relocs.len() == 0
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x48\x89\xf8\x5d\xc3"
} leaves_out_unread_calls_of_functions_noted_removable

/// The parameter, after a copy of it into a slot and an unread call of a leaf `u0:2` reading
/// the slot, `u0:2` being noted removable: the call is left out, not taken in place, and so is
/// the copy nothing else reads.
test leaves_out_unread_calls_of_removable_leaves for compile {
    let alloc = testing::world().alloc
    var noted = Leaves.empty(alloc)
    mut noted.note_copier(1)
    mut noted.note_removable(2)
    var read_body = named_builder(2, params: 1, alloc)
    let read_params = params_of(read_body, alloc)
    expect read_params.len() == 1
    let word = mut read_body.load(clif::Type.Int64, flags: clif::MemFlags.owned(), p: read_params[0], offset: 8)
    mut read_body.ret(one(word, alloc).view())
    mut noted.offer(take read_body.finalize(), alloc)
    var b = builder_of(1, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 1
    let copy_sig = mut b.import_signature(int_signature(3, alloc))
    let copier = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 1), signature: copy_sig, colocated: true))
    let read_sig = mut b.import_signature(int_signature(1, alloc))
    let reader = mut b.import_function(clif::ExtFuncData(name: clif::ExternalName(namespace: 0, index: 2), signature: read_sig, colocated: true))
    let slot = mut b.create_sized_stack_slot(clif::StackSlotData(size: 16, align_shift: 3))
    let place = mut b.stack_addr(clif::Type.Int64, slot, offset: 0)
    let length = mut b.iconst(clif::Type.Int64, imm: 16)
    var args = one(place, alloc)
    mut args.push(params[0])
    mut args.push(length)
    discard mut b.call(copier, args: args.view())
    discard mut b.call(reader, args: one(place, alloc).view())
    mut b.ret(one(params[0], alloc).view())
    let code = compile(take b.finalize(), isa: host_isa(), leaves: noted, alloc)
    expect code.relocs.len() == 0
    expect code.bytes.view() == b"\x55\x48\x89\xe5\x48\x89\xf8\x5d\xc3"
} leaves_out_unread_calls_of_removable_leaves

/// A function looping on itself is not noted removable, and one computing a value is.
test notes_as_removable_only_functions_that_end_and_hide_their_effects for is_left_out_callee {
    let alloc = testing::world().alloc
    var looping = builder_of(1, alloc)
    let spin = mut looping.create_block()
    mut looping.jump(spin, args: no_values(alloc).view())
    mut looping.switch_to_block(spin)
    mut looping.jump(spin, args: no_values(alloc).view())
    mut looping.seal_all_blocks()
    let loops = is_left_out_callee(take looping.finalize(), leaves: Leaves.empty(alloc), alloc)
    expect not loops
    var adding = builder_of(2, alloc)
    let pair = params_of(adding, alloc)
    expect pair.len() == 2
    let sum = mut adding.iadd(pair[0], y: pair[1])
    mut adding.ret(one(sum, alloc).view())
    let adds = is_left_out_callee(take adding.finalize(), leaves: Leaves.empty(alloc), alloc)
    expect adds
} notes_as_removable_only_functions_that_end_and_hide_their_effects

/// The instructions the members of `core::Secret` lower to, over three 64-bit parameters:
/// comparisons, a choice, wrapping and high products, bitwise operations, a rotation by a
/// computed amount, truncation and extensions.
fn secret_operations(alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(3, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 3
    let below = mut b.icmp(clif::IntCC.SignedLessThan, x: params[0], y: params[1])
    let same = mut b.icmp(clif::IntCC.Equal, x: params[0], y: params[2])
    let both = mut b.band(below, y: same)
    let sum = mut b.iadd(params[0], y: params[1])
    let difference = mut b.isub(sum, y: params[2])
    let product = mut b.imul(difference, y: params[1])
    let high = mut b.umulhi(product, y: params[0])
    let signed_high = mut b.smulhi(high, y: params[1])
    let mixed = mut b.bxor(signed_high, y: product)
    let flipped = mut b.bnot(mixed)
    let width = mut b.iconst(clif::Type.Int32, imm: 64)
    let amount = mut b.ireduce(clif::Type.Int32, x: params[2])
    let turn = mut b.isub(width, y: amount)
    let rotated = mut b.rotr(flipped, y: turn)
    let low = mut b.ireduce(clif::Type.Int32, x: rotated)
    let unsigned = mut b.uextend(clif::Type.Int64, x: low)
    let signed = mut b.sextend(clif::Type.Int64, x: low)
    let chosen = mut b.select(both, x: unsigned, y: signed)
    mut b.ret(one(chosen, alloc).view())
    return take b.finalize()
} secret_operations

/// Whether x86-64 code holds a conditional branch or a division.
fn x64_branches_or_divides(vcode: VCode[x64::Inst]) -> bool {
    for held in vcode.insts {
        match held.inst {
            x64::Inst.Jcc(cond: _, label: _) or x64::Inst.Div(signed: _, size: _, divisor: _) or x64::Inst.CheckedSrem(size: _, divisor: _) => return true
            else => {}
        }
    }
    return false
} x64_branches_or_divides

/// Whether AArch64 code holds a conditional branch or a division.
fn arm_branches_or_divides(vcode: VCode[aarch64::Inst]) -> bool {
    for held in vcode.insts {
        match held.inst {
            aarch64::Inst.Bcond(cond: _, label: _) or aarch64::Inst.Cbz(width: _, reg: _, label: _) or aarch64::Inst.Cbnz(width: _, reg: _, label: _) or aarch64::Inst.JumpTable(index: _, base: _, temp: _, table: _) => return true
            aarch64::Inst.Sdiv(width: _, dst: _, lhs: _, rhs: _) or aarch64::Inst.Udiv(width: _, dst: _, lhs: _, rhs: _) => return true
            else => {}
        }
    }
    return false
} arm_branches_or_divides

test selects_secret_operations_without_branches_or_divisions for select {
    let alloc = testing::world().alloc
    let x64_selected = select(secret_operations(alloc), isa: host_isa(), alloc)
    expect x64_selected.blocks.len() == 1
    expect not x64_branches_or_divides(x64_selected)
    let arm_selected = arm_select(secret_operations(alloc), isa: arm_isa(), alloc)
    expect arm_selected.blocks.len() == 1
    expect not arm_branches_or_divides(arm_selected)
} selects_secret_operations_without_branches_or_divisions

/// A function storing at its third parameter the product of the vectors of two 64-bit lanes
/// its first two address.
fn lanes_product(alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(3, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 3
    let a = mut b.load(clif::Type.Int64x2, flags: clif::MemFlags.unaligned(), p: params[0], offset: 0)
    let c = mut b.load(clif::Type.Int64x2, flags: clif::MemFlags.unaligned(), p: params[1], offset: 0)
    let product = mut b.imul(a, y: c)
    mut b.store(clif::MemFlags.unaligned(), x: product, p: params[2], offset: 0)
    mut b.ret(one(params[2], alloc).view())
    return take b.finalize()
} lanes_product

test selects_vector_instructions_of_each_level for compile {
    let alloc = testing::world().alloc
    let base = compile(lanes_product(alloc), isa: host_isa(), leaves: Leaves.empty(alloc), alloc)
    let vex = compile(lanes_product(alloc), isa: Isa(arch: workspace::Arch.Amd64, pic: true, probes: true, level: Some(workspace::Level.X64v3)), leaves: Leaves.empty(alloc), alloc)
    let evex = compile(lanes_product(alloc), isa: Isa(arch: workspace::Arch.Amd64, pic: true, probes: true, level: Some(workspace::Level.X64v4)), leaves: Leaves.empty(alloc), alloc)
    expect holds_vex(base.bytes.view(), opcode: 0xF4) == false and holds_vex(vex.bytes.view(), opcode: 0xF4)
    expect holds_vpmullq(base.bytes.view()) == false and holds_vpmullq(vex.bytes.view()) == false and holds_vpmullq(evex.bytes.view())
    expect evex.bytes.len() < vex.bytes.len()
} selects_vector_instructions_of_each_level

/// Whether code holds a VEX-encoded instruction of the `0F` map with an opcode and the `66`
/// prefix, as `vpmuludq` is.
fn holds_vex(code: Slice[u8], opcode: u8) -> bool {
    for at in 0..<code.len() {
        if at + 3 < code.len() and code[at] == 0xC4 and (code[at + 1] & 0x1F) == 1 and (code[at + 2] & 3) == 1 and code[at + 3] == opcode {
            return true
        }
    }
    return false
} holds_vex

/// Whether code holds `vpmullq` of 128-bit registers below 16, EVEX-encoded.
fn holds_vpmullq(code: Slice[u8]) -> bool {
    for at in 0..<code.len() {
        if at + 4 < code.len() and code[at] == 0x62 and (code[at + 1] & 0x13) == 0x12 and (code[at + 2] & 0x87) == 0x85 and code[at + 3] == 0x08 and code[at + 4] == 0x40 {
            return true
        }
    }
    return false
} holds_vpmullq

/// A function adding to the vector of four 32-bit lanes its third parameter addresses the dot
/// product of the vectors of bytes its first two address, in the form lowering builds it.
fn bytes_dot(alloc: mem::Alloc) -> clif::Function {
    var b = builder_of(3, alloc)
    let params = params_of(b, alloc)
    expect params.len() == 3
    let a = mut b.load(clif::Type.Int8x16, flags: clif::MemFlags.unaligned(), p: params[0], offset: 0)
    let c = mut b.load(clif::Type.Int8x16, flags: clif::MemFlags.unaligned(), p: params[1], offset: 0)
    let acc = mut b.load(clif::Type.Int32x4, flags: clif::MemFlags.unaligned(), p: params[2], offset: 0)
    let low_a = mut b.swiden_low(a)
    let low_c = mut b.swiden_low(c)
    let low = mut b.imul(low_a, y: low_c)
    let high_a = mut b.swiden_high(a)
    let high_c = mut b.swiden_high(c)
    let high = mut b.imul(high_a, y: high_c)
    let low_first = mut b.swiden_low(low)
    let low_second = mut b.swiden_high(low)
    let low_pairs = mut b.iadd_pairwise(low_first, y: low_second)
    let high_first = mut b.swiden_low(high)
    let high_second = mut b.swiden_high(high)
    let high_pairs = mut b.iadd_pairwise(high_first, y: high_second)
    let pairs = mut b.iadd_pairwise(low_pairs, y: high_pairs)
    let sum = mut b.iadd(pairs, y: acc)
    mut b.store(clif::MemFlags.unaligned(), x: sum, p: params[2], offset: 0)
    mut b.ret(one(params[2], alloc).view())
    return take b.finalize()
} bytes_dot

test selects_sdot_for_a_dot_product_at_aarch64_dotprod for compile {
    let alloc = testing::world().alloc
    let base = compile(bytes_dot(alloc), isa: arm_isa(), leaves: Leaves.empty(alloc), alloc)
    let dotprod = compile(bytes_dot(alloc), isa: Isa(arch: workspace::Arch.Aarch64, pic: true, probes: true, level: Some(workspace::Level.Aarch64Dotprod)), leaves: Leaves.empty(alloc), alloc)
    expect holds_sdot(base.bytes.view()) == false and holds_sdot(dotprod.bytes.view())
    expect dotprod.bytes.len() < base.bytes.len()
} selects_sdot_for_a_dot_product_at_aarch64_dotprod

/// Whether AArch64 code holds `sdot` of vector registers.
fn holds_sdot(code: Slice[u8]) -> bool {
    var at: usize = 0
    while at + 3 < code.len() {
        let word = u32.widen(code[at]) | (u32.widen(code[at + 1]) << 8) | (u32.widen(code[at + 2]) << 16) | (u32.widen(code[at + 3]) << 24)
        if (word & 0xFFE0_FC00) == 0x4E80_9400 {
            return true
        }
        at += 4
    }
    return false
} holds_sdot
