//! Entry of the prober, its probes and its status file.

pub closed enum SaveError derives Render {
    Fs(sys::fs::FsError) from
} SaveError

pub closed enum ProbeError derives Render {
    Save(SaveError) from
    Cancelled(task::Cancelled) from
} ProbeError

/// The first port probed and the number of ports probed.
const FIRST_PORT: u16 = 4_300

const SERVICES: u16 = 4

fn main(take world: host::World) fails ProbeError uses wait {
    let up = try await count_up(world.net, start: FIRST_PORT, count: SERVICES)
    world.log.info("services up", up)
    try await record_status(world.fs, up, alloc: world.alloc)
} main

/// Whether a service accepts connections on `port` on `localhost`.
pub fn is_up(net: sys::Net, port: u16) -> bool fails task::Cancelled uses wait {
    match first attempt await net.connect("localhost", port) {
        Ok(_) => return true
        Err(sys::net::NetError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return false
    }
} is_up

/// How many of the `count` ports from `start` have a service accepting connections.
pub fn count_up(net: sys::Net, start: u16, count: u16) -> u16 fails task::Cancelled uses wait {
    var up: u16 = 0
    for port in start..<(start + count) {
        if try is_up(net, port) {
            up += 1
        }
    }
    return up
} count_up

/// Writes `up=`, the count and a line feed to `status.txt`, replacing its contents.
pub fn record_status(fs: sys::Fs, up: u16, alloc: mem::Alloc) fails SaveError uses wait {
    var line = text::String.empty(alloc)
    mut line.write(text::fmt("up={up}\n", up), budget: 32)
    await fs.write_all("status.txt", data: line.as_bytes())
} record_status
