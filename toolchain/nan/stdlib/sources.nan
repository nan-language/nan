    \\pub fn Map.contains(self, key: K) -> bool limits pure, notrap, terminates
    \\    example not Map[u8, u8].empty(testing::world().alloc).contains(1)
    \\{
    \\    return self.get(key).is_some()
    \\} Map.contains
    \\
    \\pub fn Map.insert(mut self, take key: K, take value: V) -> Option[V]
    \\    ensures match result {
    \\        Some(_) => old(self.contains(key)) and self.len() == old(self.len())
    \\        None => not old(self.contains(key)) and self.len() > 0 and self.len() - 1 == old(self.len())
    \\    }
    \\
    \\pub fn Map.try_insert(mut self, take key: K, take value: V) -> Option[V] fails OutOfMemory
    \\    ensures match result {
    \\        Some(_) => old(self.contains(key)) and self.len() == old(self.len())
    \\        None => not old(self.contains(key)) and self.len() > 0 and self.len() - 1 == old(self.len())
    \\    }
    \\
    \\pub fn Map.remove(mut self, key: K) -> Option[V]
    \\    ensures not self.contains(key)
    \\    ensures match result {
    \\        Some(_) => old(self.contains(key)) and old(self.len()) > 0 and self.len() == old(self.len()) - 1
    \\        None => not old(self.contains(key)) and self.len() == old(self.len())
    \\    }
    \\    example Map[u8, u8].empty(testing::world().alloc).remove(1) == None
    \\
