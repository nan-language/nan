//! Place paths: a root local and the fields after it, and when two overlap.

struct Path derives Eq, Hash {
    root: LocalId
    fields: mem::List[text::String]
} Path

impl Path: Ord

fn Path.cmp(self, other: Path) -> core::Ordering {
    let rooted = self.root.cmp(other.root)
    if rooted != core::Ordering.Equal {
        return rooted
    }
    return self.fields.view().cmp(other.fields.view())
} Path.cmp

fn Path.of(root: LocalId, alloc: mem::Alloc) -> Path {
    return Path(root: root, fields: mem::List[text::String].empty(alloc))
} Path.of

fn Path.copy(self, alloc: mem::Alloc) -> Path {
    var fields = mem::List[text::String].empty(alloc)
    for field in self.fields {
        mut fields.push(text::String.of(field.as_str(), alloc))
    }
    return Path(root: self.root, fields: take fields)
} Path.copy

fn Path.field(self, name: Str, alloc: mem::Alloc) -> Path {
    var extended = self.copy(alloc)
    mut extended.fields.push(text::String.of(name, alloc))
    return extended
} Path.field

/// The path extended by a field.
fn Path.into_field(take self, name: Str, alloc: mem::Alloc) -> Path {
    mut self.fields.push(text::String.of(name, alloc))
    return self
} Path.into_field

/// Whether this path is `prefix` or extends it.
fn Path.starts_with(self, prefix: Path) -> bool {
    if self.root != prefix.root or self.fields.len() < prefix.fields.len() {
        return false
    }
    for index in 0..<prefix.fields.len() {
        if self.fields[index].as_str() != prefix.fields[index].as_str() {
            return false
        }
    }
    return true
} Path.starts_with

/// Whether one of two paths extends the other.
fn Path.overlaps(self, other: Path) -> bool {
    return self.starts_with(other) or other.starts_with(self)
} Path.overlaps

/// The path as source writes it, its root named `root`.
fn Path.written(self, root: Str, alloc: mem::Alloc) -> text::String {
    var written = text::String.of(root, alloc)
    for field in self.fields {
        mut written.push('.')
        mut written.append(field.as_str())
    }
    return written
} Path.written
