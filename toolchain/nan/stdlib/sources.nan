    \\
    \\pub fn Set.empty(alloc: Alloc) -> Set[T]
    \\    ensures result.len() == 0
    \\    example Set[u8].empty(testing::world().alloc).len() == 0
    \\
    \\pub fn Set.len(self) -> usize limits pure, notrap, terminates
