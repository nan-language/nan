    \\    example (~0u64).wide_mul(2) == WideProduct(high: 1, low: ~1u64)
    \\    example (~0u64).wide_mul(~0u64) == WideProduct(high: ~1u64, low: 1)
    \\
    \\pub fn i64.wide_mul(self, other: i64) -> WideProduct[i64] limits pure, notrap, terminates
    \\    example (-1i64).wide_mul(1) == WideProduct(high: -1, low: ~0u64)
    \\
    \\pub fn f64.abs(self) -> f64 limits pure, notrap, terminates
    \\    example (-2.5f64).abs() == 2.5
    \\{
    \\    return f64.from_bits(self.to_bits() & ~(1u64 << 63))
    \\} f64.abs
    \\
    \\pub fn f64.sqrt(self) -> f64 limits pure, notrap, terminates
    \\    example 2.25f64.sqrt() == 1.5
    \\
    \\pub fn f64.fused_mul_add(self, factor: f64, addend: f64) -> f64 limits pure, notrap, terminates
    \\    example 2.0f64.fused_mul_add(3.0, addend: 1.0) == 7.0
    \\
    \\pub fn f64.is_nan(self) -> bool limits pure, notrap, terminates
    \\    example (0.0f64 / 0.0).is_nan()
    \\{
    \\    return self != self
    \\} f64.is_nan
    \\
    \\pub fn f64.total_cmp(self, other: f64) -> Ordering limits pure, notrap, terminates
    \\    example (-0.0f64).total_cmp(0.0) == Ordering.Less
    \\{
    \\    return total_key_u64(self.to_bits()).cmp(total_key_u64(other.to_bits()))
    \\} f64.total_cmp
    \\
    \\fn total_key_u64(bits: u64) -> u64 limits pure, notrap, terminates {
    \\    if (bits & (1u64 << 63)) == 0 {
    \\        return bits | (1u64 << 63)
    \\    }
    \\    return ~bits
    \\} total_key_u64
    \\
    \\pub fn f32.abs(self) -> f32 limits pure, notrap, terminates
    \\    example (-2.5f32).abs() == 2.5
    \\{
    \\    return f32.from_bits(self.to_bits() & ~(1u32 << 31))
    \\} f32.abs
    \\
    \\pub fn f32.sqrt(self) -> f32 limits pure, notrap, terminates
    \\    example 2.25f32.sqrt() == 1.5
    \\
    \\pub fn f32.fused_mul_add(self, factor: f32, addend: f32) -> f32 limits pure, notrap, terminates
    \\    example 2.0f32.fused_mul_add(3.0, addend: 1.0) == 7.0
    \\
    \\pub fn f32.is_nan(self) -> bool limits pure, notrap, terminates
    \\    example (0.0f32 / 0.0).is_nan()
    \\{
    \\    return self != self
    \\} f32.is_nan
    \\
    \\pub fn f32.total_cmp(self, other: f32) -> Ordering limits pure, notrap, terminates
    \\    example (-0.0f32).total_cmp(0.0) == Ordering.Less
    \\{
    \\    return total_key_u32(self.to_bits()).cmp(total_key_u32(other.to_bits()))
    \\} f32.total_cmp
    \\
    \\fn total_key_u32(bits: u32) -> u32 limits pure, notrap, terminates {
    \\    if (bits & (1u32 << 31)) == 0 {
    \\        return bits | (1u32 << 31)
    \\    }
    \\    return ~bits
    \\} total_key_u32
    \\
    \\pub closed struct TotalF64 derives Copy {
    \\    pub value: f64
    \\} TotalF64
    \\
    \\impl TotalF64: Eq
    \\
    \\impl TotalF64: Ord
    \\
    \\impl TotalF64: Hash
    \\
    \\pub fn TotalF64.eq(self, other: TotalF64) -> bool limits pure, notrap, terminates
    \\    ensures result == (self.value.to_bits() == other.value.to_bits())
    \\    example not TotalF64(value: -0.0).eq(TotalF64(value: 0.0))
    \\{
    \\    return self.value.to_bits() == other.value.to_bits()
    \\} TotalF64.eq
    \\
    \\pub fn TotalF64.cmp(self, other: TotalF64) -> Ordering limits pure, notrap, terminates
    \\    ensures result == self.value.total_cmp(other.value)
    \\    example TotalF64(value: 1.0).cmp(TotalF64(value: 2.0)) == Ordering.Less
    \\
    \\pub fn TotalF64.hash[H: Hasher](self, mut hasher: H) limits pure, notrap, terminates {
    \\    self.value.to_bits().hash(mut hasher)
    \\} TotalF64.hash
    \\
    \\pub closed struct TotalF32 derives Copy {
    \\    pub value: f32
    \\} TotalF32
    \\
    \\impl TotalF32: Eq
    \\
    \\impl TotalF32: Ord
    \\
    \\impl TotalF32: Hash
    \\
    \\pub fn TotalF32.eq(self, other: TotalF32) -> bool limits pure, notrap, terminates
    \\    ensures result == (self.value.to_bits() == other.value.to_bits())
    \\    example not TotalF32(value: -0.0).eq(TotalF32(value: 0.0))
    \\{
    \\    return self.value.to_bits() == other.value.to_bits()
    \\} TotalF32.eq
    \\
    \\pub fn TotalF32.cmp(self, other: TotalF32) -> Ordering limits pure, notrap, terminates
    \\    ensures result == self.value.total_cmp(other.value)
    \\    example TotalF32(value: 1.0).cmp(TotalF32(value: 2.0)) == Ordering.Less
    \\
    \\pub fn TotalF32.hash[H: Hasher](self, mut hasher: H) limits pure, notrap, terminates {
    \\    self.value.to_bits().hash(mut hasher)
    \\} TotalF32.hash
    \\
    \\struct ByteSum {
    \\    total: u64
    \\} ByteSum
    \\
    \\impl ByteSum: Hasher
    \\
    \\fn ByteSum.write(mut self, bytes: Slice[u8]) limits pure, notrap, terminates {
    \\    for byte in bytes {
    \\        self.total = self.total.wrapping_add(u64.widen(byte))
    \\    }
    \\} ByteSum.write
    \\
    \\test total_f64_hash_writes_the_bits for TotalF64.hash {
    \\    var sum = ByteSum(total: 0)
    \\    TotalF64(value: -0.0).hash(mut sum)
    \\    expect sum.total == 0x80
    \\} total_f64_hash_writes_the_bits
    \\
    \\test total_f32_hash_writes_the_bits for TotalF32.hash {
    \\    var sum = ByteSum(total: 0)
    \\    TotalF32(value: -0.0).hash(mut sum)
    \\    expect sum.total == 0x80
    \\} total_f32_hash_writes_the_bits
    \\

const TEXT_CORE_PACKAGE: Str =
    \\//! Scalars, options and results, arrays, slices, text views, ranges, cursors, Untrusted and Secret values and the core interfaces.
    \\
    \\package core {
    \\    language 1
    \\    targets any
    \\} core
    \\

const TEXT_CORE_RENDER: Str =
    \\//! Rendering values as text within a render budget.
    \\
    \\pub interface Render {
    \\    fn render(self, mut out: Renderer) limits pure, terminates
    \\} Render
    \\
    \\pub open view struct Renderer {
    \\} Renderer
    \\
    \\pub fn Renderer.write(mut self, text: Str) limits pure, notrap, terminates
    \\
    \\pub fn Renderer.write_char(mut self, c: char) limits pure, notrap, terminates
    \\
    \\pub fn Renderer.remaining(self) -> usize limits pure, notrap, terminates
    \\
    \\pub fn Renderer.is_elided(self) -> bool limits pure, notrap, terminates
    \\
    \\pub fn Renderer.write_nested[T: Render](mut self, value: T) limits pure, terminates
    \\
    \\view struct Sample {
    \\    text: Str
    \\} Sample
    \\
    \\impl Sample: Render
    \\
    \\fn Sample.render(self, mut out: Renderer) limits pure, terminates {
    \\    mut out.write(self.text)
    \\    if not out.is_elided() {
    \\        mut out.write_char('!')
    \\    }
    \\    if out.remaining() > 2 {
    \\        mut out.write("+")
    \\    }
    \\} Sample.render
    \\
    \\test write_appends_text for Renderer.write {
    \\    let world = testing::world()
    \\    var out = text::String.empty(world.alloc)
    \\    mut out.write(text::fmt("{sample}", sample: Sample(text: "ab")), budget: 64)
    \\    expect out.as_str() == "ab!+"
    \\} write_appends_text
    \\
    \\test write_char_appends_its_encoding for Renderer.write_char {
    \\    let world = testing::world()
    \\    var out = text::String.empty(world.alloc)
    \\    mut out.write(text::fmt("{sample}", sample: Sample(text: "é")), budget: 64)
    \\    expect out.as_str() == "é!+"
    \\} write_char_appends_its_encoding
    \\
    \\test remaining_counts_down_the_budget for Renderer.remaining {
    \\    let world = testing::world()
    \\    var out = text::String.empty(world.alloc)
    \\    mut out.write(text::fmt("{sample}", sample: Sample(text: "ab")), budget: 5)
    \\    expect out.as_str() == "ab!"
    \\} remaining_counts_down_the_budget
    \\
    \\test a_rendering_filling_its_budget_is_not_elided for Renderer.is_elided {
    \\    let world = testing::world()
    \\    var out = text::String.empty(world.alloc)
    \\    mut out.write(text::fmt("{sample}", sample: Sample(text: "abc")), budget: 3)
    \\    expect out.as_str() == "..."
    \\} a_rendering_filling_its_budget_is_not_elided
    \\
    \\view struct Quoted {
    \\    text: Str
    \\} Quoted
    \\
    \\impl Quoted: Render
    \\
    \\fn Quoted.render(self, mut out: Renderer) limits pure, terminates {
    \\    mut out.write_nested(self.text)
    \\    mut out.write(" ")
    \\    mut out.write_nested(Some('\\''))
    \\} Quoted.render
    \\
    \\test write_nested_writes_literals for Renderer.write_nested {
    \\    let world = testing::world()
    \\    var out = text::String.empty(world.alloc)
    \\    mut out.write(text::fmt("{quoted}", quoted: Quoted(text: "a\\"b\\u{200B}")), budget: 64)
    \\    expect out.as_str() == "\\"a\\\\\\"b\\\\u{200B}\\" Some('\\\\'')"
    \\} write_nested_writes_literals
    \\

const TEXT_CORE_SECRET: Str =
    \\//! Secret values and their constant-time operations.
    \\
    \\pub interface SecretBits {
    \\} SecretBits
    \\
    \\pub open struct Secret[T: SecretBits] {
    \\} Secret
    \\
    \\pub fn Secret.of(value: T) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(7u8).reveal() == 7
    \\
    \\pub fn Secret.reveal(self) -> T limits pure, notrap, terminates
    \\    example Secret.of(true).reveal()
    \\
    \\pub fn Secret.wrapping_add(self, other: Secret[T]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(~0u8).wrapping_add(Secret.of(2)).reveal() == 1
    \\
    \\pub fn Secret.wrapping_sub(self, other: Secret[T]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(0u8).wrapping_sub(Secret.of(1)).reveal() == ~0u8
    \\
    \\pub fn Secret.wrapping_mul(self, other: Secret[T]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(-128i8).wrapping_mul(Secret.of(3)).reveal() == -128
    \\
    \\pub fn Secret.mul_high(self, other: Secret[T]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(~0u64).mul_high(Secret.of(2)).reveal() == 1
    \\    example Secret.of(-1i64).mul_high(Secret.of(1)).reveal() == -1
    \\
    \\pub fn Secret.bit_and(self, other: Secret[T]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(0b1100u8).bit_and(Secret.of(0b1010)).reveal() == 0b1000
    \\
    \\pub fn Secret.bit_or(self, other: Secret[T]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(0b1100u8).bit_or(Secret.of(0b1010)).reveal() == 0b1110
    \\
    \\pub fn Secret.bit_xor(self, other: Secret[T]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(true).bit_xor(Secret.of(true)).reveal() == false
    \\
    \\pub fn Secret.bit_not(self) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(0b1100u8).bit_not().reveal() == 0b1111_0011
    \\    example Secret.of(true).bit_not().reveal() == false
    \\
    \\pub fn Secret.shl(self, amount: u32) -> Secret[T] limits pure, terminates
    \\    example Secret.of(0b11u8).shl(7).reveal() == 0b1000_0000
    \\
    \\pub fn Secret.shr(self, amount: u32) -> Secret[T] limits pure, terminates
    \\    example Secret.of(0x80u8).shr(7).reveal() == 1
    \\    example Secret.of(-8i32).shr(1).reveal() == -4
    \\
    \\pub fn Secret.rotate_left(self, amount: u32) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(0x81u8).rotate_left(9).reveal() == 0x03
    \\
    \\pub fn Secret.rotate_right(self, amount: u32) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret.of(0x81u8).rotate_right(1).reveal() == 0xC0
    \\
    \\pub fn Secret.eq(self, other: Secret[T]) -> Secret[bool] limits pure, notrap, terminates
    \\    example Secret.of(3u32).eq(Secret.of(3)).reveal()
    \\
    \\pub fn Secret.ne(self, other: Secret[T]) -> Secret[bool] limits pure, notrap, terminates
    \\    example Secret.of(3u32).ne(Secret.of(4)).reveal()
    \\
    \\pub fn Secret.lt(self, other: Secret[T]) -> Secret[bool] limits pure, notrap, terminates
    \\    example Secret.of(-1i8).lt(Secret.of(0)).reveal()
    \\
    \\pub fn Secret.le(self, other: Secret[T]) -> Secret[bool] limits pure, notrap, terminates
    \\    example Secret.of(0u8).le(Secret.of(0)).reveal()
    \\
    \\pub fn Secret.gt(self, other: Secret[T]) -> Secret[bool] limits pure, notrap, terminates
    \\    example Secret.of(~0u8).gt(Secret.of(0)).reveal()
    \\
    \\pub fn Secret.ge(self, other: Secret[T]) -> Secret[bool] limits pure, notrap, terminates
    \\    example not Secret.of(-1i64).ge(Secret.of(0)).reveal()
    \\
    \\pub fn Secret.select[V: SecretBits](self, if_true: Secret[V], if_false: Secret[V]) -> Secret[V] limits pure, notrap, terminates
    \\    example Secret.of(false).select(Secret.of(1u64), if_false: Secret.of(2)).reveal() == 2
    \\
    \\pub fn Secret.widen[S: SecretBits](value: Secret[S]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret[i64].widen(Secret.of(-1i32)).reveal() == -1
    \\
    \\pub fn Secret.truncate[S: SecretBits](value: Secret[S]) -> Secret[T] limits pure, notrap, terminates
    \\    example Secret[u8].truncate(Secret.of(0x1234u32)).reveal() == 0x34
    \\
    \\pub fn Secret.equal(a: Slice[Secret[T]], b: Slice[Secret[T]]) -> Secret[bool] limits pure, terminates
    \\    requires a.len() == b.len()
    \\{
    \\    var same = Secret.of(true)
    \\    for index in 0..<a.len() {
    \\        same = same.bit_and(a[index].eq(b[index]))
    \\    }
    \\    return same
    \\} Secret.equal
    \\
    \\pub fn Secret.copy_if(mut target: SliceMut[Secret[T]], source: Slice[Secret[T]], choice: Secret[bool]) limits pure, terminates
    \\    requires target.len() == source.len()
    \\{
    \\    for index in 0..<target.len() {
    \\        target[index] = choice.select(source[index], if_false: target[index])
    \\    }
    \\} Secret.copy_if
    \\
    \\test equal_compares_every_element for Secret.equal {
    \\    var a = Array[Secret[u8], 3].filled(Secret.of(5))
    \\    let b = Array[Secret[u8], 3].filled(Secret.of(5))
    \\    expect Secret.equal(a.view(), b: b.view()).reveal()
    \\    a[2] = Secret.of(6)
    \\    expect not Secret.equal(a.view(), b: b.view()).reveal()
    \\} equal_compares_every_element
    \\
    \\test copy_if_copies_only_when_chosen for Secret.copy_if {
    \\    var target = Array[Secret[u16], 2].filled(Secret.of(1))
    \\    let source = Array[Secret[u16], 2].filled(Secret.of(9))
    \\    Secret.copy_if(mut target.view_mut(), source: source.view(), choice: Secret.of(false))
    \\    expect target[1].reveal() == 1
    \\    Secret.copy_if(mut target.view_mut(), source: source.view(), choice: Secret.of(true))
    \\    expect target[1].reveal() == 9
    \\} copy_if_copies_only_when_chosen
    \\
    \\test integer_members_wrap_and_shift_by_width for Secret.mul_high {
    \\    expect Secret.of(~0u8).wrapping_add(Secret.of(2)).reveal() == 1
    \\    expect Secret.of(5i16).wrapping_sub(Secret.of(7)).reveal() == -2
    \\    expect Secret.of(0x8000_0000u32).wrapping_mul(Secret.of(2)).reveal() == 0
    \\    expect Secret.of(~0u64).mul_high(Secret.of(~0u64)).reveal() == ~1u64
    \\    expect Secret.of(-3i64).mul_high(Secret.of(5)).reveal() == -1
    \\    expect Secret.of(-8i32).shr(1).reveal() == -4
    \\    expect Secret.of(0x8000_0000u32).shr(31).reveal() == 1
    \\    expect Secret.of(1i8).shl(7).reveal() == -128
    \\    expect Secret.of(0x8000_0001u32).rotate_left(1).reveal() == 3
    \\    expect Secret.of(1u16).rotate_right(17).reveal() == 0x8000
    \\} integer_members_wrap_and_shift_by_width
    \\
    \\test comparisons_and_choices_follow_the_type for Secret.select {
    \\    expect Secret.of(-1i32).lt(Secret.of(1)).reveal()
    \\    expect not Secret.of(~0u32).lt(Secret.of(1)).reveal()
    \\    expect Secret.of(true).bit_not().select(Secret.of(1i8), if_false: Secret.of(-1)).reveal() == -1
    \\    expect Secret[i64].widen(Secret.of(-2i8)).reveal() == -2
    \\    expect Secret[u64].widen(Secret.of(0xFFu8)).reveal() == 0xFF
    \\    expect Secret[i8].truncate(Secret.of(0x1FFu64)).reveal() == -1
    \\} comparisons_and_choices_follow_the_type
    \\

const TEXT_CORE_SEQUENCES: Str =
    \\//! Arrays, slices, their cursors and ranges.
    \\
    \\pub open struct Array[T: Any, N: usize] {
    \\} Array
    \\
    \\pub open view struct Slice[T: Any] {
    \\} Slice
    \\
    \\pub open view struct SliceMut[T: Any] {
    \\} SliceMut
    \\
    \\pub fn Array.len(self) -> usize = N
    \\
    \\pub fn Array.filled(value: T) -> Array[T, N] limits pure, notrap, terminates
    \\    example Array[u8, 3].filled(7)[2] == 7
    \\
    \\pub proj fn Array.at(self, i: usize) -> T limits pure, notrap, terminates
    \\    example Array[u8, 2].filled(5).at(1) == 5
    \\
    \\pub proj fn Array.at_mut(mut self, i: usize) -> T limits pure, notrap, terminates
    \\    example Array[u8, 2].filled(5).at_mut(1) == 5
    \\
    \\pub proj fn Array.view(self) -> Slice[T] limits pure, notrap, terminates
    \\    ensures result.len() == N
    \\    example Array[u8, 3].filled(0).view().len() == 3
    \\
    \\pub proj fn Array.view_mut(mut self) -> SliceMut[T] limits pure, notrap, terminates
    \\    ensures result.len() == N
    \\    example Array[u8, 3].filled(0).view_mut().len() == 3
    \\
    \\pub proj fn Array.cursor(self) -> SliceCursor[T] limits pure, notrap, terminates
    \\
    \\pub proj fn Array.cursor_mut(mut self) -> SliceCursorMut[T] limits pure, notrap, terminates
    \\
    \\pub fn Array.into_cursor(take self) -> ArrayCursor[T, N] limits pure, notrap, terminates
    \\
    \\pub fn Slice.len(self) -> usize limits pure, notrap, terminates
    \\    example b"abc".len() == 3
    \\
    \\pub fn Slice.is_empty(self) -> bool = self.len() == 0
    \\
    \\pub proj fn Slice.at(self, i: usize) -> T limits pure, notrap, terminates
    \\    example b"ab".at(1) == b'b'
    \\
    \\pub proj fn Slice.prefix(self, count: usize) -> Option[Slice[T]] limits pure, notrap, terminates
    \\    ensures match result {
    \\        Some(head) => count <= self.len() and head.len() == count
    \\        None => count > self.len()
    \\    }
    \\    example b"abc".prefix(2) == Some(b"ab")
    \\
    \\pub proj fn Slice.split_at(self, at: usize) -> Option[core::Parts[Slice[T]]] limits pure, notrap, terminates
    \\    ensures match result {
    \\        Some(parts) => at <= self.len() and parts.head.len() == at and parts.tail.len() == self.len() - at
    \\        None => at > self.len()
    \\    }
    \\    example b"abc".split_at(4).is_none()
    \\
    \\pub proj fn Slice.cursor(self) -> SliceCursor[T] limits pure, notrap, terminates
    \\
    \\pub fn Slice.u16_le(self, at: usize) -> u16 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 2
    \\    example b"\\x34\\x12".u16_le(0) == 0x1234
    \\
    \\pub fn Slice.u32_le(self, at: usize) -> u32 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 4
    \\    example b"\\x78\\x56\\x34\\x12".u32_le(0) == 0x1234_5678
    \\
    \\pub fn Slice.u64_le(self, at: usize) -> u64 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 8
    \\    example b"\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x02".u64_le(0) == 0x0200_0000_0000_0001
    \\
    \\pub fn Slice.u16_be(self, at: usize) -> u16 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 2
    \\    example b"\\x12\\x34".u16_be(0) == 0x1234
    \\
    \\pub fn Slice.u32_be(self, at: usize) -> u32 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 4
    \\    example b"\\x12\\x34\\x56\\x78".u32_be(0) == 0x1234_5678
    \\
    \\pub fn Slice.u64_be(self, at: usize) -> u64 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 8
    \\    example b"\\x02\\x00\\x00\\x00\\x00\\x00\\x00\\x01".u64_be(0) == 0x0200_0000_0000_0001
    \\
    \\pub fn SliceMut.len(self) -> usize limits pure, notrap, terminates
    \\    example Array[u8, 3].filled(0).view_mut().len() == 3
    \\
    \\pub fn SliceMut.is_empty(self) -> bool = self.len() == 0
    \\
    \\pub proj fn SliceMut.at(self, i: usize) -> T limits pure, notrap, terminates
    \\    example Array[u8, 2].filled(5).view_mut().at(0) == 5
    \\
    \\pub proj fn SliceMut.at_mut(mut self, i: usize) -> T limits pure, notrap, terminates
    \\
    \\pub proj fn SliceMut.view(self) -> Slice[T] limits pure, notrap, terminates
    \\    ensures result.len() == self.len()
    \\    example Array[u8, 2].filled(5).view_mut().view().len() == 2
    \\
    \\pub proj fn SliceMut.prefix_mut(mut self, count: usize) -> Option[SliceMut[T]] limits pure, notrap, terminates
    \\    ensures match result {
    \\        Some(head) => count <= self.len() and head.len() == count
    \\        None => count > self.len()
    \\    }
    \\
    \\pub proj fn SliceMut.split_at_mut(mut self, at: usize) -> Option[core::Parts[SliceMut[T]]] limits pure, notrap, terminates
    \\    ensures match result {
    \\        Some(parts) => at <= self.len() and parts.head.len() == at and parts.tail.len() == self.len() - at
    \\        None => at > self.len()
    \\    }
    \\
    \\pub proj fn SliceMut.cursor(self) -> SliceCursor[T] limits pure, notrap, terminates
    \\
    \\pub proj fn SliceMut.cursor_mut(mut self) -> SliceCursorMut[T] limits pure, notrap, terminates
    \\
    \\pub fn SliceMut.fill(mut self, value: T) limits notrap, terminates
    \\
    \\pub fn SliceMut.copy_from(mut self, source: Slice[T]) limits notrap, terminates
    \\    requires source.len() == self.len()
    \\
    \\pub fn SliceMut.u16_le(self, at: usize) -> u16 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 2
    \\    example Array[u8, 2].filled(1).view_mut().u16_le(0) == 0x0101
    \\
    \\pub fn SliceMut.u32_le(self, at: usize) -> u32 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 4
    \\    example Array[u8, 4].filled(1).view_mut().u32_le(0) == 0x0101_0101
    \\
    \\pub fn SliceMut.u64_le(self, at: usize) -> u64 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 8
    \\    example Array[u8, 8].filled(1).view_mut().u64_le(0) == 0x0101_0101_0101_0101
    \\
    \\pub fn SliceMut.u16_be(self, at: usize) -> u16 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 2
    \\    example Array[u8, 2].filled(2).view_mut().u16_be(0) == 0x0202
    \\
    \\pub fn SliceMut.u32_be(self, at: usize) -> u32 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 4
    \\    example Array[u8, 4].filled(2).view_mut().u32_be(0) == 0x0202_0202
    \\
    \\pub fn SliceMut.u64_be(self, at: usize) -> u64 limits pure, notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 8
    \\    example Array[u8, 8].filled(2).view_mut().u64_be(0) == 0x0202_0202_0202_0202
    \\
    \\pub fn SliceMut.write_u16_le(mut self, at: usize, value: u16) limits notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 2
    \\
    \\pub fn SliceMut.write_u32_le(mut self, at: usize, value: u32) limits notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 4
    \\
    \\pub fn SliceMut.write_u64_le(mut self, at: usize, value: u64) limits notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 8
    \\
    \\pub fn SliceMut.write_u16_be(mut self, at: usize, value: u16) limits notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 2
    \\
    \\pub fn SliceMut.write_u32_be(mut self, at: usize, value: u32) limits notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 4
    \\
    \\pub fn SliceMut.write_u64_be(mut self, at: usize, value: u64) limits notrap, terminates
    \\    requires at <= self.len() and self.len() - at >= 8
    \\
    \\pub interface Cursor[T: Any] {
    \\    proj fn next(mut self) -> Option[T]
    \\} Cursor
    \\
    \\pub open view struct SliceCursor[T: Any] {
    \\} SliceCursor
    \\
    \\impl SliceCursor: Cursor[T]
    \\
    \\pub proj fn SliceCursor.next(mut self) -> Option[T] limits pure, notrap, terminates
    \\
    \\pub open view struct SliceCursorMut[T: Any] {
    \\} SliceCursorMut
    \\
    \\impl SliceCursorMut: Cursor[T]
    \\
    \\pub proj fn SliceCursorMut.next(mut self) -> Option[T] limits pure, notrap, terminates
    \\
    \\pub open struct ArrayCursor[T: Any, N: usize] {
    \\} ArrayCursor
    \\
    \\impl ArrayCursor[T, N]: Cursor[T]
    \\
    \\pub fn ArrayCursor.next(mut self) -> Option[T] limits pure, notrap, terminates
    \\
    \\pub closed struct Range[T: Copy and Ord] derives Copy, Eq {
    \\    pub low: T
    \\    pub high: T
    \\    pub inclusive: bool
    \\} Range
    \\
    \\pub fn Range.contains(self, value: T) -> bool limits pure, notrap, terminates
    \\    ensures result == (self.low <= value and (value < self.high or (self.inclusive and value <= self.high)))
    \\    example (0u8..<3).contains(2)
    \\{
    \\    if not (self.low <= value) {
    \\        return false
    \\    }
    \\    if value < self.high {
    \\        return true
    \\    }
    \\    if not self.inclusive {
    \\        return false
    \\    }
    \\    if value <= self.high {
    \\        return true
    \\    }
    \\    return false
    \\} Range.contains
    \\
    \\pub fn Range.is_empty(self) -> bool limits pure, notrap, terminates
    \\    ensures result == (self.high < self.low or (not self.inclusive and self.high <= self.low))
    \\    example (3u8..<3).is_empty()
    \\{
    \\    if self.high < self.low {
    \\        return true
    \\    }
    \\    if self.inclusive {
    \\        return false
    \\    }
    \\    if self.high <= self.low {
    \\        return true
    \\    }
    \\    return false
    \\} Range.is_empty
    \\
    \\pub fn Range.next(mut self) -> Option[T] limits pure, notrap, terminates
    \\    example (1u8..=2).next() == Some(1)
    \\
    \\test empty_slice_is_empty for Slice.is_empty {
    \\    expect b"".is_empty()
    \\    expect not b"a".is_empty()
    \\} empty_slice_is_empty
    \\
    \\test array_len_is_its_parameter for Array.len {
    \\    expect Array[u8, 4].filled(0).len() == 4
    \\} array_len_is_its_parameter
    \\
    \\test empty_view_mut_is_empty for SliceMut.is_empty {
    \\    var bytes = Array[u8, 1].filled(0)
    \\    let view = mut bytes.view_mut()
    \\    expect not view.is_empty()
    \\} empty_view_mut_is_empty
    \\
    \\test fill_writes_every_element for SliceMut.fill {
    \\    var bytes = Array[u8, 3].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    mut view.fill(9)
    \\    expect bytes == Array[u8, 3].filled(9)
    \\} fill_writes_every_element
    \\
    \\test copy_from_copies_in_order for SliceMut.copy_from {
    \\    var bytes = Array[u8, 2].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    mut view.copy_from(b"xy")
    \\    expect bytes[0] == b'x'
    \\    expect bytes[1] == b'y'
    \\} copy_from_copies_in_order
    \\
    \\test write_u16_le_stores_low_byte_first for SliceMut.write_u16_le {
    \\    var bytes = Array[u8, 2].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    mut view.write_u16_le(0, value: 0x1234)
    \\    expect bytes[0] == 0x34
    \\} write_u16_le_stores_low_byte_first
    \\
    \\test write_u32_le_stores_low_byte_first for SliceMut.write_u32_le {
    \\    var bytes = Array[u8, 4].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    mut view.write_u32_le(0, value: 0x1234_5678)
    \\    expect bytes[0] == 0x78
    \\} write_u32_le_stores_low_byte_first
    \\
    \\test write_u64_le_stores_low_byte_first for SliceMut.write_u64_le {
    \\    var bytes = Array[u8, 8].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    mut view.write_u64_le(0, value: 0x0102_0304_0506_0708)
    \\    expect bytes[0] == 0x08
    \\} write_u64_le_stores_low_byte_first
    \\
    \\test write_u16_be_stores_high_byte_first for SliceMut.write_u16_be {
    \\    var bytes = Array[u8, 2].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    mut view.write_u16_be(0, value: 0x1234)
    \\    expect bytes[0] == 0x12
    \\} write_u16_be_stores_high_byte_first
    \\
    \\test write_u32_be_stores_high_byte_first for SliceMut.write_u32_be {
    \\    var bytes = Array[u8, 4].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    mut view.write_u32_be(0, value: 0x1234_5678)
    \\    expect bytes[0] == 0x12
    \\} write_u32_be_stores_high_byte_first
    \\
    \\test write_u64_be_stores_high_byte_first for SliceMut.write_u64_be {
    \\    var bytes = Array[u8, 8].filled(0)
    \\    var view = mut bytes.view_mut()
    \\    mut view.write_u64_be(0, value: 0x0102_0304_0506_0708)
    \\    expect bytes[0] == 0x01
    \\} write_u64_be_stores_high_byte_first
    \\
    \\test slice_cursor_yields_in_index_order for Slice.cursor {
    \\    var total: u32 = 0
    \\    for byte in b"ab" {
    \\        total = total * 256 + u32.widen(byte)
    \\    }
    \\    expect total == 0x6162
    \\} slice_cursor_yields_in_index_order
    \\
    \\test slice_cursor_next_ends_with_none for SliceCursor.next {
    \\    var cursor = b"a".cursor()
    \\    let earlier = mut cursor.next()
    \\    let later = mut cursor.next()
    \\    expect earlier == Some(b'a')
    \\    expect later == None
    \\} slice_cursor_next_ends_with_none
    \\
    \\test array_cursor_reads_elements for Array.cursor {
    \\    var total: u32 = 0
    \\    for value in Array[u8, 3].filled(2) {
    \\        total += u32.widen(value)
    \\    }
    \\    expect total == 6
    \\} array_cursor_reads_elements
    \\
    \\test array_cursor_mut_writes_elements for Array.cursor_mut {
    \\    var values = Array[u8, 3].filled(2)
    \\    for value in mut values {
    \\        value = 7
    \\    }
    \\    expect values == Array[u8, 3].filled(7)
    \\} array_cursor_mut_writes_elements
    \\
    \\test slice_cursor_mut_next_yields_writable_elements for SliceCursorMut.next {
    \\    var values = Array[u8, 2].filled(0)
    \\    for value in mut values {
    \\        value = 9
    \\    }
    \\    expect values[0] == 9
    \\} slice_cursor_mut_next_yields_writable_elements
    \\
    \\test array_into_cursor_owns_elements for Array.into_cursor {
    \\    var total: u32 = 0
    \\    for value in take Array[u8, 2].filled(4) {
    \\        total += u32.widen(value)
    \\    }
    \\    expect total == 8
    \\} array_into_cursor_owns_elements
    \\
    \\test array_cursor_next_ends_with_none for ArrayCursor.next {
    \\    var cursor = Array[u8, 1].filled(4).into_cursor()
    \\    let earlier = mut cursor.next()
    \\    let later = mut cursor.next()
    \\    expect earlier == Some(4)
    \\    expect later == None
    \\} array_cursor_next_ends_with_none
    \\
    \\fn store_three(mut slot: u8) {
    \\    slot = 3
    \\} store_three
    \\
    \\test slice_mut_at_mut_writes_element for SliceMut.at_mut {
    \\    var values = Array[u8, 2].filled(0)
    \\    var view = mut values.view_mut()
    \\    store_three(mut view.at_mut(1))
    \\    expect values[1] == 3
    \\} slice_mut_at_mut_writes_element
    \\
    \\test prefix_mut_keeps_leading_elements for SliceMut.prefix_mut {
    \\    var values = Array[u8, 3].filled(0)
    \\    var view = mut values.view_mut()
    \\    let Some(head) = mut view.prefix_mut(2) else {
    \\        return
    \\    }
    \\    expect head.len() == 2
    \\} prefix_mut_keeps_leading_elements
    \\
    \\test split_at_mut_divides_the_view for SliceMut.split_at_mut {
    \\    var values = Array[u8, 3].filled(0)
    \\    var view = mut values.view_mut()
    \\    let Some(parts) = mut view.split_at_mut(1) else {
    \\        return
    \\    }
    \\    expect parts.tail.len() == 2
    \\} split_at_mut_divides_the_view
    \\
    \\test slice_mut_cursor_reads_elements for SliceMut.cursor {
    \\    var values = Array[u8, 2].filled(3)
    \\    let view = mut values.view_mut()
    \\    var total: u32 = 0
    \\    for value in view {
    \\        total += u32.widen(value)
    \\    }
    \\    expect total == 6
    \\} slice_mut_cursor_reads_elements
    \\
    \\test slice_mut_cursor_mut_writes_elements for SliceMut.cursor_mut {
    \\    var values = Array[u8, 2].filled(3)
    \\    var view = mut values.view_mut()
    \\    for value in mut view {
    \\        value = 1
    \\    }
    \\    expect values == Array[u8, 2].filled(1)
    \\} slice_mut_cursor_mut_writes_elements
    \\
    \\test range_next_steps_through_values for Range.next {
    \\    var total: u32 = 0
    \\    for value in 0u32..=3 {
    \\        total += value
    \\    }
    \\    expect total == 6
    \\} range_next_steps_through_values
    \\

const TEXT_CORE_TEXT: Str =
    \\//! Chars and text views: lengths, slicing, searching and the char cursor.
    \\
    \\pub open view struct Str {
    \\} Str
    \\
    \\pub fn char.utf8_len(self) -> usize limits pure, notrap, terminates
    \\    ensures result >= 1 and result <= 4
    \\    example 'é'.utf8_len() == 2
    \\{
    \\    return match self {
    \\        '\\u{0}'..='\\u{7F}' => 1
    \\        '\\u{80}'..='\\u{7FF}' => 2
    \\        '\\u{800}'..='\\u{FFFF}' => 3
    \\        else => 4
    \\    }
    \\} char.utf8_len
    \\
    \\pub fn char.is_ascii(self) -> bool limits pure, notrap, terminates
    \\    ensures result == (self <= '\\x7F')
    \\    example 'a'.is_ascii()
    \\{
    \\    return self <= '\\x7F'
    \\} char.is_ascii
    \\
    \\pub fn char.is_ascii_digit(self) -> bool limits pure, notrap, terminates
    \\    ensures result == (self >= '0' and self <= '9')
    \\    example '7'.is_ascii_digit()
    \\{
    \\    return self >= '0' and self <= '9'
    \\} char.is_ascii_digit
    \\
    \\pub fn char.is_ascii_alphabetic(self) -> bool limits pure, notrap, terminates
    \\    ensures result == ((self >= 'A' and self <= 'Z') or (self >= 'a' and self <= 'z'))
    \\    example not '7'.is_ascii_alphabetic()
    \\{
    \\    if self >= 'A' and self <= 'Z' {
    \\        return true
    \\    }
    \\    if self >= 'a' and self <= 'z' {
    \\        return true
    \\    }
    \\    return false
    \\} char.is_ascii_alphabetic
    \\
    \\pub fn char.is_ascii_whitespace(self) -> bool limits pure, notrap, terminates
    \\    ensures result == (self == ' ' or self == '\\t' or self == '\\n' or self == '\\x0C' or self == '\\r')
    \\    example '\\t'.is_ascii_whitespace()
    \\{
    \\    if self == ' ' or self == '\\t' {
    \\        return true
    \\    }
    \\    if self == '\\n' or self == '\\x0C' {
    \\        return true
    \\    }
    \\    if self == '\\r' {
    \\        return true
    \\    }
    \\    return false
    \\} char.is_ascii_whitespace
    \\
    \\pub fn char.to_ascii_lowercase(self) -> char limits pure, notrap, terminates
    \\    example 'Q'.to_ascii_lowercase() == 'q'
    \\{
    \\    let bits = self.to_bits()
    \\    if bits >= 65 and bits <= 90 {
    \\        return char.checked_from_bits(bits + 32).value_or(self)
    \\    }
    \\    return self
    \\} char.to_ascii_lowercase
    \\
    \\pub fn char.to_ascii_uppercase(self) -> char limits pure, notrap, terminates
    \\    example 'q'.to_ascii_uppercase() == 'Q'
    \\{
    \\    let bits = self.to_bits()
    \\    if bits >= 97 and bits <= 122 {
    \\        return char.checked_from_bits(bits - 32).value_or(self)
    \\    }
    \\    return self
    \\} char.to_ascii_uppercase
    \\
    \\pub proj fn Str.as_bytes(self) -> Slice[u8] limits pure, notrap, terminates
    \\    ensures result.len() == self.byte_len()
    \\    example "ab".as_bytes() == b"ab"
    \\
    \\pub proj fn Str.cursor(self) -> CharCursor limits pure, notrap, terminates
    \\
    \\pub fn Str.is_empty(self) -> bool limits pure, notrap, terminates
    \\    ensures result == (self.byte_len() == 0)
    \\    example "".is_empty()
    \\{
    \\    return self.byte_len() == 0
    \\} Str.is_empty
    \\
    \\pub fn Str.starts_with(self, prefix: Str) -> bool limits pure, notrap, terminates
    \\    example "port=80".starts_with("port")
    \\{
    \\    let Some(head) = self.as_bytes().prefix(prefix.byte_len()) else {
    \\        return false
    \\    }
    \\    return head == prefix.as_bytes()
    \\} Str.starts_with
    \\
    \\pub fn Str.ends_with(self, suffix: Str) -> bool limits pure, notrap, terminates
    \\    example "port=80".ends_with("80")
    \\{
    \\    let bytes = self.as_bytes()
    \\    let count = suffix.byte_len()
    \\    if count > bytes.len() {
    \\        return false
    \\    }
    \\    let Some(parts) = bytes.split_at(bytes.len() - count) else {
    \\        return false
    \\    }
    \\    return parts.tail == suffix.as_bytes()
    \\} Str.ends_with
    \\
    \\pub fn Str.find(self, needle: Str) -> Option[usize] limits pure, notrap, terminates
    \\    example "port=80".find("=") == Some(4)
    \\{
    \\    let bytes = self.as_bytes()
    \\    let count = needle.byte_len()
    \\    if count > bytes.len() {
    \\        return None
    \\    }
    \\    for start in 0..=(bytes.len() - count) {
    \\        let Some(parts) = bytes.split_at(start) else {
    \\            return None
    \\        }
    \\        let Some(window) = parts.tail.prefix(count) else {
    \\            return None
    \\        }
    \\        if window == needle.as_bytes() {
    \\            return Some(start)
    \\        }
    \\    }
    \\    return None
    \\} Str.find
    \\
    \\pub fn Str.byte_len(self) -> usize limits pure, notrap, terminates
    \\    example "café".byte_len() == 5
    \\{
    \\    return self.as_bytes().len()
    \\} Str.byte_len
    \\
    \\pub fn Str.char_count(self) -> usize limits pure, notrap, terminates
    \\    example "café".char_count() == 4
    \\{
    \\    let bytes = self.as_bytes()
    \\    var count: usize = 0
    \\    for byte in bytes {
    \\        if (byte & 0xC0) != 0x80 {
    \\            count = count.wrapping_add(1)
    \\        }
    \\    }
    \\    return count
    \\} Str.char_count
    \\
    \\pub fn Str.is_char_boundary(self, i: usize) -> bool limits pure, notrap, terminates
    \\    example not "café".is_char_boundary(4)
    \\{
    \\    let bytes = self.as_bytes()
    \\    if i == 0 or i == bytes.len() {
    \\        return true
    \\    }
    \\    return i < bytes.len() and (bytes[i] & 0xC0) != 0x80
    \\} Str.is_char_boundary
    \\
    \\pub proj fn Str.slice_bytes(self, start: usize, end: usize) -> Option[Str] limits pure, notrap, terminates
    \\    ensures match result {
    \\        Some(slice) => start <= end and end <= self.byte_len() and slice.byte_len() == end - start
    \\        None => not (start <= end and end <= self.byte_len() and self.is_char_boundary(start) and self.is_char_boundary(end))
    \\    }
    \\    example "café".slice_bytes(0, end: 3) == Some("caf")
    \\    example "café".slice_bytes(0, end: 4) == None
    \\
    \\pub open view struct CharCursor {
    \\} CharCursor
    \\
    \\impl CharCursor: Cursor[char]
    \\
    \\pub fn CharCursor.next(mut self) -> Option[char] limits pure, notrap, terminates
    \\
    \\test text_cursor_yields_chars for Str.cursor {
    \\    var count: u32 = 0
    \\    for c in "é!" {
    \\        if c == 'é' {
    \\            count += 1
    \\        }
    \\    }
    \\    expect count == 1
    \\} text_cursor_yields_chars
    \\
    \\test char_cursor_next_decodes_one_char for CharCursor.next {
    \\    var cursor = "é!".cursor()
    \\    let decoded = mut cursor.next()
    \\    expect decoded == Some('é')
    \\} char_cursor_next_decodes_one_char
    \\

const TEXT_CORE_UNTRUSTED: Str =
    \\//! Untrusted values and their content-blind operations.
    \\
    \\pub open struct Untrusted[T: Any] {
    \\} Untrusted
    \\
    \\pub closed view struct Parts[T] {
    \\    pub head: T
    \\    pub tail: T
    \\} Parts
    \\
    \\pub fn Untrusted.of(take value: T) -> Untrusted[T] limits pure, notrap, terminates
    \\    example Untrusted.of(b"ok").byte_len() == 2
    \\
    \\pub proj fn Untrusted.inspect(self) -> T limits pure, notrap, terminates
    \\
    \\pub fn Untrusted.byte_len(self) -> usize limits pure, notrap, terminates
    \\    example Untrusted.of(b"ok").byte_len() == 2
    \\
    \\pub proj fn Untrusted.view(self) -> Untrusted[Slice[u8]] limits pure, notrap, terminates
    \\    ensures result.byte_len() == self.byte_len()
    \\    example Untrusted.of(Array[u8, 3].filled(0)).view().byte_len() == 3
    \\
    \\pub proj fn Untrusted.view_mut(mut self) -> Untrusted[SliceMut[u8]] limits pure, notrap, terminates
    \\    ensures result.byte_len() == self.byte_len()
    \\    example Untrusted.of(Array[u8, 3].filled(0)).view_mut().byte_len() == 3
    \\
    \\pub proj fn Untrusted.prefix(self, count: usize) -> Option[Untrusted[Slice[u8]]] limits pure, notrap, terminates
    \\    ensures match result {
    \\        Some(head) => count <= self.byte_len() and head.byte_len() == count
    \\        None => count > self.byte_len()
    \\    }
    \\    example Untrusted.of(b"ok").prefix(3).is_none()
    \\
    \\pub proj fn Untrusted.split_at(self, at: usize) -> Option[Parts[Untrusted[Slice[u8]]]] limits pure, notrap, terminates
    \\    ensures match result {
    \\        Some(parts) => at <= self.byte_len() and parts.head.byte_len() == at and parts.tail.byte_len() == self.byte_len() - at
    \\        None => at > self.byte_len()
    \\    }
    \\    example Untrusted.of(b"ok").split_at(1).is_some()
    \\
    \\pub fn Untrusted.append(mut self, bytes: Untrusted[Slice[u8]]) limits terminates
    \\    ensures self.byte_len() >= bytes.byte_len() and self.byte_len() - bytes.byte_len() == old(self.byte_len())
    \\
    \\pub fn Untrusted.try_append(mut self, bytes: Untrusted[Slice[u8]]) fails mem::OutOfMemory limits notrap, terminates
    \\    ensures self.byte_len() >= bytes.byte_len() and self.byte_len() - bytes.byte_len() == old(self.byte_len())
    \\
    \\pub fn Untrusted.copy_prefix(self, count: usize, alloc: mem::Alloc) -> Untrusted[mem::Bytes] limits terminates
    \\    requires count <= self.byte_len()
    \\    ensures result.byte_len() == count
    \\    example Untrusted.of(b"ok").copy_prefix(1, alloc: testing::world().alloc).byte_len() == 1
    \\
    \\pub fn Untrusted.try_copy_prefix(self, count: usize, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails mem::OutOfMemory limits terminates
    \\    requires count <= self.byte_len()
    \\    ensures result.byte_len() == count
    \\    example (attempt Untrusted.of(b"ok").try_copy_prefix(1, alloc: testing::world().alloc)).is_ok()
    \\
    \\pub fn Untrusted.into_cleared(take self) -> T limits pure, notrap, terminates
    \\    example Untrusted.of(Array[u8, 2].filled(7)).into_cleared() == Array[u8, 2].filled(0)
    \\
    \\test append_grows_the_contents for Untrusted.append {
    \\    let world = testing::world()
    \\    var message = Untrusted.of(b"ab").copy_prefix(2, alloc: world.alloc)
    \\    mut message.append(Untrusted.of(b"cd"))
    \\    expect message.byte_len() == 4
    \\} append_grows_the_contents
    \\
    \\test try_append_grows_the_contents for Untrusted.try_append {
    \\    let world = testing::world()
    \\    var message = Untrusted.of(b"ab").copy_prefix(2, alloc: world.alloc)
    \\    try mut message.try_append(Untrusted.of(b"cd"))
    \\    expect message.byte_len() == 4
    \\} try_append_grows_the_contents
    \\

const TEXT_HOST_HOST: Str =
    \\//! The host root grant and the component runner.
    \\
    \\pub open struct World derives Send {
    \\    pub fs: sys::Fs
    \\    pub net: sys::Net
    \\    pub clock: sys::Clock
    \\    pub wall: sys::WallClock
    \\    pub random: sys::Random
    \\    pub log: sys::Log
    \\    pub stdio: sys::Stdio
    \\    pub alloc: mem::Alloc
    \\    pub exec: task::Executor
    \\    pub args: Untrusted[mem::List[mem::Bytes]]
    \\    pub environment: Untrusted[mem::Map[mem::Bytes, mem::Bytes]]
    \\} World
    \\
    \\pub open struct Runner[S] {
    \\} Runner
    \\
    \\pub fn Runner.run[Env: Any, M: Any, E](take env: Env, exec: task::Executor, alloc: mem::Alloc, body: fn(inbox: sys::Outbox[M]) fails E uses wait) -> S fails E uses wait
    \\
    \\struct Tally derives Encode {
    \\    total: u64
    \\} Tally
    \\
    \\struct TallyEnv {
    \\} TallyEnv
    \\
    \\impl Tally: sys::Component[TallyEnv, u32]
    \\
    \\fn Tally.start(mut env: TallyEnv) -> Tally = Tally(total: 0)
    \\
    \\fn Tally.on(mut self, take message: u32, mut env: TallyEnv, mut cx: sys::Cx[u32]) {
    \\    self.total += u64.widen(message)
    \\} Tally.on
    \\
    \\test run_returns_the_final_state for Runner.run {
    \\    let world = testing::world()
    \\    let last = try await Runner[Tally].run(TallyEnv(), exec: world.exec, alloc: world.alloc, body: fn(inbox: sys::Outbox[u32]) fails task::SendError uses wait {
    \\        try await inbox.post(3)
    \\        try await inbox.post(4)
    \\    })
    \\    expect last.total == 7
    \\} run_returns_the_final_state
    \\
    \\struct Spent derives Encode {
    \\    handled: u64
    \\} Spent
    \\
    \\linear struct SpentEnv {
    \\    budget: mem::Budget
    \\} SpentEnv
    \\
    \\fn SpentEnv.abandon(take self) {
    \\    let SpentEnv(budget: budget) = self
    \\    take budget.close()
    \\} SpentEnv.abandon
    \\
    \\impl Spent: sys::Component[SpentEnv, u32]
    \\
    \\fn Spent.start(mut env: SpentEnv) -> Spent = Spent(handled: 0)
    \\
    \\fn Spent.on(mut self, take message: u32, mut env: SpentEnv, mut cx: sys::Cx[u32]) {
    \\    self.handled += 1
    \\} Spent.on
    \\
    \\test run_abandons_a_linear_env for Runner.run {
    \\    let world = testing::world()
    \\    let budget = world.alloc.split(65_536)
    \\    var bytes = mem::Bytes.empty(budget.alloc())
    \\    let last = try await Runner[Spent].run(SpentEnv(budget: take budget), exec: world.exec, alloc: world.alloc, body: fn(inbox: sys::Outbox[u32]) fails task::SendError uses wait {
    \\        try await inbox.post(1)
    \\    })
    \\    let pushed = attempt mut bytes.try_push(1)
    \\    expect last.handled == 1
    \\    expect pushed.is_err()
    \\} run_abandons_a_linear_env
    \\

const TEXT_HOST_PACKAGE: Str =
    \\//! The host root grant and the component runner.
    \\
    \\package host {
    \\    language 1
    \\    targets any
    \\} host
    \\

const TEXT_HOST_PLATFORM_FILES: Str =
    \\//! The file operations of `sys::Fs` and `sys::fs::File` over the descriptor of a directory.
    \\
    \\/// How `openat2` resolves a path: its open flags, its mode and its resolution flags.
    \\layout OpenHow: bytes 24 le {
    \\    flags: u64 at 0
    \\    mode: u64 at 8
    \\    resolve: u64 at 16
    \\} OpenHow
    \\
    \\/// The open flags of a file read from, written to after truncation, or created.
    \\const READ_ONLY: u64 = 0x8_0000
    \\
    \\const WRITE_CREATE: u64 = 0x8_0241
    \\
    \\/// Resolution staying beneath the directory and following no magic links.
    \\const BENEATH: u64 = 0x0A
    \\
    \\/// The longest path the platform functions join, in bytes, its NUL excluded.
    \\const PATH_LIMIT: usize = 4_095
    \\
    \\/// `prefix`, `/` when it is not empty, `path` and a NUL, in a buffer; false when it is too long.
    \\fn joined(prefix: Str, path: Str, mut buffer: Array[u8, 4_096]) -> bool {
    \\    let head = prefix.as_bytes()
    \\    let tail = path.as_bytes()
    \\    var separator: usize = 0
    \\    if head.len() > 0 {
    \\        separator = 1
    \\    }
    \\    if head.len() + separator + tail.len() > PATH_LIMIT {
    \\        return false
    \\    }
    \\    var at: usize = 0
    \\    for byte in head {
    \\        buffer[at] = byte
    \\        at += 1
    \\    }
    \\    if separator == 1 {
    \\        buffer[at] = b'/'
    \\        at += 1
    \\    }
    \\    for byte in tail {
    \\        buffer[at] = byte
    \\        at += 1
    \\    }
    \\    buffer[at] = 0
    \\    return true
    \\} joined
    \\
    \\/// The failure of a negative error number of a file operation.
    \\fn failure(error: i32) -> sys::fs::FsError {
    \\    return match -error {
    \\        2 => sys::fs::FsError.NotFound
    \\        28 or 122 => sys::fs::FsError.NoSpace
    \\        else => sys::fs::FsError.Denied
    \\    }
    \\} failure
    \\
    \\/// Opens a path beneath a directory with `flags`, creating its missing directories first and
    \\/// the file with mode 0644 when the flags create it: the new descriptor.
    \\fn open_beneath(dir: i32, prefix: Str, path: Str, flags: u64) -> i32 fails sys::fs::FsError uses wait {
    \\    var buffer = Array[u8, 4_096].filled(0)
    \\    if not joined(prefix, path, mut buffer) {
    \\        fail sys::fs::FsError.InvalidPath
    \\    }
    \\    var mode: u64 = 0
    \\    if flags == WRITE_CREATE {
    \\        mode = 0x1A4
    \\        try await make_parents(dir, path: buffer)
    \\    }
    \\    var how = OpenHow(flags: flags, mode: mode, resolve: BENEATH)
    \\    let path_address = u64.widen(hw::Ptr.of_view(buffer.view()).addr())
    \\    let how_address = u64.widen(hw::Ptr.of_mut(mut how).addr())
    \\    let result = try await submit(operation(OP_OPENAT2, fd: dir, address: path_address, len: 24, offset: how_address))
    \\    if result < 0 {
    \\        fail failure(result)
    \\    }
    \\    return result
    \\} open_beneath
    \\
    \\/// Creates each missing directory of a joined path's parent.
    \\fn make_parents(dir: i32, path: Array[u8, 4_096]) fails sys::fs::FsError uses wait {
    \\    var partial = Array[u8, 4_096].filled(0)
    \\    var at: usize = 0
    \\    while path[at] != 0 {
    \\        if path[at] == b'/' {
    \\            let address = u64.widen(hw::Ptr.of_view(partial.view()).addr())
    \\            let result = try await submit(operation(OP_MKDIRAT, fd: dir, address, len: 0x1ED, offset: 0))
    \\            if result < 0 and result != -EEXIST {
    \\                fail failure(result)
    \\            }
    \\        }
    \\        partial[at] = path[at]
    \\        at += 1
    \\    }
    \\} make_parents
    \\
    \\pkg fn fs_open(dir: i32, prefix: Str, path: Str) -> i32 fails sys::fs::FsError uses wait {
    \\    return try await open_beneath(dir, prefix, path, flags: READ_ONLY)
    \\} fs_open
    \\
    \\pkg fn fs_create(dir: i32, prefix: Str, path: Str) -> i32 fails sys::fs::FsError uses wait {
    \\    return try await open_beneath(dir, prefix, path, flags: WRITE_CREATE)
    \\} fs_create
    \\
    \\pkg fn fs_read_all(dir: i32, prefix: Str, path: Str, alloc: mem::Alloc) -> mem::Bytes fails sys::fs::FsError uses wait {
    \\    let fd = try await open_beneath(dir, prefix, path, flags: READ_ONLY)
    \\    defer release(fd)
    \\    var contents = mem::Bytes.empty(alloc)
    \\    var chunk = Array[u8, 4_096].filled(0)
    \\    loop {
    \\        let address = u64.widen(hw::Ptr.of_view_mut(mut chunk.view_mut()).addr())
    \\        let count = try await read_at(fd, address, len: 4_096)
    \\        if count < 0 {
    \\            fail failure(count)
    \\        }
    \\        if count == 0 {
    \\            return contents
    \\        }
    \\        let Some(filled) = chunk.view().prefix(usize.fit(count)) else {
    \\            return contents
    \\        }
    \\        mut contents.append(filled)
    \\    }
    \\} fs_read_all
    \\
    \\pkg fn fs_write_all(dir: i32, prefix: Str, path: Str, data: Slice[u8]) fails sys::fs::FsError uses wait {
    \\    let fd = try await open_beneath(dir, prefix, path, flags: WRITE_CREATE)
    \\    defer release(fd)
    \\    var done: usize = 0
    \\    while done < data.len() {
    \\        let Some(parts) = data.split_at(done) else {
    \\            return
    \\        }
    \\        let count = try await write_some(fd, data: parts.tail)
    \\        if count <= 0 {
    \\            fail failure(count)
    \\        }
    \\        done += usize.fit(count)
    \\    }
    \\} fs_write_all
    \\
    \\pkg fn fs_remove(dir: i32, prefix: Str, path: Str) fails sys::fs::FsError uses wait {
    \\    var buffer = Array[u8, 4_096].filled(0)
    \\    if not joined(prefix, path, mut buffer) {
    \\        fail sys::fs::FsError.InvalidPath
    \\    }
    \\    let address = u64.widen(hw::Ptr.of_view(buffer.view()).addr())
    \\    let result = try await submit(operation(OP_UNLINKAT, fd: dir, address, len: 0, offset: 0))
    \\    if result < 0 {
    \\        fail failure(result)
    \\    }
    \\} fs_remove
    \\
    \\pkg fn file_read(fd: i32, address: u64, len: usize) -> usize fails sys::fs::FsError uses wait {
    \\    let count = try await read_at(fd, address, len)
    \\    if count < 0 {
    \\        fail failure(count)
    \\    }
    \\    return usize.fit(count)
    \\} file_read
    \\
    \\pkg fn file_write(fd: i32, data: Slice[u8]) -> usize fails sys::fs::FsError uses wait {
    \\    let count = try await write_some(fd, data)
    \\    if count < 0 {
    \\        fail failure(count)
    \\    }
    \\    return usize.fit(count)
    \\} file_write
    \\
    \\pkg fn file_byte_len(fd: i32) -> u64 fails sys::fs::FsError uses wait {
    \\    var status = Array[u8, 256].filled(0)
    \\    let empty = Array[u8, 1].filled(0)
    \\    let path_address = u64.widen(hw::Ptr.of_view(empty.view()).addr())
    \\    let status_address = u64.widen(hw::Ptr.of_view_mut(mut status.view_mut()).addr())
    \\    var request = operation(OP_STATX, fd, address: path_address, len: 0x200, offset: status_address)
    \\    request.op_flags = 0x1000
    \\    let result = try await submit(request)
    \\    if result < 0 {
    \\        fail failure(result)
    \\    }
    \\    return status.view().u64_le(40)
    \\} file_byte_len
    \\

const TEXT_HOST_PLATFORM_HOST_PLATFORM: Str =
    \\//! The host entry landing fn and the submission of operations to the executor's io_uring.
    \\
    \\/// One io_uring submission queue entry, which `submit` hands to the ring of the thread running
    \\/// the task.
    \\pkg layout Entry: bytes 64 le {
    \\    opcode: u8 at 0
    \\    flags: u8 at 1
    \\    priority: u16 at 2
    \\    fd: i32 at 4
    \\    offset: u64 at 8
    \\    address: u64 at 16
    \\    len: u32 at 24
    \\    op_flags: u32 at 28
    \\    user_data: u64 at 32
    \\    buffer_index: u16 at 40
    \\    personality: u16 at 42
    \\    file_index: u32 at 44
    \\    address3: u64 at 48
    \\    padding: u64 at 56
    \\} Entry
    \\
    \\/// Submits an operation on the io_uring of the executor thread running the task and returns
    \\/// the result its completion carries, a negative error number on failure. Cancelling it
    \\/// cancels the operation in flight and returns only once the kernel acknowledges.
    \\pkg fn submit(entry: Entry) -> i32 fails task::Cancelled uses wait
    \\
    \\pkg const OP_READ: u8 = 22
    \\
    \\pkg const OP_WRITE: u8 = 23
    \\
    \\pkg const OP_TIMEOUT: u8 = 11
    \\
    \\pkg const OP_ACCEPT: u8 = 13
    \\
    \\pkg const OP_CONNECT: u8 = 16
    \\
    \\pkg const OP_STATX: u8 = 21
    \\
    \\pkg const OP_SEND: u8 = 26
    \\
    \\pkg const OP_RECV: u8 = 27
    \\
    \\pkg const OP_OPENAT2: u8 = 28
    \\
    \\pkg const OP_SHUTDOWN: u8 = 34
    \\
    \\pkg const OP_UNLINKAT: u8 = 36
    \\
    \\pkg const OP_MKDIRAT: u8 = 37
    \\
    \\pkg const ENOENT: i32 = 2
    \\
    \\pkg const EINTR: i32 = 4
    \\
    \\pkg const EAGAIN: i32 = 11
    \\
    \\pkg const EEXIST: i32 = 17
    \\
    \\pkg const ETIME: i32 = 62
    \\
    \\pkg const ECANCELED: i32 = 125
    \\
    \\/// The entry of an operation `opcode` on `fd` with its address, length and offset, every other field zero.
    \\pkg fn operation(
    \\    opcode: u8,
    \\    fd: i32,
    \\    address: u64,
    \\    len: u32,
    \\    offset: u64,
    \\    ) -> Entry {
    \\    return Entry(
    \\        opcode: opcode,
    \\        flags: 0,
    \\        priority: 0,
    \\        fd: fd,
    \\        offset: offset,
    \\        address: address,
    \\        len: len,
    \\        op_flags: 0,
    \\        user_data: 0,
    \\        buffer_index: 0,
    \\        personality: 0,
    \\        file_index: 0,
    \\        address3: 0,
    \\        padding: 0,
    \\    )
    \\} operation
    \\
    \\/// The address of a view's first byte.
    \\pkg fn address_of(bytes: Slice[u8]) -> u64 {
    \\    return u64.widen(hw::Ptr.of_view(bytes).addr())
    \\} address_of
    \\
    \\/// The host entry landing fn: mints the root grant and gives it the program's arguments and
    \\/// environment, as Untrusted byte strings.
    \\pub landing fn enter(count: i32, arguments: hw::Ptr[hw::Ptr[u8]], environment: hw::Ptr[hw::Ptr[u8]]) -> host::World limits stack 65_536 {
    \\    var world = hw::mint_root()
    \\    let alloc = world.alloc
    \\    var args = mem::List[mem::Bytes].empty(alloc)
    \\    var index: isize = 1
    \\    while index < isize.widen(count) {
    \\        let text = trusted "the C library passes `count` arguments, each a NUL-terminated text" { arguments.offset(index).read() }
    \\        mut args.push(c_bytes(text, alloc))
    \\        index += 1
    \\    }
    \\    world.args = Untrusted.of(take args)
    \\    var variables = mem::Map[mem::Bytes, mem::Bytes].empty(alloc)
    \\    var at: isize = 0
    \\    loop {
    \\        let text = trusted "the environment is a list of NUL-terminated texts ending with a zero address" { environment.offset(at).read() }
    \\        if text.addr() == 0 {
    \\            break
    \\        }
    \\        add_variable(mut variables, text: c_bytes(text, alloc), alloc)
    \\        at += 1
    \\    }
    \\    world.environment = Untrusted.of(take variables)
    \\    return world
    \\} enter
    \\
    \\/// The bytes of a NUL-terminated text, without the NUL.
    \\fn c_bytes(text: hw::Ptr[u8], alloc: mem::Alloc) -> mem::Bytes {
    \\    var bytes = mem::Bytes.empty(alloc)
    \\    var at: isize = 0
    \\    loop {
    \\        let byte = trusted "the text ends with a NUL" { text.offset(at).read() }
    \\        if byte == 0 {
    \\            return bytes
    \\        }
    \\        mut bytes.push(byte)
    \\        at += 1
    \\    }
    \\} c_bytes
    \\
    \\/// Adds a `NAME=value` environment entry, a text without `=` naming an empty value.
    \\fn add_variable(mut variables: mem::Map[mem::Bytes, mem::Bytes], take text: mem::Bytes, alloc: mem::Alloc) {
    \\    let view = text.view()
    \\    var split = view.len()
    \\    for at in 0..<view.len() {
    \\        if view[at] == b'=' and split == view.len() {
    \\            split = at
    \\        }
    \\    }
    \\    var name = mem::Bytes.empty(alloc)
    \\    var value = mem::Bytes.empty(alloc)
    \\    for at in 0..<view.len() {
    \\        if at < split {
    \\            mut name.push(view[at])
    \\        } else if at > split {
    \\            mut value.push(view[at])
    \\        }
    \\    }
    \\    discard mut variables.insert(take name, take value)
    \\} add_variable
    \\

const TEXT_HOST_PLATFORM_NETWORK: Str =
    \\//! The network operations of `sys::Net`, `sys::net::Listener` and `sys::net::Conn`.
    \\
    \\/// An `addrinfo` of the C library: a resolved address and the next one.
    \\layout AddressInfo: bytes 48 le {
    \\    flags: i32 at 0
    \\    family: i32 at 4
    \\    kind: i32 at 8
    \\    protocol: i32 at 12
    \\    address_len: u32 at 16
    \\    padding: u32 at 20
    \\    address: u64 at 24
    \\    canonical_name: u64 at 32
    \\    next: u64 at 40
    \\} AddressInfo
    \\
    \\/// An IPv6 socket address.
    \\layout Inet6Address: bytes 28 le {
    \\    family: u16 at 0
    \\    port: u16 at 2
    \\    flow: u32 at 4
    \\    address: Array[u8, 16] at 8
    \\    scope: u32 at 24
    \\} Inet6Address
    \\
    \\/// The `linger` option of a socket.
    \\layout Linger: bytes 8 le {
    \\    enabled: i32 at 0
    \\    seconds: i32 at 4
    \\} Linger
    \\
    \\foreign fn socket(domain: i32, kind: i32, protocol: i32) -> i32 convention "sysv"
    \\
    \\foreign fn setsockopt(
    \\    fd: i32,
    \\    level: i32,
    \\    name: i32,
    \\    value: hw::Ptr[u8],
    \\    len: u32,
    \\    ) -> i32 convention "sysv"
    \\
    \\foreign fn bind(fd: i32, address: hw::Ptr[Inet6Address], len: u32) -> i32 convention "sysv"
    \\
    \\foreign fn listen(fd: i32, backlog: i32) -> i32 convention "sysv"
    \\
    \\foreign fn getaddrinfo(node: hw::Ptr[u8], service: hw::Ptr[u8], hints: hw::Ptr[AddressInfo], found: hw::Ptr[u64]) -> i32 convention "sysv"
    \\
    \\foreign fn freeaddrinfo(found: hw::Ptr[AddressInfo]) convention "sysv"
    \\
    \\/// A stream socket closed on exec.
    \\const STREAM: i32 = 0x8_0001
    \\
    \\/// The `send` flag keeping a reset peer from raising `SIGPIPE`.
    \\const NO_SIGNAL: u32 = 0x4000
    \\
    \\/// The failure of a negative error number of a network operation.
    \\fn net_failure(error: i32) -> sys::net::NetError {
    \\    return match -error {
    \\        111 => sys::net::NetError.Refused
    \\        32 or 103 or 104 or 107 => sys::net::NetError.Reset
    \\        101 or 110 or 113 => sys::net::NetError.Unreachable
    \\        98 => sys::net::NetError.AddressInUse
    \\        else => sys::net::NetError.Denied
    \\    }
    \\} net_failure
    \\
    \\/// A port with its bytes in network order.
    \\fn network_order(port: u16) -> u16 {
    \\    return (port << 8) | (port >> 8)
    \\} network_order
    \\
    \\/// Sets an integer option of a socket.
    \\fn set_option(fd: i32, level: i32, name: i32, value: i32) {
    \\    var held = Array[i32, 1].filled(value)
    \\    let address: hw::Ptr[u8] = trusted "an i32 is read as its bytes" { hw::Ptr[u8].cast(hw::Ptr.of_view_mut(mut held.view_mut())) }
    \\    discard setsockopt(fd, level, name, value: address, len: 4)
    \\} set_option
    \\
    \\pkg fn net_listen(port: u16) -> i32 fails sys::net::NetError {
    \\    if port == 0 {
    \\        fail sys::net::NetError.Denied
    \\    }
    \\    let fd = socket(10, kind: STREAM, protocol: 0)
    \\    if fd < 0 {
    \\        fail sys::net::NetError.Denied
    \\    }
    \\    set_option(fd, level: 41, name: 26, value: 0)
    \\    set_option(fd, level: 1, name: 2, value: 1)
    \\    var address = Inet6Address(family: 10, port: network_order(port), flow: 0, address: Array[u8, 16].filled(0), scope: 0)
    \\    if bind(fd, address: hw::Ptr.of_mut(mut address), len: 28) < 0 {
    \\        release(fd)
    \\        fail sys::net::NetError.AddressInUse
    \\    }
    \\    if listen(fd, backlog: 128) < 0 {
    \\        release(fd)
    \\        fail sys::net::NetError.Denied
    \\    }
    \\    return fd
    \\} net_listen
    \\
    \\pkg fn net_connect(host: Str, port: u16) -> i32 fails sys::net::NetError uses wait {
    \\    if port == 0 {
    \\        fail sys::net::NetError.Denied
    \\    }
    \\    var name = Array[u8, 256].filled(0)
    \\    let bytes = host.as_bytes()
    \\    if bytes.len() >= 256 {
    \\        fail sys::net::NetError.Unreachable
    \\    }
    \\    for at in 0..<bytes.len() {
    \\        name[at] = bytes[at]
    \\    }
    \\    var hints = AddressInfo(flags: 0, family: 0, kind: 1, protocol: 0, address_len: 0, padding: 0, address: 0, canonical_name: 0, next: 0)
    \\    var found = Array[u64, 1].filled(0)
    \\    let node = hw::Ptr.of_view(name.view())
    \\    let answers = hw::Ptr.of_view_mut(mut found.view_mut())
    \\    if getaddrinfo(node, service: hw::Ptr.of_addr(0), hints: hw::Ptr.of_mut(mut hints), found: answers) != 0 {
    \\        fail sys::net::NetError.Unreachable
    \\    }
    \\    let head: hw::Ptr[AddressInfo] = hw::Ptr.of_addr(usize.widen(found[0]))
    \\    let info = trusted "getaddrinfo succeeded, so its first result is a live addrinfo" { head.read() }
    \\    let socket_address = hw::Ptr[u16].of_addr(usize.widen(info.address))
    \\    trusted "the result's address is a socket address whose port lies at byte 2" {
    \\        socket_address.offset(1).write(network_order(port))
    \\    }
    \\    let fd = socket(info.family, kind: STREAM, protocol: 0)
    \\    if fd < 0 {
    \\        freeaddrinfo(head)
    \\        fail sys::net::NetError.Denied
    \\    }
    \\    let attempt_result = attempt await submit(operation(OP_CONNECT, fd, address: info.address, len: 0, offset: u64.widen(info.address_len)))
    \\    freeaddrinfo(head)
    \\    let result = match attempt_result {
    \\        Ok(result) => result
    \\        Err(cancelled) => {
    \\            release(fd)
    \\            fail cancelled
    \\        }
    \\    }
    \\    if result < 0 {
    \\        release(fd)
    \\        fail net_failure(result)
    \\    }
    \\    return fd
    \\} net_connect
    \\
    \\pkg fn listener_accept(fd: i32) -> i32 fails sys::net::NetError uses wait {
    \\    loop {
    \\        var request = operation(OP_ACCEPT, fd, address: 0, len: 0, offset: 0)
    \\        request.op_flags = 0x8_0000
    \\        let result = try await submit(request)
    \\        if result >= 0 {
    \\            return result
    \\        }
    \\        if result != -EINTR and result != -EAGAIN {
    \\            fail net_failure(result)
    \\        }
    \\    }
    \\} listener_accept
    \\
    \\pkg fn conn_read(fd: i32, address: u64, len: usize) -> usize fails sys::net::NetError uses wait {
    \\    let count = try await read_at(fd, address, len)
    \\    if count < 0 {
    \\        fail net_failure(count)
    \\    }
    \\    return usize.fit(count)
    \\} conn_read
    \\
    \\pkg fn conn_write(fd: i32, data: Slice[u8]) -> usize fails sys::net::NetError uses wait {
    \\    loop {
    \\        var request = operation(OP_SEND, fd, address: address_of(data), len: u32.saturate(data.len()), offset: 0)
    \\        request.op_flags = NO_SIGNAL
    \\        let count = try await submit(request)
    \\        if count >= 0 {
    \\            return usize.fit(count)
    \\        }
    \\        if count != -EINTR and count != -EAGAIN {
    \\            fail net_failure(count)
    \\        }
    \\    }
    \\} conn_write
    \\
    \\pkg fn conn_close(fd: i32) fails sys::net::NetError uses wait {
    \\    defer release(fd)
    \\    let result = try await submit(operation(OP_SHUTDOWN, fd, address: 0, len: 1, offset: 0))
    \\    if result < 0 and result != -107 {
    \\        fail net_failure(result)
    \\    }
    \\} conn_close
    \\
    \\pkg fn conn_abandon(fd: i32) {
    \\    var linger = Linger(enabled: 1, seconds: 0)
    \\    let address: hw::Ptr[u8] = trusted "a linger option is read as its bytes" { hw::Ptr[u8].cast(hw::Ptr.of_mut(mut linger)) }
    \\    discard setsockopt(fd, level: 1, name: 13, value: address, len: 8)
    \\    release(fd)
    \\} conn_abandon
    \\

const TEXT_HOST_PLATFORM_PACKAGE: Str =
    \\//! The platform of the host targets: the host root grant and the sys capabilities over Linux.
    \\
    \\package host_platform {
    \\    language 1
    \\    targets aarch64-host, x86_64-host
    \\    allow priv in host_platform
    \\    allow trusted in host_platform
    \\} host_platform
    \\

const TEXT_HOST_PLATFORM_STREAMS: Str =
    \\//! Reads, writes and closes on descriptors: standard streams, files and connections.
    \\
    \\foreign fn close(fd: i32) -> i32 convention "sysv"
    \\
    \\/// Reads at most `len` bytes at `address` from a descriptor at its position: the count, 0 at
    \\/// the end, or a negative error number.
    \\pkg fn read_at(fd: i32, address: u64, len: usize) -> i32 fails task::Cancelled uses wait {
    \\    loop {
    \\        let count = try await submit(operation(OP_READ, fd, address, len: u32.saturate(len), offset: ~0))
    \\        if count != -EINTR and count != -EAGAIN {
    \\            return count
    \\        }
    \\    }
    \\} read_at
    \\
    \\/// Writes a prefix of `data` to a descriptor at its position: the count written, at least 1
    \\/// when `data` is not empty, or a negative error number.
    \\pkg fn write_some(fd: i32, data: Slice[u8]) -> i32 fails task::Cancelled uses wait {
    \\    loop {
    \\        let count = try await submit(operation(OP_WRITE, fd, address: address_of(data), len: u32.saturate(data.len()), offset: ~0))
    \\        if count != -EINTR and count != -EAGAIN {
    \\            return count
    \\        }
    \\    }
    \\} write_some
    \\
    \\/// Closes a descriptor.
    \\pkg fn release(fd: i32) {
    \\    discard close(fd)
    \\} release
    \\
    \\pkg fn stdio_read(fd: i32, address: u64, len: usize) -> usize fails sys::StdioError uses wait {
    \\    let count = try await read_at(fd, address, len)
    \\    if count < 0 {
    \\        fail sys::StdioError.Closed
    \\    }
    \\    return usize.fit(count)
    \\} stdio_read
    \\
    \\pkg fn stdio_write(fd: i32, data: Slice[u8]) fails sys::StdioError uses wait {
    \\    var done: usize = 0
    \\    while done < data.len() {
    \\        let Some(parts) = data.split_at(done) else {
    \\            return
    \\        }
    \\        let count = try await write_some(fd, data: parts.tail)
    \\        if count <= 0 {
    \\            fail sys::StdioError.Closed
    \\        }
    \\        done += usize.fit(count)
    \\    }
    \\} stdio_write
    \\

const TEXT_HOST_PLATFORM_SYSTEM: Str =
    \\//! The clock, the random source and log records of the host.
    \\
    \\/// A time as seconds and nanoseconds.
    \\layout Timespec: bytes 16 le {
    \\    seconds: i64 at 0
    \\    nanoseconds: i64 at 8
    \\} Timespec
    \\
    \\foreign fn clock_gettime(clock: i32, time: hw::Ptr[Timespec]) -> i32 convention "sysv"
    \\
    \\foreign fn getrandom(buffer: hw::Ptr[u8], len: usize, flags: u32) -> isize convention "sysv"
    \\
    \\foreign fn write(fd: i32, buffer: hw::Ptr[u8], count: usize) -> isize convention "sysv"
    \\
    \\/// The nanoseconds of the monotonic clock.
    \\pkg fn now_ns() -> u64 {
    \\    return read_clock(1)
    \\} now_ns
    \\
    \\/// The nanoseconds of the real-time clock since the Unix epoch.
    \\pkg fn wall_ns() -> u64 {
    \\    return read_clock(0)
    \\} wall_ns
    \\
    \\/// The nanoseconds a clock reads, saturating.
    \\fn read_clock(clock: i32) -> u64 {
    \\    var time = Timespec(seconds: 0, nanoseconds: 0)
    \\    discard clock_gettime(clock, time: hw::Ptr.of_mut(mut time))
    \\    return u64.fit(time.seconds).saturating_mul(1_000_000_000).saturating_add(u64.fit(time.nanoseconds))
    \\} read_clock
    \\
    \\pkg fn sleep(ns: u64) fails task::Cancelled uses wait {
    \\    var time = Timespec(seconds: i64.fit(ns / 1_000_000_000), nanoseconds: i64.fit(ns % 1_000_000_000))
    \\    let address = u64.widen(hw::Ptr.of_mut(mut time).addr())
    \\    discard try await submit(operation(OP_TIMEOUT, fd: -1, address, len: 1, offset: 0))
    \\} sleep
    \\
    \\pkg fn random_fill(mut buf: SliceMut[u8]) {
    \\    var done: usize = 0
    \\    while done < buf.len() {
    \\        let Some(parts) = mut buf.split_at_mut(done) else {
    \\            return
    \\        }
    \\        var rest = parts.tail
    \\        let count = getrandom(hw::Ptr.of_view_mut(mut rest), len: rest.len(), flags: 0)
    \\        if count > 0 {
    \\            done += usize.fit(count)
    \\        }
    \\    }
    \\} random_fill
    \\
    \\/// Writes every byte of a buffer's prefix to standard error.
    \\fn write_err(bytes: Slice[u8]) {
    \\    var done: usize = 0
    \\    while done < bytes.len() {
    \\        let Some(parts) = bytes.split_at(done) else {
    \\            return
    \\        }
    \\        let count = write(2, buffer: hw::Ptr.of_view(parts.tail), count: parts.tail.len())
    \\        if count <= 0 {
    \\            return
    \\        }
    \\        done += usize.fit(count)
    \\    }
    \\} write_err
    \\
    \\/// Writes one log record to standard error: the level, `: `, the message, a space and the
    \\/// rendering, each line feed written as `\\n`, then a line feed.
    \\pkg fn log_line(level: Str, message: Str, rendering: Str) {
    \\    var line = Array[u8, 4_096].filled(0)
    \\    var len: usize = 0
    \\    len = append_escaped(mut line, at: len, text: level.as_bytes())
    \\    len = append_escaped(mut line, at: len, text: b": ")
    \\    len = append_escaped(mut line, at: len, text: message.as_bytes())
    \\    len = append_escaped(mut line, at: len, text: b" ")
    \\    len = append_escaped(mut line, at: len, text: rendering.as_bytes())
    \\    let Some(written) = line.view().prefix(len) else {
    \\        return
    \\    }
    \\    write_err(written)
    \\    write_err(b"\\n")
    \\} log_line
    \\
    \\/// Appends a text to a line from `at`, each line feed as `\\n`, flushing a full line; returns
    \\/// the line's new length.
    \\fn append_escaped(mut line: Array[u8, 4_096], at: usize, text: Slice[u8]) -> usize {
    \\    var len = at
    \\    for byte in text {
    \\        if len + 2 > 4_096 {
    \\            let Some(full) = line.view().prefix(len) else {
    \\                return len
    \\            }
    \\            write_err(full)
    \\            len = 0
    \\        }
    \\        if byte == b'\\n' {
    \\            line[len] = b'\\\\'
    \\            line[len + 1] = b'n'
    \\            len += 2
    \\        } else {
    \\            line[len] = byte
    \\            len += 1
    \\        }
    \\    }
    \\    return len
    \\} append_escaped
    \\

const TEXT_HW_HW: Str =
    \\//! Pointers, address types, register windows, DMA, privileged intrinsics and kernel primitives.
    \\
    \\pub open struct Ptr[T: Any] {
    \\} Ptr
    \\
    \\pub fn Ptr.of_addr(addr: usize) -> Ptr[T] limits pure, notrap, terminates
    \\    ensures result.addr() == addr
    \\    example Ptr[u32].of_addr(0x1000).addr() == 0x1000
    \\
    \\pub fn Ptr.of(value: T) -> Ptr[T] limits pure, notrap, terminates
    \\    example trusted "the pointer addresses the value passed to of" { Ptr.of(7u32).read() } == 7
    \\
    \\pub fn Ptr.of_mut(mut value: T) -> Ptr[T] limits pure, notrap, terminates
    \\
    \\pub fn Ptr.of_view(items: Slice[T]) -> Ptr[T] limits pure, notrap, terminates
    \\    example trusted "the view holds two bytes" { Ptr.of_view(b"AB").read() } == 65
    \\
    \\pub fn Ptr.of_view_mut(mut items: SliceMut[T]) -> Ptr[T] limits pure, notrap, terminates
    \\
    \\pub fn Ptr.addr(self) -> usize limits pure, notrap, terminates
    \\    example Ptr[u8].of_addr(0x40).addr() == 0x40
    \\
    \\pub fn Ptr.is_aligned(self) -> bool limits pure, notrap, terminates
    \\    example Ptr[u32].of_addr(0x1000).is_aligned()
    \\    example not Ptr[u32].of_addr(0x1002).is_aligned()
    \\
    \\pub fn Ptr.read(self) -> T
    \\    requires self.addr() != 0
    \\    requires self.is_aligned()
    \\    example trusted "the pointer addresses the value passed to of" { Ptr.of(0x1234u16).read() } == 0x1234
    \\
    \\pub fn Ptr.write(self, take value: T)
    \\    requires self.addr() != 0
    \\    requires self.is_aligned()
    \\
    \\pub fn Ptr.offset(self, count: isize) -> Ptr[T]
    \\    example trusted "the view holds three bytes" { Ptr.of_view(b"ABC").offset(2).read() } == 67
    \\
    \\pub fn Ptr.cast[U: Any](from: Ptr[U]) -> Ptr[T]
    \\    ensures result.addr() == from.addr()
    \\    example trusted "a cast accesses no memory" { Ptr[u16].cast(Ptr[u8].of_addr(0x1000)).addr() } == 0x1000
    \\
    \\pub fn Ptr.copy(self, to: Ptr[T], count: usize)
    \\    requires self.is_aligned()
    \\    requires to.is_aligned()
    \\
    \\test of_mut_addresses_the_place for Ptr.of_mut {
    \\    var level: u32 = 4
    \\    let pointer = Ptr.of_mut(mut level)
    \\    trusted "pointer addresses level, which nothing else reaches until the write ends" {
    \\        pointer.write(9)
    \\    }
    \\    expect level == 9
    \\} of_mut_addresses_the_place
    \\
    \\test of_view_mut_addresses_the_first_element for Ptr.of_view_mut {
    \\    var bytes = Array[u8, 3].filled(0)
    \\    let start = Ptr.of_view_mut(mut bytes.view_mut())
    \\    trusted "start addresses the first of the three bytes, which nothing else reaches until the write ends" {
    \\        start.write(5)
    \\    }
    \\    expect bytes[0] == 5
    \\    expect bytes[1] == 0
    \\} of_view_mut_addresses_the_first_element
    \\
    \\test write_stores_at_the_address for Ptr.write {
    \\    var bytes = Array[u8, 3].filled(0)
    \\    let start = Ptr.of_view_mut(mut bytes.view_mut())
    \\    trusted "the view holds three bytes, which nothing else reaches until the write ends" {
    \\        start.offset(2).write(7)
    \\    }
    \\    expect bytes[2] == 7
    \\} write_stores_at_the_address
    \\
    \\test copy_handles_overlapping_ranges for Ptr.copy {
    \\    var bytes = Array[u8, 4].filled(0)
    \\    bytes[0] = 1
    \\    bytes[1] = 2
    \\    bytes[2] = 3
    \\    let start = Ptr.of_view_mut(mut bytes.view_mut())
    \\    trusted "the view holds four bytes, so both ranges of three lie inside it" {
    \\        start.copy(start.offset(1), count: 3)
    \\    }
    \\    expect bytes[1] == 1
    \\    expect bytes[2] == 2
    \\    expect bytes[3] == 3
    \\} copy_handles_overlapping_ranges
    \\
