item "core::Decoder"
text "pub interface Decoder {"
text "    fn read_bool(mut self) -> bool fails DecodeError limits terminates"
text "    fn read_unsigned(mut self) -> u64 fails DecodeError limits terminates"
text "    fn read_signed(mut self) -> i64 fails DecodeError limits terminates"
text "    fn read_float(mut self) -> f64 fails DecodeError limits terminates"
text "    fn read_char(mut self) -> char fails DecodeError limits terminates"
text "    fn begin_text(mut self) -> usize fails DecodeError limits terminates"
text "    fn begin_bytes(mut self) -> usize fails DecodeError limits terminates"
text "    fn read_chunk(mut self, mut out: SliceMut[u8]) fails DecodeError limits terminates"
text "    fn begin_sequence(mut self) fails DecodeError limits terminates"
text "    fn begin_map(mut self) fails DecodeError limits terminates"
text "    fn begin_record(mut self) fails DecodeError limits terminates"
text "    fn next_follows(mut self) -> bool fails DecodeError limits terminates"
text "    fn read_key(mut self, keys: Slice[Str]) -> Option[usize] fails DecodeError limits terminates"
text "    fn read_variant(mut self, keys: Slice[Str]) -> Option[usize] fails DecodeError limits terminates"
text "    fn payload_follows(mut self) -> bool fails DecodeError limits terminates"
text "    fn skip(mut self) fails DecodeError limits terminates"
text "    fn end(mut self) fails DecodeError limits terminates"
text "} Decoder"
