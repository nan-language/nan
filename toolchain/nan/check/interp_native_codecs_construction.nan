//! The interpreter's reader of construction text, the form derived `Render` writes.

/// What the construction reader is inside: elements up to a closing byte, which the frame
/// passes over unless it closes a variant's payload, with whether one was read; a record named
/// without parentheses; or a variant, with whether its payload's parenthesis is open.
enum ConstructionFrame derives Copy {
    Elements(close: u8, owned: bool, started: bool)
    Bare
    Variant(payload: bool)
} ConstructionFrame

/// The literals of construction text.
enum ConstructionLiteral derives Copy, Eq {
    Char
    Text
    Bytes
} ConstructionLiteral

/// A number's text without `_`, and whether it has a fraction or an exponent.
struct ConstructionNumber {
    written: mem::Bytes
    fractional: bool
} ConstructionNumber

struct ConstructionReader {
    input: CodecInput
    frames: mem::List[ConstructionFrame]
    grammar: mem::Shared[syntax::Grammar]
} ConstructionReader

fn ConstructionReader.new(take bytes: mem::Bytes, take grammar: mem::Shared[syntax::Grammar], alloc: mem::Alloc) -> ConstructionReader {
    return ConstructionReader(input: CodecInput(bytes: take bytes, at: 0, alloc: alloc), frames: mem::List[ConstructionFrame].empty(alloc), grammar: take grammar)
} ConstructionReader.new

/// Whether a byte may stand in a `WORD`, first or later.
fn is_word_byte(byte: u8, leading: bool) -> bool {
    let letter = (byte >= b'a' and byte <= b'z') or (byte >= b'A' and byte <= b'Z') or byte == b'_'
    return letter or (not leading and byte >= b'0' and byte <= b'9')
} is_word_byte

/// Whether an ASCII digit stands at a position.
fn is_digit_at(bytes: Slice[u8], at: usize) -> bool {
    return at < bytes.len() and bytes[at] >= b'0' and bytes[at] <= b'9'
} is_digit_at

/// Whether a byte comes next, passing over it when it does.
fn ConstructionReader.takes(mut self, byte: u8) -> bool {
    if self.input.at < self.input.bytes.len() and self.input.bytes[self.input.at] == byte {
        self.input.at += 1
        return true
    }
    return false
} ConstructionReader.takes

/// Whether a byte follows after whitespace, passing over it when it does.
fn ConstructionReader.follows(mut self, byte: u8) -> bool {
    mut self.input.space()
    return mut self.takes(byte)
} ConstructionReader.follows

/// A `WORD` after whitespace.
fn ConstructionReader.word(mut self) -> mem::Bytes fails Failure {
    let lead = try mut self.input.peek()
    if not is_word_byte(lead, leading: true) {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    var word = mem::Bytes.empty(self.input.alloc)
    while self.input.at < self.input.bytes.len() and is_word_byte(self.input.bytes[self.input.at], leading: false) {
        mut word.push(self.input.bytes[self.input.at])
        self.input.at += 1
    }
    return word
} ConstructionReader.word

/// Digits with `_` between two of them, at least one, their digits alone appended to `out`.
fn ConstructionReader.digits(mut self, mut out: mem::Bytes) fails Failure {
    if not is_digit_at(self.input.bytes.view(), at: self.input.at) {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    while self.input.at < self.input.bytes.len() {
        let byte = self.input.bytes[self.input.at]
        if byte >= b'0' and byte <= b'9' {
            mut out.push(byte)
        } else if byte != b'_' or not is_digit_at(self.input.bytes.view(), at: self.input.at + 1) {
            return
        }
        self.input.at += 1
    }
} ConstructionReader.digits

/// A number after whitespace.
fn ConstructionReader.number(mut self) -> ConstructionNumber fails Failure {
    discard try mut self.input.peek()
    var written = mem::Bytes.empty(self.input.alloc)
    if mut self.takes(b'-') {
        mut written.push(b'-')
    }
    if mut self.takes(b'0') {
        mut written.push(b'0')
    } else {
        try mut self.digits(mut written)
    }
    let point = mut self.takes(b'.')
    if point {
        mut written.push(b'.')
        try mut self.digits(mut written)
    }
    let exponent = mut self.takes(b'e')
    if exponent {
        mut written.push(b'e')
        if mut self.takes(b'-') {
            mut written.push(b'-')
        }
        let from = self.input.at
        while self.input.at < self.input.bytes.len() and self.input.bytes[self.input.at] >= b'0' and self.input.bytes[self.input.at] <= b'9' {
            mut written.push(self.input.bytes[self.input.at])
            self.input.at += 1
        }
        if self.input.at == from {
            fail Failure.Decode(DecodeKind.Malformed)
        }
    }
    return ConstructionNumber(written: take written, fractional: point or exponent)
} ConstructionReader.number

/// An integer without fraction or exponent, `-0` being 0.
fn ConstructionReader.integer(mut self) -> wide::Wide fails Failure {
    let number = try mut self.number()
    if number.fractional {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    let digits = number.written.view()
    let negative = digits.len() > 0 and digits[0] == b'-'
    var start: usize = 0
    if negative {
        start = 1
    }
    let Some(parts) = digits.split_at(start) else {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    let Ok(magnitude_text) = attempt text::String.try_from_utf8(parts.tail, alloc: self.input.alloc) else {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    let Some(magnitude) = wide::Wide.parse(magnitude_text.as_str(), radix: 10) else {
        fail Failure.Decode(DecodeKind.OutOfRange)
    }
    if negative {
        return magnitude.wrapping_neg()
    }
    return magnitude
} ConstructionReader.integer

/// After whitespace, whether `-inf` follows, passing over its `-` when it does.
fn ConstructionReader.negative_infinity(mut self) -> bool fails Failure {
    let lead = try mut self.input.peek()
    let after = self.input.at + 1
    if lead == b'-' and after < self.input.bytes.len() and self.input.bytes[after] == b'i' {
        self.input.at = after
        return true
    }
    return false
} ConstructionReader.negative_infinity

/// Hexadecimal digits up to a byte, at least `least` and at most `most` of them.
fn ConstructionReader.hex(mut self, least: usize, most: usize) -> u32 fails Failure {
    var value: u32 = 0
    for index in 0..<most {
        if self.input.at >= self.input.bytes.len() {
            fail Failure.Decode(DecodeKind.Truncated)
        }
        let Some(digit) = hex_value(self.input.bytes[self.input.at]) else {
            if index < least {
                fail Failure.Decode(DecodeKind.Malformed)
            }
            return value
        }
        value = (value << 4) | digit
        self.input.at += 1
    }
    return value
} ConstructionReader.hex

/// The value of a char, text or byte-string literal after whitespace.
fn ConstructionReader.literal(mut self, kind: ConstructionLiteral) -> mem::Bytes fails Failure {
    var quote = b'"'
    if kind == ConstructionLiteral.Char {
        quote = b'\''
    }
    if kind == ConstructionLiteral.Bytes {
        try mut self.input.expect_byte(b'b')
        if self.input.at >= self.input.bytes.len() or self.input.bytes[self.input.at] != b'"' {
            fail Failure.Decode(DecodeKind.Malformed)
        }
    }
    try mut self.input.expect_byte(quote)
    var value = mem::Bytes.empty(self.input.alloc)
    loop {
        let start = self.input.at
        if start >= self.input.bytes.len() {
            fail Failure.Decode(DecodeKind.Truncated)
        }
        let byte = self.input.bytes[start]
        self.input.at = start + 1
        if byte == quote {
            return value
        }
        if byte != b'\\' {
            if kind == ConstructionLiteral.Bytes {
                if byte < 0x20 or byte > 0x7E {
                    fail Failure.Decode(DecodeKind.Malformed)
                }
                mut value.push(byte)
                continue
            }
            try mut self.raw_char(start, lead: byte, mut value)
            continue
        }
        let scalar = try mut self.escaped(kind)
        if kind == ConstructionLiteral.Bytes {
            mut value.push(u8.truncate(scalar))
        } else {
            let Some(c) = char.checked_from_bits(scalar) else {
                fail Failure.Decode(DecodeKind.InvalidText)
            }
            push_utf8(mut value, c)
        }
    }
} ConstructionReader.literal

/// Appends the char of a text or char literal whose lead byte is at `start`, passing over it.
fn ConstructionReader.raw_char(mut self, start: usize, lead: u8, mut value: mem::Bytes) fails Failure {
    var width: usize = 4
    if lead < 0x80 {
        width = 1
    } else if lead >= 0xC2 and lead <= 0xDF {
        width = 2
    } else if lead >= 0xE0 and lead <= 0xEF {
        width = 3
    } else if lead < 0xF0 or lead > 0xF4 {
        fail Failure.Decode(DecodeKind.InvalidText)
    }
    if start > self.input.bytes.len() or width > self.input.bytes.len() - start {
        fail Failure.Decode(DecodeKind.Truncated)
    }
    let Some(upto) = self.input.bytes.view().prefix(start + width) else {
        fail Failure.Decode(DecodeKind.Truncated)
    }
    let Some(parts) = upto.split_at(start) else {
        fail Failure.Decode(DecodeKind.Truncated)
    }
    let sequence = parts.tail
    if not text::utf8::is_valid(sequence) {
        fail Failure.Decode(DecodeKind.InvalidText)
    }
    let Some(c) = text::utf8::char_at(sequence, at: 0) else {
        fail Failure.Decode(DecodeKind.InvalidText)
    }
    if c.to_bits() < 0x20 or syntax::is_rejected(c, grammar: self.grammar.contents()) {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    mut value.append(sequence)
    self.input.at = start + width
} ConstructionReader.raw_char

/// The value an escape of a literal of a kind stands for, its backslash read.
fn ConstructionReader.escaped(mut self, kind: ConstructionLiteral) -> u32 fails Failure {
    if self.input.at >= self.input.bytes.len() {
        fail Failure.Decode(DecodeKind.Truncated)
    }
    let escape = self.input.bytes[self.input.at]
    self.input.at += 1
    var scalar: u32 = 0
    if escape == b'\\' or escape == b'"' or escape == b'\'' {
        scalar = u32.widen(escape)
    } else if escape == b'n' {
        scalar = 0x0A
    } else if escape == b'r' {
        scalar = 0x0D
    } else if escape == b't' {
        scalar = 0x09
    } else if escape == b'0' {
        scalar = 0
    } else if escape == b'x' {
        scalar = try mut self.hex(least: 2, most: 2)
        if scalar > 0x7F and kind != ConstructionLiteral.Bytes {
            fail Failure.Decode(DecodeKind.Malformed)
        }
    } else if escape == b'u' and kind != ConstructionLiteral.Bytes {
        if self.input.at >= self.input.bytes.len() {
            fail Failure.Decode(DecodeKind.Truncated)
        }
        if self.input.bytes[self.input.at] != b'{' {
            fail Failure.Decode(DecodeKind.Malformed)
        }
        self.input.at += 1
        scalar = try mut self.hex(least: 1, most: 6)
        if self.input.at >= self.input.bytes.len() {
            fail Failure.Decode(DecodeKind.Truncated)
        }
        if self.input.bytes[self.input.at] != b'}' {
            fail Failure.Decode(DecodeKind.Malformed)
        }
        self.input.at += 1
    } else {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    return scalar
} ConstructionReader.escaped

/// Passes over any value, nested no deeper than decoding reads.
fn ConstructionReader.skip_value(mut self, depth: usize) fails Failure {
    let next = try mut self.input.peek()
    let after = self.input.at + 1
    if next == b'"' {
        discard try mut self.literal(ConstructionLiteral.Text)
        return
    }
    if next == b'\'' {
        discard try mut self.read_char()
        return
    }
    if next == b'b' and after < self.input.bytes.len() and self.input.bytes[after] == b'"' {
        discard try mut self.literal(ConstructionLiteral.Bytes)
        return
    }
    if next == b'[' or next == b'{' {
        if depth >= DECODE_DEPTH_LIMIT {
            fail Failure.Decode(DecodeKind.TooDeep)
        }
        let map = next == b'{'
        var close = b']'
        if map {
            close = b'}'
        }
        self.input.at = after
        mut self.frames.push(ConstructionFrame.Elements(close: close, owned: true, started: false))
        while try mut self.next_follows() {
            try mut self.skip_value(depth + 1)
            if map {
                try mut self.input.expect_byte(b':')
                try mut self.skip_value(depth + 1)
            }
        }
        try mut self.end()
        return
    }
    if is_word_byte(next, leading: true) {
        discard try mut self.word()
        if mut self.follows(b'.') {
            discard try mut self.word()
        }
        if not mut self.follows(b'(') {
            return
        }
        if depth >= DECODE_DEPTH_LIMIT {
            fail Failure.Decode(DecodeKind.TooDeep)
        }
        mut self.frames.push(ConstructionFrame.Elements(close: b')', owned: true, started: false))
        while try mut self.next_follows() {
            let at = self.input.at
            let worded = attempt mut self.word()
            var labelled = false
            if worded.is_ok() {
                labelled = mut self.follows(b':')
            }
            if not labelled {
                self.input.at = at
            }
            try mut self.skip_value(depth + 1)
        }
        try mut self.end()
        return
    }
    if try mut self.negative_infinity() {
        let word = try mut self.word()
        if word.view() != b"inf" {
            fail Failure.Decode(DecodeKind.Malformed)
        }
        return
    }
    discard try mut self.number()
} ConstructionReader.skip_value

/// Pushes a frame of elements up to a closing byte.
fn ConstructionReader.elements(mut self, close: u8, owned: bool) {
    mut self.frames.push(ConstructionFrame.Elements(close: close, owned: owned, started: false))
} ConstructionReader.elements

fn ConstructionReader.read_bool(mut self) -> bool fails Failure {
    let word = try mut self.word()
    if word.view() == b"true" {
        return true
    }
    if word.view() == b"false" {
        return false
    }
    fail Failure.Decode(DecodeKind.Malformed)
} ConstructionReader.read_bool

fn ConstructionReader.read_unsigned(mut self) -> u64 fails Failure {
    let value = try mut self.integer()
    let Some(unsigned) = value.to_u64() else {
        fail Failure.Decode(DecodeKind.OutOfRange)
    }
    return unsigned
} ConstructionReader.read_unsigned

fn ConstructionReader.read_signed(mut self) -> i64 fails Failure {
    let value = try mut self.integer()
    let Some(signed) = value.to_i64() else {
        fail Failure.Decode(DecodeKind.OutOfRange)
    }
    return signed
} ConstructionReader.read_signed

fn ConstructionReader.read_float(mut self) -> f64 fails Failure {
    let negative = try mut self.negative_infinity()
    let lead = try mut self.input.peek()
    if negative or is_word_byte(lead, leading: true) {
        let word = try mut self.word()
        if not negative and word.view() == b"NaN" {
            return f64.from_bits(0x7FF8_0000_0000_0000)
        }
        if word.view() == b"inf" {
            if negative {
                return f64.from_bits(0xFFF0_0000_0000_0000)
            }
            return f64.from_bits(0x7FF0_0000_0000_0000)
        }
        fail Failure.Decode(DecodeKind.Malformed)
    }
    let number = try mut self.number()
    return json_float(number.written.view(), alloc: self.input.alloc)
} ConstructionReader.read_float

fn ConstructionReader.read_char(mut self) -> u32 fails Failure {
    let written = try mut self.literal(ConstructionLiteral.Char)
    let Some(c) = text::utf8::char_at(written.view(), at: 0) else {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    if c.utf8_len() != written.len() {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    return c.to_bits()
} ConstructionReader.read_char

fn ConstructionReader.read_text(mut self) -> mem::Bytes fails Failure {
    return try mut self.literal(ConstructionLiteral.Text)
} ConstructionReader.read_text

fn ConstructionReader.read_bytes(mut self) -> mem::Bytes fails Failure {
    return try mut self.literal(ConstructionLiteral.Bytes)
} ConstructionReader.read_bytes

fn ConstructionReader.begin_sequence(mut self) fails Failure {
    try mut self.input.expect_byte(b'[')
    mut self.elements(close: b']', owned: true)
} ConstructionReader.begin_sequence

fn ConstructionReader.begin_map(mut self) fails Failure {
    try mut self.input.expect_byte(b'{')
    mut self.elements(close: b'}', owned: true)
} ConstructionReader.begin_map

fn ConstructionReader.begin_record(mut self) fails Failure {
    discard try mut self.word()
    if mut self.follows(b'(') {
        mut self.elements(close: b')', owned: true)
    } else {
        mut self.frames.push(ConstructionFrame.Bare)
    }
} ConstructionReader.begin_record

fn ConstructionReader.begin_labelled(mut self) {
    mut self.elements(close: b')', owned: false)
} ConstructionReader.begin_labelled

fn ConstructionReader.next_follows(mut self) -> bool fails Failure {
    let count = self.frames.len()
    if count == 0 {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    match self.frames[count - 1] {
        ConstructionFrame.Bare => return false
        ConstructionFrame.Elements(close: close, owned: owned, started: started) => {
            self.frames[count - 1] = ConstructionFrame.Elements(close: close, owned: owned, started: true)
            let next = try mut self.input.peek()
            if next == close {
                return false
            }
            if started {
                try mut self.input.expect_byte(b',')
            }
            return true
        }
        ConstructionFrame.Variant(payload: _) => fail Failure.Decode(DecodeKind.Malformed)
    }
} ConstructionReader.next_follows

fn ConstructionReader.map_value(mut self) fails Failure {
    try mut self.input.expect_byte(b':')
} ConstructionReader.map_value

fn ConstructionReader.read_key(mut self) -> mem::Bytes fails Failure {
    let key = try mut self.word()
    try mut self.input.expect_byte(b':')
    return key
} ConstructionReader.read_key

fn ConstructionReader.read_variant(mut self) -> mem::Bytes fails Failure {
    var key = try mut self.word()
    if mut self.follows(b'.') {
        key = try mut self.word()
    }
    mut self.frames.push(ConstructionFrame.Variant(payload: false))
    return key
} ConstructionReader.read_variant

fn ConstructionReader.payload_follows(mut self) -> bool fails Failure {
    let follows = mut self.follows(b'(')
    let count = self.frames.len()
    if count > 0 {
        match self.frames[count - 1] {
            ConstructionFrame.Variant(payload: _) => {
                self.frames[count - 1] = ConstructionFrame.Variant(payload: follows)
                return follows
            }
            else => {}
        }
    }
    fail Failure.Decode(DecodeKind.Malformed)
} ConstructionReader.payload_follows

fn ConstructionReader.skip(mut self, depth: usize) fails Failure {
    try mut self.skip_value(depth)
} ConstructionReader.skip

fn ConstructionReader.end(mut self) fails Failure {
    let Some(frame) = mut self.frames.pop() else {
        fail Failure.Decode(DecodeKind.Malformed)
    }
    match frame {
        ConstructionFrame.Elements(close: close, owned: owned, started: _) => {
            if owned {
                try mut self.input.expect_byte(close)
            }
        }
        ConstructionFrame.Variant(payload: payload) => {
            if payload {
                try mut self.input.expect_byte(b')')
            }
        }
        ConstructionFrame.Bare => {}
    }
} ConstructionReader.end

fn ConstructionReader.finish(mut self) fails Failure {
    mut self.input.space()
    if self.input.at != self.input.bytes.len() {
        fail Failure.Decode(DecodeKind.Trailing)
    }
} ConstructionReader.finish
