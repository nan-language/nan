//! The bindings of an item: the names its parameters, patterns, statements, closures, quantifiers and loops introduce, and the tokens naming each.

pkg struct Bindings {
    /// The token of each binding's first introduction, by each token introducing or naming it.
    pkg of: mem::HashMap[u32, u32]
    /// The first introductions of the item's own parameters.
    pkg parameters: mem::HashMap[u32, Unit]
} Bindings

/// The bindings of an item's tree.
pkg fn Bindings.collect(file: syntax::SourceFile, tree: syntax::Tree, alloc: mem::Alloc) -> Bindings {
    var walk = BindingWalk(scopes: mem::List[mem::List[u32]].empty(alloc), labels: mem::List[u32].empty(alloc), found: Bindings(of: mem::HashMap[u32, u32].empty(seed: 0, alloc), parameters: mem::HashMap[u32, Unit].empty(seed: 0, alloc)), alloc: alloc)
    var steps = mem::List[Step].empty(alloc)
    mut steps.push(Step.Node(tree.root()))
    loop {
        let Some(step) = mut steps.pop() else {
            return walk.found
        }
        match step {
            Step.Node(node) => mut walk.node(file, tree, node, mut steps)
            Step.Push(tokens) => {
                mut walk.scopes.push(mem::List[u32].empty(alloc))
                mut walk.introduce(file, tokens)
            }
            Step.Pop => {
                discard mut walk.scopes.pop()
            }
            Step.Bind(statement) => {
                let tokens = walk.bound(file, tree, statement)
                mut walk.introduce(file, tokens)
            }
            Step.Label(token) => {
                discard mut walk.found.of.insert(token, value: token)
                mut walk.labels.push(token)
            }
            Step.Unlabel => {
                discard mut walk.labels.pop()
            }
        }
    }
} Bindings.collect

/// A step of the walk, taken once the steps before it are done.
enum Step {
    Node(u32)
    /// Opens a scope introducing the names of these tokens.
    Push(mem::List[u32])
    Pop
    /// Introduces the names a statement binds into the innermost scope.
    Bind(u32)
    /// Opens the loop labelled by this token.
    Label(u32)
    Unlabel
} Step

/// Pushes the steps walking each child node of `node`, the first on top.
fn push_children(tree: syntax::Tree, node: u32, mut steps: mem::List[Step]) {
    let children = tree.children(node)
    for index in 0..<children.len() {
        match children[children.len() - 1 - index] {
            syntax::Child.Node(child) => mut steps.push(Step.Node(child))
            syntax::Child.Token(_) => {}
        }
    }
} push_children

/// Pushes the steps walking the child nodes of `node` in a scope introducing the names of
/// `tokens`.
fn push_scoped(take tokens: mem::List[u32], tree: syntax::Tree, node: u32, mut steps: mem::List[Step]) {
    mut steps.push(Step.Pop)
    push_children(tree, node, mut steps)
    mut steps.push(Step.Push(take tokens))
} push_scoped

/// The state of a walk over an item's tree.
struct BindingWalk {
    /// The first introductions of the names each open scope introduces, innermost last.
    scopes: mem::List[mem::List[u32]]
    /// The labels of the loops open, innermost last.
    labels: mem::List[u32]
    found: Bindings
    alloc: mem::Alloc
} BindingWalk

/// Introduces names into the innermost scope; a name it already introduces, as the
/// alternatives of a match arm do, stays one binding.
fn BindingWalk.introduce(mut self, file: syntax::SourceFile, tokens: mem::List[u32]) {
    for token in tokens {
        let name = file.text(usize.widen(token))
        let depth = self.scopes.len()
        expect depth > 0
        var introduced: Option[u32] = None
        for bound in self.scopes[depth - 1] {
            if file.text(usize.widen(bound)) == name {
                introduced = Some(bound)
                break
            }
        }
        var origin = token
        match introduced {
            Some(bound) => {
                origin = bound
            }
            None => mut (mut self.scopes.at_mut(depth - 1)).push(token)
        }
        discard mut self.found.of.insert(token, value: origin)
    }
} BindingWalk.introduce

/// Records a token naming the binding of its name in scope, if any.
fn BindingWalk.name(mut self, file: syntax::SourceFile, token: u32) {
    let name = file.text(usize.widen(token))
    for back in 1..=self.scopes.len() {
        for bound in self.scopes[self.scopes.len() - back] {
            if file.text(usize.widen(bound)) == name {
                discard mut self.found.of.insert(token, value: bound)
                return
            }
        }
    }
} BindingWalk.name

/// Pushes the steps walking a node, the first on top.
fn BindingWalk.node(mut self, file: syntax::SourceFile, tree: syntax::Tree, node: u32, mut steps: mem::List[Step]) {
    match first tree.rule(node) {
        syntax::Rule.FnItem or syntax::Rule.TestItem or syntax::Rule.InterfaceMember or syntax::Rule.ProtocolOperation or syntax::Rule.RetiredItem => {
            let parameters = self.parameters(file, tree, node)
            for parameter in parameters {
                discard mut self.found.parameters.insert(parameter, value: Unit)
            }
            push_scoped(take parameters, tree, node, mut steps)
        }
        syntax::Rule.ClosureExpr => push_scoped(self.parameters(file, tree, node), tree, node, mut steps)
        syntax::Rule.Block or syntax::Rule.LoopBlock or syntax::Rule.FnBody or syntax::Rule.MethodBody or syntax::Rule.TrustedBody => push_block(tree, node, mut steps, alloc: self.alloc)
        syntax::Rule.ForStmt => self.push_for(file, tree, node, mut steps)
        syntax::Rule.LoopStmt => push_loop(file, tree, node, mut steps)
        syntax::Rule.JumpExpr => {
            mut self.jump(file, tree, node)
            push_children(tree, node, mut steps)
        }
        syntax::Rule.MatchArm => {
            var tokens = mem::List[u32].empty(self.alloc)
            for child in tree.child_nodes(node) {
                if tree.rule(child) == syntax::Rule.Pattern {
                    for token in self.pattern_names(file, tree, pattern: child) {
                        mut tokens.push(token)
                    }
                }
            }
            push_scoped(take tokens, tree, node, mut steps)
        }
        syntax::Rule.QuantifierExpr => push_quantifier(tree, node, mut steps, alloc: self.alloc)
        syntax::Rule.Arg or syntax::Rule.FieldPattern if two_child_nodes(tree, node).is_some() => {
            let Some(pair) = two_child_nodes(tree, node) else {
                return
            }
            mut steps.push(Step.Node(pair.latter))
        }
        syntax::Rule.Path or syntax::Rule.PlaceRoot => {
            let held = tree.children(node)
            if held.len() == 1 {
                match held[0] {
                    syntax::Child.Token(token) => {
                        if is_ident(file, token) {
                            mut self.name(file, token)
                        }
                    }
                    syntax::Child.Node(_) => {
                    }
                }
            }
        }
        else => push_children(tree, node, mut steps)
    }
} BindingWalk.node

/// The two child nodes of a node that has exactly two.
struct ChildPair derives Copy {
    former: u32
    latter: u32
} ChildPair

fn two_child_nodes(tree: syntax::Tree, node: u32) -> Option[ChildPair] {
    var nodes = tree.child_nodes(node)
    let Some(former) = mut nodes.next() else {
        return None
    }
    let Some(latter) = mut nodes.next() else {
        return None
    }
    let beyond = mut nodes.next()
    if beyond.is_some() {
        return None
    }
    return Some(ChildPair(former: former, latter: latter))
} two_child_nodes

/// Pushes the steps walking a block: a scope in which each statement's bindings follow it.
fn push_block(tree: syntax::Tree, node: u32, mut steps: mem::List[Step], alloc: mem::Alloc) {
    mut steps.push(Step.Pop)
    let children = tree.children(node)
    for index in 0..<children.len() {
        let syntax::Child.Node(child) = children[children.len() - 1 - index] else {
            continue
        }
        let rule = tree.rule(child)
        if rule == syntax::Rule.Stmt or rule == syntax::Rule.TrustedLeadStmt {
            var nodes = tree.child_nodes(child)
            match mut nodes.next() {
                Some(statement) => mut steps.push(Step.Bind(statement))
                None => {
                }
            }
        }
        mut steps.push(Step.Node(child))
    }
    mut steps.push(Step.Push(mem::List[u32].empty(alloc)))
} push_block

/// Pushes the steps walking a `for` statement: its body in a scope introducing its pattern's
/// names.
fn BindingWalk.push_for(self, file: syntax::SourceFile, tree: syntax::Tree, node: u32, mut steps: mem::List[Step]) {
    var tokens = mem::List[u32].empty(self.alloc)
    match tree.find(node, rule: syntax::Rule.Pattern) {
        Some(pattern) => {
            tokens = self.pattern_names(file, tree, pattern)
        }
        None => {
        }
    }
    let children = tree.children(node)
    mut steps.push(Step.Pop)
    for index in 0..<children.len() {
        match children[children.len() - 1 - index] {
            syntax::Child.Node(child) => if tree.rule(child) == syntax::Rule.LoopBlock {
                mut steps.push(Step.Node(child))
            }
            syntax::Child.Token(_) => {}
        }
    }
    mut steps.push(Step.Push(take tokens))
    for index in 0..<children.len() {
        match children[children.len() - 1 - index] {
            syntax::Child.Node(child) => if tree.rule(child) != syntax::Rule.LoopBlock {
                mut steps.push(Step.Node(child))
            }
            syntax::Child.Token(_) => {}
        }
    }
} BindingWalk.push_for

/// Pushes the steps walking a `loop` statement, its label open while its body is walked.
fn push_loop(file: syntax::SourceFile, tree: syntax::Tree, node: u32, mut steps: mem::List[Step]) {
    var label: Option[u32] = None
    var first_seen = false
    for token in tree.child_tokens(node) {
        if is_ident(file, token) {
            if first_seen {
                label = Some(token)
                break
            }
            first_seen = true
        }
    }
    if label.is_some() {
        mut steps.push(Step.Unlabel)
    }
    push_children(tree, node, mut steps)
    match label {
        Some(token) => mut steps.push(Step.Label(token))
        None => {
        }
    }
} push_loop

/// Records the label a `break` or `continue` names as naming the loop open with that label.
fn BindingWalk.jump(mut self, file: syntax::SourceFile, tree: syntax::Tree, node: u32) {
    let tokens = child_token_list(tree, node, alloc: self.alloc)
    expect tokens.len() > 0
    let jump = match token_kind(file, token: tokens[0]) {
        syntax::TokenKind.Keyword(syntax::Keyword.Break) or syntax::TokenKind.Keyword(syntax::Keyword.Continue) => true
        else => false
    }
    if not jump or tokens.len() < 2 {
        return
    }
    let label = tokens[1]
    for back in 1..=self.labels.len() {
        let open = self.labels[self.labels.len() - back]
        if file.text(usize.widen(open)) == file.text(usize.widen(label)) {
            discard mut self.found.of.insert(label, value: open)
            return
        }
    }
} BindingWalk.jump

/// Pushes the steps walking a quantifier: its domain, then its condition in a scope
/// introducing its variable.
fn push_quantifier(tree: syntax::Tree, node: u32, mut steps: mem::List[Step], alloc: mem::Alloc) {
    let Some(pair) = two_child_nodes(tree, node) else {
        return
    }
    var variable = mem::List[u32].empty(alloc)
    var tokens = tree.child_tokens(node)
    discard mut tokens.next()
    match mut tokens.next() {
        Some(token) => mut variable.push(token)
        None => {
        }
    }
    mut steps.push(Step.Pop)
    mut steps.push(Step.Node(pair.latter))
    mut steps.push(Step.Push(take variable))
    mut steps.push(Step.Node(pair.former))
} push_quantifier

/// The name tokens of the parameters a function, test, interface method, operation,
/// tombstone or closure declares.
fn BindingWalk.parameters(self, file: syntax::SourceFile, tree: syntax::Tree, node: u32) -> mem::List[u32] {
    let alloc = self.alloc
    let params = match tree.rule(node) {
        syntax::Rule.FnItem => tree.list_elements(find_in(tree, node: tree.find(node, rule: syntax::Rule.FnHead), rule: syntax::Rule.ParamList), element: syntax::Rule.Param, alloc)
        syntax::Rule.TestItem => tree.list_elements(find_in(tree, node: tree.find(node, rule: syntax::Rule.TestParams), rule: syntax::Rule.ParamList), element: syntax::Rule.Param, alloc)
        syntax::Rule.InterfaceMember => tree.list_elements(tree.find(node, rule: syntax::Rule.ParamList), element: syntax::Rule.Param, alloc)
        syntax::Rule.ProtocolOperation => tree.list_elements(tree.find(node, rule: syntax::Rule.OperationParams), element: syntax::Rule.OperationParam, alloc)
        syntax::Rule.RetiredItem => tree.list_elements(find_in(tree, node: find_in(tree, node: tree.find(node, rule: syntax::Rule.RetiredOld), rule: syntax::Rule.RetiredHead), rule: syntax::Rule.ParamList), element: syntax::Rule.Param, alloc)
        else => tree.list_elements(tree.find(node, rule: syntax::Rule.FnTypeParamList), element: syntax::Rule.FnTypeParam, alloc)
    }
    var names = mem::List[u32].empty(alloc)
    for param in params {
        for token in tree.child_tokens(param) {
            if is_ident(file, token) {
                mut names.push(token)
                break
            }
        }
    }
    return names
} BindingWalk.parameters

/// The name tokens a `let` or `var` statement binds.
fn BindingWalk.bound(self, file: syntax::SourceFile, tree: syntax::Tree, statement: u32) -> mem::List[u32] {
    let alloc = self.alloc
    var names = mem::List[u32].empty(alloc)
    let rule = tree.rule(statement)
    if rule == syntax::Rule.LetStmt {
        match tree.find(statement, rule: syntax::Rule.Pattern) {
            Some(pattern) => {
                names = self.pattern_names(file, tree, pattern)
            }
            None => {
            }
        }
    } else if rule == syntax::Rule.VarStmt {
        for token in tree.child_tokens(statement) {
            if is_ident(file, token) {
                mut names.push(token)
                break
            }
        }
    }
    return names
} BindingWalk.bound

/// The name tokens of the bindings a pattern introduces: a lone lowercase name, and those
/// of its field patterns.
fn BindingWalk.pattern_names(self, file: syntax::SourceFile, tree: syntax::Tree, pattern: u32) -> mem::List[u32] {
    let alloc = self.alloc
    var names = mem::List[u32].empty(alloc)
    var pending = mem::List[u32].empty(alloc)
    mut pending.push(pattern)
    loop {
        let Some(current) = mut pending.pop() else {
            return names
        }
        let Some(named) = tree.find(current, rule: syntax::Rule.NamedPattern) else {
            continue
        }
        match lone_binding(file, tree, named) {
            Some(token) => {
                mut names.push(token)
                continue
            }
            None => {
            }
        }
        let fields = tree.list_elements(tree.find(named, rule: syntax::Rule.FieldPatternList), element: syntax::Rule.FieldPattern, alloc)
        for back in 1..=fields.len() {
            var last: Option[u32] = None
            for child in tree.child_nodes(fields[fields.len() - back]) {
                last = Some(child)
            }
            let Some(inner) = last else {
                expect false
                return names
            }
            mut pending.push(inner)
        }
    }
} BindingWalk.pattern_names

/// The token of a named pattern that is a lone path of one token starting lowercase or with
/// `_`.
fn lone_binding(file: syntax::SourceFile, tree: syntax::Tree, named: u32) -> Option[u32] {
    let held = tree.children(named)
    if held.len() != 1 {
        return None
    }
    let syntax::Child.Node(path) = held[0] else {
        return None
    }
    let inner = tree.children(path)
    if inner.len() != 1 {
        return None
    }
    let syntax::Child.Token(token) = inner[0] else {
        return None
    }
    let spelt = file.text(usize.widen(token)).as_bytes()
    if spelt.len() > 0 and ((spelt[0] >= b'a' and spelt[0] <= b'z') or spelt[0] == b'_') {
        return Some(token)
    }
    return None
} lone_binding
