//! Targets and programs: the targets each dependency covers, dependencies on programs, the one concrete target a program declares and the head of its entry function.

/// The rules of a package's `targets`, `entry` and `dep` directives: a program declares one
/// concrete target and an entry function `main` of its root module, and each dependency in
/// the workspace covers every target the package declares and is no program, unless its
/// `dep` directive lacks a grant its package needs; a failed `targets` directive declares
/// unknown targets, which satisfy the rules of targets.
fn Checker.check_program(self, package_id: ty::PackageId) {
    let source = self.db().source(package_id)
    let Some(manifest) = source.manifest else {
        return
    }
    let Some(manifest_file) = source.files.get(0) else {
        expect false
        return
    }
    let path = manifest_file.path.as_str()
    match manifest.entry {
        Some(entry) => self.check_program_entry(package_id, manifest, entry, path)
        None => {}
    }
    for dep in manifest.deps {
        self.check_dependency_targets(package_id, manifest, dep, path)
    }
} Checker.check_program

/// Judges under the checker's concrete target each item of a package declaring `any` within
/// the reach of the final build of each program it checks, from the program's entry items and
/// the admitted contributions to platform registries.
fn Checker.judge_build_reaches(self) {
    let db = self.db()
    let alloc = self.alloc()
    if db.target == workspace::Target.Any {
        return
    }
    var sharing = false
    for index in 0..<db.packages.len() {
        sharing = sharing or self.is_shared(ty::PackageId(index: u32.fit(index)))
    }
    if not sharing {
        return
    }
    for program in self.packages_checked() {
        let Some(manifest) = db.source(program).manifest else {
            continue
        }
        let Some(entry) = manifest.entry else {
            continue
        }
        let Some(module) = db.package_data(program).root else {
            continue
        }
        var admitted = mem::List[Contribution].empty(alloc)
        for contribution in self.contributions(program) {
            if contribution.admitted {
                mut admitted.push(contribution)
            }
        }
        var roots = mem::List[ty::ItemId].empty(alloc)
        for name in entry.names {
            match db.lookup(module, name: name.as_str()) {
                Some(named) => mut roots.push(named)
                None => {}
            }
        }
        for contribution in admitted {
            if self.is_platform_contribution(contribution.item) {
                mut roots.push(contribution.item)
            }
        }
        self.judge_reach(take roots, admitted: admitted.view())
    }
} Checker.judge_build_reaches

/// Judges each item of a package declaring `any` that `roots` reach: each item a reached item's
/// unit names, the impl lines of each reached type and the `admitted` contributions to each
/// reached registry, an item of the carried std or of a quiet package adding only itself.
fn Checker.judge_reach(self, take roots: mem::List[ty::ItemId], admitted: Slice[Contribution]) {
    let db = self.db()
    let alloc = self.alloc()
    var pending = roots
    var reach = mem::Set[ty::ItemId].empty(alloc)
    loop {
        let Some(item) = mut pending.pop() else {
            return
        }
        if not mut reach.insert(item) or not db.is_reported(item) {
            continue
        }
        if self.is_shared(db.package_of(item)) {
            self.judge_alone(item)
        }
        if self.rejected(item) {
            continue
        }
        match db.declaration(item).kind {
            ast::ItemKind.Struct(_) or ast::ItemKind.Enum(_) or ast::ItemKind.Layout(_) => {
                for line in self.impl_lines(TypeKey.Item(item)) {
                    mut pending.push(line)
                }
            }
            ast::ItemKind.Impl(_) => {
                for named in self.names(item).contents() {
                    mut pending.push(named)
                }
            }
            ast::ItemKind.Registry(_) => {
                for contribution in admitted {
                    if contribution.registry_item == item {
                        mut pending.push(contribution.item)
                    }
                }
            }
            else => {}
        }
        match self.unit(item) {
            Some(unit) => {
                for named in named_items(self.types(), unit: unit.contents(), alloc) {
                    mut pending.push(named)
                }
            }
            None => {}
        }
    }
} Checker.judge_reach

/// Whether a package of the checker's closure that it reports on declares `any`.
fn Checker.is_shared(self, package_id: ty::PackageId) -> bool {
    let db = self.db()
    let data = db.package_data(package_id)
    if data.carried or data.quiet {
        return false
    }
    let targets = check_targets(db.source(package_id), alloc: self.alloc())
    return targets.len() == 1 and targets[0] == workspace::Target.Any
} Checker.is_shared

/// The `entry` directive of a program: one concrete target declared, and `main` naming a
/// function of its root module or component entries.
fn Checker.check_program_entry(self, package_id: ty::PackageId, manifest: workspace::Manifest, entry: workspace::ProgramEntry, path: Str) {
    let db = self.db()
    let concrete = manifest.targets.len() == 1 and manifest.targets[0] != workspace::Target.Any
    if manifest.targets_line.is_some() and not manifest.targets_failed and not concrete {
        self.report_file(path, line: entry.line, code: diagnostic::Code.TargetProgramTargets)
    }
    let Some(module) = db.package_data(package_id).root else {
        return
    }
    if db.module(module).abandoned {
        return
    }
    match self.entry_problem(module, names: entry.names.view()) {
        Some(code) => self.report_file(path, line: entry.line, code)
        None => {}
    }
} Checker.check_program_entry

/// The rule an `entry` directive listing `names` of a root module breaks: `main` alone names
/// a function item `main`, and other names, on a nanos target, each name a component entry.
fn Checker.entry_problem(self, module: ty::ModuleId, names: Slice[text::String]) -> Option[diagnostic::Code] {
    let db = self.db()
    if names.len() == 1 and names[0].as_str() == "main" {
        let found = match db.lookup(module, name: "main") {
            Some(main_item) => is_fn_item(db.ast(main_item))
            None => false
        }
        if found {
            return None
        }
        return Some(diagnostic::Code.TargetEntryMissing)
    }
    var problem: Option[diagnostic::Code] = None
    for name in names {
        let Some(state) = db.lookup(module, name: name.as_str()) else {
            return Some(diagnostic::Code.TargetEntryMissing)
        }
        let typed = match db.ast(state).kind {
            ast::ItemKind.Struct(_) or ast::ItemKind.Enum(_) => true
            else => false
        }
        if not typed or not db.target.is_nanos() {
            return Some(diagnostic::Code.TargetEntryMissing)
        }
        if not self.is_component_entry(state) {
            problem = Some(diagnostic::Code.TargetComponentEntry)
        }
    }
    return problem
} Checker.entry_problem

/// Whether a type item is a component entry: a state without generic parameters of a
/// component serving a protocol, whose Env is not linear and implements `nanos::Environment`.
fn Checker.is_component_entry(self, state: ty::ItemId) -> bool {
    if self.sig(state).contents().generics.len() > 0 {
        return false
    }
    let state_ty = self.types().item(state, args: mem::List[ty::Arg].empty(self.alloc()))
    let Some(served) = self.component_of(state_ty) else {
        return false
    }
    let protocol = match self.types().kind(served.message) {
        ty::TyKind.Item(item: item, args: _) => self.is_protocol(item)
        else => false
    }
    let built = match self.db().std_item("nanos", name: "Environment") {
        Some(environment) => self.implements(served.env, interface_item: environment)
        None => false
    }
    return protocol and built and not self.has(served.env, property: Property.Linear)
} Checker.is_component_entry

/// A `dep` directive naming a workspace package: the dependency covers every target the
/// package declares and is no program, unless the directive lacks a grant its package needs.
fn Checker.check_dependency_targets(self, package_id: ty::PackageId, manifest: workspace::Manifest, dep: workspace::Dep, path: Str) {
    let db = self.db()
    let Some(found) = db.package_data(package_id).deps.get(dep.alias) else {
        return
    }
    let Some(dependency) = found else {
        return
    }
    let Some(declared) = db.source(dependency).manifest else {
        return
    }
    if declared.targets_line.is_none() or self.ungranted(package_id, alias: dep.alias.as_str()).len() > 0 {
        return
    }
    var covers = true
    let failed = manifest.targets_failed or declared.targets_failed
    for target in manifest.targets {
        if not failed and not holds_target(declared.targets.view(), wanted: target) and not holds_target(declared.targets.view(), wanted: workspace::Target.Any) {
            covers = false
            break
        }
    }
    if not covers {
        self.report_file(path, line: dep.line, code: diagnostic::Code.TargetDependencyUncovered)
    } else if declared.entry.is_some() {
        self.report_file(path, line: dep.line, code: diagnostic::Code.TargetDepProgram)
    }
} Checker.check_dependency_targets

/// Whether a list of targets holds one.
fn holds_target(targets: Slice[workspace::Target], wanted: workspace::Target) -> bool {
    for target in targets {
        if target == wanted {
            return true
        }
    }
    return false
} holds_target

/// The head of a program's entry function: one of its target's forms, quoted as expected,
/// unless a rule of heads reports it.
fn Checker.check_entry_head(self, item: ty::ItemId) {
    let db = self.db()
    let types = self.types()
    let node = db.ast(item)
    let ast::ItemKind.Fn(function) = node.kind else {
        return
    }
    let Some(sig) = self.fn_sig(item) else {
        return
    }
    if sig.has_error(types) or self.reported_at(item, token: node.token) {
        return
    }
    let Some(kind) = db.target.kind() else {
        return
    }
    let host_forms = "fn main(take P: host::World) fails E uses wait or fn main(take P: host::World) -> u8 fails E uses wait"
    let forms = match kind {
        workspace::Kind.Linux or workspace::Kind.Windows => host_forms
        workspace::Kind.Uefi => "fn main(take P: boot::Machine) -> Never"
        workspace::Kind.Bare => "fn main(take P: boot::Kernel) -> Never"
        workspace::Kind.Nanos => "fn main(take P: nanos::World, take I: In) -> Out fails E uses wait, In and Out implementing Encode, or fn main(take P: host::World) fails E uses wait or fn main(take P: host::World) -> u8 fails E uses wait"
    }
    let waits = self.entry_failure(sig.failure) and sig.wait
    let host = sig.params.len() == 1 and self.taken(sig, index: 0, grant: "host::World") and (sig.result == ty::Ty.unit() or sig.result == ty::Ty.scalar(ty::Scalar.Unsigned8)) and waits
    let rest = match kind {
        workspace::Kind.Linux or workspace::Kind.Windows => host
        workspace::Kind.Nanos => host or self.job_head(sig, waits)
        workspace::Kind.Uefi => self.machine_head(sig, grant: "boot::Machine")
        workspace::Kind.Bare => self.machine_head(sig, grant: "boot::Kernel")
    }
    let shaped = node.visibility == ast::Visibility.Private and function.modifier.is_none() and function.head.generics.len() == 0 and rest
    if not shaped {
        let last = Clauses.of(function.head, fixable: false).last
        let found = self.written(item, head: node.token, last)
        self.report_expected(item, token: node.token, code: diagnostic::Code.TargetEntryHead, expected: text::String.of(forms, alloc: self.alloc()), found: take found)
    }
} Checker.check_entry_head

/// Whether an entry head's parameter at an index exists and takes a std type, not as `self`.
fn Checker.taken(self, sig: FnSig, index: usize, grant: Str) -> bool {
    if index >= sig.params.len() {
        return false
    }
    return sig.params[index].mode == ast::Mode.Take and not sig.params[index].is_self and self.is_std(sig.params[index].ty, path: grant)
} Checker.taken

/// Whether an entry head has a machine target's form: one taken parameter, the root grant, and
/// the result `Never`, without a `fails` or `uses wait` clause.
fn Checker.machine_head(self, sig: FnSig, grant: Str) -> bool {
    return self.taken(sig, index: 0, grant) and sig.params.len() == 1 and sig.result == ty::Ty.never() and sig.failure.is_none() and not sig.wait
} Checker.machine_head

/// Whether an entry head has the typed job form of the nanos targets: the root grant and a taken
/// input, each of input and result implementing `Encode`, failing and waiting as a host entry.
fn Checker.job_head(self, sig: FnSig, waits: bool) -> bool {
    let Some(encode) = self.db().core_item("Encode") else {
        return false
    }
    if sig.params.len() != 2 or not waits or not self.taken(sig, index: 0, grant: "nanos::World") {
        return false
    }
    return sig.params[1].mode == ast::Mode.Take and self.implements(sig.params[1].ty, interface_item: encode) and self.implements(sig.result, interface_item: encode)
} Checker.job_head

/// Whether an entry function's failure type is an enum implementing `Render`, or
/// `task::Cancelled`.
fn Checker.entry_failure(self, failure: Option[ty::Ty]) -> bool {
    let Some(failure_ty) = failure else {
        return false
    }
    let types = self.types()
    let db = self.db()
    var rendered_enum = false
    match types.kind(failure_ty) {
        ty::TyKind.Item(item: failure_item, args: _) => {
            match db.ast(failure_item).kind {
                ast::ItemKind.Enum(_) => {
                    rendered_enum = match db.core_item("Render") {
                        Some(render) => self.implements(failure_ty, interface_item: render)
                        None => false
                    }
                }
                else => {}
            }
        }
        else => {}
    }
    return rendered_enum or self.is_std(failure_ty, path: "task::Cancelled")
} Checker.entry_failure
