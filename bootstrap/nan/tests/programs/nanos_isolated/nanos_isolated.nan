//! Runs the jobs of nanos bundles in isolated spaces, serving their logs and standard streams on the serial port and their random source from a counter through system calls: a typed job using floats and lanes, an input it does not decode, a host program, jobs that trap, fail and return, a job reading kernel memory, a job recursing past the stack it starts with, a job holding memory within the frames its space draws from and past them, a space drawing and giving back pages of its boot area, a job exchanging lines with the kernel over the channels of its link, woken by its doorbell, instances of a component whose calls, keyed tasks and checkpoints run in their spaces, with logs crossing into and out of them and a runner the kernel serves, one ending trapped and one abandoned, a space's runtime probing kernel memory, and a job spinning on floats while a job of the shared space does.

registers Uart {
    data: u8 at 0x0 write
} Uart

registers Selector {
    key: u16 at 0x0 write
} Selector

registers Data {
    byte: u8 at 0x0 read
} Data

/// The fw_cfg key of the file directory, and the bytes of a file's name in it.
const DIRECTORY: u16 = 0x19

const NAME_BYTES: usize = 56

/// The public key of the seed of 32 bytes 7, with which the harness signs the bundles.
const SIGNER: Slice[u8] = b"\xEA\x4A\x6C\x63\xE2\x9C\x52\x0A\xBE\xF5\x50\x7B\x13\x2E\xC5\xF9\x95\x47\x76\xAE\xBE\xBE\x7B\x92\x42\x1E\xEA\x69\x14\x46\xD2\x2C"

/// What the typed job is asked and what it answers, as it declares them.
pub closed struct Readings derives Encode {
    pub values: mem::List[u32]
} Readings

pub closed struct Summary derives Encode {
    pub mean_milli: u64
    pub lanes: u64
    pub entropy: u64
} Summary

pub closed enum Ask derives Encode {
    Average(Readings)
    Divide(u32)
    Sum(u64)
    Spin(u32)
    Hold(u32)
    Echo
} Ask

pub closed enum Answer derives Encode {
    Summary(Summary)
    Number(u64)
} Answer

/// The book's protocol and state, as the kernel declares them.
pub protocol Ledger {
    pub fn add(amount: u32) -> u64 limits pure
    pub fn echo(clock: sys::Clock) -> sys::Clock limits pure
    pub fn note(log: sys::Log) -> sys::Log limits recorded
    pub fn borrow() limits recorded
    pub fn divide(by: u32) -> u64 limits pure
    pub fn spin() -> u64 limits pure
} Ledger

pub closed struct Book derives Encode {
    pub total: u64
    pub ticks: u64
} Book

/// The serial port serving a job's log and standard streams, its state counting the bytes of
/// standard input it has given and its record 1 for the log the book notes through.
struct Console {
} Console

impl Console: sys::Kind[core::atomic::AtomicU64, u64]

impl Console: sys::LogService

impl Console: sys::StdioService

/// A random source serving the bytes of a counter.
struct Counter {
} Counter

impl Counter: sys::Kind[core::atomic::AtomicU64, u64]

impl Counter: sys::RandomService

fn Console.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
    match sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => record) {
        Some(1) => say(text: "note ")
        else => say(text: "log ")
    }
    match level {
        sys::LogLevel.Info => say(text: "info ")
        sys::LogLevel.Warn => say(text: "warn ")
        sys::LogLevel.Error => say(text: "error ")
    }
    say(text: message)
    say(text: ": ")
    say(text: value)
    say(text: "\n")
} Console.log

fn Console.read_in(self, mut buf: SliceMut[u8]) -> usize fails sys::StdioError limits stack 4_096 {
    let input = b"from the kernel"
    let given = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(input.len())))
    let Some(Some(start)) = given else {
        fail sys::StdioError.Closed
    }
    if start > 0 {
        return 0
    }
    var count: usize = 0
    while count < buf.len() and count < input.len() {
        buf[count] = input[count]
        count += 1
    }
    return count
} Console.read_in

fn Console.write_out(self, data: Slice[u8]) limits stack 4_096 {
    say(text: "out ")
    say_bytes(data)
} Console.write_out

fn Console.write_err(self, data: Slice[u8]) limits stack 4_096 {
    say(text: "err ")
    say_bytes(data)
} Console.write_err

fn Counter.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
    let given = sys::reach(self, body: fn(state: core::atomic::AtomicU64, record: u64) => state.fetch_add(u64.widen(buf.len())))
    let start = given.value_or(None).value_or(0)
    for index in 0..<buf.len() {
        buf[index] = u8.truncate(start + u64.widen(index))
    }
} Counter.fill

fn say(text: Str) {
    say_bytes(text.as_bytes())
} say

fn say_bytes(bytes: Slice[u8]) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in bytes {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say_bytes

fn say_number(value: u64) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var left = value
    loop {
        digits[count] = b'0' + u8.truncate(left % 10)
        count += 1
        left = left / 10
        if left == 0 {
            break
        }
    }
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    while count > 0 {
        count -= 1
        mut uart.write(Uart.data, value: digits[count])
    }
    take uart.unmap()
} say_number

/// Reads a big-endian number of `count` bytes from the fw_cfg data port.
fn read_be(mut data: hw::Ports[Data], count: u32) -> u64 {
    var value: u64 = 0
    for _ in 0..<count {
        value = (value << 8) | u64.widen(mut data.read(Data.byte))
    }
    return value
} read_be

/// The fw_cfg file of a name: its key and size, a zero key when there is none.
struct Found derives Copy {
    key: u16
    size: u64
} Found

fn find_file(mut data: hw::Ports[Data], name: Str) -> Found {
    var found = Found(key: 0, size: 0)
    for _ in 0..<read_be(mut data, count: 4) {
        let size = read_be(mut data, count: 4)
        let key = u16.truncate(read_be(mut data, count: 2))
        discard read_be(mut data, count: 2)
        var same = true
        for index in 0..<NAME_BYTES {
            let byte = mut data.read(Data.byte)
            var wanted: u8 = 0
            if index < name.as_bytes().len() {
                wanted = name.as_bytes()[index]
            }
            same = same and byte == wanted
        }
        if same {
            found = Found(key: key, size: size)
        }
    }
    return found
} find_file

/// The bytes of the fw_cfg file of a name, empty when there is none.
fn fw_file(name: Str, alloc: mem::Alloc) -> mem::Bytes {
    var selector = trusted "the board decodes port 0x510 to the fw_cfg selector" { hw::Ports[Selector].map(0x510) }
    var data = trusted "the board decodes port 0x511 to the fw_cfg data port" { hw::Ports[Data].map(0x511) }
    mut selector.write(Selector.key, value: DIRECTORY)
    let found = find_file(mut data, name)
    var bytes = mem::Bytes.empty(alloc)
    if found.key != 0 {
        mut selector.write(Selector.key, value: found.key)
        for _ in 0..<found.size {
            mut bytes.push(mut data.read(Data.byte))
        }
    }
    take selector.unmap()
    take data.unmap()
    return bytes
} fw_file

fn stop(text: Str) -> Never {
    say(text)
    loop {
    }
} stop

/// The kernel's policy, which keeps every task on CPU 0 with slices of a millisecond.
struct OneCpu {
} OneCpu

impl OneCpu: hw::Policy

fn OneCpu.place(self, t: hw::IrqsDisabled, task: hw::TaskView) -> hw::Placement limits notrap, terminates, noalloc, stack 4_096 {
    return hw::Placement(cpu: 0, key: 0, bound: false)
} OneCpu.place

fn OneCpu.steal(self, t: hw::IrqsDisabled, cpu: u32, round: u32) -> Option[hw::Steal] limits notrap, terminates, noalloc, stack 4_096 {
    return None
} OneCpu.steal

fn OneCpu.slice(self, t: hw::IrqsDisabled, cpu: u32, task: hw::TaskView) -> u64 limits notrap, terminates, noalloc, stack 4_096 {
    return 1_000_000
} OneCpu.slice

fn OneCpu.idle(self, t: hw::IrqsDisabled, cpu: u32, until_ns: Option[u64]) -> hw::Idle limits notrap, terminates, noalloc, stack 4_096 {
    return hw::Idle.Halt
} OneCpu.idle

/// The frames each space takes and draws from: 16 MiB, less than its runtime's boot area.
const SPACE_FRAMES: usize = 4_096

/// Kernel memory outside the entry area, which a space's root does not map.
const KERNEL_PROBE: u64 = 0x1000_0000

/// Runs the runtime of a space of a job with its stack in kernel memory outside the entry area,
/// so that its first store probes that memory, and writes whether the store faulted on a page
/// the space's root does not map.
fn probed(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    match attempt job.space(cpu, data: 64, frames: mut held, alloc: grants.alloc) {
        Ok(space) => {
            var state = hw::UserState(regs: Array[Untrusted[u64], 31].filled(Untrusted.of(0)), sp: Untrusted.of(KERNEL_PROBE + 4_096), ip: Untrusted.of(space.start()), flags: Untrusted.of(0))
            var none: Option[hw::ExtendedState] = None
            var exit = hw::UserExit.Interrupted
            while exit == hw::UserExit.Interrupted {
                exit = space.run(cpu, mut state, extended: mut none)
            }
            match unmapped_fault(exit) {
                true => say(text: "probe faulted on a page the space does not map\n")
                false => say(text: "probe faulted otherwise\n")
            }
            returned(take none, mut frames)
            take space.release(frames: mut held)
        }
        Err(_) => say(text: "probe unplaced\n")
    }
    for frame in take held {
        mut frames.push(take frame)
    }
} probed

/// Whether an exit is a fault of a store to the page below `KERNEL_PROBE + 4_096` that the root
/// does not map.
fn unmapped_fault(exit: hw::UserExit) -> bool {
    let hw::UserExit.Fault(fault) = exit else {
        return false
    }
    // A user-mode write to a page the root does not map: present clear, write and user set.
    return fault.vector == 14 and fault.code == 6 and fault.address >= KERNEL_PROBE and fault.address < KERNEL_PROBE + 4_096
} unmapped_fault

/// Makes a space of a job, draws the first chunk of its boot area, writes there and gives the
/// chunk back, then draws past the frames left and outside the boot area, writing how many
/// frames each step takes or gives back.
fn drew(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) {
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    match attempt job.space(cpu, data: 64, frames: mut held, alloc: grants.alloc) {
        Ok(made) => {
            var space = made
            let area = space.boot_area()
            let left = held.len()
            let Ok(pages) = attempt mut space.draw(area, len: 65_536, frames: mut held) else {
                stop(text: "chunk undrawn\n")
            }
            say(text: "drew ")
            say_number(pages)
            say(text: " pages from ")
            say_number(u64.widen(left - held.len()))
            say(text: " frames\n")
            let wrote = attempt mut space.write(area + 4_096, bytes: b"drawn")
            discard attempt mut space.give_back(area, len: 65_536, frames: mut held)
            say(text: "gave back ")
            say_number(u64.widen(held.len() + 16 - left))
            say(text: " frames, ")
            let unmapped = match attempt mut space.write(area + 4_096, bytes: b"drawn") {
                Err(hw::UserAddrError.Unmapped) => true
                else => false
            }
            match wrote.is_ok() and unmapped {
                true => say(text: "wrote while drawn only\n")
                false => say(text: "wrote otherwise\n")
            }
            let past = match attempt mut space.draw(area, len: u64.widen(held.len() + 1) * 4_096, frames: mut held) {
                Err(sys::load::DrawError.Exhausted) => true
                else => false
            }
            let outside = match attempt mut space.draw(space.data(), len: 1, frames: mut held) {
                Err(sys::load::DrawError.Outside) => true
                else => false
            }
            match past and outside {
                true => say(text: "refused past the frames and outside the boot area\n")
                false => say(text: "refused otherwise\n")
            }
            take space.release(frames: mut held)
        }
        Err(_) => say(text: "space unplaced\n")
    }
    for frame in take held {
        mut frames.push(take frame)
    }
} drew

/// A bundle verified for isolated spaces.
fn isolated(loader: sys::load::Loader, bytes: Slice[u8], alloc: mem::Alloc) -> sys::load::Isolated {
    let keys = Array[core::crypto::PublicKey, 1].filled(bundle_key())
    let Ok(job) = attempt loader.isolate(bytes, keys: keys.view(), alloc) else {
        stop(text: "unverified\n")
    }
    return job
} isolated

/// What the kernel serves every job, and the console the book notes through.
struct Grants derives Copy {
    clock: sys::Clock
    console: Console
    noter: Console
    counter: Counter
    exec: task::Executor
    alloc: mem::Alloc
} Grants

/// The services of an isolated job: its log and standard streams on the console, its random
/// source the counter.
fn services(grants: Grants) -> nanos::Services {
    let Ok(log) = attempt sys::Log.served(grants.console) else {
        stop(text: "no log\n")
    }
    let Ok(stdio) = attempt sys::Stdio.served(grants.console) else {
        stop(text: "no stdio\n")
    }
    let Ok(random) = attempt sys::Random.served(grants.counter) else {
        stop(text: "no random\n")
    }
    return nanos::Services(clock: grants.clock, log: log, stdio: stdio, random: random)
} services

/// The frames a space takes, from the end of `frames`.
fn frames_for_space(mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    var taken = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    for _ in 0..<SPACE_FRAMES {
        let Some(frame) = mut frames.pop() else {
            stop(text: "out of frames\n")
        }
        mut taken.push(take frame)
    }
    return taken
} frames_for_space

/// Writes how a run ended, giving what it returned, empty for a run returning nothing.
fn report(name: Str, take outcome: Result[nanos::Ended, nanos::IsolatedError], alloc: mem::Alloc) -> mem::Bytes {
    say(text: name)
    match outcome {
        Ok(nanos::Ended.Returned(bytes)) => {
            say(text: " returned\n")
            return bytes
        }
        Ok(nanos::Ended.Failed(rendered)) => {
            say(text: " failed ")
            say(text: rendered.as_str())
            say(text: "\n")
        }
        Ok(nanos::Ended.Trapped(trap)) => {
            match trap.kind() {
                sys::TrapKind.DivisionByZero => say(text: " trapped trap.division-by-zero\n")
                sys::TrapKind.Exception => say(text: " trapped trap.exception\n")
                sys::TrapKind.Exhausted => say(text: " trapped trap.exhausted\n")
                else => say(text: " trapped otherwise\n")
            }
        }
        Ok(nanos::Ended.Cancelled) or Ok(nanos::Ended.Abandoned) => say(text: " stopped\n")
        Ok(nanos::Ended.Undecodable) => say(text: " undecodable\n")
        Err(_) => say(text: " did not run\n")
    }
    return mem::Bytes.empty(alloc)
} report

/// Runs the job of a bundle verified for isolated spaces in a space on each input, writing how
/// each run ended, and gives what each run returned.
fn ran(cpu: hw::Ring0, job: sys::load::Isolated, name: Str, grants: Grants, take inputs: mem::List[mem::Bytes], mut frames: mem::List[hw::PhysFrame[4_096]]) -> mem::List[mem::Bytes] fails task::Cancelled uses wait {
    var left = inputs
    var results = mem::List[mem::Bytes].empty(grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    let link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    while left.len() > 0 {
        let input = mut left.remove(0)
        var held = frames_for_space(mut frames, alloc: grants.alloc)
        let outcome = attempt await nanos::run_isolated(cpu, job, services: services(grants), link, take input, frames: mut held, mut extended, alloc: grants.alloc)
        for frame in take held {
            mut frames.push(take frame)
        }
        mut results.push(report(name, take outcome, alloc: grants.alloc))
    }
    returned(take extended, mut frames)
    take link.release(mut frames)
    return results
} ran

/// The last frame of a list, or a stop when none is left.
fn next_frame(mut frames: mem::List[hw::PhysFrame[4_096]]) -> hw::PhysFrame[4_096] {
    let Some(frame) = mut frames.pop() else {
        stop(text: "out of frames\n")
    }
    return frame
} next_frame

/// Gives back the frame of an extended state.
fn returned(take extended: Option[hw::ExtendedState], mut frames: mem::List[hw::PhysFrame[4_096]]) {
    match extended {
        Some(owned) => mut frames.push(take owned.into_frame())
        None => {}
    }
} returned

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    let clock = k.clock()
    let Some(loader) = k.loader() else {
        stop(text: "no loader\n")
    }
    let Some(cpu) = mut k.ring0() else {
        stop(text: "no ring0\n")
    }
    var regions = mut k.regions()
    var frames = mem::List[hw::PhysFrame[4_096]].empty(alloc)
    match mut regions.pop() {
        Some(region) => take region.frames(mut frames)
        None => stop(text: "no usable memory\n")
    }
    mut k.policy(OneCpu())
    take k.anchor(0u8, run: fn[take loader, take cpu, take frames](exec: task::Executor) fails task::Cancelled uses wait limits stack 262_144 {
        let consoles = sys::Minter[Console, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let counters = sys::Minter[Counter, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let grants = Grants(clock: clock, console: consoles.mint(0), noter: consoles.mint(1), counter: counters.mint(0), exec: exec, alloc: alloc)
        var pool = frames
        let served = attempt await serve(cpu, loader, grants, frames: mut pool)
        take consoles.close()
        take counters.close()
        let Some(last) = mut pool.pop() else {
            stop(text: "out of frames\n")
        }
        relinquished(take cpu, frame: take last)
        for frame in take pool {
            given_up(take frame)
        }
        discard served
    })
} main

/// Gives up the CPU's privileges, which a frame holds from now on, and the frame.
fn relinquished(take cpu: hw::Ring0, take frame: hw::PhysFrame[4_096]) {
    let base = frame.base()
    trusted "the frame holds the privileges, and no value owns them from now on" { hw::Ptr[hw::Ring0].of_addr(usize.widen(base + 8)).write(take cpu) }
    given_up(take frame)
} relinquished

/// Gives up an unused frame, which holds itself from now on.
fn given_up(take frame: hw::PhysFrame[4_096]) {
    let base = frame.base()
    trusted "the frame holds itself, and no value owns it from now on" { hw::Ptr[hw::PhysFrame[4_096]].of_addr(usize.widen(base)).write(take frame) }
} given_up

/// Runs the jobs: a typed job using floats, lanes and the served capabilities and an input it does
/// not decode, a host program, a job trapping, failing, returning and reading kernel memory, a job
/// without a stack bound recursing past the stack it starts with, a job holding memory within the
/// frames its space draws from and past them, a space drawing and giving back pages, a job
/// answering a line over its link, instances of a component held in spaces, a space's runtime
/// probing kernel memory, then a job spinning on floats in a space while the same job, verified
/// once, spins in the shared space.
fn serve(cpu: hw::Ring0, loader: sys::load::Loader, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    var values = mem::List[u32].empty(grants.alloc)
    mut values.push(2)
    mut values.push(4)
    mut values.push(9)
    var averaged = mem::List[mem::Bytes].empty(grants.alloc)
    mut averaged.push(encoded(Ask.Average(Readings(values: take values)), alloc: grants.alloc))
    var garbage = mem::Bytes.empty(grants.alloc)
    mut garbage.push(0xFF)
    mut averaged.push(take garbage)
    let typed_bytes = fw_file(name: "opt/nan/typed", alloc: grants.alloc)
    let typed = isolated(loader, bytes: typed_bytes.view(), alloc: grants.alloc)
    let summaries = try await ran(cpu, job: typed, name: "average", grants, inputs: take averaged, mut frames)
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(summaries[0].view()), alloc: grants.alloc) {
        Ok(Answer.Summary(summary)) => {
            say(text: "mean ")
            say_number(summary.mean_milli)
            say(text: " lanes ")
            say_number(summary.lanes)
            say(text: " entropy ")
            say_number(summary.entropy)
            say(text: "\n")
        }
        else => say(text: "summary undecodable\n")
    }
    var args = mem::List[mem::Bytes].empty(grants.alloc)
    mut args.push(mem::Bytes.empty(grants.alloc))
    let host = nanos::HostInput(args: take args, environment: mem::Map[mem::Bytes, mem::Bytes].empty(grants.alloc))
    var greeted = mem::List[mem::Bytes].empty(grants.alloc)
    mut greeted.push(encoded(host, alloc: grants.alloc))
    let greet = unverified(loader, bytes: fw_file(name: "opt/nan/greet", alloc: grants.alloc).view(), alloc: grants.alloc)
    discard try await ran(cpu, job: greet, name: "greet", grants, inputs: take greeted, mut frames)
    var divisors = mem::List[mem::Bytes].empty(grants.alloc)
    mut divisors.push(encoded(Ask.Divide(0), alloc: grants.alloc))
    mut divisors.push(encoded(Ask.Divide(1), alloc: grants.alloc))
    mut divisors.push(encoded(Ask.Divide(4), alloc: grants.alloc))
    mut divisors.push(encoded(Ask.Divide(2), alloc: grants.alloc))
    var quotients = try await ran(cpu, job: typed, name: "crash", grants, inputs: take divisors, mut frames)
    say_answer(text: "quotient ", bytes: mut quotients.remove(2), alloc: grants.alloc)
    var depths = mem::List[mem::Bytes].empty(grants.alloc)
    mut depths.push(encoded(Ask.Sum(20_000), alloc: grants.alloc))
    var sums = try await ran(cpu, job: typed, name: "deep", grants, inputs: take depths, mut frames)
    say_answer(text: "sum ", bytes: mut sums.remove(0), alloc: grants.alloc)
    var holdings = mem::List[mem::Bytes].empty(grants.alloc)
    mut holdings.push(encoded(Ask.Hold(4), alloc: grants.alloc))
    mut holdings.push(encoded(Ask.Hold(64), alloc: grants.alloc))
    var holds = try await ran(cpu, job: typed, name: "hold", grants, inputs: take holdings, mut frames)
    say_answer(text: "held pages ", bytes: mut holds.remove(0), alloc: grants.alloc)
    drew(cpu, job: typed, grants, mut frames)
    try await linked(cpu, job: typed, grants, mut frames)
    try await booked(cpu, job: isolated(loader, bytes: fw_file(name: "opt/nan/ledger", alloc: grants.alloc).view(), alloc: grants.alloc), grants, mut frames)
    probed(cpu, job: typed, grants, mut frames)
    try await spun(cpu, loader, job: typed, bytes: typed_bytes.view(), grants, mut frames)
} serve

/// Runs the typed job spinning in a space and, in another task, in the shared space from the
/// bytes `job` was verified from, each from its own start, and writes the integer parts each
/// gives.
fn spun(cpu: hw::Ring0, loader: sys::load::Loader, job: sys::load::Isolated, bytes: Slice[u8], grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let Ok(prepared) = trusted "isolate verified these bytes" { attempt loader.prepare_unverified(bytes, alloc: grants.alloc) } else {
        stop(text: "malformed\n")
    }
    let Ok(bundle) = attempt take prepared.load() else {
        stop(text: "unloadable\n")
    }
    let load = bundle.share()
    var given = Some(Spun(result: mem::Bytes.empty(grants.alloc), frames: frames_for_space(mut frames, alloc: grants.alloc), extended: Some(hw::ExtendedState.of(next_frame(mut frames))), link: nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)))
    var in_shared = mem::Bytes.empty(grants.alloc)
    var runs = mem::List[Spun].empty(grants.alloc)
    discard attempt await task::scope(grants.exec, body: fn[mut given, mut in_shared, mut runs](s: task::Scope) fails task::Cancelled uses wait {
        let Some(taken) = mut given.extract() else {
            return
        }
        let isolated_run = s.spawn(fn[take taken]() -> Spun fails task::Cancelled uses wait limits stack 65_536 {
            let Spun(result: _, frames: held, extended: owned, link: link) = taken
            var pool = held
            var state = owned
            let outcome = attempt await nanos::run_isolated(cpu, job, services: services(grants), link, input: encoded(Ask.Spin(500_000), alloc: grants.alloc), frames: mut pool, extended: mut state, alloc: grants.alloc)
            return Spun(result: result_of(take outcome, alloc: grants.alloc), frames: take pool, extended: take state, link: take link)
        })
        let outcome = attempt await nanos::run(load, world: world_of(grants), input: encoded(Ask.Spin(1), alloc: grants.alloc), domain: sys::Abandoner.new(), exec: grants.exec, alloc: grants.alloc)
        in_shared = shared_result_of(take outcome, alloc: grants.alloc)
        mut runs.push(try await take isolated_run.join())
    })
    take bundle.unload()
    say_answer(text: "spun ", bytes: take in_shared, alloc: grants.alloc)
    for run in take runs {
        let Spun(result: result, frames: held, extended: owned, link: link) = run
        say_answer(text: "spun ", bytes: take result, alloc: grants.alloc)
        for frame in take held {
            mut frames.push(take frame)
        }
        returned(take owned, mut frames)
        take link.release(mut frames)
    }
    match given {
        Some(Spun(result: _, frames: held, extended: owned, link: link)) => {
            for frame in take held {
                mut frames.push(take frame)
            }
            returned(take owned, mut frames)
            take link.release(mut frames)
        }
        None => {}
    }
} spun

/// What a job's run in a space gives back: what it returned, and the frames, the extended state
/// and the link it took.
linear struct Spun {
    result: mem::Bytes
    frames: mem::List[hw::PhysFrame[4_096]]
    extended: Option[hw::ExtendedState]
    link: nanos::Link
} Spun

/// Runs the typed job answering a line over a link of two channels, `ask` and `answer`: once
/// the job says it is ready, waits 100 ms and sends it a line, then writes what the job sent and
/// whether its read returned before the second its runtime waits at most on the doorbell.
fn linked(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    var link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    let ask = mut link.open("ask", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    let answer = mut link.open("answer", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var held = frames_for_space(mut frames, alloc: grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    var result = mem::Bytes.empty(grants.alloc)
    discard attempt await task::scope(grants.exec, body: fn[mut held, mut extended, mut result](s: task::Scope) fails task::Cancelled uses wait {
        let run = s.spawn(fn[mut held, mut extended, mut result]() fails task::Cancelled uses wait limits stack 65_536 {
            let outcome = attempt await nanos::run_isolated(cpu, job, services: services(grants), link, input: encoded(Ask.Echo, alloc: grants.alloc), frames: mut held, mut extended, alloc: grants.alloc)
            result = result_of(take outcome, alloc: grants.alloc)
        })
        say_received(text: "link said ", outcome: attempt await link.receive(answer, alloc: grants.alloc), alloc: grants.alloc)
        try await grants.clock.sleep_ns(100_000_000)
        discard attempt link.send(ask, data: b"ping")
        say_received(text: "link answered ", outcome: attempt await link.receive(answer, alloc: grants.alloc), alloc: grants.alloc)
        try await take run.join()
    })
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(result.view()), alloc: grants.alloc) {
        Ok(Answer.Number(waited)) => {
            match waited < 900_000_000 {
                true => say(text: "the doorbell woke the read\n")
                false => say(text: "the read woke otherwise\n")
            }
        }
        else => say(text: "echo answered nothing\n")
    }
    for frame in take held {
        mut frames.push(take frame)
    }
    returned(take extended, mut frames)
    take link.release(mut frames)
} linked

/// Holds instances of the ledger's book in spaces over the first channel of a link, acting through
/// a runner the kernel serves: started, called, given a log it notes through, publishing its total,
/// and gives back, lent logs through its runner, refused a call carrying a clock, checkpointed and
/// ended, then restored from that checkpoint, a handler that traps and a handler that never returns
/// until the instance is abandoned.
fn booked(cpu: hw::Ring0, job: sys::load::Isolated, grants: Grants, mut frames: mem::List[hw::PhysFrame[4_096]]) fails task::Cancelled uses wait {
    let lending = sys::Minter[Lending, Lent, u64].of(Lent(noter: grants.noter, alloc: grants.alloc), alloc: grants.alloc)
    defer take lending.close()
    let Ok(runner) = attempt sys::Runner.served(lending.mint(0)) else {
        stop(text: "no runner\n")
    }
    var link = nanos::Link.of(next_frame(mut frames), alloc: grants.alloc)
    discard mut link.open("book", inbound: next_frame(mut frames), outbound: next_frame(mut frames))
    var pool = frames_for_space(mut frames, alloc: grants.alloc)
    var extended = Some(hw::ExtendedState.of(next_frame(mut frames)))
    let opened = attempt await nanos::hold_isolated(cpu, job, component: "Book", services: services(grants), link, checkpoint: None, runner, frames: mut pool, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) -> mem::Bytes fails nanos::InstanceError uses wait {
        return try await started(take instance, grants)
    })
    match opened {
        Ok(Some(checkpoint)) => {
            discard attempt await nanos::hold_isolated(cpu, job, component: "Book", services: services(grants), link, checkpoint: Some(take checkpoint), runner, frames: mut pool, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
                try await restored(take instance, grants)
            })
        }
        else => say(text: "book unheld\n")
    }
    discard attempt await nanos::hold_isolated(cpu, job, component: "Book", services: services(grants), link, checkpoint: None, runner, frames: mut pool, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        try await trapped(take instance, grants)
    })
    discard attempt await nanos::hold_isolated(cpu, job, component: "Book", services: services(grants), link, checkpoint: None, runner, frames: mut pool, mut extended, exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        try await abandoned(take instance, grants)
    })
    for frame in take pool {
        mut frames.push(take frame)
    }
    returned(take extended, mut frames)
    take link.release(mut frames)
} booked

/// Starts the book, calls it and gives a checkpoint of it.
fn started(take instance: nanos::Instance, grants: Grants) -> mem::Bytes fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    try await ticked(mut book, reason: sys::ResumeReason.Started)
    try await added(mut book, amount: 5, grants)
    try await noted(mut book, grants)
    try await borrowed(mut book, grants)
    var echo = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].echo(mut echo, clock: grants.clock)
    match attempt await book.inbox().call(sys::Wire[Ledger].hash(), request: take echo, alloc: grants.alloc) {
        Err(sys::CallError.Malformed(core::DecodeError.Invalid)) => say(text: "book refused a clock\n")
        else => say(text: "book took a clock\n")
    }
    let checkpoint = try await book.checkpoint()
    say(text: "book checkpoint ")
    say_book(checkpoint, alloc: grants.alloc)
    undefer book
    say(text: "book ")
    say_ended(try await take book.end(), alloc: grants.alloc)
    return checkpoint
} started

/// Gives the book the log of the noting console, which it notes its total through and gives back,
/// and logs through the log it gives back.
fn noted(mut book: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    let Ok(log) = attempt sys::Log.served(grants.noter) else {
        stop(text: "no note log\n")
    }
    var request = sys::Encoded.empty(grants.alloc)
    let note = sys::Wire[Ledger].note(mut request, log)
    let Ok(reply) = try await called(mut book, take request, grants) else {
        say(text: "book note refused\n")
        return
    }
    match attempt note.decode(Untrusted.of(reply.bytes.view()), handles: reply.handles.view(), alloc: grants.alloc) {
        Ok(given) => given.info("given back", value: true)
        Err(_) => say(text: "book note undecodable\n")
    }
} noted

/// Has the book read the log its runner holds as capability 7, then borrow the log its runner lends
/// through port 1 from the keyed task it starts, which sends a tick once it has logged through it.
fn borrowed(mut book: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var request = sys::Encoded.empty(grants.alloc)
    sys::Wire[Ledger].borrow(mut request)
    discard try await called(mut book, take request, grants)
    discard try await mut book.start_keyed()
    try await book.incoming()
    discard try await mut book.step()
    say(text: "book borrowed\n")
} borrowed

/// The runner the kernel serves the book: it writes each total the book publishes, holds the
/// noting console's log as capability 7 and lends it through port 1, refusing every other
/// operation.
struct Lending {
} Lending

impl Lending: sys::Kind[Lent, u64]

/// What the runner the kernel serves the book holds: the noting console, and the allocator it
/// decodes through.
struct Lent derives Copy {
    noter: Console
    alloc: mem::Alloc
} Lent

impl Lending: sys::RunnerService

fn Lending.send_to(self, port: u64, hash: sys::ProtocolHash, bytes: Slice[u8], handles: Slice[sys::Handle]) fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Lending.send_to

fn Lending.call(self, port: u64, hash: sys::ProtocolHash, bytes: Slice[u8], handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::RunnerError limits stack 4_096 {
    let Some(log) = lent(self) else {
        fail sys::RunnerError.Unknown
    }
    if port != 1 {
        fail sys::RunnerError.Unknown
    }
    var reply = sys::Encoded.empty(alloc)
    let lending: Result[u64, u8] = Ok(0)
    mem::wire::Codec[Result[u64, u8]].encode(lending, out: mut reply.bytes)
    mut reply.handles.push(sys::Handle.of(log))
    return reply
} Lending.call

fn Lending.reply(self, request: u64, bytes: Slice[u8], handles: Slice[sys::Handle]) fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Lending.reply

fn Lending.publish(self, summary: Slice[u8]) limits stack 4_096 {
    let Some(alloc) = sys::reach(self, body: fn(state: Lent, record: u64) => state.alloc) else {
        return
    }
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(summary)
    let Ok(total) = attempt mem::wire::Codec[u64].decode(Untrusted.of(bytes.view()), alloc) else {
        say(text: "published otherwise\n")
        return
    }
    say(text: "published total ")
    say_number(total)
    say(text: "\n")
} Lending.publish

fn Lending.sync(self) fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Lending.sync

fn Lending.capability(self, id: u64) -> sys::Handle fails sys::RunnerError limits stack 4_096 {
    let Some(log) = lent(self) else {
        fail sys::RunnerError.Unknown
    }
    if id != 7 {
        fail sys::RunnerError.Unknown
    }
    return sys::Handle.of(log)
} Lending.capability

fn Lending.drop_capability(self, id: u64) fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Lending.drop_capability

fn Lending.resource(self, id: u64) -> sys::Held fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Lending.resource

fn Lending.take_resource(self, id: u64) -> sys::Held fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Lending.take_resource

fn Lending.put_resource(self, id: u64, take resource: sys::Held) fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Lending.put_resource

/// The log of the noting console a runner holds, none for a stale runner.
fn lent(runner: Lending) -> Option[sys::Log] {
    let Some(noter) = sys::reach(runner, body: fn(state: Lent, record: u64) => state.noter) else {
        return None
    }
    match attempt sys::Log.served(noter) {
        Ok(log) => return Some(log)
        Err(_) => return None
    }
} lent

/// Restores the book from a checkpoint into a fresh instance and calls it.
fn restored(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    try await ticked(mut book, reason: sys::ResumeReason.Restored)
    try await added(mut book, amount: 7, grants)
    undefer book
    say(text: "book ")
    say_ended(try await take book.end(), alloc: grants.alloc)
} restored

/// Calls a handler of the book that traps, which ends the instance.
fn trapped(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    var zero = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].divide(mut zero, by: 0)
    say(text: "book divided ")
    match attempt await called(mut book, request: take zero, grants) {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    say(text: "book stepped ")
    match attempt await mut book.step() {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    undefer book
    say(text: "book divider ")
    say_ended(try await take book.end(), alloc: grants.alloc)
} trapped

/// Calls a handler of the book that never returns, abandoning the instance from a task of its own
/// while its holder steps the call.
fn abandoned(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var book = instance
    defer take book.abandon()
    var spin = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Ledger].spin(mut spin)
    var pending = Some(take spin)
    var watching = Some(book.domain())
    say(text: "book spun ")
    let outcome = attempt await task::scope(grants.exec, body: fn[mut book, mut pending, mut watching](s: task::Scope) fails nanos::InstanceError uses wait {
        let Some(request) = mut pending.extract() else {
            return
        }
        let Some(watched) = mut watching.extract() else {
            return
        }
        discard s.spawn(fn[take watched]() fails task::Cancelled uses wait limits stack 16_384 {
            try await grants.clock.sleep(10)
            watched.contents().trigger()
        })
        discard try await called(mut book, take request, grants)
    })
    match outcome {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    undefer book
    say(text: "book spinner ")
    say_ended(try await take book.end(), alloc: grants.alloc)
} abandoned

/// Resumes the book for a reason, then starts the keyed task its resume spawns and steps the tick
/// that task posts.
fn ticked(mut book: nanos::Instance, reason: sys::ResumeReason) fails nanos::InstanceError uses wait {
    try await mut book.resumed(reason)
    say(text: "book keyed ")
    say_number(u64.widen(try await mut book.start_keyed()))
    say(text: "\n")
    try await book.incoming()
    say(text: "book ticked ")
    match try await mut book.step() {
        true => say(text: "true\n")
        false => say(text: "false\n")
    }
} ticked

/// Adds `amount` to the book and writes the total it answers.
fn added(mut book: nanos::Instance, amount: u32, grants: Grants) fails nanos::InstanceError uses wait {
    var request = sys::Encoded.empty(grants.alloc)
    let add = sys::Wire[Ledger].add(mut request, amount)
    let reply = try await called(mut book, take request, grants)
    say(text: "book added ")
    let Ok(given) = reply else {
        say(text: "nothing\n")
        return
    }
    match attempt add.decode(Untrusted.of(given.bytes.view()), handles: given.handles.view(), alloc: grants.alloc) {
        Ok(total) => {
            say_number(total)
            say(text: "\n")
        }
        Err(_) => say(text: "nothing\n")
    }
} added

/// The reply of the book to a call, which the instance handles in the next step its holder takes.
fn called(mut book: nanos::Instance, take request: sys::Encoded, grants: Grants) -> Result[sys::Encoded, sys::CallError[Never]] fails nanos::InstanceError uses wait {
    var pending = Some(take request)
    var reply: Result[sys::Encoded, sys::CallError[Never]] = Err(sys::CallError.Closed(task::SendError.Closed))
    try await task::scope(grants.exec, body: fn[mut book, mut pending, mut reply](s: task::Scope) fails nanos::InstanceError uses wait {
        let Some(call) = mut pending.extract() else {
            return
        }
        let inbox = book.inbox()
        let answered = s.spawn(fn[take inbox, take call]() -> Result[sys::Encoded, sys::CallError[Never]] fails task::Cancelled uses wait limits stack 16_384 {
            return attempt await inbox.call(sys::Wire[Ledger].hash(), request: take call, alloc: grants.alloc)
        })
        try await book.incoming()
        discard try await mut book.step()
        reply = try await take answered.join()
    })
    return reply
} called

/// Writes the total and ticks of the book whose state `bytes` encodes.
fn say_book(bytes: mem::Bytes, alloc: mem::Alloc) {
    match attempt mem::wire::Codec[Book].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(state) => {
            say(text: "total ")
            say_number(state.total)
            say(text: " ticks ")
            say_number(state.ticks)
            say(text: "\n")
        }
        Err(_) => say(text: "undecodable\n")
    }
} say_book

/// Writes how an instance of the book ended.
fn say_ended(take ended: nanos::Ended, alloc: mem::Alloc) {
    match ended {
        nanos::Ended.Returned(bytes) => {
            say(text: "returned ")
            say_book(bytes, alloc)
        }
        nanos::Ended.Trapped(trap) => match trap.kind() {
            sys::TrapKind.DivisionByZero => say(text: "trapped trap.division-by-zero\n")
            else => say(text: "trapped otherwise\n")
        }
        nanos::Ended.Abandoned => say(text: "abandoned\n")
        else => say(text: "ended otherwise\n")
    }
} say_ended

/// Writes `text`, then the bytes a link received.
fn say_received(text: Str, take outcome: Result[Untrusted[mem::Bytes], nanos::LinkError], alloc: mem::Alloc) {
    say(text)
    match outcome {
        Ok(bytes) => say_bytes(shown(bytes.view(), alloc).view())
        Err(_) => say(text: "nothing")
    }
    say(text: "\n")
} say_received

/// The bytes a space sent, which the kernel writes as they are.
validator fn shown(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(raw.inspect())
    return bytes
} shown

/// What a run in a space returned, empty for a run ending otherwise.
fn result_of(take outcome: Result[nanos::Ended, nanos::IsolatedError], alloc: mem::Alloc) -> mem::Bytes {
    match outcome {
        Ok(nanos::Ended.Returned(bytes)) => return bytes
        else => return mem::Bytes.empty(alloc)
    }
} result_of

/// What a run in the shared space returned, empty for a run ending otherwise.
fn shared_result_of(take outcome: Result[nanos::Ended, nanos::RunError], alloc: mem::Alloc) -> mem::Bytes {
    match outcome {
        Ok(nanos::Ended.Returned(bytes)) => return bytes
        else => return mem::Bytes.empty(alloc)
    }
} shared_result_of

/// Writes `text`, then the number a typed job answered.
fn say_answer(text: Str, take bytes: mem::Bytes, alloc: mem::Alloc) {
    say(text)
    match attempt mem::wire::Codec[Answer].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(Answer.Number(value)) => {
            say_number(value)
            say(text: "\n")
        }
        else => say(text: "nothing\n")
    }
} say_answer

/// The world of a shared job: its log, standard streams and random source served, its file
/// system and network denied.
fn world_of(grants: Grants) -> nanos::World {
    let served = services(grants)
    return nanos::World(alloc: grants.alloc, exec: grants.exec, clock: grants.clock, random: served.random, log: served.log, stdio: served.stdio, fs: sys::Fs.denied(), net: sys::Net.denied(), caps: nanos::Caps.empty(grants.alloc))
} world_of

fn encoded[T: Encode](value: T, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return bytes
} encoded

fn bundle_key() -> core::crypto::PublicKey {
    var bytes = Array[u8, 32].filled(0)
    mut bytes.view_mut().copy_from(SIGNER)
    return core::crypto::PublicKey(bytes: bytes)
} bundle_key

/// A bundle placed for isolated spaces without checking its signature, trusted as the harness
/// builds each bundle against this kernel's interface.
fn unverified(loader: sys::load::Loader, bytes: Slice[u8], alloc: mem::Alloc) -> sys::load::Isolated {
    let Ok(job) = trusted "the harness builds each bundle against this kernel's interface" { attempt loader.isolate_unverified(bytes, alloc) } else {
        stop(text: "unplaceable\n")
    }
    return job
} unverified
