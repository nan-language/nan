//! What prefix checking and context packs read of the workspace: holes, and the api records of items, each listed once across the targets they are checked under.

/// A hole: its location and expected type.
pkg struct Listed {
    pkg path: text::String
    pkg line: u32
    pkg expected: text::String
} Listed

/// An item consumers see, as `nan show --api` prints it.
pkg struct ApiItem {
    pkg path: text::String
    /// The name of its package.
    pkg package_name: text::String
    pkg file: text::String
    pkg line: u32
    pkg lines: mem::List[text::String]
} ApiItem

/// The holes of the workspace's items under each target their packages are checked for, each
/// once, by path and line, with their expected types.
pkg fn Session.holes(self) -> mem::List[Listed] {
    let alloc = self.alloc
    var listed = mem::List[Listed].empty(alloc)
    for entry in self.closures_checked() {
        let checker = entry.checker
        let db = checker.db()
        for hole in checker.state.contents().holes.cursor() {
            let data = db.item(hole.item)
            let path = db.file(data.file).path.as_str()
            let line = db.line(hole.item, token: hole.token)
            let expected = checker.show(hole.expected, from: data.module)
            if listed.position(fn(other: Listed) => other.path.as_str() == path and other.line == line).is_some() {
                continue
            }
            mut listed.push(Listed(path: text::String.of(path, alloc), line: line, expected: take expected))
        }
    }
    mut listed.sort_by(fn(left: Listed, right: Listed) -> core::Ordering {
        let paths = left.path.as_str().cmp(right.path.as_str())
        if paths != core::Ordering.Equal {
            return paths
        }
        return left.line.cmp(right.line)
    })
    return listed
} Session.holes

/// A function's digest lines under each target its package declares, in byte order, each
/// followed by its target when there are several; none for another item.
fn Checker.digest_lines(self, checkers: Slice[TargetChecker], item: ty::ItemId) -> mem::List[text::String] {
    let db = self.db()
    let alloc = self.alloc()
    let data = db.item(item)
    var lines = mem::List[text::String].empty(alloc)
    match db.ast(item).kind {
        ast::ItemKind.Fn(_) => {}
        else => return lines
    }
    var declared = check_targets(db.source(db.package_of(item)), alloc)
    mut declared.sort_by(fn(left: workspace::Target, right: workspace::Target) => left.name().cmp(right.name()))
    for target in declared {
        var position: usize = 0
        while position < checkers.len() and checkers[position].target != target {
            position += 1
        }
        if position == checkers.len() {
            continue
        }
        let other = checkers[position].checker
        let Some(same) = other.db().same(data) else {
            continue
        }
        let digest = other.digest_text(same)
        var line = text::String.of("digest: ", alloc)
        mut line.append(digest.as_str())
        if declared.len() > 1 {
            mut line.append(" (")
            mut line.append(target.name())
            mut line.push(')')
        }
        mut lines.push(take line)
    }
    return lines
} Checker.digest_lines
