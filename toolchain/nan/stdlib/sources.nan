    \\pub fn Mask8x16.bit_xor(self, other: Mask8x16) -> Mask8x16 limits pure, notrap, terminates
    \\    example U8x16.splat(1).lanes_eq(U8x16.splat(1)).bit_xor(U8x16.splat(1).lanes_eq(U8x16.splat(2))).any()
    \\{
