test resumed_state_continues_its_checkpoint for Stepper.resume {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    mut stepper.deliver(ProbeMessage.Count)
    mut stepper.deliver(ProbeMessage.Count)
    var checkpoint = mem::Bytes.empty(world.alloc)
    mem::wire::Codec[Probe].encode(stepper.state(), out: mut checkpoint)
    let Stopped(state: _, env: env) = try await take stepper.end()
    let restored = try mem::wire::Codec[Probe].decode(Untrusted.of(checkpoint.view()), alloc: world.alloc)
    var resumed = try Stepper[Probe, ProbeEnv, ProbeMessage].resume(take restored, take env, exec: world.exec, alloc: world.alloc)
    mut resumed.deliver(ProbeMessage.Count)
    let last = try await take resumed.end()
    expect last.state.handled == 3
} resumed_state_continues_its_checkpoint

test end_gives_the_env_back for Stepper.end {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    mut stepper.deliver(ProbeMessage.Echo)
    let echoed = mut stepper.step()
    let emptied = mut stepper.step()
    let last = try await take stepper.end()
    expect echoed and not emptied
    expect last.state.handled == 1
    expect last.env.counted == 1
} end_gives_the_env_back

test keyed_task_waits_until_started for Stepper.start_keyed {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    defer take stepper.abandon()
    mut stepper.deliver(ProbeMessage.Spawn(0))
    try await world.clock.sleep(10)
    let early = mut stepper.step()
    let busy = not stepper.idle()
    let started = mut stepper.start_keyed()
    let posted = try await stepper.ready()
    let handled = mut stepper.step()
    let waiting = try await stepper.ready()
    undefer stepper
    let last = try await take stepper.end()
    expect not early and busy and started == 1
    expect posted and handled and not waiting
    expect last.state.handled == 1
} keyed_task_waits_until_started

test superseded_held_task_posts_nothing for Stepper.ready {
    let world = testing::world()
    var stepper = try Stepper[Probe, ProbeEnv, ProbeMessage].start(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc)
    defer take stepper.abandon()
    mut stepper.deliver(ProbeMessage.Spawn(1_000))
    mut stepper.deliver(ProbeMessage.Stop)
    let started = mut stepper.start_keyed()
    let waiting = try await stepper.ready()
    let idle = stepper.idle()
    undefer stepper
    let last = try await take stepper.end()
    expect started == 1 and not waiting and idle
    expect last.state.handled == 0
} superseded_held_task_posts_nothing

test started_stepper_holds_the_start_state for Stepper.start {
    let world = testing::world()
