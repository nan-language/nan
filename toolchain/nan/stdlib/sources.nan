    \\    var state = started
    \\    let outcome = attempt await run_space(cpu, mut space, mut state, mut extended, served: Serving(services: services, table: take table), link, halted: fn() => false, mut frames, alloc)
    \\    take space.release(mut frames)
    \\    match outcome {
    \\        Ok(how) => return how
    \\        Err(cancelled) => fail IsolatedError.Cancelled(take cancelled)
    \\    }
    \\} run_isolated
    \\
    \\/// A space made to run an entry: the space, the thread state starting its runtime, and its table
    \\/// of handles.
    \\linear struct Placed {
    \\    space: sys::load::Space
    \\    state: hw::UserState
    \\    table: Table
    \\} Placed
    \\
    \\/// Makes a space of `job` from `frames` that runs `entry` on `input`, the instance of a component
    \\/// entry acting through `runner` when `held`, sharing `link`'s frames with it and laying out its
    \\/// start record.
    \\fn placed(cpu: hw::Ring0, job: sys::load::Isolated, entry: sys::load::Job, services: Services, runner: sys::Runner, link: Link, held: bool, take input: mem::Bytes, mut frames: mem::List[hw::PhysFrame[4_096]], alloc: mem::Alloc) -> Placed fails sys::load::LoadError {
    \\    var keys: usize = 0
    \\    for channel in link.channels {
    \\        keys += channel.key.as_str().as_bytes().len()
    \\    }
    \\    let ports_len = PORT_BYTES * link.channels.len()
    \\    let table = Table(held: mem::OnceMap[u64, Holding].empty(0, alloc), count: core::atomic::AtomicU64.of(0))
    \\    let log = held_by(table, holding: Holding.Log(services.log))
    \\    let stdio = held_by(table, holding: Holding.Stdio(services.stdio))
    \\    let random = held_by(table, holding: Holding.Random(services.random))
    \\    let channels = table.count.load()
    \\    for index in 0..<link.channels.len() {
    \\        discard held_by(table, holding: Holding.Channel(index))
    \\    }
    \\    let acting = held_by(table, holding: Holding.Runner(runner))
    \\    var space = try job.space(cpu, data: u64.widen(START_BYTES + ports_len + keys + input.len()), mut frames, alloc)
    \\    let start = space.data()
    \\    match attempt shared(mut space, link, start, channels, alloc) {
    \\        Ok(ports) => {
    \\            let input_at = start + u64.widen(START_BYTES + ports_len + keys)
    \\            let instance: u64 = match held {
    \\                true => 1
    \\                false => 0
    \\            }
    \\            let record = Start(job: entry, input: input_at, input_len: u64.widen(input.len()), bell: ports.bell, log: log, stdio: stdio, random: random, ports: start + u64.widen(START_BYTES), port_count: u64.widen(link.channels.len()), held: instance, runner: acting)
    \\            discard attempt mut space.write(start, bytes: record_bytes(record, count: START_BYTES, alloc).view())
