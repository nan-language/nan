//! Greets, reports how much its standard input gives and whether the wall clock is set, and ends with a status.

pub closed enum GreetError derives Render {
    Revoked(sys::Revoked) from
    Stdio(sys::StdioError) from
    Cancelled(task::Cancelled) from
} GreetError

fn main(take world: host::World) -> u8 fails GreetError uses wait limits stack 65_536 {
    var buffer = Untrusted.of(Array[u8, 32].filled(0))
    let read = try await world.stdio.read_in(mut buffer.view_mut())
    try await world.stdio.write_out(b"hello\n")
    world.log.info("read", value: read)
    let wall = try world.wall.now_ns()
    world.log.info("wall clock set", value: wall > 1_600_000_000_000_000_000)
    return 3
} main
