//! Reads the identification of the PL011 of the console port, then lets the first task end.

/// The data register and the first identification registers of a PL011.
registers Pl011 {
    data: u8 at 0x0 write
    first_id: u32 at 0xFE0 read
    second_id: u32 at 0xFE4 read
} Pl011

/// The values a PL011's first identification registers hold.
const FIRST_ID: u32 = 0x11

const SECOND_ID: u32 = 0x10

fn say(text: Str) {
    var port = trusted "the virt board maps the PL011 of the serial port at 0x0900_0000 and nothing else maps it" { hw::Mmio[Pl011].map(0x0900_0000) }
    for byte in text.as_bytes() {
        mut port.write(Pl011.data, value: byte)
    }
    take port.unmap()
} say

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    var console = trusted "the virt board maps the PL011 of the console port at 0x0904_0000 and nothing else maps it" { hw::Mmio[Pl011].map(0x0904_0000) }
    let found = mut console.read(Pl011.first_id) == FIRST_ID and mut console.read(Pl011.second_id) == SECOND_ID
    take console.unmap()
    if found {
        say(text: "console: a PL011 answers at 0x0904_0000\n")
    }
    take k.anchor(0u8, run: fn(exec: task::Executor) limits stack 16_384 {
    })
} main
