//! The construction text that derived `Render` writes.

pub open struct Codec[T: Encode] {
} Codec

pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    example attempt Codec[Option[i16]].decode(Untrusted.of(b" Some(-1_200) "), alloc: testing::world().alloc) == Ok(Some(-1_200))
    example attempt Codec[mem::List[u8]].decode(Untrusted.of(b"[1, 2,]"), alloc: testing::world().alloc) == Err(core::DecodeError.Malformed)
    example attempt Codec[char].decode(Untrusted.of(b"'\\u{D800}'"), alloc: testing::world().alloc) == Err(core::DecodeError.InvalidText)

test decode_reads_text_literals for Codec.decode {
    let escaped = attempt Codec[text::Fixed[4]].decode(Untrusted.of(b"\"a\\\"\\u{E9}\""), alloc: testing::world().alloc)
    let byte = attempt Codec[text::Fixed[4]].decode(Untrusted.of(b"\"\\x41\""), alloc: testing::world().alloc)
    expect escaped == Ok(text::Fixed[4].of("a\"é"))
    expect byte == Ok(text::Fixed[4].of("A"))
} decode_reads_text_literals
