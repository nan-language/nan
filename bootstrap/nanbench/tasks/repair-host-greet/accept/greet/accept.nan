//! Acceptance tests of the greeter.

/// The arguments with `text` added after them.
fn plus_argument(take listed: mem::List[mem::Bytes], text: Str, alloc: mem::Alloc) -> mem::List[mem::Bytes] {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(text.as_bytes())
    var longer = listed
    mut longer.push(take bytes)
    return longer
} plus_argument

/// What parsing the arguments holding `text` alone gives.
fn parsed_from(text: Str, alloc: mem::Alloc) -> Result[text::String, GreetError] {
    let listed = plus_argument(mem::List[mem::Bytes].empty(alloc), text, alloc)
    return attempt parse_name(Untrusted.of(take listed), alloc)
} parsed_from

/// The name parsing gave, empty when it failed.
fn name_of(take outcome: Result[text::String, GreetError], alloc: mem::Alloc) -> text::String {
    return match outcome {
        Ok(name) => name
        Err(_) => text::String.empty(alloc)
    }
} name_of

/// Whether parsing failed for a usage error.
fn misused(outcome: Result[text::String, GreetError]) -> bool {
    return match outcome {
        Err(GreetError.Usage) => true
        else => false
    }
} misused

test the_name_argument_is_parsed for parse_name {
    let alloc = testing::world().alloc
    let short_name = name_of(parsed_from("--name=adaLovelace", alloc), alloc)
    expect short_name.as_str() == "adaLovelace"
    let full_name = name_of(parsed_from("--name=abcdefghijklmnopqrstuvwxyzABCDEF", alloc), alloc)
    expect full_name.as_str() == "abcdefghijklmnopqrstuvwxyzABCDEF"
} the_name_argument_is_parsed

test other_arguments_are_refused for parse_name {
    let alloc = testing::world().alloc
    let no_outcome = attempt parse_name(Untrusted.of(mem::List[mem::Bytes].empty(alloc)), alloc)
    expect misused(no_outcome)
    let pair = plus_argument(plus_argument(mem::List[mem::Bytes].empty(alloc), text: "--name=ada", alloc), text: "--name=ada", alloc)
    let pair_outcome = attempt parse_name(Untrusted.of(take pair), alloc)
    expect misused(pair_outcome)
    let empty_outcome = parsed_from("--name=", alloc)
    expect misused(empty_outcome)
    let digit_outcome = parsed_from("--name=ada2", alloc)
    expect misused(digit_outcome)
    let flag_outcome = parsed_from("--nick=ada", alloc)
    expect misused(flag_outcome)
    let longer_outcome = parsed_from("--name=abcdefghijklmnopqrstuvwxyzABCDEFG", alloc)
    expect misused(longer_outcome)
} other_arguments_are_refused

test the_first_character_is_raised for capitalized {
    let alloc = testing::world().alloc
    let lower_name = capitalized("ada", alloc)
    expect lower_name.as_str() == "Ada"
    let upper_name = capitalized("Zed", alloc)
    expect upper_name.as_str() == "Zed"
    let accented_name = capitalized("éa", alloc)
    expect accented_name.as_str() == "éa"
    let no_name = capitalized("", alloc)
    expect no_name.as_str() == ""
} the_first_character_is_raised

test the_greeting_names_the_person for greeting {
    let alloc = testing::world().alloc
    let line = greeting("grace", alloc)
    expect line.as_str() == "Hello, Grace!\n"
} the_greeting_names_the_person
