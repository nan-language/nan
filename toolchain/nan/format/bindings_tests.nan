//! The tests of the bindings of an item.

/// A token naming a binding, with the token of the binding's first introduction.
struct Naming derives Copy {
    token: u32
    origin: u32
} Naming

/// A token as its line and text.
fn token_at(file: syntax::SourceFile, token: u32, mut out: text::String) {
    mut out.write(text::fmt("{line}:", line: file.tokens[usize.widen(token)].line), budget: 100)
    mut out.append(file.text(usize.widen(token)))
} token_at

/// Each identifier of the first item's bindings, by line and text, with the line and text of the
/// binding's first introduction; parameters marked `kept`; one per line in token order.
fn named_bindings(source: Str, grammar: syntax::Grammar, alloc: mem::Alloc) -> text::String {
    let file = syntax::parse(text::String.of(source, alloc).into_bytes(), grammar, alloc)
    var index: usize = 0
    while index < file.items.len() and file.items[index].tree.is_none() {
        index += 1
    }
    expect index < file.items.len()
    var written = text::String.empty(alloc)
    let Some(tree) = file.items[index].tree else {
        return written
    }
    let found = Bindings.collect(file, tree, alloc)
    var namings = mem::List[Naming].empty(alloc)
    for entry in found.of.cursor() {
        mut namings.push(Naming(token: entry.key(), origin: entry.value()))
    }
    mut namings.sort_by(fn(left: Naming, right: Naming) => left.token.cmp(right.token))
    for naming in namings {
        token_at(file, token: naming.token, out: mut written)
        mut written.append(" -> ")
        token_at(file, token: naming.origin, out: mut written)
        if found.parameters.contains(naming.origin) {
            mut written.append(" kept")
        }
        mut written.push('\n')
    }
    return written
} named_bindings

test uses_name_the_binding_in_scope for Bindings.collect {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    let found = named_bindings("fn f(limit: u32) -> u32 {\n    let total = limit\n    loop as outer {\n        for item in values() {\n            break outer\n        }\n    }\n    let add = fn [mut total](step: u32) => total + step\n    return match total {\n        Some(x) or Other(x) if x > 0 => all i in 0..<x: i < limit\n        else => total\n    }\n} f\n", grammar, alloc)
    expect found.as_str() == "1:limit -> 1:limit kept\n2:total -> 2:total\n2:limit -> 1:limit kept\n3:outer -> 3:outer\n4:item -> 4:item\n5:outer -> 3:outer\n8:add -> 8:add\n8:total -> 2:total\n8:step -> 8:step\n8:total -> 2:total\n8:step -> 8:step\n9:total -> 2:total\n10:x -> 10:x\n10:x -> 10:x\n10:x -> 10:x\n10:i -> 10:i\n10:x -> 10:x\n10:i -> 10:i\n10:limit -> 1:limit kept\n11:total -> 2:total\n"
} uses_name_the_binding_in_scope
