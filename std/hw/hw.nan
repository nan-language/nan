pub closed enum SysReg derives Copy, Eq {
    SctlrEl1
    TcrEl1
    MairEl1
    Ttbr1El1
    ContextidrEl1
    CpacrEl1
    CntkctlEl1
    TpidrEl0
    TpidrroEl0
    CntpCtlEl0
    CntpCvalEl0
    CntpTvalEl0
    CntvCtlEl0
    CntvCvalEl0
    CntvTvalEl0
    MidrEl1
    MpidrEl1
    CntfrqEl0
    CntpctEl0
    CntvctEl0
    CtrEl0
    IdAa64pfr0El1
    IdAa64isar0El1
    IdAa64mmfr0El1
} SysReg

pub fn SysReg.is_writable(self) -> bool limits pure, notrap, terminates
    example SysReg.TcrEl1.is_writable()
    example not SysReg.MpidrEl1.is_writable()
{
    return match self {
        SysReg.MidrEl1 or SysReg.MpidrEl1 or SysReg.CntfrqEl0 or SysReg.CntpctEl0 or SysReg.CntvctEl0 => false
        SysReg.CtrEl0 or SysReg.IdAa64pfr0El1 or SysReg.IdAa64isar0El1 or SysReg.IdAa64mmfr0El1 => false
        else => true
    }
} SysReg.is_writable

