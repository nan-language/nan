//! Files, directories and their metadata.

const GENERIC_READ: u32 = 0x8000_0000

const GENERIC_WRITE: u32 = 0x4000_0000

/// Sharing reads, writes and removals with every other handle, as a Linux file is shared.
const SHARE_ALL: u32 = 7

const CREATE_NEW: u32 = 1

const CREATE_ALWAYS: u32 = 2

const OPEN_EXISTING: u32 = 3

const OPEN_ALWAYS: u32 = 4

const FILE_ATTRIBUTE_READONLY: u32 = 0x1

const FILE_ATTRIBUTE_DIRECTORY: u32 = 0x10

const FILE_ATTRIBUTE_NORMAL: u32 = 0x80

const FILE_ATTRIBUTE_TEMPORARY: u32 = 0x100

const FILE_ATTRIBUTE_REPARSE_POINT: u32 = 0x400

/// The flag opening a directory, or what a link names, for its metadata.
const FILE_FLAG_BACKUP_SEMANTICS: u32 = 0x0200_0000

const FILE_FLAG_DELETE_ON_CLOSE: u32 = 0x0400_0000

/// The reparse tags of a junction and of a symbolic link.
const MOUNT_POINT_TAG: u32 = 0xA000_0003

const SYMLINK_TAG: u32 = 0xA000_000C

const LOCKFILE_EXCLUSIVE_LOCK: u32 = 2

const MOVEFILE_REPLACE_EXISTING: u32 = 1

const FILE_BEGIN: u32 = 0

const ERROR_HANDLE_EOF: u32 = 38

/// The error of a path naming a file where a directory is wanted.
const ERROR_DIRECTORY: u32 = 267

/// The handles `GetStdHandle` gives for these numbers.
const STD_INPUT_HANDLE: u32 = 0xFFFF_FFF6

const STD_OUTPUT_HANDLE: u32 = 0xFFFF_FFF5

const STD_ERROR_HANDLE: u32 = 0xFFFF_FFF4

/// The handle `CreateFileW` and `FindFirstFileW` give on failure.
const INVALID_HANDLE: u64 = 0xFFFF_FFFF_FFFF_FFFF

/// The attributes `GetFileAttributesW` gives on failure.
const INVALID_ATTRIBUTES: u32 = 0xFFFF_FFFF

/// The bytes a read asks for at least, before the file's size is known.
const READ_CHUNK: usize = 8_192

/// The most bytes one read or write of the system moves.
const MOST_MOVED: usize = 1_073_741_824

/// Windows' `WIN32_FIND_DATAW`.
layout FindData: bytes 592 le {
    attributes: u32 at 0
    created: u64 at 4
    accessed: u64 at 12
    written: u64 at 20
    size_high: u32 at 28
    size_low: u32 at 32
    tag: u32 at 36
    reserved: u32 at 40
    name: Array[u16, 260] at 44
    short_name: Array[u16, 14] at 564
} FindData

/// Windows' `BY_HANDLE_FILE_INFORMATION`.
layout FileInformation: bytes 52 le {
    attributes: u32 at 0
    created: u64 at 4
    accessed: u64 at 12
    written: u64 at 20
    volume: u32 at 28
    size_high: u32 at 32
    size_low: u32 at 36
    links: u32 at 40
    index_high: u32 at 44
    index_low: u32 at 48
} FileInformation

/// Windows' `OVERLAPPED` on 64-bit Windows, which places a read and a lock of a handle opened
/// for synchronous calls.
layout Overlapped: bytes 32 le {
    internal: u64 at 0
    internal_high: u64 at 8
    offset: u32 at 16
    offset_high: u32 at 20
    event: u64 at 24
} Overlapped

/// Windows' `SECURITY_ATTRIBUTES` on 64-bit Windows.
layout SecurityAttributes: bytes 24 le {
    size: u32 at 0
    padding: u32 at 4
    descriptor: u64 at 8
    inherit: u32 at 16
    padding_end: u32 at 20
} SecurityAttributes

foreign fn CreateFileW(name: hw::Ptr[u16], access: u32, share: u32, security: hw::Ptr[SecurityAttributes], disposition: u32, flags: u32, template: u64) -> u64 convention "win64"

foreign fn ReadFile(handle: u64, buffer: hw::Ptr[u8], count: u32, done: hw::Ptr[u32], overlapped: hw::Ptr[Overlapped]) -> i32 convention "win64"

foreign fn WriteFile(handle: u64, buffer: hw::Ptr[u8], count: u32, done: hw::Ptr[u32], overlapped: hw::Ptr[Overlapped]) -> i32 convention "win64"

foreign fn GetFileSizeEx(handle: u64, size: hw::Ptr[u64]) -> i32 convention "win64"

foreign fn SetFilePointerEx(handle: u64, distance: i64, position: hw::Ptr[u64], method: u32) -> i32 convention "win64"

foreign fn SetEndOfFile(handle: u64) -> i32 convention "win64"

foreign fn FlushFileBuffers(handle: u64) -> i32 convention "win64"

foreign fn LockFileEx(handle: u64, flags: u32, reserved: u32, low: u32, high: u32, overlapped: hw::Ptr[Overlapped]) -> i32 convention "win64"

foreign fn UnlockFileEx(handle: u64, reserved: u32, low: u32, high: u32, overlapped: hw::Ptr[Overlapped]) -> i32 convention "win64"

foreign fn GetStdHandle(which: u32) -> u64 convention "win64"

foreign fn MoveFileExW(from: hw::Ptr[u16], to: hw::Ptr[u16], flags: u32) -> i32 convention "win64"

foreign fn DeleteFileW(name: hw::Ptr[u16]) -> i32 convention "win64"

foreign fn CreateDirectoryW(name: hw::Ptr[u16], security: hw::Ptr[SecurityAttributes]) -> i32 convention "win64"

foreign fn RemoveDirectoryW(name: hw::Ptr[u16]) -> i32 convention "win64"

foreign fn GetFileAttributesW(name: hw::Ptr[u16]) -> u32 convention "win64"

foreign fn SetFileAttributesW(name: hw::Ptr[u16], attributes: u32) -> i32 convention "win64"

foreign fn FindFirstFileW(name: hw::Ptr[u16], data: hw::Ptr[FindData]) -> u64 convention "win64"

foreign fn FindNextFileW(search: u64, data: hw::Ptr[FindData]) -> i32 convention "win64"

foreign fn FindClose(search: u64) -> i32 convention "win64"

foreign fn GetFileInformationByHandle(handle: u64, information: hw::Ptr[FileInformation]) -> i32 convention "win64"

foreign fn GetCurrentDirectoryW(size: u32, buffer: hw::Ptr[u16]) -> u32 convention "win64"

foreign fn GetFinalPathNameByHandleW(handle: u64, buffer: hw::Ptr[u16], size: u32, flags: u32) -> u32 convention "win64"

/// What the system records of a file: its kind, and who else may reach it.
pub open struct Metadata derives Copy {
    pub kind: platform::FileKind
} Metadata

/// Whether a user other than `user` owns the file or may write it, as its owner and mode say on
/// Linux; never on Windows, whose access control lists the toolchain does not read.
pub fn Metadata.writable_by_others(self, user: u32) -> bool {
    return false
} Metadata.writable_by_others

/// Whether a user other than `user` owns the file or may access it, as its owner and mode say on
/// Linux; never on Windows, whose access control lists the toolchain does not read.
pub fn Metadata.accessible_by_others(self, user: u32) -> bool {
    return false
} Metadata.accessible_by_others

pub fn Metadata.is_file(self) -> bool = self.kind == platform::FileKind.Regular

pub fn Metadata.is_dir(self) -> bool = self.kind == platform::FileKind.Directory

pub fn Metadata.is_symlink(self) -> bool = self.kind == platform::FileKind.Symlink

/// A file this process holds open, until `close`.
pub open linear struct File {
    handle: u64
} File

/// Opens a file for reading.
pub fn File.open(path: Str) -> File fails platform::IoError {
    return try open_file(path, access: GENERIC_READ, disposition: OPEN_EXISTING)
} File.open

/// Opens a file for writing, creating it when it is missing, with `mode` where the system gives
/// files one, and emptying it otherwise.
pub fn File.create(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, access: GENERIC_WRITE, disposition: CREATE_ALWAYS)
} File.create

/// Creates a file, with `mode` where the system gives files one, and opens it for writing;
/// `AlreadyExists` when the path names one.
pub fn File.create_new(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, access: GENERIC_WRITE, disposition: CREATE_NEW)
} File.create_new

/// Opens a file for writing without changing it, creating it when it is missing, with `mode` where
/// the system gives files one.
pub fn File.open_or_create(path: Str, mode: u32) -> File fails platform::IoError {
    return try open_file(path, access: GENERIC_WRITE, disposition: OPEN_ALWAYS)
} File.open_or_create

fn open_file(path: Str, access: u32, disposition: u32) -> File fails platform::IoError {
    let name = try wide(path)
    let handle = trusted "name holds a NUL-terminated path, and a null pointer asks for no security attributes" { CreateFileW(hw::Ptr.of_view(name.units.view()), access, share: SHARE_ALL, security: hw::Ptr.of_addr(0), disposition, flags: FILE_ATTRIBUTE_NORMAL, template: 0) }
    if handle == INVALID_HANDLE {
        fail last_error()
    }
    return File(handle: handle)
} open_file

pub fn File.close(take self) {
    let File(handle: handle) = self
    release(handle)
} File.close

/// Writes all of `data` at the file's position.
pub fn File.write_all(self, data: Slice[u8]) fails platform::IoError {
    try write_handle(self.handle, data)
} File.write_all

/// Returns once the file's contents and metadata are on disk.
pub fn File.sync_all(self) fails platform::IoError {
    try checked(trusted "self.handle is a file this process holds open" { FlushFileBuffers(self.handle) })
} File.sync_all

/// Returns once the entries of the directory `path` are on disk, as renames into it leave them: on
/// Linux by syncing the directory, and on Windows, whose file systems journal their entries in
/// order, once it finds that `path` names a directory.
pub fn sync_dir(path: Str) fails platform::IoError {
    if not (try metadata(path)).is_dir() {
        fail platform::IoError.Other(i32.from_bits(ERROR_DIRECTORY))
    }
} sync_dir

/// Waits for the exclusive lock of the file.
pub fn File.lock(self) fails platform::IoError {
    try lock_range(self.handle, flags: LOCKFILE_EXCLUSIVE_LOCK)
} File.lock

/// Waits for a shared lock of the file.
pub fn File.lock_shared(self) fails platform::IoError {
    try lock_range(self.handle, flags: 0)
} File.lock_shared

/// Releases the lock the file holds.
pub fn File.unlock(self) fails platform::IoError {
    var place = Overlapped.from_bits(Array[u8, 32].filled(0))
    try checked(trusted "place addresses an OVERLAPPED placing the range at offset 0" { UnlockFileEx(self.handle, reserved: 0, low: 0xFFFF_FFFF, high: 0xFFFF_FFFF, overlapped: hw::Ptr.of_mut(mut place)) })
} File.unlock

/// Waits for a lock of the whole range of an open file, exclusive with `LOCKFILE_EXCLUSIVE_LOCK`.
fn lock_range(handle: u64, flags: u32) fails platform::IoError {
    var place = Overlapped.from_bits(Array[u8, 32].filled(0))
    try checked(trusted "place addresses an OVERLAPPED placing the range at offset 0" { LockFileEx(handle, flags, reserved: 0, low: 0xFFFF_FFFF, high: 0xFFFF_FFFF, overlapped: hw::Ptr.of_mut(mut place)) })
} lock_range

/// The rest of the file from its position.
pub fn File.read_to_end(self, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    return try read_rest(self.handle, alloc)
} File.read_to_end

/// What standard input holds up to its end.
pub fn read_stdin(alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    return try read_rest(std_handle(STD_INPUT_HANDLE), alloc)
} read_stdin

/// One of this process's standard handles.
fn std_handle(which: u32) -> u64 {
    return trusted "GetStdHandle reads no memory" { GetStdHandle(which) }
} std_handle

/// The rest of an open handle's file from its position, up to its end or the close of the pipe
/// it reads.
fn read_rest(handle: u64, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    var room = READ_CHUNK
    var size: u64 = 0
    let sized = trusted "size addresses a LARGE_INTEGER" { GetFileSizeEx(handle, size: hw::Ptr.of_mut(mut size)) }
    if sized != 0 and size > 0 {
        room = usize.widen(size).saturating_add(1)
    }
    var data = mem::Bytes.zeroed(room, alloc)
    var filled: usize = 0
    loop {
        if filled == data.len() {
            let extra = mem::Bytes.zeroed(data.len(), alloc)
            mut data.append(extra.view())
        }
        var count = data.len() - filled
        if count > MOST_MOVED {
            count = MOST_MOVED
        }
        var done: u32 = 0
        let start = hw::Ptr.of_view_mut(mut data.view_mut())
        let succeeded = trusted "start addresses the len bytes of data, of which filled are behind, done a DWORD, and a null pointer places nothing" { ReadFile(handle, buffer: start.offset(isize.fit(filled)), count: u32.fit(count), done: hw::Ptr.of_mut(mut done), overlapped: hw::Ptr.of_addr(0)) }
        if succeeded == 0 {
            let code = last_code()
            if code != ERROR_BROKEN_PIPE {
                fail error_of(code)
            }
            done = 0
        }
        if done == 0 {
            mut data.truncate(filled)
            return data
        }
        filled += usize.widen(done)
    }
} read_rest

/// Writes all of `data` to an open handle.
fn write_handle(handle: u64, data: Slice[u8]) fails platform::IoError {
    var written: usize = 0
    while written < data.len() {
        var count = data.len() - written
        if count > MOST_MOVED {
            count = MOST_MOVED
        }
        var done: u32 = 0
        let start = hw::Ptr.of_view(data)
        try checked(trusted "start addresses the len bytes of data, of which written are behind, done a DWORD, and a null pointer places nothing" { WriteFile(handle, buffer: start.offset(isize.fit(written)), count: u32.fit(count), done: hw::Ptr.of_mut(mut done), overlapped: hw::Ptr.of_addr(0)) })
        if done == 0 {
            fail platform::IoError.Other(0)
        }
        written += usize.widen(done)
    }
} write_handle

/// Writes all of `data` to standard output.
pub fn write_stdout(data: Slice[u8]) fails platform::IoError {
    try write_handle(std_handle(STD_OUTPUT_HANDLE), data)
} write_stdout

/// Writes all of `data` to standard error.
pub fn write_stderr(data: Slice[u8]) fails platform::IoError {
    try write_handle(std_handle(STD_ERROR_HANDLE), data)
} write_stderr

/// The contents of a file.
pub fn read_all(path: Str, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    return try file.read_to_end(alloc)
} read_all

/// The `length` bytes of a file at an offset, fewer when the file ends before them.
pub fn read_at(path: Str, at: usize, length: usize, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    let file = try File.open(path)
    defer take file.close()
    var data = mem::Bytes.zeroed(length, alloc)
    var filled: usize = 0
    while filled < length {
        var count = length - filled
        if count > MOST_MOVED {
            count = MOST_MOVED
        }
        let position = u64.widen(at).wrapping_add(u64.widen(filled))
        var place = Overlapped.from_bits(Array[u8, 32].filled(0))
        place.offset = u32.truncate(position)
        place.offset_high = u32.truncate(position >> 32)
        var done: u32 = 0
        let start = hw::Ptr.of_view_mut(mut data.view_mut())
        let succeeded = trusted "start addresses the length bytes of data, of which filled are behind, done a DWORD, and place an OVERLAPPED placing the read" { ReadFile(file.handle, buffer: start.offset(isize.fit(filled)), count: u32.fit(count), done: hw::Ptr.of_mut(mut done), overlapped: hw::Ptr.of_mut(mut place)) }
        if succeeded == 0 {
            let code = last_code()
            if code == ERROR_HANDLE_EOF {
                break
            }
            fail error_of(code)
        }
        if done == 0 {
            break
        }
        filled += usize.widen(done)
    }
    mut data.truncate(filled)
    return data
} read_at

/// The contents of a file, which hold text; `InvalidData` when they are not well-formed UTF-8.
pub fn read_text(path: Str, alloc: mem::Alloc) -> text::String fails platform::IoError {
    let data = try read_all(path, alloc)
    let Ok(decoded) = attempt text::String.try_from_utf8(data.view(), alloc) else {
        fail platform::IoError.InvalidData
    }
    return decoded
} read_text

/// Writes a file whole, creating it when it is missing, with mode rw-rw-rw- where the system gives
/// files one.
pub fn write_all(path: Str, contents: Slice[u8]) fails platform::IoError {
    let file = try File.create(path, mode: 0b110_110_110)
    defer take file.close()
    try file.write_all(contents)
} write_all

/// Writes a file of `bytes` zero bytes, replacing any file `path` names; on Linux the system
/// allocates them only as they are written.
pub fn write_sized(path: Str, bytes: u64) fails platform::IoError {
    let file = try File.create(path, mode: 0b110_110_110)
    defer take file.close()
    let Some(length) = i64.checked_fit(bytes) else {
        fail platform::IoError.Other(0)
    }
    try checked(trusted "a null pointer asks for no new position" { SetFilePointerEx(file.handle, distance: length, position: hw::Ptr.of_addr(0), method: FILE_BEGIN) })
    try checked(trusted "file.handle is a file this process holds open for writing" { SetEndOfFile(file.handle) })
} write_sized

/// Whether this process may open a file for reading and writing.
pub fn may_read_write(path: Str) -> bool {
    let Ok(file) = attempt open_file(path, access: GENERIC_READ | GENERIC_WRITE, disposition: OPEN_EXISTING) else {
        return false
    }
    take file.close()
    return true
} may_read_write

/// Renames a file or directory, replacing the file `to` names.
pub fn rename_path(from: Str, to: Str) fails platform::IoError {
    let old = try wide(from)
    let new = try wide(to)
    try checked(trusted "old and new hold NUL-terminated paths" { MoveFileExW(hw::Ptr.of_view(old.units.view()), to: hw::Ptr.of_view(new.units.view()), flags: MOVEFILE_REPLACE_EXISTING) })
} rename_path

/// Removes a file, a read-only one too.
pub fn remove_file(path: Str) fails platform::IoError {
    let name = try wide(path)
    let removed = trusted "name holds a NUL-terminated path" { DeleteFileW(hw::Ptr.of_view(name.units.view())) }
    if removed != 0 {
        return
    }
    let code = last_code()
    let attributes = attributes_of(name)
    if code != ERROR_ACCESS_DENIED or attributes == INVALID_ATTRIBUTES or (attributes & FILE_ATTRIBUTE_READONLY) == 0 {
        fail error_of(code)
    }
    try checked(trusted "name holds a NUL-terminated path" { SetFileAttributesW(hw::Ptr.of_view(name.units.view()), attributes: attributes & ~FILE_ATTRIBUTE_READONLY) })
    try checked(trusted "name holds a NUL-terminated path" { DeleteFileW(hw::Ptr.of_view(name.units.view())) })
} remove_file

/// The attributes of what a path names, a link itself; `INVALID_ATTRIBUTES` when the system gives
/// none.
fn attributes_of(name: Wide) -> u32 {
    return trusted "name holds a NUL-terminated path" { GetFileAttributesW(hw::Ptr.of_view(name.units.view())) }
} attributes_of

/// Creates a directory, with `mode` where the system gives directories one, its parent existing.
pub fn create_dir(path: Str, mode: u32) fails platform::IoError {
    let name = try wide(path)
    try checked(trusted "name holds a NUL-terminated path, and a null pointer asks for no security attributes" { CreateDirectoryW(hw::Ptr.of_view(name.units.view()), security: hw::Ptr.of_addr(0)) })
} create_dir

/// Creates a directory and every missing parent, with mode rwxrwxrwx where the system gives
/// directories one; succeeds when the path names a directory.
pub fn create_dir_all(path: Str, alloc: mem::Alloc) fails platform::IoError {
    if path.is_empty() {
        return
    }
    let made = attempt create_dir(path, mode: 0b111_111_111)
    match first made {
        Ok(_) => return
        Err(platform::IoError.NotFound) => {}
        Err(error) => {
            if is_dir(path) {
                return
            }
            fail error
        }
    }
    let Some(above) = platform::parent(path, alloc) else {
        fail platform::IoError.Other(0)
    }
    try create_dir_all(above.as_str(), alloc)
    let Err(error) = attempt create_dir(path, mode: 0b111_111_111) else {
        return
    }
    if is_dir(path) {
        return
    }
    fail error
} create_dir_all

/// The metadata of what a path names, a symbolic link or junction followed.
pub fn metadata(path: Str) -> Metadata fails platform::IoError {
    let held = try symlink_metadata(path)
    if not held.is_symlink() {
        return held
    }
    let name = try wide(path)
    let handle = trusted "name holds a NUL-terminated path, and a null pointer asks for no security attributes" { CreateFileW(hw::Ptr.of_view(name.units.view()), access: 0, share: SHARE_ALL, security: hw::Ptr.of_addr(0), disposition: OPEN_EXISTING, flags: FILE_FLAG_BACKUP_SEMANTICS, template: 0) }
    if handle == INVALID_HANDLE {
        fail last_error()
    }
    var raw = FileInformation.from_bits(Array[u8, 52].filled(0))
    let buffer = hw::Ptr.of_mut(mut raw)
    let succeeded = trusted "handle is open and buffer addresses a BY_HANDLE_FILE_INFORMATION" { GetFileInformationByHandle(handle, information: buffer) }
    if succeeded == 0 {
        let error = last_error()
        release(handle)
        fail error
    }
    release(handle)
    let information = trusted "GetFileInformationByHandle wrote a BY_HANDLE_FILE_INFORMATION at buffer" { buffer.read() }
    return Metadata(kind: kind_of(information.attributes))
} metadata

/// The metadata of what a path names, a symbolic link or junction itself.
pub fn symlink_metadata(path: Str) -> Metadata fails platform::IoError {
    let name = try wide(path)
    let attributes = attributes_of(name)
    if attributes == INVALID_ATTRIBUTES {
        fail last_error()
    }
    if (attributes & FILE_ATTRIBUTE_REPARSE_POINT) == 0 {
        return Metadata(kind: kind_of(attributes))
    }
    var raw = FindData.from_bits(Array[u8, 592].filled(0))
    let buffer = hw::Ptr.of_mut(mut raw)
    let search = trusted "name holds a NUL-terminated path and buffer addresses a WIN32_FIND_DATAW" { FindFirstFileW(hw::Ptr.of_view(name.units.view()), data: buffer) }
    if search == INVALID_HANDLE {
        fail last_error()
    }
    end_search(search)
    return Metadata(kind: entry_kind(trusted "FindFirstFileW wrote a WIN32_FIND_DATAW at buffer" { buffer.read() }))
} symlink_metadata

fn end_search(search: u64) {
    discard trusted "search is a search this process started and ends once" { FindClose(search) }
} end_search

/// The kind of a file with these attributes that is no link.
fn kind_of(attributes: u32) -> platform::FileKind {
    if (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0 {
        return platform::FileKind.Directory
    }
    return platform::FileKind.Regular
} kind_of

/// The kind of the file a search found: a link when it is a symbolic link or a junction.
fn entry_kind(found: FindData) -> platform::FileKind {
    if (found.attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 and (found.tag == SYMLINK_TAG or found.tag == MOUNT_POINT_TAG) {
        return platform::FileKind.Symlink
    }
    return kind_of(found.attributes)
} entry_kind

/// Whether a path names something, a symbolic link followed.
pub fn exists(path: Str) -> bool {
    let Ok(_) = attempt metadata(path) else {
        return false
    }
    return true
} exists

/// Whether a path names a directory, a symbolic link followed.
pub fn is_dir(path: Str) -> bool {
    let Ok(held) = attempt metadata(path) else {
        return false
    }
    return held.is_dir()
} is_dir

/// The entries of a directory but `.` and `..`, in the order the system gives them.
pub fn list_dir(path: Str, alloc: mem::Alloc) -> mem::List[platform::DirEntry] fails platform::IoError {
    var pattern = Wide(units: NO_WIDE)
    let end = try put_wide(mut pattern, at: 0, written: path)
    if path.ends_with("/") or path.ends_with("\\") {
        discard try put_wide(mut pattern, at: end, written: "*")
    } else {
        discard try put_wide(mut pattern, at: end, written: "/*")
    }
    var raw = FindData.from_bits(Array[u8, 592].filled(0))
    let buffer = hw::Ptr.of_mut(mut raw)
    let search = trusted "pattern holds a NUL-terminated pattern and buffer addresses a WIN32_FIND_DATAW" { FindFirstFileW(hw::Ptr.of_view(pattern.units.view()), data: buffer) }
    var found = mem::List[platform::DirEntry].empty(alloc)
    if search == INVALID_HANDLE {
        let code = last_code()
        if code == ERROR_FILE_NOT_FOUND {
            return found
        }
        fail error_of(code)
    }
    defer end_search(search)
    loop {
        let entry = trusted "FindFirstFileW or FindNextFileW wrote a WIN32_FIND_DATAW at buffer" { buffer.read() }
        let name = try entry_name(entry, alloc)
        if name.view() != b"." and name.view() != b".." {
            mut found.push(platform::DirEntry(name: take name, kind: entry_kind(entry)))
        }
        let next = trusted "search is an open search and buffer addresses a WIN32_FIND_DATAW" { FindNextFileW(search, data: buffer) }
        if next == 0 {
            let code = last_code()
            if code == ERROR_NO_MORE_FILES {
                return found
            }
            fail error_of(code)
        }
    }
} list_dir

/// The name of the file a search found, as UTF-8 bytes; `InvalidData` when it holds an unpaired
/// surrogate.
fn entry_name(found: FindData, alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    var length: usize = 0
    while length < 260 and found.name[length] != 0 {
        length += 1
    }
    let Some(units) = found.name.view().prefix(length) else {
        fail platform::IoError.InvalidData
    }
    let Some(written) = narrow(units, slashed: false, alloc) else {
        fail platform::IoError.InvalidData
    }
    var name = mem::Bytes.empty(alloc)
    mut name.append(written.as_bytes())
    return name
} entry_name

/// Removes a directory with everything in it, or a symbolic link or junction itself; a link inside
/// is removed, never followed.
pub fn remove_dir_all(path: Str, alloc: mem::Alloc) fails platform::IoError {
    let held = try symlink_metadata(path)
    if held.is_symlink() {
        try remove_link(path)
        return
    }
    if not held.is_dir() {
        fail platform::IoError.Other(i32.from_bits(ERROR_DIRECTORY))
    }
    try remove_tree(path, alloc)
} remove_dir_all

/// Removes a directory after what it holds.
fn remove_tree(path: Str, alloc: mem::Alloc) fails platform::IoError {
    for entry in try list_dir(path, alloc) {
        let Ok(name) = attempt text::String.try_from_utf8(entry.name.view(), alloc) else {
            fail platform::IoError.InvalidData
        }
        let child = platform::join(path, name: name.as_str(), alloc)
        let removed = attempt remove_child(child.as_str(), kind: entry.kind, alloc)
        let Err(error) = removed else {
            continue
        }
        if error != platform::IoError.NotFound {
            fail error
        }
    }
    let name = try wide(path)
    let gone = trusted "name holds a NUL-terminated path" { RemoveDirectoryW(hw::Ptr.of_view(name.units.view())) }
    if gone == 0 {
        let error = last_error()
        if error != platform::IoError.NotFound {
            fail error
        }
    }
} remove_tree

fn remove_child(path: Str, kind: platform::FileKind, alloc: mem::Alloc) fails platform::IoError {
    match kind {
        platform::FileKind.Directory => try remove_tree(path, alloc)
        platform::FileKind.Symlink => try remove_link(path)
        else => try remove_file(path)
    }
} remove_child

/// Removes a symbolic link or a junction itself: one to a directory as a directory.
fn remove_link(path: Str) fails platform::IoError {
    let name = try wide(path)
    let attributes = attributes_of(name)
    if attributes != INVALID_ATTRIBUTES and (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0 {
        try checked(trusted "name holds a NUL-terminated path" { RemoveDirectoryW(hw::Ptr.of_view(name.units.view())) })
        return
    }
    try remove_file(path)
} remove_link

/// The current directory of this process, with `/` separators: the bytes Linux gives, or the UTF-8
/// of the path Windows gives.
pub fn current_dir(alloc: mem::Alloc) -> mem::Bytes fails platform::IoError {
    var buffer = Wide(units: NO_WIDE)
    let length = trusted "buffer addresses WIDE_UNITS code units" { GetCurrentDirectoryW(u32.fit(WIDE_UNITS), buffer: hw::Ptr.of_view_mut(mut buffer.units.view_mut())) }
    if usize.widen(length) >= WIDE_UNITS {
        fail platform::IoError.Other(i32.from_bits(ERROR_FILENAME_EXCED_RANGE))
    }
    let written = try written_wide(buffer, length, slashed: true, alloc)
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(written.as_bytes())
    return bytes
} current_dir

/// The absolute path naming what a path names, once every link and every `.` and `..` component is
/// resolved, with `/` separators; `InvalidData` when the system's path is not well-formed Unicode.
pub fn canonicalize(path: Str, alloc: mem::Alloc) -> text::String fails platform::IoError {
    let name = try wide(path)
    let handle = trusted "name holds a NUL-terminated path, and a null pointer asks for no security attributes" { CreateFileW(hw::Ptr.of_view(name.units.view()), access: 0, share: SHARE_ALL, security: hw::Ptr.of_addr(0), disposition: OPEN_EXISTING, flags: FILE_FLAG_BACKUP_SEMANTICS, template: 0) }
    if handle == INVALID_HANDLE {
        fail last_error()
    }
    var buffer = Wide(units: NO_WIDE)
    let length = trusted "handle is open and buffer addresses WIDE_UNITS code units" { GetFinalPathNameByHandleW(handle, buffer: hw::Ptr.of_view_mut(mut buffer.units.view_mut()), size: u32.fit(WIDE_UNITS), flags: 0) }
    if length == 0 {
        let error = last_error()
        release(handle)
        fail error
    }
    release(handle)
    if usize.widen(length) >= WIDE_UNITS {
        fail platform::IoError.Other(i32.from_bits(ERROR_FILENAME_EXCED_RANGE))
    }
    let full = try written_wide(buffer, length, slashed: true, alloc)
    return without_verbatim(full.as_str(), alloc)
} canonicalize

/// A full path the system gives in its verbatim form, `//?/` before a drive's path and `//?/UNC/`
/// before a share's, as Windows programs read it.
fn without_verbatim(full: Str, alloc: mem::Alloc) -> text::String {
    if full.starts_with("//?/UNC/") {
        var shared = text::String.of("//", alloc)
        let Some(rest) = full.slice_bytes(8, end: full.byte_len()) else {
            return text::String.of(full, alloc)
        }
        mut shared.append(rest)
        return shared
    }
    if full.starts_with("//?/") {
        let Some(rest) = full.slice_bytes(4, end: full.byte_len()) else {
            return text::String.of(full, alloc)
        }
        return text::String.of(rest, alloc)
    }
    return text::String.of(full, alloc)
} without_verbatim
