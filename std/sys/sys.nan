pub fn CapabilityId.of_handle(self, handle: Handle) -> Option[C]

pub open struct Port[Q: Protocol] derives Copy, Send {
    runner: Runner
    id: u64
} Port

pub fn Port.of[M: Any and Send](cx: Cx[M], id: u64) -> Port[Q] {
    return Port(runner: cx.runner(), id: id)
} Port.of

pub fn Port.call[R: Send, E: Send](self, reply: Reply[R, E], call: Encoded, alloc: mem::Alloc) -> R fails CallError[E] uses wait {
    let answer = match attempt await self.runner.call(self.id, hash: Wire[Q].hash(), bytes: call.bytes.view(), handles: call.handles.view(), alloc) {
        Ok(encoded) => encoded
        Err(RunnerError.Cancelled(cancelled)) => fail CallError.Cancelled(take cancelled)
        else => fail CallError.Closed(task::SendError.Closed)
    }
    return try reply.decode(Untrusted.of(answer.bytes.view()), handles: answer.handles.view(), alloc)
} Port.call

pub interface Resource {
    fn held(take self) -> Held limits pure, notrap, terminates
    fn of_held(take held: Held) -> Result[Self, Held] limits pure, notrap, terminates
} Resource

pub closed enum Held {
    File(fs::File)
    Listener(net::Listener)
} Held

impl fs::File: Resource

impl net::Listener: Resource

pub fn fs::File.held(take self) -> Held = Held.File(take self)

pub fn fs::File.of_held(take held: Held) -> Result[fs::File, Held] limits pure, notrap, terminates {
    match held {
        Held.File(file) => return Ok(take file)
        Held.Listener(listener) => return Err(Held.Listener(take listener))
    }
} fs::File.of_held

pub fn net::Listener.held(take self) -> Held = Held.Listener(take self)

pub fn net::Listener.of_held(take held: Held) -> Result[net::Listener, Held] limits pure, notrap, terminates {
    match held {
        Held.Listener(listener) => return Ok(take listener)
        Held.File(file) => return Err(Held.File(take file))
    }
} net::Listener.of_held

pub closed struct ResourceId[R: Resource] derives Copy, Eq, Encode {
    pub id: u64
} ResourceId

pub open struct Resources derives Copy, Send {
    runner: Runner
} Resources

pub fn Resources.of[M: Any and Send](cx: Cx[M]) -> Resources {
    return Resources(runner: cx.runner())
} Resources.of

pub fn Resources.resource[R: Resource](self, id: ResourceId[R]) -> R fails RunnerError uses wait {
    return try await self.typed(id, held: try await self.runner.resource(id.id))
} Resources.resource

pub fn Resources.take_resource[R: Resource](self, id: ResourceId[R]) -> R fails RunnerError uses wait {
    return try await self.typed(id, held: try await self.runner.take_resource(id.id))
} Resources.take_resource

pub fn Resources.put_resource[R: Resource](self, id: ResourceId[R], take resource: R) fails RunnerError uses wait {
    try await self.runner.put_resource(id.id, resource: take resource.held())
} Resources.put_resource

/// The resource `held` holds when it is an R, failing with `RunnerError.Unknown` once it puts any
/// other back under `id`.
fn Resources.typed[R: Resource](self, id: ResourceId[R], take held: Held) -> R fails RunnerError uses wait {
    match R.of_held(take held) {
        Ok(resource) => return resource
        Err(other) => {
            discard attempt await self.runner.put_resource(id.id, resource: take other)
            fail RunnerError.Unknown
        }
    }
} Resources.typed

