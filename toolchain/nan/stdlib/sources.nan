const TEXT_CORE_CRYPTO_CRYPTO: Str =
    \\//! Ed25519 signatures over SHA-512, as RFC 8032 defines them, verified strictly.
    \\
    \\/// A public key: the encoding of a curve point.
    \\pub closed struct PublicKey derives Copy, Eq, Ord, Hash {
    \\    pub bytes: Array[u8, 32]
    \\} PublicKey
    \\
    \\/// A signature: the encoding of the point R, then the scalar S, least significant byte first.
    \\pub closed struct Signature derives Copy, Eq {
    \\    pub bytes: Array[u8, 64]
    \\} Signature
    \\
    \\/// A secret key: the scalar and the prefix its seed expands to, with its public key.
    \\pub open struct SecretKey {
    \\    scalar: Array[u8, 32]
    \\    prefix: Array[u8, 32]
    \\    public: PublicKey
    \\} SecretKey
    \\
    \\/// The key of a 32-byte secret seed.
    \\pub fn SecretKey.of_seed(seed: Array[u8, 32]) -> SecretKey limits pure, terminates {
    \\    var hasher = Sha512.empty()
    \\    mut hasher.update(seed.view())
    \\    let digest = hasher.finish()
    \\    var scalar = Array[u8, 32].filled(0)
    \\    var prefix = Array[u8, 32].filled(0)
    \\    for at in 0..<32usize {
    \\        scalar[at] = digest[at]
    \\        prefix[at] = digest[at + 32]
    \\    }
    \\    scalar[0] = scalar[0] & 248
    \\    scalar[31] = (scalar[31] & 127) | 64
    \\    let public = PublicKey(bytes: scalar_mul(base(), scalar).encoded())
    \\    return SecretKey(scalar: scalar, prefix: prefix, public: public)
    \\} SecretKey.of_seed
    \\
    \\pub fn SecretKey.public_key(self) -> PublicKey limits pure, notrap, terminates {
    \\    return self.public
    \\} SecretKey.public_key
    \\
    \\/// The signature of a message by this key.
    \\pub fn SecretKey.sign(self, message: Slice[u8]) -> Signature limits pure, terminates {
    \\    var nonce = Sha512.empty()
    \\    mut nonce.update(self.prefix.view())
    \\    mut nonce.update(message)
    \\    let r = reduced(nonce.finish())
    \\    let point = scalar_mul(base(), scalar: r).encoded()
    \\    let k = challenge(point, key: self.public, message)
    \\    var x = Array[i64, 64].filled(0)
    \\    for i in 0..<32usize {
    \\        x[i] = i64.widen(r[i])
    \\    }
    \\    for i in 0..<32usize {
    \\        for j in 0..<32usize {
    \\            x[i + j] = x[i + j].wrapping_add(i64.widen(k[i]).wrapping_mul(i64.widen(self.scalar[j])))
    \\        }
    \\    }
    \\    let s = reduced_limbs(x)
    \\    var bytes = Array[u8, 64].filled(0)
    \\    for at in 0..<32usize {
    \\        bytes[at] = point[at]
    \\        bytes[at + 32] = s[at]
    \\    }
    \\    return Signature(bytes: bytes)
    \\} SecretKey.sign
    \\
    \\/// Whether `signature` is a signature of `message` by this key: the key and R are canonical
    \\/// encodings, S is below the group order, the key does not have small order, and
    \\/// `[S]B - [k]A` encodes as R.
    \\pub fn PublicKey.verify(self, message: Slice[u8], signature: Signature) -> bool limits pure, terminates {
    \\    let Some(point) = decoded(self.bytes) else {
    \\        return false
    \\    }
    \\    var r = Array[u8, 32].filled(0)
    \\    var s = Array[u8, 32].filled(0)
    \\    for at in 0..<32usize {
    \\        r[at] = signature.bytes[at]
    \\        s[at] = signature.bytes[at + 32]
    \\    }
    \\    if not below_order(s) {
    \\        return false
    \\    }
    \\    let four = point.plus(point).plus(point.plus(point))
    \\    if four.plus(four).encoded() == neutral().encoded() {
    \\        return false
    \\    }
    \\    let negated = Point(x: ZERO.minus(point.x), y: point.y, z: point.z, t: ZERO.minus(point.t))
    \\    let k = challenge(r, key: self, message)
    \\    let check = scalar_mul(negated, scalar: k).plus(scalar_mul(base(), scalar: s))
    \\    return check.encoded() == r
    \\} PublicKey.verify
    \\
    \\/// The scalar of the digest of R, the public key and the message.
    \\fn challenge(r: Array[u8, 32], key: PublicKey, message: Slice[u8]) -> Array[u8, 32] {
    \\    var hasher = Sha512.empty()
    \\    mut hasher.update(r.view())
    \\    mut hasher.update(key.bytes.view())
    \\    mut hasher.update(message)
    \\    return reduced(hasher.finish())
    \\} challenge
    \\
    \\/// A field element modulo 2^255 - 19: sixteen limbs of 16 bits, least significant first, each
    \\/// possibly out of range between operations.
    \\struct Field derives Copy {
    \\    limbs: Array[i64, 16]
    \\} Field
    \\
    \\/// The field element whose limbs the four 64-bit words hold, least significant first.
    \\fn field_of(w0: u64, w1: u64, w2: u64, w3: u64) -> Field {
    \\    var limbs = Array[i64, 16].filled(0)
    \\    for j in 0..<4u32 {
    \\        let at = usize.widen(j)
    \\        limbs[at] = i64.widen(u16.truncate(w0 >> (16 * j)))
    \\        limbs[at + 4] = i64.widen(u16.truncate(w1 >> (16 * j)))
    \\        limbs[at + 8] = i64.widen(u16.truncate(w2 >> (16 * j)))
    \\        limbs[at + 12] = i64.widen(u16.truncate(w3 >> (16 * j)))
    \\    }
    \\    return Field(limbs: limbs)
    \\} field_of
    \\
    \\const ZERO: Field = field_of(0, w1: 0, w2: 0, w3: 0)
    \\
    \\const ONE: Field = field_of(1, w1: 0, w2: 0, w3: 0)
    \\
    \\/// The curve constant d = -121665/121666, and twice it.
    \\const CURVE_D: Field = field_of(0x75EB_4DCA_1359_78A3, w1: 0x0070_0A4D_4141_D8AB, w2: 0x8CC7_4079_7779_E898, w3: 0x5203_6CEE_2B6F_FE73)
    \\
    \\const CURVE_D2: Field = field_of(0xEBD6_9B94_26B2_F159, w1: 0x00E0_149A_8283_B156, w2: 0x198E_80F2_EEF3_D130, w3: 0x2406_D9DC_56DF_FCE7)
    \\
    \\/// The coordinates of the base point B.
    \\const BASE_X: Field = field_of(0xC956_2D60_8F25_D51A, w1: 0x692C_C760_9525_A7B2, w2: 0xC0A4_E231_FDD6_DC5C, w3: 0x2169_36D3_CD6E_53FE)
    \\
    \\const BASE_Y: Field = field_of(0x6666_6666_6666_6658, w1: 0x6666_6666_6666_6666, w2: 0x6666_6666_6666_6666, w3: 0x6666_6666_6666_6666)
    \\
    \\/// A square root of -1.
    \\const SQRT_M1: Field = field_of(0xC4EE_1B27_4A0E_A0B0, w1: 0x2F43_1806_AD2F_E478, w2: 0x2B4D_0099_3DFB_D7A7, w3: 0x2B83_2480_4FC1_DF0B)
    \\
    \\fn Field.carried(self) -> Field {
    \\    var o = self.limbs
    \\    for i in 0..<16usize {
    \\        o[i] = o[i].wrapping_add(65_536)
    \\        let c = o[i].shr_arith(16)
    \\        if i == 15 {
    \\            o[0] = o[0].wrapping_add(c.wrapping_sub(1).wrapping_mul(38))
    \\        } else {
    \\            o[i + 1] = o[i + 1].wrapping_add(c.wrapping_sub(1))
    \\        }
    \\        o[i] = o[i].wrapping_sub(c.wrapping_shl(16))
    \\    }
    \\    return Field(limbs: o)
    \\} Field.carried
    \\
    \\fn Field.plus(self, other: Field) -> Field {
    \\    var o = self.limbs
    \\    for i in 0..<16usize {
    \\        o[i] = o[i].wrapping_add(other.limbs[i])
    \\    }
    \\    return Field(limbs: o)
    \\} Field.plus
    \\
    \\fn Field.minus(self, other: Field) -> Field {
    \\    var o = self.limbs
    \\    for i in 0..<16usize {
    \\        o[i] = o[i].wrapping_sub(other.limbs[i])
    \\    }
    \\    return Field(limbs: o)
    \\} Field.minus
    \\
    \\fn Field.times(self, other: Field) -> Field {
    \\    var t = Array[i64, 31].filled(0)
    \\    for i in 0..<16usize {
    \\        for j in 0..<16usize {
    \\            t[i + j] = t[i + j].wrapping_add(self.limbs[i].wrapping_mul(other.limbs[j]))
    \\        }
    \\    }
    \\    var o = Array[i64, 16].filled(0)
    \\    for i in 0..<15usize {
    \\        o[i] = t[i].wrapping_add(t[i + 16].wrapping_mul(38))
    \\    }
    \\    o[15] = t[15]
    \\    return Field(limbs: o).carried().carried()
