item "nanos::run"
text "pub fn run("
text "    load: sys::load::Load,"
text "    take world: World,"
text "    take input: mem::Bytes,"
text "    domain: sys::Abandoner,"
text "    exec: task::Executor,"
text "    alloc: mem::Alloc,"
text "    ) -> Ended fails RunError uses wait"
interface "ae6ctxz6oj6njsfbuz7f5toryae67a6jyuoxs2retq7lklinlmy5ypo"
digest any "effects wait alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
