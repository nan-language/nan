//! The NaN toolchain's interface to the system running it: files, directories, locks and processes on Linux, macOS, Windows and NaN OS, with the paths and texts they take.

package platform {
    language 1
    targets aarch64-linux, aarch64-macos, aarch64-nanos, aarch64-windows, x86_64-linux, x86_64-macos, x86_64-nanos, x86_64-windows
    allow trusted in os
    allow validate in platform
} platform
