pkg fn Code.class(self) -> Class {
    return match self {
        Code.InternalInvariant or Code.InternalResourceExhausted => Class.Internal
        Code.ApiStale or Code.ApiWeakeningPending or Code.DocStale or Code.RetiredForwardedUse or Code.SealSameAuthor or Code.TestDbg or Code.TestGeneratorGap or Code.ThresholdDepth or Code.ThresholdLength or Code.TodoDisputed or Code.TodoHole or Code.TodoMissingSpec or Code.TrustUnsealed or Code.UnusedDependency or Code.UnusedField or Code.UnusedGrant or Code.UnusedItem or Code.UnusedLocal or Code.UnusedTombstone => Class.Incompleteness
        else => Class.Error
    }
} Code.class

/// The role of a reason in a because-chain.
pkg enum Role derives Copy, Eq {
    /// Its line declares the subject the reported construct is checked against.
    Declared
    /// Its line binds or creates the subject.
    Bound
    /// Its line starts a hold freezing the subject.
    Frozen
    /// Its line starts a hold holding the subject.
    Held
    /// Its line moves the subject.
    Moved
    /// Its line uses the subject, keeping a hold or a value live.
    Used
    /// Its line accesses the subject, written with its mode.
    Accessed
    /// Its line calls the subject, through which a fact reaches the reported line.
    Called
    /// Its line is the site of a fact; the subject is the operation.
    Raised
    /// Its line is the reported line of another diagnostic, whose code is the subject.
    Diagnostic
    /// The command making the change the owning rule requires, on no line.
    Command
    /// A value the owning rule names, on no line.
    Note
} Role

pkg proj fn Role.word(self) -> Str {
    return match self {
        Role.Declared => "declared"
        Role.Bound => "bound"
        Role.Frozen => "frozen"
        Role.Held => "held"
        Role.Moved => "moved"
        Role.Used => "used"
        Role.Accessed => "accessed"
        Role.Called => "called"
        Role.Raised => "raised"
        Role.Diagnostic => "diagnostic"
        Role.Command => "command"
        Role.Note => "note"
    }
} Role.word

/// A file and a line in it.
pkg struct At {
    pkg path: text::String
    pkg line: u32
} At

pkg struct Reason {
    pkg role: Role
    pkg subject: text::String
    /// The workspace file and line the reason lies on, when it lies in source.
    pkg at: Option[At]
} Reason

pkg fn Reason.note(subject: Str, alloc: mem::Alloc) -> Reason {
    return Reason(role: Role.Note, subject: text::String.of(subject, alloc), at: None)
} Reason.note

/// The bytes `start..end` of a source file.
pkg struct Span derives Copy, Eq {
    pkg start: u32
    pkg end: u32
} Span

/// A replacement of the bytes `start..end` of a source file, an empty run inserting the text.
pkg struct Replacement {
    pkg start: u32
    pkg end: u32
    pkg text: text::String
} Replacement

/// A replacement in the source file at a path.
pkg struct Edit {
    pkg path: text::String
    pkg replacement: Replacement
} Edit

/// An exact fix: replacements in the workspace's source files, by path, none overlapping.
pkg struct Fix {
    pkg edits: mem::List[Edit]
} Fix

/// The fix making this one's replacements and another's.
pkg fn Fix.joined(take self, take other: Fix) -> Fix {
    var edits = self.edits
    for edit in take other.edits {
        mut edits.push(take edit)
    }
    return Fix(edits: take edits)
} Fix.joined

/// Which of the fixes a rule names a diagnostic offers, among those passing the in-memory
/// re-check.
pkg enum Offer derives Copy, Eq {
    /// Each.
    Each
    /// The first, the others being its alternatives.
    First
    /// The one, when exactly one passes.
    Unique
} Offer

/// The output of an external program a diagnostic quotes: the program's name and the lines.
pkg struct Envelope {
    pkg origin: text::String
    pkg lines: mem::List[text::String]
} Envelope

/// One reported root cause. The quote and the item are derived from the location when printed.
pkg struct Diagnostic {
    pkg code: Code
    pkg path: Option[text::String]
    pkg line: Option[u32]
    /// The canonical path of the item it is reported on, when the checker reports it.
    pkg item: Option[text::String]
    pkg expected: Option[text::String]
    pkg found: Option[text::String]
    pkg because: mem::List[Reason]
    /// The bytes of the reported construct in its file.
    pkg span: Option[Span]
    /// The bytes of the construct its rule judges, when wider than the reported construct.
    pkg judged: Option[Span]
    /// For a syntax failure, the first byte of the token at which the parse failed.
    pkg failing: Option[u32]
    /// The fixes its rule names, or once re-checked, those it offers.
    pkg fixes: mem::List[Fix]
    pkg offer: Offer
    pkg envelope: Option[Envelope]
} Diagnostic

pkg fn Diagnostic.new(code: Code, alloc: mem::Alloc) -> Diagnostic {
    return Diagnostic(code: code, path: None, line: None, item: None, expected: None, found: None, because: mem::List[Reason].empty(alloc), span: None, judged: None, failing: None, fixes: mem::List[Fix].empty(alloc), offer: Offer.Each, envelope: None)
} Diagnostic.new

pkg fn Diagnostic.at(code: Code, path: Str, line: u32, alloc: mem::Alloc) -> Diagnostic {
    var diagnostic = Diagnostic.new(code, alloc)
    diagnostic.path = Some(text::String.of(path, alloc))
    diagnostic.line = Some(line)
    return diagnostic
} Diagnostic.at

pkg fn Diagnostic.copy(self, alloc: mem::Alloc) -> Diagnostic {
    var because = mem::List[Reason].empty(alloc)
    for reason in self.because {
        var at: Option[At] = None
        match reason.at {
            Some(held) => {
                at = Some(At(path: text::String.of(held.path.as_str(), alloc), line: held.line))
            }
            None => {}
        }
        mut because.push(Reason(role: reason.role, subject: text::String.of(reason.subject.as_str(), alloc), at: take at))
    }
    var fixes = mem::List[Fix].empty(alloc)
    for fix in self.fixes {
        var edits = mem::List[Edit].empty(alloc)
        for edit in fix.edits {
            let replacement = Replacement(start: edit.replacement.start, end: edit.replacement.end, text: text::String.of(edit.replacement.text.as_str(), alloc))
            mut edits.push(Edit(path: text::String.of(edit.path.as_str(), alloc), replacement: take replacement))
        }
        mut fixes.push(Fix(edits: take edits))
    }
    var envelope: Option[Envelope] = None
    match self.envelope {
        Some(held) => {
            var lines = mem::List[text::String].empty(alloc)
            for line in held.lines {
                mut lines.push(text::String.of(line.as_str(), alloc))
            }
            envelope = Some(Envelope(origin: text::String.of(held.origin.as_str(), alloc), lines: take lines))
        }
        None => {}
    }
    return Diagnostic(code: self.code, path: copied_text(self.path, alloc), line: self.line, item: copied_text(self.item, alloc), expected: copied_text(self.expected, alloc), found: copied_text(self.found, alloc), because: take because, span: self.span, judged: self.judged, failing: self.failing, fixes: take fixes, offer: self.offer, envelope: take envelope)
} Diagnostic.copy

fn copied_text(held: Option[text::String], alloc: mem::Alloc) -> Option[text::String] {
    let Some(value) = held else {
        return None
    }
    return Some(text::String.of(value.as_str(), alloc))
} copied_text
