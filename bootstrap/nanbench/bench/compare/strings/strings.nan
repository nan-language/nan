//! The size's numbers written into a string, then read back.

enum BenchError derives Render {
    Usage
    Stdio(sys::StdioError) from
    Cancelled(task::Cancelled) from
} BenchError

/// The number the first argument states in decimal, if it states one.
validator fn size(args: Untrusted[mem::List[mem::Bytes]]) -> Option[u64] {
    let Some(arg) = args.inspect().get(0) else {
        return None
    }
    var value: u64 = 0
    for digit in arg.view() {
        if digit < b'0' or digit > b'9' {
            return None
        }
        value = value * 10 + u64.widen(digit - b'0')
    }
    return Some(value)
} size

/// The numbers below `n`, each followed by a comma.
fn numbers(n: u64, alloc: mem::Alloc) -> text::String {
    var written = text::String.empty(alloc)
    for number in 0..<n {
        mut written.write(text::fmt("{number},", number), budget: 32)
    }
    return written
} numbers

/// The sum of the numbers a text of numbers each followed by a comma holds.
fn sum(written: Slice[u8]) -> u64 {
    var total: u64 = 0
    var number: u64 = 0
    for byte in written {
        if byte == b',' {
            total += number
            number = 0
        } else {
            number = number * 10 + u64.widen(byte - b'0')
        }
    }
    return total
} sum

fn main(take world: host::World) fails BenchError uses wait {
    let Some(n) = size(world.args) else {
        fail BenchError.Usage
    }
    let written = numbers(n, alloc: world.alloc)
    var out = text::String.empty(world.alloc)
    mut out.write(text::fmt("{length} {total}\n", length: written.byte_len(), total: sum(written.as_bytes())), budget: 64)
    let bytes = take out.into_bytes()
    try await world.stdio.write_out(bytes.view())
} main
