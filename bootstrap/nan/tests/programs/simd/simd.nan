fn report_u8(log: sys::Log) {
    let a_u8 = lanes_u8(seed: 8, extremes: true)
    let b_u8 = lanes_u8(seed: 56, extremes: false)
    say(log, label: "u8 splat", value: hashed(bytes_u8(core::simd::U8x16.splat(b_u8.lane(15)))))
    say(log, label: "u8 add", value: hashed(bytes_u8(a_u8.wrapping_add(b_u8))))
    say(log, label: "u8 sub", value: hashed(bytes_u8(a_u8.wrapping_sub(b_u8))))
    say(log, label: "u8 saturating add", value: hashed(bytes_u8(a_u8.saturating_add(b_u8))))
    say(log, label: "u8 saturating sub", value: hashed(bytes_u8(a_u8.saturating_sub(b_u8))))
    say(log, label: "u8 and", value: hashed(bytes_u8(a_u8.bit_and(b_u8))))
    say(log, label: "u8 or", value: hashed(bytes_u8(a_u8.bit_or(b_u8))))
    say(log, label: "u8 xor", value: hashed(bytes_u8(a_u8.bit_xor(b_u8))))
    say(log, label: "u8 not", value: hashed(bytes_u8(a_u8.bit_not())))
    say(log, label: "u8 shl", value: hashed(bytes_u8(a_u8.shl(5))))
    say(log, label: "u8 shr", value: hashed(bytes_u8(a_u8.shr(5))))
    say(log, label: "u8 eq", value: mask_u8(a_u8.lanes_eq(a_u8.replace_lane(1, value: b_u8.lane(1)))))
    say(log, label: "u8 lt", value: mask_u8(a_u8.lanes_lt(b_u8)))
    say(log, label: "u8 gt", value: mask_u8(a_u8.lanes_gt(b_u8)))
    say(log, label: "u8 mask ops", value: mask_u8(a_u8.lanes_lt(b_u8).bit_xor(a_u8.lanes_gt(b_u8)).bit_or(a_u8.lanes_eq(b_u8).bit_not()).bit_and(a_u8.lanes_eq(a_u8))))
    say(log, label: "u8 select", value: hashed(bytes_u8(core::simd::U8x16.select(a_u8.lanes_lt(b_u8), if_true: a_u8, if_false: b_u8))))
    say(log, label: "u8 sum", value: u64.widen(a_u8.wrapping_sum()))
    var stored_u8 = Array[u8, 17].filled(0)
    a_u8.store(mut stored_u8.view_mut(), at: 1)
    say(log, label: "u8 load", value: hashed(bytes_u8(core::simd::U8x16.load(stored_u8.view(), at: 1).wrapping_add(b_u8))))
} report_u8

fn report_i8(log: sys::Log) {
