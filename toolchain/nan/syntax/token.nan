//! Tokens, including the virtual tokens the lexer adds.

pkg enum TokenKind derives Copy, Eq {
    Ident
    Int
    Float
    Text
    Bytes
    Char
    Byte
    TextLine
    Doc
    FileDoc
    Keyword(Keyword)
    Punct(Punct)
    Foreign(Foreign)
    Nl
    Col0
    Eof
    /// The position after the tokens of a line holding a lexical diagnostic.
    LexError
} TokenKind

pkg fn TokenKind.is_virtual(self) -> bool {
    return match self {
        TokenKind.Nl or TokenKind.Col0 or TokenKind.Eof or TokenKind.LexError => true
        else => false
    }
} TokenKind.is_virtual

/// A token after which the logical line continues on the next line holding a token.
pkg fn TokenKind.is_continuing(self) -> bool {
    return match first self {
        TokenKind.Punct(Punct.RParen) or TokenKind.Punct(Punct.RBracket) or TokenKind.Punct(Punct.RBrace) => false
        TokenKind.Punct(_) => true
        TokenKind.Foreign(Foreign.AmpAmp) or TokenKind.Foreign(Foreign.PipePipe) => true
        TokenKind.Keyword(Keyword.And) or TokenKind.Keyword(Keyword.Or) or TokenKind.Keyword(Keyword.Not) => true
        else => false
    }
} TokenKind.is_continuing

/// The terminal the token is in the grammar, an `IDENT` before any context word reading.
fn TokenKind.term(self) -> Option[Term] {
    return match self {
        TokenKind.Ident => Some(Term.Class(Class.Ident))
        TokenKind.Int => Some(Term.Class(Class.Int))
        TokenKind.Float => Some(Term.Class(Class.Float))
        TokenKind.Text => Some(Term.Class(Class.Text))
        TokenKind.Bytes => Some(Term.Class(Class.Bytes))
        TokenKind.Char => Some(Term.Class(Class.Char))
        TokenKind.Byte => Some(Term.Class(Class.Byte))
        TokenKind.TextLine => Some(Term.Class(Class.TextLine))
        TokenKind.Doc => Some(Term.Class(Class.Doc))
        TokenKind.FileDoc => Some(Term.Class(Class.FileDoc))
        TokenKind.Keyword(keyword) => Some(Term.Keyword(keyword))
        TokenKind.Punct(punct) => Some(Term.Punct(punct))
        TokenKind.Nl => Some(Term.Class(Class.Nl))
        TokenKind.Col0 => Some(Term.Class(Class.Col0))
        TokenKind.Eof => Some(Term.Class(Class.Eof))
        TokenKind.Foreign(_) or TokenKind.LexError => None
    }
} TokenKind.term

/// A token of a source file. Virtual tokens are empty; `line` is the physical line, from 1.
pkg struct Token derives Copy, Eq {
    pkg kind: TokenKind
    pkg start: u32
    pkg end: u32
    pkg line: u32
} Token

/// The text of a source file in which each byte of an ill-formed UTF-8 sequence is `?`. A token
/// never holds such a byte, so its text is the bytes `start..end` of this text.
pkg fn source_text(source: Slice[u8], alloc: mem::Alloc) -> text::String {
    var readable = text::String.empty(alloc)
    var at: usize = 0
    while at < source.len() {
        match text::utf8::char_at(source, at) {
            Some(c) => {
                mut readable.push(c)
                at += c.utf8_len()
            }
            None => {
                mut readable.push('?')
                at += 1
            }
        }
    }
    return readable
} source_text

/// The context word an `IDENT` token spells, if any.
fn Token.context_word(self, source: Slice[u8]) -> Option[ContextWord] {
    if self.kind != TokenKind.Ident {
        return None
    }
    let Some(parts) = source.split_at(usize.widen(self.start)) else {
        expect false
        return None
    }
    let Some(spelt) = parts.tail.prefix(usize.widen(self.end - self.start)) else {
        expect false
        return None
    }
    return ContextWord.from_spelling(spelt)
} Token.context_word

/// The written form of the token in grammar notation, as a failure reports it.
fn Token.written(self, alloc: mem::Alloc) -> text::String {
    match self.kind {
        TokenKind.Foreign(spelt) => {
            var written = text::String.empty(alloc)
            mut written.push('"')
            mut written.append(spelt.spelling())
            mut written.push('"')
            return written
        }
        else => {}
    }
    let Some(term) = self.kind.term() else {
        expect false
        return text::String.empty(alloc)
    }
    return term.written(alloc)
} Token.written
