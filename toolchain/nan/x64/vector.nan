//! The instructions on whole vector registers: the SSE operations of the base set and of SSE4.1, numbered as their encodings number them, with their legacy and VEX encodings, the AVX2 broadcasts and the AVX-512 operations of `x86_64-v4`, EVEX-encoded.

/// An operation of two vector registers, the destination's lanes combined with the source's, or
/// of one, the destination written from the source alone.
pkg enum Packed derives Copy, Eq {
    Paddb
    Paddw
    Paddd
    Paddq
    Psubb
    Psubw
    Psubd
    Psubq
    Pmullw
    Pmulld
    Pmuludq
    Paddsb
    Paddsw
    Paddusb
    Paddusw
    Psubsb
    Psubsw
    Psubusb
    Psubusw
    Pand
    Pandn
    Por
    Pxor
    Pcmpeqb
    Pcmpeqw
    Pcmpeqd
    Pcmpeqq
    Pcmpgtb
    Pcmpgtw
    Pcmpgtd
    Pcmpgtq
    Psllw
    Pslld
    Psllq
    Psrlw
    Psrld
    Psrlq
    Psraw
    Psrad
    Punpcklbw
    Punpcklwd
    Punpckldq
    Punpcklqdq
    Punpckhbw
    Punpckhwd
    Packsswb
    Packuswb
    Phaddd
    Addps
    Subps
    Mulps
    Divps
    Minps
    Maxps
    Andnps
    Orps
    Xorps
    Pmovsxbw
    Pmovsxwd
    Sqrtps
    Cvtdq2ps
    Cvttps2dq
} Packed

/// The mandatory prefix, opcode map and opcode of an operation as `0xPPMMOO`: the prefix none,
/// `0x66`, `0xF2` or `0xF3`, the map 1 for `0F`, 2 for `0F 38` and 3 for `0F 3A`, and the opcode.
fn Packed.code(self) -> u32 {
    return match self {
        Packed.Paddb => 0x6601FC
        Packed.Paddw => 0x6601FD
        Packed.Paddd => 0x6601FE
        Packed.Paddq => 0x6601D4
        Packed.Psubb => 0x6601F8
        Packed.Psubw => 0x6601F9
        Packed.Psubd => 0x6601FA
        Packed.Psubq => 0x6601FB
        Packed.Pmullw => 0x6601D5
        Packed.Pmulld => 0x660240
        Packed.Pmuludq => 0x6601F4
        Packed.Paddsb => 0x6601EC
        Packed.Paddsw => 0x6601ED
        Packed.Paddusb => 0x6601DC
        Packed.Paddusw => 0x6601DD
        Packed.Psubsb => 0x6601E8
        Packed.Psubsw => 0x6601E9
        Packed.Psubusb => 0x6601D8
        Packed.Psubusw => 0x6601D9
        Packed.Pand => 0x6601DB
        Packed.Pandn => 0x6601DF
        Packed.Por => 0x6601EB
        Packed.Pxor => 0x6601EF
        Packed.Pcmpeqb => 0x660174
        Packed.Pcmpeqw => 0x660175
        Packed.Pcmpeqd => 0x660176
        Packed.Pcmpeqq => 0x660229
        Packed.Pcmpgtb => 0x660164
        Packed.Pcmpgtw => 0x660165
        Packed.Pcmpgtd => 0x660166
        Packed.Pcmpgtq => 0x660237
        Packed.Psllw => 0x6601F1
        Packed.Pslld => 0x6601F2
        Packed.Psllq => 0x6601F3
        Packed.Psrlw => 0x6601D1
        Packed.Psrld => 0x6601D2
        Packed.Psrlq => 0x6601D3
        Packed.Psraw => 0x6601E1
        Packed.Psrad => 0x6601E2
        Packed.Punpcklbw => 0x660160
        Packed.Punpcklwd => 0x660161
        Packed.Punpckldq => 0x660162
        Packed.Punpcklqdq => 0x66016C
        Packed.Punpckhbw => 0x660168
        Packed.Punpckhwd => 0x660169
        Packed.Packsswb => 0x660163
        Packed.Packuswb => 0x660167
        Packed.Phaddd => 0x660202
        Packed.Addps => 0x000158
        Packed.Subps => 0x00015C
        Packed.Mulps => 0x000159
        Packed.Divps => 0x00015E
        Packed.Minps => 0x00015D
        Packed.Maxps => 0x00015F
        Packed.Andnps => 0x000155
        Packed.Orps => 0x000156
        Packed.Xorps => 0x000157
        Packed.Pmovsxbw => 0x660220
        Packed.Pmovsxwd => 0x660223
        Packed.Sqrtps => 0x000151
        Packed.Cvtdq2ps => 0x00015B
        Packed.Cvttps2dq => 0xF3015B
    }
} Packed.code

/// Whether the operation writes its destination from its source alone.
fn Packed.is_unary(self) -> bool {
    return match self {
        Packed.Pmovsxbw or Packed.Pmovsxwd or Packed.Sqrtps or Packed.Cvtdq2ps or Packed.Cvttps2dq => true
        else => false
    }
} Packed.is_unary

/// An operation of vector registers taking an 8-bit immediate: `pshufd` and `pshuflw` writing
/// their destination from their source, `shufps` and `cmpps` combining both.
pkg enum PackedImm derives Copy, Eq {
    Pshufd
    Pshuflw
    Shufps
    Cmpps
} PackedImm

fn PackedImm.code(self) -> u32 {
    return match self {
        PackedImm.Pshufd => 0x660170
        PackedImm.Pshuflw => 0xF20170
        PackedImm.Shufps => 0x0001C6
        PackedImm.Cmpps => 0x0001C2
    }
} PackedImm.code

fn PackedImm.is_unary(self) -> bool = self == PackedImm.Pshufd or self == PackedImm.Pshuflw

/// A shift of each lane of a vector register by an immediate, or of the whole register right by
/// bytes for `Psrldq`.
pkg enum PackedShift derives Copy, Eq {
    Psllw
    Pslld
    Psllq
    Psrlw
    Psrld
    Psrlq
    Psraw
    Psrad
} PackedShift

/// The opcode of a shift's group, `0x71` for words, `0x72` for doublewords and `0x73` for
/// quadwords, and its ModRM reg extension: 6 left, 2 logical right, 4 arithmetic right.
fn PackedShift.code(self) -> u32 {
    return match self {
        PackedShift.Psllw => 0x7106
        PackedShift.Pslld => 0x7206
        PackedShift.Psllq => 0x7306
        PackedShift.Psrlw => 0x7102
        PackedShift.Psrld => 0x7202
        PackedShift.Psrlq => 0x7302
        PackedShift.Psraw => 0x7104
        PackedShift.Psrad => 0x7204
    }
} PackedShift.code

/// An AVX-512 operation of `x86_64-v4` on 64-bit lanes: `vpmullq` and `vpsraq` by the count in
/// a vector register.
pkg enum PackedWide derives Copy, Eq {
    Vpmullq
    Vpsraq
} PackedWide

fn PackedWide.code(self) -> u32 {
    return match self {
        PackedWide.Vpmullq => 0x660240
        PackedWide.Vpsraq => 0x6601E2
    }
} PackedWide.code

/// Which lanes' top bits a move of a mask gathers: bytes for `pmovmskb`, doublewords for
/// `movmskps` and quadwords for `movmskpd`.
pkg enum MaskMove derives Copy, Eq {
    Bytes
    Dwords
    Qwords
} MaskMove

fn MaskMove.code(self) -> u32 {
    return match self {
        MaskMove.Bytes => 0x6601D7
        MaskMove.Dwords => 0x000150
        MaskMove.Qwords => 0x660150
    }
} MaskMove.code

/// The escape bytes and their count for an opcode map of a code.
fn escaped(code: u32) -> u32 {
    let opcode = code & 0xFF
    return match (code >> 8) & 0xFF {
        2 => 0x0F3800 | opcode
        3 => 0x0F3A00 | opcode
        else => 0x0F00 | opcode
    }
} escaped

fn escape_len(code: u32) -> u32 {
    if ((code >> 8) & 0xFF) == 1 {
        return 2
    }
    return 3
} escape_len

/// The legacy encoding of an operation of a code: its prefix, REX, escape and opcode, and a
/// ModRM naming `reg` and `rm`.
fn Assembler.legacy(mut self, code: u32, reg: u8, rm: u8) {
    let prefix = u8.truncate(code >> 16)
    if prefix != 0 {
        mut self.put8(prefix)
    }
    mut self.reg_reg(false, opcode: escaped(code), len: escape_len(code), reg: reg, rm: rm, force: false)
} Assembler.legacy

/// The `pp` field of a VEX or EVEX prefix for a code's mandatory prefix.
fn prefix_field(code: u32) -> u8 {
    return match code >> 16 {
        0x66 => 1
        0xF3 => 2
        0xF2 => 3
        else => 0
    }
} prefix_field

/// The three-byte VEX encoding of a 128-bit operation of a code: `reg` in ModRM's reg field,
/// `operand` in VEX.vvvv and `rm` in ModRM's r/m field.
fn Assembler.vex(mut self, code: u32, w: bool, reg: u8, operand: u8, rm: u8) {
    mut self.put8(0xC4)
    var lead = u8.truncate((code >> 8) & 0x1F)
    if reg < 8 {
        lead = lead | 0x80
    }
    lead = lead | 0x40
    if rm < 8 {
        lead = lead | 0x20
    }
    mut self.put8(lead)
    var second = ((~operand & 15) << 3) | prefix_field(code)
    if w {
        second = second | 0x80
    }
    mut self.put8(second)
    mut self.put8(u8.truncate(code))
    mut self.put8(0xC0 | ((reg & 7) << 3) | (rm & 7))
} Assembler.vex

/// The EVEX encoding of a 128-bit operation of a code on 64-bit lanes, unmasked: `reg` in
/// ModRM's reg field, `operand` in EVEX.vvvv and `rm` in ModRM's r/m field.
fn Assembler.evex(mut self, code: u32, reg: u8, operand: u8, rm: u8) {
    mut self.put8(0x62)
    var lead = u8.truncate((code >> 8) & 0x3) | 0x50
    if reg < 8 {
        lead = lead | 0x80
    }
    if rm < 8 {
        lead = lead | 0x20
    }
    mut self.put8(lead)
    mut self.put8(0x80 | ((~operand & 15) << 3) | 0x04 | prefix_field(code))
    mut self.put8(0x08)
    mut self.put8(u8.truncate(code))
    mut self.put8(0xC0 | ((reg & 7) << 3) | (rm & 7))
} Assembler.evex

/// `movdqu` between a vector register and memory: a load when `load` holds, else a store.
fn Assembler.movdqu(mut self, load: bool, reg: machinst::Reg, mem: Amode) {
    mut self.put8(0xF3)
    var opcode: u32 = 0x0F7F
    if load {
        opcode = 0x0F6F
    }
    mut self.reg_mem(false, opcode: opcode, len: 2, reg: hw(reg), mem: mem, trailing: 0, force: false)
} Assembler.movdqu

/// A shift by an immediate: its group's opcode with the extension in ModRM's reg field.
fn Assembler.packed_shift(mut self, op: PackedShift, reg: machinst::Reg, imm: u8) {
    mut self.put8(0x66)
    let code = op.code()
    mut self.reg_reg(false, opcode: 0x0F00 | (code >> 8), len: 2, reg: u8.truncate(code), rm: hw(reg), force: false)
    mut self.put8(imm)
} Assembler.packed_shift

/// `vpbroadcastb`, `vpbroadcastw`, `vpbroadcastd` or `vpbroadcastq` of a size.
fn Assembler.broadcast(mut self, size: Size, dst: machinst::Reg, src: machinst::Reg) {
    let opcode: u32 = match size {
        Size.Byte => 0x78
        Size.Word => 0x79
        Size.Dword => 0x58
        Size.Qword => 0x59
    }
    mut self.vex(0x660200 | opcode, w: false, reg: hw(dst), operand: 0, rm: hw(src))
} Assembler.broadcast
