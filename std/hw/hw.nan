pub closed enum Order derives Copy, Eq {
    Relaxed
    Acquire
    Release
    AcqRel
    SeqCst
} Order

pub fn Ptr.atomic_load(self, order: Order) -> T
    requires self.is_aligned()
    requires order != Order.Release and order != Order.AcqRel
    example trusted "no other task reaches the value" { Ptr.of(5u32).atomic_load(Order.Acquire) } == 5

pub fn Ptr.atomic_store(self, value: T, order: Order)
    requires self.is_aligned()
    requires order != Order.Acquire and order != Order.AcqRel

pub fn Ptr.atomic_swap(self, value: T, order: Order) -> T
    requires self.is_aligned()

pub fn Ptr.atomic_compare_swap(self, expected: T, replacement: T, order: Order) -> Result[T, T]
    requires self.is_aligned()

pub fn Ptr.atomic_wrapping_add(self, amount: T, order: Order) -> T
    requires self.is_aligned()

pub fn fence(order: Order)

test atomic_store_replaces_the_value for Ptr.atomic_store {
    var flag: u32 = 0
    let pointer = Ptr.of_mut(mut flag)
    trusted "pointer addresses flag, which only this task reaches" {
        pointer.atomic_store(1, order: Order.Release)
    }
    expect flag == 1
} atomic_store_replaces_the_value

test atomic_swap_returns_the_previous_value for Ptr.atomic_swap {
    var flag: u32 = 3
    let pointer = Ptr.of_mut(mut flag)
    let previous = trusted "pointer addresses flag, which only this task reaches" { pointer.atomic_swap(7, order: Order.AcqRel) }
    expect previous == 3
    expect flag == 7
} atomic_swap_returns_the_previous_value

test atomic_compare_swap_writes_only_on_a_match for Ptr.atomic_compare_swap {
    var slot: u64 = 5
    let pointer = Ptr.of_mut(mut slot)
    let missed = trusted "pointer addresses slot, which only this task reaches" { pointer.atomic_compare_swap(4, replacement: 9, order: Order.SeqCst) }
    expect missed == Err(5)
    expect slot == 5
    let matched = trusted "pointer addresses slot, which only this task reaches" { pointer.atomic_compare_swap(5, replacement: 9, order: Order.SeqCst) }
    expect matched == Ok(5)
    expect slot == 9
} atomic_compare_swap_writes_only_on_a_match

test atomic_wrapping_add_wraps for Ptr.atomic_wrapping_add {
    var count: u8 = 255
    let pointer = Ptr.of_mut(mut count)
    let previous = trusted "pointer addresses count, which only this task reaches" { pointer.atomic_wrapping_add(2, order: Order.Relaxed) }
    expect previous == 255
    expect count == 1
} atomic_wrapping_add_wraps

test fence_keeps_earlier_stores for fence {
    var flag: u32 = 0
    let pointer = Ptr.of_mut(mut flag)
    trusted "pointer addresses flag, which only this task reaches" {
        pointer.atomic_store(1, order: Order.Relaxed)
        fence(Order.SeqCst)
    }
    expect flag == 1
} fence_keeps_earlier_stores

