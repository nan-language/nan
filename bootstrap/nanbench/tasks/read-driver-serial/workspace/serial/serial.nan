//! The line control register and the framing it sets.

/// The parity bit a frame carries.
pub layout Parity: u8 tags {
    Off = 0
    Odd = 1
    Even = 3
} Parity

pub layout LineControl: u16 le {
    parity: Parity at 0
    data_bits: bit 8..=11
    two_stop_bits: bit 12
    reserved: rest
} LineControl

pub layout LineStatus: u8 {
    data_ready: bit 0
    framing_error: bit 3
    reserved: rest
} LineStatus

pub registers UartRegs {
    line_control: u16 at 0x2 read write
    line_status: LineStatus at 0x4 read
} UartRegs

/// The framing of `data_bits` data bits, with two stop bits beyond 8 data bits.
pub fn LineControl.framing(data_bits: u8, parity: Parity) -> LineControl {
    return LineControl(parity: parity, data_bits: data_bits, two_stop_bits: data_bits > 8, reserved: 0)
} LineControl.framing

/// Sets the line's framing and tells whether the line saw a framing error before.
pub fn configure(mut regs: hw::Mmio[UartRegs], data_bits: u8, parity: Parity) -> bool {
    let status = mut regs.read(UartRegs.line_status)
    mut regs.write(UartRegs.line_control, value: LineControl.framing(data_bits, parity).to_bits())
    return status.framing_error
} configure
