//! The tests of the canonical format of source files.

/// The canonical format of `source`.
fn formatted_text(source: Str, grammar: syntax::Grammar, alloc: mem::Alloc) -> text::String {
    let file = syntax::parse(text::String.of(source, alloc).into_bytes(), grammar, alloc)
    let written = source_file(file, only: None, alloc)
    let Ok(output) = attempt text::String.try_from_utf8(written.view(), alloc) else {
        expect false
        return text::String.empty(alloc)
    }
    return output
} formatted_text

/// Formats `source`, checks the result against `expected` and that formatting it changes nothing.
fn expect_format(source: Str, expected: Str, grammar: syntax::Grammar, alloc: mem::Alloc) {
    let once = formatted_text(source, grammar, alloc)
    expect once.as_str() == expected
    let twice = formatted_text(once.as_str(), grammar, alloc)
    expect twice.as_str() == once.as_str()
} expect_format

test tokens_are_spaced_and_numbers_grouped for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//!Sums.\npub const MASK:u64=0xfeb00000\nconst BIG:u32=1000000\nconst SMALL:u32=1_0_0\nconst HALF:f64=1234.5678\nfn f(x:u32)->u32=-x+ ~x*foo(x)[0].y - ~ - -x\n", expected: "//! Sums.\n\npub const MASK: u64 = 0xFEB0_0000\n\nconst BIG: u32 = 1_000_000\n\nconst SMALL: u32 = 100\n\nconst HALF: f64 = 1_234.5678\n\nfn f(x: u32) -> u32 = -x + ~x * foo(x)[0].y - ~- -x\n", grammar, alloc)
    expect_format("//! T.\n\npackage app {\n    language 1\n    targets x86_64 - host\n} app\n", expected: "//! T.\n\npackage app {\n    language 1\n    targets x86_64-host\n} app\n", grammar, alloc)
} tokens_are_spaced_and_numbers_grouped

test lines_take_the_depth_of_their_delimiters_and_units for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! D.\n\nfn f(x: u32) -> u32 {\n        if x > 1 {\n    return x +\n    1\n        }\n    return match x {\n    0 => 1\n        else => 2\n    }\n} f\n", expected: "//! D.\n\nfn f(x: u32) -> u32 {\n    if x > 1 {\n        return x +\n            1\n    }\n    return match x {\n        0 => 1\n        else => 2\n    }\n} f\n", grammar, alloc)
} lines_take_the_depth_of_their_delimiters_and_units

test blank_lines_separate_items_once for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("\n//! B.\n\n\n// About X.\nconst X: u32 = 1\n// About Y.\n\n\n\nconst Y: u32 = 2\nfn f() {\n\n    return\n\n} f\n\n\n", expected: "//! B.\n\n// About X.\nconst X: u32 = 1\n\n// About Y.\n\nconst Y: u32 = 2\n\nfn f() {\n    return\n} f\n", grammar, alloc)
} blank_lines_separate_items_once

test breakable_lists_are_flat_or_broken for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! L.\n\nfn f(a: u32, b: u32, c: u32, d: u32, e: u32) {\n} f\n\nfn g(\n    a: u32,\n    ) {\n    h(a,\n        b)\n    h(a, b,)\n} g\n", expected: "//! L.\n\nfn f(\n    a: u32,\n    b: u32,\n    c: u32,\n    d: u32,\n    e: u32,\n    ) {\n} f\n\nfn g(a: u32) {\n    h(\n        a,\n        b,\n    )\n    h(a, b)\n} g\n", grammar, alloc)
    expect_format("//! L.\n\nfn f( // the only one\n    a: u32) {\n} f\n", expected: "//! L.\n\nfn f( // the only one\n    a: u32,\n    ) {\n} f\n", grammar, alloc)
} breakable_lists_are_flat_or_broken

test other_lists_lie_on_one_line for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! O.\n\npub closed struct P[T: Copy,\n    U] derives Eq,\n    Copy {\n    pub x: T\n} P\n", expected: "//! O.\n\npub closed struct P[T: Copy, U] derives Copy, Eq {\n    pub x: T\n} P\n", grammar, alloc)
} other_lists_lie_on_one_line

test braces_end_and_start_lines_except_in_trusted_code for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! T.\n\nfn f(x: u32) -> u32 {\n    if x > 0 { return 1\n    }\n    let y = trusted \"premise\" { g(x) }\n    match x {\n        0 => {}\n        else => return y\n    }\n    return y\n} f\n", expected: "//! T.\n\nfn f(x: u32) -> u32 {\n    if x > 0 {\n        return 1\n    }\n    let y = trusted \"premise\" { g(x) }\n    match x {\n        0 => {\n        }\n        else => return y\n    }\n    return y\n} f\n", grammar, alloc)
} braces_end_and_start_lines_except_in_trusted_code

test canonical_order_sorts_modifiers_clauses_directives_limits_and_derives for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! C.\n\npub view linear open struct S derives Render, Hash, Copy, Custom {\n    x: u32\n} S\n\nfn f(x: u32) -> u32 limits stack 64, notrap, pure\n    waive length \"why\"\n    todo \"check\" example f(1) == 1\n    ensures result > 0\n    requires x > 0\n{\n    return x\n} f\n", expected: "//! C.\n\npub open linear view struct S derives Copy, Hash, Render, Custom {\n    x: u32\n} S\n\nfn f(x: u32) -> u32 limits pure, notrap, stack 64\n    requires x > 0\n    ensures result > 0\n    todo \"check\" example f(1) == 1\n    waive length \"why\"\n{\n    return x\n} f\n", grammar, alloc)
    expect_format("//! P.\n\npackage app {\n    deny b -> a\n    allow trusted in zeta, alpha\n    dep units \"../units\"\n    entry main\n    deny a -> c\n    targets x86_64-host, x86_64-bare\n    dep clock \"../clock\"\n    allow device in app\n    language 1\n} app\n", expected: "//! P.\n\npackage app {\n    language 1\n    targets x86_64-bare, x86_64-host\n    entry main\n    dep clock \"../clock\"\n    dep units \"../units\"\n    allow device in app\n    allow trusted in alpha, zeta\n    deny a -> c\n    deny b -> a\n} app\n", grammar, alloc)
} canonical_order_sorts_modifiers_clauses_directives_limits_and_derives

test labels_naming_a_binding_in_scope_are_punned_in_calls for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! P.\n\nfn f(count: u32, items: Slice[u32]) -> u32 {\n    let total = g(count: count, items: items, total: total)\n    let pair = Pair(left: count, count: count)\n    var limit = 1\n    return h(count, limit: mut limit, LIMIT: LIMIT, other: count)\n} f\n", expected: "//! P.\n\nfn f(count: u32, items: Slice[u32]) -> u32 {\n    let total = g(count: count, items, total: total)\n    let pair = Pair(left: count, count: count)\n    var limit = 1\n    return h(count, mut limit, LIMIT: LIMIT, other: count)\n} f\n", grammar, alloc)
    expect_format("//! P.\n\nfn f(items: Slice[u32], x: u32) -> u32 {\n    for item in items {\n        g(x, item: item)\n    }\n    g(x, item: item)\n    if x > 0 {\n        let y = 1\n        g(x, y: y)\n    }\n    g(x, y: y)\n    return match x {\n        Some(inner) => g(x, inner: inner)\n        else => g(x, inner: inner)\n    }\n} f\n", expected: "//! P.\n\nfn f(items: Slice[u32], x: u32) -> u32 {\n    for item in items {\n        g(x, item)\n    }\n    g(x, item: item)\n    if x > 0 {\n        let y = 1\n        g(x, y)\n    }\n    g(x, y: y)\n    return match x {\n        Some(inner) => g(x, inner)\n        else => g(x, inner: inner)\n    }\n} f\n", grammar, alloc)
} labels_naming_a_binding_in_scope_are_punned_in_calls

test clause_lines_of_a_body_less_std_function_take_the_depth_of_its_clauses for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    let file = syntax::parse_std(text::String.of("//! S.\n\npub fn u32.f(self) -> u32 limits pure\n    example (~0u32).f() == 1\n    example(1u32).f() == 1\n", alloc).into_bytes(), grammar, alloc)
    let written = source_file(file, only: None, alloc)
    expect written.view() == b"//! S.\n\npub fn u32.f(self) -> u32 limits pure\n    example (~0u32).f() == 1\n    example (1u32).f() == 1\n"
} clause_lines_of_a_body_less_std_function_take_the_depth_of_its_clauses

test comments_take_the_depth_of_the_line_they_precede for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! C.\n\nfn f(x: u32) -> u32\n    requires x > 0\n// before the body\n{\n    for y in x {\n        g(y)\n            //last\n    }\n    return x   //   done\n} f\n", expected: "//! C.\n\nfn f(x: u32) -> u32\n    requires x > 0\n    // before the body\n{\n    for y in x {\n        g(y)\n        // last\n    }\n    return x //   done\n} f\n", grammar, alloc)
} comments_take_the_depth_of_the_line_they_precede

test text_runs_keep_the_depth_of_their_first_line for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! R.\n\nconst USAGE: Str =\n        \\\\usage: nan\n    \\\\    check\n", expected: "//! R.\n\nconst USAGE: Str =\n    \\\\usage: nan\n    \\\\    check\n", grammar, alloc)
} text_runs_keep_the_depth_of_their_first_line

test damaged_lines_and_items_are_kept_as_written for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    expect_format("//! K.\n\nfn f( {\n  x\n} f\nconst   Y: u32 = 2\n", expected: "//! K.\n\nfn f( {\n  x\n} f\nconst Y: u32 = 2\n", grammar, alloc)
    expect_format("//! K.\nconst  X: u32 = 1 \n", expected: "//! K.\n\nconst  X: u32 = 1 \n", grammar, alloc)
    var invalid = mem::Bytes.empty(alloc)
    mut invalid.append(b"//! K.\nconst  X: Str = \"\xFF\"\n")
    let file = syntax::parse(take invalid, grammar, alloc)
    let written = source_file(file, only: None, alloc)
    expect written.view() == b"//! K.\nconst  X: Str = \"\xFF\"\n"
} damaged_lines_and_items_are_kept_as_written

test an_item_scope_formats_that_item_alone for source_file {
    let alloc = testing::world().alloc
    let grammar = syntax::Grammar.load(alloc)
    let file = syntax::parse(text::String.of("//! S.\nconst  X: u32 = 1\nconst  Y: u32 = 2\n", alloc).into_bytes(), grammar, alloc)
    let written = source_file(file, only: Some(3..=3), alloc)
    expect written.view() == b"//! S.\nconst  X: u32 = 1\nconst Y: u32 = 2\n"
} an_item_scope_formats_that_item_alone
