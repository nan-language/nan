//! The sections of an ELF64 or PE32+ file, and the artefacts an image's `.nan` section holds.

/// The artefacts the one section named `.nan` of an ELF64 or PE32+ file holds; none when the file
/// is neither or holds no such section, or several.
pkg fn image_section(image: Slice[u8], alloc: mem::Alloc) -> Option[mem::List[mem::Bytes]] {
    let Ok(located) = attempt named_section(read: fn(at: usize, length: usize) -> mem::Bytes {
        return held_bytes(image, at, length, alloc)
    }, name: b".nan") else {
        return None
    }
    let Some(found) = located else {
        return None
    }
    let Some(end) = found.start.checked_add(found.length) else {
        return None
    }
    let Some(upto) = image.prefix(end) else {
        return None
    }
    let Some(parts) = upto.split_at(found.start) else {
        return None
    }
    return section_artefacts(parts.tail, alloc)
} image_section

/// The bytes of a file at an offset, fewer when the file ends before them.
fn held_bytes(image: Slice[u8], at: usize, length: usize, alloc: mem::Alloc) -> mem::Bytes {
    var out = mem::Bytes.empty(alloc)
    let Some(parts) = image.split_at(at) else {
        return out
    }
    match parts.tail.prefix(length) {
        Some(held) => mut out.append(held)
        None => mut out.append(parts.tail)
    }
    return out
} held_bytes

/// The contents of the one section named `name` of the ELF64 or PE32+ file whose bytes at an
/// offset `read` gives, fewer when the file ends before them; none when the file is neither or
/// holds no such section, or several.
pkg fn section_contents(read: fn(at: usize, length: usize) -> mem::Bytes fails platform::IoError, name: Slice[u8]) -> Option[mem::Bytes] fails platform::IoError {
    let Some(found) = try named_section(read, name) else {
        return None
    }
    let held = try read(found.start, length: found.length)
    if held.len() != found.length {
        return None
    }
    return Some(take held)
} section_contents

/// Where the one section named `name` of the ELF64 or PE32+ file `read` reads lies, a PE32+
/// file naming it without the dots after its first byte.
fn named_section(read: fn(at: usize, length: usize) -> mem::Bytes fails platform::IoError, name: Slice[u8]) -> Option[Span] fails platform::IoError {
    let head = try read(0, length: ELF_HEADER)
    if head.view().prefix(2) == Some(b"MZ") {
        return try pe_section(read, head: head.view(), name)
    }
    let Some(leading) = head.view().prefix(6) else {
        return None
    }
    if leading != b"\x7FELF\x02\x01" {
        return None
    }
    let Some(headers) = number_at(head.view(), at: 0x28, width: 8) else {
        return None
    }
    let Some(size) = number_at(head.view(), at: 0x3A, width: 2) else {
        return None
    }
    let Some(count) = number_at(head.view(), at: 0x3C, width: 2) else {
        return None
    }
    let Some(names) = number_at(head.view(), at: 0x3E, width: 2) else {
        return None
    }
    let Some(extent) = count.checked_mul(size) else {
        return None
    }
    let table = try read(headers, length: extent)
    let table_at = ElfHeaders(start: 0, size: size)
    let Some(names_at) = section_span(table.view(), headers: table_at, index: names) else {
        return None
    }
    let name_table = try read(names_at.start, length: names_at.length)
    if name_table.len() != names_at.length {
        return None
    }
    var found: Option[Span] = None
    for index in 0..<count {
        let Some(at) = table_at.header(index) else {
            return None
        }
        let Some(offset) = number_at(table.view(), at, width: 4) else {
            return None
        }
        let Some(named) = name_matches(name_table.view(), offset, name) else {
            return None
        }
        if named {
            if found.is_some() {
                return None
            }
            found = section_span(table.view(), headers: table_at, index)
            if found.is_none() {
                return None
            }
        }
    }
    return found
} named_section

/// The bytes of an ELF64 file header, which hold a PE32+ file's offset of its PE signature.
const ELF_HEADER: usize = 0x40

/// The bytes of a PE32+ file's signature and file header, and of each of its section headers.
const PE_HEADER: usize = 24

const PE_SECTION_HEADER: usize = 40

/// Where the one section named `name` without the dots after its first byte lies in the PE32+
/// file `read` reads, whose first bytes are `head`.
fn pe_section(read: fn(at: usize, length: usize) -> mem::Bytes fails platform::IoError, head: Slice[u8], name: Slice[u8]) -> Option[Span] fails platform::IoError {
    let Some(spelt) = pe_name(name) else {
        return None
    }
    let Some(signature_at) = number_at(head, at: 0x3C, width: 4) else {
        return None
    }
    let file_header = try read(signature_at, length: PE_HEADER)
    if file_header.view().prefix(4) != Some(b"PE\x00\x00") {
        return None
    }
    let Some(count) = number_at(file_header.view(), at: 6, width: 2) else {
        return None
    }
    let Some(optional) = number_at(file_header.view(), at: 20, width: 2) else {
        return None
    }
    let Some(table_at) = signature_at.checked_add(PE_HEADER) else {
        return None
    }
    let Some(first_at) = table_at.checked_add(optional) else {
        return None
    }
    let Some(extent) = count.checked_mul(PE_SECTION_HEADER) else {
        return None
    }
    let table = try read(first_at, length: extent)
    var found: Option[Span] = None
    var at: usize = 0
    while at < table.len() {
        let Some(parts) = table.view().split_at(at) else {
            return None
        }
        let Some(field) = parts.tail.prefix(8) else {
            return None
        }
        let Some(size) = number_at(parts.tail, at: 8, width: 4) else {
            return None
        }
        let Some(offset) = number_at(parts.tail, at: 20, width: 4) else {
            return None
        }
        if field == spelt.view() {
            if found.is_some() {
                return None
            }
            found = Some(Span(start: offset, length: size))
        }
        let Some(next) = at.checked_add(PE_SECTION_HEADER) else {
            return None
        }
        at = next
    }
    return found
} pe_section

/// The name field of a PE32+ section header naming a section `name` without the dots after its
/// first byte; none when that holds more than 8 bytes.
fn pe_name(name: Slice[u8]) -> Option[Array[u8, 8]] {
    var field = Array[u8, 8].filled(0)
    var length: usize = 0
    for at in 0..<name.len() {
        if at > 0 and name[at] == b'.' {
            continue
        }
        if length >= 8 {
            return None
        }
        field[length] = name[at]
        length += 1
    }
    return Some(field)
} pe_name

/// Where the section headers of an ELF64 file lie: their offset and the size of each.
struct ElfHeaders derives Copy {
    start: usize
    size: usize
} ElfHeaders

/// The offset of the header of the section at an index.
fn ElfHeaders.header(self, index: usize) -> Option[usize] {
    let Some(skipped) = index.checked_mul(self.size) else {
        return None
    }
    return self.start.checked_add(skipped)
} ElfHeaders.header

/// Where bytes lie in a file: their offset and their length.
struct Span derives Copy {
    start: usize
    length: usize
} Span

/// The little-endian unsigned number of `width` bytes at an offset of bytes.
fn number_at(image: Slice[u8], at: usize, width: usize) -> Option[usize] {
    let Some(end) = at.checked_add(width) else {
        return None
    }
    let Some(upto) = image.prefix(end) else {
        return None
    }
    let Some(parts) = upto.split_at(at) else {
        return None
    }
    var value: u64 = 0
    var shift: u32 = 0
    for byte in parts.tail {
        value = value | (u64.widen(byte) << shift)
        shift += 8
    }
    return Some(usize.widen(value))
} number_at

/// Where the contents of the section at an index of a section header table lie.
fn section_span(table: Slice[u8], headers: ElfHeaders, index: usize) -> Option[Span] {
    let Some(at) = headers.header(index) else {
        return None
    }
    let Some(offset_at) = at.checked_add(24) else {
        return None
    }
    let Some(size_at) = at.checked_add(32) else {
        return None
    }
    let Some(offset) = number_at(table, at: offset_at, width: 8) else {
        return None
    }
    let Some(size) = number_at(table, at: size_at, width: 8) else {
        return None
    }
    if offset.checked_add(size).is_none() {
        return None
    }
    return Some(Span(start: offset, length: size))
} section_span

/// Whether the name at an offset of a section name table, up to its NUL or the table's end, is
/// `name`; none when the offset lies past the table.
fn name_matches(table: Slice[u8], offset: usize, name: Slice[u8]) -> Option[bool] {
    let Some(parts) = table.split_at(offset) else {
        return None
    }
    var end: usize = 0
    while end < parts.tail.len() and parts.tail[end] != 0 {
        end += 1
    }
    return Some(parts.tail.prefix(end) == Some(name))
} name_matches

/// The artefacts a `.nan` section holds: a uvar count, then each artefact's bytes; none when the
/// content holds anything else.
fn section_artefacts(content: Slice[u8], alloc: mem::Alloc) -> Option[mem::List[mem::Bytes]] {
    let Some(count) = read_uvar(content, at: 0) else {
        return None
    }
    let Some(total) = count.value.to_u64() else {
        return None
    }
    var artefacts = mem::List[mem::Bytes].empty(alloc)
    var at = count.next
    var index: u64 = 0
    while index < total {
        let Some(held) = read_bytes(content, at) else {
            return None
        }
        mut artefacts.push(held.copy(content, alloc))
        at = held.next
        index += 1
    }
    if at != content.len() {
        return None
    }
    return Some(take artefacts)
} section_artefacts
