//! Schema trees: the description of a type's encoded structure as a `mem::wire::Schema`, and the schema hash, the hash of a tree's `mem::wire` encoding.

/// The `mem::wire` encoding of a schema tree.
pkg fn schema_wire(tree: mem::wire::Schema, alloc: mem::Alloc) -> mem::Bytes {
    var out = mem::Bytes.empty(alloc)
    mem::wire::Codec[mem::wire::Schema].encode(tree, out: mut out)
    return out
} schema_wire

pkg fn schema_hash(tree: mem::wire::Schema, alloc: mem::Alloc) -> hashing::HashValue {
    return hashing::HashValue.of(schema_wire(tree, alloc).view())
} schema_hash

/// An instantiation a schema is made inside, with the number of `Record` and `Variant` nodes
/// made since it.
struct SchemaEnclosing derives Copy {
    ty: ty::Ty
    made: u64
} SchemaEnclosing

/// A walk making a schema tree: the struct and enum instantiations enclosing the node being
/// made, and the instantiations found of packages other than `outside`, while outside every
/// other found one.
struct SchemaWalk {
    enclosing: mem::List[SchemaEnclosing]
    outside: Option[ty::PackageId]
    found: mem::List[ty::Ty]
} SchemaWalk

/// The schema tree of a type implementing `Encode`.
pkg fn Checker.schema(self, ty: ty::Ty) -> mem::wire::Schema {
    let alloc = self.alloc()
    var walk = SchemaWalk(enclosing: mem::List[SchemaEnclosing].empty(alloc), outside: None, found: mem::List[ty::Ty].empty(alloc))
    return self.schema_within(ty, walk: mut walk)
} Checker.schema

/// The struct and enum instantiations of packages other than `package_id` that the schema tree
/// of a type makes nodes for, each outside every other.
pkg fn Checker.foreign_schemas(self, ty: ty::Ty, package_id: ty::PackageId) -> mem::List[ty::Ty] {
    let alloc = self.alloc()
    var walk = SchemaWalk(enclosing: mem::List[SchemaEnclosing].empty(alloc), outside: Some(package_id), found: mem::List[ty::Ty].empty(alloc))
    discard self.schema_within(ty, walk: mut walk)
    return walk.found
} Checker.foreign_schemas

/// Each non-generic `pub` struct or enum of a package implementing `Encode`, by canonical path.
pkg fn Checker.exported_encoded(self, package_id: ty::PackageId) -> mem::Map[text::String, ty::Ty] {
    let alloc = self.alloc()
    var found = mem::Map[text::String, ty::Ty].empty(alloc)
    let db = self.db()
    let Some(encode) = db.core_item("Encode") else {
        return found
    }
    for module in db.package_data(package_id).modules {
        for item in db.module(module).items {
            let declared = db.ast(item)
            let typed = match declared.kind {
                ast::ItemKind.Struct(_) or ast::ItemKind.Enum(_) => true
                else => false
            }
            if not typed or declared.visibility != ast::Visibility.Pub or self.sig(item).contents().generics.len() > 0 {
                continue
            }
            let ty = self.types().item(item, args: mem::List[ty::Arg].empty(alloc))
            if not self.implements(ty, interface_item: encode) {
                continue
            }
            let Some(path) = self.canonical_path(item) else {
                continue
            }
            discard mut found.insert(take path, value: ty)
        }
    }
    return found
} Checker.exported_encoded

/// The types whose schema trees a package's code root records, by canonical path: its exported
/// types implementing `Encode` and each component state it declares, the target of an impl line
/// naming `sys::Component`.
pkg fn Checker.recorded_schemas(self, package_id: ty::PackageId) -> mem::Map[text::String, ty::Ty] {
    let alloc = self.alloc()
    let db = self.db()
    var found = self.exported_encoded(package_id)
    for module in db.package_data(package_id).modules {
        for item in db.module(module).items {
            let sig = self.sig(item)
            let SigKind.Impl(target: Some(TypeKey.Item(target)), target_ty: _, bound: Some(bound)) = sig.contents().kind else {
                continue
            }
            if db.canonical_text(bound.item) == "sys::Component" {
                discard mut found.insert(db.canonical(target), value: self.types().item(target, args: mem::List[ty::Arg].empty(alloc)))
            }
        }
    }
    return found
} Checker.recorded_schemas

/// The schema of a type within a walk.
fn Checker.schema_within(self, ty: ty::Ty, mut walk: SchemaWalk) -> mem::wire::Schema {
    let alloc = self.alloc()
    let types = self.types()
    match types.kind(ty) {
        ty::TyKind.Scalar(scalar) => return schema_leaf(schema_scalar_node(scalar), alloc)
        ty::TyKind.Unit => return schema_record(open: false, members: mem::List[SchemaMember].empty(alloc), alloc)
        else => {}
    }
    let ty::TyKind.Item(item: item, args: args) = types.kind(ty) else {
        return schema_record(open: false, members: mem::List[SchemaMember].empty(alloc), alloc)
    }
    let held_args = types.arg_list(args)
    let path = self.db().canonical(item)
    match path.as_str() {
        "text::String" => return schema_leaf(mem::wire::SchemaNode.Text, alloc)
        "mem::Bytes" => return schema_leaf(mem::wire::SchemaNode.Bytes, alloc)
        "text::Fixed" => return schema_leaf(mem::wire::SchemaNode.BoundedText(capacity: schema_arg_count(held_args, index: 0).value_or(0)), alloc)
        "mem::Box" or "mem::Shared" or "core::Untrusted" => return self.schema_within(schema_arg_ty(held_args, index: 0), walk: mut walk)
        "mem::Id" => return schema_leaf(mem::wire::SchemaNode.Unsigned(width: 32), alloc)
        "core::Array" or "mem::Bounded" or "mem::Set" or "mem::List" => {
            let element = self.schema_within(schema_arg_ty(held_args, index: 0), walk: mut walk)
            var length: Option[u64] = None
            if path.as_str() == "core::Array" {
                length = schema_arg_count(held_args, index: 1)
            }
            var capacity: Option[u64] = None
            if path.as_str() == "mem::Bounded" {
                capacity = schema_arg_count(held_args, index: 1)
            }
            return schema_sequence(take element, length, capacity, unique: path.as_str() == "mem::Set", alloc)
        }
        "mem::Map" => {
            let key = self.schema_within(schema_arg_ty(held_args, index: 0), walk: mut walk)
            let value = self.schema_within(schema_arg_ty(held_args, index: 1), walk: mut walk)
            return schema_map(take key, take value, alloc)
        }
        else => {}
    }
    match walk.enclosing.position(fn(known: SchemaEnclosing) => known.ty == ty) {
        Some(at) => {
            var depth: u64 = 0
            for index in at..<walk.enclosing.len() {
                let made = walk.enclosing[index].made
                expect depth <= ~0u64 - made
                depth += made
            }
            return schema_leaf(mem::wire::SchemaNode.Back(depth: depth), alloc)
        }
        None => {}
    }
    let outside = walk.outside
    match outside {
        Some(package_id) => {
            if self.db().package_of(item) != package_id {
                if walk.found.position(fn(known: ty::Ty) => known == ty).is_none() {
                    mut walk.found.push(ty)
                }
                walk.outside = None
            }
        }
        None => {}
    }
    let sig = self.sig(item)
    var params = mem::List[ty::Param].empty(alloc)
    for def in sig.contents().generics {
        mut params.push(def.param)
    }
    let subst = ty::Subst.of(params.view(), args: held_args, alloc)
    let open = self.db().ast(item).is_open()
    mut walk.enclosing.push(SchemaEnclosing(ty: ty, made: 1))
    let node = match sig.contents().kind {
        SigKind.Struct(fields: fields) => schema_record(open, members: self.field_nodes(item, fields: fields.view(), subst, open, walk: mut walk), alloc)
        SigKind.Enum(variants: variants) => schema_variant(open, alternatives: self.variant_nodes(item, variants: variants.view(), subst, walk: mut walk), alloc)
        else => schema_record(open, members: mem::List[SchemaMember].empty(alloc), alloc)
    }
    discard mut walk.enclosing.pop()
    walk.outside = outside
    return node
} Checker.schema_within

/// The node of a scalar type.
fn schema_scalar_node(scalar: ty::Scalar) -> mem::wire::SchemaNode {
    let width = u8.truncate(scalar.bits())
    if scalar == ty::Scalar.Bool {
        return mem::wire::SchemaNode.Bool
    }
    if scalar == ty::Scalar.Char {
        return mem::wire::SchemaNode.Char
    }
    if scalar.is_float() {
        return mem::wire::SchemaNode.Float(width: width)
    }
    if scalar.is_signed() {
        return mem::wire::SchemaNode.Signed(width: width)
    }
    return mem::wire::SchemaNode.Unsigned(width: width)
} schema_scalar_node

/// A field of a record node with the tree of its value, which its position does not name yet.
struct SchemaMember {
    field: mem::wire::SchemaField
    tree: mem::wire::Schema
} SchemaMember

/// A variant of a variant node with the tree of its payload, which its position does not name
/// yet.
struct SchemaAlternative {
    variant: mem::wire::SchemaVariant
    tree: Option[mem::wire::Schema]
} SchemaAlternative

/// A tree of one node.
fn schema_leaf(take node: mem::wire::SchemaNode, alloc: mem::Alloc) -> mem::wire::Schema {
    var nodes = mem::List[mem::wire::SchemaNode].empty(alloc)
    mut nodes.push(take node)
    return mem::wire::Schema(nodes: take nodes)
} schema_leaf

/// The nodes of a tree holding a placeholder for its root, which its children's trees follow
/// once grafted.
fn schema_root(alloc: mem::Alloc) -> mem::List[mem::wire::SchemaNode] {
    var nodes = mem::List[mem::wire::SchemaNode].empty(alloc)
    mut nodes.push(mem::wire::SchemaNode.Bool)
    return nodes
} schema_root

/// A sequence node with its element's tree grafted after it.
fn schema_sequence(take element: mem::wire::Schema, length: Option[u64], capacity: Option[u64], unique: bool, alloc: mem::Alloc) -> mem::wire::Schema {
    var nodes = schema_root(alloc)
    let at = schema_graft(mut nodes, tree: take element)
    nodes[0] = mem::wire::SchemaNode.Sequence(element: at, length: length, capacity: capacity, unique: unique)
    return mem::wire::Schema(nodes: take nodes)
} schema_sequence

/// A map node with its key's and its value's trees grafted after it.
fn schema_map(take key: mem::wire::Schema, take value: mem::wire::Schema, alloc: mem::Alloc) -> mem::wire::Schema {
    var nodes = schema_root(alloc)
    let key_at = schema_graft(mut nodes, tree: take key)
    let value_at = schema_graft(mut nodes, tree: take value)
    nodes[0] = mem::wire::SchemaNode.Map(key: key_at, value: value_at)
    return mem::wire::Schema(nodes: take nodes)
} schema_map

/// A record node with its fields' trees grafted after it in order.
fn schema_record(open: bool, take members: mem::List[SchemaMember], alloc: mem::Alloc) -> mem::wire::Schema {
    var nodes = schema_root(alloc)
    var fields = mem::List[mem::wire::SchemaField].empty(alloc)
    var members_left = take members.into_cursor()
    loop {
        let Some(member) = mut members_left.next() else {
            break
        }
        let SchemaMember(field: field, tree: tree) = member
        var placed = field
        placed.value = schema_graft(mut nodes, tree: take tree)
        mut fields.push(take placed)
    }
    nodes[0] = mem::wire::SchemaNode.Record(open: open, fields: take fields)
    return mem::wire::Schema(nodes: take nodes)
} schema_record

/// A variant node with its payloads' trees grafted after it in order.
fn schema_variant(open: bool, take alternatives: mem::List[SchemaAlternative], alloc: mem::Alloc) -> mem::wire::Schema {
    var nodes = schema_root(alloc)
    var variants = mem::List[mem::wire::SchemaVariant].empty(alloc)
    var alternatives_left = take alternatives.into_cursor()
    loop {
        let Some(alternative) = mut alternatives_left.next() else {
            break
        }
        let SchemaAlternative(variant: variant, tree: tree) = alternative
        var placed = variant
        match tree {
            Some(payload) => {
                placed.payload = Some(schema_graft(mut nodes, tree: take payload))
            }
            None => {}
        }
        mut variants.push(take placed)
    }
    nodes[0] = mem::wire::SchemaNode.Variant(open: open, variants: take variants)
    return mem::wire::Schema(nodes: take nodes)
} schema_variant

/// Appends a tree's nodes to `nodes`, each naming its children by their positions there, giving
/// the position of the tree's root.
fn schema_graft(mut nodes: mem::List[mem::wire::SchemaNode], take tree: mem::wire::Schema) -> usize {
    let base = nodes.len()
    let mem::wire::Schema(nodes: grafted) = tree
    var grafted_left = take grafted.into_cursor()
    loop {
        let Some(node) = mut grafted_left.next() else {
            return base
        }
        mut nodes.push(schema_shifted(take node, by: base))
    }
} schema_graft

/// A node naming each of its children `by` positions further.
fn schema_shifted(take node: mem::wire::SchemaNode, by: usize) -> mem::wire::SchemaNode {
    match node {
        mem::wire::SchemaNode.Sequence(element: element, length: length, capacity: capacity, unique: unique) => return mem::wire::SchemaNode.Sequence(element: element + by, length: length, capacity: capacity, unique: unique)
        mem::wire::SchemaNode.Map(key: key, value: value) => return mem::wire::SchemaNode.Map(key: key + by, value: value + by)
        mem::wire::SchemaNode.Record(open: open, fields: fields) => {
            var shifted = fields
            for field in mut shifted {
                field.value += by
            }
            return mem::wire::SchemaNode.Record(open: open, fields: take shifted)
        }
        mem::wire::SchemaNode.Variant(open: open, variants: variants) => {
            var shifted = variants
            for variant in mut shifted {
                match variant.payload {
                    Some(payload) => {
                        variant.payload = Some(payload + by)
                    }
                    None => {}
                }
            }
            return mem::wire::SchemaNode.Variant(open: open, variants: take shifted)
        }
        else => return node
    }
} schema_shifted

/// The type argument at an index, `Unit` without one.
fn schema_arg_ty(args: Slice[ty::Arg], index: usize) -> ty::Ty {
    if index >= args.len() {
        return ty::Ty.unit()
    }
    return match args[index] {
        ty::Arg.Ty(held) => held
        ty::Arg.Const(_) => ty::Ty.unit()
    }
} schema_arg_ty

/// The integer const argument at an index, its low 64 bits.
fn schema_arg_count(args: Slice[ty::Arg], index: usize) -> Option[u64] {
    if index >= args.len() {
        return None
    }
    return match args[index] {
        ty::Arg.Const(ty::Const.Int(value)) => Some(value.low_bits())
        else => None
    }
} schema_arg_count

/// The fields of a struct's record node, in byte order of keys.
fn Checker.field_nodes(self, item: ty::ItemId, fields: Slice[FieldSig], subst: ty::Subst, open: bool, mut walk: SchemaWalk) -> mem::List[SchemaMember] {
    let alloc = self.alloc()
    var nodes = mem::List[SchemaMember].empty(alloc)
    for field in fields {
        if field.is_kept() {
            continue
        }
        let value_ty = subst.ty(self.types(), ty: field.ty)
        let defaulted = open and self.implements_default(value_ty)
        let aliases = self.key_aliases_of(item, member: field.name.as_str())
        let value = self.nested(value_ty, walk: mut walk)
        mut nodes.push(SchemaMember(field: mem::wire::SchemaField(key: text::String.of(field.name.as_str(), alloc), aliases: take aliases, defaulted: defaulted, value: 0), tree: take value))
    }
    mut nodes.sort_by(fn(left: SchemaMember, right: SchemaMember) => left.field.key.as_str().cmp(right.field.key.as_str()))
    return nodes
} Checker.field_nodes

/// The variants of an enum's variant node, in byte order of keys.
fn Checker.variant_nodes(self, item: ty::ItemId, variants: Slice[VariantSig], subst: ty::Subst, mut walk: SchemaWalk) -> mem::List[SchemaAlternative] {
    let alloc = self.alloc()
    var nodes = mem::List[SchemaAlternative].empty(alloc)
    for variant in variants {
        let aliases = self.key_aliases_of(item, member: variant.name.as_str())
        var payload: Option[mem::wire::Schema] = None
        match variant.payload {
            Payload.None => {}
            Payload.Single(payload_ty) => {
                payload = Some(self.nested(subst.ty(self.types(), ty: payload_ty), walk: mut walk))
            }
            Payload.Labelled(labelled_fields) => {
                payload = Some(schema_record(open: false, members: self.labelled_nodes(labelled_fields.view(), subst, walk: mut walk), alloc))
            }
        }
        mut nodes.push(SchemaAlternative(variant: mem::wire::SchemaVariant(key: text::String.of(variant.name.as_str(), alloc), aliases: take aliases, payload: None), tree: take payload))
    }
    mut nodes.sort_by(fn(left: SchemaAlternative, right: SchemaAlternative) => left.variant.key.as_str().cmp(right.variant.key.as_str()))
    return nodes
} Checker.variant_nodes

/// The fields of a labelled payload's record node, in byte order of keys.
fn Checker.labelled_nodes(self, fields: Slice[LabelledTy], subst: ty::Subst, mut walk: SchemaWalk) -> mem::List[SchemaMember] {
    let alloc = self.alloc()
    var nodes = mem::List[SchemaMember].empty(alloc)
    for field in fields {
        let value = self.nested(subst.ty(self.types(), ty: field.ty), walk: mut walk)
        mut nodes.push(SchemaMember(field: mem::wire::SchemaField(key: text::String.of(field.name.as_str(), alloc), aliases: mem::List[text::String].empty(alloc), defaulted: false, value: 0), tree: take value))
    }
    mut nodes.sort_by(fn(left: SchemaMember, right: SchemaMember) => left.field.key.as_str().cmp(right.field.key.as_str()))
    return nodes
} Checker.labelled_nodes

/// The node of a constituent, counting the node made for each enclosing instantiation.
fn Checker.nested(self, ty: ty::Ty, mut walk: SchemaWalk) -> mem::wire::Schema {
    let node = self.schema_within(ty, walk: mut walk)
    let made = match node.nodes[0] {
        mem::wire::SchemaNode.Record(open: _, fields: _) or mem::wire::SchemaNode.Variant(open: _, variants: _) => true
        else => false
    }
    let count = walk.enclosing.len()
    if made and count > 0 {
        let instantiations = walk.enclosing[count - 1].made
        expect instantiations < ~0u64
        walk.enclosing[count - 1].made = instantiations + 1
    }
    return node
} Checker.nested

fn Checker.implements_default(self, ty: ty::Ty) -> bool {
    let Some(interface_item) = self.db().core_item("Default") else {
        return false
    }
    return self.implements(ty, interface_item)
} Checker.implements_default

/// The aliases of a field's or variant's key: the old names of the `preserves` tombstones of
/// the type's package retiring a member of the type into it.
fn Checker.key_aliases_of(self, owner: ty::ItemId, member: Str) -> mem::List[text::String] {
    let alloc = self.alloc()
    let db = self.db()
    let owner_path = db.canonical(owner)
    var target = text::String.of(owner_path.as_str(), alloc)
    mut target.push('.')
    mut target.append(member)
    var prefix = text::String.of(owner_path.as_str(), alloc)
    mut prefix.push('.')
    var aliases = mem::List[text::String].empty(alloc)
    for entry in db.tombstones.cursor() {
        let old = entry.key()
        if not old.starts_with(prefix.as_str()) {
            continue
        }
        let Some(old_member) = old.as_str().slice_bytes(prefix.byte_len(), end: old.byte_len()) else {
            continue
        }
        if self.renames_into(entry.value().view(), target: target.as_str()) {
            mut aliases.push(text::String.of(old_member, alloc))
        }
    }
    mut aliases.sort_by(fn(left: text::String, right: text::String) => left.as_str().cmp(right.as_str()))
    return aliases
} Checker.key_aliases_of

/// Whether one of tombstones is a `preserves` tombstone whose rewrite names a member by its
/// canonical path.
fn Checker.renames_into(self, tombstones: Slice[ty::ItemId], target: Str) -> bool {
    let db = self.db()
    for tombstone in tombstones {
        let ast::ItemKind.Retired(retired_item) = db.ast(tombstone).kind else {
            continue
        }
        let ast::RetiredNew.Rewrite(expr: rewrite, preserves: preserves) = retired_item.new else {
            continue
        }
        if preserves and self.rewrite_names(tombstone, rewrite, target) {
            return true
        }
    }
    return false
} Checker.renames_into

/// Whether a tombstone's rewrite names a member by its canonical path.
fn Checker.rewrite_names(self, tombstone: ty::ItemId, rewrite: ast::Expr, target: Str) -> bool {
    let alloc = self.alloc()
    let db = self.db()
    var written = text::String.empty(alloc)
    for token in rewrite.token..=rewrite.last {
        mut written.append(db.text(tombstone, token))
    }
    let bytes = written.as_bytes()
    var dot = bytes.len()
    while dot > 0 {
        invariant dot <= bytes.len()
        if bytes[dot - 1] == b'.' {
            break
        }
        dot -= 1
    }
    if dot == 0 {
        return false
    }
    let Some(owner) = written.as_str().slice_bytes(0, end: dot - 1) else {
        return false
    }
    let Some(member) = written.as_str().slice_bytes(dot, end: written.byte_len()) else {
        return false
    }
    var segments = mem::List[text::String].empty(alloc)
    var start: usize = 0
    loop {
        let Some(rest) = owner.slice_bytes(start, end: owner.byte_len()) else {
            break
        }
        let Some(at) = rest.find("::") else {
            mut segments.push(text::String.of(rest, alloc))
            break
        }
        let Some(segment) = rest.slice_bytes(0, end: at) else {
            break
        }
        mut segments.push(text::String.of(segment, alloc))
        expect at <= ~0usize - 2 and start <= ~0usize - 2 - at
        start += at + 2
    }
    let Some(path) = self.canonically(db.item(tombstone).module, segments: segments.view()) else {
        return false
    }
    var named = text::String.of(path.as_str(), alloc)
    mut named.push('.')
    mut named.append(member)
    return named.as_str() == target
} Checker.rewrite_names
