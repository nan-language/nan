item "platform::os::replace_process"
text "pub fn replace_process(program: Str, args: Slice[text::String], env: Slice[text::String], alloc: mem::Alloc) -> platform::IoError"
interface "agfxqyof3aee3if6rwr2of4hw2x32y2pnb2ucqckowo6g4xoive7gf7"
digest aarch64-linux "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest aarch64-windows "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest x86_64-linux "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
digest x86_64-windows "effects alloc sync irreversible(emit, actuate, erase, spend) | authority device priv any | may-trap yes | may-not-terminate"
doc "agfxqyof3aee3if6rwr2of4hw2x32y2pnb2ucqckowo6g4xoive7gf7" "Hands this process over to a program the system's search finds, a name holding `/` being its\npath, given its arguments after its name, with this process's environment with the variables\nthat the `NAME=VALUE` entries of `env` give set and this process's standard streams: on Linux\nthe program replaces this process, with no signal blocked and `SIGPIPE` at its default action,\nand on Windows this process runs it to its end and ends with its exit code. Returns only when\nthe system refuses to start it, with the failure."
seal "m5-review" "aeumov7ffonfokrg4lvgsfd4w7cxug4nwafhvc76b4wqtgfdk3hu6vo" "ahvik6n3wtewlnnpkfjqm7xf34434pu7bpogsafma5t2d5jdnzpq6x5"
