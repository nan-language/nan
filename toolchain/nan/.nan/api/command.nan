nan api 1
item "nan::command::last_colon"
head "fn last_colon(written: Str) -> Option[usize]"
accepted "ensures match result {         Some(at) => at < written.as_bytes().len()         None => true     }"
item "nan::command::listed_values"
head "fn listed_values(args: Slice[text::String], from: usize) -> usize"
accepted "requires from <= args.len()"
accepted "ensures result <= args.len() - from"
