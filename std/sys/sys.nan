enum Full derives Render, Encode {
    Over
} Full

protocol Meter {
    pub fn add(amount: u32) -> u64 fails Full limits pure
        requires amount > 0
    pub fn clear() limits pure
    pub fn keep(clock: Clock) -> Clock limits pure
} Meter

struct MeterEnv {
} MeterEnv

struct Gauge derives Encode {
    total: u64
} Gauge

impl Gauge: Component[MeterEnv, Meter]

fn Gauge.start(mut env: MeterEnv) -> Gauge = Gauge(total: 0)

fn Gauge.add(mut self, take amount: u32, mut env: MeterEnv, mut cx: Cx[Meter]) -> u64 fails Full {
    if amount > 100 {
        fail Full.Over
    }
    self.total = self.total.wrapping_add(u64.widen(amount))
    return self.total
} Gauge.add

fn Gauge.clear(mut self, mut env: MeterEnv, mut cx: Cx[Meter]) {
    self.total = 0
} Gauge.clear

fn Gauge.keep(mut self, take clock: Clock, mut env: MeterEnv, mut cx: Cx[Meter]) -> Clock = clock

/// The reply of the gauge behind `inbox` to the call `call`, with `handles` beside it, none when
/// its handler postponed it.
fn served(inbox: Outbox[Meter], call: Encoded, handles: Slice[Handle], alloc: mem::Alloc) -> Option[Encoded] fails CallError[Never] uses wait {
    let peers = mem::List[ProtocolSchema].empty(alloc)
    return try await Wire[Meter].serve(inbox, request: 1, hash: Wire[Meter].hash(), peers: peers.view(), raw: Untrusted.of(call.bytes.view()), handles, alloc)
} served

test hashes_differ_by_protocol for Wire.hash {
    expect Wire[Meter].hash() == Wire[Meter].hash()
    expect Wire[Meter].hash() != Wire[MeterSpare].hash()
} hashes_differ_by_protocol

protocol MeterSpare {
    pub fn clear() limits pure
} MeterSpare

enum Shortfall derives Render, Encode {
    Over
    Under
} Shortfall

protocol MeterClient {
    pub fn add(amount: u32) -> u64 fails Shortfall limits pure
} MeterClient

protocol MeterOneWay {
    pub fn add(amount: u32) limits pure
} MeterOneWay

protocol Bell {
    pub fn ring() limits irreversible(emit, actuate)
    pub fn note(entry: u64) limits recorded
} Bell

test schemas_state_the_class_of_each_operation for Wire.schema {
    let alloc = testing::world().alloc
    let bell = Wire[Bell].schema(alloc)
    let spare = Wire[MeterSpare].schema(alloc)
    expect bell.operations[0].class == Reversibility.Recorded
    expect bell.operations[1].class == Reversibility.Irreversible(emit: true, actuate: true, erase: false, spend: false)
    expect spare.operations[0].class == Reversibility.Traceless
} schemas_state_the_class_of_each_operation

test operations_serve_the_calls_they_read_and_answer_readably for ProtocolSchema.serves {
    let alloc = testing::world().alloc
    let meter = Wire[Meter].schema(alloc)
    let client = Wire[MeterClient].schema(alloc)
    let spare = Wire[MeterSpare].schema(alloc)
    let one_way = Wire[MeterOneWay].schema(alloc)
    let kept = meter.serves(meter, operation: "keep", alloc)
    let added = meter.serves(client, operation: "add", alloc)
    let cleared = meter.serves(spare, operation: "clear", alloc)
    let spare_added = meter.serves(spare, operation: "add", alloc)
    let one_way_added = meter.serves(one_way, operation: "add", alloc)
    let removed = meter.serves(meter, operation: "remove", alloc)
    let client_added = client.serves(meter, operation: "add", alloc)
    expect kept and added and cleared
    expect not spare_added and not one_way_added and not removed and not client_added
} operations_serve_the_calls_they_read_and_answer_readably

test calls_are_judged_by_the_schema_of_their_hash for ProtocolSchema.serves_call {
    let alloc = testing::world().alloc
    let meter = Wire[Meter].schema(alloc)
    var peers = mem::List[ProtocolSchema].empty(alloc)
    mut peers.push(Wire[MeterSpare].schema(alloc))
    mut peers.push(Wire[MeterClient].schema(alloc))
    let own = meter.serves_call(Wire[Meter].hash(), peers: peers.view(), operation: "keep", alloc)
    let peer = meter.serves_call(Wire[MeterClient].hash(), peers: peers.view(), operation: "add", alloc)
    let unread = meter.serves_call(Wire[MeterClient].hash(), peers: peers.view(), operation: "clear", alloc)
    let unknown = meter.serves_call(Wire[MeterOneWay].hash(), peers: peers.view(), operation: "add", alloc)
    expect own and peer
    expect not unread and not unknown
} calls_are_judged_by_the_schema_of_their_hash

test compatible_clients_are_served for Wire.serve {
    let world = testing::world()
    let alloc = world.alloc
    let last = try await host::Runner[Gauge].run(MeterEnv(), exec: world.exec, alloc, body: fn(inbox: Outbox[Meter]) fails CallError[Never] uses wait {
        var peers = mem::List[ProtocolSchema].empty(alloc)
        mut peers.push(Wire[MeterClient].schema(alloc))
        mut peers.push(Wire[MeterOneWay].schema(alloc))
        var call = Encoded.empty(alloc)
        let reply = Wire[MeterClient].add(mut call, amount: 7)
        let Ok(Some(answer)) = attempt await Wire[Meter].serve(inbox, request: 1, hash: Wire[MeterClient].hash(), peers: peers.view(), raw: Untrusted.of(call.bytes.view()), handles: call.handles.view(), alloc) else {
            expect false
            return
        }
        let Ok(total) = attempt reply.decode(Untrusted.of(answer.bytes.view()), handles: answer.handles.view(), alloc) else {
            expect false
            return
        }
        expect total == 7
        var posted = Encoded.empty(alloc)
        Wire[MeterOneWay].add(mut posted, amount: 1)
        let Err(CallError.Malformed(core::DecodeError.UnknownSchema)) = attempt await Wire[Meter].serve(inbox, request: 2, hash: Wire[MeterOneWay].hash(), peers: peers.view(), raw: Untrusted.of(posted.bytes.view()), handles: posted.handles.view(), alloc) else {
            expect false
            return
        }
        var cleared = Encoded.empty(alloc)
        Wire[MeterSpare].clear(mut cleared)
        let Err(CallError.Malformed(core::DecodeError.UnknownSchema)) = attempt await Wire[Meter].serve(inbox, request: 3, hash: Wire[MeterSpare].hash(), peers: peers.view(), raw: Untrusted.of(cleared.bytes.view()), handles: cleared.handles.view(), alloc) else {
            expect false
            return
        }
    })
    expect last.total == 7
} compatible_clients_are_served

test calls_are_served_from_their_encodings for Wire.serve {
    let world = testing::world()
    let alloc = world.alloc
    let last = try await host::Runner[Gauge].run(MeterEnv(), exec: world.exec, alloc, body: fn(inbox: Outbox[Meter]) fails CallError[Full] uses wait {
        var call = Encoded.empty(alloc)
        let reply = Wire[Meter].add(mut call, amount: 7)
        expect call.bytes.view() == b"\x03add\x01\x0A\x01\x06amount\x01\x07"
        let Ok(Some(answer)) = attempt await served(inbox, call, handles: call.handles.view(), alloc) else {
            expect false
            return
        }
        expect answer.bytes.view() == b"\x02Ok\x01\x01\x07"
        let total = try reply.decode(Untrusted.of(answer.bytes.view()), handles: answer.handles.view(), alloc)
        expect total == 7
        var zero = Encoded.empty(alloc)
        discard Wire[Meter].add(mut zero, amount: 0)
        let Err(CallError.Malformed(core::DecodeError.Invalid)) = attempt await served(inbox, call: zero, handles: zero.handles.view(), alloc) else {
            expect false
            return
        }
        var cleared = Encoded.empty(alloc)
        Wire[Meter].clear(mut cleared)
        expect cleared.bytes.view() == b"\x05clear\x00"
        let Ok(Some(none)) = attempt await served(inbox, call: cleared, handles: cleared.handles.view(), alloc) else {
            expect false
            return
        }
        expect none.bytes.len() == 0
    })
    expect last.total == 0
} calls_are_served_from_their_encodings

protocol Awaited {
    pub fn read() -> u64 limits traceless
    pub fn arrive(value: u64) limits traceless
} Awaited

/// A component postponing each read until a value arrives, which answers every read it
/// postponed, and counting the reads it answered at once.
struct Waiter derives Encode {
    reads: mem::List[u64]
    prompt: u64
} Waiter

impl Waiter: Component[RelayEnv, Awaited]

fn Waiter.start(mut env: RelayEnv) -> Waiter = Waiter(reads: mem::List.empty(env.alloc), prompt: 0)

fn Waiter.read(mut self, mut env: RelayEnv, mut cx: Cx[Awaited]) -> u64 {
    let Some(request) = mut cx.postpone() else {
        self.prompt += 1
        return 7
    }
    if mut cx.postpone() == Some(request) {
        mut self.reads.push(request)
    }
    return 0
} Waiter.read

fn Waiter.arrive(mut self, take value: u64, mut env: RelayEnv, mut cx: Cx[Awaited]) {
    let one_way = mut cx.postpone()
    if one_way.is_some() {
        return
    }
    for request in self.reads {
        var reply = Encoded.empty(env.alloc)
        let answer: Result[u64, Never] = Ok(value)
        mem::wire::Codec[Result[u64, Never]].encode(answer, out: mut reply.bytes)
        discard attempt mut cx.reply(request, reply)
    }
    mut self.reads.truncate(0)
} Waiter.arrive

test postponed_requests_are_answered_by_number for Cx.postpone {
    let world = testing::world()
    let alloc = world.alloc
    let minter = boards(mem::Map[u64, Held].empty(alloc), alloc)
    defer take minter.close()
    let counter = minter.mint(0)
    var stepper = try Stepper[Waiter, RelayEnv, Awaited].start(RelayEnv(alloc: alloc), exec: world.exec, alloc)
    defer take stepper.abandon()
    let Ok(runner) = attempt Runner.served(minter.mint(0)) else {
        expect false
        return
    }
    mut stepper.attach(runner)
    let inbox = stepper.outbox()
    var numbered_reply: Option[Result[Option[Encoded], CallError[Never]]] = None
    var direct: Option[Result[u64, task::SendError]] = None
    try await task::scope(world.exec, body: fn[mut stepper, mut numbered_reply, mut direct](s: task::Scope) fails task::Cancelled uses wait {
        let numbered = s.spawn(fn() -> Result[Option[Encoded], CallError[Never]] fails task::Cancelled uses wait {
            var call = Encoded.empty(alloc)
            discard Wire[Awaited].read(mut call)
            let peers = mem::List[ProtocolSchema].empty(alloc)
            return attempt await Wire[Awaited].serve(inbox, request: 4, hash: Wire[Awaited].hash(), peers: peers.view(), raw: Untrusted.of(call.bytes.view()), handles: call.handles.view(), alloc)
        })
        try await stepper.incoming()
        discard mut stepper.step()
        numbered_reply = Some(try await take numbered.join())
        let posted = s.spawn(fn() -> Result[u64, task::SendError] fails task::Cancelled uses wait {
            return attempt await inbox.read()
        })
        try await stepper.incoming()
        discard mut stepper.step()
        direct = Some(try await take posted.join())
    })
    let Some(Ok(None)) = numbered_reply else {
        expect false
        return
    }
    let Some(Ok(7)) = direct else {
        expect false
        return
    }
    let before = reach(counter, body: board_count)
    mut stepper.deliver(Awaited.arrive(value: 9))
    let after = reach(counter, body: board_count)
    expect before == Some(0) and after == Some(4_000)
    undefer stepper
    let last = try await take stepper.end()
    expect last.state.reads.len() == 0 and last.state.prompt == 1
} postponed_requests_are_answered_by_number

/// Whether a call keeping `clock` carries its handle, which the reply to it gives back.
fn keeps_clock(clock: Clock, alloc: mem::Alloc) -> bool {
    var call = Encoded.empty(alloc)
    let reply = Wire[Meter].keep(mut call, clock)
    let kept = attempt reply.decode(Untrusted.of(b"\x02Ok\x01\x01\x00"), handles: call.handles.view(), alloc)
    let none = mem::List[Handle].empty(alloc)
    let missing = attempt reply.decode(Untrusted.of(b"\x02Ok\x01\x01\x00"), handles: none.view(), alloc)
    return call.bytes.view() == b"\x04keep\x01\x09\x01\x05clock\x01\x00" and kept.is_ok() and missing.is_err()
} keeps_clock

test handles_travel_beside_their_encodings for Reply.decode {
    let world = testing::world()
    let alloc = world.alloc
    let clock = world.clock
    discard try await host::Runner[Gauge].run(MeterEnv(), exec: world.exec, alloc, body: fn(inbox: Outbox[Meter]) fails CallError[Never] uses wait {
        var call = Encoded.empty(alloc)
        let reply = Wire[Meter].keep(mut call, clock)
        expect call.bytes.view() == b"\x04keep\x01\x09\x01\x05clock\x01\x00"
        expect call.handles.len() == 1
        let missing = mem::List[Handle].empty(alloc)
        let Err(CallError.Malformed(core::DecodeError.Truncated)) = attempt await served(inbox, call, handles: missing.view(), alloc) else {
            expect false
            return
        }
        var doubled = mem::List[Handle].empty(alloc)
        mut doubled.push(call.handles.at(0))
        mut doubled.push(call.handles.at(0))
        let Err(CallError.Malformed(core::DecodeError.Trailing)) = attempt await served(inbox, call, handles: doubled.view(), alloc) else {
            expect false
            return
        }
        let Ok(Some(answer)) = attempt await served(inbox, call, handles: call.handles.view(), alloc) else {
            expect false
            return
        }
        let kept = try reply.decode(Untrusted.of(answer.bytes.view()), handles: answer.handles.view(), alloc)
        let elapsed = attempt kept.elapsed_ns()
        expect elapsed.is_ok()
        var other = Encoded.empty(alloc)
        discard Wire[Meter].add(mut other, amount: 1)
        let refused = attempt reply.decode(Untrusted.of(answer.bytes.view()), handles: other.handles.view(), alloc)
        let Err(CallError.Malformed(core::DecodeError.Truncated)) = refused else {
            expect false
            return
        }
    })
} handles_travel_beside_their_encodings

