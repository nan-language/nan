//! A book served through the Ledger protocol: it adds amounts, gives back a clock it receives, counts the ticks of a keyed task it starts whenever resumed, traps dividing by zero and spins without end when asked.

pub protocol Ledger {
    pub fn add(amount: u32) -> u64 limits pure
    pub fn echo(clock: sys::Clock) -> sys::Clock limits pure
    pub fn divide(by: u32) -> u64 limits pure
    pub fn spin() -> u64 limits pure
    fn tick() limits pure
} Ledger

pub closed struct Env {
    pub log: sys::Log
} Env

impl Env: nanos::Environment

pub fn Env.build(take world: nanos::World) -> Env = Env(log: world.log)

pub closed struct Book derives Encode {
    pub total: u64
    pub ticks: u64
} Book

impl Book: sys::Component[Env, Ledger]

impl Book: sys::Resume[Env, Ledger]

pub fn Book.start(mut env: Env) -> Book = Book(total: 0, ticks: 0)

pub fn Book.add(mut self, take amount: u32, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    self.total = self.total.wrapping_add(u64.widen(amount))
    return self.total
} Book.add

pub fn Book.echo(mut self, take clock: sys::Clock, mut env: Env, mut cx: sys::Cx[Ledger]) -> sys::Clock = clock

pub fn Book.divide(mut self, take by: u32, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    return self.total / u64.widen(by)
} Book.divide

pub fn Book.spin(mut self, mut env: Env, mut cx: sys::Cx[Ledger]) -> u64 {
    loop {
    }
} Book.spin

fn Book.tick(mut self, mut env: Env, mut cx: sys::Cx[Ledger]) {
    self.ticks += 1
} Book.tick

pub fn Book.resume(mut self, reason: sys::ResumeReason, mut env: Env, mut cx: sys::Cx[Ledger]) {
    env.log.info("resumed", value: reason)
    mut cx.spawn(key: 1, run: fn(out: sys::Outbox[Ledger]) fails task::Cancelled uses wait {
        discard attempt await out.tick()
    })
} Book.resume
