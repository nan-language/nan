//! Resolution: the greatest acceptable assignment of releases to the dependency sources of a package, and the lock `nan dep sync` and `nan upgrade` write from it, appending the path releases it locks to the local store. `nan upgrade` also forwards the package's uses of retired forms.

/// A package whose locked release changes: its name, its old and new code roots, the class of
/// the new release with the old as its parent, the epoch of each exported item of the new release
/// above 0 that differs from its epoch in the old, and the entries of the new release's authority
/// summary that the old one's lacks.
pkg struct Change {
    pkg package_name: text::String
    pkg old: Option[hashing::HashValue]
    pkg new: Option[hashing::HashValue]
    pkg class: store::Class
    pkg epochs: mem::List[ItemEpoch]
    pkg widenings: mem::List[machine::SummaryEntry]
} Change

/// An exported item of a release, by canonical path, and its behaviour epoch.
pkg struct ItemEpoch {
    pkg path: text::String
    pkg epoch: u64
} ItemEpoch

/// What resolution decides.
pkg enum Outcome {
    /// The lock to write, the packages whose locked release changes, the package's source files
    /// that forwarding rewrites, and its errors under the lock: its uses that stay moved and,
    /// when its own errors were ignored, every other.
    Resolved(lock: machine::Lock, changes: mem::List[Change], sources: mem::Map[text::String, mem::Bytes], errors: mem::List[diagnostic::Diagnostic])
    /// No assignment is acceptable: why the newest one is not.
    Unresolved(Rejection)
} Outcome

/// Why an assignment is not acceptable: the errors checking finds and the tests that fail.
pkg struct Rejection {
    pkg diagnostics: mem::List[diagnostic::Diagnostic]
    pkg failures: mem::List[test_runs::Failure]
} Rejection

/// The rejection naming no reason.
fn Rejection.empty(alloc: mem::Alloc) -> Rejection {
    return Rejection(diagnostics: mem::List[diagnostic::Diagnostic].empty(alloc), failures: mem::List[test_runs::Failure].empty(alloc))
} Rejection.empty

/// A source a `dep` directive of the closure names: as the locking package's lock writes it, with
/// the package it reaches and, for a path, the package's directory.
struct Source derives Eq {
    written: text::String
    package_name: text::String
    dir: Option[text::String]
} Source

fn Source.copy(self, alloc: mem::Alloc) -> Source {
    var dir: Option[text::String] = None
    match self.dir {
        Some(held) => {
            dir = Some(text::String.of(held.as_str(), alloc))
        }
        None => {}
    }
    return Source(written: text::String.of(self.written.as_str(), alloc), package_name: text::String.of(self.package_name.as_str(), alloc), dir: take dir)
} Source.copy

/// The order of sources by package, then source as written.
fn source_order(left: Source, right: Source) -> core::Ordering {
    let by_package = left.package_name.as_str().cmp(right.package_name.as_str())
    if by_package != core::Ordering.Equal {
        return by_package
    }
    return left.written.as_str().cmp(right.written.as_str())
} source_order

/// A candidate release of a source: the current state of a path source's workspace package, or
/// a release of the store.
enum Candidate {
    Current(usize)
    Stored(mem::Shared[store::Entry])
} Candidate

fn Candidate.copy(self) -> Candidate {
    return match self {
        Candidate.Current(index) => Candidate.Current(index)
        Candidate.Stored(entry) => Candidate.Stored(entry.share())
    }
} Candidate.copy

/// A source and the candidate assigned to it.
struct Assigned {
    source: Source
    candidate: Candidate
} Assigned

/// A copy of an assignment.
fn copied_assignment(assigned: Slice[Assigned], alloc: mem::Alloc) -> mem::List[Assigned] {
    var copy = mem::List[Assigned].empty(alloc)
    for pair in assigned {
        mut copy.push(Assigned(source: pair.source.copy(alloc), candidate: pair.candidate.copy()))
    }
    return copy
} copied_assignment

/// The code root a lock line names for the current state of a path source while candidates are
/// checked, before that state's code root is computed.
fn pending_code_root(dir: Str, alloc: mem::Alloc) -> text::String {
    var keyed = text::String.of("current\n", alloc)
    mut keyed.append(dir)
    return keyed
} pending_code_root

fn pending_root(dir: Str, alloc: mem::Alloc) -> hashing::HashValue {
    return hashing::HashValue.of(pending_code_root(dir, alloc).as_bytes())
} pending_root

/// A store entry by its code root, outside the entries of the local store read: for a candidate
/// lock, one of its pending code root attesting its files, standing for the current state of a
/// path source's package.
struct CurrentEntry {
    root: hashing::HashValue
    entry: mem::Shared[store::Entry]
} CurrentEntry

struct Resolver {
    session: check::Session
    package_index: usize
    entries: mem::List[mem::Shared[store::Entry]]
    /// The code root of each entry, by its position in `entries`.
    roots: mem::List[hashing::HashValue]
    /// Why the first assignment judged, the newest, is not acceptable.
    newest: Option[Rejection]
    /// Whether the package's own errors make an assignment unacceptable: until no assignment is
    /// acceptable with them.
    own_errors: bool
    /// Whether the package is checked with each use matching a `preserves` or `changes`
    /// tombstone replaced by its forwarding fix, `name.moved` accepted.
    forwarding: bool
    alloc: mem::Alloc
} Resolver

/// Resolves the dependency closure of the workspace package at `package_index`, forwarding its
/// uses of retired forms when `forwarding`.
pkg fn resolve(session: check::Session, package_index: usize, local: store::Store, user_cache: cache::Cache, forwarding: bool) -> Result[Outcome, cache::Exposed] fails platform::IoError {
    let alloc = session.alloc
    let read = match try local.entries() {
        Ok(found) => found
        Err(exposed) => return Err(take exposed)
    }
    var entries = mem::List[mem::Shared[store::Entry]].empty(alloc)
    var roots = mem::List[hashing::HashValue].empty(alloc)
    for entry in take read {
        mut roots.push(entry.root(alloc))
        mut entries.push(mem::Shared.of(take entry, alloc))
    }
    var resolver = Resolver(session: session.share(), package_index: package_index, entries: take entries, roots: take roots, newest: None, own_errors: true, forwarding: forwarding, alloc: alloc)
    let held = session.workspace.contents()
    let Some(root) = held.package_at(package_index) else {
        expect false
        return Ok(Outcome.Unresolved(Rejection.empty(alloc)))
    }
    var assigned = mem::List[Assigned].empty(alloc)
    var found: Option[mem::List[Assigned]] = None
    match resolver.sources_of(root.dir.as_str(), deps: workspace::manifest_deps(root, alloc).view()) {
        Some(direct) => {
            found = try mut resolver.search(assigned: mut assigned, pending: copied_sources(direct.view(), alloc), user_cache)
            if found.is_none() {
                resolver.own_errors = false
                found = try mut resolver.search(assigned: mut assigned, pending: take direct, user_cache)
            }
        }
        None => {}
    }
    let Some(assignment) = found else {
        let Some(manifest) = root.manifest else {
            expect false
            return Ok(Outcome.Unresolved(Rejection.empty(alloc)))
        }
        var path = text::String.of(root.dir.as_str(), alloc)
        mut path.append("/package.nan")
        var rejection = Rejection.empty(alloc)
        match resolver.without_candidate() {
            Some(unreached) => {
                var unresolved = diagnostic::Diagnostic.at(diagnostic::Code.DepUnresolved, path: path.as_str(), line: unreached.line, alloc)
                mut unresolved.because.push(diagnostic::Reason.note(unreached.named.as_str(), alloc))
                mut rejection.diagnostics.push(take unresolved)
            }
            None => {
                match mut resolver.newest.extract() {
                    Some(newest) => {
                        rejection = newest
                    }
                    None => {}
                }
                mut rejection.diagnostics.push(diagnostic::Diagnostic.at(diagnostic::Code.DepUnresolved, path: path.as_str(), line: manifest.line, alloc))
            }
        }
        return Ok(Outcome.Unresolved(Rejection(diagnostics: diagnostic::sorted_diagnostics(take rejection.diagnostics, alloc), failures: take rejection.failures)))
    }
    return try resolver.lock(local, assigned: assignment.view())
} resolve

/// Copies of sources.
fn copied_sources(sources: Slice[Source], alloc: mem::Alloc) -> mem::List[Source] {
    var copy = mem::List[Source].empty(alloc)
    for source in sources {
        mut copy.push(source.copy(alloc))
    }
    return copy
} copied_sources

/// The workspace package being resolved.
proj fn Resolver.root(self) -> workspace::Package {
    let Some(root) = self.session.workspace.contents().package_at(self.package_index) else {
        expect false
        loop {
        }
    }
    return root
} Resolver.root

/// The sources of `dep` directives written in the package directory `dir`, as the locking
/// package writes them; none when one has no candidate, reaching no package.
fn Resolver.sources_of(self, dir: Str, deps: Slice[workspace::DepSource]) -> Option[mem::List[Source]] {
    var sources = mem::List[Source].empty(self.alloc)
    for dep in deps {
        match self.source(dir, written: dep.written.as_str(), path: dep.path) {
            Ok(source) => mut sources.push(take source)
            Err(_) => return None
        }
    }
    return Some(take sources)
} Resolver.sources_of

/// The source of a `dep` directive written in the package directory `dir`, as the locking package
/// writes it, or, when it reaches no package, what it names: the directory of a path relative to
/// the workspace root, a store name otherwise.
fn Resolver.source(self, dir: Str, written: Str, path: bool) -> Result[Source, text::String] {
    let alloc = self.alloc
    if not path {
        let Some(at) = self.entries.position(fn(entry: mem::Shared[store::Entry]) => named_as(entry.contents(), name: written)) else {
            return Err(text::String.of(written, alloc))
        }
        let package_name = text::String.of(self.entries[at].contents().package_name.as_str(), alloc)
        return Ok(Source(written: text::String.of(written, alloc), package_name: take package_name, dir: None))
    }
    let held = self.session.workspace.contents()
    let target = workspace::resolve_source(dir, source: written, alloc)
    let Some(at) = held.package_position(fn(candidate: workspace::Package) => candidate.dir.as_str() == target.as_str()) else {
        return Err(take target)
    }
    let Some(pack) = held.package_at(at) else {
        expect false
        return Err(take target)
    }
    let Some(name) = pack.name() else {
        return Err(take target)
    }
    let relative = workspace::relative_source(self.root().dir.as_str(), to: target.as_str(), alloc)
    return Ok(Source(written: take relative, package_name: text::String.of(name, alloc), dir: Some(take target)))
} Resolver.source

/// A `dep` directive of the package through whose newest candidates a source without candidates
/// is reached: its line, and what that source names.
struct Unreached {
    line: u32
    named: text::String
} Unreached

/// The first `dep` directive of the package, in alias order, through whose newest candidates a
/// source without candidates is reached.
fn Resolver.without_candidate(self) -> Option[Unreached] {
    let alloc = self.alloc
    let root = self.root()
    let Some(manifest) = root.manifest else {
        return None
    }
    var order = mem::List[usize].empty(alloc)
    for at in 0..<manifest.deps.len() {
        if manifest.deps[at].source.is_some() {
            mut order.push(at)
        }
    }
    mut order.sort_by(fn(left: usize, right: usize) => manifest.deps[left].alias.as_str().cmp(manifest.deps[right].alias.as_str()))
    for at in order {
        let dep = manifest.deps[at]
        var seen = mem::List[Source].empty(alloc)
        match self.unreached(root.dir.as_str(), written: dep.written.as_str(), path: dep.path, seen: mut seen) {
            Some(named) => return Some(Unreached(line: dep.line, named: take named))
            None => {}
        }
    }
    return None
} Resolver.without_candidate

/// What the first source without candidates names that a directive written in the package
/// directory `dir` reaches through newest candidates, the sources in `seen` aside.
fn Resolver.unreached(self, dir: Str, written: Str, path: bool, mut seen: mem::List[Source]) -> Option[text::String] {
    let source = match self.source(dir, written, path) {
        Ok(source) => source
        Err(named) => return Some(take named)
    }
    if seen.position(fn(known: Source) => known == source).is_some() {
        return None
    }
    let alloc = self.alloc
    mut seen.push(source.copy(alloc))
    let candidates = self.candidates(source)
    if candidates.len() == 0 {
        return match source.dir {
            Some(held) => Some(text::String.of(held.as_str(), alloc))
            None => Some(text::String.of(source.written.as_str(), alloc))
        }
    }
    let reaching = self.manifest_of(candidates[0], source)
    for dep in reaching.deps {
        match self.unreached(reaching.dir.as_str(), written: dep.written.as_str(), path: dep.path, seen: mut seen) {
            Some(named) => return Some(take named)
            None => {}
        }
    }
    return None
} Resolver.unreached

/// Whether a store entry is a named release of a store name.
fn named_as(entry: store::Entry, name: Str) -> bool {
    let Some(held) = entry.name else {
        return false
    }
    return held.as_str() == name
} named_as

/// The code root of the entry holding a release, by its position.
fn Resolver.root_at(self, at: usize) -> hashing::HashValue {
    let Some(root) = self.roots.get(at) else {
        expect false
        return hashing::HashValue(bytes: Array[u8, 33].filled(0))
    }
    return root
} Resolver.root_at

/// A source's candidates, newest first.
fn Resolver.candidates(self, source: Source) -> mem::List[Candidate] {
    let alloc = self.alloc
    var found = mem::List[Candidate].empty(alloc)
    let held = self.session.workspace.contents()
    match source.dir {
        Some(dir) => {
            match held.package_position(fn(candidate: workspace::Package) => candidate.dir.as_str() == dir.as_str()) {
                Some(index) => mut found.push(Candidate.Current(index))
                None => {}
            }
            return found
        }
        None => {}
    }
    var locked: Option[hashing::HashValue] = None
    match self.root().machine.lock() {
        Some(lock) => {
            for line in lock.deps {
                if line.source.as_str() == source.written.as_str() {
                    locked = Some(line.root)
                    break
                }
            }
        }
        None => {}
    }
    var named = mem::List[usize].empty(alloc)
    for at in 0..<self.entries.len() {
        if named_as(self.entries[at].contents(), name: source.written.as_str()) {
            mut named.push(at)
        }
    }
    for position in 0..<named.len() {
        let at = named[named.len() - 1 - position]
        let kept = match locked {
            Some(ancestor) => self.descends(named.view(), at, ancestor)
            None => true
        }
        if kept {
            expect at < self.entries.len()
            mut found.push(Candidate.Stored(self.entries[at].share()))
        }
    }
    return found
} Resolver.candidates

/// Whether the named release at `at` is `ancestor` or descends from it through parents among
/// the releases `named`.
fn Resolver.descends(self, named: Slice[usize], at: usize, ancestor: hashing::HashValue) -> bool {
    var current = Some(at)
    while current.is_some() {
        let Some(held) = current else {
            return false
        }
        if self.root_at(held) == ancestor {
            return true
        }
        current = None
        expect held < self.entries.len()
        let Some(parent) = self.entries[held].contents().parent else {
            return false
        }
        for other in named {
            if self.root_at(other) == parent {
                current = Some(other)
                break
            }
        }
    }
    return false
} Resolver.descends

/// The dependency sources a candidate's manifest names; none when one has no candidate.
fn Resolver.reached(self, candidate: Candidate, source: Source) -> Option[mem::List[Source]] {
    let reaching = self.manifest_of(candidate, source)
    return self.sources_of(reaching.dir.as_str(), deps: reaching.deps.view())
} Resolver.reached

/// The package directory of a candidate of a source, and the `dep` directives its manifest writes.
struct Reaching {
    dir: text::String
    deps: mem::List[workspace::DepSource]
} Reaching

fn Resolver.manifest_of(self, candidate: Candidate, source: Source) -> Reaching {
    let alloc = self.alloc
    let held = self.session.workspace.contents()
    match candidate {
        Candidate.Current(index) => {
            let Some(pack) = held.package_at(index) else {
                expect false
                return Reaching(dir: text::String.empty(alloc), deps: mem::List[workspace::DepSource].empty(alloc))
            }
            return Reaching(dir: text::String.of(pack.dir.as_str(), alloc), deps: workspace::manifest_deps(pack, alloc))
        }
        Candidate.Stored(entry) => {
            let dir = match source.dir {
                Some(held_dir) => text::String.of(held_dir.as_str(), alloc)
                None => text::String.of(source.package_name.as_str(), alloc)
            }
            let Some(at) = entry.contents().sources.position(fn(file: artefact::SourceFile) => file.path.as_str() == "package.nan") else {
                return Reaching(dir: take dir, deps: mem::List[workspace::DepSource].empty(alloc))
            }
            var manifest = mem::Bytes.empty(alloc)
            mut manifest.append(entry.contents().sources[at].content.view())
            let file = syntax::parse(take manifest, grammar: self.session.grammar.contents(), alloc)
            let deps = workspace::read_deps(file, dir: dir.as_str(), alloc)
            return Reaching(dir: take dir, deps: take deps)
        }
    }
} Resolver.manifest_of

/// The greatest acceptable assignment extending `assigned` to the sources of `pending`.
fn Resolver.search(mut self, mut assigned: mem::List[Assigned], take pending: mem::List[Source], user_cache: cache::Cache) -> Option[mem::List[Assigned]] fails platform::IoError {
    let alloc = self.alloc
    var waiting = pending
    mut waiting.retain(fn(source: Source) => assigned.position(fn(known: Assigned) => known.source == source).is_none())
    mut waiting.sort_by(fn(left: Source, right: Source) => source_order(left, right))
    var sources = mem::List[Source].empty(alloc)
    for source in take waiting {
        let count = sources.len()
        if count > 0 and sources[count - 1] == source {
            continue
        }
        mut sources.push(take source)
    }
    if sources.len() == 0 {
        match try self.judge(assigned.view(), user_cache) {
            None => return Some(copied_assignment(assigned.view(), alloc))
            Some(rejection) => {
                if self.newest.is_none() {
                    self.newest = Some(take rejection)
                }
                return None
            }
        }
    }
    let next = sources[0].copy(alloc)
    let root_name = match self.root().name() {
        Some(name) => name
        None => ""
    }
    let split = assigned.position(fn(known: Assigned) => known.source.package_name == next.package_name and known.source.written != next.written).is_some()
    if split or next.package_name.as_str() == root_name {
        return None
    }
    for candidate in take self.candidates(next) {
        let Some(reached) = self.reached(candidate, source: next) else {
            continue
        }
        var rest = mem::List[Source].empty(alloc)
        for index in 1..<sources.len() {
            mut rest.push(sources[index].copy(alloc))
        }
        for source in take reached {
            mut rest.push(take source)
        }
        mut assigned.push(Assigned(source: next.copy(alloc), candidate: take candidate))
        match try mut self.search(assigned: mut assigned, pending: take rest, user_cache) {
            Some(found) => return Some(take found)
            None => {}
        }
        discard mut assigned.pop()
    }
    return None
} Resolver.search

/// The root a candidate lock line names for a candidate.
fn Resolver.candidate_root(self, source: Source, candidate: Candidate) -> hashing::HashValue {
    match candidate {
        Candidate.Current(_) => {
            let dir = match source.dir {
                Some(held) => held.as_str()
                None => ""
            }
            return pending_root(dir, alloc: self.alloc)
        }
        Candidate.Stored(entry) => return entry.contents().root(self.alloc)
    }
} Resolver.candidate_root

/// The public key of the publisher of a candidate's release, for a stored signed one.
fn Resolver.candidate_signer(self, candidate: Candidate) -> Option[core::crypto::PublicKey] {
    let Candidate.Stored(entry) = candidate else {
        return None
    }
    let Ok(decoded) = artefact::decode(entry.contents().artefact.view(), alloc: self.alloc) else {
        return None
    }
    return decoded.publisher_key(alloc: self.alloc)
} Resolver.candidate_signer

/// The candidate lock of an assignment: path lines name the pending roots of current
/// states.
fn Resolver.candidate_lock(self, assigned: Slice[Assigned]) -> machine::Lock {
    let alloc = self.alloc
    let deps_written = workspace::manifest_deps(self.root(), alloc)
    var deps = mem::List[machine::Locked].empty(alloc)
    for pair in assigned {
        var alias: Option[text::String] = None
        for dep in deps_written {
            if dep.written == pair.source.written {
                alias = Some(text::String.of(dep.alias.as_str(), alloc))
            }
        }
        mut deps.push(machine::Locked(package_name: text::String.of(pair.source.package_name.as_str(), alloc), alias: take alias, source: text::String.of(pair.source.written.as_str(), alloc), root: self.candidate_root(pair.source, candidate: pair.candidate), signer: self.candidate_signer(pair.candidate), line: 0))
    }
    mut deps.sort_by(fn(left: machine::Locked, right: machine::Locked) => left.package_name.as_str().cmp(right.package_name.as_str()))
    var snapshot: u64 = 0
    if self.entries.len() > 0 {
        snapshot = self.entries[self.entries.len() - 1].contents().index
    }
    return machine::Lock(snapshot: snapshot, deps: take deps, approved: mem::List[machine::Approval].empty(alloc), epochs: mem::List[machine::ApprovedEpoch].empty(alloc))
} Resolver.candidate_lock

/// The session of an assignment's candidate lock, the package's uses of retired forms
/// forwarded when resolving so, with the files forwarding rewrites.
struct Forwarded {
    session: check::Session
    sources: mem::Map[text::String, mem::Bytes]
} Forwarded

fn Resolver.assigned(self, lock: machine::Lock) -> Forwarded fails platform::IoError {
    let alloc = self.alloc
    let locked = try self.locked_session(lock, changed: mem::Map[text::String, mem::Bytes].empty(alloc))
    if not self.forwarding {
        return Forwarded(session: take locked, sources: mem::Map[text::String, mem::Bytes].empty(alloc))
    }
    let sources = forwarded(locked, package_index: self.package_index)
    if sources.len() == 0 {
        return Forwarded(session: take locked, sources: take sources)
    }
    let rewritten = try self.locked_session(lock, changed: copied_files(sources, alloc))
    return Forwarded(session: take rewritten, sources: take sources)
} Resolver.assigned

/// A copy of files by path.
fn copied_files(files: mem::Map[text::String, mem::Bytes], alloc: mem::Alloc) -> mem::Map[text::String, mem::Bytes] {
    var copy = mem::Map[text::String, mem::Bytes].empty(alloc)
    for file in files {
        var content = mem::Bytes.empty(alloc)
        mut content.append(file.value().view())
        discard mut copy.insert(text::String.of(file.key().as_str(), alloc), value: take content)
    }
    return copy
} copied_files

/// The session of the workspace with the candidate lock of an assignment and changed source
/// files.
fn Resolver.locked_session(self, lock: machine::Lock, take changed: mem::Map[text::String, mem::Bytes]) -> check::Session fails platform::IoError {
    let alloc = self.alloc
    let held = self.session.workspace.contents()
    var current = mem::List[CurrentEntry].empty(alloc)
    for shared in held.packages {
        let pack = shared.contents()
        let package_name = match pack.name() {
            Some(name) => name
            None => ""
        }
        let sources = check::package_files(pack, alloc)
        let attested = artefact::attestation(self.session.toolchain_hash(), source_tree: artefact::source_tree_hash(sources.view(), alloc), seals: artefact::seal_list(mem::List[artefact::AttestedSeal].empty(alloc).view(), alloc).view(), alloc)
        let pending = artefact::artefact(pending_code_root(pack.dir.as_str(), alloc).as_bytes(), attested: attested.view(), alloc)
        let entry = store::Entry(index: 0, package_name: text::String.of(package_name, alloc), name: None, parent: None, summary: None, artefact: take pending, sources: take sources)
        mut current.push(CurrentEntry(root: pending_root(pack.dir.as_str(), alloc), entry: mem::Shared.of(take entry, alloc)))
    }
    var path = text::String.of(self.root().dir.as_str(), alloc)
    mut path.append("/.nan/lock.nan")
    let grammar = self.session.grammar.contents()
    let Some(bytes) = lock.bytes(grammar, alloc) else {
        expect false
        return self.session.share()
    }
    var files = changed
    discard mut files.insert(take path, value: take bytes)
    let rebuilt = try held.rebuilt(files, store_entry: fn(root: hashing::HashValue) -> Option[mem::Shared[store::Entry]] {
        for held_entry in current {
            if held_entry.root == root {
                return Some(held_entry.entry.share())
            }
        }
        for at in 0..<self.entries.len() {
            if self.root_at(at) == root {
                return Some(self.entries[at].share())
            }
        }
        return None
    }, grammar, alloc)
    return check::Session.of(mem::Shared.of(take rebuilt, alloc), std: self.session.carried.share(), grammar: self.session.grammar.share(), home: cache::copied_override(self.session.home, alloc), alloc)
} Resolver.locked_session

/// Whether a diagnostic lies in a file under a directory.
fn lies_within(reported: diagnostic::Diagnostic, dir: Str) -> bool {
    let Some(path) = reported.path else {
        return false
    }
    if not path.starts_with(dir) {
        return false
    }
    let Some(rest) = path.as_str().slice_bytes(dir.byte_len(), end: path.byte_len()) else {
        return false
    }
    return rest.starts_with("/")
} lies_within

/// Why an assignment is not acceptable, none when it is: the errors checking the closure
/// finds on the package, the current states and the releases, but for what the package's
/// lock leaves unapproved, and its failing tests.
fn Resolver.judge(self, assigned: Slice[Assigned], user_cache: cache::Cache) -> Option[Rejection] fails platform::IoError {
    let alloc = self.alloc
    let lock = self.candidate_lock(assigned)
    let judged = try self.assigned(lock)
    let workspace_held = judged.session.workspace.contents()
    let Some(root) = workspace_held.package_at(self.package_index) else {
        expect false
        return Some(Rejection.empty(alloc))
    }
    let root_dir = root.dir.as_str()
    let Some(closure) = workspace_held.closure_of(self.package_index) else {
        return Some(Rejection.empty(alloc))
    }
    var dirs = mem::List[text::String].empty(alloc)
    for pair in assigned {
        match pair.candidate {
            Candidate.Current(_) => {
                match pair.source.dir {
                    Some(dir) => mut dirs.push(text::String.of(dir.as_str(), alloc))
                    None => mut dirs.push(text::String.empty(alloc))
                }
            }
            Candidate.Stored(_) => mut dirs.push(text::String.of(pair.source.package_name.as_str(), alloc))
        }
    }
    var errors = judged.session.closure_errors(closure)
    for reported in take workspace_held.diagnostics(alloc) {
        mut errors.push(take reported)
    }
    var own = mem::List[diagnostic::Diagnostic].empty(alloc)
    var rejection = Rejection.empty(alloc)
    for reported in take errors {
        if reported.code.class() != diagnostic::Class.Error {
            continue
        }
        if self.forwarding and reported.code == diagnostic::Code.NameMoved {
            continue
        }
        if check::is_unapproved(reported.code) {
            continue
        }
        if lies_within(reported, dir: root_dir) {
            mut own.push(take reported)
            continue
        }
        let related = reported.path.is_none() or dirs.position(fn(dir: text::String) => lies_within(reported, dir: dir.as_str())).is_some()
        if related {
            mut rejection.diagnostics.push(take reported)
        }
    }
    if own.len() == 0 {
        let changed = self.changed(lock)
        match try test_runs::run(judged.session, scope: scope::Scope.Package(self.package_index), runs: test_runs::Runs.Reaching(take changed), user_cache, checked: None) {
            Ok(report) => {
                rejection.failures = report.failures
                for reported in take report.diagnostics {
                    mut rejection.diagnostics.push(take reported)
                }
            }
            Err(exposed) => {
                var reported = diagnostic::Diagnostic.new(diagnostic::Code.BuildCacheExposed, alloc)
                reported.path = Some(take exposed.path)
                mut rejection.diagnostics.push(take reported)
            }
        }
    } else if self.own_errors {
        for reported in take own {
            mut rejection.diagnostics.push(take reported)
        }
    }
    if rejection.diagnostics.len() == 0 and rejection.failures.len() == 0 {
        return None
    }
    return Some(take rejection)
} Resolver.judge

/// The packages whose release a candidate lock assigns differently from the current lock: a
/// path source's current state counting as changed.
fn Resolver.changed(self, candidate: machine::Lock) -> mem::List[text::String] {
    let alloc = self.alloc
    var changed = mem::List[text::String].empty(alloc)
    for line in candidate.deps {
        if not self.unchanged(line) {
            mut changed.push(text::String.of(line.package_name.as_str(), alloc))
        }
    }
    return changed
} Resolver.changed

/// Whether the current lock assigns a candidate lock line's package the same release: the same
/// root, or for the pending root of a path source's current state, a release holding its files.
fn Resolver.unchanged(self, line: machine::Locked) -> bool {
    let alloc = self.alloc
    let Some(current) = self.root().machine.lock() else {
        return false
    }
    let Some(at) = current.deps.position(fn(known: machine::Locked) => known.package_name == line.package_name) else {
        return false
    }
    let known_root = current.deps[at].root
    if known_root == line.root {
        return true
    }
    let held = self.session.workspace.contents()
    let dir = workspace::resolve_source(self.root().dir.as_str(), source: line.source.as_str(), alloc)
    if line.root != pending_root(dir.as_str(), alloc) {
        return false
    }
    let Some(source_at) = held.package_position(fn(candidate: workspace::Package) => candidate.dir.as_str() == dir.as_str()) else {
        return false
    }
    let Some(pack) = held.package_at(source_at) else {
        expect false
        return false
    }
    for at_entry in 0..<self.entries.len() {
        if self.root_at(at_entry) == known_root and workspace::holds_sources(self.entries[at_entry].contents(), pack, alloc) {
            return true
        }
    }
    return false
} Resolver.unchanged

/// The position of the pair assigning a package, by name.
fn assigned_at(assigned: Slice[Assigned], package_name: Str) -> Option[usize] {
    for at in 0..<assigned.len() {
        if assigned[at].source.package_name.as_str() == package_name {
            return Some(at)
        }
    }
    return None
} assigned_at

/// The lock of an acceptable assignment, appending the path releases it locks.
fn Resolver.lock(self, local: store::Store, assigned: Slice[Assigned]) -> Result[Outcome, cache::Exposed] fails platform::IoError {
    let alloc = self.alloc
    let candidate = self.candidate_lock(assigned)
    let judged = try self.assigned(candidate)
    let workspace_held = judged.session.workspace.contents()
    let Some(closure) = workspace_held.closure_of(self.package_index) else {
        expect false
        return Ok(Outcome.Unresolved(Rejection.empty(alloc)))
    }
    var deps = mem::List[machine::Locked].empty(alloc)
    var appended = mem::List[CurrentEntry].empty(alloc)
    for line in candidate.deps {
        var locked = line.copy(alloc)
        let Some(at) = assigned_at(assigned, package_name: line.package_name.as_str()) else {
            mut deps.push(take locked)
            continue
        }
        expect at < assigned.len()
        let Candidate.Current(index) = assigned[at].candidate else {
            mut deps.push(take locked)
            continue
        }
        let built = judged.session.build(closure, member: workspace::Member.Source(index))
        let check::Built(artefact: artefact_bytes, sources: sources) = built
        let appended_entry = try local.append(store::Append(package_name: text::String.of(line.package_name.as_str(), alloc), name: None, parent: None, summary: None, artefact: take artefact_bytes, sources: take sources))
        match appended_entry {
            Ok(entry) => {
                locked.root = entry.root(alloc)
                mut appended.push(CurrentEntry(root: locked.root, entry: mem::Shared.of(take entry, alloc)))
            }
            Err(exposed) => return Err(take exposed)
        }
        mut deps.push(take locked)
    }
    let published = match try local.index() {
        Ok(index) => index
        Err(exposed) => return Err(take exposed)
    }
    var snapshot: u64 = 0
    if published.len() > 0 {
        snapshot = published[published.len() - 1].index
    }
    var lock = match self.root().machine.lock() {
        Some(current) => current.copy(alloc)
        None => machine::Lock.empty(alloc)
    }
    lock.snapshot = snapshot
    lock.deps = deps
    let unlocked = self.root().machine.lock_file.is_none()
    let approved = judged.session.approvals(self.package_index, take lock, all: unlocked)
    let changes = try self.changes(approved.lock, appended: appended.view())
    var errors = mem::List[diagnostic::Diagnostic].empty(alloc)
    if self.forwarding or not self.own_errors {
        for reported in take judged.session.reported(scope::Scope.Package(self.package_index)) {
            let kept = match self.own_errors {
                true => reported.code == diagnostic::Code.NameMoved
                false => reported.code.class() == diagnostic::Class.Error and not check::is_unapproved(reported.code)
            }
            if kept {
                mut errors.push(take reported)
            }
        }
    }
    let check::Approved(lock: locked, unapproved: unapproved) = approved
    for reported in take unapproved {
        mut errors.push(take reported)
    }
    let Forwarded(session: _, sources: sources) = judged
    return Ok(Outcome.Resolved(lock: take locked, changes: take changes, sources: take sources, errors: diagnostic::sorted_diagnostics(take errors, alloc)))
} Resolver.lock

/// The position of the entry holding a release, by its code root.
fn Resolver.entry_at(self, root: Option[hashing::HashValue]) -> Option[usize] {
    let Some(wanted) = root else {
        return None
    }
    for at in 0..<self.entries.len() {
        if self.root_at(at) == wanted {
            return Some(at)
        }
    }
    return None
} Resolver.entry_at

/// The code root a lock assigns a package, by name.
fn root_of(lock: Option[machine::Lock], package_name: Str) -> Option[hashing::HashValue] {
    let Some(held) = lock else {
        return None
    }
    for line in held.deps {
        if line.package_name.as_str() == package_name {
            return Some(line.root)
        }
    }
    return None
} root_of

/// The packages whose locked release a new lock changes, by name, the path releases it locks
/// that the store did not hold in `appended`.
fn Resolver.changes(self, lock: machine::Lock, appended: Slice[CurrentEntry]) -> mem::List[Change] fails platform::IoError {
    let alloc = self.alloc
    let current = self.root().machine.lock()
    var listed = mem::List[text::String].empty(alloc)
    match current {
        Some(held) => {
            for line in held.deps {
                mut listed.push(text::String.of(line.package_name.as_str(), alloc))
            }
        }
        None => {}
    }
    for line in lock.deps {
        mut listed.push(text::String.of(line.package_name.as_str(), alloc))
    }
    mut listed.sort_by(fn(left: text::String, right: text::String) => left.as_str().cmp(right.as_str()))
    var names = mem::List[text::String].empty(alloc)
    for index in 0..<listed.len() {
        let name = listed[index].as_str()
        if index > 0 and listed[index - 1].as_str() == name {
            continue
        }
        if root_of(current, package_name: name) != root_of(Some(lock), package_name: name) {
            mut names.push(text::String.of(name, alloc))
        }
    }
    var changes = mem::List[Change].empty(alloc)
    if names.len() == 0 {
        return changes
    }
    let held_before = mem::List[CurrentEntry].empty(alloc)
    let before = match current {
        Some(held) => try self.authority(held, appended: held_before.view(), names: names.view())
        None => self.no_authority(names.len())
    }
    let after = try self.authority(lock, appended, names: names.view())
    for index in 0..<names.len() {
        let name = names[index].as_str()
        let old = root_of(current, package_name: name)
        let new = root_of(Some(lock), package_name: name)
        var widenings = mem::List[machine::SummaryEntry].empty(alloc)
        for entry in after[index] {
            if not before[index].contains(entry) {
                mut widenings.push(entry.copy(alloc))
            }
        }
        mut changes.push(Change(package_name: text::String.of(name, alloc), old: old, new: new, class: self.change_class(old, new, appended), epochs: self.epochs(old, new), widenings: take widenings))
    }
    return changes
} Resolver.changes

/// An empty authority summary per package.
fn Resolver.no_authority(self, count: usize) -> mem::List[mem::Set[machine::SummaryEntry]] {
    var summaries = mem::List[mem::Set[machine::SummaryEntry]].empty(self.alloc)
    for _ in 0..<count {
        mut summaries.push(mem::Set[machine::SummaryEntry].empty(self.alloc))
    }
    return summaries
} Resolver.no_authority

/// The epoch of each exported item of a package's new release above 0 that differs from its
/// epoch in the old, in byte order of canonical path.
fn Resolver.epochs(self, old: Option[hashing::HashValue], new: Option[hashing::HashValue]) -> mem::List[ItemEpoch] {
    let alloc = self.alloc
    var epochs = mem::List[ItemEpoch].empty(alloc)
    let Some(new_at) = self.entry_at(new) else {
        return epochs
    }
    expect new_at < self.entries.len()
    let Some(summary) = self.entries[new_at].contents().summary else {
        return epochs
    }
    for exported in summary.items {
        if exported.epoch > 0 and exported.epoch != self.epoch_in(old, path: exported.path.as_str()) {
            mut epochs.push(ItemEpoch(path: text::String.of(exported.path.as_str(), alloc), epoch: exported.epoch))
        }
    }
    return epochs
} Resolver.epochs

/// The epoch an item has in a release: its publish summary's, 0 without one or without a release.
fn Resolver.epoch_in(self, root: Option[hashing::HashValue], path: Str) -> u64 {
    let Some(at) = self.entry_at(root) else {
        return 0
    }
    expect at < self.entries.len()
    return release::epoch(self.entries[at].contents().summary, path)
} Resolver.epoch_in

/// The authority summary of each package of `names` that the closure a lock gives the package
/// holds, in the order of `names`, each release, a path release included, read from the store or
/// `appended`.
fn Resolver.authority(self, lock: machine::Lock, appended: Slice[CurrentEntry], names: Slice[text::String]) -> mem::List[mem::Set[machine::SummaryEntry]] fails platform::IoError {
    let alloc = self.alloc
    let grammar = self.session.grammar.contents()
    let root = self.root()
    var lock_path = text::String.of(root.dir.as_str(), alloc)
    mut lock_path.append("/.nan/lock.nan")
    var files = mem::List[artefact::SourceFile].empty(alloc)
    for file in take check::package_files(root, alloc) {
        let artefact::SourceFile(path: within, content: content) = file
        var path = text::String.of(root.dir.as_str(), alloc)
        mut path.push('/')
        mut path.append(within.as_str())
        if path != lock_path {
            mut files.push(artefact::SourceFile(path: take path, content: take content))
        }
    }
    let Some(bytes) = lock.bytes(grammar, alloc) else {
        expect false
        return self.no_authority(names.len())
    }
    mut files.push(artefact::SourceFile(path: take lock_path, content: take bytes))
    let alone = try workspace::Workspace.from_files(self.session.workspace.contents().root.as_str(), files: files.view(), syntaxes: workspace::Syntaxes.parsing(), store_entry: fn(held: hashing::HashValue) -> Option[mem::Shared[store::Entry]] {
        for fresh in appended {
            if fresh.root == held {
                return Some(fresh.entry.share())
            }
        }
        for at in 0..<self.entries.len() {
            if self.root_at(at) == held {
                return Some(self.entries[at].share())
            }
        }
        return None
    }, grammar, alloc)
    let session = self.session.over(mem::Shared.of(take alone, alloc), alloc)
    return session.authority_summaries(package_index: 0, names)
} Resolver.authority

/// The entry holding a release, by its code root: the store's, else that of a path release in
/// `appended`.
fn Resolver.held_entry(self, root: Option[hashing::HashValue], appended: Slice[CurrentEntry]) -> Option[mem::Shared[store::Entry]] {
    let Some(wanted) = root else {
        return None
    }
    match self.entry_at(root) {
        Some(at) => {
            expect at < self.entries.len()
            return Some(self.entries[at].share())
        }
        None => {}
    }
    for fresh in appended {
        if fresh.root == wanted {
            return Some(fresh.entry.share())
        }
    }
    return None
} Resolver.held_entry

/// The class of a package's new release with its old one as its parent, either read from the
/// store or from the path releases in `appended`: the class its publish summary records when it
/// was published on that parent, else as their exported items compare.
fn Resolver.change_class(self, old: Option[hashing::HashValue], new: Option[hashing::HashValue], appended: Slice[CurrentEntry]) -> store::Class {
    let alloc = self.alloc
    let grammar = self.session.grammar.contents()
    let Some(release_held) = self.held_entry(new, appended) else {
        return store::Class.Additive
    }
    let release = release_held.contents()
    if release.parent == old {
        match release.summary {
            Some(summary) => return summary.class
            None => {}
        }
    }
    let Some(parent_held) = self.held_entry(old, appended) else {
        return store::Class.Additive
    }
    let parent = parent_held.contents()
    let classes = release::classes(release::exported(parent.artefact.view(), grammar, alloc), release: release::exported(release.artefact.view(), grammar, alloc), epochs: fn(path: Str) -> release::EpochPair {
        return release::EpochPair(old: release::epoch(parent.summary, path), new: release::epoch(release.summary, path))
    }, forwarded: release::forwards(release.artefact.view(), alloc), compatible: mem::Set[text::String].empty(alloc), alloc)
    return release::release_class(classes, parented: true)
} Resolver.change_class

/// The source files of a workspace package once each use matching a `preserves` or `changes`
/// tombstone is replaced by its forwarding fix, the first of overlapping fixes alone.
fn forwarded(session: check::Session, package_index: usize) -> mem::Map[text::String, mem::Bytes] {
    let alloc = session.alloc
    let diagnostics = session.reported(scope::Scope.Package(package_index))
    var kept = mem::List[diagnostic::Fix].empty(alloc)
    for reported in diagnostics {
        if reported.code != diagnostic::Code.RetiredForwardedUse and reported.code != diagnostic::Code.NameMoved {
            continue
        }
        let Some(fix) = reported.fixes.get(0) else {
            continue
        }
        if not overlaps_kept(kept.view(), fix) {
            mut kept.push(fix::copied_fix(fix, alloc))
        }
    }
    return fix::apply(session.workspace.contents(), fixes: kept.view(), alloc)
} forwarded

/// Whether a fix replaces bytes that one of the kept fixes replaces.
fn overlaps_kept(kept: Slice[diagnostic::Fix], fix: diagnostic::Fix) -> bool {
    for other in kept {
        for held in other.edits {
            for edit in fix.edits {
                if edit.path == held.path and edit.replacement.start < held.replacement.end and held.replacement.start < edit.replacement.end {
                    return true
                }
            }
        }
    }
    return false
} overlaps_kept
