//! The intermediate form lowering builds: the subset of Cranelift's IR, numbered and laid out as Cranelift numbers and lays it out, with its function builder and text form.

/// The type of a value.
pkg enum Type derives Copy, Eq, Ord, Hash {
    Int8
    Int16
    Int32
    Int64
    Int128
    Float32
    Float64
    Int8x16
    Int16x8
    Int32x4
    Int64x2
    Float32x4
} Type

pkg fn Type.bits(self) -> u32
    ensures result >= 8 and result <= 128
{
    return match self {
        Type.Int8 => 8
        Type.Int16 => 16
        Type.Int32 or Type.Float32 => 32
        Type.Int64 or Type.Float64 => 64
        Type.Int128 => 128
        else => 128
    }
} Type.bits

pkg fn Type.bytes(self) -> u32 {
    return self.bits() / 8
} Type.bytes

/// Whether the type is a scalar integer type.
pkg fn Type.is_int(self) -> bool {
    return match self {
        Type.Int8 or Type.Int16 or Type.Int32 or Type.Int64 or Type.Int128 => true
        else => false
    }
} Type.is_int

/// Whether the type is a scalar float type.
pkg fn Type.is_float(self) -> bool {
    return self == Type.Float32 or self == Type.Float64
} Type.is_float

/// Whether the type is a 128-bit vector of lanes.
pkg fn Type.is_vector(self) -> bool {
    return not self.is_int() and not self.is_float()
} Type.is_vector

/// Whether a value of the type lives in the float and vector registers.
pkg fn Type.in_vector_registers(self) -> bool {
    return not self.is_int()
} Type.in_vector_registers

/// The type of a vector's lanes, the type itself for a scalar.
pkg fn Type.lane_type(self) -> Type {
    return match self {
        Type.Int8x16 => Type.Int8
        Type.Int16x8 => Type.Int16
        Type.Int32x4 => Type.Int32
        Type.Int64x2 => Type.Int64
        Type.Float32x4 => Type.Float32
        else => self
    }
} Type.lane_type

/// The integer type of a float type's shape: the type itself for an integer type.
pkg fn Type.integer(self) -> Type {
    return match self {
        Type.Float32 => Type.Int32
        Type.Float64 => Type.Int64
        Type.Float32x4 => Type.Int32x4
        else => self
    }
} Type.integer

/// The vector of half as many lanes twice as wide.
pkg fn Type.merge_lanes(self) -> Type {
    return match self {
        Type.Int8x16 => Type.Int16x8
        Type.Int16x8 => Type.Int32x4
        else => Type.Int64x2
    }
} Type.merge_lanes

/// The integer type of a width in bits, none for a width no integer type has.
pkg fn Type.int(bits: u32) -> Option[Type] {
    return match bits {
        8 => Some(Type.Int8)
        16 => Some(Type.Int16)
        32 => Some(Type.Int32)
        64 => Some(Type.Int64)
        128 => Some(Type.Int128)
        else => None
    }
} Type.int

/// The type's name in the text form.
pkg proj fn Type.name(self) -> Str {
    return match self {
        Type.Int8 => "i8"
        Type.Int16 => "i16"
        Type.Int32 => "i32"
        Type.Int64 => "i64"
        Type.Int128 => "i128"
        Type.Float32 => "f32"
        Type.Float64 => "f64"
        Type.Int8x16 => "i8x16"
        Type.Int16x8 => "i16x8"
        Type.Int32x4 => "i32x4"
        Type.Int64x2 => "i64x2"
        Type.Float32x4 => "f32x4"
    }
} Type.name

/// The type of addresses and sizes.
pkg const POINTER: Type = Type.Int64

pkg struct Value derives Copy, Eq, Ord, Hash {
    pkg index: u32
} Value

pkg struct Block derives Copy, Eq, Ord, Hash {
    pkg index: u32
} Block

pkg struct Inst derives Copy, Eq, Ord, Hash {
    pkg index: u32
} Inst

pkg struct StackSlot derives Copy, Eq, Ord, Hash {
    pkg index: u32
} StackSlot

/// A function a function names, by its index among the function's imported functions.
pkg struct FuncRef derives Copy, Eq, Ord, Hash {
    pkg index: u32
} FuncRef

/// A signature a function names, by its index among the function's imported signatures.
pkg struct SigRef derives Copy, Eq, Ord, Hash {
    pkg index: u32
} SigRef

/// A symbol a function names, by its index among the function's global values.
pkg struct GlobalValue derives Copy, Eq, Ord, Hash {
    pkg index: u32
} GlobalValue

/// A variable of the function builder, by its index in declaration order.
pkg struct Variable derives Copy, Eq, Ord, Hash {
    pkg index: u32
} Variable

/// An integer comparison.
pkg enum IntCC derives Copy, Eq, Hash {
    Equal
    NotEqual
    SignedLessThan
    SignedGreaterThanOrEqual
    SignedGreaterThan
    SignedLessThanOrEqual
    UnsignedLessThan
    UnsignedGreaterThanOrEqual
    UnsignedGreaterThan
    UnsignedLessThanOrEqual
} IntCC

pkg proj fn IntCC.name(self) -> Str {
    return match self {
        IntCC.Equal => "eq"
        IntCC.NotEqual => "ne"
        IntCC.SignedLessThan => "slt"
        IntCC.SignedGreaterThanOrEqual => "sge"
        IntCC.SignedGreaterThan => "sgt"
        IntCC.SignedLessThanOrEqual => "sle"
        IntCC.UnsignedLessThan => "ult"
        IntCC.UnsignedGreaterThanOrEqual => "uge"
        IntCC.UnsignedGreaterThan => "ugt"
        IntCC.UnsignedLessThanOrEqual => "ule"
    }
} IntCC.name

/// A float comparison.
pkg enum FloatCC derives Copy, Eq, Hash {
    Ordered
    Unordered
    Equal
    NotEqual
    OrderedNotEqual
    UnorderedOrEqual
    LessThan
    LessThanOrEqual
    GreaterThan
    GreaterThanOrEqual
    UnorderedOrLessThan
    UnorderedOrLessThanOrEqual
    UnorderedOrGreaterThan
    UnorderedOrGreaterThanOrEqual
} FloatCC

pkg proj fn FloatCC.name(self) -> Str {
    return match self {
        FloatCC.Ordered => "ord"
        FloatCC.Unordered => "uno"
        FloatCC.Equal => "eq"
        FloatCC.NotEqual => "ne"
        FloatCC.OrderedNotEqual => "one"
        FloatCC.UnorderedOrEqual => "ueq"
        FloatCC.LessThan => "lt"
        FloatCC.LessThanOrEqual => "le"
        FloatCC.GreaterThan => "gt"
        FloatCC.GreaterThanOrEqual => "ge"
        FloatCC.UnorderedOrLessThan => "ult"
        FloatCC.UnorderedOrLessThanOrEqual => "ule"
        FloatCC.UnorderedOrGreaterThan => "ugt"
        FloatCC.UnorderedOrGreaterThanOrEqual => "uge"
    }
} FloatCC.name

/// How a function receives its parameters and gives its results.
pkg enum CallConv derives Copy, Eq, Hash {
    SystemV
    WindowsFastcall
} CallConv

pkg proj fn CallConv.name(self) -> Str {
    return match self {
        CallConv.SystemV => "system_v"
        CallConv.WindowsFastcall => "windows_fastcall"
    }
} CallConv.name

pkg struct AbiParam derives Copy, Eq, Hash {
    pkg value_type: Type
} AbiParam

pkg struct Signature derives Eq, Hash {
    pkg params: mem::List[AbiParam]
    pkg returns: mem::List[AbiParam]
    pkg call_conv: CallConv
} Signature

pkg fn Signature.new(call_conv: CallConv, alloc: mem::Alloc) -> Signature = Signature(params: mem::List[AbiParam].empty(alloc), returns: mem::List[AbiParam].empty(alloc), call_conv: call_conv)

/// What an access to memory may assume: that its address is aligned to its width, and that it
/// cannot fault.
pkg struct MemFlags derives Copy, Eq, Hash {
    pkg aligned: bool
    pkg notrap: bool
} MemFlags

/// The flags of an access that assumes nothing.
pkg fn MemFlags.new() -> MemFlags = MemFlags(aligned: false, notrap: false)

/// The flags of an access to memory lowered code owns: aligned, and unable to fault.
pkg fn MemFlags.owned() -> MemFlags = MemFlags(aligned: true, notrap: true)

/// The flags of an access unable to fault whose address may be unaligned.
pkg fn MemFlags.unaligned() -> MemFlags = MemFlags(aligned: false, notrap: true)

/// What a `trap` instruction reports: a user code.
pkg struct TrapCode derives Copy, Eq, Hash {
    pkg user: u8
} TrapCode

pkg enum AtomicRmwOp derives Copy, Eq, Hash {
    Add
    And
    Or
    Xor
    Xchg
} AtomicRmwOp

pkg proj fn AtomicRmwOp.name(self) -> Str {
    return match self {
        AtomicRmwOp.Add => "add"
        AtomicRmwOp.And => "and"
        AtomicRmwOp.Or => "or"
        AtomicRmwOp.Xor => "xor"
        AtomicRmwOp.Xchg => "xchg"
    }
} AtomicRmwOp.name

/// The source location an instruction carries, `DEFAULT_LOC` for none.
pkg struct SourceLoc derives Copy, Eq, Hash {
    pkg bits: u32
} SourceLoc

pkg const DEFAULT_LOC: SourceLoc = SourceLoc(bits: 0xFFFF_FFFF)

pkg fn SourceLoc.is_default(self) -> bool = self.bits == 0xFFFF_FFFF

pkg enum Opcode derives Copy, Eq, Hash {
    Iconst
    F32const
    F64const
    Iadd
    Isub
    Imul
    Ineg
    Udiv
    Sdiv
    Urem
    Srem
    Umulhi
    Smulhi
    Band
    Bor
    Bxor
    Bnot
    Ishl
    Ushr
    Sshr
    Rotr
    Clz
    Ctz
    Popcnt
    Bswap
    Umin
    Umax
    SaddSat
    UaddSat
    SsubSat
    UsubSat
    Icmp
    Select
    Uextend
    Sextend
    Ireduce
    Iconcat
    Isplit
    Bitcast
    UaddOverflow
    SaddOverflow
    UsubOverflow
    SsubOverflow
    UmulOverflow
    SmulOverflow
    Fadd
    Fsub
    Fmul
    Fdiv
    Sqrt
    Fabs
    Fneg
    Fcopysign
    Fmin
    Fmax
    Fcmp
    Fpromote
    Fdemote
    FcvtToSintSat
    FcvtToUintSat
    FcvtFromSint
    FcvtFromUint
    Splat
    Bitselect
    SwidenLow
    SwidenHigh
    IaddPairwise
    VanyTrue
    VallTrue
    VhighBits
    Load
    Store
    AtomicLoad
    AtomicStore
    AtomicRmw
    AtomicCas
    Fence
    StackAddr
    SymbolValue
    TlsValue
    FuncAddr
    GetFramePointer
    Call
    CallIndirect
    Return
    Jump
    Brif
    Trap
    StackSwitch
} Opcode

/// Whether the opcode ends its block.
pkg fn Opcode.is_terminator(self) -> bool {
    return match self {
        Opcode.Return or Opcode.Jump or Opcode.Brif or Opcode.Trap => true
        else => false
    }
} Opcode.is_terminator

/// Whether the opcode branches to blocks of its function.
pkg fn Opcode.is_branch(self) -> bool {
    return match self {
        Opcode.Jump or Opcode.Brif => true
        else => false
    }
} Opcode.is_branch

/// Whether the opcode's types vary with a controlling type.
fn Opcode.is_polymorphic(self) -> bool {
    return match self {
        Opcode.F32const or Opcode.F64const or Opcode.Fence or Opcode.Call or Opcode.Return or Opcode.Jump or Opcode.Trap => false
        else => true
    }
} Opcode.is_polymorphic

/// Whether the controlling type of a polymorphic opcode may be read from its designated operand.
fn Opcode.uses_typevar_operand(self) -> bool {
    return match self {
        Opcode.Iconst or Opcode.F32const or Opcode.F64const or Opcode.Uextend or Opcode.Sextend or Opcode.Ireduce or Opcode.Bitcast => false
        Opcode.Splat or Opcode.VhighBits => false
        Opcode.Fpromote or Opcode.Fdemote or Opcode.FcvtToSintSat or Opcode.FcvtToUintSat or Opcode.FcvtFromSint or Opcode.FcvtFromUint => false
        Opcode.Load or Opcode.AtomicLoad or Opcode.AtomicRmw or Opcode.Fence or Opcode.StackAddr or Opcode.SymbolValue or Opcode.TlsValue => false
        Opcode.FuncAddr or Opcode.GetFramePointer or Opcode.Call or Opcode.Return or Opcode.Jump or Opcode.Trap => false
        else => true
    }
} Opcode.uses_typevar_operand

/// Whether the controlling type of a polymorphic opcode is always its designated operand's type,
/// rather than its first result's.
fn Opcode.requires_typevar_operand(self) -> bool {
    return match self {
        Opcode.Icmp or Opcode.Iconcat or Opcode.Isplit or Opcode.Fcmp or Opcode.Store or Opcode.AtomicStore or Opcode.CallIndirect or Opcode.Brif => true
        Opcode.SwidenLow or Opcode.SwidenHigh or Opcode.VanyTrue or Opcode.VallTrue => true
        else => false
    }
} Opcode.requires_typevar_operand

