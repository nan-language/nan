//! Signed 128-bit integers in two's complement, for the values that exceed 64 bits.

/// A signed 128-bit integer: its high and low 64 bits in two's complement.
pkg struct Wide derives Copy, Eq, Hash {
    high: u64
    low: u64
} Wide

impl Wide: Ord

impl Wide: Render

/// 2^64 and 2^127 as floats.
const TWO_TO_64: f64 = 18_446_744_073_709_551_616.0

const TWO_TO_127: f64 = 170_141_183_460_469_231_731_687_303_715_884_105_728.0

/// The bit that is set exactly in a negative high word.
const SIGN: u64 = 0x8000_0000_0000_0000

pkg fn Wide.of_i64(value: i64) -> Wide {
    var high: u64 = 0
    if value < 0 {
        high = ~0u64
    }
    return Wide(high: high, low: value.to_bits())
} Wide.of_i64

pkg fn Wide.of_u64(value: u64) -> Wide = Wide(high: 0, low: value)

pkg fn Wide.zero() -> Wide = Wide(high: 0, low: 0)

pkg fn Wide.one() -> Wide = Wide(high: 0, low: 1)

/// The greatest value, 2^127 - 1.
pkg fn Wide.max() -> Wide = Wide(high: ~SIGN, low: ~0u64)

/// The least value, -2^127.
pkg fn Wide.min() -> Wide = Wide(high: SIGN, low: 0)

pkg fn Wide.is_negative(self) -> bool = (self.high & SIGN) != 0

pkg fn Wide.is_zero(self) -> bool = self.high == 0 and self.low == 0

/// The value when it fits in an `i64`.
pkg fn Wide.to_i64(self) -> Option[i64] {
    let low = i64.from_bits(self.low)
    if (self.high == 0 and low >= 0) or (self.high == ~0u64 and low < 0) {
        return Some(low)
    }
    return None
} Wide.to_i64

/// The value when it fits in a `u64`.
pkg fn Wide.to_u64(self) -> Option[u64] {
    if self.high == 0 {
        return Some(self.low)
    }
    return None
} Wide.to_u64

/// The low 64 bits.
pkg fn Wide.low_bits(self) -> u64 = self.low

/// The value converted to `f64`, rounded to nearest.
pkg fn Wide.to_f64(self) -> f64 {
    let Some(small) = self.to_i64() else {
        let magnitude = self.wrapping_abs()
        let value = f64.nearest(magnitude.high) * TWO_TO_64 + f64.nearest(magnitude.low)
        if self.is_negative() {
            return -value
        }
        return value
    }
    return f64.nearest(small)
} Wide.to_f64

/// A float truncated toward zero and clamped to the range, NaN giving 0.
pkg fn Wide.saturate_f64(value: f64) -> Wide {
    if value.is_nan() {
        return Wide.zero()
    }
    if value >= TWO_TO_127 {
        return Wide.max()
    }
    if value <= -TWO_TO_127 {
        return Wide.min()
    }
    let negative = value < 0.0
    var magnitude = value.abs()
    let high = u64.saturate(magnitude / TWO_TO_64)
    magnitude = magnitude - f64.nearest(high) * TWO_TO_64
    let result = Wide(high: high, low: u64.saturate(magnitude))
    if negative {
        return result.wrapping_neg()
    }
    return result
} Wide.saturate_f64

pkg fn Wide.cmp(self, other: Wide) -> core::Ordering limits pure, notrap, terminates {
    let left = self.high ^ SIGN
    let right = other.high ^ SIGN
    if left != right {
        return left.cmp(right)
    }
    return self.low.cmp(other.low)
} Wide.cmp

pkg fn Wide.min_of(self, other: Wide) -> Wide {
    if self.cmp(other) == core::Ordering.Greater {
        return other
    }
    return self
} Wide.min_of

pkg fn Wide.max_of(self, other: Wide) -> Wide {
    if self.cmp(other) == core::Ordering.Less {
        return other
    }
    return self
} Wide.max_of

pkg fn Wide.lt(self, other: Wide) -> bool = self.cmp(other) == core::Ordering.Less

pkg fn Wide.le(self, other: Wide) -> bool = self.cmp(other) != core::Ordering.Greater

pkg fn Wide.wrapping_add(self, other: Wide) -> Wide {
    let low = self.low.wrapping_add(other.low)
    var carry: u64 = 0
    if low < self.low {
        carry = 1
    }
    return Wide(high: self.high.wrapping_add(other.high).wrapping_add(carry), low: low)
} Wide.wrapping_add

pkg fn Wide.wrapping_neg(self) -> Wide = Wide(high: ~self.high, low: ~self.low).wrapping_add(Wide.one())

pkg fn Wide.wrapping_sub(self, other: Wide) -> Wide = self.wrapping_add(other.wrapping_neg())

pkg fn Wide.checked_add(self, other: Wide) -> Option[Wide] {
    let sum = self.wrapping_add(other)
    if self.is_negative() == other.is_negative() and sum.is_negative() != self.is_negative() {
        return None
    }
    return Some(sum)
} Wide.checked_add

pkg fn Wide.checked_sub(self, other: Wide) -> Option[Wide] {
    let difference = self.wrapping_sub(other)
    if self.is_negative() != other.is_negative() and difference.is_negative() != self.is_negative() {
        return None
    }
    return Some(difference)
} Wide.checked_sub

pkg fn Wide.checked_neg(self) -> Option[Wide] {
    if self == Wide.min() {
        return None
    }
    return Some(self.wrapping_neg())
} Wide.checked_neg

/// The magnitude, wrapping for the least value.
pkg fn Wide.wrapping_abs(self) -> Wide {
    if self.is_negative() {
        return self.wrapping_neg()
    }
    return self
} Wide.wrapping_abs

pkg fn Wide.checked_abs(self) -> Option[Wide] {
    if self.is_negative() {
        return self.checked_neg()
    }
    return Some(self)
} Wide.checked_abs

pkg fn Wide.signum(self) -> Wide {
    if self.is_negative() {
        return Wide.of_i64(-1)
    }
    if self.is_zero() {
        return Wide.zero()
    }
    return Wide.one()
} Wide.signum

/// The product of two magnitudes below 2^128, and whether it reached 2^128.
fn unsigned_mul(left: Wide, right: Wide) -> Overflow {
    let low = left.low.wide_mul(right.low)
    let cross_one = left.high.wide_mul(right.low)
    let cross_two = left.low.wide_mul(right.high)
    var overflowed = (left.high != 0 and right.high != 0) or cross_one.high != 0 or cross_two.high != 0
    let Some(middle) = cross_one.low.checked_add(cross_two.low) else {
        return Overflow(value: Wide(high: 0, low: low.low), overflowed: true)
    }
    let Some(high) = low.high.checked_add(middle) else {
        return Overflow(value: Wide(high: low.high.wrapping_add(middle), low: low.low), overflowed: true)
    }
    return Overflow(value: Wide(high: high, low: low.low), overflowed: overflowed)
} unsigned_mul

/// A result and whether computing it overflowed.
struct Overflow derives Copy {
    value: Wide
    overflowed: bool
} Overflow

pkg fn Wide.wrapping_mul(self, other: Wide) -> Wide {
    let product = unsigned_mul(self.wrapping_abs(), right: other.wrapping_abs()).value
    if self.is_negative() != other.is_negative() {
        return product.wrapping_neg()
    }
    return product
} Wide.wrapping_mul

pkg fn Wide.checked_mul(self, other: Wide) -> Option[Wide] {
    let Some(small_left) = self.to_i64() else {
        return wide_checked_mul(self, right: other)
    }
    let Some(small_right) = other.to_i64() else {
        return wide_checked_mul(self, right: other)
    }
    let product = small_left.wide_mul(small_right)
    return Some(Wide(high: product.high.to_bits(), low: product.low))
} Wide.checked_mul

fn wide_checked_mul(left: Wide, right: Wide) -> Option[Wide] {
    let product = unsigned_mul(left.wrapping_abs(), right: right.wrapping_abs())
    if product.overflowed {
        return None
    }
    let negative = left.is_negative() != right.is_negative()
    if negative {
        if product.value.high > SIGN or (product.value.high == SIGN and product.value.low != 0) {
            return None
        }
        return Some(product.value.wrapping_neg())
    }
    if product.value.is_negative() {
        return None
    }
    return Some(product.value)
} wide_checked_mul

/// The quotient and remainder of two magnitudes, the divisor not zero.
fn unsigned_divide(dividend: Wide, divisor: Wide) -> Division {
    if dividend.high == 0 and divisor.high == 0 {
        return Division(quotient: Wide.of_u64(dividend.low / divisor.low), remainder: Wide.of_u64(dividend.low % divisor.low))
    }
    var quotient = Wide.zero()
    var remainder = Wide.zero()
    for step in 0..<128u32 {
        let bit = 127 - step
        remainder = remainder.shift_left(1)
        if dividend.bit(bit) {
            remainder = Wide(high: remainder.high, low: remainder.low | 1)
        }
        if unsigned_le(divisor, right: remainder) {
            remainder = remainder.wrapping_sub(divisor)
            quotient = quotient.set_bit(bit)
        }
    }
    return Division(quotient: quotient, remainder: remainder)
} unsigned_divide

/// A quotient and its remainder.
struct Division derives Copy {
    quotient: Wide
    remainder: Wide
} Division

fn unsigned_le(left: Wide, right: Wide) -> bool {
    if left.high != right.high {
        return left.high < right.high
    }
    return left.low <= right.low
} unsigned_le

fn Wide.bit(self, index: u32) -> bool {
    if index >= 64 {
        return ((self.high >> (index - 64)) & 1) == 1
    }
    return ((self.low >> index) & 1) == 1
} Wide.bit

fn Wide.set_bit(self, index: u32) -> Wide {
    if index >= 64 {
        return Wide(high: self.high | (1u64 << (index - 64)), low: self.low)
    }
    return Wide(high: self.high, low: self.low | (1u64 << index))
} Wide.set_bit

/// The quotient rounded toward zero; none for a zero divisor or an overflow.
pkg fn Wide.checked_div_trunc(self, divisor: Wide) -> Option[Wide] {
    if divisor.is_zero() or (self == Wide.min() and divisor == Wide.of_i64(-1)) {
        return None
    }
    let division = unsigned_divide(self.wrapping_abs(), divisor: divisor.wrapping_abs())
    if self.is_negative() != divisor.is_negative() {
        return Some(division.quotient.wrapping_neg())
    }
    return Some(division.quotient)
} Wide.checked_div_trunc

/// The remainder of the quotient rounded toward zero, with the sign of the dividend.
pkg fn Wide.checked_rem_trunc(self, divisor: Wide) -> Option[Wide] {
    if divisor.is_zero() {
        return None
    }
    if self == Wide.min() and divisor == Wide.of_i64(-1) {
        return Some(Wide.zero())
    }
    let division = unsigned_divide(self.wrapping_abs(), divisor: divisor.wrapping_abs())
    if self.is_negative() {
        return Some(division.remainder.wrapping_neg())
    }
    return Some(division.remainder)
} Wide.checked_rem_trunc

/// The remainder that is at least 0 and below the divisor's magnitude.
pkg fn Wide.checked_rem_euclid(self, divisor: Wide) -> Option[Wide] {
    let Some(remainder) = self.checked_rem_trunc(divisor) else {
        return None
    }
    if remainder.is_negative() {
        return Some(remainder.wrapping_add(divisor.wrapping_abs()))
    }
    return Some(remainder)
} Wide.checked_rem_euclid

/// The quotient q with self = q * divisor + r and 0 <= r < |divisor|.
pkg fn Wide.checked_div_euclid(self, divisor: Wide) -> Option[Wide] {
    let Some(quotient) = self.checked_div_trunc(divisor) else {
        return None
    }
    let Some(remainder) = self.checked_rem_trunc(divisor) else {
        return None
    }
    if not remainder.is_negative() {
        return Some(quotient)
    }
    if divisor.is_negative() {
        return quotient.checked_add(Wide.one())
    }
    return quotient.checked_sub(Wide.one())
} Wide.checked_div_euclid

/// The bits moved toward the high end by `amount` below 128, the high ones dropped.
pkg fn Wide.shift_left(self, amount: u32) -> Wide {
    if amount == 0 {
        return self
    }
    if amount >= 128 {
        return Wide.zero()
    }
    if amount >= 64 {
        return Wide(high: self.low << (amount - 64), low: 0)
    }
    return Wide(high: (self.high << amount) | (self.low >> (64 - amount)), low: self.low << amount)
} Wide.shift_left

/// The bits moved toward the low end by `amount`, the sign bit copied in.
pkg fn Wide.shift_right(self, amount: u32) -> Wide {
    if amount == 0 {
        return self
    }
    var fill: u64 = 0
    if self.is_negative() {
        fill = ~0u64
    }
    if amount >= 128 {
        return Wide(high: fill, low: fill)
    }
    if amount >= 64 {
        let shift = amount - 64
        var low = self.high >> shift
        if shift > 0 {
            low = low | (fill << (64 - shift))
        }
        return Wide(high: fill, low: low)
    }
    let high = (self.high >> amount) | (fill << (64 - amount))
    return Wide(high: high, low: (self.low >> amount) | (self.high << (64 - amount)))
} Wide.shift_right

pkg fn Wide.bit_and(self, other: Wide) -> Wide = Wide(high: self.high & other.high, low: self.low & other.low)

pkg fn Wide.bit_or(self, other: Wide) -> Wide = Wide(high: self.high | other.high, low: self.low | other.low)

pkg fn Wide.bit_xor(self, other: Wide) -> Wide = Wide(high: self.high ^ other.high, low: self.low ^ other.low)

pkg fn Wide.bit_not(self) -> Wide = Wide(high: ~self.high, low: ~self.low)

/// The value of digits in `radix` from 2 to 16, each `_` skipped; none when a character is not a
/// digit of the radix or the value exceeds 2^127 - 1.
pkg fn Wide.parse(digits: Str, radix: u32) -> Option[Wide] {
    var value = Wide.zero()
    let base = Wide.of_u64(u64.widen(radix))
    var any = false
    for byte in digits.as_bytes() {
        if byte == b'_' {
            continue
        }
        let Some(digit) = digit_value(byte) else {
            return None
        }
        if digit >= radix {
            return None
        }
        let Some(scaled) = value.checked_mul(base) else {
            return None
        }
        let Some(next) = scaled.checked_add(Wide.of_u64(u64.widen(digit))) else {
            return None
        }
        value = next
        any = true
    }
    if not any {
        return None
    }
    return Some(value)
} Wide.parse

fn digit_value(byte: u8) -> Option[u32] {
    if byte >= b'0' and byte <= b'9' {
        return Some(u32.widen(byte - b'0'))
    }
    if byte >= b'a' and byte <= b'f' {
        return Some(u32.widen(byte - b'a') + 10)
    }
    if byte >= b'A' and byte <= b'F' {
        return Some(u32.widen(byte - b'A') + 10)
    }
    return None
} digit_value

/// Writes the value in decimal, a `-` before a negative one.
pkg fn Wide.render(self, mut out: core::Renderer) limits pure, terminates {
    if self.is_negative() {
        mut out.write("-")
    }
    let magnitude = self.wrapping_abs()
    let Some(small) = magnitude.to_u64() else {
        let chunk = Wide.of_u64(QUINTILLION)
        let upper = unsigned_divide(magnitude, divisor: chunk)
        let top = unsigned_divide(upper.quotient, divisor: chunk)
        if top.quotient.is_zero() {
            top.remainder.low.render(mut out)
        } else {
            top.quotient.low.render(mut out)
            padded(top.remainder.low, mut out)
        }
        padded(upper.remainder.low, mut out)
        return
    }
    small.render(mut out)
} Wide.render

/// 10^18, the decimal chunk of a rendering.
const QUINTILLION: u64 = 1_000_000_000_000_000_000

/// Writes a value below 10^18 as exactly 18 decimal digits.
fn padded(value: u64, mut out: core::Renderer) limits pure, terminates {
    var scale: u64 = 100_000_000_000_000_000
    for _ in 0..<18usize {
        if value >= scale or scale == 1 {
            break
        }
        mut out.write("0")
        scale = scale / 10
    }
    value.render(mut out)
} padded

test products_and_quotients for Wide.checked_mul {
    let big = Wide.of_u64(1u64 << 63)
    let Some(square) = big.checked_mul(big) else {
        expect false
        return
    }
    expect square == Wide(high: 1u64 << 62, low: 0)
    expect Wide.of_u64(~0u64).checked_mul(Wide.of_u64(~0u64)) == None
    expect Wide.max().checked_mul(Wide.of_i64(2)) == None
    expect Wide.of_i64(-7).checked_div_euclid(Wide.of_i64(2)) == Some(Wide.of_i64(-4))
    expect Wide.of_i64(-7).checked_rem_euclid(Wide.of_i64(2)) == Some(Wide.one())
    expect Wide.of_i64(-7).checked_div_trunc(Wide.of_i64(2)) == Some(Wide.of_i64(-3))
    expect square.checked_div_trunc(big) == Some(big)
} products_and_quotients
