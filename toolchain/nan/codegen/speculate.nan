//! Speculating short branches: a conditional branch whose arms run only constants, arithmetic, comparisons, conversions and selects into one join, except for branches to cold blocks that trap, computes both arms in its own block, branches to such a cold block only when the arm holding it is the one taken and its test sends it there, and passes the join the values its condition selects; the function is copied with the branches speculated. An arm divides only where selection shifts or masks, and multiplies only by a product x86-64 selects as one `lea`. A test of a trap that shares no operand with the comparisons the branch's condition combines branches alone, to a cold block that traps when the arm holding it is taken and goes on otherwise.

/// The most instructions the arms of a speculated branch hold together, besides their branches.
const SPECULATED_INSTS: usize = 16

/// How an arm of a conditional branch reaches its join: straight from the branch, passing the
/// branch's arguments, or through a chain of blocks only it reaches, each but the last branching
/// to a cold block that traps or jumping on to the next, the last jumping to the join.
struct Arm {
    blocks: mem::List[clif::Block]
    join: clif::Block
    args: mem::List[clif::Value]
} Arm

/// The branches a function speculates: the first of the two arms of the branch ending each block,
/// by block index, `NONE` for a block whose branch stays; the arms; and whether each block stays
/// in the copy.
struct Speculations {
    at: mem::List[u32]
    arms: mem::List[Arm]
    kept: mem::List[bool]
} Speculations

/// The function with its short branches speculated, or none when it speculates none or holds a
/// use before its definition in layout order; `leas` tells whether its products by 3, 5 and 9
/// are each one `lea`.
fn speculated(func: clif::Function, leas: bool, alloc: mem::Alloc) -> Option[clif::Function] {
    let Some(speculations) = speculations_of(func, leas, alloc) else {
        return None
    }
    var copier = Copier.speculating(func, take speculations, alloc)
    mut copier.copy_function(func, leaves: Leaves.empty(alloc))
    return take copier.finish()
} speculated

fn speculations_of(func: clif::Function, leas: bool, alloc: mem::Alloc) -> Option[Speculations] {
    let count = block_count(func, alloc)
    let preds = predecessor_counts(func, alloc)
    var found = Speculations(at: filled(count, value: NONE, alloc), arms: mem::List[Arm].empty(alloc), kept: filled(count, value: true, alloc))
    for block in func.layout_blocks(alloc) {
        let insts = func.block_insts(block, alloc)
        if func.is_cold(block) or insts.len() == 0 {
            continue
        }
        let clif::InstructionData.Brif(opcode: _, arg: _, then: then_call, otherwise: else_call) = func.inst_data(insts[insts.len() - 1]) else {
            continue
        }
        let Some(then_arm) = arm_of(func, call: then_call, preds: preds.view(), leas, alloc) else {
            continue
        }
        let Some(else_arm) = arm_of(func, call: else_call, preds: preds.view(), leas, alloc) else {
            continue
        }
        if not is_worth_speculating(then_arm, else_arm) {
            continue
        }
        if arm_insts(func, arm: then_arm, alloc) + arm_insts(func, arm: else_arm, alloc) > SPECULATED_INSTS {
            continue
        }
        mut found.claim(block, then_arm: take then_arm, else_arm: take else_arm)
    }
    if found.arms.len() == 0 {
        return None
    }
    return Some(take found)
} speculations_of

/// Whether two arms reach one join and speculating them leaves a select to compute.
fn is_worth_speculating(then_arm: Arm, else_arm: Arm) -> bool {
    if then_arm.join != else_arm.join {
        return false
    }
    return then_arm.blocks.len() > 0 or else_arm.blocks.len() > 0 or then_arm.args != else_arm.args
} is_worth_speculating

/// Records a branch speculated with its arms, the blocks of its arms leaving the copy.
fn Speculations.claim(mut self, block: clif::Block, take then_arm: Arm, take else_arm: Arm) {
    expect usize.widen(block.index) < self.at.len()
    self.at[usize.widen(block.index)] = u32.fit(self.arms.len())
    for arm_block in then_arm.blocks {
        self.kept[usize.widen(arm_block.index)] = false
    }
    for arm_block in else_arm.blocks {
        self.kept[usize.widen(arm_block.index)] = false
    }
    mut self.arms.push(take then_arm)
    mut self.arms.push(take else_arm)
} Speculations.claim

/// The arm a branch's edge starts, none when it holds an instruction other than those a
/// speculated arm may hold or a branch other than to a cold block that traps.
fn arm_of(func: clif::Function, call: clif::BlockCall, preds: Slice[u32], leas: bool, alloc: mem::Alloc) -> Option[Arm] {
    var current = call.block
    var blocks = mem::List[clif::Block].empty(alloc)
    loop {
        let at = usize.widen(current.index)
        expect at < preds.len()
        if (blocks.len() == 0 and call.args.len() > 0) or preds[at] != 1 or func.block_params(current, alloc).len() > 0 or func.is_cold(current) {
            if blocks.len() > 0 {
                return None
            }
            return Some(Arm(blocks: take blocks, join: current, args: copy_values(call.args.view(), alloc)))
        }
        let insts = func.block_insts(current, alloc)
        if insts.len() == 0 or not speculates(func, insts: insts.view(), leas, alloc) {
            return None
        }
        mut blocks.push(current)
        match func.inst_data(insts[insts.len() - 1]) {
            clif::InstructionData.Jump(opcode: _, destination: destination) => {
                if not continues(func, call: destination, preds, alloc) {
                    return Some(Arm(blocks: take blocks, join: destination.block, args: copy_values(destination.args.view(), alloc)))
                }
                current = destination.block
            }
            clif::InstructionData.Brif(opcode: _, arg: _, then: then_call, otherwise: else_call) => {
                let Some(next) = onward_of(func, then_call, else_call, preds, alloc) else {
                    return None
                }
                current = next
            }
            else => return None
        }
    }
} arm_of

/// Whether a jump goes on to a block that only it reaches, passing no arguments, which the arm
/// then holds.
fn continues(func: clif::Function, call: clif::BlockCall, preds: Slice[u32], alloc: mem::Alloc) -> bool {
    let at = usize.widen(call.block.index)
    expect at < preds.len()
    return call.args.len() == 0 and preds[at] == 1 and func.block_params(call.block, alloc).len() == 0 and not func.is_cold(call.block)
} continues

fn copy_values(values: Slice[clif::Value], alloc: mem::Alloc) -> mem::List[clif::Value] {
    var copied = mem::List[clif::Value].empty(alloc)
    for value in values {
        mut copied.push(value)
    }
    return copied
} copy_values

/// The block an arm goes on to from a branch one of whose edges goes to a cold block that traps
/// and the other, without arguments, to a block only it reaches.
fn onward_of(func: clif::Function, then_call: clif::BlockCall, else_call: clif::BlockCall, preds: Slice[u32], alloc: mem::Alloc) -> Option[clif::Block] {
    if then_call.args.len() > 0 or else_call.args.len() > 0 {
        return None
    }
    if is_trap_block(func, block: then_call.block, alloc) and not is_trap_block(func, block: else_call.block, alloc) {
        return Some(else_call.block)
    }
    if is_trap_block(func, block: else_call.block, alloc) and not is_trap_block(func, block: then_call.block, alloc) {
        return Some(then_call.block)
    }
    return None
} onward_of

/// Whether a block is cold and ends in a trap.
fn is_trap_block(func: clif::Function, block: clif::Block, alloc: mem::Alloc) -> bool {
    if not func.is_cold(block) or func.block_params(block, alloc).len() > 0 {
        return false
    }
    let insts = func.block_insts(block, alloc)
    if insts.len() == 0 {
        return false
    }
    return match func.inst_data(insts[insts.len() - 1]) {
        clif::InstructionData.Trap(opcode: _, code: _) => true
        else => false
    }
} is_trap_block

/// Whether a block's instructions before its terminator are all ones a speculated arm may hold:
/// those hoisting moves, except multiplications and divisions, whose latency would lengthen the
/// arm not taken, unless selection makes them one quick instruction.
fn speculates(func: clif::Function, insts: Slice[clif::Inst], leas: bool, alloc: mem::Alloc) -> bool {
    for index in 0..<insts.len() {
        let data = func.inst_data(insts[index])
        if index + 1 < insts.len() and (not is_hoistable(func, inst: insts[index], alloc) or (is_slow(data) and not is_quick(func, data, leas))) {
            return false
        }
    }
    return true
} speculates

/// Whether selection makes a multiplication or division one quick instruction: an unsigned
/// quotient or remainder by a power of two, a shift or a mask, or, when `leas`, a 64-bit
/// unsigned product by 3, 5 or 9 checked for overflow, a `lea`.
fn is_quick(func: clif::Function, data: clif::InstructionData, leas: bool) -> bool {
    let clif::InstructionData.Binary(opcode: opcode, x: x, y: y) = data else {
        return false
    }
    return match opcode {
        clif::Opcode.Udiv or clif::Opcode.Urem => match constant_of(func, value: y) {
            Some(divisor) => divisor != 0 and (divisor & (divisor - 1)) == 0
            None => false
        }
        clif::Opcode.UmulOverflow => leas and func.value_type(x).bits() == 64 and (is_lea_factor(func, value: x) or is_lea_factor(func, value: y))
        else => false
    }
} is_quick

/// Whether a value is the constant 3, 5 or 9.
fn is_lea_factor(func: clif::Function, value: clif::Value) -> bool {
    return match constant_of(func, value) {
        Some(factor) => factor == 3 or factor == 5 or factor == 9
        None => false
    }
} is_lea_factor

/// The bits of the constant an instruction gives a value, none for another value.
fn constant_of(func: clif::Function, value: clif::Value) -> Option[u64] {
    let Some(def) = func.value_inst(value) else {
        return None
    }
    let clif::InstructionData.UnaryImm(opcode: _, imm: imm) = func.inst_data(def) else {
        return None
    }
    return Some(imm.to_bits())
} constant_of

/// Whether an instruction multiplies or divides.
fn is_slow(data: clif::InstructionData) -> bool {
    return match data {
        clif::InstructionData.Binary(opcode: opcode, x: _, y: _) => opcode == clif::Opcode.Imul or opcode == clif::Opcode.UmulOverflow or opcode == clif::Opcode.SmulOverflow or opcode == clif::Opcode.Umulhi or opcode == clif::Opcode.Smulhi or opcode == clif::Opcode.Udiv or opcode == clif::Opcode.Sdiv or opcode == clif::Opcode.Urem or opcode == clif::Opcode.Srem or opcode == clif::Opcode.Fdiv
        clif::InstructionData.Unary(opcode: opcode, arg: _) => opcode == clif::Opcode.Sqrt
        else => false
    }
} is_slow

/// The instructions of an arm's blocks besides their terminators.
fn arm_insts(func: clif::Function, arm: Arm, alloc: mem::Alloc) -> usize {
    var count: usize = 0
    for block in arm.blocks {
        count += func.block_insts(block, alloc).len() - 1
    }
    return count
} arm_insts

/// The arms of the speculated branch ending a block, none for a block whose branch stays.
fn Speculations.arms_of(self, block: clif::Block) -> Option[u32] {
    let at = usize.widen(block.index)
    if at >= self.at.len() or self.at[at] == NONE {
        return None
    }
    return Some(self.at[at])
} Speculations.arms_of

fn Speculations.empty(alloc: mem::Alloc) -> Speculations = Speculations(at: mem::List[u32].empty(alloc), arms: mem::List[Arm].empty(alloc), kept: mem::List[bool].empty(alloc))

/// Copies a speculated branch: both arms' instructions, each branch of an arm to a cold block that
/// traps taken only when the arm is the one the condition picks, then a jump to the join passing
/// the values the condition selects.
fn Copier.copy_speculated(mut self, func: clif::Function, mut scope: Scope, c: clif::Value, first_arm: u32, leaves: Leaves) {
    let condition = mut self.value(scope, func, value: c)
    if self.lost {
        return
    }
    mut self.copy_arm(func, mut scope, c, condition, arm: first_arm, then: true, leaves)
    mut self.copy_arm(func, mut scope, c, condition, arm: first_arm + 1, then: false, leaves)
    if self.lost {
        return
    }
    let then_arm = self.speculations.arms[usize.widen(first_arm)]
    let else_arm = self.speculations.arms[usize.widen(first_arm) + 1]
    let direct = then_arm.blocks.len() == 0 and else_arm.blocks.len() == 0
    let join = then_arm.join
    let then_args = copy_values(then_arm.args.view(), alloc: self.alloc)
    let else_args = copy_values(else_arm.args.view(), alloc: self.alloc)
    expect then_args.len() == else_args.len()
    var passed = mem::List[clif::Value].empty(self.alloc)
    for index in 0..<then_args.len() {
        let chosen = mut self.value(scope, func, value: then_args[index])
        let other = mut self.value(scope, func, value: else_args[index])
        if chosen == other {
            mut passed.push(chosen)
        } else {
            mut passed.push(mut self.b.select(condition, x: chosen, y: other))
        }
    }
    if self.lost {
        return
    }
    let target = scope.block(join)
    mut self.b.jump(target, args: passed.view())
    mut self.reached(target)
    if not direct {
        mut self.reached(target)
    }
} Copier.copy_speculated

/// Copies the instructions of an arm of a speculated branch on `c`, copied as `condition`, each
/// of its branches to a cold block that traps taken only when the condition picks the arm,
/// `then` for the first arm.
fn Copier.copy_arm(mut self, func: clif::Function, mut scope: Scope, c: clif::Value, condition: clif::Value, arm: u32, then: bool, leaves: Leaves) {
    let blocks = self.speculations.arms[usize.widen(arm)].blocks
    var taken = NO_VALUE
    for block in blocks {
        let insts = func.block_insts(block, alloc: self.alloc)
        for index in 0..<(insts.len() - 1) {
            mut self.copy_inst(func, mut scope, inst: insts[index], leaves)
            if self.lost {
                return
            }
        }
        let clif::InstructionData.Brif(opcode: _, arg: arg, then: then_call, otherwise: else_call) = func.inst_data(insts[insts.len() - 1]) else {
            continue
        }
        if not shares_operand(func, c, arg, alloc: self.alloc) {
            mut self.guard_trap_cold(func, scope, condition, then, arg, then_call, else_call)
            continue
        }
        if taken == NO_VALUE {
            let picked = if then {
                clif::IntCC.NotEqual
            } else {
                clif::IntCC.Equal
            }
            taken = mut self.b.icmp_imm_s(picked, x: condition, y: 0)
        }
        mut self.guard_trap(func, scope, taken, arg, then_call, else_call)
    }
} Copier.copy_arm

/// A branch of a speculated arm to a cold block that traps, copied as a branch to it when the arm
/// is taken and its test sends it there, the copy going on in a new block otherwise.
fn Copier.guard_trap(mut self, func: clif::Function, scope: Scope, taken: clif::Value, arg: clif::Value, then_call: clif::BlockCall, else_call: clif::BlockCall) {
    let traps_then = is_trap_block(func, block: then_call.block, alloc: self.alloc)
    let Inverse(value: tested, inverted: inverted) = inverse_of(func, value: arg, alloc: self.alloc)
    let flag = mut self.value(scope, func, value: tested)
    if self.lost {
        return
    }
    var bad = flag
    if traps_then == inverted {
        bad = mut self.b.icmp_imm_s(clif::IntCC.Equal, x: flag, y: 0)
    } else if not inverted {
        bad = mut self.b.icmp_imm_s(clif::IntCC.NotEqual, x: flag, y: 0)
    }
    let sending = mut self.b.band(taken, y: bad)
    let trap = trap_target(scope, func, then_call, else_call, alloc: self.alloc)
    let next = mut self.new_block(predecessors: 1)
    let no_args = mem::List[clif::Value].empty(self.alloc)
    mut self.b.brif(sending, then: trap, then_args: no_args.view(), otherwise: next, otherwise_args: no_args.view())
    mut self.reached(trap)
    mut self.reached(next)
    mut self.b.switch_to_block(next)
} Copier.guard_trap

/// A branch of a speculated arm to a cold block that traps, copied as a branch on its test alone
/// to a cold block that goes on to the trap when `condition` picks the arm, `then` for the first,
/// and back to the copy otherwise, which goes on in a new block.
fn Copier.guard_trap_cold(mut self, func: clif::Function, scope: Scope, condition: clif::Value, then: bool, arg: clif::Value, then_call: clif::BlockCall, else_call: clif::BlockCall) {
    let traps_then = is_trap_block(func, block: then_call.block, alloc: self.alloc)
    let Inverse(value: tested, inverted: inverted) = inverse_of(func, value: arg, alloc: self.alloc)
    let flag = mut self.value(scope, func, value: tested)
    if self.lost {
        return
    }
    let trap = trap_target(scope, func, then_call, else_call, alloc: self.alloc)
    let picking = mut self.new_block(predecessors: 1)
    mut self.b.set_cold_block(picking)
    let next = mut self.new_block(predecessors: 2)
    let no_args = mem::List[clif::Value].empty(self.alloc)
    if traps_then == inverted {
        mut self.b.brif(flag, then: next, then_args: no_args.view(), otherwise: picking, otherwise_args: no_args.view())
    } else {
        mut self.b.brif(flag, then: picking, then_args: no_args.view(), otherwise: next, otherwise_args: no_args.view())
    }
    mut self.reached(picking)
    mut self.reached(next)
    mut self.b.switch_to_block(picking)
    if then {
        mut self.b.brif(condition, then: trap, then_args: no_args.view(), otherwise: next, otherwise_args: no_args.view())
    } else {
        mut self.b.brif(condition, then: next, then_args: no_args.view(), otherwise: trap, otherwise_args: no_args.view())
    }
    mut self.reached(trap)
    mut self.reached(next)
    mut self.b.switch_to_block(next)
} Copier.guard_trap_cold

/// The copy of the cold block that traps among a branch's two targets.
fn trap_target(scope: Scope, func: clif::Function, then_call: clif::BlockCall, else_call: clif::BlockCall, alloc: mem::Alloc) -> clif::Block {
    if is_trap_block(func, block: then_call.block, alloc) {
        return scope.block(then_call.block)
    }
    return scope.block(else_call.block)
} trap_target

/// Whether the operation or comparison whose flag an arm's branch on `arg` tests reads an operand
/// of a comparison that `c` combines through `band`, `bor` and `bxor`, as when `c` picks the arm
/// in which the operation cannot overflow; true when another instruction gives the flag.
fn shares_operand(func: clif::Function, c: clif::Value, arg: clif::Value, alloc: mem::Alloc) -> bool {
    let Inverse(value: tested, inverted: _) = inverse_of(func, value: arg, alloc)
    let Some(operation) = func.value_inst(tested) else {
        return true
    }
    let Some(operands) = operands_of(func, inst: operation) else {
        return true
    }
    let left = func.resolve_aliases(operands.x)
    let right = func.resolve_aliases(operands.y)
    var pending = mem::List[clif::Value].empty(alloc)
    mut pending.push(c)
    loop {
        let Some(value) = mut pending.pop() else {
            return false
        }
        let Some(def) = func.value_inst(value) else {
            continue
        }
        match func.inst_data(def) {
            clif::InstructionData.IntCompare(opcode: _, cond: _, x: cx, y: cy) or clif::InstructionData.FloatCompare(opcode: _, cond: _, x: cx, y: cy) => {
                let compared_x = func.resolve_aliases(cx)
                let compared_y = func.resolve_aliases(cy)
                if left == compared_x or left == compared_y or right == compared_x or right == compared_y {
                    return true
                }
            }
            clif::InstructionData.Binary(opcode: opcode, x: bx, y: by) => {
                if opcode == clif::Opcode.Band or opcode == clif::Opcode.Bor or opcode == clif::Opcode.Bxor {
                    mut pending.push(bx)
                    mut pending.push(by)
                }
            }
            else => {}
        }
    }
} shares_operand

/// The two operands of a binary operation or an integer comparison.
fn operands_of(func: clif::Function, inst: clif::Inst) -> Option[Operands] {
    return match func.inst_data(inst) {
        clif::InstructionData.Binary(opcode: _, x: x, y: y) or clif::InstructionData.IntCompare(opcode: _, cond: _, x: x, y: y) => Some(Operands(x: x, y: y))
        else => None
    }
} operands_of

/// A value a branch tests, and whether it tests that value's inverse.
struct Inverse derives Copy, Eq {
    value: clif::Value
    inverted: bool
} Inverse

/// The value a branch on `value` tests: the flag of a comparison or an overflowing operation a
/// `bxor` with 1 inverts when one defines it, else the value itself.
fn inverse_of(func: clif::Function, value: clif::Value, alloc: mem::Alloc) -> Inverse {
    let Some(def) = func.value_inst(value) else {
        return Inverse(value: value, inverted: false)
    }
    let clif::InstructionData.Binary(opcode: clif::Opcode.Bxor, x: x, y: y) = func.inst_data(def) else {
        return Inverse(value: value, inverted: false)
    }
    let Some(constant) = func.value_inst(y) else {
        return Inverse(value: value, inverted: false)
    }
    let clif::InstructionData.UnaryImm(opcode: _, imm: 1) = func.inst_data(constant) else {
        return Inverse(value: value, inverted: false)
    }
    if not is_zero_or_one(func, value: x, alloc) {
        return Inverse(value: value, inverted: false)
    }
    return Inverse(value: x, inverted: true)
} inverse_of

/// Whether a value is 0 or 1: a comparison's result or an overflowing operation's flag.
fn is_zero_or_one(func: clif::Function, value: clif::Value, alloc: mem::Alloc) -> bool {
    let Some(def) = func.value_inst(value) else {
        return false
    }
    return match func.inst_data(def) {
        clif::InstructionData.IntCompare(opcode: _, cond: _, x: _, y: _) or clif::InstructionData.FloatCompare(opcode: _, cond: _, x: _, y: _) => true
        clif::InstructionData.Binary(opcode: opcode, x: _, y: _) => is_overflow_check(opcode) and second_result_of(func, inst: def, alloc) == func.resolve_aliases(value)
        else => false
    }
} is_zero_or_one

fn is_overflow_check(opcode: clif::Opcode) -> bool {
    return match opcode {
        clif::Opcode.UaddOverflow or clif::Opcode.SaddOverflow or clif::Opcode.UsubOverflow or clif::Opcode.SsubOverflow or clif::Opcode.UmulOverflow or clif::Opcode.SmulOverflow => true
        else => false
    }
} is_overflow_check
