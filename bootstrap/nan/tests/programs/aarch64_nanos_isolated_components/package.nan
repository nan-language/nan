//! An AArch64 bare kernel holding instances of the components of nanos bundles in isolated spaces.

package aarch64_nanos_isolated_components {
    language 1
    targets aarch64-bare
    entry main
    dep gauges "./gauges"
    allow capability in aarch64_nanos_isolated_components
    allow device in aarch64_nanos_isolated_components
    allow trusted in aarch64_nanos_isolated_components
    allow validate in aarch64_nanos_isolated_components
} aarch64_nanos_isolated_components
