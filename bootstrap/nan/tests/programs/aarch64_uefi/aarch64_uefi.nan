//! Ends the firmware's boot services, writes a line to the PL011 under the entry root and runs a first kernel task on the CPUs the firmware left.

registers Pl011 {
    data: u8 at 0x0 write
} Pl011

fn say(text: Str) {
    var port = trusted "the virt board maps the PL011 at 0x0900_0000 and nothing else maps it" { hw::Mmio[Pl011].map(0x0900_0000) }
    for byte in text.as_bytes() {
        mut port.write(Pl011.data, value: byte)
    }
    take port.unmap()
} say

fn main(take m: boot::Machine) -> Never limits stack 16_384 {
    let k = take m.exit_services()
    say(text: "services ended\n")
    take k.anchor(0u8, run: fn(exec: task::Executor) limits stack 16_384 {
        say(text: "anchored\n")
    })
} main
