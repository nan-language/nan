//! The host root grant and the component runner.

pub open struct World derives Send {
    pub fs: sys::Fs
    pub net: sys::Net
    pub clock: sys::Clock
    pub random: sys::Random
    pub log: sys::Log
    pub stdio: sys::Stdio
    pub alloc: mem::Alloc
    pub exec: task::Executor
    pub args: Untrusted[mem::List[mem::Bytes]]
    pub environment: Untrusted[mem::Map[mem::Bytes, mem::Bytes]]
} World

pub open struct Runner[S] {
} Runner

pub fn Runner.run[Env: Any, M: Any, E](take env: Env, exec: task::Executor, alloc: mem::Alloc, body: fn(inbox: sys::Outbox[M]) fails E uses wait) -> S fails E uses wait

struct Tally derives Encode {
    total: u64
} Tally

struct TallyEnv {
} TallyEnv

impl Tally: sys::Component[TallyEnv, u32]

fn Tally.start(mut env: TallyEnv) -> Tally = Tally(total: 0)

fn Tally.on(mut self, take message: u32, mut env: TallyEnv, mut cx: sys::Cx[u32]) {
    self.total += u64.widen(message)
} Tally.on

test run_returns_the_final_state for Runner.run {
    let world = testing::world()
    let last = try await Runner[Tally].run(TallyEnv(), exec: world.exec, alloc: world.alloc, body: fn(inbox: sys::Outbox[u32]) fails task::SendError uses wait {
        try await inbox.post(3)
        try await inbox.post(4)
    })
    expect last.total == 7
} run_returns_the_final_state
