//! The canonical binary format.

pub open struct Codec[T: Encode] {
} Codec

pub fn Codec.encode(value: T, mut out: mem::Bytes)
    ensures out.len() >= old(out.len())

pub fn Codec.try_encode(value: T, mut out: mem::Bytes) fails mem::OutOfMemory
    ensures out.len() >= old(out.len())

pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    example attempt Codec[u16].decode(Untrusted.of(b"\xAC\x02"), alloc: testing::world().alloc) == Ok(300)
    example attempt Codec[u8].decode(Untrusted.of(b"\x05\x00"), alloc: testing::world().alloc) == Err(core::DecodeError.Trailing)

test encode_appends_a_uvar for Codec.encode {
    var out = mem::Bytes.zeroed(1, alloc: testing::world().alloc)
    Codec[u16].encode(300, mut out)
    expect out.len() == 3
    expect out[1] == 0xAC
    expect out[2] == 0x02
} encode_appends_a_uvar

test try_encode_leaves_out_unchanged_when_exhausted for Codec.try_encode {
    let budget = testing::world().alloc.split(65_536)
    var out = mem::Bytes.empty(budget.alloc())
    take budget.close()
    let encoded = attempt Codec[u16].try_encode(300, mut out)
    expect encoded.is_err()
    expect out.len() == 0
} try_encode_leaves_out_unchanged_when_exhausted
