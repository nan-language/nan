//! Base64 with padding (RFC 4648, section 4).

/// The char of the alphabet for a 6-bit value.
fn sextet_char(value: u32) -> char {
    if value == 62 {
        return '+'
    }
    if value == 63 {
        return '/'
    }
    var bits = value + 65
    if value >= 52 {
        bits = value - 4
    } else if value >= 26 {
        bits = value + 71
    }
    return char.checked_from_bits(bits).value_or('=')
} sextet_char

/// The 6-bit value of a byte of the alphabet, none for any other byte.
fn sextet_value(byte: u8) -> Option[u32] {
    let value = u32.widen(byte)
    if byte >= 65 and byte <= 90 {
        return Some(value - 65)
    }
    if byte >= 97 and byte <= 122 {
        return Some(value - 71)
    }
    if byte >= 48 and byte <= 57 {
        return Some(value + 4)
    }
    if byte == 43 {
        return Some(62)
    }
    if byte == 47 {
        return Some(63)
    }
    return None
} sextet_value

pub fn encode(bytes: Slice[u8], mut out: text::String) {
    var at: usize = 0
    while at < bytes.len() {
        let count = (bytes.len() - at).min(3)
        var group: u32 = 0
        for index in 0..<count {
            group = group | (u32.widen(bytes[at + index]) << (16 - 8 * u32.truncate(index)))
        }
        for index in 0u32..<4 {
            if usize.widen(index) <= count {
                mut out.push(sextet_char((group >> (18 - 6 * index)) & 63))
            } else {
                mut out.push('=')
            }
        }
        at += count
    }
} encode

pub validator fn decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes fails core::DecodeError {
    let text = raw.inspect()
    if text.len() % 4 != 0 {
        fail core::DecodeError.Malformed
    }
    var bytes = mem::Bytes.empty(alloc)
    var at: usize = 0
    while at < text.len() {
        var padding: usize = 0
        if at + 4 == text.len() and text[at + 3] == 61 {
            padding = 1
            if text[at + 2] == 61 {
                padding = 2
            }
        }
        var group: u32 = 0
        for index in 0..<(4 - padding) {
            let Some(value) = sextet_value(text[at + index]) else {
                fail core::DecodeError.Malformed
            }
            group = group | (value << (18 - 6 * u32.truncate(index)))
        }
        if (padding == 1 and (group & 0xFF) != 0) or (padding == 2 and (group & 0xFFFF) != 0) {
            fail core::DecodeError.Malformed
        }
        for index in 0..<(3 - padding) {
            mut bytes.push(u8.truncate(group >> (16 - 8 * u32.truncate(index))))
        }
        at += 4
    }
    return bytes
} decode

test encode_pads_the_last_group for encode {
    let world = testing::world()
    var out = text::String.empty(world.alloc)
    encode(b"Man", mut out)
    encode(b"Ma", mut out)
    encode(b"M", mut out)
    encode(b"", mut out)
    expect out.as_str() == "TWFuTWE=TQ=="
} encode_pads_the_last_group

test encode_uses_the_whole_alphabet for encode {
    let world = testing::world()
    var out = text::String.empty(world.alloc)
    encode(b"\x00\x10\x83\x10\x51\x87\x20\x92\x8b\x30\xd3\x8f\x41\x14\x93\x51\x55\x97\x61\x96\x9b\x71\xd7\x9f\x82\x18\xa3\x92\x59\xa7\xa2\x9a\xab\xb2\xdb\xaf\xc3\x1c\xb3\xd3\x5d\xb7\xe3\x9e\xbb\xf3\xdf\xbf", mut out)
    expect out.as_str() == "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
} encode_uses_the_whole_alphabet

test decode_reads_what_encode_writes for decode {
    let world = testing::world()
    let bytes = b"\x00\xffbase64\x7f"
    var out = text::String.empty(world.alloc)
    encode(bytes, mut out)
    let decoded = try decode(Untrusted.of(out.as_bytes()), alloc: world.alloc)
    expect decoded.view() == bytes
} decode_reads_what_encode_writes

test decode_rejects_text_encode_does_not_write for decode {
    let world = testing::world()
    let rejected_0 = attempt decode(Untrusted.of(b"TWE"), alloc: world.alloc)
    let rejected_1 = attempt decode(Untrusted.of(b"TWE=TQ=="), alloc: world.alloc)
    let rejected_2 = attempt decode(Untrusted.of(b"TR=="), alloc: world.alloc)
    let rejected_3 = attempt decode(Untrusted.of(b"TWF="), alloc: world.alloc)
    let rejected_4 = attempt decode(Untrusted.of(b"T==="), alloc: world.alloc)
    let rejected_5 = attempt decode(Untrusted.of(b"TW-="), alloc: world.alloc)
    expect rejected_0.is_err() and rejected_1.is_err() and rejected_2.is_err() and rejected_3.is_err() and rejected_4.is_err() and rejected_5.is_err()
} decode_rejects_text_encode_does_not_write
