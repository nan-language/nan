//! Tests of the encoder and the call standard: each instruction's bytes against those GNU `as` gives for it, the labels, tables and relocations of encoded code, and where signatures place values.

/// The bytes an instruction encodes as on its own.
fn encoded(inst: Inst, alloc: mem::Alloc) -> mem::Bytes {
    var asm = Assembler.new(alloc)
    mut asm.emit(inst)
    let Encoded(bytes: bytes, relocs: _) = take asm.finish()
    return bytes
} encoded

/// Expects an instruction alone to encode as `expected`.
fn encodes_as(inst: Inst, expected: Slice[u8], alloc: mem::Alloc) {
    let bytes = encoded(inst, alloc)
    expect bytes.view() == expected
} encodes_as

/// A symbol for relocations to name.
const EXTERNAL: machinst::Symbol = machinst::Symbol.Name(clif::ExternalName(namespace: 0, index: 7))

test encodes_moves_and_arithmetic_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.Mov(width: Width.Bits64, dst: X0, src: X1), expected: b"\xe0\x03\x01\xaa", alloc)
    encodes_as(Inst.Mov(width: Width.Bits64, dst: FP, src: LR), expected: b"\xfd\x03\x1e\xaa", alloc)
    encodes_as(Inst.Mov(width: Width.Bits64, dst: SP, src: X0), expected: b"\x1f\x00\x00\x91", alloc)
    encodes_as(Inst.Mov(width: Width.Bits64, dst: X0, src: SP), expected: b"\xe0\x03\x00\x91", alloc)
    encodes_as(Inst.Mov(width: Width.Bits32, dst: X0, src: X1), expected: b"\xe0\x03\x01\x2a", alloc)
    encodes_as(Inst.MovImm(dst: X0, imm: 0), expected: b"\x00\x00\x80\xd2", alloc)
    encodes_as(Inst.MovImm(dst: X1, imm: 0x1234), expected: b"\x81\x46\x82\xd2", alloc)
    encodes_as(Inst.MovImm(dst: X2, imm: 0xFFFF_0000), expected: b"\xe2\xff\xbf\xd2", alloc)
    encodes_as(Inst.MovImm(dst: xreg(3), imm: 0xABCD_0000_1234), expected: b"\x83\x46\x82\xd2\xa3\x79\xd5\xf2", alloc)
    encodes_as(Inst.MovImm(dst: xreg(4), imm: 0xFFFF_FFFF_FFFF_FFFF), expected: b"\x04\x00\x80\x92", alloc)
    encodes_as(Inst.MovImm(dst: xreg(5), imm: 0xFFFF_FFFF_FFFF_1234), expected: b"\x65\xb9\x9d\x92", alloc)
    encodes_as(Inst.MovImm(dst: xreg(6), imm: 0x5555_5555_5555_5555), expected: b"\xe6\xf3\x00\xb2", alloc)
    encodes_as(Inst.AddReg(width: Width.Bits64, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x00\x02\x8b", alloc)
    encodes_as(Inst.SubReg(width: Width.Bits32, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x00\x02\x4b", alloc)
    encodes_as(Inst.AddsReg(width: Width.Bits64, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x00\x02\xab", alloc)
    encodes_as(Inst.SubsReg(width: Width.Bits64, dst: X0, lhs: SP, rhs: X2), expected: b"\xe0\x03\x02\xeb", alloc)
    encodes_as(Inst.Adc(width: Width.Bits64, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x00\x02\x9a", alloc)
    encodes_as(Inst.Sbc(width: Width.Bits64, dst: X0, lhs: SP, rhs: X2), expected: b"\xe0\x03\x02\xda", alloc)
    encodes_as(Inst.Sbcs(width: Width.Bits64, dst: SP, lhs: X1, rhs: X2), expected: b"\x3f\x00\x02\xfa", alloc)
    encodes_as(Inst.AddImm(width: Width.Bits64, dst: X2, src: xreg(3), imm: 4095), expected: b"\x62\xfc\x3f\x91", alloc)
    encodes_as(Inst.AddImm(width: Width.Bits64, dst: X2, src: xreg(3), imm: 0x5000), expected: b"\x62\x14\x40\x91", alloc)
    encodes_as(Inst.SubImm(width: Width.Bits64, dst: SP, src: SP, imm: 16), expected: b"\xff\x43\x00\xd1", alloc)
    encodes_as(Inst.AddImm(width: Width.Bits64, dst: X0, src: SP, imm: 32), expected: b"\xe0\x83\x00\x91", alloc)
    encodes_as(Inst.Cmp(width: Width.Bits64, lhs: X0, rhs: X1), expected: b"\x1f\x00\x01\xeb", alloc)
    encodes_as(Inst.CmpImm(width: Width.Bits32, lhs: X0, imm: 10), expected: b"\x1f\x28\x00\x71", alloc)
    encodes_as(Inst.CmnImm(width: Width.Bits64, lhs: X0, imm: 1), expected: b"\x1f\x04\x00\xb1", alloc)
    encodes_as(Inst.Tst(width: Width.Bits64, lhs: X0, rhs: X1), expected: b"\x1f\x00\x01\xea", alloc)
    encodes_as(Inst.Logic(op: LogicOp.And, width: Width.Bits64, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x00\x02\x8a", alloc)
    encodes_as(Inst.Logic(op: LogicOp.Orr, width: Width.Bits32, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x00\x02\x2a", alloc)
    encodes_as(Inst.Logic(op: LogicOp.Eor, width: Width.Bits64, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x00\x02\xca", alloc)
    encodes_as(Inst.LogicImm(op: LogicOp.And, width: Width.Bits64, dst: X0, src: X1, imm: 0xFF), expected: b"\x20\x1c\x40\x92", alloc)
    encodes_as(Inst.LogicImm(op: LogicOp.Orr, width: Width.Bits32, dst: X0, src: X1, imm: 0x8000_0000), expected: b"\x20\x00\x01\x32", alloc)
    encodes_as(Inst.LogicImm(op: LogicOp.Eor, width: Width.Bits64, dst: X0, src: X1, imm: 0x7FFF_FFFF_FFFF_FFFF), expected: b"\x20\xf8\x40\xd2", alloc)
    encodes_as(Inst.LogicImm(op: LogicOp.Ands, width: Width.Bits32, dst: SP, src: X0, imm: 0xFFFF), expected: b"\x1f\x3c\x00\x72", alloc)
    encodes_as(Inst.LogicImm(op: LogicOp.And, width: Width.Bits64, dst: xreg(16), src: xreg(16), imm: 0xFFFF_FFFF_FFFF_FFE0), expected: b"\x10\xea\x7b\x92", alloc)
    encodes_as(Inst.LogicImm(op: LogicOp.And, width: Width.Bits64, dst: X0, src: X1, imm: 0x0F0F_0F0F_0F0F_0F0F), expected: b"\x20\xcc\x00\x92", alloc)
    encodes_as(Inst.Shift(kind: ShiftKind.Lsr, width: Width.Bits64, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x24\xc2\x9a", alloc)
    encodes_as(Inst.ShiftImm(kind: ShiftKind.Lsl, width: Width.Bits64, dst: X0, src: X1, amount: 3), expected: b"\x20\xf0\x7d\xd3", alloc)
    encodes_as(Inst.ShiftImm(kind: ShiftKind.Lsr, width: Width.Bits32, dst: X0, src: X1, amount: 16), expected: b"\x20\x7c\x10\x53", alloc)
    encodes_as(Inst.ShiftImm(kind: ShiftKind.Asr, width: Width.Bits64, dst: X0, src: X1, amount: 63), expected: b"\x20\xfc\x7f\x93", alloc)
    encodes_as(Inst.ShiftImm(kind: ShiftKind.Ror, width: Width.Bits32, dst: X0, src: X1, amount: 7), expected: b"\x20\x1c\x81\x13", alloc)
    encodes_as(Inst.Madd(width: Width.Bits64, dst: X0, lhs: X1, rhs: X2, addend: SP), expected: b"\x20\x7c\x02\x9b", alloc)
    encodes_as(Inst.Madd(width: Width.Bits32, dst: X0, lhs: X1, rhs: X2, addend: xreg(3)), expected: b"\x20\x0c\x02\x1b", alloc)
    encodes_as(Inst.Msub(width: Width.Bits64, dst: X0, lhs: X1, rhs: X2, minuend: xreg(3)), expected: b"\x20\x8c\x02\x9b", alloc)
    encodes_as(Inst.Sdiv(width: Width.Bits64, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x0c\xc2\x9a", alloc)
    encodes_as(Inst.Udiv(width: Width.Bits32, dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x08\xc2\x1a", alloc)
    encodes_as(Inst.Smulh(dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x7c\x42\x9b", alloc)
    encodes_as(Inst.Umulh(dst: X0, lhs: X1, rhs: X2), expected: b"\x20\x7c\xc2\x9b", alloc)
    encodes_as(Inst.Csel(cond: Cond.Lo, width: Width.Bits64, dst: X0, a: X1, b: X2), expected: b"\x20\x30\x82\x9a", alloc)
    encodes_as(Inst.Cset(cond: Cond.Eq, width: Width.Bits32, dst: X0), expected: b"\xe0\x17\x9f\x1a", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Sxtb, dst: X0, src: X1), expected: b"\x20\x1c\x40\x93", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Uxth, dst: X0, src: X1), expected: b"\x20\x3c\x00\x53", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Sxtw, dst: X0, src: X1), expected: b"\x20\x7c\x40\x93", alloc)
    encodes_as(Inst.Mvn(width: Width.Bits64, dst: X0, src: X1), expected: b"\xe0\x03\x21\xaa", alloc)
    encodes_as(Inst.Neg(width: Width.Bits32, dst: X0, src: X1), expected: b"\xe0\x03\x01\x4b", alloc)
    encodes_as(Inst.Clz(width: Width.Bits64, dst: X0, src: X1), expected: b"\x20\x10\xc0\xda", alloc)
    encodes_as(Inst.Rbit(width: Width.Bits32, dst: X0, src: X1), expected: b"\x20\x00\xc0\x5a", alloc)
    encodes_as(Inst.Rev(width: Width.Bits64, dst: X0, src: X1), expected: b"\x20\x0c\xc0\xda", alloc)
    encodes_as(Inst.Rev(width: Width.Bits32, dst: X0, src: X1), expected: b"\x20\x08\xc0\x5a", alloc)
} encodes_moves_and_arithmetic_as_gnu_as_does

test encodes_memory_accesses_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.Ldr(width: Width.Bits64, dst: X0, src: Amode.at(X1, disp: 8)), expected: b"\x20\x04\x40\xf9", alloc)
    encodes_as(Inst.Ldr(width: Width.Bits64, dst: X0, src: Amode.at(X1, disp: -8)), expected: b"\x20\x80\x5f\xf8", alloc)
    encodes_as(Inst.Ldr(width: Width.Bits64, dst: X0, src: Amode.at(X1, disp: 4)), expected: b"\x20\x40\x40\xf8", alloc)
    encodes_as(Inst.Str(width: Width.Bits64, src: xreg(3), dst: Amode.at(FP, disp: -24)), expected: b"\xa3\x83\x1e\xf8", alloc)
    encodes_as(Inst.Str(width: Width.Bits32, src: SP, dst: Amode.at(SP, disp: 0)), expected: b"\xff\x03\x00\xb9", alloc)
    encodes_as(Inst.Ldr(width: Width.Bits32, dst: X0, src: Amode.at(X1, disp: 4)), expected: b"\x20\x04\x40\xb9", alloc)
    encodes_as(Inst.Ldr(width: Width.Bits64, dst: X0, src: Amode.at(SP, disp: 32760)), expected: b"\xe0\xff\x7f\xf9", alloc)
    encodes_as(Inst.Ldr(width: Width.Bits64, dst: X0, src: Amode.Reg(base: X1, index: X2, scaled: false)), expected: b"\x20\x68\x62\xf8", alloc)
    encodes_as(Inst.Str(width: Width.Bits64, src: X0, dst: Amode.Reg(base: X1, index: X2, scaled: true)), expected: b"\x20\x78\x22\xf8", alloc)
    encodes_as(Inst.Str(width: Width.Bits32, src: SP, dst: Amode.Reg(base: SP, index: xreg(16), scaled: false)), expected: b"\xff\x6b\x30\xb8", alloc)
    encodes_as(Inst.LdrSized(kind: LoadKind.Byte, dst: X0, src: Amode.at(X1, disp: 0)), expected: b"\x20\x00\x40\x39", alloc)
    encodes_as(Inst.LdrSized(kind: LoadKind.Half, dst: X0, src: Amode.at(X1, disp: -2)), expected: b"\x20\xe0\x5f\x78", alloc)
    encodes_as(Inst.LdrSized(kind: LoadKind.SignWord, dst: X0, src: Amode.at(X1, disp: 4)), expected: b"\x20\x04\x80\xb9", alloc)
    encodes_as(Inst.StrSized(kind: StoreKind.Byte, src: X0, dst: Amode.Reg(base: X1, index: X2, scaled: false)), expected: b"\x20\x68\x22\x38", alloc)
    encodes_as(Inst.StrSized(kind: StoreKind.Half, src: X0, dst: Amode.at(X1, disp: 2)), expected: b"\x20\x04\x00\x79", alloc)
    encodes_as(Inst.LdrFloat(prec: Precision.Double, dst: vreg(0), src: Amode.at(X1, disp: 0)), expected: b"\x20\x00\x40\xfd", alloc)
    encodes_as(Inst.LdrFloat(prec: Precision.Double, dst: vreg(8), src: Amode.at(FP, disp: -88)), expected: b"\xa8\x83\x5a\xfc", alloc)
    encodes_as(Inst.StrFloat(prec: Precision.Single, src: vreg(0), dst: Amode.at(X1, disp: 4)), expected: b"\x20\x04\x00\xbd", alloc)
    encodes_as(Inst.Ldp(mode: PairMode.Signed, dst1: xreg(19), dst2: xreg(20), base: FP, imm: -16), expected: b"\xb3\x53\x7f\xa9", alloc)
    encodes_as(Inst.Stp(mode: PairMode.Pre, src1: FP, src2: LR, base: SP, imm: -16), expected: b"\xfd\x7b\xbf\xa9", alloc)
    encodes_as(Inst.Ldp(mode: PairMode.Post, dst1: FP, dst2: LR, base: SP, imm: 16), expected: b"\xfd\x7b\xc1\xa8", alloc)
    encodes_as(Inst.Ldar(size: Size.Double, dst: X0, base: X1), expected: b"\x20\xfc\xdf\xc8", alloc)
    encodes_as(Inst.Ldar(size: Size.Byte, dst: X0, base: X1), expected: b"\x20\xfc\xdf\x08", alloc)
    encodes_as(Inst.Stlr(size: Size.Word, src: X0, base: X1), expected: b"\x20\xfc\x9f\x88", alloc)
    encodes_as(Inst.Stlr(size: Size.Half, src: X0, base: X1), expected: b"\x20\xfc\x9f\x48", alloc)
    encodes_as(Inst.Dmb, expected: b"\xbf\x3b\x03\xd5", alloc)
} encodes_memory_accesses_as_gnu_as_does

test encodes_floating_point_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.FloatMov(prec: Precision.Double, dst: vreg(0), src: vreg(1)), expected: b"\x20\x40\x60\x1e", alloc)
    encodes_as(Inst.FloatFromInt(prec: Precision.Double, dst: vreg(0), src: X1), expected: b"\x20\x00\x67\x9e", alloc)
    encodes_as(Inst.FloatFromInt(prec: Precision.Single, dst: vreg(0), src: SP), expected: b"\xe0\x03\x27\x1e", alloc)
    encodes_as(Inst.IntFromFloat(prec: Precision.Double, dst: X0, src: vreg(1)), expected: b"\x20\x00\x66\x9e", alloc)
    encodes_as(Inst.FloatArith(op: FloatOp.Add, prec: Precision.Double, dst: vreg(0), lhs: vreg(1), rhs: vreg(2)), expected: b"\x20\x28\x62\x1e", alloc)
    encodes_as(Inst.FloatArith(op: FloatOp.Div, prec: Precision.Single, dst: vreg(0), lhs: vreg(1), rhs: vreg(2)), expected: b"\x20\x18\x22\x1e", alloc)
    encodes_as(Inst.FloatSqrt(prec: Precision.Double, dst: vreg(0), src: vreg(1)), expected: b"\x20\xc0\x61\x1e", alloc)
    encodes_as(Inst.FloatNeg(prec: Precision.Single, dst: vreg(0), src: vreg(1)), expected: b"\x20\x40\x21\x1e", alloc)
    encodes_as(Inst.FloatAbs(prec: Precision.Double, dst: vreg(0), src: vreg(1)), expected: b"\x20\xc0\x60\x1e", alloc)
    encodes_as(Inst.FloatCmp(prec: Precision.Double, lhs: vreg(0), rhs: vreg(1)), expected: b"\x00\x20\x61\x1e", alloc)
    encodes_as(Inst.FloatConvert(to: Precision.Single, dst: vreg(0), src: vreg(1)), expected: b"\x20\x40\x62\x1e", alloc)
    encodes_as(Inst.FloatConvert(to: Precision.Double, dst: vreg(0), src: vreg(1)), expected: b"\x20\xc0\x22\x1e", alloc)
    encodes_as(Inst.IntToFloat(signed: true, width: Width.Bits64, prec: Precision.Single, dst: vreg(0), src: X1), expected: b"\x20\x00\x22\x9e", alloc)
    encodes_as(Inst.IntToFloat(signed: false, width: Width.Bits32, prec: Precision.Double, dst: vreg(0), src: X1), expected: b"\x20\x00\x63\x1e", alloc)
    encodes_as(Inst.FloatToInt(signed: true, width: Width.Bits32, prec: Precision.Double, dst: X0, src: vreg(1)), expected: b"\x20\x00\x78\x1e", alloc)
    encodes_as(Inst.FloatToInt(signed: false, width: Width.Bits64, prec: Precision.Single, dst: X0, src: vreg(1)), expected: b"\x20\x00\x39\x9e", alloc)
    encodes_as(Inst.FloatCsel(cond: Cond.Ne, prec: Precision.Double, dst: vreg(0), a: vreg(1), b: vreg(2)), expected: b"\x20\x1c\x62\x1e", alloc)
    encodes_as(Inst.Cnt(dst: vreg(0), src: vreg(1)), expected: b"\x20\x58\x20\x0e", alloc)
    encodes_as(Inst.Addv(dst: vreg(0), src: vreg(1)), expected: b"\x20\xb8\x31\x0e", alloc)
} encodes_floating_point_as_gnu_as_does

test encodes_vector_instructions_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    let v1 = vreg(1)
    let v2 = vreg(2)
    let v3 = vreg(3)
    encodes_as(Inst.VecLoad(dst: v1, src: Amode.at(xreg(2), disp: 32)), expected: b"\x41\x08\xc0\x3d", alloc)
    encodes_as(Inst.VecLoad(dst: v1, src: Amode.at(xreg(2), disp: -16)), expected: b"\x41\x00\xdf\x3c", alloc)
    encodes_as(Inst.VecStore(src: v3, dst: Amode.at(SP, disp: 0)), expected: b"\xe3\x03\x80\x3d", alloc)
    encodes_as(Inst.VecMov(dst: vreg(4), src: vreg(5)), expected: b"\xa4\x1c\xa5\x4e", alloc)
    encodes_as(Inst.Vec3(op: VecOp.Add, size: 2, dst: v1, lhs: v2, rhs: v3), expected: b"\x41\x84\xa3\x4e", alloc)
    encodes_as(Inst.Vec3(op: VecOp.Mul, size: 1, dst: v1, lhs: v2, rhs: v3), expected: b"\x41\x9c\x63\x4e", alloc)
    encodes_as(Inst.Vec3(op: VecOp.Uqsub, size: 1, dst: v1, lhs: v2, rhs: v3), expected: b"\x41\x2c\x63\x6e", alloc)
    encodes_as(Inst.Vec3(op: VecOp.Cmhi, size: 0, dst: v1, lhs: v2, rhs: v3), expected: b"\x41\x34\x23\x6e", alloc)
    encodes_as(Inst.Vec3(op: VecOp.Sshl, size: 3, dst: v1, lhs: v2, rhs: v3), expected: b"\x41\x44\xe3\x4e", alloc)
    encodes_as(Inst.Vec3(op: VecOp.Eor, size: 2, dst: v1, lhs: v2, rhs: v3), expected: b"\x41\x1c\x23\x6e", alloc)
    encodes_as(Inst.Vec3(op: VecOp.Fmin, size: 2, dst: v1, lhs: v2, rhs: v3), expected: b"\x41\xf4\xa3\x4e", alloc)
    encodes_as(Inst.Vec3(op: VecOp.Fcmgt, size: 2, dst: v1, lhs: v2, rhs: v3), expected: b"\x41\xe4\xa3\x6e", alloc)
    encodes_as(Inst.Vec2(op: VecUnary.Cmeq0, size: 3, dst: v1, src: v2), expected: b"\x41\x98\xe0\x4e", alloc)
    encodes_as(Inst.Vec2(op: VecUnary.Fcvtzs, size: 2, dst: v1, src: v2), expected: b"\x41\xb8\xa1\x4e", alloc)
    encodes_as(Inst.Vec2(op: VecUnary.Sxtl, size: 0, dst: v1, src: v2), expected: b"\x41\xa4\x08\x0f", alloc)
    encodes_as(Inst.Vec2(op: VecUnary.Sxtl2, size: 1, dst: v1, src: v2), expected: b"\x41\xa4\x10\x4f", alloc)
    encodes_as(Inst.Bsl(dst: v1, lhs: v2, rhs: v3), expected: b"\x41\x1c\x63\x6e", alloc)
    encodes_as(Inst.Sdot(acc: v1, lhs: v2, rhs: v3), expected: b"\x41\x94\x83\x4e", alloc)
    encodes_as(Inst.Dup(size: 3, dst: v1, src: xreg(2)), expected: b"\x41\x0c\x08\x4e", alloc)
    encodes_as(Inst.DupLane(dst: v1, src: v2), expected: b"\x41\x04\x04\x4e", alloc)
    encodes_as(Inst.Umov(dst: xreg(1), src: v2, lane: 1), expected: b"\x41\x3c\x18\x4e", alloc)
    encodes_as(Inst.Ins(dst: v1, src: xreg(2), lane: 1), expected: b"\x41\x1c\x18\x4e", alloc)
} encodes_vector_instructions_as_gnu_as_does

test encodes_sequences_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.CanonNan(prec: Precision.Double, reg: vreg(0), temp: xreg(9)), expected: b"\x00\x20\x60\x1e\x67\x00\x00\x54\x09\xff\xef\xd2\x20\x01\x67\x9e", alloc)
    encodes_as(Inst.CanonNan(prec: Precision.Single, reg: vreg(1), temp: xreg(10)), expected: b"\x20\x20\x21\x1e\x67\x00\x00\x54\x0a\xf8\xaf\x52\x41\x01\x27\x1e", alloc)
    encodes_as(Inst.AtomicRmwLoop(op: AtomicOp.Add, size: Size.Double, addr: X0, operand: X1, old: X2, temp: xreg(3), status: xreg(4)), expected: b"\x02\xfc\x5f\xc8\x43\x00\x01\x8b\x03\xfc\x04\xc8\xa4\xff\xff\x35", alloc)
    encodes_as(Inst.AtomicRmwLoop(op: AtomicOp.Orr, size: Size.Byte, addr: X0, operand: X1, old: X2, temp: xreg(3), status: xreg(4)), expected: b"\x02\xfc\x5f\x08\x43\x00\x01\x2a\x03\xfc\x04\x08\xa4\xff\xff\x35", alloc)
    encodes_as(Inst.AtomicRmwLoop(op: AtomicOp.Xchg, size: Size.Word, addr: X0, operand: X1, old: X2, temp: xreg(3), status: xreg(4)), expected: b"\x02\xfc\x5f\x88\x01\xfc\x04\x88\xc4\xff\xff\x35", alloc)
    encodes_as(Inst.AtomicCasLoop(size: Size.Half, addr: X0, expected: X1, replacement: X2, old: xreg(3), status: xreg(4)), expected: b"\x03\xfc\x5f\x48\x7f\x00\x01\x6b\x61\x00\x00\x54\x02\xfc\x04\x48\x84\xff\xff\x35", alloc)
    encodes_as(Inst.TrapIfZero(width: Width.Bits64, reg: X1), expected: b"\x41\x00\x00\xb5\x1f\xc1\x00\x00", alloc)
    encodes_as(Inst.TrapIfOverflow(width: Width.Bits32, lhs: X0, rhs: X1), expected: b"\x3f\x04\x00\x31\x00\x08\x41\x7a\x47\x00\x00\x54\x1f\xc1\x00\x00", alloc)
    encodes_as(Inst.Udf, expected: b"\x1f\xc1\x00\x00", alloc)
    encodes_as(Inst.Ret(reg: LR), expected: b"\xc0\x03\x5f\xd6", alloc)
    encodes_as(Inst.Call(target: CallTarget.Indirect(X1), args: machinst::RegSet.empty(), results: machinst::RegSet.empty(), clobbers: caller_saved()), expected: b"\x20\x00\x3f\xd6", alloc)
    encodes_as(Inst.Address(dst: xreg(5), symbol: EXTERNAL, mode: AddressMode.Far), expected: b"\x45\x00\x00\x58\x03\x00\x00\x14\x00\x00\x00\x00\x00\x00\x00\x00", alloc)
} encodes_sequences_as_gnu_as_does

test branches_resolve_forward_and_backward_labels for Assembler.finish {
    let alloc = testing::world().alloc
    var asm = Assembler.new(alloc)
    let back = mut asm.new_label()
    mut asm.bind(back)
    mut asm.emit(Inst.Dmb)
    let fwd = mut asm.new_label()
    mut asm.emit(Inst.B(label: fwd))
    mut asm.emit(Inst.Cbz(width: Width.Bits64, reg: X0, label: back))
    mut asm.bind(fwd)
    mut asm.emit(Inst.Ret(reg: LR))
    let Encoded(bytes: bytes, relocs: _) = take asm.finish()
    expect bytes.view() == b"\xbf\x3b\x03\xd5\x02\x00\x00\x14\xc0\xff\xff\xb4\xc0\x03\x5f\xd6"
} branches_resolve_forward_and_backward_labels

test jump_tables_hold_their_targets_offsets_from_their_start for Assembler.table_entry {
    let alloc = testing::world().alloc
    var asm = Assembler.new(alloc)
    let target = mut asm.new_label()
    let table = mut asm.new_label()
    mut asm.emit(Inst.JumpTable(index: X1, base: X2, temp: xreg(3), table: table))
    mut asm.bind(target)
    mut asm.emit(Inst.Ret(reg: LR))
    let start = asm.offset()
    mut asm.bind(table)
    mut asm.table_entry(target, start)
    let Encoded(bytes: bytes, relocs: _) = take asm.finish()
    expect bytes.view() == b"\xa2\x00\x00\x10\x43\x78\xa1\xb8\x42\x00\x03\x8b\x40\x00\x1f\xd6\xc0\x03\x5f\xd6\xfc\xff\xff\xff"
} jump_tables_hold_their_targets_offsets_from_their_start

test symbols_are_reached_through_their_relocations for Assembler.emit {
    let alloc = testing::world().alloc
    var asm = Assembler.new(alloc)
    mut asm.emit(Inst.Call(target: CallTarget.Direct(EXTERNAL), args: machinst::RegSet.empty(), results: machinst::RegSet.empty(), clobbers: caller_saved()))
    mut asm.emit(Inst.Address(dst: X0, symbol: EXTERNAL, mode: AddressMode.Near))
    mut asm.emit(Inst.Address(dst: X1, symbol: EXTERNAL, mode: AddressMode.Got))
    mut asm.emit(Inst.Address(dst: X2, symbol: EXTERNAL, mode: AddressMode.Far))
    mut asm.emit(Inst.TlsDesc(symbol: EXTERNAL, temp: xreg(9)))
    let Encoded(bytes: bytes, relocs: relocs) = take asm.finish()
    expect bytes.view() == b"\x00\x00\x00\x94\x00\x00\x00\x90\x00\x00\x00\x91\x01\x00\x00\x90\x21\x00\x40\xf9\x42\x00\x00\x58\x03\x00\x00\x14\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x90\x09\x00\x40\xf9\x00\x00\x00\x91\x20\x01\x3f\xd6\x49\xd0\x3b\xd5\x00\x00\x09\x8b"
    expect relocs.len() == 10
    expect relocs[0].offset == 0 and relocs[0].kind == machinst::RelocKind.Arm64Call
    expect relocs[1].offset == 4 and relocs[1].kind == machinst::RelocKind.Arm64AdrPrel
    expect relocs[2].offset == 8 and relocs[2].kind == machinst::RelocKind.Arm64AddLo12
    expect relocs[3].offset == 12 and relocs[3].kind == machinst::RelocKind.Arm64AdrGotPage
    expect relocs[4].offset == 16 and relocs[4].kind == machinst::RelocKind.Arm64Ld64GotLo12
    expect relocs[5].offset == 28 and relocs[5].kind == machinst::RelocKind.Arm64Abs64
    expect relocs[6].offset == 36 and relocs[6].kind == machinst::RelocKind.Arm64TlsDescAdrPage
    expect relocs[7].offset == 40 and relocs[7].kind == machinst::RelocKind.Arm64TlsDescLd64Lo12
    expect relocs[8].offset == 44 and relocs[8].kind == machinst::RelocKind.Arm64TlsDescAddLo12
    expect relocs[9].offset == 48 and relocs[9].kind == machinst::RelocKind.Arm64TlsDescCall
} symbols_are_reached_through_their_relocations

test bitmask_immediates_are_rotated_runs_of_ones for bitmask {
    expect bitmask(0x00FF_00FF_00FF_00FF, width: Width.Bits64).is_some()
    expect bitmask(0x0000_0000_FFFF_FFF0, width: Width.Bits64).is_some()
    expect bitmask(0x1234, width: Width.Bits64).is_none()
    expect bitmask(0, width: Width.Bits64).is_none()
    expect bitmask(0xFFFF_FFFF, width: Width.Bits32).is_none()
    expect bitmask(0x1_0000_0000, width: Width.Bits32).is_none()
} bitmask_immediates_are_rotated_runs_of_ones

test places_parameters_and_results_under_the_call_standard for places {
    let alloc = testing::world().alloc
    var sig = clif::Signature.new(clif::CallConv.SystemV, alloc)
    for _ in 0u32..<9u32 {
        mut sig.params.push(clif::AbiParam(value_type: clif::Type.Int64))
    }
    mut sig.returns.push(clif::AbiParam(value_type: clif::Type.Int64))
    let placed = places(sig, alloc)
    expect placed.params.len() == 9
    expect placed.params[0] == Place.Reg(X0)
    expect placed.params[7] == Place.Reg(xreg(7))
    expect placed.params[8] == Place.Stack(0)
    expect placed.stack == 16
    expect placed.returns.len() == 1
    expect placed.returns[0] == Place.Reg(X0)
} places_parameters_and_results_under_the_call_standard

test places_128_bit_integers_in_even_register_pairs_or_aligned_on_the_stack for places {
    let alloc = testing::world().alloc
    var sig = clif::Signature.new(clif::CallConv.SystemV, alloc)
    mut sig.params.push(clif::AbiParam(value_type: clif::Type.Int64))
    mut sig.params.push(clif::AbiParam(value_type: clif::Type.Int128))
    for _ in 0u32..<3u32 {
        mut sig.params.push(clif::AbiParam(value_type: clif::Type.Int64))
    }
    mut sig.params.push(clif::AbiParam(value_type: clif::Type.Int128))
    mut sig.params.push(clif::AbiParam(value_type: clif::Type.Int64))
    let placed = places(sig, alloc)
    expect placed.params.len() == 9
    expect placed.params[0] == Place.Reg(X0)
    expect placed.params[1] == Place.Reg(X2)
    expect placed.params[2] == Place.Reg(xreg(3))
    expect placed.params[5] == Place.Reg(xreg(6))
    expect placed.params[6] == Place.Stack(0)
    expect placed.params[7] == Place.Stack(8)
    expect placed.params[8] == Place.Reg(xreg(7))
    expect placed.stack == 16
} places_128_bit_integers_in_even_register_pairs_or_aligned_on_the_stack

test places_floats_in_vector_registers for places {
    let alloc = testing::world().alloc
    var sig = clif::Signature.new(clif::CallConv.SystemV, alloc)
    mut sig.params.push(clif::AbiParam(value_type: clif::Type.Float64))
    mut sig.params.push(clif::AbiParam(value_type: clif::Type.Int64))
    let placed = places(sig, alloc)
    expect placed.params[0] == Place.Reg(vreg(0))
    expect placed.params[1] == Place.Reg(X0)
} places_floats_in_vector_registers
