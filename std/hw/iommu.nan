//! I/O domains: the machine's IOMMU, which translates the DMA of each PCI function through the domain it is attached to, its domains and their spaces, the mappings of DMA buffers in them, the DMA faults it records, and what settlement releases.

/// The kinds of IOMMU the runtime drives: Intel VT-d and Arm SMMUv3.
const VTD: u64 = 1

const SMMU: u64 = 2

/// The offsets of the unit record, a chunk the runtime's flush and interrupt routines read too:
/// its kind, register base, command queue, the queue's next entry, the interrupt remapping
/// table, its flags, then past the runtime's lock and wait words, its root table of contexts or
/// its stream table, the free table pages, what it translates, the DMAR table's remapping unit
/// on VT-d and the entries of its stream table on SMMUv3, its event queue on SMMUv3, and the
/// domain slots, each a domain record and a generation.
const UNIT_KIND: u64 = 0

const UNIT_REGISTERS: u64 = 8

const UNIT_QUEUE: u64 = 16

const UNIT_REMAPPING: u64 = 32

const UNIT_FLAGS: u64 = 40

const UNIT_STREAMS: u64 = 64

const UNIT_FREE: u64 = 72

const UNIT_COVERS: u64 = 80

const UNIT_EVENTS: u64 = 88

const UNIT_SLOTS: u64 = 128

const SLOTS: u64 = 256

const SLOT_BYTES: u64 = 16

/// The unit's flags: interrupt remapping in extended mode, reads and writes drained by an
/// invalidation, table walks that miss the caches, pass-through translation, and 2 MiB pages in
/// a domain's tables.
const EXTENDED_MODE: u64 = 1

const DRAIN_READS: u64 = 2

const DRAIN_WRITES: u64 = 4

const UNCOHERENT: u64 = 8

const PASS_THROUGH: u64 = 16

const LARGE_PAGES: u64 = 32

/// The tags of the records settlement receives, at offset 8 of each: a domain, a PCI function,
/// a mapping, a PCI port, a register window over a BAR and a PCI function's keeper. Every such
/// record holds its holding at offset 0.
const DOMAIN_TAG: u64 = 1

const FUNCTION_TAG: u64 = 2

const MAPPING_TAG: u64 = 3

const PORT_TAG: u64 = 4

const WINDOW_TAG: u64 = 5

const KEEPER_TAG: u64 = 6

const RECORD_HOLDING: u64 = 0

const RECORD_TAG: u64 = 8

/// The holding kinds settlement releases through `settled`.
const UNMAP: u64 = 9

const DETACH: u64 = 10

/// A domain record, a table page: its slot and its root table; its SMMU context descriptor from
/// `DOMAIN_CONTEXT`.
const DOMAIN_SLOT: u64 = 16

const DOMAIN_ROOT: u64 = 24

const DOMAIN_CONTEXT: u64 = 64

/// A mapping record: its space's key, its first address and its bytes.
const MAPPING_KEY: u64 = 16

const MAPPING_ADDRESS: u64 = 24

const MAPPING_BYTES: u64 = 32

const MAPPING_RECORD: u64 = 40

/// The bytes of a page, of a 2 MiB page, of a chunk, and of a cache line; the entries of a table
/// and the bits of an entry holding the next table or page.
const PAGE_BYTES: u64 = 4_096

const LARGE_BYTES: u64 = 2_097_152

const CHUNK: u64 = 65_536

const LINE_BYTES: u64 = 64

const ENTRIES: u64 = 512

const FRAME_MASK: u64 = 0x000F_FFFF_FFFF_F000

/// The bits of a present table entry, and of a present page entry: readable and writable on
/// VT-d; on SMMUv3 a page of normal memory, inner shareable, accessed, not global and
/// reachable by unprivileged requests, or such a page of device memory.
const TABLE_ENTRY: u64 = 0x3

const VTD_PAGE: u64 = 0x3

const SMMU_PAGE: u64 = 0xF43

const SMMU_DEVICE_PAGE: u64 = 0xF47

/// The bit of a level-2 entry telling a 2 MiB page from a table: VT-d's page size bit, set in the
/// page's entry; SMMUv3's table bit, clear in a block's.
const VTD_LARGE: u64 = 0x80

const SMMU_TABLE: u64 = 0x2

/// The key of the physical space.
const PHYSICAL_KEY: u64 = 0

/// The domain id of functions VT-d passes through, and the first one of a slot's domain.
const PASS_DOMAIN: u64 = 1

const FIRST_DOMAIN: u64 = 2

/// The registers of VT-d that the runtime reads and writes, with the global command bits it
/// sets: translation, the root table pointer, queued invalidation, interrupt remapping and the
/// remapping table pointer; the status bits that stay set across a command; and the
/// capability and extended capability bits it reads.
registers VtdRegisters {
    capability: u64 at 0x08 read
    extended: u64 at 0x10 read
    command: u32 at 0x18 write
    status: u32 at 0x1C read
    root: u64 at 0x20 read write
    queue_tail: u64 at 0x88 read write
    queue_address: u64 at 0x90 read write
    remapping: u64 at 0xB8 read write
    fault_status: u32 at 0x34 read write
    fault_control: u32 at 0x38 write
    fault_data: u32 at 0x3C write
    fault_address: u32 at 0x40 write
    fault_upper: u32 at 0x44 write
} VtdRegisters

const TRANSLATE: u32 = 0x8000_0000

const SET_ROOT: u32 = 0x4000_0000

const QUEUED: u32 = 0x0400_0000

const REMAP: u32 = 0x0200_0000

const SET_REMAPPING: u32 = 0x0100_0000

const KEPT_STATUS: u32 = 0x96FF_FFFF

const FOUR_LEVELS: u64 = 0x400

const PAGES_2M: u64 = 0x4_0000_0000

const DRAINS_READS: u64 = 0x80_0000_0000_0000

const DRAINS_WRITES: u64 = 0x40_0000_0000_0000

const COHERENT: u64 = 0x1

const QUEUES: u64 = 0x2

const REMAPS: u64 = 0x8

const EXTENDS: u64 = 0x10

const PASSES: u64 = 0x40

/// A fault recording register of VT-d: the page a fault reached, the requester id, and the fault
/// reason with the bit of a read and the bit of a recorded fault, which writing it clears.
registers FaultRecord {
    page: u64 at 0x0 read
    requester: u32 at 0x8 read
    reason: u32 at 0xC read write
} FaultRecord

/// VT-d's faults: the fault status's overflow bit and where its index of the first pending
/// record starts; where the capability's offset of the fault recording registers, in units of
/// 16 bytes, and their count less one start; a record's recorded and read bits; the reasons of
/// an access the domain does not let through: an address past its width, a write and a read; the
/// address of a message in the format without remapping, which fault events take, and where it
/// holds the destination id; where a remapped message's handle starts, which for CPU 0 is its
/// vector.
const FAULT_OVERFLOW: u32 = 0x1

const FIRST_RECORD: u32 = 8

const RECORDS_AT: u32 = 24

const RECORD_COUNT: u32 = 40

const RECORDED: u32 = 0x8000_0000

const READ_ACCESS: u32 = 0x4000_0000

const BEYOND_WIDTH: u32 = 4

const UNREADABLE: u32 = 6

const MSI_ADDRESS: u32 = 0xFEE0_0000

const DESTINATION: u32 = 12

const HANDLE: u32 = 5

/// The remapping table: 2^14 entries, one per CPU and vector, its size field, and the bit
/// selecting the extended mode.
const REMAPPING_CHUNKS: u64 = 4

const REMAPPING_SIZE: u64 = 13

const REMAPPING_EXTENDED: u64 = 0x800

/// The remapping structures of the DMAR table: where they start, the kinds of a remapping
/// unit and of a reserved memory region, the flag of a unit including every PCI function, and
/// the table flag saying the platform remaps interrupts; where a unit's device scopes start, the
/// kinds of an endpoint's scope, of a bridge's and of an I/O APIC's, and the length of one naming
/// a device of its start bus.
const DMAR_STRUCTURES: u64 = 48

const DMAR_SCOPES: u64 = 16

const ENDPOINT_SCOPE: u8 = 1

const BRIDGE_SCOPE: u8 = 2

const IOAPIC_SCOPE: u8 = 3

const ONE_HOP: u64 = 8

const DMAR_UNIT: u32 = 0

const DMAR_RESERVED: u32 = 1

const ALL_FUNCTIONS: u8 = 1

const REMAPS_INTERRUPTS: u8 = 1

/// The registers of SMMUv3 that the runtime reads and writes.
registers SmmuRegisters {
    identity0: u32 at 0x0 read
    identity1: u32 at 0x4 read
    identity5: u32 at 0x14 read
    control: u32 at 0x20 read write
    control_ack: u32 at 0x24 read
    control1: u32 at 0x28 read write
    bypass: u32 at 0x44 read write
    streams: u64 at 0x80 read write
    streams_config: u32 at 0x88 read write
    queue_base: u64 at 0x90 read write
    queue_produce: u32 at 0x98 read write
    queue_consume: u32 at 0x9C read write
    irq_control: u32 at 0x50 read write
    irq_control_ack: u32 at 0x54 read
    events_base: u64 at 0xA0 read write
    events_produce: u32 at 0x100A8 read write
    events_consume: u32 at 0x100AC read write
} SmmuRegisters

/// The identity bits SMMUv3 needs: stage 1, AArch64 tables, coherent table walks, 4 KiB pages,
/// and the stream id bits; the identity bit of two-level stream tables; the control bits
/// enabling it and its command queue; the bypass register's update and abort bits; the
/// read-allocate hint of a base register; inner shareable write-back tables and queues; a
/// command queue of 2^8 entries; the stream ids of a bus's functions, whose stream table
/// entries fill a level-2 table of a two-level stream table; its format and split, and the span
/// of a level-1 descriptor naming such a table; and the buses one chunk of a linear stream table
/// holds.
const STAGE1: u32 = 0x2

const AARCH64_TABLES: u32 = 0x8

const WALKS_COHERENT: u32 = 0x10

const TWO_LEVELS: u32 = 0x800_0000

const GRANULE_4K: u32 = 0x10

const ENABLED: u32 = 0x1

const COMMANDS: u32 = 0x8

const UPDATE: u32 = 0x8000_0000

const ABORT: u32 = 0x10_0000

const READ_ALLOCATE: u64 = 0x4000_0000_0000_0000

const SHARED_CACHED: u32 = 0xD75

const LOG2_ENTRIES: u64 = 8

const BUS_STREAMS: u64 = 256

const BUS_TABLE: u64 = 16_384

const TWO_LEVEL_FORMAT: u32 = 0x1_0000

const BUS_SPLIT: u32 = 0x200

const BUS_SPAN: u64 = 9

const LINEAR_BUSES: u64 = 4

/// SMMUv3's event queue: its control bit and interrupt enable; a queue of 2^7 entries of 32
/// bytes, a page, and the bits of its indices without and with their wrap bit; the overflow flag
/// its produce index toggles and its consume index acknowledges; the bit of an entry's second
/// word telling a read; the event types of an access the domain does not let through, from a
/// translation fault to a permission fault; and the bytes of an interrupt the device tree names,
/// a shared peripheral one's first cell being zero and its second its identifier less 32.
const EVENT_QUEUE: u32 = 0x4

const EVENT_IRQ: u32 = 0x4

const LOG2_EVENTS: u64 = 7

const EVENT_ENTRIES: u64 = 128

const EVENT_BYTES: u64 = 32

const EVENT_INDEX: u32 = 0x7F

const EVENT_WRAP: u32 = 0xFF

const EVENT_OVERFLOW: u32 = 0x8000_0000

const READ_EVENT: u64 = 0x8_0000_0000

const TRANSLATION_FAULT: u64 = 0x10

const PERMISSION_FAULT: u64 = 0x13

const INTERRUPT_BYTES: u64 = 12

const SPI_BASE: u64 = 32

/// A stream table entry's words: valid, then translated by stage 1 through one context
/// descriptor or bypassing translation; the inner shareable write-back walks of its second word.
const STREAM_BYTES: u64 = 64

const STREAM_TRANSLATED: u64 = 0xB

const STREAM_BYPASS: u64 = 0x9

const STREAM_WALKS: u64 = 0xD4

/// A context descriptor's first word, a 48-bit space of 4 KiB pages walked inner shareable
/// write-back, the upper table disabled, valid, AArch64 tables, recording and aborting faults,
/// its output size at `CONTEXT_SIZE` and its ASID at `CONTEXT_ASID`; its memory attributes,
/// index 0 normal write-back and index 1 device memory.
const CONTEXT_FIRST: u64 = 0x0000_E200_C000_3510

const CONTEXT_SIZE: u32 = 32

const CONTEXT_ASID: u32 = 48

const CONTEXT_ATTRIBUTES: u64 = 0xFF

/// The ITS page a message-signalled interrupt writes, which a domain's functions reach.
const ITS_PAGE: u64 = 0x0809_0000

/// The machine's IOMMU.
pub open linear struct Iommu derives Send {
} Iommu

/// A domain of the IOMMU, which a slot of the unit names.
pub open linear struct IoDomain derives Send {
    record: u64
} IoDomain

/// The addresses a function attached to a domain reaches, or physical memory.
pub open struct IoSpace derives Copy, Send {
    key: u64
} IoSpace

pub closed enum IommuError derives Copy, Eq, Render {
    Exhausted
    Physical
    Closed
    Grouped
    Unsupported
} IommuError

pub closed struct DmaFault derives Copy, Eq, Render {
    pub function: PciAddress
    pub address: u64
    pub write: bool
} DmaFault

pub fn Iommu.domain(self) -> IoDomain fails IommuError {
    let unit = iommu_unit()
    let flags = iommu_lock()
    var slot: u64 = SLOTS
    for index in 0..<SLOTS {
        let entry = unit + UNIT_SLOTS + index * SLOT_BYTES
        if slot == SLOTS and peek(entry) == 0 and peek(entry + 8) != 0xFFFF_FFFF {
            slot = index
        }
    }
    var record: u64 = 0
    var root: u64 = 0
    if slot != SLOTS {
        record = table_page(unit)
        root = table_page(unit)
    }
    if root == 0 {
        if record != 0 {
            free_page(unit, page: record)
        }
        iommu_unlock(flags)
        fail IommuError.Exhausted
    }
    let entry = unit + UNIT_SLOTS + slot * SLOT_BYTES
    poke(entry, value: record)
    poke(record + RECORD_TAG, value: DOMAIN_TAG)
    poke(record + DOMAIN_SLOT, value: slot)
    poke(record + DOMAIN_ROOT, value: root)
    if peek(unit + UNIT_KIND) == SMMU {
        let context = record + DOMAIN_CONTEXT
        let size = (peek(unit + UNIT_FLAGS) >> 8) & 0x7
        poke(context, value: CONTEXT_FIRST | (size << CONTEXT_SIZE) | ((slot + FIRST_DOMAIN) << CONTEXT_ASID))
        poke(context + 8, value: root)
        poke(context + 24, value: CONTEXT_ATTRIBUTES)
    }
    iommu_unlock(flags)
    poke(record + RECORD_HOLDING, value: hold(DETACH, payload: record))
    return IoDomain(record: record)
} Iommu.domain

pub fn Iommu.fault(self) -> Option[DmaFault] {
    let unit = iommu_unit()
    let flags = iommu_lock()
    var fault: Option[DmaFault] = None
    if peek(unit + UNIT_KIND) == VTD {
        fault = vtd_fault(unit)
    } else {
        fault = smmu_fault(unit)
    }
    iommu_unlock(flags)
    return fault
} Iommu.fault

pub fn Iommu.fault_irq[T: Any and Send](self, take dev: T, on_irq: interrupt fn(mut dev: T, take irq: IrqContext) -> IrqExit) -> Result[IrqShared[T], MsiRefusal[T]] {
    let unit = iommu_unit()
    if peek(unit + UNIT_KIND) == VTD {
        match IrqShared.install_validated(take dev, cpu: 0, source: 0, on_irq) {
            Ok(shared) => {
                match shared.message() {
                    Some(message) => vtd_signalled(unit, message: message.address)
                    None => {}
                }
                return Ok(take shared)
            }
            Err(refusal) => return Err(take refusal)
        }
    }
    let line = events_line()
    if line == 0 {
        return Err(MsiRefusal(dev: take dev, error: MsiError.Unsupported))
    }
    match IrqShared.install_line(take dev, line, source: 0, edge: true, active_low: false, on_irq) {
        Ok(shared) => {
            let flags = iommu_lock()
            var regs = trusted "the device tree names the SMMU's registers, which the entry root maps as device memory, and only the unit's lock holder maps them" { Mmio[SmmuRegisters].map(peek(unit + UNIT_REGISTERS)) }
            mut regs.write(SmmuRegisters.irq_control, value: EVENT_IRQ)
            while mut regs.read(SmmuRegisters.irq_control_ack) != EVENT_IRQ {
            }
            take regs.unmap()
            iommu_unlock(flags)
            return Ok(take shared)
        }
        Err(refusal) => return Err(take refusal)
    }
} Iommu.fault_irq

pub fn Iommu.release(take self) {
    let Iommu() = self
} Iommu.release

pub fn IoDomain.space(self) -> IoSpace {
    let unit = iommu_unit()
    let slot = peek(self.record + DOMAIN_SLOT)
    let generation = peek(unit + UNIT_SLOTS + slot * SLOT_BYTES + 8)
    return IoSpace(key: (slot + 1) | (generation << 32))
} IoDomain.space

pub fn IoDomain.close(take self) {
    let IoDomain(record: record) = self
    unhold(peek(record + RECORD_HOLDING))
    close_domain(record)
} IoDomain.close

pub fn IoSpace.physical() -> IoSpace {
    return IoSpace(key: PHYSICAL_KEY)
} IoSpace.physical

/// The unit record the runtime keeps, zero before `boot::Kernel.iommu` enables the IOMMU.
pkg fn iommu_unit() -> u64

/// Records the unit record of the enabled IOMMU.
pkg fn iommu_ready(unit: u64)

/// Takes the unit's lock with maskable interrupts disabled, giving the state to restore.
pkg fn iommu_lock() -> u64

pkg fn iommu_unlock(flags: u64)

/// Invalidates every context, translation and interrupt entry the unit caches, under its lock,
/// and waits until it has.
pkg fn iommu_flush()

/// `count` zeroed chunks of 64 KiB aligned to their size, zero when none is left.
pkg fn chunks(count: u64) -> u64

/// A zeroed runtime record of `bytes` bytes, trapping with `trap.exhausted` when none is left,
/// and its release.
pkg fn runtime_record(bytes: u64) -> u64

pkg fn free_record(address: u64)

/// A holding of a kind and payload, owned by the running task's domain, and its release.
pkg fn hold(kind: u64, payload: u64) -> u64

pkg fn unhold(holding: u64)

/// Writes the cache line holding an address back to memory.
pkg fn flush_line(address: u64)

/// Traps with `trap.exhausted`.
pkg fn exhausted() -> Never

/// Whether the local APICs run in x2APIC mode.
pkg fn x2apic() -> bool

/// The addresses of the ACPI root system description pointer and of the device tree the
/// platform gives, zero when none.
pkg fn rsdp_address() -> u64

pkg fn tree_address() -> u64

/// Whether the image runs on AArch64.
pkg fn on_aarch64() -> bool

/// The address of the entry root's top-level table.
pkg fn entry_root() -> u64

/// What `boot::Kernel.iommu` enables: the machine's IOMMU, with interrupt remapping on VT-d.
pkg fn started() -> Option[Iommu] {
    if on_aarch64() {
        return started_smmu()
    }
    return started_vtd()
} started

/// Maps the pages from `address` holding `bytes` bytes in a space's domain at their own
/// addresses, giving the mapping's record held for settlement; zero for the physical space.
/// A closed domain's space maps nothing.
pkg fn mapped(space: IoSpace, address: u64, bytes: u64) -> u64 {
    if space.key == PHYSICAL_KEY {
        return 0
    }
    let unit = iommu_unit()
    let flags = iommu_lock()
    let domain = live(unit, key: space.key)
    if domain != 0 {
        if not map_range(unit, domain, address, bytes, device: false) {
            unmap_range(unit, domain, address, bytes)
            iommu_unlock(flags)
            exhausted()
        }
        iommu_flush()
    }
    iommu_unlock(flags)
    let mapping = runtime_record(MAPPING_RECORD)
    poke(mapping + RECORD_TAG, value: MAPPING_TAG)
    poke(mapping + MAPPING_KEY, value: space.key)
    poke(mapping + MAPPING_ADDRESS, value: address)
    poke(mapping + MAPPING_BYTES, value: bytes)
    poke(mapping + RECORD_HOLDING, value: hold(UNMAP, payload: mapping))
    return mapping
} mapped

/// Ends a mapping `mapped` gave, waiting until the IOMMU no longer translates its pages.
pkg fn unmapped(mapping: u64) {
    unhold(peek(mapping + RECORD_HOLDING))
    end_mapping(mapping)
} unmapped

/// Releases what a holding of an abandoned domain holds: a mapping or a register window ends,
/// a domain is cut off from memory, a function too, handed back to its keeper where it has one,
/// and a keeper ends.
pkg fn settled(kind: u64, payload: u64) {
    let tag = peek(payload + RECORD_TAG)
    if kind == UNMAP {
        end_mapping(payload)
    } else if tag == DOMAIN_TAG {
        close_domain(payload)
    } else if tag == WINDOW_TAG {
        end_window(payload)
    } else if tag == KEEPER_TAG {
        keeper_ended(payload)
    } else if tag == FUNCTION_TAG {
        given_up(payload)
    }
} settled

/// Unmaps a mapping's pages when its domain is live, and frees its record.
fn end_mapping(mapping: u64) {
    let unit = iommu_unit()
    if unit != 0 {
        let flags = iommu_lock()
        let domain = live(unit, key: peek(mapping + MAPPING_KEY))
        if domain != 0 {
            unmap_range(unit, domain, address: peek(mapping + MAPPING_ADDRESS), bytes: peek(mapping + MAPPING_BYTES))
            iommu_flush()
        }
        iommu_unlock(flags)
    }
    free_record(mapping)
} end_mapping

/// Ends a domain: every function attached to it stops reaching memory, its slot takes a new
/// generation, and once the unit no longer caches its translations its tables are freed.
fn close_domain(record: u64) {
    let unit = iommu_unit()
    let flags = iommu_lock()
    let slot = peek(record + DOMAIN_SLOT)
    for bus in 0..<256u64 {
        let first_entry = bus_entries(unit, bus, create: false)
        if first_entry != 0 {
            for function in 0..<BUS_STREAMS {
                let entry = first_entry + function * entry_bytes(unit)
                if attached_domain(unit, entry) == slot + FIRST_DOMAIN {
                    clear_at(unit, entry)
                }
            }
        }
    }
    let entry = unit + UNIT_SLOTS + slot * SLOT_BYTES
    poke(entry, value: 0)
    poke(entry + 8, value: peek(entry + 8) + 1)
    iommu_flush()
    free_tables(unit, root: peek(record + DOMAIN_ROOT))
    free_page(unit, page: record)
    iommu_unlock(flags)
} close_domain

/// The record of the domain a space's key names, zero when the key is stale or names no slot.
fn live(unit: u64, key: u64) -> u64 {
    let slot = (key & 0xFFFF_FFFF).wrapping_sub(1)
    if slot >= SLOTS {
        return 0
    }
    let entry = unit + UNIT_SLOTS + slot * SLOT_BYTES
    if peek(entry + 8) != (key >> 32) {
        return 0
    }
    return peek(entry)
} live

/// The domain id a context or stream table entry reaches, zero when it reaches none: the
/// pass-through id, or a slot's plus `FIRST_DOMAIN`.
fn attached_domain(unit: u64, entry: u64) -> u64 {
    let head = peek(entry)
    if (head & 1) == 0 {
        return 0
    }
    if peek(unit + UNIT_KIND) == VTD {
        return (peek(entry + 8) >> 8) & 0xFFFF
    }
    if (head & 0xE) == (STREAM_BYPASS & 0xE) {
        return PASS_DOMAIN
    }
    let context = head & 0x000F_FFFF_FFFF_FFC0
    return peek(context - DOMAIN_CONTEXT + DOMAIN_SLOT) + FIRST_DOMAIN
} attached_domain

/// The bytes of a context entry or stream table entry.
fn entry_bytes(unit: u64) -> u64 {
    if peek(unit + UNIT_KIND) == VTD {
        return 16
    }
    return STREAM_BYTES
} entry_bytes

/// The first context or stream table entry of a bus's requesters, under the unit's lock,
/// adding the bus's context table on VT-d when `create` holds; zero when the unit has none or
/// no table page is left.
fn bus_entries(unit: u64, bus: u64, create: bool) -> u64 {
    let table = peek(unit + UNIT_STREAMS)
    if peek(unit + UNIT_KIND) == SMMU {
        if (bus + 1) * BUS_STREAMS > peek(unit + UNIT_COVERS) {
            return 0
        }
        return table + bus * BUS_STREAMS * STREAM_BYTES
    }
    let root = table + bus * 16
    if (peek(root) & 1) == 0 {
        if not create {
            return 0
        }
        let contexts = table_page(unit)
        if contexts == 0 {
            return 0
        }
        poke(root, value: contexts | 0x1)
        publish(unit, address: root, bytes: 16)
    }
    return peek(root) & FRAME_MASK
} bus_entries

/// A requester's context or stream table entry, as `bus_entries` gives its bus's.
fn requester_entry(unit: u64, requester: u64, create: bool) -> u64 {
    let first_entry = bus_entries(unit, bus: requester >> 8, create)
    if first_entry == 0 {
        return 0
    }
    return first_entry + (requester & 0xFF) * entry_bytes(unit)
} requester_entry

/// Points a requester's context or stream at a domain, or passes it through for zero, under
/// the unit's lock, the first word, holding the valid bit, written last; false when no table
/// page is left.
fn set_entry(unit: u64, requester: u64, domain: u64) -> bool {
    let entry = requester_entry(unit, requester, create: true)
    if entry == 0 {
        return false
    }
    if peek(unit + UNIT_KIND) == VTD {
        if domain == 0 {
            poke(entry + 8, value: 0x2 | (PASS_DOMAIN << 8))
            poke(entry, value: 0x9)
        } else {
            poke(entry + 8, value: 0x2 | ((peek(domain + DOMAIN_SLOT) + FIRST_DOMAIN) << 8))
            poke(entry, value: peek(domain + DOMAIN_ROOT) | 0x1)
        }
    } else if domain == 0 {
        poke(entry + 8, value: STREAM_WALKS)
        poke(entry, value: STREAM_BYPASS)
    } else {
        poke(entry + 8, value: STREAM_WALKS)
        poke(entry, value: (domain + DOMAIN_CONTEXT) | STREAM_TRANSLATED)
    }
    publish(unit, address: entry, bytes: 16)
    return true
} set_entry

/// Makes a requester's DMA reach nothing, under the unit's lock.
fn clear_entry(unit: u64, requester: u64) {
    let entry = requester_entry(unit, requester, create: false)
    if entry != 0 {
        clear_at(unit, entry)
    }
} clear_entry

/// Makes the DMA of every requester of a bus reach nothing, under the unit's lock.
fn clear_bus(unit: u64, bus: u64) {
    let first_entry = bus_entries(unit, bus, create: false)
    if first_entry != 0 {
        for function in 0..<BUS_STREAMS {
            clear_at(unit, entry: first_entry + function * entry_bytes(unit))
        }
    }
} clear_bus

fn clear_at(unit: u64, entry: u64) {
    poke(entry, value: 0)
    publish(unit, address: entry, bytes: 8)
} clear_at

/// Maps the pages of a range at their own addresses in a domain's tables, as device memory on
/// SMMUv3 when `device` holds, under the unit's lock, each 2 MiB-aligned 2 MiB of it through one
/// 2 MiB page where the unit has them, the table its level-2 entry held freed once the unit no
/// longer caches it; false when no table page is left.
fn map_range(unit: u64, domain: u64, address: u64, bytes: u64, device: bool) -> bool {
    var leaf = VTD_PAGE
    var large = VTD_PAGE | VTD_LARGE
    if peek(unit + UNIT_KIND) == SMMU {
        leaf = SMMU_PAGE
        if device {
            leaf = SMMU_DEVICE_PAGE
        }
        large = leaf & ~SMMU_TABLE
    }
    let root = peek(domain + DOMAIN_ROOT)
    let end = address + bytes
    var page = address & ~(PAGE_BYTES - 1)
    while page < end {
        if large_span(unit, page, end) {
            let entry = entry_at(unit, root, address: page, depth: 2, create: true)
            if entry == 0 {
                return false
            }
            let former = peek(entry)
            poke(entry, value: page | large)
            publish(unit, address: entry, bytes: 8)
            if (former & 1) != 0 {
                iommu_flush()
                free_page(unit, page: former & FRAME_MASK)
            }
            page += LARGE_BYTES
        } else {
            let entry = entry_at(unit, root, address: page, depth: 3, create: true)
            if entry == 0 {
                return false
            }
            poke(entry, value: page | leaf)
            publish(unit, address: entry, bytes: 8)
            page += PAGE_BYTES
        }
    }
    return true
} map_range

/// Unmaps the pages of a range in a domain's tables, under the unit's lock.
fn unmap_range(unit: u64, domain: u64, address: u64, bytes: u64) {
    let root = peek(domain + DOMAIN_ROOT)
    let end = address + bytes
    var page = address & ~(PAGE_BYTES - 1)
    while page < end {
        if large_span(unit, page, end) {
            let entry = entry_at(unit, root, address: page, depth: 2, create: false)
            if entry != 0 and large_entry(unit, value: peek(entry)) {
                poke(entry, value: 0)
                publish(unit, address: entry, bytes: 8)
            }
            page += LARGE_BYTES
        } else {
            let entry = entry_at(unit, root, address: page, depth: 3, create: false)
            if entry != 0 {
                poke(entry, value: 0)
                publish(unit, address: entry, bytes: 8)
            }
            page += PAGE_BYTES
        }
    }
} unmap_range

/// Whether the 2 MiB from a page start at a 2 MiB boundary, lie before `end` and map through one
/// 2 MiB page of the unit.
fn large_span(unit: u64, page: u64, end: u64) -> bool {
    return (peek(unit + UNIT_FLAGS) & LARGE_PAGES) != 0 and (page & (LARGE_BYTES - 1)) == 0 and end - page >= LARGE_BYTES
} large_span

/// Whether a present level-2 entry maps a 2 MiB page rather than a table.
fn large_entry(unit: u64, value: u64) -> bool {
    if peek(unit + UNIT_KIND) == VTD {
        return (value & VTD_LARGE) != 0
    }
    return (value & SMMU_TABLE) == 0
} large_entry

/// The address of the entry at `depth` of a four-level table from `root` for an address, the
/// last-level entry of its page at depth 3 and the level-2 entry of its 2 MiB at depth 2,
/// adding the missing tables above it when `create` holds; zero when one is missing or no table
/// page is left.
fn entry_at(unit: u64, root: u64, address: u64, depth: u32, create: bool) -> u64 {
    var table = root
    for level in 0u32..<depth {
        let entry = table + ((address >> (39 - 9 * level)) & (ENTRIES - 1)) * 8
        var next = peek(entry)
        if (next & 1) == 0 {
            if not create {
                return 0
            }
            next = table_page(unit)
            if next == 0 {
                return 0
            }
            poke(entry, value: next | TABLE_ENTRY)
            publish(unit, address: entry, bytes: 8)
        }
        table = next & FRAME_MASK
    }
    return table + ((address >> (39 - 9 * depth)) & (ENTRIES - 1)) * 8
} entry_at

/// Frees the tables of a four-level table from `root`, under the unit's lock.
fn free_tables(unit: u64, root: u64) {
    for index in 0..<ENTRIES {
        let entry = peek(root + index * 8)
        if (entry & 1) != 0 {
            free_middle(unit, table: entry & FRAME_MASK, levels: 2)
        }
    }
    free_page(unit, page: root)
} free_tables

/// Frees a table holding `levels` levels of tables below it, and those tables.
fn free_middle(unit: u64, table: u64, levels: u64) {
    if levels != 0 {
        for index in 0..<ENTRIES {
            let entry = peek(table + index * 8)
            if (entry & 1) != 0 {
                free_leaves(unit, table: entry & FRAME_MASK, levels: levels - 1)
            }
        }
    }
    free_page(unit, page: table)
} free_middle

fn free_leaves(unit: u64, table: u64, levels: u64) {
    if levels != 0 {
        for index in 0..<ENTRIES {
            let entry = peek(table + index * 8)
            if (entry & 1) != 0 and not large_entry(unit, value: entry) {
                free_page(unit, page: entry & FRAME_MASK)
            }
        }
    }
    free_page(unit, page: table)
} free_leaves

/// A zeroed table page the hardware sees as zeroed, drawn from the unit's free pages or from a
/// new chunk; zero when none is left. The caller holds the unit's lock.
fn table_page(unit: u64) -> u64 {
    var page = peek(unit + UNIT_FREE)
    if page != 0 {
        poke(unit + UNIT_FREE, value: peek(page))
        poke(page, value: 0)
    } else {
        page = chunks(1)
        if page == 0 {
            return 0
        }
        var rest = page + PAGE_BYTES
        while rest < page + CHUNK {
            free_page(unit, page: rest)
            rest += PAGE_BYTES
        }
    }
    publish(unit, address: page, bytes: PAGE_BYTES)
    return page
} table_page

/// Returns a page to the unit's free pages, zeroed but for the link in its first word.
fn free_page(unit: u64, page: u64) {
    for index in 1..<ENTRIES {
        poke(page + index * 8, value: 0)
    }
    poke(page, value: peek(unit + UNIT_FREE))
    poke(unit + UNIT_FREE, value: page)
} free_page

/// Writes the lines of a range back to memory when the unit's table walks miss the caches.
fn publish(unit: u64, address: u64, bytes: u64) {
    if (peek(unit + UNIT_FLAGS) & UNCOHERENT) == 0 {
        return
    }
    var line = address & ~(LINE_BYTES - 1)
    while line < address + bytes {
        flush_line(line)
        line += LINE_BYTES
    }
} publish

/// Enables VT-d: the remapping unit of the DMAR table, when it is the only one, the table lists
/// no reserved memory region, and the unit remaps interrupts, queues invalidations and walks
/// four-level tables. Every function's DMA then reaches nothing until it is attached,
/// and interrupts reach CPUs only through the remapping table.
fn started_vtd() -> Option[Iommu] {
    let drhd = vtd_unit()
    if drhd == 0 {
        return None
    }
    let base = u64_at(drhd + 8)
    var regs = trusted "the DMAR table names the remapping unit's registers, which the entry root maps uncached, and nothing else maps them" { Mmio[VtdRegisters].map(base) }
    let caps = mut regs.read(VtdRegisters.capability)
    let features = mut regs.read(VtdRegisters.extended)
    let needed = QUEUES | REMAPS
    if (features & needed) != needed or (caps & FOUR_LEVELS) == 0 {
        take regs.unmap()
        return None
    }
    let unit = chunks(1)
    let remapping = chunks(REMAPPING_CHUNKS)
    if unit == 0 or remapping == 0 {
        take regs.unmap()
        return None
    }
    var flags: u64 = 0
    if (features & EXTENDS) != 0 and x2apic() {
        flags |= EXTENDED_MODE
    }
    if (caps & DRAINS_READS) != 0 {
        flags |= DRAIN_READS
    }
    if (caps & DRAINS_WRITES) != 0 {
        flags |= DRAIN_WRITES
    }
    if (features & COHERENT) == 0 {
        flags |= UNCOHERENT
    }
    if (features & PASSES) != 0 {
        flags |= PASS_THROUGH
    }
    if (caps & PAGES_2M) != 0 {
        flags |= LARGE_PAGES
    }
    poke(unit + UNIT_KIND, value: VTD)
    poke(unit + UNIT_REGISTERS, value: base)
    poke(unit + UNIT_REMAPPING, value: remapping)
    poke(unit + UNIT_FLAGS, value: flags)
    poke(unit + UNIT_COVERS, value: drhd)
    let root = table_page(unit)
    poke(unit + UNIT_QUEUE, value: table_page(unit))
    poke(unit + UNIT_STREAMS, value: root)
    publish(unit, address: remapping, bytes: REMAPPING_CHUNKS * CHUNK)
    mut regs.write(VtdRegisters.root, value: root)
    vtd_command(mut regs, bit: SET_ROOT)
    mut regs.write(VtdRegisters.queue_tail, value: 0)
    mut regs.write(VtdRegisters.queue_address, value: peek(unit + UNIT_QUEUE))
    vtd_command(mut regs, bit: QUEUED)
    iommu_ready(unit)
    var remapped = remapping | REMAPPING_SIZE
    if (flags & EXTENDED_MODE) != 0 {
        remapped |= REMAPPING_EXTENDED
    }
    mut regs.write(VtdRegisters.remapping, value: remapped)
    vtd_command(mut regs, bit: SET_REMAPPING)
    let held = iommu_lock()
    iommu_flush()
    iommu_unlock(held)
    vtd_command(mut regs, bit: REMAP)
    vtd_command(mut regs, bit: TRANSLATE)
    take regs.unmap()
    return Some(Iommu())
} started_vtd

/// Sets a bit of VT-d's global command, keeping the persistent ones its status reports, and
/// waits until its status reports it.
fn vtd_command(mut regs: Mmio[VtdRegisters], bit: u32) {
    let status = mut regs.read(VtdRegisters.status) & KEPT_STATUS
    mut regs.write(VtdRegisters.command, value: status | bit)
    while (mut regs.read(VtdRegisters.status) & bit) == 0 {
    }
} vtd_command

/// The DMAR table's one remapping unit when it lies in segment 0, the table lists no reserved
/// memory region and the platform remaps interrupts; zero otherwise.
fn vtd_unit() -> u64 {
    let dmar = listed_table(0x5241_4D44)
    if dmar == 0 or (byte_at(dmar + 37) & REMAPS_INTERRUPTS) == 0 {
        return 0
    }
    let end = dmar + u64.widen(u32_at(dmar + 4))
    var at = dmar + DMAR_STRUCTURES
    var unit: u64 = 0
    var units: u32 = 0
    while at + 4 <= end {
        let kind = u32_at(at) & 0xFFFF
        let length = u64.widen(u32_at(at) >> 16)
        if length == 0 or kind == DMAR_RESERVED {
            return 0
        }
        if kind == DMAR_UNIT {
            units += 1
            if (u32_at(at + 4) >> 16) == 0 {
                unit = at
            }
        }
        at += length
    }
    if units != 1 {
        return 0
    }
    return unit
} vtd_unit

/// Whether the unit translates a requester of a segment whose configuration an ECAM, or the
/// configuration ports for zero, reaches: on VT-d one of segment 0 its remapping unit includes,
/// every one when it includes every PCI function, otherwise each endpoint its device scopes name
/// one hop below their start bus and each function of the buses below each bridge they name so;
/// on SMMUv3 one of segment 0 its stream table holds.
fn covered(unit: u64, segment: u64, ecam: u64, requester: u64) -> bool {
    let covers = peek(unit + UNIT_COVERS)
    if segment != 0 {
        return false
    }
    if peek(unit + UNIT_KIND) == SMMU {
        return requester < covers
    }
    if (byte_at(covers + 4) & ALL_FUNCTIONS) != 0 {
        return true
    }
    let end = covers + u64.widen(u32_at(covers) >> 16)
    var at = covers + DMAR_SCOPES
    while at + 2 <= end {
        let length = u64.widen(byte_at(at + 1))
        if length == 0 {
            return false
        }
        let named = (u64.widen(byte_at(at + 5)) << 8) | (u64.widen(byte_at(at + 6)) << 3) | u64.widen(byte_at(at + 7) & 0x7)
        if length == ONE_HOP and named == requester and (byte_at(at) == ENDPOINT_SCOPE or byte_at(at) == BRIDGE_SCOPE) {
            return true
        }
        if length == ONE_HOP and byte_at(at) == BRIDGE_SCOPE {
            let buses = config_read(ecam, requester: u32.truncate(named), offset: BUSES_OFFSET)
            let bus = u32.truncate(requester >> 8)
            if bus >= ((buses >> 8) & 0xFF) and bus <= ((buses >> 16) & 0xFF) and ((buses >> 8) & 0xFF) != 0 {
                return true
            }
        }
        at += length
    }
    return false
} covered

/// The requester id of the I/O APIC of an id that a device scope of VT-d's remapping unit names
/// one hop below its start bus.
fn ioapic_requester(unit: u64, id: u8) -> Option[u32] {
    let covers = peek(unit + UNIT_COVERS)
    let end = covers + u64.widen(u32_at(covers) >> 16)
    var at = covers + DMAR_SCOPES
    while at + 2 <= end {
        let length = u64.widen(byte_at(at + 1))
        if length == 0 {
            return None
        }
        if length == ONE_HOP and byte_at(at) == IOAPIC_SCOPE and byte_at(at + 4) == id {
            return Some((u32.widen(byte_at(at + 5)) << 8) | (u32.widen(byte_at(at + 6)) << 3) | u32.widen(byte_at(at + 7) & 0x7))
        }
        at += length
    }
    return None
} ioapic_requester

/// Enables SMMUv3: the device tree's `arm,smmu-v3` node when it translates stage 1 through
/// AArch64 tables of 4 KiB pages with coherent walks, has stream ids for bus 0 and takes an
/// event queue of `LOG2_EVENTS` entries, which records the faults of its domains, its stream
/// table holding the stream table entries of the PCI host's buses that its stream ids reach,
/// in a level-2 table per bus, or of the buses one chunk holds when it walks no two-level
/// table. Every function's DMA then reaches nothing until it is attached.
fn started_smmu() -> Option[Iommu] {
    let node = tree_node(compatible: "arm,smmu-v3")
    if node.reg == 0 {
        return None
    }
    let base = u64_be_at(node.reg)
    var regs = trusted "the device tree names the SMMU's registers, which the entry root maps as device memory, and nothing else maps them" { Mmio[SmmuRegisters].map(base) }
    let identity = mut regs.read(SmmuRegisters.identity0)
    let needed = STAGE1 | WALKS_COHERENT
    let sizes = mut regs.read(SmmuRegisters.identity5)
    let queue_sizes = mut regs.read(SmmuRegisters.identity1)
    let stream_bits = u64.widen(queue_sizes & 0x3F)
    let event_bits = u64.widen((queue_sizes >> 16) & 0x1F)
    if (identity & needed) != needed or (identity & AARCH64_TABLES) == 0 or (sizes & GRANULE_4K) == 0 or stream_bits < LOG2_ENTRIES or event_bits < LOG2_EVENTS {
        take regs.unmap()
        return None
    }
    let walks_two = (identity & TWO_LEVELS) != 0
    let wanted = tree_buses()
    var log2 = LOG2_ENTRIES
    while log2 < stream_bits and (1u64 << u32.fit(log2)) < wanted * BUS_STREAMS and (walks_two or (1u64 << u32.fit(log2)) < LINEAR_BUSES * BUS_STREAMS) {
        log2 += 1
    }
    let buses = (1u64 << u32.fit(log2)) / BUS_STREAMS
    let unit = chunks(1)
    let streams = chunks((buses * BUS_TABLE + CHUNK - 1) / CHUNK)
    if unit == 0 or streams == 0 {
        take regs.unmap()
        return None
    }
    poke(unit + UNIT_KIND, value: SMMU)
    poke(unit + UNIT_REGISTERS, value: base)
    poke(unit + UNIT_FLAGS, value: LARGE_PAGES | (u64.widen(sizes & 0x7) << 8))
    poke(unit + UNIT_STREAMS, value: streams)
    poke(unit + UNIT_COVERS, value: buses * BUS_STREAMS)
    var table = streams
    var format = u32.truncate(log2)
    if walks_two {
        table = table_page(unit)
        for bus in 0..<buses {
            poke(table + bus * 8, value: (streams + bus * BUS_TABLE) | BUS_SPAN)
        }
        format |= TWO_LEVEL_FORMAT | BUS_SPLIT
    }
    let queue = table_page(unit)
    let events = table_page(unit)
    poke(unit + UNIT_QUEUE, value: queue)
    poke(unit + UNIT_EVENTS, value: events)
    mut regs.write(SmmuRegisters.control, value: 0)
    while mut regs.read(SmmuRegisters.control_ack) != 0 {
    }
    mut regs.write(SmmuRegisters.bypass, value: UPDATE | ABORT)
    while (mut regs.read(SmmuRegisters.bypass) & UPDATE) != 0 {
    }
    mut regs.write(SmmuRegisters.control1, value: SHARED_CACHED)
    mut regs.write(SmmuRegisters.streams, value: table | READ_ALLOCATE)
    mut regs.write(SmmuRegisters.streams_config, value: format)
    mut regs.write(SmmuRegisters.queue_base, value: queue | READ_ALLOCATE | LOG2_ENTRIES)
    mut regs.write(SmmuRegisters.queue_produce, value: 0)
    mut regs.write(SmmuRegisters.queue_consume, value: 0)
    mut regs.write(SmmuRegisters.events_base, value: events | LOG2_EVENTS)
    mut regs.write(SmmuRegisters.events_produce, value: 0)
    mut regs.write(SmmuRegisters.events_consume, value: 0)
    smmu_control(mut regs, value: COMMANDS | EVENT_QUEUE)
    iommu_ready(unit)
    let held = iommu_lock()
    iommu_flush()
    iommu_unlock(held)
    smmu_control(mut regs, value: COMMANDS | EVENT_QUEUE | ENABLED)
    take regs.unmap()
    return Some(Iommu())
} started_smmu

/// The oldest access VT-d recorded that a domain did not let through, clearing every record up to
/// it and the fault status's overflow, under the unit's lock.
fn vtd_fault(unit: u64) -> Option[DmaFault] {
    let base = peek(unit + UNIT_REGISTERS)
    var regs = trusted "the DMAR table names the remapping unit's registers, which the entry root maps uncached, and only the unit's lock holder maps them" { Mmio[VtdRegisters].map(base) }
    let caps = mut regs.read(VtdRegisters.capability)
    let oldest = u64.widen((mut regs.read(VtdRegisters.fault_status) >> FIRST_RECORD) & 0xFF)
    let records = base + ((caps >> RECORDS_AT) & 0x3FF) * 16
    let count = ((caps >> RECORD_COUNT) & 0xFF) + 1
    var fault: Option[DmaFault] = None
    for index in 0..<count {
        fault = vtd_record(at: records + (oldest + index) % count * 16)
        if fault.is_some() {
            break
        }
    }
    mut regs.write(VtdRegisters.fault_status, value: FAULT_OVERFLOW)
    take regs.unmap()
    return fault
} vtd_fault

/// The access a fault recording register of VT-d holds when the domain did not let it through,
/// clearing the register.
fn vtd_record(at: u64) -> Option[DmaFault] {
    var record = trusted "the remapping unit's capability places its fault recording registers among its registers, which the entry root maps uncached, and only the unit's lock holder maps them" { Mmio[FaultRecord].map(at) }
    let reason = mut record.read(FaultRecord.reason)
    var fault: Option[DmaFault] = None
    if (reason & RECORDED) != 0 {
        if (reason & 0xFF) >= BEYOND_WIDTH and (reason & 0xFF) <= UNREADABLE {
            let requester = u64.widen(mut record.read(FaultRecord.requester) & 0xFFFF)
            fault = Some(DmaFault(function: requester_address(segment: 0, requester), address: mut record.read(FaultRecord.page) & ~(PAGE_BYTES - 1), write: (reason & READ_ACCESS) == 0))
        }
        mut record.write(FaultRecord.reason, value: RECORDED)
    }
    take record.unmap()
    return fault
} vtd_record

/// Points VT-d's fault event at the vector of CPU 0 that a remapped message names, in the
/// format without remapping, and unmasks it. The fault event bypasses remapping, so the
/// message's remapping entry need accept only requester 0, the host bridge, which sends none.
fn vtd_signalled(unit: u64, message: u64) {
    let id = cpu_hardware_id(0).value_or(0)
    let flags = iommu_lock()
    var regs = trusted "the DMAR table names the remapping unit's registers, which the entry root maps uncached, and only the unit's lock holder maps them" { Mmio[VtdRegisters].map(peek(unit + UNIT_REGISTERS)) }
    mut regs.write(VtdRegisters.fault_data, value: u32.truncate((message >> HANDLE) & 0xFF))
    mut regs.write(VtdRegisters.fault_address, value: MSI_ADDRESS | (u32.truncate(id & 0xFF) << DESTINATION))
    if (peek(unit + UNIT_FLAGS) & EXTENDED_MODE) != 0 {
        mut regs.write(VtdRegisters.fault_upper, value: u32.truncate(id & 0xFFFF_FF00))
    }
    mut regs.write(VtdRegisters.fault_control, value: 0)
    take regs.unmap()
    iommu_unlock(flags)
} vtd_signalled

/// The oldest access SMMUv3's event queue holds that a domain did not let through, consuming
/// every entry up to it and acknowledging an overflow, under the unit's lock.
fn smmu_fault(unit: u64) -> Option[DmaFault] {
    var regs = trusted "the device tree names the SMMU's registers, which the entry root maps as device memory, and only the unit's lock holder maps them" { Mmio[SmmuRegisters].map(peek(unit + UNIT_REGISTERS)) }
    let produced = mut regs.read(SmmuRegisters.events_produce)
    var consumed = mut regs.read(SmmuRegisters.events_consume) & EVENT_WRAP
    var fault: Option[DmaFault] = None
    for _ in 0..<EVENT_ENTRIES {
        if fault.is_some() or consumed == (produced & EVENT_WRAP) {
            break
        }
        let entry = peek(unit + UNIT_EVENTS) + u64.widen(consumed & EVENT_INDEX) * EVENT_BYTES
        let head = peek(entry)
        if (head & 0xFF) >= TRANSLATION_FAULT and (head & 0xFF) <= PERMISSION_FAULT {
            fault = Some(DmaFault(function: requester_address(segment: 0, requester: head >> 32), address: peek(entry + 16) & ~(PAGE_BYTES - 1), write: (peek(entry + 8) & READ_EVENT) == 0))
        }
        consumed = (consumed + 1) & EVENT_WRAP
    }
    mut regs.write(SmmuRegisters.events_consume, value: consumed | (produced & EVENT_OVERFLOW))
    take regs.unmap()
    return fault
} smmu_fault

/// The identifier of the shared peripheral interrupt that the `interrupts` of SMMUv3's node names
/// `eventq`, zero when none.
fn events_line() -> u64 {
    let node = tree_node(compatible: "arm,smmu-v3")
    let Some(index) = listed_at(node.interrupt_names, len: node.names_len, text: "eventq") else {
        return 0
    }
    let at = node.interrupts + index * INTERRUPT_BYTES
    if (index + 1) * INTERRUPT_BYTES > node.interrupts_len or u32_be_at(at) != 0 {
        return 0
    }
    return u64.widen(u32_be_at(at + 4)) + SPI_BASE
} events_line

/// Writes SMMUv3's control register and waits until it acknowledges the value.
fn smmu_control(mut regs: Mmio[SmmuRegisters], value: u32) {
    mut regs.write(SmmuRegisters.control, value)
    while mut regs.read(SmmuRegisters.control_ack) != value {
    }
} smmu_control

/// The word at an address of runtime memory.
fn peek(address: u64) -> u64 {
    return trusted "the unit's records and tables lie in runtime memory that the running root maps" { Ptr[u64].of_addr(usize.widen(address)).read() }
} peek

fn poke(address: u64, value: u64) {
    trusted "the unit's records and tables lie in runtime memory that the running root maps, which only the unit's lock holder writes" {
        Ptr[u64].of_addr(usize.widen(address)).write(value)
    }
} poke

test physical_space_keeps_a_buffer_in_place for IoSpace.physical {
    let heap = mem::Heap.of(testing::world().alloc)
    let contents = heap.boxed(Array[u8, 4].filled(7))
    let address = u64.widen(Ptr.of_view(contents.contents().view()).addr())
    let buffer = Dma.of(take contents, space: IoSpace.physical())
    let bus = buffer.bus_addr()
    discard take buffer.into_box()
    expect bus.value == address
} physical_space_keeps_a_buffer_in_place
