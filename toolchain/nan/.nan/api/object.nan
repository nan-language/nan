nan api 1
item "nan::object::Elf.define"
head "fn Elf.define(mut self, symbol: u32, section: u32, data: Slice[u8], align: u64) -> u64"
accepted "requires usize.widen(section) < self.sections.len()"
item "nan::object::Elf.define_zeros"
head "fn Elf.define_zeros(mut self, symbol: u32, section: u32, size: u64, align: u64) -> u64"
accepted "requires usize.widen(section) < self.sections.len()"
item "nan::object::Elf.lay_out"
head "fn Elf.lay_out(self, alloc: mem::Alloc) -> Layout"
accepted "ensures result.sections.len() == self.sections.len() and result.symbol_strings.len() == self.symbols.len() and result.symbol_indexes.len() == self.symbols.len()"
item "nan::object::Elf.section"
head "fn Elf.section(mut self, kind: SectionKind) -> u32"
accepted "ensures usize.widen(result) < self.sections.len()"
item "nan::object::Elf.write_section_headers"
head "fn Elf.write_section_headers(self, mut out: mem::Bytes, laid: Layout)"
accepted "requires laid.sections.len() == self.sections.len()"
item "nan::object::Elf.write_symbol"
head "fn Elf.write_symbol(self, mut out: mem::Bytes, at: usize, laid: Layout)"
accepted "requires at < self.symbols.len() and laid.symbol_strings.len() == self.symbols.len()"
item "nan::object::Module.declare_function"
