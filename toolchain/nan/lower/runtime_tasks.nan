//! Tasks: their records and stacks, the run queue, the protocol by which a task parks and a waker makes it ready, the scheduler each executor thread runs, the start and end of a task, and the waits of tasks on kernel operations. A task's state word moves from running to parking when it suspends, then to parked once its executor thread has switched away from its stack; a waker turns new or parked into ready, and running or parking into notified, which the task or its thread turns back into ready. A task asked to stop, or trapping, becomes stopped once off its thread instead, and is never resumed.

/// The offsets of a task record's fields. The saved stack pointer, frame pointer and resume
/// address.
const TASK_CONTEXT: u64 = 0

const TASK_STATE: u64 = 24

/// The stack's lowest address and its length, its guard region included.
const TASK_STACK: u64 = 32

const TASK_STACK_SIZE: u64 = 40

const TASK_DOMAIN: u64 = 48

/// The innermost region holding the call the task runs.
const TASKS_TASK_REGION: u64 = 56

/// The glue running the task's entry, given the record, and the entry's code and environment.
const TASK_GLUE: u64 = 64

const TASK_CODE: u64 = 72

const TASK_ENV: u64 = 80

/// Where the entry's result and failure go.
const TASK_RESULT: u64 = 88

const TASK_FAILURE: u64 = 96

/// How the entry ended: zero while it runs, 1 returned, 2 failed.
const TASK_OUTCOME: u64 = 104

const TASK_NEXT: u64 = 112

/// The links of the list of live tasks.
const TASK_ALL_NEXT: u64 = 120

const TASK_ALL_PREVIOUS: u64 = 128

/// What the task waits on at a cancellation point: an operation in flight, with `TASKS_CLAIMED` set
/// while a cancellation reads its record, the waiting marker, or zero.
const TASK_IO: u64 = 136

/// The glue run on the task's stack once its entry has ended, given the record.
const TASK_END: u64 = 144

/// The construct or domain whose task it is.
const TASK_OWNER: u64 = 152

/// The lowest address of the stack's usable part, above its guard region.
const TASK_GUARD: u64 = 160

/// The thread running it.
const TASK_THREAD: u64 = 168

/// The task waiting in `join` for this one to end.
const TASK_JOINER: u64 = 176

/// Whether its join handle has reaped it, and whether its scope has returned.
const TASK_FLAGS: u64 = 184

/// The cowns of the `await when` body it runs.
const TASK_HELD: u64 = 192

/// The cell its stack was drawn through, zero for a mapped stack.
const TASK_STACK_CELL: u64 = 200

/// The routine its executor thread runs, given the record, once the task has ended and
/// switched away for the last time.
const TASK_DONE: u64 = 208

/// The release of its entry's result, zero when releasing one does nothing.
const TASK_RESULT_RELEASE: u64 = 216

/// The argument its entry takes, when the entry has a parameter.
const TASK_ARGUMENT: u64 = 224

/// Nonzero once the abandoning of its domain asks it to stop.
const TASK_STOP: u64 = 240

/// The first of the deadlines in flight that the constructs it runs armed, linked through their
/// records.
const TASK_DEADLINES: u64 = 248

/// The record of its wait in a structure other domains reach, which settlement withdraws: the
/// glue withdrawing it, given the record, then what that glue reads.
const TASK_WAIT: u64 = 256

/// The next task of the abandoned domain being settled.
const TASK_SETTLE: u64 = 264

/// On the seeded scheduler, the order in which it last became ready.
const TASK_ORDER: u64 = 272

/// On a kernel, nonzero while an interrupt that preempted the task waits to return into it.
const TASK_PREEMPTED: u64 = 280

const TASK_SIZE: u64 = 288

/// The offsets of an executor thread record's fields: the scheduler's saved context, the task
/// it runs, its index and the locks it holds; on `x86_64-host` also its ring, whether it waits
/// idle in its ring, the operations in flight on it, whether another thread asked to cancel
/// one, its POSIX thread and the top of the stack its stack overflow reports run on; on a
/// kernel the flags from before its outermost held lock disabled interrupts.
const THREAD_CONTEXT: u64 = 0

const THREAD_CURRENT: u64 = 24

const THREAD_RING: u64 = 32

const THREAD_INDEX: u64 = 40

const THREAD_IDLE: u64 = 48

const THREAD_OPERATIONS: u64 = 56

const THREAD_REQUESTS: u64 = 64

/// The number of locks the thread holds, then up to `HELD_LOCKS` of them in the order it took
/// them.
const THREAD_LOCKS: u64 = 72

const THREAD_PTHREAD: u64 = 80

const THREAD_TRAP_STACK: u64 = 88

const THREAD_HELD: u64 = 96

const THREAD_SAVED_IF: u64 = THREAD_HELD + 8 * HELD_LOCKS

const THREAD_SIZE: u64 = THREAD_SAVED_IF + 8

/// The bits of a task record's flags. Its join handle has reaped it.
const FLAG_REAPED: i64 = 1

/// It has ended and its executor thread has switched away from it.
const FLAG_DONE: i64 = 2

/// The states of a task.
const RUN_NEW: i64 = 0

const RUN_READY: i64 = 1

const RUN_RUNNING: i64 = 2

const RUN_PARKING: i64 = 3

const RUN_PARKED: i64 = 4

const RUN_NOTIFIED: i64 = 5

const RUN_ENDED: i64 = 6

/// A trapping task switching away for the last time.
const RUN_STOPPING: i64 = 7

const RUN_STOPPED: i64 = 8

/// The offsets of a domain record's fields.
const DOMAIN_PARENT: u64 = 0

const DOMAIN_POOLS: u64 = 8

const DOMAIN_CHUNKS: u64 = 16

/// Nonzero once a trap abandons it.
const DOMAIN_ABANDONED: u64 = 24

/// The task waiting for the domain's first task to end, and the lock of that wait.
const DOMAIN_WAITER: u64 = 32

const DOMAIN_LOCK: u64 = 40

/// The record its trap report is written into: the trap kind's number, the report's length and
/// its bytes.
const DOMAIN_TRAP: u64 = 48

/// The first of the domains nested in it, and the next domain nested in its parent.
const DOMAIN_CHILDREN: u64 = 56

const DOMAIN_SIBLING: u64 = 64

/// The first of the holdings it owns.
const DOMAIN_HOLDINGS: u64 = 72

const DOMAIN_SIZE: u64 = 80

/// The offsets of an operation record's fields: what a task waits on at a cancellation point,
/// or a timer, which a completion, the virtual clock or a sim reaches.
const OPERATION_TASK: u64 = 0

const OPERATION_RESULT: u64 = 8

/// Zero in flight, `OPERATION_COMPLETED` once its completion arrived, then
/// `OPERATION_DELIVERED` once its waiter has been woken, after which the thread delivering it
/// no longer reads the record.
const OPERATION_DONE: u64 = 16

const OPERATION_THREAD: u64 = 24

/// Zero, `OPERATION_REQUESTED` once its cancellation is asked, `OPERATION_SUBMITTED` once
/// submitted.
const OPERATION_CANCEL: u64 = 32

const OPERATION_KIND: u64 = 40

/// Its links among its thread's operations in flight; on the seeded scheduler, among the
/// virtual clock's timers or in the queue of the sim it waits in.
const OPERATION_NEXT: u64 = 48

const OPERATION_PREVIOUS: u64 = 56

/// For a deadline, the task to wake once it completes, and the next deadline its task armed;
/// for a wait in a sim, the sim's record.
const OPERATION_WAITER: u64 = 64

const OPERATION_LINK: u64 = 72

/// On the seeded scheduler, when a timer is due and the order in which it was armed, and for a
/// wait in a sim, the glue withdrawing it from the sim, given the record.
const OPERATION_DUE: u64 = 80

const OPERATION_ORDER: u64 = 88

const OPERATION_WITHDRAW: u64 = 96

const OPERATION_SIZE: u64 = 104

const OPERATION_COMPLETED: i64 = 1

const OPERATION_DELIVERED: i64 = 2

const OPERATION_REQUESTED: i64 = 1

const OPERATION_SUBMITTED: i64 = 2

/// The kinds of operations. A task waits on it.
const TASKS_KIND_WAIT: i64 = 0

/// It reads the next termination request.
const TASKS_KIND_SIGNAL: i64 = 1

/// A deadline, whose expiry cancels the region its `TASK` field names.
const TASKS_KIND_DEADLINE: i64 = 2

/// A component's delayed message, whose expiry lets the messages due into the intake of the
/// runner its `TASK` field names.
const TASKS_KIND_AFTER: i64 = 3

/// The error numbers of an expired timeout and of a cancelled operation, negated.
const TASKS_EXPIRED: i64 = -62

const CANCELED: i64 = -125

/// The offsets of a trap record's fields.
const TRAP_RECORD_KIND: u64 = 0

const TRAP_RECORD_LEN: u64 = 8

const TRAP_RECORD_BYTES: u64 = 16

/// The default size of a task's stack, of the entry task's stack on `x86_64-host`, and of a
/// guard region.
const TASKS_STACK: u64 = 65_536

const ENTRY_STACK: u64 = 67_108_864

const TASKS_GUARD: u64 = 4_096

/// The bytes a task's stack holds beyond its usable size for the support routines and C library
/// functions that its calls of support routines run, whose use past the stub call bound the
/// usable size does not count.
const ROUTINE_RESERVE: u64 = 32_768

/// The bit of a task's `IO` word set while a cancellation reads the record of the operation the
/// task waits on, which the task keeps until the bit clears.
const TASKS_CLAIMED: i64 = 4

/// The symbol of the table of task entries whose own `limits stack N` passes the default task
/// stack: their count, then each entry's code address and N.
const ENTRY_STACKS: Str = "_NSentry_stacks"

fn tasks_define(mut lo: Lowering, mut fx: Fx, routine: Routine) {
    match routine {
        Routine.Spawn => tasks_spawn(mut lo, mut fx)
        Routine.Wake => {
            let params = mut fx.entry()
            expect params.len() > 0
            tasks_wake(mut lo, mut fx, record: params[0])
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.Park => {
            discard mut fx.entry()
            park(mut lo, mut fx)
            mut fx.b.ret(mem::List[clif::Value].empty(fx.alloc).view())
        }
        Routine.TaskStart => task_start(mut lo, mut fx)
        Routine.Schedule => schedule(mut lo, mut fx)
        Routine.ThreadMain => {
            let params = mut fx.entry()
            expect params.len() > 0
            let slot = mut lo.thread_slot(mut fx)
            mut fx.store(params[0], addr: slot, offset: 0)
            let refused = thread_signals(mut lo, mut fx, record: params[0])
            mut fx.if_true(refused, then: fn[mut lo](mut fx1: Fx) {
                let status = mut fx1.ptr(70)
                discard mut lo.call_routine(mut fx1, routine: Routine.Exit, args: fx1.list1(status).view())
            })
            discard mut lo.call_routine(mut fx, routine: Routine.Schedule, args: mem::List[clif::Value].empty(fx.alloc).view())
            mut fx.b.trap(clif::TrapCode(user: 1))
        }
        Routine.Stop => {
            let params = mut fx.entry()
            expect params.len() > 0
            stop_running(mut lo, mut fx, record: params[0])
        }
        Routine.IoSubmit => io_submit(mut lo, mut fx)
        Routine.Thread => {
            discard mut fx.entry()
            let slot = mut lo.thread_slot(mut fx)
            let record = mut fx.load(PTR, addr: slot, offset: 0)
            mut fx.b.ret(fx.list1(record).view())
        }
        else => {
            expect false
        }
    }
} tasks_define

/// Sets what the running task waits on at a cancellation point: `REGIONS_WAITING` for a plain
/// wait, zero once it no longer waits.
fn waiting_on(mut lo: Lowering, mut fx: Fx, what: i64) {
    let current = current_task(mut lo, mut fx)
    let word = mut fx.offset(current, offset: TASK_IO)
    let marker = mut fx.ptr(what.to_bits())
    mut fx.b.atomic_store(clif::MemFlags.owned(), x: marker, p: word)
} waiting_on

/// The task the running executor thread runs, zero outside a task.
fn current_task(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let thread = mut lo.thread(mut fx)
    let inside = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: thread, y: 0)
    let tasks = mut fx.choose(inside, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let running = mut fx1.load(PTR, addr: thread, offset: THREAD_CURRENT)
        return fx1.list1(running)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let none = mut fx1.ptr(0)
        return fx1.list1(none)
    })
    return tasks[0]
} current_task

/// Whether a domain is `outer` or nested in it.
fn tasks_within(mut fx: Fx, inner: clif::Value, outer: clif::Value) -> clif::Value {
    let found = mut fx.repeat(fx.list1(inner).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 0
        let current = state[0]
        let same = mut fx1.b.icmp(clif::IntCC.Equal, x: current, y: outer)
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: current, y: 0)
        let parents = mut fx1.choose(present, results: fx1.types1(PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let parent = mut fx2.load(PTR, addr: current, offset: DOMAIN_PARENT)
            return fx2.list1(parent)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let none = mut fx2.ptr(0)
            return fx2.list1(none)
        })
        let parent = parents[0]
        let has_parent = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: parent, y: 0)
        let differ = mut fx1.b.bxor_imm_s(same, y: 1)
        let more = mut fx1.b.band(differ, y: has_parent)
        let next = mut fx1.b.select(same, x: current, y: parent)
        return Pass(again: more, next: fx1.list1(next))
    })
    return mut fx.b.icmp(clif::IntCC.Equal, x: found[0], y: outer)
} tasks_within

/// Whether a domain is nested in `outer`, `outer` itself excluded.
fn nested_in(mut fx: Fx, inner: clif::Value, outer: clif::Value) -> clif::Value {
    let differ = mut fx.b.icmp(clif::IntCC.NotEqual, x: inner, y: outer)
    let inside = tasks_within(mut fx, inner, outer)
    return mut fx.b.band(differ, y: inside)
} nested_in

/// The domain of the running task, the process domain outside a task.
fn current_domain(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let task = current_task(mut lo, mut fx)
    let state_address = mut lo.state(mut fx)
    let process = mut fx.load(PTR, addr: state_address, offset: STATE_PROCESS)
    let inside = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: task, y: 0)
    let domains = mut fx.choose(inside, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let domain = mut fx1.load(PTR, addr: task, offset: TASK_DOMAIN)
        return fx1.list1(domain)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(process)
    })
    return domains[0]
} current_domain

/// Records the code of a task entry with its own `limits stack N`, when N passes the default
/// task stack.
fn Lowering.entry_stack(mut self, code: object::FuncId, own: Option[u64]) {
    let Some(stack) = own else {
        return
    }
    if stack <= TASKS_STACK {
        return
    }
    let entry = TaskEntryStack(code: code, stack: stack)
    if self.entry_stacks.position(matches: fn(value: TaskEntryStack) => value == entry).is_none() {
        mut self.entry_stacks.push(entry)
    }
} Lowering.entry_stack

/// The address of the table of task entries' own stacks, declared once.
fn Lowering.entry_table(mut self, mut fx: Fx) -> clif::Value {
    let id = match self.entry_table_id {
        Some(known) => known
        None => mut self.module.declare_data(ENTRY_STACKS, linkage: object::Linkage.Local, writable: false, tls: false)
    }
    self.entry_table_id = Some(id)
    let global = mut self.data_ref(mut fx, id)
    return mut fx.b.symbol_value(PTR, global_value: global)
} Lowering.entry_table

/// Defines the table of task entries' own stacks, when a spawn reads it.
fn emit_entry_stacks(mut lo: Lowering) {
    let Some(id) = lo.entry_table_id else {
        return
    }
    var bytes = mem::Bytes.empty(lo.alloc)
    object::append_u64(mut bytes, value: u64.widen(lo.entry_stacks.len()))
    var description = object::DataDescription.new(lo.alloc)
    for entry in lo.entry_stacks {
        object::append_u64(mut bytes, value: 0)
        object::append_u64(mut bytes, value: entry.stack)
    }
    mut description.define(take bytes)
    mut description.set_align(8)
    var index: u32 = 0
    for entry in lo.entry_stacks {
        let reference = mut description.import_function(entry.code)
        mut description.write_function_addr(8 + 16 * index, function: reference)
        index += 1
    }
    mut lo.module.define_data(id, take description)
} emit_entry_stacks

/// The usable stack a task entry's own `limits stack N` needs, when its code is in the table of
/// such entries, or `usable`.
fn tasks_own_stack(mut lo: Lowering, mut fx: Fx, code: clif::Value, usable: clif::Value) -> clif::Value {
    let table = mut lo.entry_table(mut fx)
    let count = mut fx.load(PTR, addr: table, offset: 0)
    let any = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: count, y: 0)
    let stacks = mut fx.choose(any, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = mut fx1.ptr(0)
        let found = mut fx1.repeat(fx1.list2(zero, b: usable).view(), body: fn(mut fx2: Fx, state: Slice[clif::Value]) -> Pass {
            expect state.len() > 1
            let index = state[0]
            let size = state[1]
            let offset = mut fx2.b.imul_imm_s(index, y: 16)
            let record = mut fx2.b.iadd(table, y: offset)
            let entry = mut fx2.load(PTR, addr: record, offset: 8)
            let stack = mut fx2.load(PTR, addr: record, offset: 16)
            let same = mut fx2.b.icmp(clif::IntCC.Equal, x: entry, y: code)
            let larger = mut fx2.b.umax(size, y: stack)
            let needed = mut fx2.b.select(same, x: larger, y: size)
            let next = mut fx2.b.iadd_imm_s(index, y: 1)
            let more = mut fx2.b.icmp(clif::IntCC.UnsignedLessThan, x: next, y: count)
            return Pass(again: more, next: fx2.list2(next, b: needed))
        })
        return fx1.list1(found[1])
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(usable)
    })
    return stacks[0]
} tasks_own_stack

/// `Spawn(glue, code, env, extra, stack, cell, domain, region)`: a new task record with `extra`
/// bytes after it for the entry's result and failure, and a stack of `stack` usable bytes, or
/// of the larger stack the entry's own `limits stack N` needs, with the routine reserve and the
/// guard region, drawn through a cell for a domain, or mapped for the zero cell; zero when the
/// stack cannot be drawn. The task joins the list of live tasks.
fn tasks_spawn(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() > 7
    let glue = params[0]
    let code = params[1]
    let env = params[2]
    let extra = params[3]
    let cell = params[5]
    let domain = params[6]
    let region = params[7]
    let usable = tasks_own_stack(mut lo, mut fx, code, usable: params[4])
    let size = mut fx.b.iadd_imm_s(extra, y: i64.fit(TASK_SIZE))
    let record = mut lo.record_alloc(mut fx, size)
    let failed = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
    mut fx.if_true(failed, then: fn[mut lo](mut fx1: Fx) {
        raise_kind(mut lo, fx: mut fx1, kind: "trap.exhausted")
    })
    let reserved = mut fx.b.iadd_imm_s(usable, y: i64.fit(TASKS_GUARD + ROUTINE_RESERVE + 15))
    let length = mut fx.b.band_imm_s(reserved, y: -16)
    let mapped = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: cell, y: 0)
    let stacks = mut fx.choose_in(mut lo, condition: mapped, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let stack = system_map_stack(mut lo1, fx: mut fx1, len: length)
        return fx1.list1(stack)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let align = mut fx1.ptr(MEMORY_CHUNK)
        let drawn_list = mut lo1.call_routine(mut fx1, routine: Routine.AllocIn, args: fx1.list4(cell, b: length, c: align, d: domain).view())
        expect drawn_list.len() > 0
        let drawn = drawn_list[0]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: drawn, y: 0)
        mut fx1.if_true(present, then: fn[mut lo1](mut fx2: Fx) {
            system_protect_guard(mut lo1, fx: mut fx2, base: drawn, accessible: false)
        })
        return fx1.list1(drawn)
    })
    let stack = stacks[0]
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: stack, y: 0)
    mut fx.if_true(missing, then: fn[mut lo](mut fx1: Fx) {
        mut lo.record_free(mut fx1, address: record)
        let none = mut fx1.ptr(0)
        mut fx1.b.ret(fx1.list1(none).view())
    })
    mut fx.store(stack, addr: record, offset: TASK_STACK)
    mut fx.store(length, addr: record, offset: TASK_STACK_SIZE)
    mut fx.store(cell, addr: record, offset: TASK_STACK_CELL)
    let guard = mut fx.b.iadd_imm_s(stack, y: i64.fit(TASKS_GUARD))
    mut fx.store(guard, addr: record, offset: TASK_GUARD)
    let end = mut fx.b.iadd(stack, y: length)
    let top = mut fx.b.iadd_imm_s(end, y: -8)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: top, offset: 0)
    mut fx.store(top, addr: record, offset: TASK_CONTEXT)
    mut fx.store(zero, addr: record, offset: TASK_CONTEXT + 8)
    let start_id = mut lo.routine(Routine.TaskStart)
    let start_ref = mut lo.func_ref(mut fx, id: start_id)
    let start = mut fx.b.func_addr(PTR, func_ref: start_ref)
    mut fx.store(start, addr: record, offset: TASK_CONTEXT + 16)
    mut fx.store(glue, addr: record, offset: TASK_GLUE)
    mut fx.store(code, addr: record, offset: TASK_CODE)
    mut fx.store(env, addr: record, offset: TASK_ENV)
    let storage = mut fx.b.iadd_imm_s(record, y: i64.fit(TASK_SIZE))
    mut fx.store(storage, addr: record, offset: TASK_RESULT)
    mut fx.store(storage, addr: record, offset: TASK_FAILURE)
    mut fx.store(domain, addr: record, offset: TASK_DOMAIN)
    mut fx.store(region, addr: record, offset: TASKS_TASK_REGION)
    let new = mut fx.int(clif::Type.Int32, value: RUN_NEW)
    mut fx.store(new, addr: record, offset: TASK_STATE)
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TASKS_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let head = mut fx.load(PTR, addr: state_address, offset: STATE_TASKS)
    mut fx.store(head, addr: record, offset: TASK_ALL_NEXT)
    let has_head = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
    mut fx.if_true(has_head, then: fn(mut fx1: Fx) {
        mut fx1.store(record, addr: head, offset: TASK_ALL_PREVIOUS)
    })
    mut fx.store(record, addr: state_address, offset: STATE_TASKS)
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    mut fx.b.ret(fx.list1(record).view())
} tasks_spawn

/// The first code a task runs, on its own stack: its glue, then its end, then it leaves the
/// list of live tasks and switches away for the last time.
fn task_start(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() > 0
    let record = params[0]
    var signature = clif::Signature.new(CALL_CONV, alloc: fx.alloc)
    mut signature.params.push(clif::AbiParam(value_type: PTR))
    let imported = mut fx.b.import_signature(take signature)
    let glue = mut fx.load(PTR, addr: record, offset: TASK_GLUE)
    discard mut fx.b.call_indirect(imported, callee: glue, args: fx.list1(record).view())
    let end = mut fx.load(PTR, addr: record, offset: TASK_END)
    let has_end = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: end, y: 0)
    mut fx.if_true(has_end, then: fn(mut fx1: Fx) {
        discard mut fx1.b.call_indirect(imported, callee: end, args: fx1.list1(record).view())
    })
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TASKS_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let next = mut fx.load(PTR, addr: record, offset: TASK_ALL_NEXT)
    let previous = mut fx.load(PTR, addr: record, offset: TASK_ALL_PREVIOUS)
    let has_previous = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: previous, y: 0)
    discard mut fx.choose(has_previous, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(next, addr: previous, offset: TASK_ALL_NEXT)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(next, addr: state_address, offset: STATE_TASKS)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    let has_next = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: next, y: 0)
    mut fx.if_true(has_next, then: fn(mut fx1: Fx) {
        mut fx1.store(previous, addr: next, offset: TASK_ALL_PREVIOUS)
    })
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    let ended = mut fx.int(clif::Type.Int32, value: RUN_ENDED)
    let word = mut fx.offset(record, offset: TASK_STATE)
    mut fx.b.atomic_store(clif::MemFlags.owned(), x: ended, p: word)
    switch_out(mut lo, mut fx, record)
    mut fx.b.trap(clif::TrapCode(user: 1))
} task_start

/// Switches from the running task to its thread's scheduler.
fn switch_out(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let thread = mut lo.thread(mut fx)
    let scheduler = mut fx.offset(thread, offset: THREAD_CONTEXT)
    let context = mut fx.offset(record, offset: TASK_CONTEXT)
    discard mut fx.b.stack_switch(context, load_context_ptr: scheduler, in_payload0: record)
} switch_out

/// Switches the running kernel task, which an interrupt preempted, away from its CPU: it
/// becomes ready again once its registers are saved, and resumes through the seam that
/// preempted it. A task interrupted while it switches away for another reason, parking or
/// ending, stays as it is.
fn yield_preempted(mut lo: Lowering, mut fx: Fx) {
    let record = current_task(mut lo, mut fx)
    let word = mut fx.offset(record, offset: TASK_STATE)
    let running = mut fx.int(clif::Type.Int32, value: RUN_RUNNING)
    let notified = mut fx.int(clif::Type.Int32, value: RUN_NOTIFIED)
    let seen = mut fx.b.atomic_cas(clif::MemFlags.owned(), p: word, e: running, x: notified)
    let was_running = mut fx.b.icmp(clif::IntCC.Equal, x: seen, y: running)
    let was_notified = mut fx.b.icmp(clif::IntCC.Equal, x: seen, y: notified)
    let yields = mut fx.b.bor(was_running, y: was_notified)
    mut fx.if_true(yields, then: fn[mut lo](mut fx1: Fx) {
        let one = mut fx1.ptr(1)
        mut fx1.store(one, addr: record, offset: TASK_PREEMPTED)
        switch_out(mut lo, fx: mut fx1, record)
    })
} yield_preempted

/// Suspends the running task until a wake, unless one came since it last ran.
fn park(mut lo: Lowering, mut fx: Fx) {
    let record = current_task(mut lo, mut fx)
    let word = mut fx.offset(record, offset: TASK_STATE)
    let running = mut fx.int(clif::Type.Int32, value: RUN_RUNNING)
    let parking = mut fx.int(clif::Type.Int32, value: RUN_PARKING)
    let previous = mut fx.b.atomic_cas(clif::MemFlags.owned(), p: word, e: running, x: parking)
    let parked = mut fx.b.icmp(clif::IntCC.Equal, x: previous, y: running)
    discard mut fx.choose_in(mut lo, condition: parked, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        switch_out(mut lo1, fx: mut fx1, record)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.b.atomic_store(clif::MemFlags.owned(), x: running, p: word)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} park

/// Makes a task ready: a new or parked one joins the run queue, a running or parking one is
/// notified.
fn tasks_wake(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let word = mut fx.offset(record, offset: TASK_STATE)
    let notified = mut fx.int(clif::Type.Int32, value: RUN_NOTIFIED)
    let ready = mut fx.int(clif::Type.Int32, value: RUN_READY)
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        let current = mut fx1.b.atomic_load(clif::Type.Int32, flags: clif::MemFlags.owned(), p: word)
        let is_new = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: current, y: RUN_NEW)
        let parked_now = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: current, y: RUN_PARKED)
        let is_parked = mut fx1.b.bor(is_new, y: parked_now)
        let is_awake = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: current, y: RUN_RUNNING)
        let is_parking = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: current, y: RUN_PARKING)
        let notify = mut fx1.b.bor(is_awake, y: is_parking)
        let target = mut fx1.b.select(is_parked, x: ready, y: notified)
        let acting = mut fx1.b.bor(is_parked, y: notify)
        let again = mut fx1.choose_in(mut lo, condition: acting, results: fx1.types1(clif::Type.Int8).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let seen = mut fx2.b.atomic_cas(clif::MemFlags.owned(), p: word, e: current, x: target)
            let done = mut fx2.b.icmp(clif::IntCC.Equal, x: seen, y: current)
            let enqueue = mut fx2.b.band(done, y: is_parked)
            mut fx2.if_true(enqueue, then: fn[mut lo2](mut fx3: Fx) {
                tasks_push_ready(mut lo2, fx: mut fx3, record)
            })
            let retry = mut fx2.b.bxor_imm_s(done, y: 1)
            return fx2.list1(retry)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let settled = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(settled)
        })
        return Pass(again: again[0], next: mem::List[clif::Value].empty(fx1.alloc))
    })
} tasks_wake

/// Makes a task just spawned ready; the spawn is a scheduling point of the running task.
fn spawned(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    discard mut lo.call_routine(mut fx, routine: Routine.Wake, args: fx.list1(record).view())
    scheduling_point(mut lo, mut fx)
} spawned

/// Appends a ready task to the run queue, waking an idle executor thread.
fn tasks_push_ready(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    if lo.seeded() {
        seeded_push_ready(mut lo, mut fx, record)
        return
    }
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_QUEUE_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: record, offset: TASK_NEXT)
    let tail = mut fx.load(PTR, addr: state_address, offset: STATE_READY_TAIL)
    let has_tail = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: tail, y: 0)
    discard mut fx.choose(has_tail, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(record, addr: tail, offset: TASK_NEXT)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(record, addr: state_address, offset: STATE_READY_HEAD)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    mut fx.store(record, addr: state_address, offset: STATE_READY_TAIL)
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    system_wake_idle(mut lo, mut fx)
} tasks_push_ready

/// Takes the first ready task, zero when none.
fn pop_ready(mut lo: Lowering, mut fx: Fx) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_QUEUE_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let head = mut fx.load(PTR, addr: state_address, offset: STATE_READY_HEAD)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: head, y: 0)
    mut fx.if_true(present, then: fn(mut fx1: Fx) {
        let next = mut fx1.load(PTR, addr: head, offset: TASK_NEXT)
        mut fx1.store(next, addr: state_address, offset: STATE_READY_HEAD)
        let last = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: next, y: 0)
        mut fx1.if_true(last, then: fn(mut fx2: Fx) {
            let zero = mut fx2.ptr(0)
            mut fx2.store(zero, addr: state_address, offset: STATE_READY_TAIL)
        })
    })
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    return head
} pop_ready

/// The scheduler of an executor thread: runs ready tasks, handling the completions on its ring
/// between them, and waits for a completion when no task is ready; the seeded scheduler chooses
/// each task it runs and advances its virtual clock instead of waiting. Never returns.
fn schedule(mut lo: Lowering, mut fx: Fx) {
    discard mut fx.entry()
    let header = mut fx.block()
    mut fx.b.jump(header, args: mem::List[clif::Value].empty(fx.alloc).view())
    mut fx.b.switch_to_block(header)
    if lo.kernel() {
        discard mut lo.call_stub(mut fx, stub: Stub.Cli, args: mem::List[clif::Value].empty(fx.alloc).view())
    }
    let record = if lo.seeded() {
        seeded_pick(mut lo, mut fx)
    } else {
        pop_ready(mut lo, mut fx)
    }
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: record, y: 0)
    discard mut fx.choose_in(mut lo, condition: present, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        run_task(mut lo1, fx: mut fx1, record)
        mut lo1.reap(mut fx1)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        if lo1.seeded() {
            seeded_idle(mut lo1, fx: mut fx1)
        } else {
            system_idle(mut lo1, fx: mut fx1)
        }
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    mut fx.b.jump(header, args: mem::List[clif::Value].empty(fx.alloc).view())
    let after = mut fx.block()
    mut fx.b.switch_to_block(after)
    mut fx.b.trap(clif::TrapCode(user: 1))
} schedule

/// Switches to a ready task until it parks or ends, then settles its state; an ended task's
/// stack returns. A task asked to stop is not switched to, and one that parks or is notified
/// while asked to stop, or that traps, becomes stopped.
fn run_task(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let word = mut fx.offset(record, offset: TASK_STATE)
    let asked = stop_asked(mut fx, record)
    discard mut fx.choose_in(mut lo, condition: asked, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let stopped = mut fx1.int(clif::Type.Int32, value: RUN_STOPPED)
        mut fx1.b.atomic_store(clif::MemFlags.owned(), x: stopped, p: word)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        switch_in(mut lo1, fx: mut fx1, record)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} run_task

/// Runs a task on the executor thread until it switches away, then settles its state.
fn switch_in(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let word = mut fx.offset(record, offset: TASK_STATE)
    let thread = mut lo.thread(mut fx)
    let running = mut fx.int(clif::Type.Int32, value: RUN_RUNNING)
    mut fx.b.atomic_store(clif::MemFlags.owned(), x: running, p: word)
    mut fx.store(record, addr: thread, offset: THREAD_CURRENT)
    mut fx.store(thread, addr: record, offset: TASK_THREAD)
    let scheduler = mut fx.offset(thread, offset: THREAD_CONTEXT)
    let context = mut fx.offset(record, offset: TASK_CONTEXT)
    if lo.kernel() {
        // A preempted task resumes through the seam that preempted it, whose return restores its
        // interrupt flag; every other task runs with maskable interrupts enabled.
        let preempted = mut fx.load(PTR, addr: record, offset: TASK_PREEMPTED)
        let resumed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: preempted, y: 0)
        discard mut fx.choose_in(mut lo, condition: resumed, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
            let zero = mut fx1.ptr(0)
            mut fx1.store(zero, addr: record, offset: TASK_PREEMPTED)
            return mem::List[clif::Value].empty(fx1.alloc)
        }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
            discard mut lo1.call_stub(mut fx1, stub: Stub.Sti, args: mem::List[clif::Value].empty(fx1.alloc).view())
            return mem::List[clif::Value].empty(fx1.alloc)
        })
    }
    discard mut fx.b.stack_switch(scheduler, load_context_ptr: context, in_payload0: record)
    let resumed_thread = mut lo.thread(mut fx)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: resumed_thread, offset: THREAD_CURRENT)
    let state_now = mut fx.b.atomic_load(clif::Type.Int32, flags: clif::MemFlags.owned(), p: word)
    let ended = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: state_now, y: RUN_ENDED)
    let trapped = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: state_now, y: RUN_STOPPING)
    let stop_requested = stop_asked(mut fx, record)
    let not_ended = mut fx.b.bxor_imm_s(ended, y: 1)
    let asked = mut fx.b.band(stop_requested, y: not_ended)
    let stops = mut fx.b.bor(trapped, y: asked)
    discard mut fx.choose_in(mut lo, condition: stops, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let stopped = mut fx1.int(clif::Type.Int32, value: RUN_STOPPED)
        mut fx1.b.atomic_store(clif::MemFlags.owned(), x: stopped, p: word)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        // A task switching away notified was woken after it parked, or was preempted.
        let parking_now = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: state_now, y: RUN_PARKING)
        let notified_now = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: state_now, y: RUN_NOTIFIED)
        let parking = mut fx1.b.bor(parking_now, y: notified_now)
        mut fx1.if_true(parking, then: fn[mut lo1](mut fx2: Fx) {
            let parking_state = mut fx2.int(clif::Type.Int32, value: RUN_PARKING)
            let parked = mut fx2.int(clif::Type.Int32, value: RUN_PARKED)
            let seen = mut fx2.b.atomic_cas(clif::MemFlags.owned(), p: word, e: parking_state, x: parked)
            let notified = mut fx2.b.icmp(clif::IntCC.NotEqual, x: seen, y: parking_state)
            mut fx2.if_true(notified, then: fn[mut lo1](mut fx3: Fx) {
                let ready = mut fx3.int(clif::Type.Int32, value: RUN_READY)
                mut fx3.b.atomic_store(clif::MemFlags.owned(), x: ready, p: word)
                tasks_push_ready(mut lo1, fx: mut fx3, record)
            })
        })
        mut fx1.if_true(ended, then: fn[mut lo1](mut fx2: Fx) {
            release_stack(mut lo1, fx: mut fx2, record)
            let done = mut fx2.load(PTR, addr: record, offset: TASK_DONE)
            let has_done = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: done, y: 0)
            mut fx2.if_true(has_done, then: fn(mut fx3: Fx) {
                var signature = clif::Signature.new(CALL_CONV, alloc: fx3.alloc)
                mut signature.params.push(clif::AbiParam(value_type: PTR))
                let imported = mut fx3.b.import_signature(take signature)
                discard mut fx3.b.call_indirect(imported, callee: done, args: fx3.list1(record).view())
            })
        })
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} switch_in

/// Whether the abandoning of a task's domain asks it to stop.
fn stop_asked(mut fx: Fx, record: clif::Value) -> clif::Value {
    let word = mut fx.offset(record, offset: TASK_STOP)
    let asked = mut fx.b.atomic_load(clif::Type.Int64, flags: clif::MemFlags.owned(), p: word)
    return mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: asked, y: 0)
} stop_asked

/// Switches the running task away for the last time, as stopped: its thread never resumes it.
fn stop_running(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let stopping = mut fx.int(clif::Type.Int32, value: RUN_STOPPING)
    let word = mut fx.offset(record, offset: TASK_STATE)
    mut fx.b.atomic_store(clif::MemFlags.owned(), x: stopping, p: word)
    switch_out(mut lo, mut fx, record)
    mut fx.b.trap(clif::TrapCode(user: 1))
} stop_running

/// Returns an ended task's stack: unmapped, or freed through its cell.
fn release_stack(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let stack = mut fx.load(PTR, addr: record, offset: TASK_STACK)
    let cell = mut fx.load(PTR, addr: record, offset: TASK_STACK_CELL)
    let mapped = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: cell, y: 0)
    discard mut fx.choose_in(mut lo, condition: mapped, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let length = mut fx1.load(PTR, addr: record, offset: TASK_STACK_SIZE)
        unmap_stack(mut lo1, fx: mut fx1, stack, len: length)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        system_protect_guard(mut lo1, fx: mut fx1, base: stack, accessible: true)
        discard mut lo1.call_routine(mut fx1, routine: Routine.Free, args: fx1.list1(stack).view())
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} release_stack

/// `IoSubmit(entry)`: submits an io_uring entry from the running task and parks until its
/// completion. A call cancelled when it starts submits nothing; one cancelled while the
/// operation is in flight cancels it and waits for the acknowledgement. Gives whether the call
/// failed with cancellation, and the completion's result.
fn io_submit(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() > 0
    let entry = params[0]
    let record = current_task(mut lo, mut fx)
    let region = mut fx.load(PTR, addr: record, offset: TASKS_TASK_REGION)
    let origin_before = regions_origin(mut fx, region)
    let cancelled_before = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: origin_before, y: 0)
    mut fx.if_true(cancelled_before, then: fn(mut fx1: Fx) {
        let yes = mut fx1.int(clif::Type.Int8, value: 1)
        let none = mut fx1.int(clif::Type.Int32, value: 0)
        mut fx1.b.ret(fx1.list2(yes, b: none).view())
    })
    let op = mut fx.slot(OPERATION_SIZE, align: 8)
    let zero = mut fx.ptr(0)
    let size = mut fx.ptr(OPERATION_SIZE)
    discard mut lo.call_routine(mut fx, routine: Routine.Fill, args: fx.list3(op, b: zero, c: size).view())
    mut fx.store(record, addr: op, offset: OPERATION_TASK)
    let word = mut fx.offset(record, offset: TASK_IO)
    mut fx.b.atomic_store(clif::MemFlags.owned(), x: op, p: word)
    host_submit(mut lo, mut fx, prepared: entry, op: Some(op))
    let origin_submitted = regions_origin(mut fx, region)
    let cancelled_submitted = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: origin_submitted, y: 0)
    mut fx.if_true(cancelled_submitted, then: fn[mut lo](mut fx1: Fx) {
        cancel_operation(mut lo, fx: mut fx1, op)
    })
    wait_delivered(mut lo, mut fx, op)
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        let seen = mut fx1.b.atomic_cas(clif::MemFlags.owned(), p: word, e: op, x: zero)
        let claimed = mut fx1.b.icmp(clif::IntCC.NotEqual, x: seen, y: op)
        mut fx1.if_true(claimed, then: fn[mut lo](mut fx2: Fx) {
            mut lo.relax(mut fx2)
        })
        return Pass(again: claimed, next: mem::List[clif::Value].empty(fx1.alloc))
    })
    let result = mut fx.load(clif::Type.Int32, addr: op, offset: OPERATION_RESULT)
    let refused = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: result, y: CANCELED)
    let origin_after = regions_origin(mut fx, region)
    let cancelled_after = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: origin_after, y: 0)
    let failed = mut fx.b.band(refused, y: cancelled_after)
    mut fx.b.ret(fx.list2(failed, b: result).view())
} io_submit

/// Delivers an operation's completion with its result, by its kind: a waiting task wakes, a
/// deadline that expired cancels its region and wakes the task disarming it, and a component's
/// delayed messages that are due enter its intake.
fn deliver(mut lo: Lowering, mut fx: Fx, op: clif::Value, result: clif::Value) {
    let kind = mut fx.load(PTR, addr: op, offset: OPERATION_KIND)
    let wait = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: TASKS_KIND_WAIT)
    mut fx.if_true(wait, then: fn[mut lo](mut fx1: Fx) {
        mut fx1.store(result, addr: op, offset: OPERATION_RESULT)
        let waiting = mut fx1.load(PTR, addr: op, offset: OPERATION_TASK)
        set_done(mut fx1, op, done: OPERATION_COMPLETED)
        tasks_wake(mut lo, fx: mut fx1, record: waiting)
        set_done(mut fx1, op, done: OPERATION_DELIVERED)
    })
    let deadline = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: TASKS_KIND_DEADLINE)
    mut fx.if_true(deadline, then: fn[mut lo](mut fx1: Fx) {
        set_done(mut fx1, op, done: OPERATION_COMPLETED)
        let expired = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: result, y: TASKS_EXPIRED)
        mut fx1.if_true(expired, then: fn[mut lo](mut fx2: Fx) {
            let region_record = mut fx2.load(PTR, addr: op, offset: OPERATION_TASK)
            discard mut lo.call_routine(mut fx2, routine: Routine.Cancel, args: fx2.list1(region_record).view())
        })
        let waiter_word = mut fx1.offset(op, offset: OPERATION_WAITER)
        let waiter = mut fx1.b.atomic_load(PTR, flags: clif::MemFlags.owned(), p: waiter_word)
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: waiter, y: 0)
        mut fx1.if_true(present, then: fn[mut lo](mut fx2: Fx) {
            tasks_wake(mut lo, fx: mut fx2, record: waiter)
        })
        set_done(mut fx1, op, done: OPERATION_DELIVERED)
    })
    let after = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: kind, y: TASKS_KIND_AFTER)
    mut fx.if_true(after, then: fn[mut lo](mut fx1: Fx) {
        timer_completed(mut lo, fx: mut fx1, op)
    })
} deliver

/// Stores how far an operation's completion has been delivered.
fn set_done(mut fx: Fx, op: clif::Value, done: i64) {
    let word = mut fx.offset(op, offset: OPERATION_DONE)
    let value = mut fx.ptr(done.to_bits())
    mut fx.b.atomic_store(clif::MemFlags.owned(), x: value, p: word)
} set_done

/// Waits until an operation's completion has been delivered, the running task parking while it
/// has not arrived; on the seeded scheduler a completion queued is delivered at once.
fn wait_delivered(mut lo: Lowering, mut fx: Fx, op: clif::Value) {
    let word = mut fx.offset(op, offset: OPERATION_DONE)
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        let done = mut fx1.b.atomic_load(PTR, flags: clif::MemFlags.owned(), p: word)
        let pending = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: done, y: 0)
        mut fx1.if_true(pending, then: fn[mut lo](mut fx2: Fx) {
            discard mut lo.call_routine(mut fx2, routine: Routine.Park, args: mem::List[clif::Value].empty(fx2.alloc).view())
        })
        if lo.seeded() {
            let queued = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: done, y: OPERATION_COMPLETED)
            mut fx1.if_true(queued, then: fn[mut lo](mut fx2: Fx) {
                seeded_reap(mut lo, fx: mut fx2)
            })
        }
        let delivered = mut fx1.b.icmp_imm_s(clif::IntCC.Equal, x: done, y: OPERATION_DELIVERED)
        let again = mut fx1.b.bxor_imm_s(delivered, y: 1)
        return Pass(again: again, next: mem::List[clif::Value].empty(fx1.alloc))
    })
} wait_delivered

/// Arms a timer that expires `ms` milliseconds from now: a timeout of the relative time it
/// writes at `spec` on the running thread's ring, or on the seeded scheduler a pending deadline
/// of the virtual clock.
fn Lowering.arm_timer(mut self, mut fx: Fx, op: clif::Value, ms: clif::Value, spec: clif::Value) {
    if self.seeded() {
        arm(mut self, fx: mut fx, op, ms)
        return
    }
    let thousand = mut fx.ptr(1_000)
    let seconds = mut fx.b.udiv(ms, y: thousand)
    let rest = mut fx.b.urem(ms, y: thousand)
    let nanoseconds = mut fx.b.imul_imm_s(rest, y: 1_000_000)
    mut fx.store(seconds, addr: spec, offset: 0)
    mut fx.store(nanoseconds, addr: spec, offset: 8)
    submit_timeout(mut self, fx: mut fx, op, spec)
} Lowering.arm_timer

/// Asks once for the cancellation of an operation whose record stays valid during the call; on
/// the seeded scheduler one in flight completes cancelled at once.
fn Lowering.cancel_operation(mut self, mut fx: Fx, op: clif::Value) {
    if self.seeded() {
        seeded_cancel(mut self, fx: mut fx, op)
    } else if self.kernel() {
        // A kernel task waits only on plain waits, which cancellation wakes, never on an
        // operation.
        mut fx.b.trap(clif::TrapCode(user: 1))
    } else {
        cancel_operation(mut self, fx: mut fx, op)
    }
} Lowering.cancel_operation

/// Delivers the completions that have arrived: those on the running thread's ring, or those
/// the seeded scheduler queued; a kernel's waits end by wakes alone.
fn Lowering.reap(mut self, mut fx: Fx) {
    if self.seeded() {
        seeded_reap(mut self, fx: mut fx)
    } else if not self.kernel() {
        host_reap(mut self, fx: mut fx, wait: None)
    }
} Lowering.reap

/// The milliseconds of the clock that delays count: the monotonic clock, or on the seeded
/// scheduler the virtual clock.
fn Lowering.now_ms(mut self, mut fx: Fx) -> clif::Value {
    if self.seeded() {
        return seeded_now(mut self, fx: mut fx)
    }
    let called = mut self.platform_call(mut fx, name: "now_ms", args: mem::List[Held].empty(fx.alloc).view())
    return called.result.scalar_value()
} Lowering.now_ms
