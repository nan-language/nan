//! Tests of declaring, defining and writing objects.

fn returning(alloc: mem::Alloc) -> clif::Signature {
    var made = clif::Signature.new(clif::CallConv.SystemV, alloc)
    mut made.returns.push(clif::AbiParam(value_type: clif::Type.Int64))
    return made
} returning

fn code_reloc(offset: u32, kind: x64::RelocKind, target: RelocTarget) -> ModuleReloc = ModuleReloc(offset: offset, kind: kind, target: target, addend: -4)

fn define_bytes(mut module: Module, id: DataId, bytes: Slice[u8], align: u64, alloc: mem::Alloc) {
    var description = DataDescription.new(alloc)
    var contents = mem::Bytes.empty(alloc)
    mut contents.append(bytes)
    mut description.define(take contents)
    mut description.set_align(align)
    mut module.define_data(id, take description)
} define_bytes

/// An object holding a section of each kind and each kind of relocation position-independent
/// code holds: `main` prints "hi" through `puts`, calls `helper` through `table` and reads a
/// thread-local variable.
fn every_kind(alloc: mem::Alloc) -> mem::Bytes {
    var module = Module.new(workspace::Target.Host, alloc)
    let entry = mut module.declare_function("main", linkage: Linkage.Export, signature: returning(alloc))
    let helper = mut module.declare_function("helper", linkage: Linkage.Local, signature: returning(alloc))
    let puts = mut module.declare_function("puts", linkage: Linkage.Import, signature: returning(alloc))
    let tls_get_addr = mut module.declare_function("__tls_get_addr", linkage: Linkage.Import, signature: returning(alloc))
    let greeting = mut module.declare_data("greeting", linkage: Linkage.Local, writable: false, tls: false)
    let table = mut module.declare_data("table", linkage: Linkage.Local, writable: false, tls: false)
    let pointer = mut module.declare_data("pointer", linkage: Linkage.Export, writable: true, tls: false)
    let zeros = mut module.declare_data("zeros", linkage: Linkage.Local, writable: true, tls: false)
    let tls_init = mut module.declare_data("tls_init", linkage: Linkage.Local, writable: true, tls: true)
    let tls_zero = mut module.declare_data("tls_zero", linkage: Linkage.Local, writable: true, tls: true)
    var relocs = mem::List[ModuleReloc].empty(alloc)
    mut relocs.push(code_reloc(12, kind: x64::RelocKind.Relative4, target: RelocTarget.Data(greeting)))
    mut relocs.push(code_reloc(17, kind: x64::RelocKind.CallPlt4, target: RelocTarget.Function(puts)))
    mut relocs.push(code_reloc(23, kind: x64::RelocKind.Relative4, target: RelocTarget.Data(table)))
    mut relocs.push(code_reloc(32, kind: x64::RelocKind.Relative4, target: RelocTarget.Data(pointer)))
    mut relocs.push(code_reloc(45, kind: x64::RelocKind.TlsGeneralDynamic, target: RelocTarget.Data(tls_init)))
    mut relocs.push(code_reloc(53, kind: x64::RelocKind.CallPlt4, target: RelocTarget.Function(tls_get_addr)))
    mut relocs.push(code_reloc(64, kind: x64::RelocKind.GotRelative4, target: RelocTarget.Function(puts)))
    let code = b"\x55\x48\x89\xe5\x53\x48\x83\xec\x08\x48\x8d\x3d\x00\x00\x00\x00\xe8\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x89\xc3\x48\x8b\x05\x00\x00\x00\x00\x0f\xb6\x00\x01\xc3\x66\x48\x8d\x3d\x00\x00\x00\x00\x66\x66\x48\xe8\x00\x00\x00\x00\x03\x18\x89\xd8\x48\x8b\x0d\x00\x00\x00\x00\x48\x83\xc4\x08\x5b\x5d\xc3"
    mut module.define_function_bytes(entry, align: 16, bytes: code, relocs: relocs.view())
    mut module.define_function_bytes(helper, align: 16, bytes: b"\xb8\x07\x00\x00\x00\xc3", relocs: mem::List[ModuleReloc].empty(alloc).view())
    define_bytes(mut module, id: greeting, bytes: b"hi\0", align: 1, alloc)
    var addresses = DataDescription.new(alloc)
    mut addresses.define(mem::Bytes.zeroed(8, alloc))
    let function = mut addresses.import_function(helper)
    mut addresses.write_function_addr(0, function)
    mut module.define_data(table, description: take addresses)
    var address = DataDescription.new(alloc)
    mut address.define(mem::Bytes.zeroed(8, alloc))
    let data = mut address.import_data(greeting)
    mut address.write_data_addr(0, data, addend: 1)
    mut module.define_data(pointer, description: take address)
    var zeroed = DataDescription.new(alloc)
    mut zeroed.define_zeroinit(64)
    mut zeroed.set_align(16)
    mut module.define_data(zeros, description: take zeroed)
    define_bytes(mut module, id: tls_init, bytes: b"\x03\x00\x00\x00", align: 4, alloc)
    var thread_zeroed = DataDescription.new(alloc)
    mut thread_zeroed.define_zeroinit(8)
    mut module.define_data(tls_zero, description: take thread_zeroed)
    return take module.finish(Some(ClosureSections(artefacts: b"artefacts", tree: b"tree")), alloc)
} every_kind

test objects_are_written_as_cranelift_object_writes_them for Module.finish {
    let alloc = testing::world().alloc
    let written = every_kind(alloc)
    let hash = hashing::HashValue.of(written.view()).full(alloc)
    expect hash.as_str() == "ag7ctlguho6hmm6nc4pqxdfk6grartfbos7b5z73fnv5m5pts5fwsit"
} objects_are_written_as_cranelift_object_writes_them

test declaring_a_name_again_merges_its_linkage for Module.declare_function {
    let alloc = testing::world().alloc
    var module = Module.new(workspace::Target.Host, alloc)
    let imported = mut module.declare_function("f", linkage: Linkage.Import, signature: returning(alloc))
    let defined = mut module.declare_function("f", linkage: Linkage.Local, signature: returning(alloc))
    expect imported == defined and module.function_linkage(defined) == Linkage.Local
    let exported = mut module.declare_function("f", linkage: Linkage.Export, signature: returning(alloc))
    expect exported == defined and module.function_linkage(exported) == Linkage.Export
    expect module.function_name(exported) == "f"
} declaring_a_name_again_merges_its_linkage

test strings_end_the_strings_written_before_them for Strings.table {
    let alloc = testing::world().alloc
    var strings = Strings.empty(alloc)
    let foo = mut strings.add("foo")
    let bar = mut strings.add("bar")
    let foobar = mut strings.add("foobar")
    let again = mut strings.add("bar")
    expect again == bar
    let table = strings.table(index: 0, name: 0, offset: 0, alloc)
    expect table.data.view() == b"\0foobar\0foo\0"
    expect table.offset_of(foo) == 8 and table.offset_of(bar) == 4 and table.offset_of(foobar) == 1
} strings_end_the_strings_written_before_them
