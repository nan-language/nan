} Builder.sshr_imm_s

pkg fn Builder.rotr_imm_s(mut self, x: Value, y: i64) -> Value {
    return mut self.binary_imm(Opcode.Rotr, x, y)
} Builder.rotr_imm_s

pkg fn Builder.clz(mut self, x: Value) -> Value {
    let ty = self.value_type(x)
    return mut self.unary(Opcode.Clz, ctrl_typevar: ty, arg: x)
} Builder.clz

pkg fn Builder.ctz(mut self, x: Value) -> Value {
    let ty = self.value_type(x)
    return mut self.unary(Opcode.Ctz, ctrl_typevar: ty, arg: x)
} Builder.ctz

pkg fn Builder.popcnt(mut self, x: Value) -> Value {
    let ty = self.value_type(x)
    return mut self.unary(Opcode.Popcnt, ctrl_typevar: ty, arg: x)
