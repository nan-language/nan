//! Forwarded calls through failure conversions, `take` arguments, generic heads and closures, a failing interface call reaching an implementation without failures, and a call through a `Dyn` view passing arguments after its receiver.

pub closed enum Low derives Render {
    Empty
} Low

pub closed enum Fault derives Render {
    Wrapped(Low) from
} Fault

pub fn checked(value: u32) -> u32 fails Low {
    if value == 0 {
        fail Low.Empty
    }
    return value
} checked

retired verified(value: u32) -> u32 fails Fault => checked(value) preserves

pub fn reading(value: u32) -> u32 {
    return match attempt verified(value) {
        Ok(found) => found
        Err(Fault.Wrapped(Low.Empty)) => 99
    }
} reading

pub fn strict(value: u32) -> u32 fails Fault {
    return try verified(value)
} strict

pub closed struct Token {
    pub size: u32
} Token

pub fn Token.weight(take self) -> u32 = self.size

retired measure(take token: Token) -> u32 => take token.weight() preserves

pub fn pick[T: Copy](left: T, right: T, leftmost: bool) -> T {
    if leftmost {
        return left
    }
    return right
} pick

retired choose[T: Copy](leftmost: bool, left: T, right: T) -> T => pick(left, right, leftmost) preserves

pub fn apply(value: u32, step: fn(x: u32) -> u32) -> u32 = step(value)

retired doubled(value: u32) -> u32 => apply(value, step: fn(x: u32) => x.saturating_add(x)) preserves

pub interface Source {
    fn next(mut self) -> u32 fails Low
} Source

pub closed struct Counter {
    pub count: u32
} Counter

impl Counter: Source

pub fn Counter.next(mut self) -> u32 {
    self.count = self.count.saturating_add(1)
    return self.count
} Counter.next

pub closed struct Scale {
    pub factor: u32
    pub product: u64
} Scale

pub interface Scaled {
    fn scaled(self, factor: u32) -> Scale
} Scaled

impl Counter: Scaled

pub fn Counter.scaled(self, factor: u32) -> Scale = Scale(factor: factor, product: u64.widen(self.count.saturating_mul(factor)))

pub fn dynamic(scaled: Dyn[Scaled], factor: u32) -> u64 {
    let scale = scaled.scaled(factor)
    return scale.product.saturating_add(u64.widen(scale.factor))
} dynamic

pub fn first_two[S: Source](mut source: S) -> u32 fails Low {
    let earlier = try mut source.next()
    let later = try mut source.next()
    return earlier.saturating_add(later)
} first_two

fn main(take world: host::World) -> u8 fails task::Cancelled uses wait {
    world.log.info("verified", value: reading(7))
    world.log.info("empty", value: reading(0))
    let strictly = match attempt strict(0) {
        Ok(found) => found
        Err(Fault.Wrapped(Low.Empty)) => 98
    }
    world.log.info("strict", value: strictly)
    world.log.info("measured", value: measure(Token(size: 5)))
    world.log.info("chosen", value: choose(false, left: 1u32, right: 2u32))
    world.log.info("doubled", value: doubled(21))
    var counter = Counter(count: 0)
    let sourced = match attempt first_two(mut counter) {
        Ok(found) => found
        Err(Low.Empty) => 0
    }
    world.log.info("sourced", value: sourced)
    world.log.info("dynamic", value: dynamic(Dyn[Scaled].view(counter), factor: 4))
    return 0
} main
