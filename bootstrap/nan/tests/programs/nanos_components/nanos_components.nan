//! Loads a component bundle and holds instances of its tally in domains of their own through `nanos::hold`, serving their logs on the serial port: calls with replies, a refusal, a transferred clock and a mismatched protocol hash, keyed tasks started on resume, the system interfaces, a checkpoint restored into a fresh instance, a trapping handler, a handler that never returns until its domain is abandoned, a missing component, an Env the kernel's grants cannot build, and an instance running from the load a replacement of the bundle retires, and a relay calling the tally through the ports of a runner the kernel serves both: an addition answered at once, a total the tally postpones until a settlement the relay sends has it reply, a summary the tally publishes, a sync it asks for, a clock the runner holds for the relay as a capability by number until the relay drops it, and a file the runner holds for the relay as a resource by number, which the relay borrows, puts back, then takes and drops, after the runner refuses it a resource it does not hold.

registers Uart {
    data: u8 at 0x0 write
} Uart

registers Selector {
    key: u16 at 0x0 write
} Selector

registers Data {
    byte: u8 at 0x0 read
} Data

/// The fw_cfg key of the file directory, and the bytes of a file's name in it.
const DIRECTORY: u16 = 0x19

const NAME_BYTES: usize = 56

/// The public key of the seed of 32 bytes 7, with which the harness signs the bundles.
const SIGNER: Slice[u8] = b"\xEA\x4A\x6C\x63\xE2\x9C\x52\x0A\xBE\xF5\x50\x7B\x13\x2E\xC5\xF9\x95\x47\x76\xAE\xBE\xBE\x7B\x92\x42\x1E\xEA\x69\x14\x46\xD2\x2C"

/// The tally's protocol as the kernel declares it, another protocol, whose hash the tally refuses,
/// and the relay's protocol as the kernel declares it.
pub protocol Counter {
    pub fn add(amount: u32) -> u64 fails refusals::Refused limits pure
    pub fn echo(clock: sys::Clock) -> sys::Clock limits pure
    pub fn divide(by: u32) -> u64 limits pure
    pub fn spin() -> u64 limits pure
    pub fn current() -> u64 fails refusals::Refused limits pure
    pub fn settle() limits traceless
} Counter

pub protocol Gauge {
    pub fn add(amount: u32) limits pure
} Gauge

pub protocol Front {
    pub fn relay(amount: u32) limits recorded
    pub fn await_total() limits recorded
    pub fn settle() limits traceless
    pub fn clocked() limits recorded
    pub fn noted() limits recorded
} Front

/// The tally's state, as the kernel declares it.
pub closed struct Tally derives Encode {
    pub total: u64
    pub ticks: u64
    pub suspended: bool
    pub pending: u64
} Tally

/// The serial port serving a component's log, random source and standard streams.
struct Console {
} Console

impl Console: sys::Kind[core::atomic::AtomicU64, u64]

impl Console: sys::LogService

impl Console: sys::RandomService

impl Console: sys::StdioService

fn Console.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
    match level {
        sys::LogLevel.Info => say(text: "log info ")
        sys::LogLevel.Warn => say(text: "log warn ")
        sys::LogLevel.Error => say(text: "log error ")
    }
    say(text: message)
    say(text: ": ")
    say(text: value)
    say(text: "\n")
} Console.log

fn Console.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
    for index in 0..<buf.len() {
        buf[index] = 0
    }
} Console.fill

fn Console.read_in(self, mut buf: SliceMut[u8]) -> usize limits stack 4_096 {
    return 0
} Console.read_in

fn Console.write_out(self, data: Slice[u8]) limits stack 4_096 {
    say_bytes(data)
} Console.write_out

fn Console.write_err(self, data: Slice[u8]) limits stack 4_096 {
    say_bytes(data)
} Console.write_err

fn say(text: Str) {
    say_bytes(text.as_bytes())
} say

fn say_bytes(bytes: Slice[u8]) {
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    for byte in bytes {
        mut uart.write(Uart.data, value: byte)
    }
    take uart.unmap()
} say_bytes

fn say_number(value: u64) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var left = value
    loop {
        digits[count] = b'0' + u8.truncate(left % 10)
        count += 1
        left = left / 10
        if left == 0 {
            break
        }
    }
    var uart = trusted "the board decodes port 0x3F8 to its first 16550 UART and nothing else maps it" { hw::Ports[Uart].map(0x3F8) }
    while count > 0 {
        count -= 1
        mut uart.write(Uart.data, value: digits[count])
    }
    take uart.unmap()
} say_number

/// Reads a big-endian number of `count` bytes from the fw_cfg data port.
fn read_be(mut data: hw::Ports[Data], count: u32) -> u64 {
    var value: u64 = 0
    for _ in 0..<count {
        value = (value << 8) | u64.widen(mut data.read(Data.byte))
    }
    return value
} read_be

/// The fw_cfg file of a name: its key and size, a zero key when there is none.
struct Found derives Copy {
    key: u16
    size: u64
} Found

fn find_file(mut data: hw::Ports[Data], name: Str) -> Found {
    var found = Found(key: 0, size: 0)
    for _ in 0..<read_be(mut data, count: 4) {
        let size = read_be(mut data, count: 4)
        let key = u16.truncate(read_be(mut data, count: 2))
        discard read_be(mut data, count: 2)
        var same = true
        for index in 0..<NAME_BYTES {
            let byte = mut data.read(Data.byte)
            var wanted: u8 = 0
            if index < name.as_bytes().len() {
                wanted = name.as_bytes()[index]
            }
            same = same and byte == wanted
        }
        if same {
            found = Found(key: key, size: size)
        }
    }
    return found
} find_file

/// The bytes of the fw_cfg file of a name, empty when there is none.
fn fw_file(name: Str, alloc: mem::Alloc) -> mem::Bytes {
    var selector = trusted "the board decodes port 0x510 to the fw_cfg selector" { hw::Ports[Selector].map(0x510) }
    var data = trusted "the board decodes port 0x511 to the fw_cfg data port" { hw::Ports[Data].map(0x511) }
    mut selector.write(Selector.key, value: DIRECTORY)
    let found = find_file(mut data, name)
    var bytes = mem::Bytes.empty(alloc)
    if found.key != 0 {
        mut selector.write(Selector.key, value: found.key)
        for _ in 0..<found.size {
            mut bytes.push(mut data.read(Data.byte))
        }
    }
    take selector.unmap()
    take data.unmap()
    return bytes
} fw_file

fn stop(text: Str) -> Never {
    say(text)
    loop {
    }
} stop

/// The bundle of a fw_cfg file, verified and prepared.
fn prepared(loader: sys::load::Loader, name: Str, alloc: mem::Alloc) -> sys::load::Prepared {
    let bytes = fw_file(name, alloc)
    let keys = Array[core::crypto::PublicKey, 1].filled(bundle_key())
    let Ok(ready) = attempt loader.prepare(bytes.view(), keys: keys.view(), alloc) else {
        stop(text: "unverified\n")
    }
    return ready
} prepared

/// What the kernel gives every instance.
struct Grants derives Copy {
    clock: sys::Clock
    console: Console
    exec: task::Executor
    alloc: mem::Alloc
} Grants

/// The world of an instance: its log, random source and standard streams served by the serial
/// port, its clock in its table under `clock` when `clocked`, and its file system and network
/// denied.
fn granted(grants: Grants, clocked: bool) -> nanos::World {
    var caps = nanos::Caps.empty(grants.alloc)
    if clocked {
        mut nanos::Cap[sys::Clock].put(mut caps, key: "clock", capability: grants.clock)
    }
    let Ok(log) = attempt sys::Log.served(grants.console) else {
        stop(text: "no log\n")
    }
    let Ok(random) = attempt sys::Random.served(grants.console) else {
        stop(text: "no random\n")
    }
    let Ok(stdio) = attempt sys::Stdio.served(grants.console) else {
        stop(text: "no stdio\n")
    }
    return nanos::World(alloc: grants.alloc, exec: grants.exec, clock: grants.clock, random: random, log: log, stdio: stdio, fs: sys::Fs.denied(), net: sys::Net.denied(), caps: take caps)
} granted

fn main(take k: boot::Kernel) -> Never limits stack 16_384 {
    let alloc = k.alloc()
    let clock = k.clock()
    let Some(loader) = k.loader() else {
        stop(text: "no loader\n")
    }
    take k.anchor(0u8, run: fn[take loader](exec: task::Executor) fails task::Cancelled uses wait limits stack 262_144 {
        let consoles = sys::Minter[Console, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc)
        let grants = Grants(clock: clock, console: consoles.mint(0), exec: exec, alloc: alloc)
        let Ok(loaded) = attempt prepared(loader, name: "opt/nan/counter", alloc).load() else {
            stop(text: "unloadable\n")
        }
        var bundle = loaded
        let served = attempt await serve(loader, mut bundle, grants)
        take bundle.unload()
        take consoles.close()
        discard served
    })
} main

fn serve(loader: sys::load::Loader, mut bundle: sys::load::Bundle, grants: Grants) fails nanos::InstanceError uses wait {
    let load = bundle.share()
    let Some(checkpoint) = try await nanos::hold(load, component: "Tally", world: granted(grants, clocked: true), checkpoint: None, runner: sys::Runner.denied(), exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) -> mem::Bytes fails nanos::InstanceError uses wait {
        return try await started(take instance, grants)
    }) else {
        stop(text: "no tally\n")
    }
    discard try await nanos::hold(load, component: "Tally", world: granted(grants, clocked: true), checkpoint: Some(take checkpoint), runner: sys::Runner.denied(), exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        try await restored(take instance, grants)
    })
    discard try await nanos::hold(load, component: "Tally", world: granted(grants, clocked: true), checkpoint: None, runner: sys::Runner.denied(), exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        try await trapped(take instance, grants)
    })
    discard try await nanos::hold(load, component: "Tally", world: granted(grants, clocked: false), checkpoint: None, runner: sys::Runner.denied(), exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        say(text: "unbuilt ")
        report(try await take instance.end(), alloc: grants.alloc)
    })
    let missing = try await nanos::hold(load, component: "Gauge", world: granted(grants, clocked: true), checkpoint: None, runner: sys::Runner.denied(), exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        discard try await take instance.end()
    })
    say(text: "gauge held ")
    say_flag(missing.is_some())
    try await ported(load, grants)
    discard try await nanos::hold(load, component: "Tally", world: granted(grants, clocked: true), checkpoint: None, runner: sys::Runner.denied(), exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        try await spun(take instance, grants)
    })
    discard load
    try await replaced(loader, mut bundle, grants)
} serve

/// Calls a handler of the tally that never returns, abandoning the instance's domain from a task
/// of its own while its holder steps the call.
fn spun(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var held = instance
    defer take held.abandon()
    var spin = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Counter].spin(mut spin)
    var pending = Some(take spin)
    var watching = Some(held.domain())
    say(text: "spun ")
    let outcome = attempt await task::scope(grants.exec, body: fn[mut held, mut pending, mut watching](s: task::Scope) fails nanos::InstanceError uses wait {
        let Some(request) = mut pending.extract() else {
            return
        }
        let Some(watched) = mut watching.extract() else {
            return
        }
        discard s.spawn(fn[take watched]() fails task::Cancelled uses wait limits stack 16_384 {
            try await grants.clock.sleep(10)
            watched.contents().trigger()
        })
        discard try await called(mut held, hash: sys::Wire[Counter].hash(), take request, grants)
    })
    match outcome {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    undefer held
    say(text: "spinner ")
    report(try await take held.end(), alloc: grants.alloc)
} spun

/// Holds the tally from a load of its bundle and replaces the bundle while calling it, then holds
/// it from a load of the replacement, writing the retired placements reclaim leaves while the
/// first instance runs and once it has ended.
fn replaced(loader: sys::load::Loader, mut bundle: sys::load::Bundle, grants: Grants) fails nanos::InstanceError uses wait {
    let original = bundle.share()
    discard try await nanos::hold(original, component: "Tally", world: granted(grants, clocked: true), checkpoint: None, runner: sys::Runner.denied(), exec: grants.exec, alloc: grants.alloc, body: fn[mut bundle](take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        var held = instance
        defer take held.abandon()
        let Ok(_) = attempt mut bundle.replace(prepared(loader, name: "opt/nan/counter", alloc: grants.alloc)) else {
            stop(text: "unreplaced\n")
        }
        say_left(try await loader.reclaim())
        undefer held
        try await added_once(take held, amount: 3, name: "replaced ", grants)
    })
    discard original
    say_left(try await loader.reclaim())
    let moved = bundle.share()
    discard try await nanos::hold(moved, component: "Tally", world: granted(grants, clocked: true), checkpoint: None, runner: sys::Runner.denied(), exec: grants.exec, alloc: grants.alloc, body: fn(take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        try await added_once(take instance, amount: 4, name: "moved ", grants)
    })
} replaced

/// Adds `amount` to the tally, then ends it, writing its total and how it ended after `name`.
fn added_once(take instance: nanos::Instance, amount: u32, name: Str, grants: Grants) fails nanos::InstanceError uses wait {
    var held = instance
    defer take held.abandon()
    var request = sys::Encoded.empty(grants.alloc)
    let add = sys::Wire[Counter].add(mut request, amount)
    let reply = try await called(mut held, hash: sys::Wire[Counter].hash(), take request, grants)
    say(text: "added ")
    say_number(added(add, given: reply, grants))
    say(text: "\n")
    undefer held
    say(text: name)
    report(try await take held.end(), alloc: grants.alloc)
} added_once

/// A line giving the retired placements reclaim left.
fn say_left(count: usize) {
    say(text: "left ")
    say_number(u64.widen(count))
    say(text: "\n")
} say_left

/// Starts the tally, calls it, asks after its health through the system interfaces and gives a
/// checkpoint of it once idle.
fn started(take instance: nanos::Instance, grants: Grants) -> mem::Bytes fails nanos::InstanceError uses wait {
    var held = instance
    defer take held.abandon()
    try await ticked(mut held, reason: sys::ResumeReason.Started)
    var five = sys::Encoded.empty(grants.alloc)
    let first_add = sys::Wire[Counter].add(mut five, amount: 5)
    let reply = try await called(mut held, hash: sys::Wire[Counter].hash(), request: take five, grants)
    say(text: "added ")
    say_number(added(first_add, given: reply, grants))
    say(text: "\n")
    var seven = sys::Encoded.empty(grants.alloc)
    let second_add = sys::Wire[Counter].add(mut seven, amount: 7)
    let total = try await called(mut held, hash: sys::Wire[Counter].hash(), request: take seven, grants)
    say(text: "added ")
    say_number(added(second_add, given: total, grants))
    say(text: "\n")
    var large = sys::Encoded.empty(grants.alloc)
    let refused = sys::Wire[Counter].add(mut large, amount: 5_000)
    let answer = try await called(mut held, hash: sys::Wire[Counter].hash(), request: take large, grants)
    say(text: "refused ")
    let Ok(encoded) = answer else {
        stop(text: "unserved\n")
    }
    let outcome = attempt refused.decode(Untrusted.of(encoded.bytes.view()), handles: encoded.handles.view(), alloc: grants.alloc)
    match outcome {
        Err(sys::CallError.Failed(refusals::Refused.TooLarge)) => say(text: "too large\n")
        else => say(text: "otherwise\n")
    }
    var echo = sys::Encoded.empty(grants.alloc)
    let echoed = sys::Wire[Counter].echo(mut echo, clock: grants.clock)
    let handed = try await called(mut held, hash: sys::Wire[Counter].hash(), request: take echo, grants)
    say(text: "echoed clock ")
    let Ok(handles) = handed else {
        stop(text: "unserved\n")
    }
    let Ok(clock) = attempt echoed.decode(Untrusted.of(handles.bytes.view()), handles: handles.handles.view(), alloc: grants.alloc) else {
        stop(text: "undecodable\n")
    }
    let reading = attempt clock.elapsed_ns()
    say_flag(reading.is_ok())
    var gauge = sys::Encoded.empty(grants.alloc)
    sys::Wire[Gauge].add(mut gauge, amount: 1)
    say(text: "mismatched ")
    match attempt await held.inbox().call(sys::Wire[Gauge].hash(), request: 0, encoding: take gauge, alloc: grants.alloc) {
        Err(sys::CallError.Malformed(core::DecodeError.UnknownSchema)) => say(text: "refused\n")
        else => say(text: "served\n")
    }
    say_health(try await mut held.health())
    try await mut held.pressure(2)
    try await mut held.suspend()
    say_health(try await mut held.health())
    try await mut held.wake()
    say_health(try await mut held.health())
    say(text: "idle ")
    say_flag(try await held.idle())
    let checkpoint = try await held.checkpoint()
    undefer held
    say(text: "started ")
    report(try await take held.end(), alloc: grants.alloc)
    return checkpoint
} started

/// Restores the tally from a checkpoint into a fresh instance and calls it.
fn restored(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var held = instance
    defer take held.abandon()
    try await ticked(mut held, reason: sys::ResumeReason.Restored)
    var one = sys::Encoded.empty(grants.alloc)
    let add = sys::Wire[Counter].add(mut one, amount: 1)
    let reply = try await called(mut held, hash: sys::Wire[Counter].hash(), request: take one, grants)
    say(text: "added ")
    say_number(added(add, given: reply, grants))
    say(text: "\n")
    say_health(try await mut held.health())
    undefer held
    say(text: "restored ")
    report(try await take held.end(), alloc: grants.alloc)
} restored

/// Calls a handler of the tally that traps, which abandons the instance's domain.
fn trapped(take instance: nanos::Instance, grants: Grants) fails nanos::InstanceError uses wait {
    var held = instance
    defer take held.abandon()
    var zero = sys::Encoded.empty(grants.alloc)
    discard sys::Wire[Counter].divide(mut zero, by: 0)
    say(text: "divided ")
    match attempt await called(mut held, hash: sys::Wire[Counter].hash(), request: take zero, grants) {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    say(text: "stepped ")
    match attempt await mut held.step() {
        Err(nanos::InstanceError.Ended) => say(text: "ended\n")
        else => say(text: "otherwise\n")
    }
    undefer held
    say(text: "divider ")
    report(try await take held.end(), alloc: grants.alloc)
} trapped

/// Resumes the tally for a reason, then starts the keyed task its resume spawns and steps the tick
/// that task posts.
fn ticked(mut instance: nanos::Instance, reason: sys::ResumeReason) fails nanos::InstanceError uses wait {
    try await mut instance.resumed(reason)
    say(text: "keyed ")
    say_number(u64.widen(try await mut instance.start_keyed()))
    say(text: "\n")
    try await instance.incoming()
    say(text: "ticked ")
    say_flag(try await mut instance.step())
} ticked

/// The reply of the held instance to a call made under the protocol hash `hash`, which the
/// instance handles in the next step its holder takes, closed when the instance postpones it.
fn called(mut instance: nanos::Instance, hash: sys::ProtocolHash, take request: sys::Encoded, grants: Grants) -> Result[sys::Encoded, sys::CallError[Never]] fails nanos::InstanceError uses wait {
    match try await answered(mut instance, hash, number: 0, take request, grants) {
        Ok(Some(reply)) => return Ok(take reply)
        Ok(None) => return Err(sys::CallError.Closed(task::SendError.Closed))
        Err(failure) => return Err(take failure)
    }
} called

/// The reply of the held instance to a call made under the protocol hash `hash` and numbered
/// `number`, which the instance handles in the next step its holder takes, none when the instance
/// postpones it.
fn answered(mut instance: nanos::Instance, hash: sys::ProtocolHash, number: u64, take request: sys::Encoded, grants: Grants) -> Result[Option[sys::Encoded], sys::CallError[Never]] fails nanos::InstanceError uses wait {
    var pending = Some(take request)
    var reply: Result[Option[sys::Encoded], sys::CallError[Never]] = Err(sys::CallError.Closed(task::SendError.Closed))
    try await task::scope(grants.exec, body: fn[mut instance, mut pending, mut reply](s: task::Scope) fails nanos::InstanceError uses wait {
        let Some(call) = mut pending.extract() else {
            return
        }
        let inbox = instance.inbox()
        let replied = s.spawn(fn[take inbox, take call]() -> Result[Option[sys::Encoded], sys::CallError[Never]] fails task::Cancelled uses wait limits stack 16_384 {
            return attempt await inbox.call(hash, request: number, encoding: take call, alloc: grants.alloc)
        })
        try await instance.incoming()
        discard try await mut instance.step()
        reply = try await take replied.join()
    })
    return reply
} answered

/// A store serving the file `note`, numbered by the length of its path, writing each release.
struct Notes {
} Notes

impl Notes: sys::Kind[core::atomic::AtomicU64, u64]

impl Notes: sys::FsService

fn Notes.open(self, path: Str) -> u64 limits stack 4_096 {
    return u64.widen(path.byte_len())
} Notes.open

fn Notes.create(self, path: Str) -> u64 fails sys::fs::FsError limits stack 4_096 {
    fail sys::fs::FsError.Denied
} Notes.create

fn Notes.read_all(self, path: Str, alloc: mem::Alloc) -> mem::Bytes fails sys::fs::FsError limits stack 4_096 {
    fail sys::fs::FsError.Denied
} Notes.read_all

fn Notes.write_all(self, path: Str, data: Slice[u8]) fails sys::fs::FsError limits stack 4_096 {
    fail sys::fs::FsError.Denied
} Notes.write_all

fn Notes.remove(self, path: Str) fails sys::fs::FsError limits stack 4_096 {
    fail sys::fs::FsError.Denied
} Notes.remove

fn Notes.read(self, file: u64, mut buf: SliceMut[u8]) -> usize limits stack 4_096 {
    return 0
} Notes.read

fn Notes.write(self, file: u64, data: Slice[u8]) -> usize fails sys::fs::FsError limits stack 4_096 {
    fail sys::fs::FsError.Denied
} Notes.write

fn Notes.byte_len(self, file: u64) -> u64 limits stack 4_096 {
    return file
} Notes.byte_len

fn Notes.release(self, file: u64) limits stack 4_096 {
    say(text: "fs release ")
    say_number(file)
    say(text: "\n")
} Notes.release

/// The runner the kernel serves its instances, recording 0 for the tally and 1 for the relay: it
/// carries each call made through a port to the kernel task holding the instances, keeps each
/// call sent through a port and each reply given, writes each published total, counts syncs,
/// holds the kernel's clock as capability 7 until it is dropped, and holds resources by number,
/// writing each it lends, takes back or gives away.
struct Wired {
} Wired

impl Wired: sys::Kind[Wiring, u64]

impl Wired: sys::RunnerService

struct Wiring {
    alloc: mem::Alloc
    forwarding: task::Sender[Forwarded]
    sent: mem::OnceMap[u64, mem::Bytes]
    sends: core::atomic::AtomicU64
    replies: mem::OnceMap[u64, mem::Bytes]
    syncs: core::atomic::AtomicU64
    clock: sys::Clock
    dropped: core::atomic::AtomicU64
    keeper: Keeper
} Wiring

/// What keeps the resources the runner holds by number, apart from its state, which every
/// operation of the runner reaches.
struct Keeper {
} Keeper

impl Keeper: sys::Kind[task::Cown[mem::Map[u64, sys::Held]], u64]

/// A call made through a port, with the sender of its reply.
struct Forwarded {
    port: u64
    hash: sys::ProtocolHash
    request: sys::Encoded
    answer: task::Sender[sys::Encoded]
} Forwarded

fn Wired.send_to(self, port: u64, hash: sys::ProtocolHash, bytes: Slice[u8], handles: Slice[sys::Handle]) limits stack 4_096 {
    discard sys::reach(self, body: fn(state: Wiring, record: u64) {
        let Some(at) = state.sends.fetch_add(1) else {
            return
        }
        discard state.sent.insert(at, value: copied(bytes, alloc: state.alloc))
    })
} Wired.send_to

fn Wired.call(self, port: u64, hash: sys::ProtocolHash, bytes: Slice[u8], handles: Slice[sys::Handle], alloc: mem::Alloc) -> sys::Encoded fails sys::RunnerError uses wait limits stack 4_096 {
    let Some(forwarding) = sys::reach(self, body: fn(state: Wiring, record: u64) => state.forwarding.split()) else {
        fail sys::RunnerError.Unknown
    }
    var request = sys::Encoded(bytes: copied(bytes, alloc), handles: mem::List[sys::Handle].empty(alloc))
    for handle in handles {
        mut request.handles.push(handle)
    }
    let task::Channel(sender: answer, receiver: answers) = task::Channel[sys::Encoded].bounded(1, alloc)
    match attempt await forwarding.send(Forwarded(port: port, hash: hash, request: take request, answer: take answer)) {
        Ok(_) => {}
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        Err(task::SendError.Closed) => fail sys::RunnerError.Unknown
    }
    var receiver = answers
    let Some(reply) = try await mut receiver.receive() else {
        fail sys::RunnerError.Unknown
    }
    return reply
} Wired.call

fn Wired.reply(self, request: u64, bytes: Slice[u8], handles: Slice[sys::Handle]) limits stack 4_096 {
    discard sys::reach(self, body: fn(state: Wiring, record: u64) {
        discard state.replies.insert(request, value: copied(bytes, alloc: state.alloc))
    })
} Wired.reply

fn Wired.publish(self, summary: Slice[u8]) limits stack 4_096 {
    let decoded = sys::reach(self, body: fn(state: Wiring, record: u64) -> Result[u64, core::DecodeError] {
        let copy = copied(summary, alloc: state.alloc)
        return attempt mem::wire::Codec[u64].decode(Untrusted.of(copy.view()), alloc: state.alloc)
    })
    let Some(Ok(total)) = decoded else {
        say(text: "published otherwise\n")
        return
    }
    say(text: "published total ")
    say_number(total)
    say(text: "\n")
} Wired.publish

fn Wired.sync(self) limits stack 4_096 {
    discard sys::reach(self, body: fn(state: Wiring, record: u64) => state.syncs.fetch_add(1))
} Wired.sync

fn Wired.capability(self, id: u64) -> sys::Handle fails sys::RunnerError limits stack 4_096 {
    let held = sys::reach(self, body: fn(state: Wiring, record: u64) -> Option[sys::Clock] {
        if id != 7 or state.dropped.load() != 0 {
            return None
        }
        return Some(state.clock)
    })
    let Some(Some(clock)) = held else {
        fail sys::RunnerError.Unknown
    }
    return sys::Handle.of(clock)
} Wired.capability

fn Wired.drop_capability(self, id: u64) limits stack 4_096 {
    discard sys::reach(self, body: fn(state: Wiring, record: u64) => state.dropped.fetch_add(1))
    say(text: "dropped capability ")
    say_number(id)
    say(text: "\n")
} Wired.drop_capability

fn Wired.resource(self, id: u64) -> sys::Held fails sys::RunnerError uses wait limits stack 8_192 {
    let resource = try await self.removed(id)
    say(text: "lent resource ")
    say_number(id)
    say(text: "\n")
    return resource
} Wired.resource

fn Wired.take_resource(self, id: u64) -> sys::Held fails sys::RunnerError uses wait limits stack 8_192 {
    let resource = try await self.removed(id)
    say(text: "gave resource ")
    say_number(id)
    say(text: "\n")
    return resource
} Wired.take_resource

fn Wired.put_resource(self, id: u64, take resource: sys::Held) fails sys::RunnerError uses wait limits stack 8_192 {
    let Some(held) = self.kept() else {
        fail sys::RunnerError.Unknown
    }
    await when mut held {
        discard mut held.insert(id, value: take resource)
    }
    say(text: "put resource ")
    say_number(id)
    say(text: "\n")
} Wired.put_resource

/// The resources the runner holds by number, none once its keeper is closed.
fn Wired.kept(self) -> Option[task::Cown[mem::Map[u64, sys::Held]]] {
    let Some(keeper) = sys::reach(self, body: fn(state: Wiring, record: u64) => state.keeper) else {
        return None
    }
    return sys::reach(keeper, body: fn(state: task::Cown[mem::Map[u64, sys::Held]], record: u64) => state.share())
} Wired.kept

/// The resource the runner holds under `id`, which it no longer holds.
fn Wired.removed(self, id: u64) -> sys::Held fails sys::RunnerError uses wait {
    let Some(held) = self.kept() else {
        fail sys::RunnerError.Unknown
    }
    let Some(resource) = await when mut held => mut held.remove(id) else {
        fail sys::RunnerError.Unknown
    }
    return resource
} Wired.removed

fn copied(bytes: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var copy = mem::Bytes.empty(alloc)
    mut copy.append(bytes)
    return copy
} copied

/// The copy of the bytes the runner the kernel serves keeps under `key`, among the replies given
/// when `replies` and among the calls sent otherwise, none when it keeps none.
fn kept(runner: Wired, key: u64, replies: bool) -> Option[mem::Bytes] {
    let found = sys::reach(runner, body: fn(state: Wiring, record: u64) -> Option[mem::Bytes] {
        if replies {
            return copy_of(state.replies.get(key), alloc: state.alloc)
        }
        return copy_of(state.sent.get(key), alloc: state.alloc)
    })
    let Some(Some(bytes)) = found else {
        return None
    }
    return Some(take bytes)
} kept

fn copy_of(held: Option[mem::Bytes], alloc: mem::Alloc) -> Option[mem::Bytes] {
    let Some(bytes) = held else {
        return None
    }
    return Some(copied(bytes.view(), alloc))
} copy_of

/// Holds the tally and, from a task of its own, a relay calling it through the ports of a runner
/// the kernel serves both, writing what they exchange through it, then ends both.
fn ported(load: sys::load::Load, grants: Grants) fails nanos::InstanceError uses wait {
    let notes = sys::Minter[Notes, core::atomic::AtomicU64, u64].of(core::atomic::AtomicU64.of(0), alloc: grants.alloc)
    defer take notes.close()
    let Ok(noting) = attempt sys::Fs.served(notes.mint(0)) else {
        stop(text: "unserved\n")
    }
    let Ok(note) = attempt await noting.open("note") else {
        stop(text: "unopened\n")
    }
    var held = mem::Map[u64, sys::Held].empty(grants.alloc)
    discard mut held.insert(3, value: take note.held())
    let keeping = sys::Minter[Keeper, task::Cown[mem::Map[u64, sys::Held]], u64].of(task::Cown.of(take held, alloc: grants.alloc), alloc: grants.alloc)
    defer take keeping.close()
    let task::Channel(sender: forwarding, receiver: forwarded) = task::Channel[Forwarded].bounded(1, alloc: grants.alloc)
    let wiring = sys::Minter[Wired, Wiring, u64].of(Wiring(alloc: grants.alloc, forwarding: take forwarding, sent: mem::OnceMap[u64, mem::Bytes].empty(1, alloc: grants.alloc), sends: core::atomic::AtomicU64.of(0), replies: mem::OnceMap[u64, mem::Bytes].empty(2, alloc: grants.alloc), syncs: core::atomic::AtomicU64.of(0), clock: grants.clock, dropped: core::atomic::AtomicU64.of(0), keeper: keeping.mint(0)), alloc: grants.alloc)
    defer take wiring.close()
    let wired = wiring.mint(0)
    let Ok(tallied) = attempt sys::Runner.served(wiring.mint(0)) else {
        stop(text: "unserved\n")
    }
    let Ok(relaying) = attempt sys::Runner.served(wiring.mint(1)) else {
        stop(text: "unserved\n")
    }
    var calls = Some(take forwarded)
    discard try await nanos::hold(load, component: "Tally", world: granted(grants, clocked: true), checkpoint: None, runner: tallied, exec: grants.exec, alloc: grants.alloc, body: fn[mut calls](take instance: nanos::Instance) fails nanos::InstanceError uses wait {
        var tally = instance
        defer take tally.abandon()
        try await task::scope(grants.exec, body: fn[mut tally, mut calls](s: task::Scope) fails nanos::InstanceError uses wait {
            let Some(receiver) = mut calls.extract() else {
                return
            }
            let task::Channel(sender: cues, receiver: cued) = task::Channel[u8].bounded(1, alloc: grants.alloc)
            let shared = load.share()
            let relay = s.spawn(fn[take shared, take cues]() fails nanos::InstanceError uses wait limits stack 131_072 {
                discard try await nanos::hold(shared, component: "Relay", world: granted(grants, clocked: false), checkpoint: None, runner: relaying, exec: grants.exec, alloc: grants.alloc, body: fn(take relay: nanos::Instance) fails nanos::InstanceError uses wait {
                    try await relays(take relay, cues, grants)
                })
                discard shared
            })
            try await tallies(mut tally, forwarded: take receiver, take cued, wired, grants)
            try await take relay.join()
        })
        undefer tally
        say(text: "tally ")
        report(try await take tally.end(), alloc: grants.alloc)
    })
} ported

/// Has the relay call the tally through port 1, answered at once, then through port 2, whose call
/// the tally's holder holds pending, then send the settlement that has the tally reply to it,
/// cueing the tally's holder once it is sent, then, once it has the reply, has it read and drop
/// the clock its runner holds for it, then borrow, put back, take and drop the file its runner
/// holds for it, and ends it.
fn relays(take relay: nanos::Instance, cues: task::Sender[u8], grants: Grants) fails nanos::InstanceError uses wait {
    var relaying = relay
    defer take relaying.abandon()
    var relayed = sys::Encoded.empty(grants.alloc)
    sys::Wire[Front].relay(mut relayed, amount: 2)
    discard try await called(mut relaying, hash: sys::Wire[Front].hash(), request: take relayed, grants)
    say(text: "relay keyed ")
    say_number(u64.widen(try await mut relaying.start_keyed()))
    say(text: "\n")
    try await relaying.incoming()
    discard try await mut relaying.step()
    var awaiting = sys::Encoded.empty(grants.alloc)
    sys::Wire[Front].await_total(mut awaiting)
    discard try await called(mut relaying, hash: sys::Wire[Front].hash(), request: take awaiting, grants)
    discard try await mut relaying.start_keyed()
    var settling = sys::Encoded.empty(grants.alloc)
    sys::Wire[Front].settle(mut settling)
    discard try await called(mut relaying, hash: sys::Wire[Front].hash(), request: take settling, grants)
    discard attempt await cues.send(1)
    try await relaying.incoming()
    discard try await mut relaying.step()
    var clocking = sys::Encoded.empty(grants.alloc)
    sys::Wire[Front].clocked(mut clocking)
    discard try await called(mut relaying, hash: sys::Wire[Front].hash(), request: take clocking, grants)
    var noting = sys::Encoded.empty(grants.alloc)
    sys::Wire[Front].noted(mut noting)
    discard try await called(mut relaying, hash: sys::Wire[Front].hash(), request: take noting, grants)
    discard try await mut relaying.start_keyed()
    try await relaying.incoming()
    discard try await mut relaying.step()
    undefer relaying
    say(text: "relay ")
    match try await take relaying.end() {
        nanos::Ended.Returned(_) => say(text: "returned\n")
        else => say(text: "otherwise\n")
    }
} relays

/// Serves the relay's calls through ports on the tally: the first at once, the second as the
/// tally's request 1, which the tally postpones until the relay's cue says the settlement it sent
/// through port 1 waits, which the tally then handles, replying to the request, publishing its
/// total and asking to sync, which writes its state.
fn tallies(mut tally: nanos::Instance, take forwarded: task::Receiver[Forwarded], take cued: task::Receiver[u8], wired: Wired, grants: Grants) fails nanos::InstanceError uses wait {
    var receiver = forwarded
    var cues = cued
    let Some(addition) = try await mut receiver.receive() else {
        stop(text: "unforwarded\n")
    }
    try await carried(mut tally, forwarded: take addition, grants)
    let Some(pending) = try await mut receiver.receive() else {
        stop(text: "unforwarded\n")
    }
    let Forwarded(port: port, hash: hash, request: request, answer: waiting) = pending
    say(text: "pending port ")
    say_number(port)
    say(text: "\n")
    let Ok(None) = try await answered(mut tally, hash, number: 1, take request, grants) else {
        stop(text: "unpostponed\n")
    }
    discard try await mut cues.receive()
    let Some(sent) = kept(wired, key: 0, replies: false) else {
        stop(text: "unsent\n")
    }
    discard try await called(mut tally, hash: sys::Wire[Counter].hash(), request: sys::Encoded(bytes: take sent, handles: mem::List[sys::Handle].empty(grants.alloc)), grants)
    let synced = sys::reach(wired, body: fn(state: Wiring, record: u64) => state.syncs.load())
    if synced == Some(1) {
        let checkpoint = try await tally.checkpoint()
        say(text: "synced ")
        report(nanos::Ended.Returned(take checkpoint), alloc: grants.alloc)
    }
    let Some(replied) = kept(wired, key: 1, replies: true) else {
        stop(text: "unreplied\n")
    }
    discard attempt await waiting.send(sys::Encoded(bytes: take replied, handles: mem::List[sys::Handle].empty(grants.alloc)))
} tallies

/// Serves a call the relay made through a port by calling the tally with it, giving the tally's
/// reply to the relay's wait, which ends without one when the tally gives none.
fn carried(mut tally: nanos::Instance, take forwarded: Forwarded, grants: Grants) fails nanos::InstanceError uses wait {
    let Forwarded(port: _, hash: hash, request: request, answer: answer) = forwarded
    let Ok(reply) = try await called(mut tally, hash, take request, grants) else {
        return
    }
    discard attempt await answer.send(take reply)
} carried

/// The total an addition's reply gives, zero when it gives none.
fn added(reply: sys::Reply[u64, refusals::Refused], given: Result[sys::Encoded, sys::CallError[Never]], grants: Grants) -> u64 {
    let Ok(encoded) = given else {
        return 0
    }
    let Ok(total) = attempt reply.decode(Untrusted.of(encoded.bytes.view()), handles: encoded.handles.view(), alloc: grants.alloc) else {
        return 0
    }
    return total
} added

fn say_flag(flag: bool) {
    if flag {
        say(text: "true\n")
    } else {
        say(text: "false\n")
    }
} say_flag

fn say_health(reply: sys::HealthReply) {
    match reply {
        sys::HealthReply.Healthy => say(text: "healthy\n")
        sys::HealthReply.Unhealthy(reason) => {
            say(text: "unhealthy ")
            say(text: reason.as_str())
            say(text: "\n")
        }
    }
} say_health

/// Writes how an instance ended: its last state's total and ticks, the kind of the trap that
/// abandoned it, or the failure building its Env.
fn report(take ended: nanos::Ended, alloc: mem::Alloc) {
    match ended {
        nanos::Ended.Returned(bytes) => match attempt mem::wire::Codec[Tally].decode(Untrusted.of(bytes.view()), alloc) {
            Ok(state) => {
                say(text: "total ")
                say_number(state.total)
                say(text: " ticks ")
                say_number(state.ticks)
                say(text: "\n")
            }
            Err(_) => say(text: "undecodable\n")
        }
        nanos::Ended.Failed(rendered) => {
            say(text: "failed ")
            say(text: rendered.as_str())
            say(text: "\n")
        }
        nanos::Ended.Trapped(trap) => match trap.kind() {
            sys::TrapKind.DivisionByZero => say(text: "trapped trap.division-by-zero\n")
            else => say(text: "trapped otherwise\n")
        }
        nanos::Ended.Cancelled => say(text: "cancelled\n")
        nanos::Ended.Abandoned => say(text: "abandoned\n")
        nanos::Ended.Undecodable => say(text: "undecodable\n")
    }
} report

fn bundle_key() -> core::crypto::PublicKey {
    var bytes = Array[u8, 32].filled(0)
    mut bytes.view_mut().copy_from(SIGNER)
    return core::crypto::PublicKey(bytes: bytes)
} bundle_key
