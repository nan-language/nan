//! Acceptance tests of the climate statistics.

test summaries_round_the_mean_toward_zero for summarize {
    var cold_days = Array[i32, 2].filled(-5)
    cold_days[1] = -6
    expect summarize(cold_days.view()) == Some(Summary(low: -6, high: -5, mean: -5))
    var mixed_days = Array[i32, 3].filled(30)
    mixed_days[1] = -10
    mixed_days[2] = 7
    expect summarize(mixed_days.view()) == Some(Summary(low: -10, high: 30, mean: 9))
    let no_days = mem::List[i32].empty(testing::world().alloc)
    expect summarize(no_days.view()) == None
} summaries_round_the_mean_toward_zero

test changes_within_the_tolerance_are_steady for trend {
    expect trend(10, after: 15, tolerance: 5) == Trend.Steady
    expect trend(10, after: 16, tolerance: 5) == Trend.Rising
    expect trend(10, after: 5, tolerance: 5) == Trend.Steady
    expect trend(10, after: 4, tolerance: 5) == Trend.Falling
    expect trend(-2_147_483_648, after: 2_147_483_647, tolerance: 0) == Trend.Rising
} changes_within_the_tolerance_are_steady

test frost_counts_readings_at_or_below_zero for frost_count {
    var winter_days = Array[i32, 4].filled(0)
    winter_days[1] = 1
    winter_days[2] = -3
    winter_days[3] = 2
    expect frost_count(winter_days.view()) == 2
} frost_counts_readings_at_or_below_zero

test rises_count_consecutive_increases for rises {
    var spring_days = Array[i32, 5].filled(5)
    spring_days[0] = 1
    spring_days[3] = 9
    spring_days[4] = 2
    expect rises(spring_days.view(), tolerance: 1) == 2
    expect rises(spring_days.view(), tolerance: 4) == 0
} rises_count_consecutive_increases
