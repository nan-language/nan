    \\pub fn Set.insert(mut self, take value: T) -> bool
    \\    ensures result != old(self.contains(value))
    \\    ensures match result {
    \\        true => self.len() > 0 and self.len() - 1 == old(self.len())
    \\        false => self.len() == old(self.len())
    \\    }
    \\    example Set[u8].empty(testing::world().alloc).insert(1)
    \\
    \\pub fn Set.try_insert(mut self, take value: T) -> bool fails OutOfMemory
    \\    ensures result != old(self.contains(value))
    \\    ensures match result {
    \\        true => self.len() > 0 and self.len() - 1 == old(self.len())
    \\        false => self.len() == old(self.len())
    \\    }
    \\    example attempt Set[u8].empty(testing::world().alloc).try_insert(1) == Ok(true)
    \\
    \\pub fn Set.remove(mut self, value: T) -> bool
    \\    ensures result == old(self.contains(value))
    \\    ensures not self.contains(value)
    \\    ensures match result {
    \\        true => old(self.len()) > 0 and self.len() == old(self.len()) - 1
    \\        false => self.len() == old(self.len())
    \\    }
    \\    example not Set[u8].empty(testing::world().alloc).remove(1)
