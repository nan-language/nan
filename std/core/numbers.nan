pub fn usize.count_ones(self) -> u32 limits pure, notrap, terminates
    ensures result <= 64
    example 0b1011usize.count_ones() == 3

pub fn usize.leading_zeros(self) -> u32 limits pure, notrap, terminates
    ensures result <= 64
