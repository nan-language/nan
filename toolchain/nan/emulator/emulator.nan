//! The emulator the machine targets' descriptors name: whether a target's images can run on this machine, the invocation booting a machine image under the emulator, its boots with the TPM emulator serving them, and boots bounded in host processor time.

/// The firmware an `x86_64-uefi` image boots through, its codes and the templates of their
/// variables, paired by position, and their fallbacks across distributions, the builds reaching
/// the TPM first, separated by spaces.
const OVMF_CODE: Str = "/usr/share/edk2/ovmf/OVMF_CODE_4M.qcow2 /usr/share/edk2/ovmf/OVMF_CODE.fd /usr/share/OVMF/OVMF_CODE.fd /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/edk2/x64/OVMF_CODE.4m.fd"

const OVMF_VARS: Str = "/usr/share/edk2/ovmf/OVMF_VARS_4M.qcow2 /usr/share/edk2/ovmf/OVMF_VARS.fd /usr/share/OVMF/OVMF_VARS.fd /usr/share/OVMF/OVMF_VARS_4M.fd /usr/share/edk2/x64/OVMF_VARS.4m.fd"

/// The firmware setting that makes OVMF place every PCI device's memory below 4 GiB, where the
/// entry root maps devices.
const BARS_BELOW_4_GIB: Str = "name=opt/ovmf/X-PciMmio64Mb,string=0"

/// The firmware an `aarch64-uefi` image boots through, its codes and the templates of their
/// variables, paired by position, each a flash image padded to the size of the `virt` board's
/// flash, and their fallbacks across distributions, the builds reaching the TPM first, separated
/// by spaces.
const AAVMF_CODE: Str = "/usr/share/AAVMF/AAVMF_CODE.secboot.fd /usr/share/AAVMF/AAVMF_CODE.fd /usr/share/edk2/aarch64/QEMU_EFI-pflash.raw"

const AAVMF_VARS: Str = "/usr/share/AAVMF/AAVMF_VARS.fd /usr/share/AAVMF/AAVMF_VARS.fd /usr/share/edk2/aarch64/vars-template-pflash.raw"

/// The emulator program of an architecture's machine targets.
fn program(arch: workspace::Arch, alloc: mem::Alloc) -> text::String {
    let name = match arch {
        workspace::Arch.Amd64 => "qemu-system-x86_64"
        workspace::Arch.Aarch64 => "qemu-system-aarch64"
    }
    return text::String.of(name, alloc)
} program

/// The TPM emulator serving each boot's TPM, and its arguments, separated by spaces.
const TPM_PROGRAM: Str = "swtpm"

const TPM_ARGS: Str = "socket --tpm2 --tpmstate dir=tpm --ctrl type=unixio,path=tpm.sock --terminate"

/// The files of a machine directory, which the emulator and the TPM emulator run in: the disk,
/// the firmware's variables, the TPM's state directory and the TPM's socket.
const DISK: Str = "disk.raw"

const VARS: Str = "vars.fd"

const TPM_STATE: Str = "tpm"

const TPM_SOCKET: Str = "tpm.sock"

/// The size of a machine's disk.
const DISK_BYTES: u64 = 268_435_456

/// The status of a run under the emulator that ends other than by a write to the exit port.
pkg const OTHER_END: u8 = 70

/// The milliseconds of host processor time a bounded boot may use.
const PROCESSOR_TIME: u64 = 10_000

/// The nanoseconds a bounded boot lasts at most: only a machine that waits forever without using
/// its processor time reaches it.
const WALL_TIME: u64 = 120_000_000_000

/// The milliseconds between two readings of a bounded boot's processor time, and between two
/// looks for the TPM emulator's socket.
const POLL: i32 = 5

/// The nanoseconds the TPM emulator may take to open its socket.
const TPM_WAIT: u64 = 10_000_000_000

/// The clock ticks per second of the processor times `/proc` gives, USER_HZ.
const TICKS_PER_SECOND: u64 = 100

/// The positions of a process's user and system times among the fields of its `/proc` stat that
/// follow its command name.
const USER_TIME: usize = 11

const SYSTEM_TIME: usize = 12

/// How a launch boots a machine.
pkg enum Boots {
    /// The boots of a run: the machine's disk, firmware variables and TPM state persist in the
    /// machine directory `dir`, its console port is the socket there, and a reset reboots the
    /// machine when `resets` holds and ends the run otherwise.
    Kept(dir: text::String, resets: bool)
    /// The boots of a test run: each finds the machine as the launch made it, its network
    /// restricted to the machine and its console port unconnected, and a reset ends it.
    Fresh
} Boots

/// The emulator arguments common to every machine run of an architecture: the machine with its
/// IOMMU first, on x86_64 accelerated by KVM when `kvm` holds, processors, memory, entropy
/// device, exit port, TPM, watchdog, disk and network device, each virtio PCI device modern and
/// behind the IOMMU, no display, the serial port on the standard streams then the console port,
/// and an end with the process that starts it. `kept` holds whether a run's boots keep resets,
/// and is none for a test run's.
fn base_args(arch: workspace::Arch, kvm: bool, kept: Option[bool], alloc: mem::Alloc) -> mem::List[text::String] {
    var written = text::String.of("-run-with exit-with-parent=on ", alloc)
    match arch {
        workspace::Arch.Amd64 => {
            mut written.append("-machine q35 -device intel-iommu,intremap=on,aw-bits=48 ")
            if kvm {
                mut written.append("-accel kvm,kernel-irqchip=split -cpu host,+invtsc")
            } else {
                mut written.append("-accel tcg -cpu max")
            }
            mut written.append(" -smp 4 -m 512M -device virtio-rng-pci,iommu_platform=on,disable-legacy=on -device isa-debug-exit,iobase=0xf4,iosize=0x01 -device tpm-crb,tpmdev=tpm")
        }
        workspace::Arch.Aarch64 => mut written.append("-machine virt,gic-version=3,its=on,iommu=smmuv3,highmem-ecam=off -accel tcg -cpu cortex-a72 -smp 4 -m 512M -global virtio-mmio.force-legacy=false -device virtio-rng-device -semihosting-config enable=on,target=native -device tpm-tis-device,tpmdev=tpm")
    }
    mut written.append(" -chardev socket,id=tpm,path=tpm.sock -tpmdev emulator,id=tpm,chardev=tpm -device i6300esb -device virtio-blk-pci,drive=disk,iommu_platform=on,disable-legacy=on -device virtio-net-pci,netdev=net,romfile=,iommu_platform=on,disable-legacy=on -display none -nodefaults -monitor none -serial stdio")
    match kept {
        Some(_) => mut written.append(" -serial unix:console.sock,server=on,wait=off -drive if=none,id=disk,format=raw,file=disk.raw -netdev user,id=net")
        None => mut written.append(" -serial null -drive if=none,id=disk,format=raw,file=disk.raw,snapshot=on -netdev user,id=net,restrict=on")
    }
    if kept != Some(true) {
        mut written.append(" -no-reboot")
    }
    return words_of(written.as_str(), alloc)
} base_args

/// Whether the emulator accelerates an architecture's machines with KVM: x86_64 ones when this
/// machine is x86_64 and this process may read and write `/dev/kvm`.
fn kvm_usable(arch: workspace::Arch) -> bool {
    return arch == workspace::Arch.Amd64 and workspace::Arch.running() == arch and platform::may_read_write("/dev/kvm")
} kvm_usable

/// The words of a text separated by spaces.
fn words_of(written: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var parts = mem::List[text::String].empty(alloc)
    let bytes = written.as_bytes()
    expect bytes.len() < ~0usize
    var start: usize = 0
    for at in 0..=bytes.len() {
        if at < bytes.len() and bytes[at] != b' ' {
            continue
        }
        let Some(part) = written.slice_bytes(start, end: at) else {
            return parts
        }
        mut parts.push(text::String.of(part, alloc))
        start = at + 1
    }
    return parts
} words_of

/// The machine directory a launch boots in, holding the machine's disk, firmware variables, TPM
/// state and sockets, and whether every boot makes its TPM state anew.
pkg struct Machine {
    pkg dir: text::String
    fresh: bool
} Machine

/// What `nan run` starts once it has built an image: the image on a host target, the emulator
/// booting it on a machine target, and its arguments.
pkg struct Launch {
    pkg program: text::String
    pkg args: mem::List[text::String]
    /// The machine directory of the emulator, whose end gives the run's status; none for an
    /// image.
    pkg machine: Option[Machine]
} Launch

/// Starts the program and gives the status the run ends with: the image replaces this process,
/// so that termination requests reach it and its status is the run's, the status being 101 when
/// the system refuses to start it; the emulator runs as a child, and the status the run ends with
/// is given once it ends.
pkg fn Launch.start(self, alloc: mem::Alloc) -> u8 {
    match self.machine {
        Some(machine) => return run(self, machine, alloc)
        None => {}
    }
    discard platform::replace_process(self.program.as_str(), args: self.args.view(), alloc)
    return 101
} Launch.start

/// Whether a target's images can run on this machine: a host target's when the machine has its
/// architecture, and a machine target's when its emulator can start, the emulator program running
/// and able to end with the process that starts it, the TPM emulator running, and the firmware
/// present for a UEFI target.
pkg fn available(target: workspace::Target, alloc: mem::Alloc) -> bool {
    let Some(arch) = target.arch() else {
        return false
    }
    if target.is_host() {
        return arch == workspace::Arch.running()
    }
    let args = words_of("-run-with help", alloc)
    let runs = match attempt platform::run_output(program(arch, alloc).as_str(), args: args.view(), input: None, capture_errors: false, alloc) {
        Ok(ran) => holds(ran.stdout.view(), wanted: b"exit-with-parent")
        Err(_) => false
    }
    let version = words_of("--version", alloc)
    let tpm = match attempt platform::run_output(TPM_PROGRAM, args: version.view(), input: None, capture_errors: false, alloc) {
        Ok(ran) => ran.status.is_success()
        Err(_) => false
    }
    let pair = firmware(arch, alloc)
    return runs and tpm and (target.kind() != Some(workspace::Kind.Uefi) or (platform::exists(pair.code.as_str()) and platform::exists(pair.vars.as_str())))
} available

/// Whether bytes hold a run of bytes.
fn holds(bytes: Slice[u8], wanted: Slice[u8]) -> bool {
    if wanted.len() > bytes.len() {
        return false
    }
    for start in 0..=(bytes.len() - wanted.len()) {
        let Some(parts) = bytes.split_at(start) else {
            return false
        }
        let Some(window) = parts.tail.prefix(wanted.len()) else {
            return false
        }
        if window == wanted {
            return true
        }
    }
    return false
} holds

/// Boots the emulator as `given` gives on `machine`, with the standard streams of this process,
/// and gives the status the run ends with once the emulator ends.
fn run(given: Launch, machine: Machine, alloc: mem::Alloc) -> u8 {
    let Ok(tpm) = attempt start_tpm(machine, alloc) else {
        return OTHER_END
    }
    let ended = attempt platform::run_attached(given.program.as_str(), args: given.args.view(), dir: machine.dir.as_str(), alloc)
    tpm.end()
    return run_status(ended)
} run

/// The status a run under the emulator ends with: v mod 128 when the machine wrote the byte v to
/// the exit port, which ends the emulator with status (2v + 1) mod 256, and `OTHER_END` for any
/// other end.
fn run_status(ended: Result[platform::Status, platform::IoError]) -> u8 {
    let Ok(platform::Status.Exited(code)) = ended else {
        return OTHER_END
    }
    return match first u8.checked_fit(code) {
        Some(status) if status % 2 == 1 => status / 2
        else => OTHER_END
    }
} run_status

/// The firmware of a UEFI target: its code and the template of its variables.
struct Firmware {
    code: text::String
    vars: text::String
} Firmware

/// The firmware of an architecture's UEFI target: the first pair present on the host, or the
/// first pair when none is.
fn firmware(arch: workspace::Arch, alloc: mem::Alloc) -> Firmware {
    var codes = words_of(OVMF_CODE, alloc)
    var templates = words_of(OVMF_VARS, alloc)
    if arch == workspace::Arch.Aarch64 {
        codes = words_of(AAVMF_CODE, alloc)
        templates = words_of(AAVMF_VARS, alloc)
    }
    var chosen: usize = 0
    for at in 0..<codes.len() {
        let Some(template) = templates.get(at) else {
            break
        }
        if platform::exists(codes[at].as_str()) and platform::exists(template.as_str()) {
            chosen = at
            break
        }
    }
    let Some(code) = codes.get(chosen) else {
        expect false
        return Firmware(code: text::String.empty(alloc), vars: text::String.empty(alloc))
    }
    let Some(template) = templates.get(chosen) else {
        expect false
        return Firmware(code: text::String.empty(alloc), vars: text::String.empty(alloc))
    }
    return Firmware(code: text::String.of(code.as_str(), alloc), vars: text::String.of(template.as_str(), alloc))
} firmware

/// Starts the TPM emulator on the machine's TPM state, made anew for a fresh machine, in the
/// machine directory, and waits for its socket.
fn start_tpm(machine: Machine, alloc: mem::Alloc) -> platform::Background fails platform::IoError {
    let dir = machine.dir.as_str()
    let state = platform::join(dir, name: TPM_STATE, alloc)
    if machine.fresh and platform::exists(state.as_str()) {
        try platform::remove_dir_all(state.as_str(), alloc)
    }
    try platform::create_dir_all(state.as_str(), alloc)
    let socket = platform::join(dir, name: TPM_SOCKET, alloc)
    if platform::exists(socket.as_str()) {
        try platform::remove_file(socket.as_str())
    }
    let args = words_of(TPM_ARGS, alloc)
    let tpm = try platform::start_background(TPM_PROGRAM, args: args.view(), dir, alloc)
    let started = platform::monotonic_nanos()
    while not platform::exists(socket.as_str()) {
        let running = attempt tpm.running()
        if running != Ok(true) or platform::monotonic_nanos().wrapping_sub(started) >= TPM_WAIT {
            tpm.end()
            fail platform::IoError.Other(0)
        }
        platform::sleep_ms(POLL)
    }
    return tpm
} start_tpm

/// The emulator invocation that boots a machine image, in a machine directory holding a disk made
/// blank when missing: a bare image directly, by the PVH boot protocol on x86_64 and by loading
/// its segments on AArch64, and a UEFI image through the firmware from a FAT volume holding it at
/// the default boot path and each of `files` at `/` followed by its name.
pkg fn launch(target: workspace::Target, image: Str, files: Slice[text::String], take boots: Boots, alloc: mem::Alloc) -> Launch fails platform::IoError {
    let Some(arch) = target.arch() else {
        expect false
        fail platform::IoError.NotFound
    }
    var dir = machine_of(image, alloc)
    var kept: Option[bool] = None
    match boots {
        Boots.Kept(dir: given, resets: resets) => {
            dir = given
            kept = Some(resets)
        }
        Boots.Fresh => {}
    }
    try platform::create_dir_all(dir.as_str(), alloc)
    let disk_path = platform::join(dir.as_str(), name: DISK, alloc)
    if not platform::exists(disk_path.as_str()) {
        try platform::write_sized(disk_path.as_str(), bytes: DISK_BYTES)
    }
    var args = base_args(arch, kvm: kvm_usable(arch), kept, alloc)
    if target.kind() == Some(workspace::Kind.Uefi) {
        let pair = firmware(arch, alloc)
        let volume = try boot_volume(arch, image, files, alloc)
        var code = text::String.of("if=pflash,format=", alloc)
        append_format(mut code, path: pair.code.as_str())
        mut code.append(",unit=0,readonly=on,file=")
        mut code.append(pair.code.as_str())
        var vars_drive = text::String.of("if=pflash,format=", alloc)
        append_format(mut vars_drive, path: pair.code.as_str())
        mut vars_drive.append(",unit=1,file=")
        var boot_drive = text::String.of("if=none,id=boot,format=raw,file=fat:", alloc)
        match kept {
            Some(_) => {
                let held = platform::join(dir.as_str(), name: VARS, alloc)
                if not platform::exists(held.as_str()) {
                    try copy_file(pair.vars.as_str(), to: held.as_str(), alloc)
                }
                mut vars_drive.append(VARS)
                mut boot_drive.append("rw:")
                mut boot_drive.append(volume.as_str())
            }
            None => {
                mut vars_drive.append(pair.vars.as_str())
                mut vars_drive.append(",snapshot=on")
                mut boot_drive.append(volume.as_str())
                mut boot_drive.append(",snapshot=on")
            }
        }
        if arch == workspace::Arch.Amd64 {
            mut args.push(text::String.of("-fw_cfg", alloc))
            mut args.push(text::String.of(BARS_BELOW_4_GIB, alloc))
        }
        mut args.push(text::String.of("-drive", alloc))
        mut args.push(take code)
        mut args.push(text::String.of("-drive", alloc))
        mut args.push(take vars_drive)
        mut args.push(text::String.of("-drive", alloc))
        mut args.push(take boot_drive)
        mut args.push(text::String.of("-device", alloc))
        mut args.push(text::String.of("virtio-blk-pci,drive=boot,bootindex=0,iommu_platform=on,disable-legacy=on", alloc))
    } else {
        mut args.push(text::String.of("-kernel", alloc))
        mut args.push(text::String.of(image, alloc))
    }
    let machine = Machine(dir: take dir, fresh: kept.is_none())
    return Launch(program: program(arch, alloc), args: take args, machine: Some(take machine))
} launch

/// Appends the format of a firmware flash image: QEMU's copy-on-write format for a `.qcow2`
/// file, raw otherwise.
fn append_format(mut written: text::String, path: Str) {
    if path.ends_with(".qcow2") {
        mut written.append("qcow2")
    } else {
        mut written.append("raw")
    }
} append_format

/// The FAT boot volume of a UEFI image: a directory beside it holding the image as the default
/// boot path the firmware of its architecture loads, and each of `files` at its root.
fn boot_volume(arch: workspace::Arch, image: Str, files: Slice[text::String], alloc: mem::Alloc) -> text::String fails platform::IoError {
    let directory = volume_of(image, alloc)
    if platform::exists(directory.as_str()) {
        try platform::remove_dir_all(directory.as_str(), alloc)
    }
    let boot_dir = platform::join(directory.as_str(), name: "EFI/BOOT", alloc)
    try platform::create_dir_all(boot_dir.as_str(), alloc)
    let default = match arch {
        workspace::Arch.Amd64 => "BOOTX64.EFI"
        workspace::Arch.Aarch64 => "BOOTAA64.EFI"
    }
    try copy_file(image, to: platform::join(boot_dir.as_str(), name: default, alloc).as_str(), alloc)
    for file in files {
        let Some(name) = platform::file_name(file.as_str(), alloc) else {
            expect false
            continue
        }
        try copy_file(file.as_str(), to: platform::join(directory.as_str(), name: name.as_str(), alloc).as_str(), alloc)
    }
    return directory
} boot_volume

/// Copies a file's contents to a path.
fn copy_file(from: Str, to: Str, alloc: mem::Alloc) fails platform::IoError {
    let contents = try platform::read_file(from, alloc)
    try platform::write_file(to, contents: contents.view())
} copy_file

/// The directory a launch makes the boot volume of an image in.
fn volume_of(image: Str, alloc: mem::Alloc) -> text::String {
    return platform::replaced_extension(image, extension: "boot", alloc)
} volume_of

/// The machine directory of a test run's launch of an image.
fn machine_of(image: Str, alloc: mem::Alloc) -> text::String {
    return platform::replaced_extension(image, extension: "machine", alloc)
} machine_of

/// Removes a test image with the boot volume and machine directory a launch made for it.
pkg fn remove_image(image: Str, alloc: mem::Alloc) fails platform::IoError {
    let volume = volume_of(image, alloc)
    if platform::exists(volume.as_str()) {
        try platform::remove_dir_all(volume.as_str(), alloc)
    }
    let machine = machine_of(image, alloc)
    if platform::exists(machine.as_str()) {
        try platform::remove_dir_all(machine.as_str(), alloc)
    }
    try platform::remove_file(image)
} remove_image

/// Boots the emulator as `given` gives, with the file at `path` as its configuration file `name`,
/// and gives how it ended, its serial output and its diagnostics; none once it has used more than
/// `PROCESSOR_TIME` of host processor time, or lasted `WALL_TIME`.
pkg fn boot(given: Launch, name: Str, path: Str, alloc: mem::Alloc) -> Option[platform::Output] fails platform::IoError {
    let Some(machine) = given.machine else {
        expect false
        fail platform::IoError.NotFound
    }
    var args = mem::List[text::String].empty(alloc)
    for arg in given.args {
        mut args.push(text::String.of(arg.as_str(), alloc))
    }
    mut args.push(text::String.of("-fw_cfg", alloc))
    var configuration = text::String.of("name=", alloc)
    mut configuration.append(name)
    mut configuration.append(",file=")
    mut configuration.append(path)
    mut args.push(take configuration)
    let tpm = try start_tpm(machine, alloc)
    let started = platform::monotonic_nanos()
    let booted = attempt platform::run_bounded(given.program.as_str(), args: args.view(), dir: machine.dir.as_str(), poll_ms: POLL, within: fn(id: u32) -> bool fails platform::IoError {
        let used = try processor_time_of(id, alloc)
        return used <= PROCESSOR_TIME and platform::monotonic_nanos().wrapping_sub(started) < WALL_TIME
    }, alloc)
    tpm.end()
    return match booted {
        Ok(output) => output
        Err(error) => fail error
    }
} boot

/// Whether a byte is ASCII white space.
fn is_space(byte: u8) -> bool = byte == b' ' or byte == b'\t' or byte == b'\n' or byte == b'\r' or byte == 0x0B or byte == 0x0C

/// The milliseconds of host processor time a process has used, its threads' in user and system
/// mode.
fn processor_time_of(pid: u32, alloc: mem::Alloc) -> u64 fails platform::IoError {
    var path = text::String.empty(alloc)
    mut path.write(text::fmt("/proc/{pid}/stat", pid), budget: 64)
    let stat = try platform::read_text(path.as_str(), alloc)
    let written = stat.as_str()
    let bytes = written.as_bytes()
    var after = bytes.len()
    for at in 0..<bytes.len() {
        if bytes[at] == b')' {
            after = at + 1
        }
    }
    var fields = mem::List[text::String].empty(alloc)
    var start = after
    expect bytes.len() < ~0usize
    for at in after..=bytes.len() {
        if at < bytes.len() and not is_space(bytes[at]) {
            continue
        }
        if at > start {
            let Some(field) = written.slice_bytes(start, end: at) else {
                fail platform::IoError.InvalidData
            }
            mut fields.push(text::String.of(field, alloc))
        }
        start = at + 1
    }
    var ticks: u64 = 0
    for at in 0..<2usize {
        var position = USER_TIME
        if at == 1 {
            position = SYSTEM_TIME
        }
        let Some(field) = fields.get(position) else {
            fail platform::IoError.Other(0)
        }
        let Some(value) = platform::parse_decimal(field.as_str()) else {
            fail platform::IoError.Other(0)
        }
        ticks = ticks.wrapping_add(value)
    }
    return ticks.wrapping_mul(1_000) / TICKS_PER_SECOND
} processor_time_of

test a_run_ends_with_the_byte_written_to_the_exit_port_and_otherwise_with_70 for run_status {
    expect run_status(Ok(platform::Status.Exited(1))) == 0
    expect run_status(Ok(platform::Status.Exited(141))) == 70
    expect run_status(Ok(platform::Status.Exited(255))) == 127
    expect run_status(Ok(platform::Status.Exited(0))) == OTHER_END
    expect run_status(Ok(platform::Status.Signalled(9))) == OTHER_END
    expect run_status(Err(platform::IoError.NotFound)) == OTHER_END
} a_run_ends_with_the_byte_written_to_the_exit_port_and_otherwise_with_70

/// The arguments of a machine run, separated by spaces.
fn joined(arch: workspace::Arch, kvm: bool, kept: Option[bool], alloc: mem::Alloc) -> text::String {
    var written = text::String.empty(alloc)
    for arg in base_args(arch, kvm, kept, alloc) {
        if written.byte_len() > 0 {
            mut written.append(" ")
        }
        mut written.append(arg.as_str())
    }
    return written
} joined

test a_machine_keeps_its_iommu_first_and_a_test_run_drops_its_writes for base_args {
    let alloc = testing::world().alloc
    let accelerated = joined(workspace::Arch.Amd64, kvm: true, kept: None, alloc)
    expect holds(accelerated.as_bytes(), wanted: b"-machine q35 -device intel-iommu,intremap=on,aw-bits=48 -accel kvm,kernel-irqchip=split -cpu host,+invtsc ")
    expect holds(accelerated.as_bytes(), wanted: b"-serial stdio -serial null -drive if=none,id=disk,format=raw,file=disk.raw,snapshot=on -netdev user,id=net,restrict=on -no-reboot")
    let tcg = joined(workspace::Arch.Amd64, kvm: false, kept: Some(false), alloc)
    expect holds(tcg.as_bytes(), wanted: b"-accel tcg -cpu max ")
    expect holds(tcg.as_bytes(), wanted: b"-serial unix:console.sock,server=on,wait=off -drive if=none,id=disk,format=raw,file=disk.raw -netdev user,id=net -no-reboot")
    let kept = joined(workspace::Arch.Aarch64, kvm: true, kept: Some(true), alloc)
    expect holds(kept.as_bytes(), wanted: b"-machine virt,gic-version=3,its=on,iommu=smmuv3,highmem-ecam=off -accel tcg -cpu cortex-a72 ")
    expect not holds(kept.as_bytes(), wanted: b"-no-reboot")
} a_machine_keeps_its_iommu_first_and_a_test_run_drops_its_writes
