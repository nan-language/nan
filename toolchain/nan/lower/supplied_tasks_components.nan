//! Components: `host::Runner.run`, which runs a component's handlers on a task of their own while a body runs, `sys::Stepper`, whose holder runs them on its own task, the operations of the component context, keyed tasks and posts through outboxes. A runner's record, drawn through the allocator of the run or the stepper, holds its lock, the intake from its oldest to its newest entry, whether the intake has stopped, the task waiting for a message, the component task or the stepper's holder, and whether it waits, the task waiting for the record's tasks, the delayed entries in the order they enter the intake, the timers in flight and their count, the keyed tasks not ended and their count, the count of what references the record, its allocator and executor cells, the number of `after` calls so far, whether the component task has ended, the outbox of the run's body or of the stepper, the nanosecond at which the executor's clock was minted with the executor's resolution, on whose grid delays end, the request whose handler runs, the stepper's holding, zero for a run, the executor's handle, the attached runner's handle, zero for none, and the index of keyed tasks by key, zero before the first spawn; the state, the Env and, for a protocol declaring one, the summary follow. An intake entry holds its links, the task posting it (zero for a message the component sends itself), its status, its deadline and order while delayed, whether a keyed outbox posted it and that outbox's key, where a request's reply goes (zero for any other message), the number a holder serving the request gave it and its numbering, and the message; a posted entry lies on the posting task's stack, any other is drawn through the runner's allocator.

const RUNNER_LOCK: u64 = 0

const RUNNER_OLDEST: u64 = 8

const RUNNER_NEWEST: u64 = 16

const RUNNER_STOPPED: u64 = 24

const RUNNER_COMPONENT: u64 = 32

const RUNNER_IDLE: u64 = 40

const RUNNER_WAITER: u64 = 48

const RUNNER_DELAYED: u64 = 56

const RUNNER_TIMERS: u64 = 64

const RUNNER_TIMER_COUNT: u64 = 72

const RUNNER_KEYED: u64 = 80

const RUNNER_LIVE_KEYED: u64 = 88

const RUNNER_REFS: u64 = 96

const RUNNER_CELL: u64 = 104

const RUNNER_EXECUTOR: u64 = 112

const RUNNER_ORDER: u64 = 120

const RUNNER_ENDED: u64 = 128

const RUNNER_INBOX: u64 = 136

const RUNNER_ORIGIN: u64 = 144

const RUNNER_RESOLUTION: u64 = 152

const RUNNER_CURRENT: u64 = 160

const RUNNER_HOLDING: u64 = 168

/// The handle of the executor its tasks run on.
const RUNNER_HANDLE: u64 = 176

/// The handle of the runner a stepper's holder attached, zero for none.
const RUNNER_RUNNER: u64 = 184

const RUNNER_KEYS: u64 = 192

const RUNNER_HEADER: u64 = 200

const COMPONENTS_ENTRY_NEXT: u64 = 0

const COMPONENTS_ENTRY_PREVIOUS: u64 = 8

const COMPONENTS_ENTRY_POSTER: u64 = 16

const COMPONENTS_ENTRY_STATUS: u64 = 24

const COMPONENTS_ENTRY_DEADLINE: u64 = 32

const COMPONENTS_ENTRY_ORDER: u64 = 40

const COMPONENTS_ENTRY_KEY: u64 = 48

const COMPONENTS_ENTRY_KEYED: u64 = 56

const COMPONENTS_ENTRY_REPLY: u64 = 64

const COMPONENTS_ENTRY_NUMBER: u64 = 72

const COMPONENTS_ENTRY_NUMBERING: u64 = 80

const COMPONENTS_ENTRY_HEADER: u64 = 88

const COMPONENTS_ENTRY_MESSAGE: u64 = 128

/// The numberings of a request's entry: none, numbered by the holder serving it, or numbered and
/// postponed by its handler.
const NUMBERING_NUMBERED: i64 = 1

const NUMBERING_POSTPONED: i64 = 2

/// The statuses of a posted entry: taken by the component task, removed from the intake untaken,
/// a request's handler having returned or failed, its poster stopped, the component task
/// stopped while its handler ran, or its handler having postponed it.
const STATUS_TAKEN: i64 = 1

const STATUS_REMOVED: i64 = 2

const STATUS_REPLIED: i64 = 3

const STATUS_FAILED: i64 = 4

const STATUS_WITHDRAWN: i64 = 5

const STATUS_ABANDONED: i64 = 6

const STATUS_POSTPONED: i64 = 7

fn components_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    match supply.path.as_str() {
        "host::Runner.run" => components_run(mut lo, mut fx, supply)
        "sys::Cx.send" => {
            let record = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
            send_now(mut lo, mut fx, supply, record, held: supply.param(1))
        }
        "sys::Cx.after" or "sys::Cx.after_ns" => components_after(mut lo, mut fx, supply)
        "sys::Cx.spawn" => components_spawn(mut lo, mut fx, supply)
        "sys::current_header" => components_current_header(mut lo, mut fx, supply)
        "sys::run_headed" => components_run_headed(mut lo, mut fx, supply)
        "sys::Cx.cancel" => {
            let record = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
            let lock = mut fx.offset(record, offset: RUNNER_LOCK)
            discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: Array[clif::Value, 1].filled(lock).view())
            supersede_key(mut lo, mut fx, record, key: supply.param(1).scalar_value())
            discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: Array[clif::Value, 1].filled(lock).view())
            supply.done(mut lo, mut fx)
        }
        "sys::Cx.postpone" => protocols_postpone(mut lo, mut fx, supply)
        "sys::Cx.runner" => {
            let record = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
            let attached = mut fx.load(PTR, addr: record, offset: RUNNER_RUNNER)
            let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: attached, y: 0)
            let handle = mut fx.choose_in(mut lo, condition: present, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
                return fx1.list1(attached)
            }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
                let denied = tables_denied(mut lo1, fx: mut fx1)
                return fx1.list1(denied)
            })
            let Some(sret) = supply.sret else {
                expect false
                return
            }
            mut fx.store(handle[0], addr: sret, offset: 0)
            supply.done(mut lo, mut fx)
        }
        "sys::Outbox.post" => {
            let message = supply.type_arg(lo, index: 0)
            let posted = components_enqueue(mut lo, mut fx, supply, message, held: supply.param(1), reply: None, number: None)
            await_taken(mut lo, mut fx, supply, message, record: posted.record, node: posted.node)
        }
        else => stepper_lower(mut lo, mut fx, supply)
    }
} components_lower

/// Where a runner's record holds the summary, the state and the Env, and its size and
/// alignment.
struct ComponentsShape derives Copy {
    state_at: u64
    env_at: u64
    summary: Option[ty::Ty]
    summary_at: u64
    size: u64
    align: u64
} ComponentsShape

fn components_shape(mut lo: Lowering, state: ty::Ty, env: ty::Ty, message: ty::Ty) -> ComponentsShape {
    let summary = protocols_summary_type(lo, message)
    var summary_at: u64 = 0
    var end = RUNNER_HEADER
    var align: u64 = 8
    match summary {
        Some(summary_ty) => {
            summary_at = protocols_summary_offset(mut lo, summary: summary_ty)
            let summary_laid = mut lo.layout_of(summary_ty)
            end = summary_at + summary_laid.contents().size
            if summary_laid.contents().align > align {
                align = summary_laid.contents().align
            }
        }
        None => {}
    }
    let state_laid = mut lo.layout_of(state)
    let env_laid = mut lo.layout_of(env)
    let state_at = next_multiple_of(end, multiple: at_least_one(state_laid.contents().align))
    let env_at = next_multiple_of(state_at + state_laid.contents().size, multiple: at_least_one(env_laid.contents().align))
    if state_laid.contents().align > align {
        align = state_laid.contents().align
    }
    if env_laid.contents().align > align {
        align = env_laid.contents().align
    }
    return ComponentsShape(state_at: state_at, env_at: env_at, summary: summary, summary_at: summary_at, size: env_at + env_laid.contents().size, align: align)
} components_shape

/// The instance of a handler of a component state for its Env and messages: a method of
/// `sys::Component` or of a system interface, whose name in `sys` is `owner`.
fn components_handler(mut lo: Lowering, owner: Str, method: Str, state: ty::Ty, env: ty::Ty, message: ty::Ty) -> Instance {
    let Some(interface_item) = lo.ck.db().std_item("sys", name: owner) else {
        expect false
        return Instance.Release(state)
    }
    let Some(index) = lo.ck.interface_method(interface_item, name: method) else {
        expect false
        return Instance.Release(state)
    }
    var args = mem::List[ty::Arg].empty(lo.alloc)
    mut args.push(ty::Arg.Ty(state))
    mut args.push(ty::Arg.Ty(env))
    mut args.push(ty::Arg.Ty(message))
    let fn_ref = nir::FnRef(callable: nir::Callable.Method(item: interface_item, method: u32.fit(index)), args: lo.ck.types().args(take args))
    return mut lo.callable_instance(fn_ref, as_value: false)
} components_handler

/// Calls an instance with values held as its parameters take them.
fn call_handler(mut lo: Lowering, mut fx: Fx, take instance: Instance, args: Slice[Held]) -> Held {
    let abi = mut lo.abi(instance)
    let id = mut lo.instance(take instance)
    let called = mut lo.invoke(mut fx, invoked: Invoked.Direct(id), abi, args)
    return called.result
} call_handler

/// Releases a run's Env: through its type's abandon method when the Env is linear, as its end of
/// scope does otherwise.
fn release_env(mut lo: Lowering, mut fx: Fx, env: ty::Ty, held: Held) {
    if lo.ck.has(env, property: check::Property.Linear) {
        let Some(abandon) = lo.ck.abandon_method(env) else {
            expect false
            return
        }
        let instance = mut lo.callable_instance(nir::FnRef.item(abandon, args: lo.ck.types().args_of(env)), as_value: false)
        discard call_handler(mut lo, mut fx, take instance, args: Array[Held, 1].filled(held).view())
        return
    }
    match held {
        Held.Address(address) => mut lo.release(mut fx, ty: env, address)
        else => {}
    }
} release_env

/// Wakes the task waiting for a run's tasks, if any. The caller holds the lock.
fn wake_waiter(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let waiter = mut fx.load(PTR, addr: record, offset: RUNNER_WAITER)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: waiter, y: 0)
    mut fx.if_true(present, then: fn[mut lo](mut fx1: Fx) {
        discard mut lo.call_routine(mut fx1, routine: Routine.Wake, args: Array[clif::Value, 1].filled(waiter).view())
    })
} wake_waiter

/// Waits until a condition read under a runner's lock holds; whatever wakes the waiter
/// changes what the condition reads.
fn wait_for(mut lo: Lowering, mut fx: Fx, record: clif::Value, condition: fn(mut fx: Fx) -> clif::Value) {
    let lock = mut fx.offset(record, offset: RUNNER_LOCK)
    let current = current_task(mut lo, mut fx)
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut lo](mut fx1: Fx, walk_state: Slice[clif::Value]) -> Pass {
        discard mut lo.call_routine(mut fx1, routine: Routine.Lock, args: Array[clif::Value, 1].filled(lock).view())
        let holds = condition(mut fx1)
        let waiting = mut fx1.b.bxor_imm_s(holds, y: 1)
        let zero = mut fx1.ptr(0)
        let waiter = mut fx1.b.select(waiting, x: current, y: zero)
        mut fx1.store(waiter, addr: record, offset: RUNNER_WAITER)
        discard mut lo.call_routine(mut fx1, routine: Routine.Unlock, args: Array[clif::Value, 1].filled(lock).view())
        mut fx1.if_true(waiting, then: fn[mut lo](mut fx2: Fx) {
            discard mut lo.call_routine(mut fx2, routine: Routine.Park, args: mem::List[clif::Value].empty(fx2.alloc).view())
        })
        return Pass(again: waiting, next: mem::List[clif::Value].empty(fx1.alloc))
    })
} wait_for

/// Adds a reference to a runner's record.
fn components_reference(mut fx: Fx, record: clif::Value) {
    let refs = mut fx.offset(record, offset: RUNNER_REFS)
    let one = mut fx.ptr(1)
    discard fetch_add(mut fx, address: refs, amount: one)
} components_reference

/// Drops one reference to a runner's record, freeing it with the last.
fn components_unreference(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let refs = mut fx.offset(record, offset: RUNNER_REFS)
    let minus = mut fx.ptr(0xFFFF_FFFF_FFFF_FFFF)
    let previous = fetch_add(mut fx, address: refs, amount: minus)
    let last = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: previous, y: 1)
    mut fx.if_true(last, then: fn[mut lo](mut fx1: Fx) {
        discard mut lo.call_routine(mut fx1, routine: Routine.Free, args: Array[clif::Value, 1].filled(record).view())
    })
} components_unreference

/// A new runner's record drawn through an allocator's cell, trapping when it is exhausted, with
/// its header cleared but for the reference its drawer holds, the cells of the allocator and the
/// executor, the executor's handle, and the origin and resolution of the executor's clock, given
/// its handle.
fn draw_record(mut lo: Lowering, mut fx: Fx, shape: ComponentsShape, cell: clif::Value, exec: clif::Value, exec_cell: clif::Value, clock: clif::Value, resolution: clif::Value) -> clif::Value {
    let size = mut fx.ptr(shape.size)
    let align = mut fx.ptr(shape.align)
    var alloc_args = Array[clif::Value, 3].filled(cell)
    alloc_args[1] = size
    alloc_args[2] = align
    let record_values = mut lo.call_routine(mut fx, routine: Routine.Alloc, args: alloc_args.view())
    expect record_values.len() == 1
    let record = record_values[0]
    let missing = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: record, y: 0)
    mut fx.if_true(missing, then: fn[mut lo](mut fx1: Fx) {
        raise_kind(mut lo, fx: mut fx1, kind: "trap.exhausted")
    })
    let zero = mut fx.ptr(0)
    let header = mut fx.ptr(RUNNER_HEADER)
    var fill_args = Array[clif::Value, 3].filled(record)
    fill_args[1] = zero
    fill_args[2] = header
    discard mut lo.call_routine(mut fx, routine: Routine.Fill, args: fill_args.view())
    let one = mut fx.ptr(1)
    mut fx.store(one, addr: record, offset: RUNNER_REFS)
    mut fx.store(cell, addr: record, offset: RUNNER_CELL)
    mut fx.store(exec_cell, addr: record, offset: RUNNER_EXECUTOR)
    mut fx.store(exec, addr: record, offset: RUNNER_HANDLE)
    mut fx.store(resolution, addr: record, offset: RUNNER_RESOLUTION)
    let clock_record = entry_at(mut lo, mut fx, handle: clock)
    let origin = mut fx.load(PTR, addr: clock_record, offset: TABLES_ENTRY_STATE)
    mut fx.store(origin, addr: record, offset: RUNNER_ORIGIN)
    return record
} draw_record

/// Where a step writes what it handles: a `sys::Handled` type and an address.
struct HandledAt derives Copy {
    handled: ty::Ty
    at: clif::Value
} HandledAt

/// Removes the oldest entry of a runner's intake and handles its message on the running task:
/// a one-way post completes, a request's entry awaits its handler's reply, and the entry of a
/// message the component sent is freed. The caller holds the lock, which this releases. With a
/// `sys::Handled` type and an address, it writes there what it handles.
fn handle_oldest(mut lo: Lowering, mut fx: Fx, record: clif::Value, oldest: clif::Value, state: ty::Ty, env: ty::Ty, message: ty::Ty, handled: Option[HandledAt]) {
    let laid = mut lo.layout_of(message)
    let slot = mut fx.slot(laid.contents().size, align: laid.contents().align)
    components_unlink(mut fx, record, node: oldest)
    let source = mut fx.offset(oldest, offset: COMPONENTS_ENTRY_MESSAGE)
    mut lo.copy(mut fx, dst: slot, src: source, size: laid.contents().size, align: laid.contents().align)
    let poster = mut fx.load(PTR, addr: oldest, offset: COMPONENTS_ENTRY_POSTER)
    let posted = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: poster, y: 0)
    let reply = mut fx.load(PTR, addr: oldest, offset: COMPONENTS_ENTRY_REPLY)
    let request = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: reply, y: 0)
    mut fx.if_true(posted, then: fn[mut lo](mut fx1: Fx) {
        take_posted(mut lo, fx: mut fx1, message, address: slot, poster)
        let taken = mut fx1.ptr(u64.fit(STATUS_TAKEN))
        mut fx1.store(taken, addr: oldest, offset: COMPONENTS_ENTRY_STATUS)
        let one_way = mut fx1.b.bxor_imm_s(request, y: 1)
        mut fx1.if_true(one_way, then: fn[mut lo](mut fx2: Fx) {
            discard mut lo.call_routine(mut fx2, routine: Routine.Wake, args: Array[clif::Value, 1].filled(poster).view())
        })
    })
    mut fx.if_true(request, then: fn(mut fx1: Fx) {
        mut fx1.store(oldest, addr: record, offset: RUNNER_CURRENT)
    })
    let header = mut fx.slot(HEADER_BLOCK, align: 8)
    let queued = mut fx.offset(oldest, offset: COMPONENTS_ENTRY_HEADER)
    mut lo.copy(mut fx, dst: header, src: queued, size: HEADER_BLOCK, align: 8)
    match handled {
        Some(written) => write_handled(mut lo, mut fx, written, message, slot, header)
        None => {}
    }
    let lock = mut fx.offset(record, offset: RUNNER_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: Array[clif::Value, 1].filled(lock).view())
    let sent = mut fx.b.bxor_imm_s(posted, y: 1)
    mut fx.if_true(sent, then: fn[mut lo](mut fx1: Fx) {
        discard mut lo.call_routine(mut fx1, routine: Routine.Free, args: Array[clif::Value, 1].filled(oldest).view())
    })
    components_handle(mut lo, mut fx, record, state, env, message, slot, header, node: Some(oldest))
} handle_oldest

/// Writes the `sys::Handled` of a message in a slot handled under the header of a block: that
/// header, and the index of the message's variant for an enum or a protocol, 0 for any other
/// message type.
fn write_handled(mut lo: Lowering, mut fx: Fx, written: HandledAt, message: ty::Ty, slot: clif::Value, header: clif::Value) {
    let header_field = mut lo.layouts.field(lo.ck, ty: written.handled, variant: None, label: "header")
    let operation_field = mut lo.layouts.field(lo.ck, ty: written.handled, variant: None, label: "operation")
    let header_at = mut fx.offset(written.at, offset: header_field.offset)
    write_header(mut lo, mut fx, option: header_field.ty, at: header_at, block: header)
    let operation = handled_operation(mut lo, mut fx, message, slot)
    mut fx.store(operation, addr: written.at, offset: operation_field.offset)
} write_handled

/// Writes at `at` the `Option[sys::Header]` of type `option` that a header block holds.
fn write_header(mut lo: Lowering, mut fx: Fx, option: ty::Ty, at: clif::Value, block: clif::Value) {
    let flag = mut fx.load(PTR, addr: block, offset: 0)
    let present = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: flag, y: 0)
    mut lo.write_option_with(mut fx, layout_ty: option, address: at, presence: present, write_payload: fn(mut lo1: Lowering, mut fx1: Fx, payload: clif::Value) {
        let bytes = mut fx1.offset(block, offset: 8)
        mut lo1.copy(mut fx1, dst: payload, src: bytes, size: HEADER_BYTES, align: 1)
    })
} write_header

/// Where a stepper's oldest message its component sent itself lies: its entry, in the intake
/// when `in_intake` holds, else first among the delayed messages.
struct SentNode derives Copy {
    node: clif::Value
    in_intake: clif::Value
} SentNode

/// Where `take_sent` writes: a `sys::Sent` type and an address.
struct SentAt derives Copy {
    sent: ty::Ty
    at: clif::Value
} SentAt

/// Removes a stepper's oldest message that its component sent itself, from its intake or else
/// from its delayed messages, and writes at `at` the `sys::Sent` of type `sent` holding it, its
/// header and the nanoseconds left before it would enter the intake. The caller holds the lock
/// and has found `node`, in the intake when `in_intake` holds.
fn take_sent(mut lo: Lowering, mut fx: Fx, record: clif::Value, found: SentNode, message: ty::Ty, written: SentAt) {
    let node = found.node
    discard mut fx.choose(found.in_intake, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        components_unlink(mut fx1, record, node)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let next = mut fx1.load(PTR, addr: node, offset: COMPONENTS_ENTRY_NEXT)
        mut fx1.store(next, addr: record, offset: RUNNER_DELAYED)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    let message_field = mut lo.layouts.field(lo.ck, ty: written.sent, variant: None, label: "message")
    let header_field = mut lo.layouts.field(lo.ck, ty: written.sent, variant: None, label: "header")
    let delay_field = mut lo.layouts.field(lo.ck, ty: written.sent, variant: None, label: "delay_ns")
    let laid = mut lo.layout_of(message)
    let message_at = mut fx.offset(written.at, offset: message_field.offset)
    let source = mut fx.offset(node, offset: COMPONENTS_ENTRY_MESSAGE)
    mut lo.copy(mut fx, dst: message_at, src: source, size: laid.contents().size, align: laid.contents().align)
    let header_at = mut fx.offset(written.at, offset: header_field.offset)
    let block = mut fx.offset(node, offset: COMPONENTS_ENTRY_HEADER)
    write_header(mut lo, mut fx, option: header_field.ty, at: header_at, block)
    let delay = mut fx.choose_in(mut lo, condition: found.in_intake, results: fx.types1(PTR).view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut fx1.ptr(0))
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let deadline = mut fx1.load(PTR, addr: node, offset: COMPONENTS_ENTRY_DEADLINE)
        let now = mut lo1.now_ns(mut fx1)
        let later = mut fx1.b.icmp(clif::IntCC.UnsignedGreaterThan, x: deadline, y: now)
        let left = mut fx1.b.isub(deadline, y: now)
        let zero = mut fx1.ptr(0)
        return fx1.list1(mut fx1.b.select(later, x: left, y: zero))
    })
    mut fx.store(delay[0], addr: written.at, offset: delay_field.offset)
    discard mut lo.call_routine(mut fx, routine: Routine.Free, args: Array[clif::Value, 1].filled(node).view())
} take_sent

/// The oldest entry of a runner's intake that its component sent itself, zero for none. The
/// caller holds the lock.
fn oldest_sent(mut fx: Fx, record: clif::Value) -> clif::Value {
    let head = mut fx.load(PTR, addr: record, offset: RUNNER_OLDEST)
    let found = mut fx.repeat(Array[clif::Value, 1].filled(head).view(), body: fn(mut fx1: Fx, walk_state: Slice[clif::Value]) -> Pass {
        expect walk_state.len() == 1
        let node = walk_state[0]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: node, y: 0)
        var results = Array[clif::Type, 2].filled(PTR)
        results[0] = clif::Type.Int8
        let moved = mut fx1.choose(present, results: results.view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let poster = mut fx2.load(PTR, addr: node, offset: COMPONENTS_ENTRY_POSTER)
            let posted = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: poster, y: 0)
            let next = mut fx2.load(PTR, addr: node, offset: COMPONENTS_ENTRY_NEXT)
            var stepped = mem::List[clif::Value].empty(fx2.alloc)
            mut stepped.push(posted)
            mut stepped.push(mut fx2.b.select(posted, x: next, y: node))
            return stepped
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            var ended = mem::List[clif::Value].empty(fx2.alloc)
            mut ended.push(mut fx2.int(clif::Type.Int8, value: 0))
            mut ended.push(node)
            return ended
        })
        expect moved.len() == 2
        return Pass(again: moved[0], next: fx1.list1(moved[1]))
    })
    expect found.len() == 1
    return found[0]
} oldest_sent

/// The 16-bit operation number of a message in a slot: the index of its variant for an enum or a
/// protocol, 0 for any other message type.
fn handled_operation(mut lo: Lowering, mut fx: Fx, message: ty::Ty, slot: clif::Value) -> clif::Value {
    let ty::TyKind.Item(item: item, args: _) = lo.ck.types().kind(message) else {
        return mut fx.int(clif::Type.Int16, value: 0)
    }
    match lo.ck.sig(item).contents().kind {
        check::SigKind.Enum(variants: _) or check::SigKind.Protocol(operations: _, variants: _, summary: _) => {}
        else => return mut fx.int(clif::Type.Int16, value: 0)
    }
    let index = mut lo.variant_index(mut fx, ty: message, address: slot)
    return mut fx.b.ireduce(clif::Type.Int16, x: index)
} handled_operation

/// Passes the message in a slot to `on`, or to its operation's handler for a protocol, with the
/// state and the Env a runner's record holds, then publishes the summary; a request's reply goes
/// to the entry `node` that posted it. The running task has the header of a block while the
/// handler runs.
fn components_handle(mut lo: Lowering, mut fx: Fx, record: clif::Value, state: ty::Ty, env: ty::Ty, message: ty::Ty, slot: clif::Value, header: clif::Value, node: Option[clif::Value]) {
    let current = current_task(mut lo, mut fx)
    let own = mut fx.offset(current, offset: TASK_HEADER)
    let saved = mut fx.slot(HEADER_BLOCK, align: 8)
    mut lo.copy(mut fx, dst: saved, src: own, size: HEADER_BLOCK, align: 8)
    mut lo.copy(mut fx, dst: own, src: header, size: HEADER_BLOCK, align: 8)
    let shape = components_shape(mut lo, state, env, message)
    let state_at = mut fx.offset(record, offset: shape.state_at)
    let env_at = mut fx.offset(record, offset: shape.env_at)
    let cx = mut fx.slot(8, align: 8)
    mut fx.store(record, addr: cx, offset: 0)
    var handler_args = Array[Held, 4].filled(Held.Address(state_at))
    handler_args[1] = Held.Address(slot)
    handler_args[2] = Held.Address(env_at)
    handler_args[3] = Held.Address(cx)
    match protocols_served(lo, message) {
        Some(protocol) => protocols_dispatch(mut lo, mut fx, record, protocol, state, args: handler_args.view(), node)
        None => {
            let on = components_handler(mut lo, owner: "Component", method: "on", state, env, message)
            discard call_handler(mut lo, mut fx, instance: take on, args: handler_args.view())
        }
    }
    protocols_publish(mut lo, mut fx, record, shape, state)
    mut lo.copy(mut fx, dst: own, src: saved, size: HEADER_BLOCK, align: 8)
} components_handle

/// The bytes of a `sys::Header`.
const HEADER_BYTES: u64 = 32

/// `sys::current_header()`: the running task's header, none outside a task or for a task without
/// one.
fn components_current_header(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let option = supply.abi.result
    let laid = mut lo.layout_of(option)
    let result = match supply.sret {
        Some(sret) => sret
        None => mut fx.slot(laid.contents().size, align: laid.contents().align)
    }
    let current = current_task(mut lo, mut fx)
    let inside = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: current, y: 0)
    let presence = mut fx.choose(inside, results: fx.types1(clif::Type.Int8).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let held = mut fx1.load(PTR, addr: current, offset: TASK_HEADER)
        return fx1.list1(mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: held, y: 0))
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(mut fx1.int(clif::Type.Int8, value: 0))
    })
    expect presence.len() > 0
    mut lo.write_option_with(mut fx, layout_ty: option, address: result, presence: presence[0], write_payload: fn(mut lo1: Lowering, mut fx1: Fx, at: clif::Value) {
        let bytes = mut fx1.offset(current, offset: TASK_HEADER + 8)
        mut lo1.copy(mut fx1, dst: at, src: bytes, size: HEADER_BYTES, align: 1)
    })
    let held = mut lo.held_at(mut fx, ty: option, address: result)
    supply.ret(mut lo, mut fx, held)
} components_current_header

/// `sys::run_headed(header, body: b)`: calls `b` with `header` as the running task's header,
/// then the task's own again.
fn components_run_headed(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let current = current_task(mut lo, mut fx)
    let own = mut fx.offset(current, offset: TASK_HEADER)
    let saved = mut fx.slot(HEADER_BLOCK, align: 8)
    mut lo.copy(mut fx, dst: saved, src: own, size: HEADER_BLOCK, align: 8)
    let one = mut fx.ptr(1)
    mut fx.store(one, addr: own, offset: 0)
    let bytes = mut fx.offset(own, offset: 8)
    mut lo.copy(mut fx, dst: bytes, src: supply.param(0).address_value(), size: HEADER_BYTES, align: 1)
    let body_ty = fn_param(lo, supply, index: 1)
    let called = mut lo.call_value(mut fx, fn_ty: body_ty, function: supply.param(1).address_value(), args: mem::List[Held].empty(fx.alloc).view())
    mut lo.copy(mut fx, dst: own, src: saved, size: HEADER_BLOCK, align: 8)
    supply.forward_failure(mut lo, mut fx, called)
    supply.ret(mut lo, mut fx, held: called.result)
} components_run_headed

/// Settles the record of a run whose caller has stopped or of a stepper whose domain is
/// abandoned, the tasks of that domain having stopped: its intake stops, each posted entry is
/// removed and its poster woken, the poster of the request whose handler ran learns that it
/// stopped, its timers are cancelled and waited for, its outboxes become stale, and the
/// references of its holder and of its stopped keyed tasks are dropped.
fn components_withdraw(mut lo: Lowering, mut fx: Fx, record: clif::Value) {
    let lock = mut fx.offset(record, offset: RUNNER_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: Array[clif::Value, 1].filled(lock).view())
    let one = mut fx.ptr(1)
    mut fx.store(one, addr: record, offset: RUNNER_STOPPED)
    let current = mut fx.load(PTR, addr: record, offset: RUNNER_CURRENT)
    let handling = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: current, y: 0)
    mut fx.if_true(handling, then: fn[mut lo](mut fx1: Fx) {
        let abandoned = mut fx1.ptr(u64.fit(STATUS_ABANDONED))
        mut fx1.store(abandoned, addr: current, offset: COMPONENTS_ENTRY_STATUS)
        let poster = mut fx1.load(PTR, addr: current, offset: COMPONENTS_ENTRY_POSTER)
        discard mut lo.call_routine(mut fx1, routine: Routine.Wake, args: Array[clif::Value, 1].filled(poster).view())
    })
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: record, offset: RUNNER_COMPONENT)
    mut fx.store(zero, addr: record, offset: RUNNER_IDLE)
    mut fx.store(zero, addr: record, offset: RUNNER_WAITER)
    mut fx.store(zero, addr: record, offset: RUNNER_CURRENT)
    let oldest = mut fx.load(PTR, addr: record, offset: RUNNER_OLDEST)
    discard mut fx.repeat(Array[clif::Value, 1].filled(oldest).view(), body: fn[mut lo](mut fx1: Fx, walk_state: Slice[clif::Value]) -> Pass {
        expect walk_state.len() == 1
        let node = walk_state[0]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: node, y: 0)
        let next = mut fx1.choose_in(mut lo, condition: present, results: Array[clif::Type, 1].filled(PTR).view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let after_node = mut fx2.load(PTR, addr: node, offset: COMPONENTS_ENTRY_NEXT)
            let poster = mut fx2.load(PTR, addr: node, offset: COMPONENTS_ENTRY_POSTER)
            let posted = mut fx2.b.icmp_imm_s(clif::IntCC.NotEqual, x: poster, y: 0)
            mut fx2.if_true(posted, then: fn[mut lo2](mut fx3: Fx) {
                components_unlink(mut fx3, record, node)
                let removed = mut fx3.ptr(u64.fit(STATUS_REMOVED))
                mut fx3.store(removed, addr: node, offset: COMPONENTS_ENTRY_STATUS)
                discard mut lo2.call_routine(mut fx3, routine: Routine.Wake, args: Array[clif::Value, 1].filled(poster).view())
            })
            var stepped = mem::List[clif::Value].empty(fx2.alloc)
            mut stepped.push(after_node)
            return stepped
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            var ended = mem::List[clif::Value].empty(fx2.alloc)
            mut ended.push(mut fx2.ptr(0))
            return ended
        })
        return Pass(again: present, next: take next)
    })
    let claimed = cancel_timers(mut lo, mut fx, record)
    let stopped = mut fx.load(PTR, addr: record, offset: RUNNER_LIVE_KEYED)
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: Array[clif::Value, 1].filled(lock).view())
    complete_claimed(mut lo, mut fx, claimed)
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut lo](mut fx1: Fx, walk_state: Slice[clif::Value]) -> Pass {
        mut lo.reap(mut fx1)
        discard mut lo.call_routine(mut fx1, routine: Routine.Lock, args: Array[clif::Value, 1].filled(lock).view())
        let timers = mut fx1.load(PTR, addr: record, offset: RUNNER_TIMER_COUNT)
        discard mut lo.call_routine(mut fx1, routine: Routine.Unlock, args: Array[clif::Value, 1].filled(lock).view())
        let pending = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: timers, y: 0)
        mut fx1.if_true(pending, then: fn[mut lo](mut fx2: Fx) {
            mut lo.relax(mut fx2)
        })
        return Pass(again: pending, next: mem::List[clif::Value].empty(fx1.alloc))
    })
    retire_outboxes(mut lo, mut fx, runner: record)
    let held = mut fx.b.iadd_imm_s(stopped, y: 1)
    let minus = mut fx.b.ineg(held)
    let refs = mut fx.offset(record, offset: RUNNER_REFS)
    let previous = fetch_add(mut fx, address: refs, amount: minus)
    let last = mut fx.b.icmp(clif::IntCC.Equal, x: previous, y: held)
    mut fx.if_true(last, then: fn[mut lo](mut fx1: Fx) {
        discard mut lo.call_routine(mut fx1, routine: Routine.Free, args: Array[clif::Value, 1].filled(record).view())
    })
} components_withdraw
