    \\} hash_map_cursor_mut_next_ends_with_none
    \\
    \\test hash_map_into_cursor_next_ends_with_none for HashMapIntoCursor.next {
    \\    var levels = HashMap[u8, u8].empty(7, alloc: testing::world().alloc)
    \\    discard mut levels.insert(1, value: 10)
    \\    var cursor = take levels.into_cursor()
    \\    let earlier = mut cursor.next()
    \\    let later = mut cursor.next()
    \\    expect earlier.is_some()
    \\    expect later.is_none()
    \\} hash_map_into_cursor_next_ends_with_none
    \\
    \\test set_cursor_next_ends_with_none for SetCursor.next {
    \\    var seen = Set[u8].empty(testing::world().alloc)
    \\    discard mut seen.insert(1)
    \\    var cursor = seen.cursor()
