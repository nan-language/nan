//! Components: the state an impl line naming `sys::Component` declares a component of, and the uses of the runner `host::Runner` and of the steppers `sys::Stepper`.

/// The component of an impl line naming `sys::Component`: a state without generic parameters,
/// Inert and implementing `Encode`, and an Env the runner can release, the first failing
/// check reported on the line.
fn Checker.check_component_impl(self, item: ty::ItemId) {
    let db = self.db()
    let held = self.sig(item)
    let SigKind.Impl(target: Some(key), target_ty: target_ty, bound: Some(bound)) = held.contents().kind else {
        return
    }
    if db.canonical_text(bound.item) != "sys::Component" {
        return
    }
    let state_item = match key {
        TypeKey.Item(found) => Some(found)
        else => None
    }
    let encode = db.core_item("Encode")
    var code = diagnostic::Code.ComponentStateGeneric
    if not self.state_generic(state_item) {
        if not self.has(target_ty, property: Property.Inert) {
            code = diagnostic::Code.ComponentStateNotInert
        } else {
            let Some(encode_item) = encode else {
                return
            }
            if not self.implements(target_ty, interface_item: encode_item) {
                code = diagnostic::Code.ComponentStateNotEncode
            } else {
                let args = self.types().arg_list(bound.args)
                if args.len() == 0 {
                    return
                }
                let Some(env) = args[0].ty() else {
                    return
                }
                if self.env_abandonable(item, env) {
                    return
                }
                code = diagnostic::Code.ComponentEnvNotAbandonable
            }
        }
    }
    var fixes = mem::List[diagnostic::Fix].empty(self.alloc())
    if code == diagnostic::Code.ComponentStateNotEncode {
        match state_item {
            Some(found) => {
                match self.derive_added(found, entry: "Encode") {
                    Some(fix) => mut fixes.push(take fix)
                    None => {}
                }
            }
            None => {}
        }
    }
    self.report_fixed(item, construct: nir::Span.at(db.ast(item).token), code, take fixes, offer: diagnostic::Offer.Each)
} Checker.check_component_impl

/// Whether the runner can release the Env of the component an impl line declares: one that
/// is not linear, or whose type has an abandon method visible at the line with no requires
/// clause that is not disputed. A failed abandon head is accepted.
fn Checker.env_abandonable(self, line: ty::ItemId, env: ty::Ty) -> bool {
    let db = self.db()
    if self.types().has_error(env) or not self.has(env, property: Property.Linear) {
        return true
    }
    let Some(abandon) = self.abandon_method(env) else {
        return false
    }
    if not db.visible(db.module_of(line), item: abandon) {
        return false
    }
    let Some(sig) = self.fn_sig(abandon) else {
        return true
    }
    if sig.has_error(self.types()) or not sig.abandon_head() {
        return true
    }
    let ast::ItemKind.Fn(function) = db.ast(abandon).kind else {
        return true
    }
    for clause in function.clauses {
        let required = match clause.kind {
            ast::ClauseKind.Requires(_) => true
            else => false
        }
        if required and not clause.disputed {
            return false
        }
    }
    return true
} Checker.env_abandonable

/// The function named `abandon` after a type item, in the type's module.
pkg fn Checker.abandon_method(self, ty: ty::Ty) -> Option[ty::ItemId] {
    let db = self.db()
    let ty::TyKind.Item(item: item, args: _) = self.types().kind(ty) else {
        return None
    }
    let module = db.module_of(item)
    for function in db.members(TypeKey.Item(item), name: "abandon") {
        if db.module_of(function) == module {
            return Some(function)
        }
    }
    return None
} Checker.abandon_method

/// Whether a component's state item has generic parameters.
fn Checker.state_generic(self, state_item: Option[ty::ItemId]) -> bool {
    let Some(found) = state_item else {
        return false
    }
    let sig = self.sig(found)
    return sig.contents().generics.len() > 0
} Checker.state_generic

/// The fix adding an entry to a struct's or enum's `derives` clause in canonical order,
/// writing the clause when it has none.
fn Checker.derive_added(self, item: ty::ItemId, entry: Str) -> Option[diagnostic::Fix] {
    let db = self.db()
    let alloc = self.alloc()
    let name_token = match db.ast(item).kind {
        ast::ItemKind.Struct(structure) => structure.name.token
        ast::ItemKind.Enum(enumeration) => enumeration.name.token
        else => return None
    }
    let Some(derived) = self.derive_entries(item) else {
        return None
    }
    let rank = derive_rank(entry)
    for written in derived {
        if derive_rank(written.text.as_str()) > rank {
            var inserted = text::String.of(entry, alloc)
            mut inserted.append(", ")
            return Some(self.fix_inserting(item, before: written.token, text: inserted.as_str()))
        }
    }
    if derived.len() > 0 {
        var appended = text::String.of(", ", alloc)
        mut appended.append(entry)
        return Some(self.fix_appending(item, after: derived[derived.len() - 1].token, text: appended.as_str()))
    }
    let syntax = db.syntax(item)
    var opener: Option[usize] = None
    for at in usize.widen(name_token)..<syntax.tokens.len() {
        if syntax.tokens[at].kind == syntax::TokenKind.Punct(syntax::Punct.LBrace) {
            opener = Some(at)
            break
        }
    }
    let Some(brace) = opener else {
        return None
    }
    let Some(before) = syntax.previous(brace) else {
        return None
    }
    var clause = text::String.of(" derives ", alloc)
    mut clause.append(entry)
    return Some(self.fix_appending(item, after: u32.truncate(before), text: clause.as_str()))
} Checker.derive_added

/// The position of a `derives` entry in canonical order, past the known ones for another.
fn derive_rank(written: Str) -> usize {
    return match written {
        "Copy" => 0
        "Eq" => 1
        "Ord" => 2
        "Hash" => 3
        "Default" => 4
        "Render" => 5
        "Encode" => 6
        "Generate" => 7
        "Send" => 8
        "Inert" => 9
        "AnyBits" => 10
        else => 11
    }
} derive_rank

/// The rule a use of `host::Runner.run`, `sys::Stepper.start` or `sys::Stepper.resume`
/// breaks: a state that is no component for the Env and messages the use fixes, then, for the
/// runner, code checked for a machine target.
fn Checker.component_use_problem(self, path: Str, head: FnSig, subst: ty::Subst) -> Option[diagnostic::Code] {
    let runner = path == "host::Runner.run"
    if self.uses_no_component(head, subst, runner) {
        return Some(diagnostic::Code.ComponentNotComponent)
    }
    let target = self.db().target
    if runner and target.is_machine() {
        return Some(diagnostic::Code.ComponentUnavailable)
    }
    return None
} Checker.component_use_problem

/// Whether a use of the runner or a stepper fixes a state that is no component for the Env and
/// messages it fixes, which follow the state for a stepper and the runner's own parameters.
fn Checker.uses_no_component(self, head: FnSig, subst: ty::Subst, runner: bool) -> bool {
    let types = self.types()
    let component = self.db().std_item("sys", name: "Component")
    var env_at: usize = 1
    if runner {
        env_at = head.inherited
    }
    let Some(state) = fixed_type(head, subst, index: 0, types) else {
        return false
    }
    let Some(env) = fixed_type(head, subst, index: env_at, types) else {
        return false
    }
    let Some(message) = fixed_type(head, subst, index: env_at + 1, types) else {
        return false
    }
    let Some(component_item) = component else {
        return false
    }
    var args = mem::List[ty::Arg].empty(self.alloc())
    mut args.push(ty::Arg.Ty(env))
    mut args.push(ty::Arg.Ty(message))
    return not self.satisfies(state, bound: ty::Bound(item: component_item, args: types.args(take args)))
} Checker.uses_no_component

/// The type a substitution gives a head's generic parameter at an index, unless it failed.
fn fixed_type(head: FnSig, subst: ty::Subst, index: usize, types: ty::Types) -> Option[ty::Ty]
    ensures match result {
        Some(_) => index < head.generics.len()
        None => true
    }
{
    if index >= head.generics.len() {
        return None
    }
    let Some(ty::Arg.Ty(fixed)) = subst.get(head.generics[index].param) else {
        return None
    }
    if types.has_error(fixed) {
        return None
    }
    return Some(fixed)
} fixed_type
