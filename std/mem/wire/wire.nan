//! The canonical binary format.

pub open struct Codec[T: Encode] {
} Codec

pub fn Codec.encode(value: T, mut out: mem::Bytes)
    ensures out.len() >= old(out.len())

pub fn Codec.try_encode(value: T, mut out: mem::Bytes) fails mem::OutOfMemory
    ensures out.len() >= old(out.len())

pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    example attempt Codec[u16].decode(Untrusted.of(b"\xAC\x02"), alloc: testing::world().alloc) == Ok(300)
    example attempt Codec[u8].decode(Untrusted.of(b"\x05\x00"), alloc: testing::world().alloc) == Err(core::DecodeError.Trailing)

pub fn Codec.canonical(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails core::DecodeError
    example (attempt Codec[u8].canonical(Untrusted.of(b"\x05\x00"), alloc: testing::world().alloc)).is_err()

pub fn Codec.erased() -> Erased limits pure, notrap, terminates
    example Codec[u8].erased().schema == Codec[u8].schema_hash()

pub fn Codec.schema_hash() -> SchemaHash limits pure, notrap, terminates
    example Codec[u8].schema_hash() != Codec[u16].schema_hash()

pub fn Codec.schema(alloc: mem::Alloc) -> Schema
    example Codec[i32].schema(testing::world().alloc).nodes.len() == 1

pub fn Codec.decode_from(schema: SchemaHash, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError
    example attempt Codec[u16].decode_from(Codec[u16].schema_hash(), raw: Untrusted.of(b"\xAC\x02"), alloc: testing::world().alloc) == Ok(300)
    example attempt Codec[u16].decode_from(Codec[u8].schema_hash(), raw: Untrusted.of(b"\x05"), alloc: testing::world().alloc) == Err(core::DecodeError.UnknownSchema)

pub fn Codec.encode_as(value: T, schema: SchemaHash, mut out: mem::Bytes, alloc: mem::Alloc) -> bool
    ensures out.len() >= old(out.len())

pub closed struct SchemaHash derives Copy, Eq, Ord, Hash, Encode {
    pub bytes: Array[u8, 33]
} SchemaHash

pub closed struct Schema derives Encode {
    pub nodes: mem::List[SchemaNode]
} Schema

pub closed enum SchemaNode derives Encode {
    Bool
    Char
    Text
    Bytes
    Unsigned(width: u8)
    Signed(width: u8)
    Float(width: u8)
    BoundedText(capacity: u64)
    Sequence(element: usize, length: Option[u64], capacity: Option[u64], unique: bool)
    Map(key: usize, value: usize)
    Record(open: bool, fields: mem::List[SchemaField])
    Variant(open: bool, variants: mem::List[SchemaVariant])
    Back(depth: u64)
} SchemaNode

pub closed struct SchemaField derives Encode {
    pub key: text::String
    pub aliases: mem::List[text::String]
    pub defaulted: bool
    pub value: usize
} SchemaField

pub closed struct SchemaVariant derives Encode {
    pub key: text::String
    pub aliases: mem::List[text::String]
    pub payload: Option[usize]
} SchemaVariant

pub open struct Erased derives Copy {
    pub schema: SchemaHash
    pub canonical: fn(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails core::DecodeError limits terminates
} Erased

pub open enum Kept {
    Empty
    Fields(Untrusted[mem::Bytes])
} Kept

impl Kept: core::Eq

impl Kept: core::Ord

impl Kept: core::Hash

impl Kept: core::Default

impl Kept: core::Generate

pub fn Kept.eq(self, other: Kept) -> bool limits pure, notrap, terminates
    example Kept.Empty.eq(Kept.Empty)
{
    return true
} Kept.eq

pub fn Kept.cmp(self, other: Kept) -> core::Ordering limits pure, notrap, terminates
    example Kept.Empty.cmp(Kept.Empty) == core::Ordering.Equal
{
    return core::Ordering.Equal
} Kept.cmp

pub fn Kept.hash[H: core::Hasher](self, mut hasher: H) limits pure, notrap, terminates {
} Kept.hash

pub fn Kept.default() -> Kept limits pure, terminates
    example Kept.default() == Kept.Empty
{
    return Kept.Empty
} Kept.default

pub fn Kept.generate(mut choices: core::Choices, alloc: mem::Alloc) -> Kept limits terminates {
    return Kept.Empty
} Kept.generate

pub fn Schema.accepts(self, old: Schema, alloc: mem::Alloc) -> bool
    example Codec[text::Fixed[16]].schema(testing::world().alloc).accepts(Codec[text::Fixed[8]].schema(testing::world().alloc), alloc: testing::world().alloc)
    example not Codec[u16].schema(testing::world().alloc).accepts(Codec[u8].schema(testing::world().alloc), alloc: testing::world().alloc)
{
    if not self.is_tree(alloc) or not old.is_tree(alloc) {
        return false
    }
    var pending = mem::List[NodePair].empty(alloc)
    mut pending.push(NodePair(new: 0, old: 0))
    loop {
        let Some(pair) = mut pending.pop() else {
            return true
        }
        if not self.nodes[pair.new].accepts(old.nodes[pair.old], pending: mut pending) {
            return false
        }
    }
} Schema.accepts

test records_accept_defaulted_and_dropped_fields for Schema.accepts {
    let alloc = testing::world().alloc
    var old_fields = mem::List[SchemaField].empty(alloc)
    mut old_fields.push(plain_field("level", value: 1, alloc))
    mut old_fields.push(plain_field("mode", value: 2, alloc))
    var renamed = plain_field("lvl", value: 1, alloc)
    mut renamed.aliases.push(text::String.of("level", alloc))
    var added = plain_field("verbose", value: 2, alloc)
    added.defaulted = true
    var new_fields = mem::List[SchemaField].empty(alloc)
    mut new_fields.push(take renamed)
    mut new_fields.push(take added)
    var old_nodes = mem::List[SchemaNode].empty(alloc)
    mut old_nodes.push(SchemaNode.Record(open: false, fields: take old_fields))
    mut old_nodes.push(SchemaNode.Unsigned(width: 8))
    mut old_nodes.push(SchemaNode.Text)
    var open_nodes = mem::List[SchemaNode].empty(alloc)
    mut open_nodes.push(SchemaNode.Record(open: true, fields: take new_fields))
    mut open_nodes.push(SchemaNode.Unsigned(width: 8))
    mut open_nodes.push(SchemaNode.Bool)
    let old = Schema(nodes: take old_nodes)
    let open = Schema(nodes: take open_nodes)
    let widened = open.accepts(old, alloc)
    let narrowed = old.accepts(open, alloc)
    expect widened
    expect not narrowed
} records_accept_defaulted_and_dropped_fields

test nodes_shared_or_out_of_order_accept_nothing for Schema.accepts {
    let alloc = testing::world().alloc
    var shared = mem::List[SchemaNode].empty(alloc)
    mut shared.push(SchemaNode.Map(key: 1, value: 1))
    mut shared.push(SchemaNode.Bool)
    var backwards = mem::List[SchemaNode].empty(alloc)
    mut backwards.push(SchemaNode.Sequence(element: 0, length: None, capacity: None, unique: false))
    let shared_tree = Schema(nodes: take shared)
    let backwards_tree = Schema(nodes: take backwards)
    let shared_accepted = shared_tree.accepts(shared_tree, alloc)
    let backwards_accepted = backwards_tree.accepts(backwards_tree, alloc)
    let empty_accepted = Schema(nodes: mem::List[SchemaNode].empty(alloc)).accepts(Codec[bool].schema(alloc), alloc)
    expect not shared_accepted
    expect not backwards_accepted
    expect not empty_accepted
} nodes_shared_or_out_of_order_accept_nothing

fn plain_field(key: Str, value: usize, alloc: mem::Alloc) -> SchemaField {
    return SchemaField(key: text::String.of(key, alloc), aliases: mem::List[text::String].empty(alloc), defaulted: false, value: value)
} plain_field

/// A node of a new tree and the node of an old tree it must accept.
struct NodePair derives Copy {
    new: usize
    old: usize
} NodePair

/// Whether each node but the first is the child of exactly one node before it.
fn Schema.is_tree(self, alloc: mem::Alloc) -> bool {
    let count = self.nodes.len()
    if count == 0 {
        return false
    }
    var parented = mem::Bytes.zeroed(count, alloc)
    for parent in 0..<count {
        match self.nodes[parent] {
            SchemaNode.Sequence(element: element, length: _, capacity: _, unique: _) => {
                if not claim(mut parented, child: element, parent) {
                    return false
                }
            }
            SchemaNode.Map(key: key, value: value) => {
                if not claim(mut parented, child: key, parent) or not claim(mut parented, child: value, parent) {
                    return false
                }
            }
            SchemaNode.Record(open: _, fields: fields) => {
                for field in fields {
                    if not claim(mut parented, child: field.value, parent) {
                        return false
                    }
                }
            }
            SchemaNode.Variant(open: _, variants: variants) => {
                for variant in variants {
                    let Some(payload) = variant.payload else {
                        continue
                    }
                    if not claim(mut parented, child: payload, parent) {
                        return false
                    }
                }
            }
            else => {}
        }
    }
    for at in 1..<count {
        if parented[at] == 0 {
            return false
        }
    }
    return true
} Schema.is_tree

/// Marks `child` as the child of `parent`, unless it lies before `parent`, past the last node or
/// already has a parent.
fn claim(mut parented: mem::Bytes, child: usize, parent: usize) -> bool {
    if child <= parent or child >= parented.len() or parented[child] != 0 {
        return false
    }
    parented[child] = 1
    return true
} claim

/// Whether this node accepts an old one, given that each pair of their children it pushes onto
/// `pending` accepts in turn.
fn SchemaNode.accepts(self, old: SchemaNode, mut pending: mem::List[NodePair]) -> bool {
    match self {
        SchemaNode.Unsigned(width: new) => {
            let SchemaNode.Unsigned(width: held) = old else {
                return false
            }
            return new == held
        }
        SchemaNode.Signed(width: new) => {
            let SchemaNode.Signed(width: held) = old else {
                return false
            }
            return new == held
        }
        SchemaNode.Float(width: new) => {
            let SchemaNode.Float(width: held) = old else {
                return false
            }
            return new == held
        }
        SchemaNode.Back(depth: new) => {
            let SchemaNode.Back(depth: held) = old else {
                return false
            }
            return new == held
        }
        SchemaNode.BoundedText(capacity: new) => {
            let SchemaNode.BoundedText(capacity: held) = old else {
                return false
            }
            return new >= held
        }
        SchemaNode.Sequence(element: element, length: length, capacity: capacity, unique: unique) => {
            let SchemaNode.Sequence(element: old_element, length: old_length, capacity: old_capacity, unique: old_unique) = old else {
                return false
            }
            let fits = match capacity {
                None => true
                Some(room) => match old_capacity {
                    Some(held) => room >= held
                    None => false
                }
            }
            mut pending.push(NodePair(new: element, old: old_element))
            return length == old_length and fits and (not unique or old_unique)
        }
        SchemaNode.Map(key: key, value: value) => {
            let SchemaNode.Map(key: old_key, value: old_value) = old else {
                return false
            }
            mut pending.push(NodePair(new: key, old: old_key))
            mut pending.push(NodePair(new: value, old: old_value))
            return true
        }
        SchemaNode.Record(open: open, fields: fields) => {
            let SchemaNode.Record(open: _, fields: old_fields) = old else {
                return false
            }
            return record_accepts(open, fields: fields.view(), old_fields: old_fields.view(), pending: mut pending)
        }
        SchemaNode.Variant(open: _, variants: variants) => {
            let SchemaNode.Variant(open: _, variants: old_variants) = old else {
                return false
            }
            return variants_accept(variants.view(), old_variants: old_variants.view(), pending: mut pending)
        }
        else => return self.kind() == old.kind()
    }
} SchemaNode.accepts

/// The position of a node's kind among the kinds of nodes.
fn SchemaNode.kind(self) -> u32 {
    return match self {
        SchemaNode.Bool => 0
        SchemaNode.Char => 1
        SchemaNode.Text => 2
        SchemaNode.Bytes => 3
        SchemaNode.Unsigned(width: _) => 4
        SchemaNode.Signed(width: _) => 5
        SchemaNode.Float(width: _) => 6
        SchemaNode.BoundedText(capacity: _) => 7
        SchemaNode.Sequence(element: _, length: _, capacity: _, unique: _) => 8
        SchemaNode.Map(key: _, value: _) => 9
        SchemaNode.Record(open: _, fields: _) => 10
        SchemaNode.Variant(open: _, variants: _) => 11
        SchemaNode.Back(depth: _) => 12
    }
} SchemaNode.kind

/// Whether a field's key or one of its aliases is `key`.
fn field_matches(field: SchemaField, key: Str) -> bool {
    if field.key.as_str() == key {
        return true
    }
    return field.aliases.position(fn(alias: text::String) => alias.as_str() == key).is_some()
} field_matches

/// Whether a record's fields accept old ones, pushing onto `pending` the value of the first field
/// matching each old field with that field's value: each old field matched, or dropped from an
/// open record, and each field matching an old one or defaulted.
fn record_accepts(open: bool, fields: Slice[SchemaField], old_fields: Slice[SchemaField], mut pending: mem::List[NodePair]) -> bool {
    for held in old_fields {
        var matched: Option[usize] = None
        for at in 0..<fields.len() {
            if field_matches(fields[at], key: held.key.as_str()) {
                matched = Some(at)
                break
            }
        }
        match matched {
            Some(at) => mut pending.push(NodePair(new: fields[at].value, old: held.value))
            None => {
                if not open {
                    return false
                }
            }
        }
    }
    for field in fields {
        if field.defaulted {
            continue
        }
        var known = false
        for held in old_fields {
            if field_matches(field, key: held.key.as_str()) {
                known = true
                break
            }
        }
        if not known {
            return false
        }
    }
    return true
} record_accepts

/// Whether variants accept old ones, pushing onto `pending` the payload of the first variant
/// matching each old variant by key or alias with that variant's payload: each old variant
/// matched, by one with a payload exactly when it has one.
fn variants_accept(variants: Slice[SchemaVariant], old_variants: Slice[SchemaVariant], mut pending: mem::List[NodePair]) -> bool {
    for held in old_variants {
        var matched: Option[usize] = None
        for at in 0..<variants.len() {
            let variant = variants[at]
            if variant.key == held.key or variant.aliases.position(fn(alias: text::String) => alias == held.key).is_some() {
                matched = Some(at)
                break
            }
        }
        let Some(at) = matched else {
            return false
        }
        match variants[at].payload {
            None => {
                if held.payload.is_some() {
                    return false
                }
            }
            Some(payload) => {
                let Some(old_payload) = held.payload else {
                    return false
                }
                mut pending.push(NodePair(new: payload, old: old_payload))
            }
        }
    }
    return true
} variants_accept

test encode_appends_a_uvar for Codec.encode {
    var out = mem::Bytes.zeroed(1, alloc: testing::world().alloc)
    Codec[u16].encode(300, mut out)
    expect out.len() == 3
    expect out[1] == 0xAC
    expect out[2] == 0x02
} encode_appends_a_uvar

test try_encode_leaves_out_unchanged_when_exhausted for Codec.try_encode {
    let budget = testing::world().alloc.split(65_536)
    var out = mem::Bytes.empty(budget.alloc())
    take budget.close()
    let encoded = attempt Codec[u16].try_encode(300, mut out)
    expect encoded.is_err()
    expect out.len() == 0
} try_encode_leaves_out_unchanged_when_exhausted

test encode_as_writes_the_own_schema_alone for Codec.encode_as {
    let alloc = testing::world().alloc
    var out = mem::Bytes.empty(alloc)
    let own = Codec[u16].encode_as(300, schema: Codec[u16].schema_hash(), mut out, alloc)
    let other = Codec[u16].encode_as(300, schema: Codec[u8].schema_hash(), mut out, alloc)
    expect own
    expect not other
    expect out.len() == 2
} encode_as_writes_the_own_schema_alone

struct Touched {
    written: bool
} Touched

impl Touched: core::Hasher

fn Touched.write(mut self, bytes: Slice[u8]) limits pure, notrap, terminates {
    self.written = true
} Touched.write

test kept_fields_hash_nothing for Kept.hash {
    var hasher = Touched(written: false)
    Kept.Empty.hash(mut hasher)
    expect not hasher.written
} kept_fields_hash_nothing

test generated_kept_fields_are_empty for Kept.generate (kept: Kept) {
    let Kept.Empty = kept else {
        expect false
        return
    }
} generated_kept_fields_are_empty
