//! Answers what its typed input asks: a hundred divided by a number; an amount added and settled through the gauge its world holds, logged with whether its random source gives bytes; or the reply to a call dialled through the line its world holds.

pub closed enum Ask derives Encode {
    Divide(u32)
    Gauge(u32)
    Dial(mem::Bytes)
} Ask

pub closed enum Answer derives Encode {
    Number(u64)
    Bytes(mem::Bytes)
} Answer

pub closed enum TypedError derives Render {
    Missing(nanos::CapError) from
    Crossed(sys::CrossError) from
    Cancelled(task::Cancelled) from
} TypedError

fn main(take world: nanos::World, take input: Ask) -> Answer fails TypedError uses wait {
    match input {
        Ask.Divide(divisor) => return Answer.Number(divided(divisor))
        Ask.Gauge(amount) => return Answer.Number(try await gauged(world, amount))
        Ask.Dial(call) => {
            let line = try nanos::Cap[gauges::Line].get(world.caps, key: "line")
            return Answer.Bytes(try await line.dial(call.view(), alloc: world.alloc))
        }
    }
} main

/// Adds `amount` through the gauge the world holds and settles it, logging both totals and whether
/// the world's random source gives bytes, and gives the settled total.
fn gauged(world: nanos::World, amount: u32) -> u64 fails TypedError uses wait {
    let gauge = try nanos::Cap[gauges::Gauge].get(world.caps, key: "gauge")
    world.log.info("gauged", value: try gauge.add(u64.widen(amount), alloc: world.alloc))
    let settled = try await gauge.settled(alloc: world.alloc)
    world.log.info("settled", value: settled)
    var bytes = Array[u8, 8].filled(0)
    world.log.info("random", value: (attempt world.random.fill(mut bytes.view_mut())).is_ok())
    return settled
} gauged

fn divided(divisor: u32) -> u64 {
    return u64.widen(100 / divisor)
} divided
