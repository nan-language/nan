//! The records of an item's context pack.

/// The records of a context pack: the item's lines, its package's manifest directives, the names
/// of its module and the api records of what checking it reads.
fn pack_records(workspace: workspace::Workspace, pack: check::Context, writer: Option[text::String], alloc: mem::Alloc) -> mem::List[output::Record] {
    var records = mem::List[output::Record].empty(alloc)
    let Some(at) = workspace.file(pack.file.as_str()) else {
        expect false
        return records
    }
    let file = workspace.file_at(at).syntax
    var item_lines = mem::List[text::String].empty(alloc)
    for number in pack.lines {
        mut item_lines.push(output::printable(file.line_text(number), alloc))
    }
    var item_fields = mem::List[text::String].empty(alloc)
    mut item_fields.push(written_for(pack.path.as_str(), writer, alloc))
    mut item_fields.push(located(pack.file.as_str(), line: pack.line, alloc))
    mut records.push(output::Record(word: text::String.of("item", alloc), fields: take item_fields, lines: take item_lines))
    var manifest_fields = mem::List[text::String].empty(alloc)
    mut manifest_fields.push(text::String.of(pack.package_name.as_str(), alloc))
    mut records.push(output::Record(word: text::String.of("manifest", alloc), fields: take manifest_fields, lines: copied_lines(pack.directives.view(), alloc)))
    var names_fields = mem::List[text::String].empty(alloc)
    mut names_fields.push(written_for(pack.module.as_str(), writer, alloc))
    var names = text::String.empty(alloc)
    for index in 0..<pack.names.len() {
        if index > 0 {
            mut names.append(", ")
        }
        mut names.append(pack.names[index].as_str())
    }
    var names_lines = mem::List[text::String].empty(alloc)
    mut names_lines.push(take names)
    mut records.push(output::Record(word: text::String.of("names", alloc), fields: take names_fields, lines: take names_lines))
    for api in pack.apis {
        var fields = mem::List[text::String].empty(alloc)
        mut fields.push(written_for(api.path.as_str(), writer, alloc))
        mut fields.push(located(api.file.as_str(), line: api.line, alloc))
        var lines = mem::List[text::String].empty(alloc)
        if api.package_name.as_str() == pack.package_name.as_str() {
            lines = copied_lines(api.lines.view(), alloc)
        } else {
            lines = enveloped(api.package_name.as_str(), lines: api.lines.view(), alloc)
        }
        mut records.push(output::Record(word: text::String.of("api", alloc), fields: take fields, lines: take lines))
    }
    return records
} pack_records

fn copied_lines(lines: Slice[text::String], alloc: mem::Alloc) -> mem::List[text::String] {
    var copies = mem::List[text::String].empty(alloc)
    for line in lines {
        mut copies.push(text::String.of(line.as_str(), alloc))
    }
    return copies
} copied_lines

/// Lines copied from another package, each maximal run of those holding a comment or a text,
/// byte or char literal written as an envelope.
fn enveloped(origin: Str, lines: Slice[text::String], alloc: mem::Alloc) -> mem::List[text::String] {
    var out = mem::List[text::String].empty(alloc)
    var quoted_run = mem::List[text::String].empty(alloc)
    for line in lines {
        let quoting = line.as_str().find("\"") != None or line.as_str().find("'") != None or line.as_str().find("//") != None
        if quoting {
            var quoted = text::String.of("| ", alloc)
            mut quoted.append(line.as_str())
            mut quoted_run.push(take quoted)
            continue
        }
        flush(mut out, quoted: mut quoted_run, origin, alloc)
        mut out.push(text::String.of(line.as_str(), alloc))
    }
    flush(mut out, quoted: mut quoted_run, origin, alloc)
    return out
} enveloped

/// Moves a run of quoted lines to the output under its envelope line, if it holds any.
fn flush(mut out: mem::List[text::String], mut quoted: mem::List[text::String], origin: Str, alloc: mem::Alloc) {
    if quoted.len() == 0 {
        return
    }
    var header = text::String.of("envelope ", alloc)
    mut header.append(origin)
    mut header.write(text::fmt(" {count}", count: quoted.len()), budget: 100)
    mut out.push(take header)
    for line in quoted {
        mut out.push(text::String.of(line.as_str(), alloc))
    }
    mut quoted.truncate(0)
} flush
