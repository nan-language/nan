test cancelling_reaches_the_task_of_its_key_alone for Cx.cancel {
    let world = testing::world()
    let clock = world.clock
    let last = try await host::Runner[Keyring].run(ProbeEnv(clock: clock, counted: 0), exec: world.exec, alloc: world.alloc, body: fn(inbox: Outbox[KeyringMessage]) fails task::SendError uses wait {
        for index in 0..<KEYRING_KEYS {
            try await inbox.post(KeyringMessage.Spawn(index * 7_919 % KEYRING_KEYS))
        }
        for index in 0..<KEYRING_KEYS {
            let key = index * 13 % KEYRING_KEYS
            if key % 3 != 0 {
                try await inbox.post(KeyringMessage.Cancel(key))
            }
        }
        for key in 0..<KEYRING_KEYS {
            if key % 5 == 0 {
                try await inbox.post(KeyringMessage.Spawn(key))
            }
        }
        try await clock.sleep(1_000)
    })
    var posted: u64 = 0
    var keys: u64 = 0
    for key in 0..<KEYRING_KEYS {
        if key % 3 == 0 or key % 5 == 0 {
            posted += 1
            keys += key
        }
    }
    expect last.posted == posted and last.keys == keys
} cancelling_reaches_the_task_of_its_key_alone

