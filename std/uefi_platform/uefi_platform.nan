//! The UEFI entry landing fn, which mints the machine root grant, and kernel task preemption.

/// The UEFI entry landing fn: mints the machine root grant, which the image handle and system
/// table the seam records stand behind.
pub landing fn enter(image: hw::Ptr[u8], table: hw::Ptr[u8]) -> boot::Machine limits stack 4_096 {
    discard image
    discard table
    return hw::mint_root()
} enter

/// Makes the preempted task ready again and switches its CPU to the next ready task, returning
/// once a later switch resumes it.
landing fn preempted() limits stack 1_024 {
    yield_task()
} preempted

/// Switches the CPU from the running kernel task, ready again, to its next ready task.
pkg fn yield_task()

contribute hw::preempt preempt = hw::PreemptEntry(slot: Unit, handler: preempted)
