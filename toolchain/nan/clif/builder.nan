pkg fn Builder.icmp(mut self, cond: IntCC, x: Value, y: Value) -> Value {
    let ty = self.value_type(x)
    return mut self.build_value(InstructionData.IntCompare(opcode: Opcode.Icmp, cond: cond, x: x, y: y), ctrl_typevar: Some(ty))
} Builder.icmp

pkg fn Builder.icmp_imm_s(mut self, cond: IntCC, x: Value, y: i64) -> Value {
    let ty = self.value_type(x)
    let imm = mut self.build_imm_const(ty, imm: y, signed: true)
    return mut self.icmp(cond, x, y: imm)
} Builder.icmp_imm_s

pkg fn Builder.select(mut self, c: Value, x: Value, y: Value) -> Value {
    let ty = self.value_type(x)
    return mut self.build_value(InstructionData.Ternary(opcode: Opcode.Select, x: c, y: x, z: y), ctrl_typevar: Some(ty))
} Builder.select

pkg fn Builder.uextend(mut self, ty: Type, x: Value) -> Value {
    return mut self.unary(Opcode.Uextend, ctrl_typevar: ty, arg: x)
} Builder.uextend

pkg fn Builder.sextend(mut self, ty: Type, x: Value) -> Value {
