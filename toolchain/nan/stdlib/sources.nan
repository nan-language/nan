    \\
    \\/// The element raised to p - 2, the inverse of a nonzero element.
    \\fn Field.inverted(self) -> Field {
    \\    var c = self
    \\    for step in 0..<254u32 {
    \\        let bit = 253 - step
    \\        c = c.times(c)
    \\        if bit != 2 and bit != 4 {
    \\            c = c.times(self)
    \\        }
    \\    }
    \\    return c
    \\} Field.inverted
    \\
    \\/// The element raised to (p - 5) / 8.
    \\fn Field.pow_p58(self) -> Field {
    \\    var c = self
    \\    for step in 0..<251u32 {
    \\        let bit = 250 - step
    \\        c = c.times(c)
