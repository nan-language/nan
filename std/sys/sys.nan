/// Whether a file opened through `fs` reads 4 bytes into 4 and is 10 bytes long, the file
/// released before it returns.
fn reads_back(fs: Fs, path: Str) -> bool fails fs::FsError uses wait {
    var file = try await fs.open(path)
    var buf = Untrusted.of(Array[u8, 4].filled(0))
    let read = try await mut file.read(mut buf.view_mut())
    let len = try await file.byte_len()
    return read == 4 and len == 10
} reads_back

test served_files_call_their_kind for Fs.served {
    let world = testing::world()
    let minter = shelves(world.alloc)
    defer take minter.close()
    let counter = minter.mint(0)
    let shelf = minter.mint(0)
    let fs = try Fs.served(shelf)
    let docs = try fs.subdir("docs")
    let reader = try docs.read_only()
    let path = try await docs.read_all("notes", alloc: world.alloc)
    let read = try await reads_back(reader, path: "notes")
    let written = attempt await reader.write_all("notes", data: b"x")
    let removed = attempt await docs.remove("notes")
    let released = reach(counter, body: tally_count)
    minter.revoke(shelf)
    let opened = attempt await docs.open("notes")
    let refused = match written {
        Err(fs::FsError.Denied) => true
        else => false
    }
    let missing = match removed {
        Err(fs::FsError.NotFound) => true
        else => false
    }
    let revoked = match opened {
        Err(fs::FsError.Revoked(Revoked.Stale)) => true
        else => false
    }
    expect path.byte_len() == 10 and read and refused and missing and revoked and released == Some(1)
} served_files_call_their_kind

/// Whether `net` denies a connection to `host`, abandoning one it opens.
fn denies_host(net: Net, host: Str) -> bool fails task::Cancelled uses wait {
    let outcome = attempt await net.connect(host, port: 7)
    var denied = false
    match outcome {
        Ok(conn) => take conn.abandon()
        Err(failure) => {
            denied = match failure {
                net::NetError.Denied => true
                else => false
            }
        }
    }
    return denied
} denies_host

/// Accepts a connection on a listener of `net` and abandons it, the listener released before it
/// returns.
fn accepts(net: Net) fails net::NetError uses wait {
    var listener = try await net.listen(80)
    let conn = try await mut listener.accept()
    take conn.abandon()
} accepts

test served_networks_call_their_kind for Net.served {
    let world = testing::world()
    let minter = lines(world.alloc)
    defer take minter.close()
    let counter = minter.mint(0)
    let net = try Net.served(minter.mint(0))
    let narrow = try net.only_host("10.0.0.2")
    let elsewhere = try await denies_host(narrow, host: "10.0.0.3")
    let conn = try await narrow.connect("10.0.0.2", port: 7)
    try await take conn.close()
    let listened = attempt await narrow.listen(80)
    try await accepts(net)
    let calls = reach(counter, body: tally_count)
    let refused = match listened {
        Err(net::NetError.Denied) => true
        else => false
    }
    expect elsewhere and refused and calls == Some(6)
} served_networks_call_their_kind

test denied_runners_refuse_every_operation for Runner.denied {
    let world = testing::world()
    var stepper = try Stepper[Relayer, RelayEnv, Relay].start(RelayEnv(alloc: world.alloc), exec: world.exec, alloc: world.alloc)
    mut stepper.attach(Runner.denied())
    mut stepper.deliver(Relay.sync())
    mut stepper.deliver(Relay.publish())
    let last = try await take stepper.end()
    expect last.state.refused == 2
} denied_runners_refuse_every_operation

