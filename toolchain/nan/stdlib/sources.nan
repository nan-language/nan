    \\pub open struct HashMap[K: Eq and Hash, V] {
    \\} HashMap
    \\
    \\/// The hasher that places the keys of `HashMap` and `OnceMap`: FNV-1a over the bytes each key's
    \\/// `hash` writes, from a start the map's seed sets.
    \\struct KeyHasher {
    \\    state: u64
    \\} KeyHasher
    \\
    \\impl KeyHasher: core::Hasher
    \\
    \\fn KeyHasher.write(mut self, bytes: Slice[u8]) limits pure, notrap, terminates {
    \\    for byte in bytes {
    \\        self.state = (self.state ^ u64.widen(byte)).wrapping_mul(0x0000_0100_0000_01B3)
    \\    }
    \\} KeyHasher.write
    \\
    \\pub fn HashMap.empty(seed: u64, alloc: Alloc) -> HashMap[K, V]
    \\    ensures result.len() == 0
    \\    example HashMap[u8, u8].empty(7, alloc: testing::world().alloc).len() == 0
    \\
    \\pub fn HashMap.len(self) -> usize limits pure, notrap, terminates
    \\
    \\pub fn HashMap.contains(self, key: K) -> bool limits pure, notrap, terminates
    \\    example not HashMap[u8, u8].empty(7, alloc: testing::world().alloc).contains(1)
    \\{
    \\    return self.get(key).is_some()
    \\} HashMap.contains
    \\
    \\pub fn HashMap.insert(mut self, take key: K, take value: V) -> Option[V]
    \\    ensures match result {
    \\        Some(_) => old(self.contains(key)) and self.len() == old(self.len())
    \\        None => not old(self.contains(key)) and self.len() > 0 and self.len() - 1 == old(self.len())
    \\    }
    \\
    \\pub fn HashMap.try_insert(mut self, take key: K, take value: V) -> Option[V] fails OutOfMemory
    \\    ensures match result {
    \\        Some(_) => old(self.contains(key)) and self.len() == old(self.len())
    \\        None => not old(self.contains(key)) and self.len() > 0 and self.len() - 1 == old(self.len())
    \\    }
    \\
    \\pub fn HashMap.remove(mut self, key: K) -> Option[V]
    \\    ensures not self.contains(key)
    \\    ensures match result {
    \\        Some(_) => old(self.contains(key)) and old(self.len()) > 0 and self.len() == old(self.len()) - 1
    \\        None => not old(self.contains(key)) and self.len() == old(self.len())
    \\    }
    \\    example HashMap[u8, u8].empty(7, alloc: testing::world().alloc).remove(1) == None
    \\
    \\pub proj fn HashMap.get(self, key: K) -> Option[V]
    \\    example HashMap[u8, u8].empty(7, alloc: testing::world().alloc).get(1) == None
    \\
    \\pub proj fn HashMap.get_mut(mut self, key: K) -> Option[V]
    \\
    \\pub proj fn HashMap.at(self, key: K) -> V
    \\    requires self.contains(key)
    \\
    \\pub proj fn HashMap.at_mut(mut self, key: K) -> V
    \\    requires self.contains(key)
    \\
    \\pub proj fn HashMap.cursor(self) -> HashMapCursor[K, V]
    \\
    \\pub proj fn HashMap.cursor_mut(mut self) -> HashMapCursorMut[K, V]
    \\
    \\pub fn HashMap.into_cursor(take self) -> HashMapIntoCursor[K, V]
    \\
    \\pub fn HashMap.retain(mut self, keep: fn(key: K, value: V) -> bool)
