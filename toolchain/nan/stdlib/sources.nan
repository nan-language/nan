    \\    ensures self.len() >= data.len() and self.len() - data.len() == old(self.len())
    \\    ensures match self.view().split_at(old(self.len())) {
    \\        Some(parts) => parts.tail == data
    \\        None => false
    \\    }
    \\
    \\pub fn Bytes.try_append(mut self, data: Slice[u8]) fails OutOfMemory
    \\    ensures self.len() >= data.len() and self.len() - data.len() == old(self.len())
    \\    ensures match self.view().split_at(old(self.len())) {
