//! Each line shows a value read from a const or a registry entry laid out in the image's data.

pub closed struct Entry derives Copy {
    pub name: text::Fixed[20]
    pub priority: u8
} Entry

pub registry entries: Entry keyed by name

contribute entries first_entry = Entry(name: text::Fixed[20].of("one"), priority: 3)

contribute entries second_entry = Entry(name: text::Fixed[20].of("two"), priority: 4)

const NAME: text::Fixed[8] = text::Fixed[8].of("abc")

const LIST: mem::Bounded[u16, 4] = two_words()

const LEFT: mem::BoundedCursor[u16, 4] = two_words().into_cursor()

const KEY: core::Secret[u32] = core::Secret.of(5u32)

const CHARS: core::CharCursor = "xyz".cursor()

const BYTES: core::SliceCursor[u8] = b"pq".cursor()

const WORDS: core::ArrayCursor[u16, 3] = Array[u16, 3].filled(4).into_cursor()

const DIGITS: Array[u8, 3] = counted()

const TRIPLE: Triple = Triple(digits: DIGITS)

const VIEW: Slice[u8] = DIGITS.view()

const HELD: Held = Held(count: 3, digits: DIGITS.view())

const PART: Slice[u8] = TRIPLE.digits.view()

const TAIL: Slice[u8] = TRIPLE.rest()

const NAME_BYTES: Slice[u8] = NAME.as_bytes()

pub closed struct Triple derives Copy {
    pub digits: Array[u8, 3]
} Triple

pub closed view struct Held {
    pub count: usize
    pub digits: Slice[u8]
} Held

/// The digits after the first.
pub proj fn Triple.rest(self) -> Slice[u8] {
    let Some(parts) = self.digits.view().split_at(1) else {
        return self.digits.view()
    }
    return parts.tail
} Triple.rest

/// The array of 1, 2 and 3.
fn counted() -> Array[u8, 3] {
    var made = Array[u8, 3].filled(0)
    made[0] = 1
    made[1] = 2
    made[2] = 3
    return made
} counted

/// A bounded list of 7 and 9.
fn two_words() -> mem::Bounded[u16, 4] {
    var made = mem::Bounded[u16, 4].empty()
    mut made.push(7)
    mut made.push(9)
    return made
} two_words

fn main(take world: host::World) fails task::Cancelled uses wait {
    for entry in entries {
        world.log.info("entry", value: entry.name.as_str())
        world.log.info("priority", value: entry.priority)
    }
    world.log.info("name", value: NAME.as_str())
    world.log.info("list", value: LIST.view()[1])
    var rest = LEFT
    discard mut rest.next()
    world.log.info("left", value: mut rest.next())
    world.log.info("key", value: KEY.reveal())
    var text = CHARS
    world.log.info("char", value: mut text.next())
    var pair = BYTES
    discard mut pair.next()
    world.log.info("byte", value: mut pair.next())
    var filled = WORDS
    discard mut filled.next()
    world.log.info("word", value: mut filled.next())
    world.log.info("view", value: VIEW[2])
    world.log.info("held", value: HELD.digits[HELD.count - 2])
    world.log.info("part", value: PART[0])
    world.log.info("tail", value: TAIL[0])
    world.log.info("name byte", value: NAME_BYTES[1])
} main
