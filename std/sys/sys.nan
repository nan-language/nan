pub closed enum CallError[E: Send] derives Render {
    Failed(E)
    Closed(task::SendError) from
    Cancelled(task::Cancelled) from
} CallError

struct Probe derives Encode {
    handled: u64
} Probe

struct ProbeEnv {
    clock: Clock
    counted: u64
} ProbeEnv

enum ProbeMessage {
    Count
    Echo
    Delay
    DelayNs
    Spawn(u64)
    Stop
} ProbeMessage

impl Probe: Component[ProbeEnv, ProbeMessage]

struct Tally {
} Tally

impl Tally: Kind[core::atomic::AtomicU64, u64]

fn tallies(start: u64, alloc: mem::Alloc) -> Minter[Tally, core::atomic::AtomicU64, u64] {
    return Minter.of(core::atomic::AtomicU64.of(start), alloc)
} tallies

fn tally_record(state: core::atomic::AtomicU64, record: u64) -> u64 = record

fn tally_count(state: core::atomic::AtomicU64, record: u64) -> u64 {
    discard state.fetch_add(record)
    return state.load()
} tally_count

fn Probe.start(mut env: ProbeEnv) -> Probe = Probe(handled: 0)

fn Probe.on(mut self, take message: ProbeMessage, mut env: ProbeEnv, mut cx: Cx[ProbeMessage]) {
    match message {
        ProbeMessage.Count => {
            self.handled += 1
            env.counted += 1
        }
        ProbeMessage.Echo => mut cx.send(ProbeMessage.Count)
        ProbeMessage.Delay => mut cx.after(ms: 10, send: ProbeMessage.Count)
        ProbeMessage.DelayNs => mut cx.after_ns(ns: 1_500, send: ProbeMessage.Count)
        ProbeMessage.Spawn(ms) => {
            let clock = env.clock
            mut cx.spawn(key: 1, run: fn(out: Outbox[ProbeMessage]) fails task::Cancelled uses wait {
                try await clock.sleep(ms)
                discard attempt await out.post(ProbeMessage.Count)
            })
        }
        ProbeMessage.Stop => mut cx.cancel(key: 1)
    }
} Probe.on

test trap_stays_inside_its_domain for Domain.run {
    let world = testing::world()
    let divisor: u32 = 0
    let outcome = try await Domain.run(fn() -> u32 {
        return 10 / divisor
    }, exec: world.exec, alloc: world.alloc)
    expect outcome.is_err()
} trap_stays_inside_its_domain

test sized_stack_holds_a_large_frame for Domain.run_sized {
    let world = testing::world()
    let outcome = try await Domain.run_sized(fn() -> u8 {
        let block = Array[u8, 200_000].filled(7)
        return block[199_999]
    }, stack: 1_048_576, exec: world.exec, alloc: world.alloc)
    let Ok(last) = outcome else {
        expect false
        return
    }
    expect last == 7
} sized_stack_holds_a_large_frame

test trap_renders_its_report for Trap.render {
    let world = testing::world()
    let divisor: u32 = 0
    let outcome = try await Domain.run(fn() -> u32 {
        return 10 / divisor
    }, exec: world.exec, alloc: world.alloc)
    let Err(trap) = outcome else {
        return
    }
    var report = text::String.empty(world.alloc)
    mut report.write(text::fmt("{trap}", trap), budget: 1_024)
    expect report.starts_with("trap.division-by-zero at ")
} trap_renders_its_report

test trap_names_its_kind for Trap.kind {
    let world = testing::world()
    let divisor: u32 = 0
    let outcome = try await Domain.run(fn() -> u32 {
        return 10 / divisor
    }, exec: world.exec, alloc: world.alloc)
    let Err(trap) = outcome else {
        return
    }
    let kind = trap.kind()
    expect kind == TrapKind.DivisionByZero
} trap_names_its_kind

test trigger_abandons_the_running_domain for Abandoner.trigger {
    let world = testing::world()
    let clock = world.clock
    let abandoner = mem::Shared.of(Abandoner.new(), alloc: world.alloc)
    var kind: Option[TrapKind] = None
    try await task::scope(world.exec, body: fn[mut kind](s: task::Scope) fails task::Cancelled uses wait {
        let watch = abandoner.share()
        discard s.spawn(fn[take watch]() fails task::Cancelled uses wait {
            try await clock.sleep(10)
            watch.contents().trigger()
        })
        let outcome = try await abandoner.contents().run(fn() fails task::Cancelled uses wait {
            loop {
                try await clock.sleep(1)
            }
        }, exec: world.exec, alloc: world.alloc)
        let Err(trap) = outcome else {
            return
        }
        kind = Some(trap.kind())
    })
    expect kind == Some(TrapKind.Abandoned)
} trigger_abandons_the_running_domain

test triggered_abandoner_runs_nothing for Abandoner.run {
    let world = testing::world()
    let abandoner = Abandoner.new()
    abandoner.trigger()
    let outcome = try await abandoner.run(fn() -> u32 {
        return 1
    }, exec: world.exec, alloc: world.alloc)
    let Err(trap) = outcome else {
        expect false
        return
    }
    expect trap.kind() == TrapKind.Abandoned
} triggered_abandoner_runs_nothing

test new_abandoner_runs_its_body for Abandoner.new {
    let world = testing::world()
    let outcome = try await Abandoner.new().run(fn() -> u32 {
        return 7
    }, exec: world.exec, alloc: world.alloc)
    let Ok(value) = outcome else {
        expect false
        return
    }
    expect value == 7
} new_abandoner_runs_its_body

test sized_run_contains_its_trap for Abandoner.run_sized {
    let world = testing::world()
    let divisor: u32 = 0
    let outcome = try await Abandoner.new().run_sized(fn() -> u32 {
        return 10 / divisor
    }, stack: 1_048_576, exec: world.exec, alloc: world.alloc)
    let Err(trap) = outcome else {
        expect false
        return
    }
    expect trap.kind() == TrapKind.DivisionByZero
} sized_run_contains_its_trap

test read_only_fs_refuses_writes for Fs.read_only {
    let world = testing::world()
    let reader = try world.fs.read_only()
    let outcome = attempt await reader.write_all("note", data: b"x")
    let denied = match outcome {
        Err(fs::FsError.Denied) => true
        else => false
    }
    expect denied
} read_only_fs_refuses_writes

test open_of_a_missing_file_fails for Fs.open {
    let world = testing::world()
    let outcome = attempt await world.fs.open("missing")
    let missing = match outcome {
        Err(fs::FsError.NotFound) => true
        else => false
    }
    expect missing
} open_of_a_missing_file_fails

test create_truncates_an_existing_file for Fs.create {
    let world = testing::world()
    try await world.fs.write_all("note", data: b"hello")
    let file = try await world.fs.create("note")
    let len = try await file.byte_len()
    expect len == 0
} create_truncates_an_existing_file

test read_all_returns_the_written_bytes for Fs.read_all {
    let world = testing::world()
    try await world.fs.write_all("note", data: b"hello")
    let saved = try await world.fs.read_all("note", alloc: world.alloc)
    expect testing::same(saved.view(), expected: Untrusted.of(b"hello"))
} read_all_returns_the_written_bytes

test write_all_replaces_contents_below_new_directories for Fs.write_all {
    let world = testing::world()
    try await world.fs.write_all("notes/day", data: b"first")
    try await world.fs.write_all("notes/day", data: b"next")
    let saved = try await world.fs.read_all("notes/day", alloc: world.alloc)
    expect testing::same(saved.view(), expected: Untrusted.of(b"next"))
} write_all_replaces_contents_below_new_directories

test removed_file_cannot_be_opened for Fs.remove {
    let world = testing::world()
    try await world.fs.write_all("note", data: b"x")
    try await world.fs.remove("note")
    let outcome = attempt await world.fs.open("note")
    let missing = match outcome {
        Err(fs::FsError.NotFound) => true
        else => false
    }
    expect missing
} removed_file_cannot_be_opened

test narrowed_net_cannot_listen for Net.only_host {
    let world = testing::world()
    let narrow = try world.net.only_host("localhost")
    let outcome = attempt await narrow.listen(4_100)
    let denied = match outcome {
        Err(net::NetError.Denied) => true
        else => false
    }
    expect denied
} narrowed_net_cannot_listen

test net_narrowed_to_two_hosts_reaches_none for Net.only_host {
    let world = testing::world()
    let narrow = try world.net.only_host("localhost")
    let none = try narrow.only_host("127.0.0.1")
    let again = try none.only_host("localhost")
    let outcome = attempt await again.connect("localhost", port: 4_100)
    var denied = false
    match outcome {
        Ok(conn) => take conn.abandon()
        Err(failure) => {
            denied = match failure {
                net::NetError.Denied => true
                else => false
            }
        }
    }
    expect denied
} net_narrowed_to_two_hosts_reaches_none

test taken_port_cannot_be_listened_on for Net.listen {
    let world = testing::world()
    let held = try await world.net.listen(4_100)
    let outcome = attempt await world.net.listen(4_100)
    discard held
    let taken = match outcome {
        Err(net::NetError.AddressInUse) => true
        else => false
    }
    expect taken
} taken_port_cannot_be_listened_on

test connect_without_a_listener_is_refused for Net.connect {
    let world = testing::world()
    let outcome = attempt await world.net.connect("localhost", port: 4_100)
    var refused = false
    match outcome {
        Ok(conn) => take conn.abandon()
        Err(failure) => {
            refused = match failure {
                net::NetError.Refused => true
                else => false
            }
        }
    }
    expect refused
} connect_without_a_listener_is_refused

test sleep_lets_time_pass for Clock.sleep {
    let world = testing::world()
    let start = try world.clock.elapsed_ms()
    try await world.clock.sleep(25)
    let finish = try world.clock.elapsed_ms()
    expect finish - start >= 25
} sleep_lets_time_pass

test elapsed_ns_counts_virtual_nanoseconds for Clock.elapsed_ns {
    let world = testing::world()
    try await world.clock.sleep(2)
    let elapsed = try world.clock.elapsed_ns()
    expect elapsed == 2_000_000
} elapsed_ns_counts_virtual_nanoseconds

test sleep_ns_lets_nanoseconds_pass for Clock.sleep_ns {
    let world = testing::world()
    let start = try world.clock.elapsed_ns()
    try await world.clock.sleep_ns(250)
    let finish = try world.clock.elapsed_ns()
    expect finish - start == 250
} sleep_ns_lets_nanoseconds_pass

test coarse_clock_reads_and_wakes_on_its_resolution for Clock.coarse {
    let world = testing::world()
    try await world.clock.sleep_ns(1_500)
    let coarse = try world.clock.coarse(1_000)
    let read = try coarse.elapsed_ns()
    try await coarse.sleep_ns(100)
    let woke = try world.clock.elapsed_ns()
    let finer = try coarse.coarse(10)
    let kept = try finer.elapsed_ns()
    expect read == 1_000
    expect woke == 2_000
    expect kept == 2_000
} coarse_clock_reads_and_wakes_on_its_resolution

test wall_clock_reads_the_virtual_clock for WallClock.now_ns {
    let world = testing::world()
    try await world.clock.sleep_ns(42)
    let now = try world.wall.now_ns()
    expect now == 42
} wall_clock_reads_the_virtual_clock

test coarse_wall_clock_rounds_down for WallClock.coarse {
    let world = testing::world()
    try await world.clock.sleep_ns(1_500)
    let wall = try world.wall.coarse(1_000)
    let now = try wall.now_ns()
    expect now == 1_000
} coarse_wall_clock_rounds_down

test revoked_random_cannot_fill for Random.fill {
    let world = testing::world()
    let revoker = try revocable(world.random)
    let random = revoker.capability()
    take revoker.revoke()
    var bytes = Array[u8, 4].filled(0)
    let outcome = attempt random.fill(mut bytes.view_mut())
    expect outcome == Err(Revoked.Stale)
} revoked_random_cannot_fill

test next_u64_reads_eight_bytes_low_first for Random.next_u64 {
    var bytes = Array[u8, 8].filled(0)
    try sim::random(3).fill(mut bytes.view_mut())
    let value = try sim::random(3).next_u64()
    expect value == bytes.view().u64_le(0)
} next_u64_reads_eight_bytes_low_first

test info_records_a_value for Log.info {
    let world = testing::world()
    world.log.info("answer", value: 42u32)
} info_records_a_value

test revoked_log_drops_records_quietly for Log.warn {
    let world = testing::world()
    let revoker = try revocable(world.log)
    let log = revoker.capability()
    take revoker.revoke()
    log.warn("dropped", value: 1u32)
} revoked_log_drops_records_quietly

test error_records_a_failure for Log.error {
    let world = testing::world()
    world.log.error("failed", value: Revoked.Stale)
} error_records_a_failure

test empty_input_ends_at_once for Stdio.read_in {
    let world = testing::world()
    var buf = Untrusted.of(Array[u8, 4].filled(0))
    let count = try await world.stdio.read_in(mut buf.view_mut())
    expect count == 0
} empty_input_ends_at_once

test revoked_stdio_cannot_write for Stdio.write_out {
    let world = testing::world()
    let revoker = try revocable(world.stdio)
    let stdio = revoker.capability()
    take revoker.revoke()
    let outcome = attempt await stdio.write_out(b"lost")
    let revoked = match outcome {
        Err(StdioError.Revoked(_)) => true
        else => false
    }
    expect revoked
} revoked_stdio_cannot_write

test write_err_writes_the_data for Stdio.write_err {
    let world = testing::world()
    try await world.stdio.write_err(b"warning\n")
} write_err_writes_the_data

test revocable_copy_goes_stale for revocable {
    let world = testing::world()
    let revoker = try revocable(world.clock)
    let clock = revoker.capability()
    take revoker.revoke()
    let outcome = attempt clock.elapsed_ms()
    expect outcome == Err(Revoked.Stale)
} revocable_copy_goes_stale

test capability_acts_until_revoked for Revoker.capability {
    let world = testing::world()
    let revoker = try revocable(world.clock)
    let outcome = attempt revoker.capability().elapsed_ms()
    take revoker.revoke()
    expect outcome.is_ok()
} capability_acts_until_revoked

test revoke_reaches_derived_capabilities for Revoker.revoke {
    let world = testing::world()
    let revoker = try revocable(world.fs)
    defer take revoker.revoke()
    let reports = try revoker.capability().subdir("reports")
    undefer revoker
    take revoker.revoke()
    let outcome = attempt await reports.write_all("day", data: b"x")
    let revoked = match outcome {
        Err(fs::FsError.Revoked(_)) => true
        else => false
    }
    expect revoked
} revoke_reaches_derived_capabilities

test new_minter_keeps_its_state for Minter.of {
    let world = testing::world()
    let minter = tallies(5, alloc: world.alloc)
    defer take minter.close()
    let tally = minter.mint(0)
    let start = reach(tally, body: fn(state: core::atomic::AtomicU64, record: u64) => state.load())
    expect start == Some(5)
} new_minter_keeps_its_state

test minted_handle_keeps_its_record for Minter.mint {
    let world = testing::world()
    let minter = tallies(0, alloc: world.alloc)
    defer take minter.close()
    let tally = minter.mint(7)
    let record = reach(tally, body: fn(state: core::atomic::AtomicU64, record: u64) => record)
    expect record == Some(7)
} minted_handle_keeps_its_record

test revoke_reaches_only_its_own_entries for Minter.revoke {
    let world = testing::world()
    let minter = tallies(0, alloc: world.alloc)
    defer take minter.close()
    let other = tallies(0, alloc: world.alloc)
    defer take other.close()
    let tally = minter.mint(1)
    let kept = minter.mint(2)
    let stranger = other.mint(3)
    let narrowed = try derive(tally, narrow: tally_record)
    minter.revoke(tally)
    minter.revoke(stranger)
    expect reach(tally, body: tally_record) == None
    expect reach(narrowed, body: tally_record) == None
    expect reach(kept, body: tally_record) == Some(2)
    expect reach(stranger, body: tally_record) == Some(3)
} revoke_reaches_only_its_own_entries

test closed_minter_stales_its_handles for Minter.close {
    let world = testing::world()
    let minter = tallies(0, alloc: world.alloc)
    defer take minter.close()
    let tally = minter.mint(1)
    let revoker = try revocable(tally)
    let copy = revoker.capability()
    undefer minter
    take minter.close()
    expect reach(tally, body: tally_record) == None
    expect reach(copy, body: tally_record) == None
    take revoker.revoke()
} closed_minter_stales_its_handles

test reaches_share_their_minter_state for reach {
    let world = testing::world()
    let minter = tallies(0, alloc: world.alloc)
    defer take minter.close()
    discard reach(minter.mint(2), body: tally_count)
    let revoker = try revocable(minter.mint(3))
    let copy = revoker.capability()
    let total = reach(copy, body: tally_count)
    take revoker.revoke()
    let after = reach(copy, body: tally_count)
    expect total == Some(5)
    expect after == None
} reaches_share_their_minter_state

test derived_handle_records_the_narrowed_record for derive {
    let world = testing::world()
    let minter = tallies(0, alloc: world.alloc)
    defer take minter.close()
    let tally = minter.mint(6)
    let half = try derive(tally, narrow: fn(state: core::atomic::AtomicU64, record: u64) => record / 2)
    expect reach(half, body: tally_record) == Some(3)
    minter.revoke(tally)
    let stale = match attempt derive(tally, narrow: tally_record) {
        Err(Revoked.Stale) => true
        else => false
    }
    expect stale
} derived_handle_records_the_narrowed_record

test sent_message_is_handled for Cx.send {
    let world = testing::world()
    let last = try await host::Runner[Probe].run(ProbeEnv(clock: world.clock, counted: 0), exec: world.exec, alloc: world.alloc, body: fn(inbox: Outbox[ProbeMessage]) fails task::SendError uses wait {
        try await inbox.post(ProbeMessage.Echo)
        try await inbox.post(ProbeMessage.Count)
    })
    expect last.handled == 2
} sent_message_is_handled

test delayed_message_waits_for_its_delay for Cx.after {
    let world = testing::world()
    let clock = world.clock
    let hurried = try await host::Runner[Probe].run(ProbeEnv(clock: clock, counted: 0), exec: world.exec, alloc: world.alloc, body: fn(inbox: Outbox[ProbeMessage]) fails task::SendError uses wait {
        try await inbox.post(ProbeMessage.Delay)
    })
    let patient = try await host::Runner[Probe].run(ProbeEnv(clock: clock, counted: 0), exec: world.exec, alloc: world.alloc, body: fn(inbox: Outbox[ProbeMessage]) fails task::SendError uses wait {
        try await inbox.post(ProbeMessage.Delay)
        try await clock.sleep(50)
    })
    expect hurried.handled == 0
    expect patient.handled == 1
} delayed_message_waits_for_its_delay

