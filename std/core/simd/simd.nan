pub fn Mask8x16.bit_not(self) -> Mask8x16 limits pure, notrap, terminates
    example U8x16.splat(1).lanes_eq(U8x16.splat(2)).bit_not().all()
{
    var lanes = self.lanes
    for index in 0..<16usize {
        lanes[index] = ~lanes[index]
    }
    return Mask8x16(lanes: lanes)
} Mask8x16.bit_not

pub fn Mask8x16.any(self) -> bool limits pure, notrap, terminates
    example U8x16.splat(1).replace_lane(1, value: 2).lanes_eq(U8x16.splat(2)).any()
{
    for index in 0..<16usize {
        if self.lanes[index] != 0 {
            return true
        }
    }
    return false
} Mask8x16.any

pub fn Mask8x16.all(self) -> bool limits pure, notrap, terminates
    example not U8x16.splat(1).replace_lane(1, value: 2).lanes_eq(U8x16.splat(2)).all()
{
    for index in 0..<16usize {
        if self.lanes[index] == 0 {
            return false
        }
    }
    return true
} Mask8x16.all

pub fn Mask8x16.bitmask(self) -> u16 limits pure, notrap, terminates
    example U8x16.splat(1).replace_lane(1, value: 2).lanes_eq(U8x16.splat(2)).bitmask() == 0b10
{
    var bits = 0u16
    for index in 0..<16u32 {
        if (self.lanes[usize.widen(index)] >> 7) == 1 {
            bits = bits | (1u16 << index)
        }
    }
    return bits
} Mask8x16.bitmask

