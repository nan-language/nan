//! Files written, read back, removed and moved, and directories made, listed and removed, through the file system capability on the host.

fn main(take world: host::World) fails task::Cancelled uses wait {
    let fs = world.fs
    let wrote = attempt await fs.write_all("notes/day", data: b"hello")
    world.log.info("wrote", value: wrote.is_ok())
    match attempt await fs.read_all("notes/day", alloc: world.alloc) {
        Ok(read) => world.log.info("read bytes", value: read.byte_len())
        Err(error) => world.log.info("read failed", value: error)
    }
    let removed = attempt await fs.remove("notes/day")
    world.log.info("removed", value: removed.is_ok())
    match attempt await fs.read_all("notes/day", alloc: world.alloc) {
        Ok(_) => world.log.info("read after removal", value: true)
        Err(error) => world.log.info("read after removal failed", value: error)
    }
    match attempt await directories(world) {
        Ok(_) => {}
        Err(error) => world.log.info("directories failed", value: error)
    }
} main

fn directories(world: host::World) fails sys::fs::FsError uses wait {
    let fs = world.fs
    try await fs.create_dir("notes/old")
    try await fs.write_all("notes/draft", data: b"kept")
    try await fs.rename("notes/draft", to: "notes/old/kept")
    for entry in try await fs.list("notes", alloc: world.alloc) {
        world.log.info("listed", value: entry.name)
        world.log.info("listed kind", value: entry.kind)
    }
    world.log.info("kind", value: try await fs.kind("notes/old/kept"))
    try await fs.remove("notes/old/kept")
    try await fs.remove("notes/old")
    world.log.info("left", value: (try await fs.list("notes", alloc: world.alloc)).len())
} directories
