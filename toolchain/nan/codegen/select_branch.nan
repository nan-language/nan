//! Instruction selection for x86-64 of comparisons, the conditional branches and selects that read them, the 128-bit comparisons, and jump tables.

/// How the flags a comparison sets answer it: one condition, both of two, or either of two.
enum FlagTest derives Copy, Eq {
    One(x64::Cond)
    Both(left: x64::Cond, right: x64::Cond)
    Either(left: x64::Cond, right: x64::Cond)
} FlagTest

/// The flag test holding exactly when this one does not.
fn FlagTest.inverse(self) -> FlagTest {
    return match self {
        FlagTest.One(cond) => FlagTest.One(cond.invert())
        FlagTest.Both(left: left, right: right) => FlagTest.Either(left: left.invert(), right: right.invert())
        FlagTest.Either(left: left, right: right) => FlagTest.Both(left: left.invert(), right: right.invert())
    }
} FlagTest.inverse

fn int_cond(cond: clif::IntCC) -> x64::Cond {
    return match cond {
        clif::IntCC.Equal => x64::Cond.Equal
        clif::IntCC.NotEqual => x64::Cond.NotEqual
        clif::IntCC.SignedLessThan => x64::Cond.Less
        clif::IntCC.SignedGreaterThanOrEqual => x64::Cond.GreaterOrEqual
        clif::IntCC.SignedGreaterThan => x64::Cond.Greater
        clif::IntCC.SignedLessThanOrEqual => x64::Cond.LessOrEqual
        clif::IntCC.UnsignedLessThan => x64::Cond.Below
        clif::IntCC.UnsignedGreaterThanOrEqual => x64::Cond.AboveOrEqual
        clif::IntCC.UnsignedGreaterThan => x64::Cond.Above
        clif::IntCC.UnsignedLessThanOrEqual => x64::Cond.BelowOrEqual
    }
} int_cond

/// Sets the flags comparing two integers at their type's width: `test` against zero, `cmp` with
/// an immediate when one side is a constant that fits, else `cmp`.
fn Selector.int_compare(mut self, func: clif::Function, cond: clif::IntCC, x: clif::Value, y: clif::Value) -> FlagTest {
    let ty = func.value_type(x)
    if ty == clif::Type.Int128 {
        return mut self.wide_compare(func, cond, x, y)
    }
    let size = exact_size(ty)
    var lhs = x
    var rhs = y
    var tested = cond
    if self.imm(x, func).is_some() and self.imm(y, func).is_none() {
        lhs = y
        rhs = x
        tested = swapped(cond)
    }
    let reg = mut self.src(lhs, func)
    match self.imm(rhs, func) {
        Some(imm) => {
            if imm == 0 {
                mut self.emit(x64::Inst.Test(size: size, lhs: reg, rhs: reg))
            } else {
                mut self.emit(x64::Inst.CmpImm(size: size, lhs: reg, imm: imm))
            }
        }
        None => {
            let other = mut self.src(rhs, func)
            mut self.emit(x64::Inst.Cmp(size: size, lhs: reg, rhs: other))
        }
    }
    return FlagTest.One(int_cond(tested))
} Selector.int_compare

/// Sets the flags comparing two 128-bit integers: equality from the halves' differences, an
/// order from the borrow and sign of subtracting them, the operands swapped for the orders
/// `cmp`'s conditions do not name.
fn Selector.wide_compare(mut self, func: clif::Function, cond: clif::IntCC, x: clif::Value, y: clif::Value) -> FlagTest {
    if cond == clif::IntCC.Equal or cond == clif::IntCC.NotEqual {
        let x_high = mut self.src_high(x, func)
        let y_high = mut self.src_high(y, func)
        let x_low = mut self.src(x, func)
        let y_low = mut self.src(y, func)
        let low = mut self.copy(x_low)
        mut self.emit(x64::Inst.Alu(op: x64::AluOp.Xor, size: x64::Size.Qword, dst: low, src: y_low))
        let high = mut self.copy(x_high)
        mut self.emit(x64::Inst.Alu(op: x64::AluOp.Xor, size: x64::Size.Qword, dst: high, src: y_high))
        mut self.emit(x64::Inst.Alu(op: x64::AluOp.Or, size: x64::Size.Qword, dst: low, src: high))
        return FlagTest.One(int_cond(cond))
    }
    var lhs = x
    var rhs = y
    var tested = cond
    match cond {
        clif::IntCC.SignedGreaterThan or clif::IntCC.SignedLessThanOrEqual or clif::IntCC.UnsignedGreaterThan or clif::IntCC.UnsignedLessThanOrEqual => {
            lhs = y
            rhs = x
            tested = swapped(cond)
        }
        else => {}
    }
    let lhs_low = mut self.src(lhs, func)
    let lhs_high = mut self.src_high(lhs, func)
    let rhs_low = mut self.src(rhs, func)
    let rhs_high = mut self.src_high(rhs, func)
    let difference = mut self.temp(false)
    mut self.emit(x64::Inst.Cmp(size: x64::Size.Qword, lhs: lhs_low, rhs: rhs_low))
    mut self.mov(difference, src: lhs_high)
    mut self.emit(x64::Inst.Alu(op: x64::AluOp.Sbb, size: x64::Size.Qword, dst: difference, src: rhs_high))
    return FlagTest.One(int_cond(tested))
} Selector.wide_compare

/// Sets the flags comparing two floats with `ucomiss` or `ucomisd`, the operands swapped for the
/// orders that read as above-or-below on the other side; an unordered comparison sets zero,
/// parity and carry.
fn Selector.float_compare(mut self, func: clif::Function, cond: clif::FloatCC, x: clif::Value, y: clif::Value) -> FlagTest {
    expect self.isa.floats
    let size = exact_size(func.value_type(x))
    var lhs = x
    var rhs = y
    match cond {
        clif::FloatCC.LessThan or clif::FloatCC.LessThanOrEqual or clif::FloatCC.UnorderedOrGreaterThan or clif::FloatCC.UnorderedOrGreaterThanOrEqual => {
            lhs = y
            rhs = x
        }
        else => {}
    }
    let a = mut self.src(lhs, func)
    let b = mut self.src(rhs, func)
    mut self.emit(x64::Inst.Ucomis(size: size, lhs: a, rhs: b))
    return match cond {
        clif::FloatCC.Ordered => FlagTest.One(x64::Cond.NoParity)
        clif::FloatCC.Unordered => FlagTest.One(x64::Cond.Parity)
        clif::FloatCC.Equal => FlagTest.Both(left: x64::Cond.NoParity, right: x64::Cond.Equal)
        clif::FloatCC.NotEqual => FlagTest.Either(left: x64::Cond.Parity, right: x64::Cond.NotEqual)
        clif::FloatCC.OrderedNotEqual => FlagTest.One(x64::Cond.NotEqual)
        clif::FloatCC.UnorderedOrEqual => FlagTest.One(x64::Cond.Equal)
        clif::FloatCC.GreaterThan or clif::FloatCC.LessThan => FlagTest.One(x64::Cond.Above)
        clif::FloatCC.GreaterThanOrEqual or clif::FloatCC.LessThanOrEqual => FlagTest.One(x64::Cond.AboveOrEqual)
        clif::FloatCC.UnorderedOrLessThan or clif::FloatCC.UnorderedOrGreaterThan => FlagTest.One(x64::Cond.Below)
        clif::FloatCC.UnorderedOrLessThanOrEqual or clif::FloatCC.UnorderedOrGreaterThanOrEqual => FlagTest.One(x64::Cond.BelowOrEqual)
    }
} Selector.float_compare

/// Writes a comparison's answer as 0 or 1 into its result.
fn Selector.set_flag(mut self, func: clif::Function, inst: clif::Inst, outcome: FlagTest) {
    let dst = mut self.dst_of(func, inst)
    mut self.write_flag(dst, outcome)
} Selector.set_flag

fn Selector.write_flag(mut self, dst: machinst::Reg, outcome: FlagTest) {
    match outcome {
        FlagTest.One(cond) => mut self.emit(x64::Inst.Setcc(cond: cond, dst: dst))
        FlagTest.Both(left: left, right: right) => mut self.combine(dst, left, right, op: x64::AluOp.And)
        FlagTest.Either(left: left, right: right) => mut self.combine(dst, left, right, op: x64::AluOp.Or)
    }
} Selector.write_flag

fn Selector.combine(mut self, dst: machinst::Reg, left: x64::Cond, right: x64::Cond, op: x64::AluOp) {
    let other = mut self.temp(false)
    mut self.emit(x64::Inst.Setcc(cond: left, dst: dst))
    mut self.emit(x64::Inst.Setcc(cond: right, dst: other))
    mut self.emit(x64::Inst.Alu(op: op, size: x64::Size.Dword, dst: dst, src: other))
} Selector.combine

/// The flags deciding a branch or a select on `c`: those of the comparison deciding the flag
/// `c` is or tests against zero, made again for each reader, else those of testing `c` against
/// zero.
fn Selector.condition(mut self, func: clif::Function, c: clif::Value) -> FlagTest {
    let Some(decided) = self.facts.decider(func, value: c) else {
        let reg = mut self.src(c, func)
        let size = exact_size(func.value_type(c))
        mut self.emit(x64::Inst.Test(size: size, lhs: reg, rhs: reg))
        return FlagTest.One(x64::Cond.NotEqual)
    }
    var outcome = FlagTest.One(x64::Cond.NotEqual)
    match func.inst_data(decided.compare) {
        clif::InstructionData.IntCompare(opcode: _, cond: cond, x: x, y: y) => {
            outcome = mut self.int_compare(func, cond, x, y)
        }
        clif::InstructionData.FloatCompare(opcode: _, cond: cond, x: x, y: y) => {
            outcome = mut self.float_compare(func, cond, x, y)
        }
        else => {
            expect false
        }
    }
    if decided.inverted {
        return outcome.inverse()
    }
    return outcome
} Selector.condition

/// The one condition a flag test reads, combining a test of two into a flag tested again.
fn Selector.single(mut self, outcome: FlagTest) -> x64::Cond {
    let FlagTest.One(cond) = outcome else {
        let flag = mut self.temp(false)
        mut self.write_flag(flag, outcome)
        mut self.emit(x64::Inst.Test(size: x64::Size.Byte, lhs: flag, rhs: flag))
        return x64::Cond.NotEqual
    }
    return cond
} Selector.single

/// A select: the condition's flag, or its inverse, when it chooses between 1 and 0, else a
/// conditional move.
fn Selector.select_value(mut self, func: clif::Function, inst: clif::Inst, c: clif::Value, x: clif::Value, y: clif::Value) {
    let outcome = mut self.condition(func, c)
    let ty = func.value_type(x)
    let Some(flag_test) = flag_choice(outcome, chosen: self.facts.constant(x, func), other: self.facts.constant(y, func)) else {
        mut self.select_move(func, inst, outcome, x, y)
        return
    }
    if ty.is_int() and ty.bits() <= 64 {
        let flag = mut self.dst_of(func, inst)
        mut self.write_flag(flag, outcome: flag_test)
        if ty.bits() > 8 {
            mut self.emit(x64::Inst.Extend(kind: x64::ExtendKind.Zx8, dst: flag, src: flag))
        }
        return
    }
    mut self.select_move(func, inst, outcome, x, y)
} Selector.select_value

/// The flag test a select writes as its result when it chooses 1 over 0, or 0 over 1 on one
/// condition.
fn flag_choice(outcome: FlagTest, chosen: Option[u64], other: Option[u64]) -> Option[FlagTest] {
    if chosen == Some(1) and other == Some(0) {
        return Some(outcome)
    }
    if chosen == Some(0) and other == Some(1) {
        match outcome {
            FlagTest.One(cond) => return Some(FlagTest.One(cond.invert()))
            else => return None
        }
    }
    return None
} flag_choice

/// A select as a conditional move of the chosen value over the other.
fn Selector.select_move(mut self, func: clif::Function, inst: clif::Inst, outcome: FlagTest, x: clif::Value, y: clif::Value) {
    let cond = mut self.single(outcome)
    let ty = func.value_type(x)
    let dst = mut self.dst_of(func, inst)
    let chosen = mut self.src(x, func)
    let other = mut self.src(y, func)
    mut self.mov(dst, src: other)
    if in_xmm(ty, floats: self.isa.floats) {
        mut self.emit(x64::Inst.XmmCmov(cond: cond, dst: dst, src: chosen))
        return
    }
    mut self.emit(x64::Inst.Cmov(cond: cond, size: op_size(ty), dst: dst, src: chosen))
    if ty == clif::Type.Int128 {
        let dst_high = mut self.dst_high_of(func, inst)
        let chosen_high = mut self.src_high(x, func)
        let other_high = mut self.src_high(y, func)
        mut self.mov(dst_high, src: other_high)
        mut self.emit(x64::Inst.Cmov(cond: cond, size: x64::Size.Qword, dst: dst_high, src: chosen_high))
    }
} Selector.select_move

/// A conditional branch: a jump on the condition to the first target, or to the block passing
/// its arguments, then a jump to the second.
fn Selector.brif(mut self, func: clif::Function, block: clif::Block, c: clif::Value, then_block: clif::Block, else_block: clif::Block) {
    let outcome = mut self.condition(func, c)
    let at = usize.widen(block.index)
    expect at < self.facts.then_edges.len() and at < self.facts.else_edges.len()
    let taken = self.facts.target_of(self.facts.then_edges[at], block: then_block)
    let other = self.facts.target_of(self.facts.else_edges[at], block: else_block)
    match outcome {
        FlagTest.One(cond) => mut self.emit(x64::Inst.Jcc(cond: cond, label: taken))
        FlagTest.Both(left: left, right: right) => {
            mut self.emit(x64::Inst.Jcc(cond: left.invert(), label: other))
            mut self.emit(x64::Inst.Jcc(cond: right, label: taken))
        }
        FlagTest.Either(left: left, right: right) => {
            mut self.emit(x64::Inst.Jcc(cond: left, label: taken))
            mut self.emit(x64::Inst.Jcc(cond: right, label: taken))
        }
    }
    mut self.emit(x64::Inst.Jmp(label: other))
    mut self.code.succs.push(taken)
    mut self.code.succs.push(other)
} Selector.brif

/// A chain's branches: its value, zero-extended and less the smallest constant, indexing a table
/// of the targets when within the constants' span, else a jump to the default.
fn Selector.jump_table(mut self, func: clif::Function, index: u32) {
    let JumpTable(value: tested, low: low, span: span, default: default, entries: entries, reached: reached) = self.facts.jump_table(index)
    let value = mut self.src(tested, func)
    let offset_index = mut self.temp(false)
    match func.value_type(tested).bits() {
        8 => mut self.emit(x64::Inst.Extend(kind: x64::ExtendKind.Zx8, dst: offset_index, src: value))
        16 => mut self.emit(x64::Inst.Extend(kind: x64::ExtendKind.Zx16, dst: offset_index, src: value))
        32 => mut self.emit(x64::Inst.Extend(kind: x64::ExtendKind.Zx32, dst: offset_index, src: value))
        else => mut self.mov(offset_index, src: value)
    }
    if low != 0 {
        mut self.emit(x64::Inst.AluImm(op: x64::AluOp.Sub, size: x64::Size.Qword, dst: offset_index, imm: i32.fit(low)))
    }
    mut self.emit(x64::Inst.CmpImm(size: x64::Size.Qword, lhs: offset_index, imm: i32.fit(span)))
    mut self.emit(x64::Inst.Jcc(cond: x64::Cond.Above, label: default))
    for label in reached {
        mut self.code.succs.push(label)
    }
    let table = mut self.code.add_table(entries.view())
    let base = mut self.temp(false)
    let offset = mut self.temp(false)
    mut self.emit(x64::Inst.JumpTable(index: offset_index, base: base, temp: offset, table: table))
} Selector.jump_table
