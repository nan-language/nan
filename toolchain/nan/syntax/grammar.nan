/// The token classes and virtual tokens that syntactic rules name.
pkg enum Class derives Copy, Eq {
    Ident
    Int
    Float
    Text
    Bytes
    Char
    Byte
    TextLine
    Doc
    FileDoc
    Nl
    Col0
    Eof
} Class

/// The class as grammar notation names it.
pkg proj fn Class.name(self) -> Str {
    return match self {
        Class.Ident => "IDENT"
        Class.Int => "INT"
        Class.Float => "FLOAT"
        Class.Text => "TEXT"
        Class.Bytes => "BYTES"
        Class.Char => "CHAR"
        Class.Byte => "BYTE"
        Class.TextLine => "TEXT_LINE"
        Class.Doc => "DOC"
        Class.FileDoc => "FILE_DOC"
        Class.Nl => "NL"
        Class.Col0 => "COL0"
        Class.Eof => "EOF"
    }
} Class.name

/// The position of the class among the classes.
fn Class.index(self) -> usize {
    return match self {
        Class.Ident => 0
        Class.Int => 1
        Class.Float => 2
        Class.Text => 3
        Class.Bytes => 4
        Class.Char => 5
        Class.Byte => 6
        Class.TextLine => 7
        Class.Doc => 8
        Class.FileDoc => 9
        Class.Nl => 10
        Class.Col0 => 11
        Class.Eof => 12
    }
} Class.index

fn Class.from_index(index: usize) -> Option[Class] {
    return match index {
        0 => Some(Class.Ident)
        1 => Some(Class.Int)
        2 => Some(Class.Float)
        3 => Some(Class.Text)
        4 => Some(Class.Bytes)
        5 => Some(Class.Char)
        6 => Some(Class.Byte)
        7 => Some(Class.TextLine)
        8 => Some(Class.Doc)
        9 => Some(Class.FileDoc)
        10 => Some(Class.Nl)
        11 => Some(Class.Col0)
        12 => Some(Class.Eof)
        else => None
    }
} Class.from_index
