//! What the system running the toolchain does: files, directories, locks, processes and the machine's facts, through glibc on Linux, `libSystem` on macOS, kernel32 on Windows and the calls of its isolated space on NaN OS, which runs no other program.

/// The most bytes of a path the toolchain passes.
const PATH_MAX: usize = 4_096

/// The most segments of a path the toolchain passes.
const PATH_SEGMENTS: usize = 512

/// The calls of the isolated space the toolchain runs in.
fn space() -> nanos::SpaceCalls {
    return trusted "the toolchain built for NaN OS runs as the job of an isolated space" { nanos::SpaceCalls.of_space() }
} space

fn error_of(error: sys::fs::FsError) -> platform::IoError {
    return match error {
        sys::fs::FsError.NotFound => platform::IoError.NotFound
        else => platform::IoError.Other(0)
    }
} error_of

fn stream_error(error: sys::StdioError) -> platform::IoError {
    return match error {
        sys::StdioError.Closed => platform::IoError.BrokenPipe
        else => platform::IoError.Other(0)
    }
} stream_error

/// The path of the job's file system naming what the absolute or relative `path` names, the
/// current directory being the root: its segments but the empty ones and `.`, each `..` dropping
/// the segment before it.
fn fs_path(path: Str) -> text::Fixed[PATH_MAX] fails platform::IoError {
    if path.byte_len() > PATH_MAX {
        fail platform::IoError.Other(0)
    }
    var starts = Array[usize, PATH_SEGMENTS].filled(0)
    var ends = Array[usize, PATH_SEGMENTS].filled(0)
    var kept: usize = 0
    let bytes = path.as_bytes()
    var start: usize = 0
    for at in 0..=bytes.len() {
        if at < bytes.len() and bytes[at] != b'/' {
            continue
        }
        let Some(segment) = path.slice_bytes(start, end: at) else {
            fail platform::IoError.Other(0)
        }
        if segment == ".." {
            kept = kept.saturating_sub(1)
        } else if not segment.is_empty() and segment != "." {
            if kept == PATH_SEGMENTS {
                fail platform::IoError.Other(0)
            }
            starts[kept] = start
            ends[kept] = at
            kept += 1
        }
        start = at + 1
    }
    var out = text::Fixed[PATH_MAX].empty()
    for index in 0..<kept {
        let Some(segment) = path.slice_bytes(starts[index], end: ends[index]) else {
            fail platform::IoError.Other(0)
        }
        if index > 0 {
            mut out.append("/")
        }
        mut out.append(segment)
    }
    return out
} fs_path

/// The id of this process.
pub fn process_id() -> u32 {
    return 1
} process_id

/// Whether the machine running the toolchain is an AArch64 one, as the system names its
/// architecture, or on NaN OS as the toolchain's target does.
pub fn on_aarch64() -> bool {
    return arch::on_aarch64()
} on_aarch64

/// Whether the system running the toolchain is Windows.
pub fn on_windows() -> bool {
    return false
} on_windows

/// Whether the system running the toolchain is macOS.
pub fn on_macos() -> bool {
    return false
} on_macos

/// The path of the running image, or on NaN OS of the artefacts of the running bundle,
/// `/image.narts`; empty when the system gives none.
pub fn own_image(alloc: mem::Alloc) -> text::String {
    return text::String.of("/image.narts", alloc)
} own_image

/// The id of the user running this process on Linux and macOS, and 0 on Windows and NaN OS,
/// where the toolchain compares no owners.
pub fn running_user() -> u32 {
    return 0
} running_user

/// The home directory of the user `uid`: on Linux the one the system's user database gives, on
/// macOS the directory `HOME` names, on Windows the running user's profile directory, which
/// `USERPROFILE` names, with `/` separators, and on NaN OS `/home`; none when there is none.
pub fn home(uid: u32, alloc: mem::Alloc) -> Option[text::String] fails platform::IoError {
    return Some(text::String.of("/home", alloc))
} home
