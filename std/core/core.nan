//! The core vocabulary: options, results and the core interfaces.

pub closed enum Option[T: Any] derives Copy, Eq, Hash, Render, Encode, Generate {
    Some(T)
    None
} Option

pub fn Option.is_some(self) -> bool limits pure, notrap, terminates
    example Some(3u8).is_some()
{
    return match self {
        Some(_) => true
        None => false
    }
} Option.is_some

pub fn Option.is_none(self) -> bool limits pure, notrap, terminates
    example not Some(3u8).is_none()
{
    return not self.is_some()
} Option.is_none

pub fn Option.value_or(self, fallback: T) -> T limits pure, notrap, terminates
    example Some(4u8).value_or(0) == 4

pub fn Option.extract(mut self) -> Option[T] limits pure, notrap, terminates
    example Some(3u8).extract() == Some(3)

pub closed enum Result[T: Any, E: Any] derives Copy, Eq, Hash, Render, Encode, Generate {
    Ok(T)
    Err(E)
} Result

pub fn Result.is_ok(self) -> bool limits pure, notrap, terminates
    example atomic::AtomicU32.of(1).compare_swap(1, replacement: 2).is_ok()
{
    return match self {
        Ok(_) => true
        Err(_) => false
    }
} Result.is_ok

pub fn Result.is_err(self) -> bool limits pure, notrap, terminates
    example atomic::AtomicU32.of(1).compare_swap(5, replacement: 2).is_err()
{
    return not self.is_ok()
} Result.is_err

pub interface Any {
} Any

pub interface AnyBits {
} AnyBits

pub interface Copy {
} Copy

pub interface Inert {
} Inert

pub interface Send {
} Send

pub interface Eq {
    fn eq(self, other: Self) -> bool limits pure, notrap, terminates
} Eq

pub interface Ord {
    fn cmp(self, other: Self) -> Ordering limits pure, notrap, terminates
} Ord

pub closed enum Ordering derives Copy, Eq, Hash, Render {
    Less
    Equal
    Greater
} Ordering

pub interface Hasher {
    fn write(mut self, bytes: Slice[u8]) limits pure, notrap, terminates
} Hasher

pub interface Hash {
    fn hash[H: Hasher](self, mut hasher: H) limits pure, notrap, terminates
} Hash

pub interface Default {
    fn default() -> Self limits pure, terminates
} Default

pub interface Add[R, O] {
    fn add(self, rhs: R) -> O limits pure, terminates
} Add

pub interface Sub[R, O] {
    fn sub(self, rhs: R) -> O limits pure, terminates
} Sub

pub interface Mul[R, O] {
    fn mul(self, rhs: R) -> O limits pure, terminates
} Mul

pub interface Div[R, O] {
    fn div(self, rhs: R) -> O limits pure, terminates
} Div

pub interface Rem[R, O] {
    fn rem(self, rhs: R) -> O limits pure, terminates
} Rem

pub interface BitAnd[R, O] {
    fn bit_and(self, rhs: R) -> O limits pure, terminates
} BitAnd

pub interface BitOr[R, O] {
    fn bit_or(self, rhs: R) -> O limits pure, terminates
} BitOr

pub interface BitXor[R, O] {
    fn bit_xor(self, rhs: R) -> O limits pure, terminates
} BitXor

pub interface Shl[R, O] {
    fn shl(self, rhs: R) -> O limits pure, terminates
} Shl

pub interface Shr[R, O] {
    fn shr(self, rhs: R) -> O limits pure, terminates
} Shr

pub interface Neg[O] {
    fn neg(self) -> O limits pure, terminates
} Neg

pub interface BitNot[O] {
    fn bit_not(self) -> O limits pure, terminates
} BitNot
