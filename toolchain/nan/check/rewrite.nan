//! The replacements the exact fixes of the checker's rules make in an item's file.

/// The fix replacing the bytes `start..end` of an item's file with a text.
fn Checker.fix_bytes(
    self,
    item: ty::ItemId,
    start: u32,
    end: u32,
    text: Str,
    ) -> diagnostic::Fix {
    let alloc = self.alloc()
    let path = self.db().item_file(item).path.as_str()
    let replacement = diagnostic::Replacement(start: start, end: end, text: text::String.of(text, alloc))
    var edits = mem::List[diagnostic::Edit].empty(alloc)
    mut edits.push(diagnostic::Edit(path: text::String.of(path, alloc), replacement: take replacement))
    return diagnostic::Fix(edits: take edits)
} Checker.fix_bytes

/// The fix replacing an item's tokens `head..=last` with a text.
fn Checker.fix_replacing(
    self,
    item: ty::ItemId,
    head: u32,
    last: u32,
    text: Str,
    ) -> diagnostic::Fix {
    let tokens = self.db().syntax(item).tokens
    expect usize.widen(head) < tokens.len() and usize.widen(last) < tokens.len()
    return self.fix_bytes(item, start: tokens[usize.widen(head)].start, end: tokens[usize.widen(last)].end, text)
} Checker.fix_replacing

/// The fix inserting a text before one of an item's tokens.
fn Checker.fix_inserting(self, item: ty::ItemId, before: u32, text: Str) -> diagnostic::Fix {
    let tokens = self.db().syntax(item).tokens
    expect usize.widen(before) < tokens.len()
    let start = tokens[usize.widen(before)].start
    return self.fix_bytes(item, start, end: start, text)
} Checker.fix_inserting

/// The fix inserting a text after one of an item's tokens.
fn Checker.fix_appending(self, item: ty::ItemId, after: u32, text: Str) -> diagnostic::Fix {
    let tokens = self.db().syntax(item).tokens
    expect usize.widen(after) < tokens.len()
    let end = tokens[usize.widen(after)].end
    return self.fix_bytes(item, start: end, end, text)
} Checker.fix_appending

/// The fix deleting an item's tokens `head..=last` and the spaces between them and the
/// token before on their line.
fn Checker.fix_deleting(self, item: ty::ItemId, head: u32, last: u32) -> diagnostic::Fix {
    let syntax = self.db().syntax(item)
    let tokens = syntax.tokens
    expect usize.widen(head) < tokens.len() and usize.widen(last) < tokens.len()
    var start = tokens[usize.widen(head)].start
    match syntax.previous(usize.widen(head)) {
        Some(before) => {
            if tokens[before].line == tokens[usize.widen(head)].line {
                start = tokens[before].end
            }
        }
        None => {}
    }
    return self.fix_bytes(item, start, end: tokens[usize.widen(last)].end, text: "")
} Checker.fix_deleting

/// The fix deleting an item's tokens `head..=last` and the spaces after them on their line.
fn Checker.fix_deleting_forward(self, item: ty::ItemId, head: u32, last: u32) -> diagnostic::Fix {
    let syntax = self.db().syntax(item)
    let tokens = syntax.tokens
    expect usize.widen(head) < tokens.len() and usize.widen(last) < tokens.len()
    let next = tokens[syntax.next(usize.widen(last) + 1)]
    var end = tokens[usize.widen(last)].end
    if next.line == tokens[usize.widen(last)].line and not next.kind.is_virtual() {
        end = next.start
    }
    return self.fix_bytes(item, start: tokens[usize.widen(head)].start, end, text: "")
} Checker.fix_deleting_forward

/// Reports a diagnostic found resolving an item's signature, types or paths, on one token,
/// with the fix its rule names: `.` for a `::` before a member, a redundant segment and its
/// `::` deleted, or a limit deleted.
fn Checker.report_problem(self, item: ty::ItemId, token: u32, code: diagnostic::Code) {
    if code == diagnostic::Code.NameUnknown {
        let span = self.path_span(item, token)
        self.report_unknown(item, construct: span, candidates: self.type_candidates(item), stub: None)
        return
    }
    let syntax = self.db().syntax(item)
    var construct = nir::Span(head: token, last: token)
    var fixes = mem::List[diagnostic::Fix].empty(self.alloc())
    match code {
        diagnostic::Code.NameColonForMember => {
            let separator = u32.fit(syntax.previous(usize.widen(token)).value_or(usize.widen(token)))
            mut fixes.push(self.fix_replacing(item, head: separator, last: separator, text: "."))
            construct = nir::Span(head: separator, last: token)
        }
        diagnostic::Code.NameRedundantPath => {
            let separator = syntax.next(usize.widen(token) + 1)
            let segment = syntax.next(separator + 1)
            expect usize.widen(token) < syntax.tokens.len()
            let start = syntax.tokens[usize.widen(token)].start
            mut fixes.push(self.fix_bytes(item, start, end: syntax.tokens[segment].start, text: ""))
            construct = nir::Span(head: token, last: u32.fit(segment))
        }
        diagnostic::Code.LimitDuplicate or diagnostic::Code.LimitRedundant or diagnostic::Code.KernelIrqLimit => {
            mut fixes.push(self.limit_deleted(item, token))
        }
        else => {}
    }
    self.report_fixed(item, construct, code, fixes: take fixes, offer: diagnostic::Offer.Each)
} Checker.report_problem

/// The fix deleting the limit at `token` from its clause, with a comma beside it, or the
/// whole clause when it is the only limit.
fn Checker.limit_deleted(self, item: ty::ItemId, token: u32) -> diagnostic::Fix {
    let syntax = self.db().syntax(item)
    let tokens = syntax.tokens
    let comma = syntax::TokenKind.Punct(syntax::Punct.Comma)
    var last = usize.widen(token)
    if syntax.text(usize.widen(token)) == "stack" {
        last = syntax.next(usize.widen(token) + 1)
    }
    let before = syntax.previous(usize.widen(token)).value_or(usize.widen(token))
    expect usize.widen(token) < tokens.len() and before <= usize.widen(token)
    let after = syntax.next(last + 1)
    if tokens[before].kind == comma {
        return self.fix_bytes(item, start: tokens[before].start, end: tokens[last].end, text: "")
    }
    if tokens[after].kind == comma {
        let next = syntax.next(after + 1)
        return self.fix_bytes(item, start: tokens[usize.widen(token)].start, end: tokens[next].start, text: "")
    }
    return self.fix_deleting(item, head: u32.fit(before), last: u32.fit(last))
} Checker.limit_deleted

/// The fix deleting the element `head..=last` of a comma-separated list with the comma
/// before it, or after it when it comes first; none when it is the list's only element.
fn Checker.fix_element_deleted(self, item: ty::ItemId, head: u32, last: u32) -> Option[diagnostic::Fix] {
    let syntax = self.db().syntax(item)
    let tokens = syntax.tokens
    let comma = syntax::TokenKind.Punct(syntax::Punct.Comma)
    let Some(before) = syntax.previous(usize.widen(head)) else {
        return None
    }
    let after = syntax.next(usize.widen(last) + 1)
    expect before < tokens.len()
    if tokens[before].kind == comma {
        expect usize.widen(last) < tokens.len()
        return Some(self.fix_bytes(item, start: tokens[before].start, end: tokens[usize.widen(last)].end, text: ""))
    }
    if tokens[after].kind == comma {
        let next = syntax.next(after + 1)
        expect usize.widen(head) < tokens.len()
        return Some(self.fix_bytes(item, start: tokens[usize.widen(head)].start, end: tokens[next].start, text: ""))
    }
    return None
} Checker.fix_element_deleted

/// The fix deleting a listed capture `head..=last`, or its whole list when it is the only
/// one.
fn Checker.fix_capture_deleted(self, item: ty::ItemId, head: u32, last: u32) -> diagnostic::Fix {
    match self.fix_element_deleted(item, head, last) {
        Some(fix) => return fix
        None => {}
    }
    let syntax = self.db().syntax(item)
    let open = u32.fit(syntax.previous(usize.widen(head)).value_or(usize.widen(head)))
    let close = u32.fit(syntax.next(usize.widen(last) + 1))
    return self.fix_replacing(item, head: open, last: close, text: "")
} Checker.fix_capture_deleted

/// The fix listing a capture, written `capture`, in the list of the closure opened by `fn`
/// at `opener`, writing the list when it has none.
fn Checker.fix_capture_listed(self, item: ty::ItemId, opener: u32, capture: Str) -> diagnostic::Fix {
    let alloc = self.alloc()
    let syntax = self.db().syntax(item)
    let open = syntax.next(usize.widen(opener) + 1)
    if syntax.tokens[open].kind != syntax::TokenKind.Punct(syntax::Punct.LBracket) {
        var listed = text::String.of("[", alloc)
        mut listed.append(capture)
        mut listed.push(']')
        return self.fix_appending(item, after: opener, text: listed.as_str())
    }
    var close = open
    for at in open..<syntax.tokens.len() {
        if syntax.tokens[at].kind == syntax::TokenKind.Punct(syntax::Punct.RBracket) {
            close = at
            break
        }
    }
    let start = syntax.tokens[close].start
    var listed = text::String.of(", ", alloc)
    mut listed.append(capture)
    return self.fix_bytes(item, start, end: start, text: listed.as_str())
} Checker.fix_capture_listed

/// The fix deleting the physical lines of an item's tokens `head..=last`.
fn Checker.fix_deleting_lines(self, item: ty::ItemId, head: u32, last: u32) -> diagnostic::Fix {
    let syntax = self.db().syntax(item)
    expect usize.widen(head) < syntax.tokens.len() and usize.widen(last) < syntax.tokens.len()
    let head_line = usize.widen(syntax.tokens[usize.widen(head)].line)
    let last_line = usize.widen(syntax.tokens[usize.widen(last)].line)
    expect 0 < head_line and head_line <= syntax.lines.len()
    let start = syntax.lines[head_line - 1].start
    var end = u32.fit(syntax.source.len())
    if last_line < syntax.lines.len() {
        end = syntax.lines[last_line].start
    }
    return self.fix_bytes(item, start, end, text: "")
} Checker.fix_deleting_lines

/// The fix deleting an item's lines, its doc comment's included, with the blank line after
/// them, or before them at the end of the file.
fn Checker.fix_deleting_item(self, item: ty::ItemId) -> diagnostic::Fix {
    let db = self.db()
    let data = db.item(item)
    let syntax = db.syntax(item)
    expect data.index < syntax.items.len()
    let held = syntax.items[data.index]
    expect held.head < syntax.tokens.len() and 0 < held.end and held.end <= syntax.tokens.len()
    let head = syntax.tokens[held.head]
    expect 0 < head.line
    var start_line = usize.widen(head.line) - 1
    var end_line = usize.widen(syntax.tokens[held.end - 1].line)
    if blank_line(syntax, index: end_line) {
        end_line += 1
    } else if start_line > 0 and blank_line(syntax, index: start_line - 1) {
        start_line -= 1
    }
    return self.fix_bytes(item, start: line_start(syntax, index: start_line), end: line_start(syntax, index: end_line), text: "")
} Checker.fix_deleting_item

/// The fix adding a name to a package's `allow` directive for an authority, writing the
/// directive before the manifest's closing line when it has none.
fn Checker.fix_granting(self, package_id: ty::PackageId, authority: workspace::Authority, name: Str) -> Option[diagnostic::Fix] {
    let alloc = self.alloc()
    let source = self.db().source(package_id)
    let Some(manifest) = source.manifest else {
        return None
    }
    let Some(file) = source.files.get(0) else {
        return None
    }
    let syntax = file.syntax
    var replacement: Option[diagnostic::Replacement] = None
    for allow in manifest.allows {
        if allow.authority != authority {
            continue
        }
        var end: Option[u32] = None
        for token in syntax.tokens {
            if token.line != allow.line or token.kind.is_virtual() {
                continue
            }
            if end.is_none() or token.end > end.value_or(0) {
                end = Some(token.end)
            }
        }
        let Some(at) = end else {
            return None
        }
        var listed = text::String.of(", ", alloc)
        mut listed.append(name)
        replacement = Some(diagnostic::Replacement(start: at, end: at, text: take listed))
        break
    }
    if replacement.is_none() {
        var closer: Option[u32] = None
        for token in syntax.tokens {
            if token.kind == syntax::TokenKind.Punct(syntax::Punct.RBrace) {
                closer = Some(token.line)
            }
        }
        let Some(line) = closer else {
            return None
        }
        expect 0 < line and usize.widen(line) <= syntax.lines.len()
        let start = syntax.lines[usize.widen(line) - 1].start
        var directive = text::String.of("    allow ", alloc)
        mut directive.append(authority.written(alloc).as_str())
        mut directive.append(" in ")
        mut directive.append(name)
        mut directive.push('\n')
        replacement = Some(diagnostic::Replacement(start: start, end: start, text: take directive))
    }
    let Some(made) = replacement else {
        return None
    }
    var edits = mem::List[diagnostic::Edit].empty(alloc)
    mut edits.push(diagnostic::Edit(path: text::String.of(file.path.as_str(), alloc), replacement: take made))
    return Some(diagnostic::Fix(edits: take edits))
} Checker.fix_granting

/// The fix adding a member line, indented one level, before the line closing an item.
fn Checker.member_added(self, item: ty::ItemId, member: Str) -> Option[diagnostic::Fix] {
    let db = self.db()
    let data = db.item(item)
    let syntax = db.syntax(item)
    expect data.index < syntax.items.len()
    let span = syntax.items[data.index]
    var closer: Option[usize] = None
    var at = span.end
    while at > span.head {
        invariant at <= syntax.tokens.len()
        at -= 1
        if syntax.tokens[at].kind == syntax::TokenKind.Punct(syntax::Punct.RBrace) {
            closer = Some(at)
            break
        }
    }
    let Some(found) = closer else {
        return None
    }
    let line = usize.widen(syntax.tokens[found].line)
    expect 0 < line and line <= syntax.lines.len()
    let start = syntax.lines[line - 1].start
    var added = text::String.of("    ", alloc: self.alloc())
    mut added.append(member)
    mut added.push('\n')
    return Some(self.fix_bytes(item, start, end: start, text: added.as_str()))
} Checker.member_added

/// The spaces indenting the line of one of an item's tokens.
fn Checker.indentation(self, item: ty::ItemId, token: u32) -> text::String {
    let db = self.db()
    let spelt = db.syntax(item).line_text(db.line(item, token))
    var width: usize = 0
    while width < spelt.len() and spelt[width] == b' ' {
        width += 1
    }
    var spaces = text::String.empty(self.alloc())
    for _ in 0..<width {
        mut spaces.push(' ')
    }
    return spaces
} Checker.indentation

/// The text of an item's tokens `head..=last` as written.
fn Checker.written(self, item: ty::ItemId, head: u32, last: u32) -> text::String {
    let syntax = self.db().syntax(item)
    expect usize.widen(head) < syntax.tokens.len() and usize.widen(last) < syntax.tokens.len()
    let start = usize.widen(syntax.tokens[usize.widen(head)].start)
    let end = usize.widen(syntax.tokens[usize.widen(last)].end)
    let Some(through) = syntax.source.view().prefix(end) else {
        return text::String.empty(self.alloc())
    }
    let Some(parts) = through.split_at(start) else {
        return text::String.empty(self.alloc())
    }
    return output::lossy(parts.tail, alloc: self.alloc())
} Checker.written

/// Whether a line of a file, numbered from 0, is empty; none past the last.
fn blank_line(syntax: syntax::SourceFile, index: usize) -> bool {
    return index < syntax.lines.len() and syntax.lines[index].start == syntax.lines[index].end
} blank_line

/// The first byte of a line of a file, numbered from 0, its end past the last line.
fn line_start(syntax: syntax::SourceFile, index: usize) -> u32 {
    if index >= syntax.lines.len() {
        return u32.fit(syntax.source.len())
    }
    return syntax.lines[index].start
} line_start
