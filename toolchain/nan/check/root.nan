//! The canonical NIR stream of each workspace package, from its checkers under each target it declares, for the comparison of the NaN front end with the bootstrap.

/// The canonical NIR stream of each workspace package's current state, or of the one named
/// `wanted` when it is not empty, each after a line holding the package's name and the stream's
/// length.
pkg fn Session.nir_streams(self, wanted: Str) -> mem::Bytes {
    let alloc = self.alloc
    let held = self.workspace.contents()
    var written = mem::Bytes.empty(alloc)
    for index in 0..<held.packages.len() {
        let source = held.packages[index]
        let Some(closure) = held.closure_of(index) else {
            continue
        }
        let Some(name) = source.name() else {
            continue
        }
        if not wanted.is_empty() and name != wanted {
            continue
        }
        var checkers = mem::List[TargetChecker].empty(alloc)
        for target in check_targets(source, alloc) {
            let checker = self.unchecked(closure, target)
            match checker.package_named(name) {
                Some(id) => checker.check_whole(id)
                None => {}
            }
            mut checkers.push(TargetChecker(target: target, checker: take checker))
        }
        let stream = package_stream(checkers.view(), package_name: name, alloc)
        var header = text::String.of(name, alloc)
        mut header.write(text::fmt(" {length}\n", length: stream.bytes.len()), budget: 100)
        mut written.append(header.as_bytes())
        mut written.append(stream.bytes.view())
    }
    return written
} Session.nir_streams

/// Checks a package of the checker's closure, quiet or not, and the rules relating its items.
fn Checker.check_whole(self, package_id: ty::PackageId) {
    let state = self.state.contents()
    state.checking.store(package_id.index)
    self.check_package(package_id)
    self.fix_misnamed()
    self.reject_items()
    let db = self.db()
    for module in db.package_data(package_id).modules {
        for item in db.module(module).items {
            self.check_elaborated(item)
        }
    }
    self.check_tables(package_id)
    self.check_wheres()
    self.check_const_cycles()
} Checker.check_whole
