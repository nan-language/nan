//! Each codec's decode of a record with a field predicate, its failures propagated with `try` from a boundary function.

pub closed struct Probe derives Eq, Render, Encode {
    pub seq: u32
    pub hops: u8 where hops >= 2
} Probe

pub fn load_wire(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Probe fails core::DecodeError {
    return try mem::wire::Codec[Probe].decode(raw, alloc)
} load_wire

pub fn load_json(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Probe fails core::DecodeError {
    return try text::json::Codec[Probe].decode(raw, alloc)
} load_json

pub fn load_text(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Probe fails core::DecodeError {
    return try text::construction::Codec[Probe].decode(raw, alloc)
} load_text

fn report(log: sys::Log, label: Str, outcome: Result[Probe, core::DecodeError]) {
    match outcome {
        Ok(probe) => log.info(label, value: probe)
        Err(error) => log.info(label, value: error)
    }
} report

fn main(take world: host::World) fails task::Cancelled uses wait {
    let alloc = world.alloc
    report(world.log, label: "wire", outcome: attempt load_wire(Untrusted.of(b"\x02\x04hops\x01\x03\x03seq\x01\x05"), alloc))
    report(world.log, label: "wire low", outcome: attempt load_wire(Untrusted.of(b"\x02\x04hops\x01\x01\x03seq\x01\x05"), alloc))
    report(world.log, label: "wire truncated", outcome: attempt load_wire(Untrusted.of(b"\x02\x04hops"), alloc))
    report(world.log, label: "json", outcome: attempt load_json(Untrusted.of(b"{\"seq\": 5, \"hops\": 3}"), alloc))
    report(world.log, label: "json low", outcome: attempt load_json(Untrusted.of(b"{\"seq\": 5, \"hops\": 1}"), alloc))
    report(world.log, label: "json truncated", outcome: attempt load_json(Untrusted.of(b"{\"seq\": 5"), alloc))
    report(world.log, label: "text", outcome: attempt load_text(Untrusted.of(b"Probe(seq: 5, hops: 3)"), alloc))
    report(world.log, label: "text low", outcome: attempt load_text(Untrusted.of(b"Probe(seq: 5, hops: 1)"), alloc))
    report(world.log, label: "text truncated", outcome: attempt load_text(Untrusted.of(b"Probe(seq: 5"), alloc))
} main
