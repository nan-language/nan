//! Line tables: the source location of each instruction of lowered code, by function and code offset, which trap reports read to name the trapping operation and each caller.

/// The symbol of the line tables: the addresses of the function, entry, location and string
/// arrays and their counts.
const LINES_SYMBOL: Str = "_NSlines"

/// The flags of a function record: trap reports leave its frames out, and a stopping task
/// does not stop while one of its frames is on the task's stack.
const LINES_HIDDEN: u32 = 1

const LINES_CRITICAL: u32 = 2

/// The size of a function record: its address, its size, its first entry, its entry count and
/// its flags.
const FUNCTION_RECORD: u64 = 24

/// The size of an entry: a code offset and a location.
const LINES_ENTRY_RECORD: u64 = 8

/// The size of a location: the offsets and lengths of its path, item and source line texts,
/// and its line number.
const LOCATION_RECORD: u64 = 28

struct Lines {
    locations: mem::List[LinesLocation]
    known: mem::HashMap[LineKey, u32]
    functions: mem::List[Function]
    table_id: Option[object::DataId]
} Lines

/// A line of an item's file.
struct LineKey derives Copy, Eq, Hash {
    item: ty::ItemId
    line: u32
} LineKey

struct LinesLocation {
    path: text::String
    line: u32
    item: text::String
    text: text::String
} LinesLocation

struct Function {
    id: object::FuncId
    size: u32
    flags: u32
    entries: mem::List[LineEntry]
} Function

/// A code offset and the location of the code from there.
struct LineEntry derives Copy {
    offset: u32
    location: u32
} LineEntry

/// The offset of a function record and the function whose address it holds.
struct RecordFunction derives Copy {
    offset: u32
    function: object::FuncId
} RecordFunction

fn Lines.empty(alloc: mem::Alloc) -> Lines {
    return Lines(locations: mem::List[LinesLocation].empty(alloc), known: mem::HashMap[LineKey, u32].empty(seed: 0, alloc), functions: mem::List[Function].empty(alloc), table_id: None)
} Lines.empty

/// The number of a span's location, as source locations of lowered code carry it.
fn Lines.location(mut self, ck: check::Checker, item: ty::ItemId, span: nir::Span) -> u32 {
    let alloc = ck.alloc()
    let line = ck.db().line(item, token: span.head)
    let key = LineKey(item: item, line: line)
    let known = self.known.get(key)
    match known {
        Some(number) => return number
        None => {}
    }
    let whole = output::lossy(ck.db().syntax(item).line_text(line), alloc)
    let text = trimmed_start(whole.as_str(), alloc)
    let path = lines_path(ck, item)
    let item_path = match ck.canonical_path(item) {
        Some(found) => found
        None => ck.db().canonical(item)
    }
    mut self.locations.push(LinesLocation(path: take path, line: line, item: take item_path, text: take text))
    let number = u32.fit(self.locations.len())
    discard mut self.known.insert(key, value: number)
    return number
} Lines.location

/// A text without the white space at its start.
fn trimmed_start(written: Str, alloc: mem::Alloc) -> text::String {
    var at: usize = 0
    for c in written {
        if not platform::is_white_space(c) {
            break
        }
        expect at <= written.byte_len() and c.utf8_len() <= written.byte_len() - at
        at += c.utf8_len()
    }
    let Some(rest) = written.slice_bytes(at, end: written.byte_len()) else {
        expect false
        return text::String.empty(alloc)
    }
    return text::String.of(rest, alloc)
} trimmed_start

/// Records a compiled function's size and the locations of its code.
fn Lines.function(mut self, id: object::FuncId, flags: u32, size: u32, take entries: mem::List[LineEntry]) {
    mut self.functions.push(Function(id: id, size: size, flags: flags, entries: take entries))
} Lines.function

/// The data object of the line tables, declared once and defined when lowering finishes.
fn Lines.table(mut self, mut module: object::Module) -> object::DataId {
    match self.table_id {
        Some(id) => return id
        None => {}
    }
    let id = mut module.declare_data(LINES_SYMBOL, linkage: object::Linkage.Local, writable: false, tls: false)
    self.table_id = Some(id)
    return id
} Lines.table

/// The path of an item's file as reports write it: its package's name, then the path within
/// the package's source directory.
fn lines_path(ck: check::Checker, item: ty::ItemId) -> text::String {
    let alloc = ck.alloc()
    let db = ck.db()
    let file = db.item_file(item).path
    let package_id = db.package_of(item)
    let dir = db.source(package_id).dir
    var start: usize = 0
    if file.starts_with(dir.as_str()) {
        start = dir.byte_len()
        let bytes = file.as_bytes()
        while start < bytes.len() and bytes[start] == b'/' {
            start += 1
        }
    }
    let Some(relative) = file.slice_bytes(start, end: file.byte_len()) else {
        expect false
        return text::String.empty(alloc)
    }
    var written = text::String.of(db.package_data(package_id).name.as_str(), alloc)
    mut written.push('/')
    mut written.append(relative)
    return written
} lines_path

/// Appends `value` as `size` bytes, least significant first.
fn append_le(mut bytes: mem::Bytes, value: u64, size: usize)
    requires size <= 8
{
    for index in 0..<size {
        mut bytes.push(u8.truncate(value >> u32.fit(8 * index)))
    }
} append_le

/// Appends a text to the strings of the line tables, giving its offset there.
fn lines_append_text(mut strings: mem::Bytes, written: Str) -> u32 {
    let at = u32.truncate(strings.len())
    mut strings.append(written.as_bytes())
    return at
} lines_append_text

/// Defines the line tables from every function lowered.
fn lines_emit(mut lo: Lowering) {
    let alloc = lo.alloc
    let table = mut lo.lines.table(mut lo.module)
    var strings = mem::Bytes.empty(alloc)
    var locations = mem::Bytes.empty(alloc)
    for location in lo.lines.locations {
        let path = lines_append_text(mut strings, written: location.path.as_str())
        let item = lines_append_text(mut strings, written: location.item.as_str())
        let line_text = lines_append_text(mut strings, written: location.text.as_str())
        append_le(mut locations, value: u64.widen(path), size: 4)
        append_le(mut locations, value: u64.widen(location.path.byte_len()), size: 4)
        append_le(mut locations, value: u64.widen(item), size: 4)
        append_le(mut locations, value: u64.widen(location.item.byte_len()), size: 4)
        append_le(mut locations, value: u64.widen(line_text), size: 4)
        append_le(mut locations, value: u64.widen(location.text.byte_len()), size: 4)
        append_le(mut locations, value: u64.widen(location.line), size: 4)
    }
    var entries = mem::Bytes.empty(alloc)
    var functions = mem::Bytes.empty(alloc)
    var function_relocs = mem::List[RecordFunction].empty(alloc)
    for function in lo.lines.functions {
        let head = u32.truncate(entries.len() / usize.widen(LINES_ENTRY_RECORD))
        for entry in function.entries {
            append_le(mut entries, value: u64.widen(entry.offset), size: 4)
            append_le(mut entries, value: u64.widen(entry.location), size: 4)
        }
        mut function_relocs.push(RecordFunction(offset: u32.truncate(functions.len()), function: function.id))
        append_le(mut functions, value: 0, size: 8)
        append_le(mut functions, value: u64.widen(function.size), size: 4)
        append_le(mut functions, value: u64.widen(head), size: 4)
        append_le(mut functions, value: u64.widen(function.entries.len()), size: 4)
        append_le(mut functions, value: u64.widen(function.flags), size: 4)
    }
    var arrays = mem::List[object::DataId].empty(alloc)
    mut arrays.push(lines_array(mut lo, index: 0, bytes: take functions, function_relocs: function_relocs.view()))
    mut arrays.push(lines_array(mut lo, index: 1, bytes: take entries, function_relocs: function_relocs.view()))
    mut arrays.push(lines_array(mut lo, index: 2, bytes: take locations, function_relocs: function_relocs.view()))
    mut arrays.push(lines_array(mut lo, index: 3, bytes: take strings, function_relocs: function_relocs.view()))
    var header = mem::Bytes.zeroed(40, alloc)
    write_le(mut header, at: 32, value: u64.widen(lo.lines.functions.len()), size: 4, big: false)
    var description = object::DataDescription.new(alloc)
    mut description.define(take header)
    mut description.set_align(8)
    for index in 0..<arrays.len() {
        let reference = mut description.import_data(arrays[index])
        mut description.write_data_addr(u32.fit(8 * index), data: reference, addend: 0)
    }
    mut lo.module.define_data(table, take description)
} lines_emit

/// Defines the array of the line tables at `index`: function records, entries, locations or
/// strings, the function records with the addresses of their functions.
fn lines_array(mut lo: Lowering, index: u32, take bytes: mem::Bytes, function_relocs: Slice[RecordFunction]) -> object::DataId {
    var name = text::String.of(LINES_SYMBOL, alloc: lo.alloc)
    mut name.write(text::fmt("_{index}", index), budget: 32)
    let id = mut lo.module.declare_data(name.as_str(), linkage: object::Linkage.Local, writable: false, tls: false)
    var description = object::DataDescription.new(lo.alloc)
    if bytes.len() == 0 {
        mut bytes.push(0)
    }
    mut description.define(take bytes)
    mut description.set_align(8)
    if index == 0 {
        for reloc in function_relocs {
            let reference = mut description.import_function(reloc.function)
            mut description.write_function_addr(reloc.offset, function: reference)
        }
    }
    mut lo.module.define_data(id, take description)
    return id
} lines_array
