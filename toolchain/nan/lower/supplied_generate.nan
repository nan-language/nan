//! Generation: `core::Choices` and its draws, the generators std supplies, and those derives write for structs and enums.

/// The offsets of the choice record's fields, which a `Choices` value is the address of: the
/// number of generator calls enclosing the one running, the innermost constraint frame and the
/// node of it the next draw stands at, the draws made, the index of the draw stream's next
/// value, the case's index, and the forced draws of a rerun with their count; then the record's
/// size.
const CHOICES_DEPTH: u64 = 0

const CHOICES_FRAME: u64 = 8

const CHOICES_CURSOR: u64 = 16

const CHOICES_DRAWS: u64 = 24

const CHOICES_STREAM: u64 = 32

const CHOICES_CASE: u64 = 40

const CHOICES_FORCED: u64 = 48

const CHOICES_FORCED_COUNT: u64 = 56

const CHOICES_SIZE: u64 = 64

/// The offsets of a constraint frame's fields: its table of difference bounds, each drawn
/// integer's value once drawn, scratch distances, and what popping it restores: the frame
/// enclosing it and that frame's node; then the frame's size.
const FRAME_TABLE: u64 = 0

const FRAME_VALUES: u64 = 8

const FRAME_UPPER: u64 = 16

const FRAME_LOWER: u64 = 24

const FRAME_OUTER: u64 = 32

const FRAME_OUTER_CURSOR: u64 = 40

const FRAME_SIZE: u64 = 48

/// The offsets of a table's counts and the sizes of its records. A table is read-only data: its
/// counts of drawn integers, edges, exclusions and nodes, then each drawn integer's bounds, each
/// edge's nodes and weight, each exclusion's drawn integer and value in ascending order, and
/// each node's drawn integer (zero for none), first child and child count. Its nodes form the
/// tree of the positions a generation reaches through fields and lengths: a struct's node has a
/// child per field, a list's, bytes', bounded list's or string's one for its length.
const TABLE_DRAWN: u64 = 0

const TABLE_EDGES: u64 = 8

const TABLE_EXCLUDED: u64 = 16

const TABLE_HEADER: u64 = 32

const TABLE_BOUND: u64 = 32

const TABLE_EDGE: u64 = 32

const TABLE_EXCLUSION: u64 = 32

const TABLE_NODE: u64 = 24

/// The stream serving draws.
const GENERATE_DRAWS: u64 = 0

/// The depth of enclosing generator calls from which collections draw no elements and enums
/// only their variants that do not hold themselves.
const GENERATE_DEEP: i64 = 8

/// The most elements a collection without a bound draws.
const GENERATE_ELEMENTS: i64 = 64

/// A node of a table's tree before it is laid out: its drawn integer, zero for none, and its
/// children.
struct Node {
    drawn: u64
    children: mem::List[Node]
} Node

/// A node of a table's tree laid out: its drawn integer, zero for none, the index of its first
/// child and its child count.
struct LaidNode derives Copy {
    drawn: u64
    first_child: u64
    child_count: u64
} LaidNode

/// The bounds of a drawn integer, as 128-bit integers.
struct Bounds derives Copy {
    low: clif::Value
    high: clif::Value
} Bounds

/// A generator's parameters, as `generator_params` reads them.
struct GeneratorArgs derives Copy {
    choices_value: clif::Value
    alloc: clif::Value
    sret: Option[clif::Value]
} GeneratorArgs

/// The run of a property test's case: the case's index, and the forced draws of a rerun with
/// their count.
struct CaseRun derives Copy {
    case_index: clif::Value
    forced: clif::Value
    forced_count: clif::Value
} CaseRun

/// Children of a laid-out node waiting to be laid out: the node's index and its children.
struct PendingChildren {
    at: usize
    children: mem::List[Node]
} PendingChildren

fn generate_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) -> bool {
    var signed = false
    match supply.path.as_str() {
        "core::Choices.draw" => {}
        "core::Choices.draw_signed" => {
            signed = true
        }
        else => return false
    }
    let record = mut fx.load(PTR, addr: supply.param(0).address_value(), offset: 0)
    let low = supply.param(1).scalar_value()
    let high = supply.param(2).scalar_value()
    let value = generate_draw(mut lo, mut fx, record, low, high, signed)
    supply.ret(mut lo, mut fx, held: Held.Scalar(value))
    return true
} generate_lower

/// A draw between two bounds, signed or not, by the routine making it.
fn generate_draw(mut lo: Lowering, mut fx: Fx, record: clif::Value, low: clif::Value, high: clif::Value, signed: bool) -> clif::Value {
    var flag: u64 = 0
    if signed {
        flag = 1
    }
    let signed_value = mut fx.ptr(flag)
    let args = fx.list4(record, b: low, c: high, d: signed_value)
    let results = mut lo.call_routine(mut fx, routine: Routine.Draw, args: args.view())
    expect results.len() == 1
    return results[0]
} generate_draw

/// A 128-bit constant.
fn generate_wide(mut fx: Fx, value: wide::Wide) -> clif::Value {
    let low = mut fx.int(clif::Type.Int64, value: i64.from_bits(value.low_bits()))
    let high = mut fx.int(clif::Type.Int64, value: i64.from_bits(value.shift_right(64).low_bits()))
    return mut fx.b.iconcat(low, hi: high)
} generate_wide

/// The 128-bit integer at an address.
fn load_wide(mut fx: Fx, address: clif::Value, offset: u64) -> clif::Value
    requires offset < 0x8000_0000
{
    let low = mut fx.load(clif::Type.Int64, addr: address, offset)
    let high = mut fx.load(clif::Type.Int64, addr: address, offset: offset + 8)
    return mut fx.b.iconcat(low, hi: high)
} load_wide

fn store_wide(mut fx: Fx, value: clif::Value, address: clif::Value, offset: u64)
    requires offset < 0x8000_0000
{
    let halves = mut fx.b.isplit(value)
    mut fx.store(halves.low, addr: address, offset)
    mut fx.store(halves.high, addr: address, offset: offset + 8)
} store_wide

/// The smaller of two 128-bit integers, by a branch: the backend has no 128-bit minimum.
fn smaller(mut fx: Fx, one: clif::Value, other: clif::Value) -> clif::Value {
    let less = mut fx.b.icmp(clif::IntCC.SignedLessThan, x: one, y: other)
    let results = fx.types1(clif::Type.Int128)
    let chosen = mut fx.choose(less, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(one)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(other)
    })
    expect chosen.len() == 1
    return chosen[0]
} smaller

/// The larger of two 128-bit integers, by a branch.
fn generate_larger(mut fx: Fx, one: clif::Value, other: clif::Value) -> clif::Value {
    let more = mut fx.b.icmp(clif::IntCC.SignedGreaterThan, x: one, y: other)
    let results = fx.types1(clif::Type.Int128)
    let chosen = mut fx.choose(more, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(one)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(other)
    })
    expect chosen.len() == 1
    return chosen[0]
} generate_larger

/// `Draw(record, low, high, signed) -> value`: a draw's value. Its bounds narrow to the values
/// extending the drawn integers of its frame drawn so far to a solution of the frame's
/// constraints, those its exclusions skip set apart; a rerun's draw takes its forced value
/// within them, past the forced ones its shrink point; case 0 takes the low bound, case 1 the
/// high bound, and a later case, as the draw stream's next value is even, a boundary value or
/// any value, chosen uniformly by its next. The draw is recorded on standard output with its
/// bounds and the value it gives once its exclusions are skipped.
fn define_draw(mut lo: Lowering, mut fx: Fx) {
    let params = mut fx.entry()
    expect params.len() == 4
    let record = params[0]
    let signed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: params[3], y: 0)
    let low_bound = extend(mut fx, bits: params[1], signed)
    let high_bound = extend(mut fx, bits: params[2], signed)
    let frame_record = mut fx.load(PTR, addr: record, offset: CHOICES_FRAME)
    let cursor = mut fx.load(PTR, addr: record, offset: CHOICES_CURSOR)
    let framed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: frame_record, y: 0)
    let placed = mut fx.b.icmp_imm_s(clif::IntCC.SignedGreaterThanOrEqual, x: cursor, y: 0)
    let at_node = mut fx.b.band(framed, y: placed)
    let drawn_results = fx.types1(PTR)
    let drawn_values = mut fx.choose(at_node, results: drawn_results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let table_address = mut fx1.load(PTR, addr: frame_record, offset: FRAME_TABLE)
        let nodes = nodes_at(mut fx1, table_address)
        let node_offset = mut fx1.b.imul_imm_s(cursor, y: i64.fit(TABLE_NODE))
        let node = mut fx1.b.iadd(nodes, y: node_offset)
        let node_drawn = mut fx1.load(PTR, addr: node, offset: 0)
        return fx1.list1(node_drawn)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let none_drawn = mut fx1.ptr(0)
        return fx1.list1(none_drawn)
    })
    expect drawn_values.len() == 1
    let drawn = drawn_values[0]
    let constrained = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: drawn, y: 0)
    let bound_results = fx.types2(clif::Type.Int128, b: clif::Type.Int128)
    let bounds = mut fx.choose(constrained, results: bound_results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return constrained_bounds(mut fx1, frame_record, drawn, low: low_bound, high: high_bound)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list2(low_bound, b: high_bound)
    })
    expect bounds.len() == 2
    let low = bounds[0]
    let high = bounds[1]
    let drawn_value = generate_choose(mut lo, mut fx, record, low, high)
    let value_results = fx.types1(clif::Type.Int128)
    let values = mut fx.choose(constrained, results: value_results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return recorded_value(mut fx1, frame_record, drawn, drawn_value)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(drawn_value)
    })
    expect values.len() == 1
    let value = values[0]
    record_draw(mut lo, mut fx, record, drawn_value, low, high, value)
} define_draw

/// The bounds of a constrained draw: those given narrowed to the frame's solutions, the values
/// its exclusions take set apart from the high bound.
fn constrained_bounds(mut fx: Fx, frame_record: clif::Value, drawn: clif::Value, low: clif::Value, high: clif::Value) -> mem::List[clif::Value] {
    let narrowed = generate_narrowed(mut fx, frame_record, drawn)
    let lower_bound = generate_larger(mut fx, one: low, other: narrowed.low)
    let upper_bound = smaller(mut fx, one: high, other: narrowed.high)
    let skipped = excluded_within(mut fx, frame_record, drawn, low: lower_bound, high: upper_bound)
    let kept_high = mut fx.b.isub(upper_bound, y: skipped)
    return fx.list2(lower_bound, b: kept_high)
} constrained_bounds

/// The value a constrained draw gives its drawn integer, recorded in its frame's values.
fn recorded_value(mut fx: Fx, frame_record: clif::Value, drawn: clif::Value, drawn_value: clif::Value) -> mem::List[clif::Value] {
    let value = generate_shifted(mut fx, frame_record, drawn, value: drawn_value)
    let values = mut fx.load(PTR, addr: frame_record, offset: FRAME_VALUES)
    let slot_offset = mut fx.b.imul_imm_s(drawn, y: 32)
    let slot = mut fx.b.iadd(values, y: slot_offset)
    let one = mut fx.ptr(1)
    mut fx.store(one, addr: slot, offset: 0)
    store_wide(mut fx, value, address: slot, offset: 16)
    return fx.list1(value)
} recorded_value

/// Records a draw on standard output with its bounds and value, counts it, and returns its
/// value.
fn record_draw(mut lo: Lowering, mut fx: Fx, record: clif::Value, drawn_value: clif::Value, low: clif::Value, high: clif::Value, value: clif::Value) {
    let entry = mut fx.slot(64, align: 8)
    store_wide(mut fx, value: drawn_value, address: entry, offset: 0)
    store_wide(mut fx, value: low, address: entry, offset: 16)
    store_wide(mut fx, value: high, address: entry, offset: 32)
    store_wide(mut fx, value, address: entry, offset: 48)
    let size = mut fx.ptr(64)
    let parts = Array[Stretch, 1].filled(Stretch(start: entry, len: size))
    write_frame(mut lo, mut fx, kind: FRAME_DRAW, parts: parts.view())
    let draws = mut fx.load(PTR, addr: record, offset: CHOICES_DRAWS)
    let counted = mut fx.b.iadd_imm_s(draws, y: 1)
    mut fx.store(counted, addr: record, offset: CHOICES_DRAWS)
    let drawn_bits = mut fx.b.ireduce(clif::Type.Int64, x: value)
    let returned = fx.list1(drawn_bits)
    mut fx.b.ret(returned.view())
} record_draw

/// A bound's 128-bit value, from its bits read as signed or not.
fn extend(mut fx: Fx, bits: clif::Value, signed: clif::Value) -> clif::Value {
    let negative = mut fx.b.sextend(clif::Type.Int128, x: bits)
    let positive = mut fx.b.uextend(clif::Type.Int128, x: bits)
    return mut fx.b.select(signed, x: negative, y: positive)
} extend

/// The address of a table's nodes.
fn nodes_at(mut fx: Fx, table_address: clif::Value) -> clif::Value {
    let drawn = mut fx.load(PTR, addr: table_address, offset: TABLE_DRAWN)
    let edges = mut fx.load(PTR, addr: table_address, offset: TABLE_EDGES)
    let excluded = mut fx.load(PTR, addr: table_address, offset: TABLE_EXCLUDED)
    let bounds_bytes = mut fx.b.imul_imm_s(drawn, y: i64.fit(TABLE_BOUND))
    let edge_bytes = mut fx.b.imul_imm_s(edges, y: i64.fit(TABLE_EDGE))
    let past_edges = mut fx.b.iadd(bounds_bytes, y: edge_bytes)
    let excluded_bytes = mut fx.b.imul_imm_s(excluded, y: i64.fit(TABLE_EXCLUSION))
    let past_exclusions = mut fx.b.iadd(past_edges, y: excluded_bytes)
    let at = mut fx.b.iadd_imm_s(past_exclusions, y: i64.fit(TABLE_HEADER))
    return mut fx.b.iadd(table_address, y: at)
} nodes_at

/// The bounds of a frame's drawn integer that extend the values drawn so far to a solution of
/// the frame's difference bounds: the shortest distances from and to node 0, each value drawn
/// fixing its node's distance to 0 both ways.
fn generate_narrowed(mut fx: Fx, frame_record: clif::Value, drawn: clif::Value) -> Bounds {
    let upper = mut fx.load(PTR, addr: frame_record, offset: FRAME_UPPER)
    let lower = mut fx.load(PTR, addr: frame_record, offset: FRAME_LOWER)
    distances(mut fx, frame_record, out: upper, inward: false)
    distances(mut fx, frame_record, out: lower, inward: true)
    let at = mut fx.b.imul_imm_s(drawn, y: 16)
    let to_upper = mut fx.b.iadd(upper, y: at)
    let high = load_wide(mut fx, address: to_upper, offset: 0)
    let to_lower = mut fx.b.iadd(lower, y: at)
    let lowest = load_wide(mut fx, address: to_lower, offset: 0)
    let low = mut fx.b.ineg(lowest)
    return Bounds(low: low, high: high)
} generate_narrowed

/// Writes the shortest distances from node 0 over a frame's edges, reversed when `inward`, with
/// the values drawn so far as edges both ways between their nodes and node 0, by relaxing every
/// edge once per node.
fn distances(mut fx: Fx, frame_record: clif::Value, out: clif::Value, inward: bool) {
    let table_address = mut fx.load(PTR, addr: frame_record, offset: FRAME_TABLE)
    let values = mut fx.load(PTR, addr: frame_record, offset: FRAME_VALUES)
    let drawn = mut fx.load(PTR, addr: table_address, offset: TABLE_DRAWN)
    let edge_count = mut fx.load(PTR, addr: table_address, offset: TABLE_EDGES)
    let bounds_bytes = mut fx.b.imul_imm_s(drawn, y: i64.fit(TABLE_BOUND))
    let header_end = mut fx.b.iadd_imm_s(table_address, y: i64.fit(TABLE_HEADER))
    let edges = mut fx.b.iadd(header_end, y: bounds_bytes)
    let nodes = mut fx.b.iadd_imm_s(drawn, y: 1)
    let far = generate_wide(mut fx, value: wide::Wide.max().shift_right(2))
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: nodes, body: fn(mut fx1: Fx, node: clif::Value) {
        let node_offset = mut fx1.b.imul_imm_s(node, y: 16)
        let at = mut fx1.b.iadd(out, y: node_offset)
        store_wide(mut fx1, value: far, address: at, offset: 0)
    })
    let origin = generate_wide(mut fx, value: wide::Wide.zero())
    store_wide(mut fx, value: origin, address: out, offset: 0)
    mut fx.each(zero, end: nodes, body: fn(mut fx1: Fx, pass: clif::Value) {
        let first_edge = mut fx1.ptr(0)
        mut fx1.each(first_edge, end: edge_count, body: fn(mut fx2: Fx, index: clif::Value) {
            let edge_offset = mut fx2.b.imul_imm_s(index, y: i64.fit(TABLE_EDGE))
            let edge = mut fx2.b.iadd(edges, y: edge_offset)
            let from = mut fx2.load(PTR, addr: edge, offset: 0)
            let to = mut fx2.load(PTR, addr: edge, offset: 8)
            let weight = load_wide(mut fx2, address: edge, offset: 16)
            relax(mut fx2, out, inward, from, to, weight)
        })
        let first_node = mut fx1.ptr(1)
        mut fx1.each(first_node, end: nodes, body: fn(mut fx2: Fx, node: clif::Value) {
            relax_drawn(mut fx2, out, inward, values, node)
        })
    })
} distances

/// Relaxes the edge from `from` to `to` of a weight, reversed when `inward`: the distance of its
/// end becomes the smaller of its own and its start's plus the weight.
fn relax(mut fx: Fx, out: clif::Value, inward: bool, from: clif::Value, to: clif::Value, weight: clif::Value) {
    var start = from
    var end = to
    if inward {
        start = to
        end = from
    }
    let start_offset = mut fx.b.imul_imm_s(start, y: 16)
    let from_at = mut fx.b.iadd(out, y: start_offset)
    let end_offset = mut fx.b.imul_imm_s(end, y: 16)
    let to_at = mut fx.b.iadd(out, y: end_offset)
    let base = load_wide(mut fx, address: from_at, offset: 0)
    let reached = mut fx.b.iadd(base, y: weight)
    let current = load_wide(mut fx, address: to_at, offset: 0)
    let best = smaller(mut fx, one: reached, other: current)
    store_wide(mut fx, value: best, address: to_at, offset: 0)
} relax

/// Relaxes the edges both ways between a node and node 0 that the value drawn for it, once
/// drawn, stands for.
fn relax_drawn(mut fx: Fx, out: clif::Value, inward: bool, values: clif::Value, node: clif::Value) {
    let slot_offset = mut fx.b.imul_imm_s(node, y: 32)
    let slot = mut fx.b.iadd(values, y: slot_offset)
    let assigned_word = mut fx.load(PTR, addr: slot, offset: 0)
    let assigned = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: assigned_word, y: 0)
    mut fx.if_true(assigned, then: fn(mut fx1: Fx) {
        let value = load_wide(mut fx1, address: slot, offset: 16)
        let origin = mut fx1.ptr(0)
        relax(mut fx1, out, inward, from: origin, to: node, weight: value)
        let back = mut fx1.b.ineg(value)
        relax(mut fx1, out, inward, from: node, to: origin, weight: back)
    })
} relax_drawn

/// The number of values a frame's exclusions take from a drawn integer's bounds.
fn excluded_within(mut fx: Fx, frame_record: clif::Value, drawn: clif::Value, low: clif::Value, high: clif::Value) -> clif::Value {
    let listed = exclusions(mut fx, frame_record)
    let none = generate_wide(mut fx, value: wide::Wide.zero())
    let skipped = mut fx.variable(clif::Type.Int128, initial: none)
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: listed.len, body: fn(mut fx1: Fx, index: clif::Value) {
        let exclusion_offset = mut fx1.b.imul_imm_s(index, y: i64.fit(TABLE_EXCLUSION))
        let at = mut fx1.b.iadd(listed.start, y: exclusion_offset)
        let excluding = mut fx1.load(PTR, addr: at, offset: 0)
        let mine = mut fx1.b.icmp(clif::IntCC.Equal, x: excluding, y: drawn)
        let value = load_wide(mut fx1, address: at, offset: 16)
        let above = mut fx1.b.icmp(clif::IntCC.SignedGreaterThanOrEqual, x: value, y: low)
        let below = mut fx1.b.icmp(clif::IntCC.SignedLessThanOrEqual, x: value, y: high)
        let within = mut fx1.b.band(above, y: below)
        let counted = mut fx1.b.band(mine, y: within)
        mut fx1.if_true(counted, then: fn(mut fx2: Fx) {
            let so_far = mut fx2.b.use_var(skipped)
            let one = generate_wide(mut fx2, value: wide::Wide.one())
            let more = mut fx2.b.iadd(so_far, y: one)
            mut fx2.b.def_var(skipped, val: more)
        })
    })
    return mut fx.b.use_var(skipped)
} excluded_within

/// The value a drawn integer takes from a draw's result: one more per value its exclusions
/// take, in ascending order, at or below the result so far.
fn generate_shifted(mut fx: Fx, frame_record: clif::Value, drawn: clif::Value, value: clif::Value) -> clif::Value {
    let listed = exclusions(mut fx, frame_record)
    let result = mut fx.variable(clif::Type.Int128, initial: value)
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: listed.len, body: fn(mut fx1: Fx, index: clif::Value) {
        let exclusion_offset = mut fx1.b.imul_imm_s(index, y: i64.fit(TABLE_EXCLUSION))
        let at = mut fx1.b.iadd(listed.start, y: exclusion_offset)
        let excluding = mut fx1.load(PTR, addr: at, offset: 0)
        let mine = mut fx1.b.icmp(clif::IntCC.Equal, x: excluding, y: drawn)
        let excluded = load_wide(mut fx1, address: at, offset: 16)
        let so_far = mut fx1.b.use_var(result)
        let reached = mut fx1.b.icmp(clif::IntCC.SignedLessThanOrEqual, x: excluded, y: so_far)
        let moves = mut fx1.b.band(mine, y: reached)
        let one = generate_wide(mut fx1, value: wide::Wide.one())
        let past = mut fx1.b.iadd(so_far, y: one)
        let next = mut fx1.b.select(moves, x: past, y: so_far)
        mut fx1.b.def_var(result, val: next)
    })
    return mut fx.b.use_var(result)
} generate_shifted

/// The address and count of a frame's table's exclusions.
fn exclusions(mut fx: Fx, frame_record: clif::Value) -> Stretch {
    let table_address = mut fx.load(PTR, addr: frame_record, offset: FRAME_TABLE)
    let drawn = mut fx.load(PTR, addr: table_address, offset: TABLE_DRAWN)
    let edges = mut fx.load(PTR, addr: table_address, offset: TABLE_EDGES)
    let count = mut fx.load(PTR, addr: table_address, offset: TABLE_EXCLUDED)
    let bounds_bytes = mut fx.b.imul_imm_s(drawn, y: i64.fit(TABLE_BOUND))
    let edge_bytes = mut fx.b.imul_imm_s(edges, y: i64.fit(TABLE_EDGE))
    let past_edges = mut fx.b.iadd(bounds_bytes, y: edge_bytes)
    let at = mut fx.b.iadd_imm_s(past_edges, y: i64.fit(TABLE_HEADER))
    let start = mut fx.b.iadd(table_address, y: at)
    return Stretch(start: start, len: count)
} exclusions

/// The value of a draw within bounds, by the run's case or forced draws.
fn generate_choose(mut lo: Lowering, mut fx: Fx, record: clif::Value, low: clif::Value, high: clif::Value) -> clif::Value {
    let forced = mut fx.load(PTR, addr: record, offset: CHOICES_FORCED)
    let rerun = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: forced, y: 0)
    let results = fx.types1(clif::Type.Int128)
    let chosen = mut fx.choose_in(mut lo, condition: rerun, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let value = forced_value(mut fx1, record, low, high)
        return fx1.list1(value)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return case_value(mut lo1, fx: mut fx1, record, low, high)
    })
    expect chosen.len() == 1
    return chosen[0]
} generate_choose

/// A draw's value by the run's case: the low bound in case 0, the high bound in case 1, and a
/// chosen value in any later case.
fn case_value(mut lo: Lowering, mut fx: Fx, record: clif::Value, low: clif::Value, high: clif::Value) -> mem::List[clif::Value] {
    let case = mut fx.load(PTR, addr: record, offset: CHOICES_CASE)
    let first_case = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: case, y: 0)
    let second_case = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: case, y: 1)
    let results = fx.types1(clif::Type.Int128)
    return mut fx.choose_in(mut lo, condition: first_case, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(low)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        let later_results = fx1.types1(clif::Type.Int128)
        return mut fx1.choose_in(mut lo1, condition: second_case, results: later_results.view(), then: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list1(high)
        }, otherwise: fn(mut lo2: Lowering, mut fx2: Fx) -> mem::List[clif::Value] {
            let value = generate_chosen(mut lo2, fx: mut fx2, record, low, high)
            return fx2.list1(value)
        })
    })
} case_value

/// The next value of the draw stream.
fn next_value(mut lo: Lowering, mut fx: Fx, record: clif::Value) -> clif::Value {
    let index = mut fx.load(PTR, addr: record, offset: CHOICES_STREAM)
    let next = mut fx.b.iadd_imm_s(index, y: 1)
    mut fx.store(next, addr: record, offset: CHOICES_STREAM)
    let stream = mut fx.ptr(GENERATE_DRAWS)
    return seeded_stream(mut lo, mut fx, stream, index)
} next_value

/// A later case's value: as the draw stream's next value is even, a boundary value chosen
/// uniformly among the bounds, their neighbours within them and 0 within them, ascending and
/// without repetition; otherwise any value within the bounds, chosen uniformly.
fn generate_chosen(mut lo: Lowering, mut fx: Fx, record: clif::Value, low: clif::Value, high: clif::Value) -> clif::Value {
    let parity = next_value(mut lo, mut fx, record)
    let parity_bit = mut fx.b.band_imm_s(parity, y: 1)
    let even = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: parity_bit, y: 0)
    let pick = next_value(mut lo, mut fx, record)
    let results = fx.types1(clif::Type.Int128)
    let chosen = mut fx.choose_in(mut lo, condition: even, results: results.view(), then: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return boundary_value(mut fx1, low, high, pick)
    }, otherwise: fn(mut lo1: Lowering, mut fx1: Fx) -> mem::List[clif::Value] {
        return uniform_value(mut fx1, low, high, pick)
    })
    expect chosen.len() == 1
    return chosen[0]
} generate_chosen

/// A boundary value within the bounds, chosen by `pick` among the distinct candidates sorted.
fn boundary_value(mut fx: Fx, low: clif::Value, high: clif::Value, pick: clif::Value) -> mem::List[clif::Value] {
    let candidates = mut fx.slot(5 * 16, align: 8)
    let one = generate_wide(mut fx, value: wide::Wide.one())
    let above_low = mut fx.b.iadd(low, y: one)
    let below_high = mut fx.b.isub(high, y: one)
    let zero = generate_wide(mut fx, value: wide::Wide.zero())
    let none = mut fx.ptr(0)
    let count = mut fx.variable(PTR, initial: none)
    add_candidate(mut fx, candidates, count, candidate: low, low, high)
    add_candidate(mut fx, candidates, count, candidate: above_low, low, high)
    add_candidate(mut fx, candidates, count, candidate: zero, low, high)
    add_candidate(mut fx, candidates, count, candidate: below_high, low, high)
    add_candidate(mut fx, candidates, count, candidate: high, low, high)
    let written = mut fx.b.use_var(count)
    sort_wide(mut fx, at: candidates, count: written)
    let position = mut fx.b.urem(pick, y: written)
    let position_offset = mut fx.b.imul_imm_s(position, y: 16)
    let at = mut fx.b.iadd(candidates, y: position_offset)
    let value = load_wide(mut fx, address: at, offset: 0)
    return fx.list1(value)
} boundary_value

/// Writes a candidate within the bounds after the `count` written so far, unless one of them
/// equals it.
fn add_candidate(mut fx: Fx, candidates: clif::Value, count: clif::Variable, candidate: clif::Value, low: clif::Value, high: clif::Value) {
    let above = mut fx.b.icmp(clif::IntCC.SignedGreaterThanOrEqual, x: candidate, y: low)
    let below = mut fx.b.icmp(clif::IntCC.SignedLessThanOrEqual, x: candidate, y: high)
    let within = mut fx.b.band(above, y: below)
    mut fx.if_true(within, then: fn(mut fx1: Fx) {
        let written = mut fx1.b.use_var(count)
        let start = mut fx1.ptr(0)
        let yes = mut fx1.int(clif::Type.Int8, value: 1)
        let initial = fx1.list2(start, b: yes)
        let scanned = mut fx1.repeat(initial.view(), body: fn(mut fx2: Fx, carried: Slice[clif::Value]) -> Pass {
            expect carried.len() == 2
            let index = carried[0]
            let fresh = carried[1]
            let inside = mut fx2.b.icmp(clif::IntCC.UnsignedLessThan, x: index, y: written)
            let going = mut fx2.b.band(inside, y: fresh)
            let results = fx2.types2(PTR, b: clif::Type.Int8)
            let next = mut fx2.choose(going, results: results.view(), then: fn(mut fx3: Fx) -> mem::List[clif::Value] {
                let index_offset = mut fx3.b.imul_imm_s(index, y: 16)
                let at = mut fx3.b.iadd(candidates, y: index_offset)
                let known = load_wide(mut fx3, address: at, offset: 0)
                let differs = mut fx3.b.icmp(clif::IntCC.NotEqual, x: known, y: candidate)
                let following = mut fx3.b.iadd_imm_s(index, y: 1)
                return fx3.list2(following, b: differs)
            }, otherwise: fn(mut fx3: Fx) -> mem::List[clif::Value] {
                return fx3.list2(index, b: fresh)
            })
            return Pass(again: going, next: take next)
        })
        expect scanned.len() == 2
        let unseen = scanned[1]
        mut fx1.if_true(unseen, then: fn(mut fx2: Fx) {
            let written_offset = mut fx2.b.imul_imm_s(written, y: 16)
            let at = mut fx2.b.iadd(candidates, y: written_offset)
            store_wide(mut fx2, value: candidate, address: at, offset: 0)
            let grown = mut fx2.b.iadd_imm_s(written, y: 1)
            mut fx2.b.def_var(count, val: grown)
        })
    })
} add_candidate

/// Any value within the bounds, chosen by `pick` uniformly.
fn uniform_value(mut fx: Fx, low: clif::Value, high: clif::Value, pick: clif::Value) -> mem::List[clif::Value] {
    let wide_span = mut fx.b.isub(high, y: low)
    let span = mut fx.b.ireduce(clif::Type.Int64, x: wide_span)
    let size = mut fx.b.iadd_imm_s(span, y: 1)
    let whole = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: size, y: 0)
    let one = mut fx.ptr(1)
    let divisor = mut fx.b.select(whole, x: one, y: size)
    let reduced = mut fx.b.urem(pick, y: divisor)
    let narrow_offset = mut fx.b.select(whole, x: pick, y: reduced)
    let offset = mut fx.b.uextend(clif::Type.Int128, x: narrow_offset)
    let value = mut fx.b.iadd(low, y: offset)
    return fx.list1(value)
} uniform_value

/// Sorts `count` 128-bit integers at an address ascending.
fn sort_wide(mut fx: Fx, at: clif::Value, count: clif::Value) {
    let zero = mut fx.ptr(0)
    mut fx.each(zero, end: count, body: fn(mut fx1: Fx, pass: clif::Value) {
        let one = mut fx1.ptr(1)
        mut fx1.each(one, end: count, body: fn(mut fx2: Fx, index: clif::Value) {
            let previous = mut fx2.b.iadd_imm_s(index, y: -1)
            let previous_offset = mut fx2.b.imul_imm_s(previous, y: 16)
            let left_at = mut fx2.b.iadd(at, y: previous_offset)
            let index_offset = mut fx2.b.imul_imm_s(index, y: 16)
            let right_at = mut fx2.b.iadd(at, y: index_offset)
            let left = load_wide(mut fx2, address: left_at, offset: 0)
            let right = load_wide(mut fx2, address: right_at, offset: 0)
            let swap = mut fx2.b.icmp(clif::IntCC.SignedGreaterThan, x: left, y: right)
            mut fx2.if_true(swap, then: fn(mut fx3: Fx) {
                store_wide(mut fx3, value: right, address: left_at, offset: 0)
                store_wide(mut fx3, value: left, address: right_at, offset: 0)
            })
        })
    })
} sort_wide

/// A rerun's draw: the forced value moved within the bounds to the nearer one, or past the
/// forced values the shrink point, the value within the bounds nearest 0.
fn forced_value(mut fx: Fx, record: clif::Value, low: clif::Value, high: clif::Value) -> clif::Value {
    let draws = mut fx.load(PTR, addr: record, offset: CHOICES_DRAWS)
    let count = mut fx.load(PTR, addr: record, offset: CHOICES_FORCED_COUNT)
    let recorded = mut fx.b.icmp(clif::IntCC.UnsignedLessThan, x: draws, y: count)
    let results = fx.types1(clif::Type.Int128)
    let forced_values = mut fx.choose(recorded, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let forced = mut fx1.load(PTR, addr: record, offset: CHOICES_FORCED)
        let draw_offset = mut fx1.b.imul_imm_s(draws, y: 8)
        let at = mut fx1.b.iadd(forced, y: draw_offset)
        let text = mut fx1.load(PTR, addr: at, offset: 0)
        let written = signed_decimal(mut fx1, text)
        let raised = generate_larger(mut fx1, one: written, other: low)
        let value = smaller(mut fx1, one: raised, other: high)
        return fx1.list1(value)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let zero = generate_wide(mut fx1, value: wide::Wide.zero())
        let raised = generate_larger(mut fx1, one: zero, other: low)
        let value = smaller(mut fx1, one: raised, other: high)
        return fx1.list1(value)
    })
    expect forced_values.len() == 1
    return forced_values[0]
} forced_value

/// The signed decimal number a NUL-terminated text writes, as a 128-bit integer.
fn signed_decimal(mut fx: Fx, text: clif::Value) -> clif::Value {
    let lead = mut fx.load(clif::Type.Int8, addr: text, offset: 0)
    let negative = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: lead, y: i64.widen(b'-'))
    let skip = mut fx.b.uextend(PTR, x: negative)
    let start = mut fx.b.iadd(text, y: skip)
    let zero = generate_wide(mut fx, value: wide::Wide.zero())
    let initial = fx.list2(start, b: zero)
    let parsed = mut fx.repeat(initial.view(), body: fn(mut fx1: Fx, carried: Slice[clif::Value]) -> Pass {
        expect carried.len() == 2
        let at = carried[0]
        let value = carried[1]
        let byte = mut fx1.load(clif::Type.Int8, addr: at, offset: 0)
        let more = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: byte, y: 0)
        let widened = mut fx1.b.uextend(clif::Type.Int64, x: byte)
        let narrow_digit = mut fx1.b.iadd_imm_s(widened, y: -i64.widen(b'0'))
        let digit = mut fx1.b.uextend(clif::Type.Int128, x: narrow_digit)
        let ten = generate_wide(mut fx1, value: wide::Wide.of_i64(10))
        let shifted = mut fx1.b.imul(value, y: ten)
        let grown = mut fx1.b.iadd(shifted, y: digit)
        let kept = mut fx1.b.select(more, x: grown, y: value)
        let next = mut fx1.b.iadd_imm_s(at, y: 1)
        return Pass(again: more, next: fx1.list2(next, b: kept))
    })
    expect parsed.len() == 2
    let magnitude = parsed[1]
    let flipped = mut fx.b.ineg(magnitude)
    return mut fx.b.select(negative, x: flipped, y: magnitude)
} signed_decimal

/// Builds the tree of a value of a type at a path, holding a node for each position a drawn
/// integer's path reaches through fields or a length.
fn generate_node(mut lo: Lowering, ty: ty::Ty, value_path: Str, constraints: check::Constraints) -> Node {
    let alloc = lo.alloc
    var drawn: u64 = 0
    for index in 0..<constraints.drawn.len() {
        if constraints.drawn[index].path.as_str() == value_path {
            drawn = u64.widen(index) + 1
            break
        }
    }
    var children = mem::List[Node].empty(alloc)
    let ty::TyKind.Item(item: item, args: _) = lo.ck.types().kind(ty) else {
        return Node(drawn: drawn, children: take children)
    }
    var dotted = text::String.of(value_path, alloc)
    mut dotted.push('.')
    var below = false
    for known in constraints.drawn {
        if known.path.as_str().starts_with(dotted.as_str()) {
            below = true
            break
        }
    }
    if not below {
        return Node(drawn: drawn, children: take children)
    }
    let canonical = lo.ck.db().canonical(item)
    let length = match canonical.as_str() {
        "mem::List" or "mem::Bytes" or "mem::Bounded" => ".len()"
        "text::String" => ".as_str().char_count()"
        else => ""
    }
    if length.byte_len() > 0 {
        var length_path = text::String.of(value_path, alloc)
        mut length_path.append(length)
        mut children.push(generate_node(mut lo, ty: ty::Ty.unit(), value_path: length_path.as_str(), constraints))
        return Node(drawn: drawn, children: take children)
    }
    let sig = lo.ck.sig(item)
    match sig.contents().kind {
        check::SigKind.Struct(fields: fields) => {
            for field in fields {
                let field_ty = lo.ck.field_type(ty, name: field.name.as_str()).value_or(ty::Ty.unit())
                var field_path = text::String.of(dotted.as_str(), alloc)
                mut field_path.append(field.name.as_str())
                mut children.push(generate_node(mut lo, ty: field_ty, value_path: field_path.as_str(), constraints))
            }
        }
        else => {}
    }
    return Node(drawn: drawn, children: take children)
} generate_node

/// Lays out a tree's nodes, each node's children after it contiguously.
fn generate_lay_out(take root: Node, alloc: mem::Alloc) -> mem::List[LaidNode] {
    let Node(drawn: root_drawn, children: root_children) = root
    var nodes = mem::List[LaidNode].empty(alloc)
    mut nodes.push(LaidNode(drawn: root_drawn, first_child: 0, child_count: 0))
    var pending = mem::List[PendingChildren].empty(alloc)
    mut pending.push(PendingChildren(at: 0, children: take root_children))
    loop {
        let Some(waiting) = mut pending.pop() else {
            break
        }
        let PendingChildren(at: at, children: children) = waiting
        let first_child = nodes.len()
        expect at < nodes.len()
        nodes[at].first_child = u64.widen(first_child)
        expect at < nodes.len()
        nodes[at].child_count = u64.widen(children.len())
        for child in children {
            mut nodes.push(LaidNode(drawn: child.drawn, first_child: 0, child_count: 0))
        }
        var offset: usize = 0
        for child in take children {
            let Node(drawn: _, children: grandchildren) = child
            expect first_child < 0xFFFF_FFFF and offset < 0xFFFF_FFFF
            mut pending.push(PendingChildren(at: first_child + offset, children: take grandchildren))
            offset += 1
        }
    }
    return nodes
} generate_lay_out

/// The table of constraints over a tree.
fn table_data(mut lo: Lowering, constraints: check::Constraints, nodes: Slice[LaidNode]) -> object::DataId {
    var bytes = mem::Bytes.empty(lo.alloc)
    push_word(mut bytes, word: u64.widen(constraints.drawn.len()))
    push_word(mut bytes, word: u64.widen(constraints.edges.len()))
    push_word(mut bytes, word: u64.widen(constraints.excluded.len()))
    push_word(mut bytes, word: u64.widen(nodes.len()))
    for drawn in constraints.drawn {
        push_wide(mut bytes, value: drawn.low)
        push_wide(mut bytes, value: drawn.high)
    }
    for edge in constraints.edges {
        push_word(mut bytes, word: u64.widen(edge.from))
        push_word(mut bytes, word: u64.widen(edge.to))
        push_wide(mut bytes, value: edge.weight)
    }
    var excluded = mem::List[check::Excluded].empty(lo.alloc)
    for exclusion in constraints.excluded {
        mut excluded.push(exclusion)
    }
    mut excluded.sort_by(order: fn(left: check::Excluded, right: check::Excluded) -> core::Ordering {
        if left.node != right.node {
            return left.node.cmp(right.node)
        }
        return left.value.cmp(right.value)
    })
    for exclusion in excluded {
        push_word(mut bytes, word: u64.widen(exclusion.node))
        push_word(mut bytes, word: 0)
        push_wide(mut bytes, value: exclusion.value)
    }
    for node in nodes {
        push_word(mut bytes, word: node.drawn)
        push_word(mut bytes, word: node.first_child)
        push_word(mut bytes, word: node.child_count)
    }
    return mut lo.data_object("generation", contents: take bytes)
} table_data

/// Appends a 64-bit word to bytes, little-endian.
fn push_word(mut bytes: mem::Bytes, word: u64) {
    for index in 0..<8u32 {
        mut bytes.push(u8.truncate(word >> (index * 8)))
    }
} push_word

/// Appends a 128-bit integer to bytes, little-endian.
fn push_wide(mut bytes: mem::Bytes, value: wide::Wide) {
    push_word(mut bytes, word: value.low_bits())
    push_word(mut bytes, word: value.shift_right(64).low_bits())
} push_wide

/// The table of a property test's generation, its root's children its parameters; none when
/// its generation has no constraint.
fn case_table(mut lo: Lowering, item: ty::ItemId, params: Slice[ty::Ty]) -> Option[object::DataId] {
    let Some(constraints) = lo.ck.generation(item) else {
        return None
    }
    if constraints.drawn.len() == 0 {
        return None
    }
    var children = mem::List[Node].empty(lo.alloc)
    for index in 0..<params.len() {
        var param_path = text::String.empty(lo.alloc)
        mut param_path.write(text::fmt("#{index}", index), budget: 32)
        mut children.push(generate_node(mut lo, ty: params[index], value_path: param_path.as_str(), constraints))
    }
    let nodes = generate_lay_out(Node(drawn: 0, children: take children), alloc: lo.alloc)
    return Some(table_data(mut lo, constraints, nodes: nodes.view()))
} case_table

/// The table of the predicates of a struct type, its root the struct; none when it has none.
fn struct_table(mut lo: Lowering, ty: ty::Ty) -> Option[object::DataId] {
    let Some(constraints) = lo.ck.struct_generation(ty) else {
        return None
    }
    let ty::TyKind.Item(item: item, args: _) = lo.ck.types().kind(ty) else {
        return None
    }
    let sig = lo.ck.sig(item)
    let check::SigKind.Struct(fields: fields) = sig.contents().kind else {
        return None
    }
    var children = mem::List[Node].empty(lo.alloc)
    for field in fields {
        let field_ty = lo.ck.field_type(ty, name: field.name.as_str()).value_or(ty::Ty.unit())
        mut children.push(generate_node(mut lo, ty: field_ty, value_path: field.name.as_str(), constraints))
    }
    let nodes = generate_lay_out(Node(drawn: 0, children: take children), alloc: lo.alloc)
    return Some(table_data(mut lo, constraints, nodes: nodes.view()))
} struct_table

/// Pushes a constraint frame of a table onto the choice record, at its root.
fn generate_push_frame(mut lo: Lowering, mut fx: Fx, record: clif::Value, table_id: object::DataId) {
    let global = mut lo.data_ref(mut fx, id: table_id)
    let table_address = mut fx.b.symbol_value(PTR, global_value: global)
    let size = mut fx.ptr(FRAME_SIZE)
    let pushed = mut lo.record_alloc(mut fx, size)
    exhausted_unless(mut lo, mut fx, address: pushed)
    let drawn = mut fx.load(PTR, addr: table_address, offset: TABLE_DRAWN)
    let nodes = mut fx.b.iadd_imm_s(drawn, y: 1)
    push_area(mut lo, mut fx, pushed, nodes, field: FRAME_VALUES, width: 32)
    push_area(mut lo, mut fx, pushed, nodes, field: FRAME_UPPER, width: 16)
    push_area(mut lo, mut fx, pushed, nodes, field: FRAME_LOWER, width: 16)
    mut fx.store(table_address, addr: pushed, offset: FRAME_TABLE)
    let outer = mut fx.load(PTR, addr: record, offset: CHOICES_FRAME)
    mut fx.store(outer, addr: pushed, offset: FRAME_OUTER)
    let cursor = mut fx.load(PTR, addr: record, offset: CHOICES_CURSOR)
    mut fx.store(cursor, addr: pushed, offset: FRAME_OUTER_CURSOR)
    mut fx.store(pushed, addr: record, offset: CHOICES_FRAME)
    let root = mut fx.ptr(0)
    mut fx.store(root, addr: record, offset: CHOICES_CURSOR)
} generate_push_frame

/// Draws a frame's area of `width` bytes per node into its field at `field`.
fn push_area(mut lo: Lowering, mut fx: Fx, pushed: clif::Value, nodes: clif::Value, field: u64, width: i64) {
    let size = mut fx.b.imul_imm_s(nodes, y: width)
    let area = mut lo.record_alloc(mut fx, size)
    exhausted_unless(mut lo, mut fx, address: area)
    mut fx.store(area, addr: pushed, offset: field)
} push_area

/// Pops the innermost constraint frame, restoring the frame and node it was pushed at.
fn pop_frame(mut fx: Fx, record: clif::Value) {
    let top = mut fx.load(PTR, addr: record, offset: CHOICES_FRAME)
    let outer = mut fx.load(PTR, addr: top, offset: FRAME_OUTER)
    let cursor = mut fx.load(PTR, addr: top, offset: FRAME_OUTER_CURSOR)
    mut fx.store(outer, addr: record, offset: CHOICES_FRAME)
    mut fx.store(cursor, addr: record, offset: CHOICES_CURSOR)
} pop_frame

/// Moves the cursor to child `index` of node `node`, to none when the node is none or has no
/// such child.
fn descend(mut fx: Fx, record: clif::Value, node: clif::Value, index: u64) {
    let none = mut fx.int(PTR, value: -1)
    let placed = mut fx.b.icmp_imm_s(clif::IntCC.SignedGreaterThanOrEqual, x: node, y: 0)
    let results = fx.types1(PTR)
    let child = mut fx.choose(placed, results: results.view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let top = mut fx1.load(PTR, addr: record, offset: CHOICES_FRAME)
        let table_address = mut fx1.load(PTR, addr: top, offset: FRAME_TABLE)
        let nodes = nodes_at(mut fx1, table_address)
        let node_offset = mut fx1.b.imul_imm_s(node, y: i64.fit(TABLE_NODE))
        let at = mut fx1.b.iadd(nodes, y: node_offset)
        let first_child = mut fx1.load(PTR, addr: at, offset: 8)
        let count = mut fx1.load(PTR, addr: at, offset: 16)
        let has = mut fx1.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThan, x: count, y: i64.fit(index))
        let indexed = mut fx1.b.iadd_imm_s(first_child, y: i64.fit(index))
        let chosen = mut fx1.b.select(has, x: indexed, y: none)
        return fx1.list1(chosen)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        return fx1.list1(none)
    })
    expect child.len() == 1
    mut fx.store(child[0], addr: record, offset: CHOICES_CURSOR)
} descend

/// Places the cursor at no node: the next draws are those no constraint names.
fn unplace(mut fx: Fx, record: clif::Value) {
    let none = mut fx.int(PTR, value: -1)
    mut fx.store(none, addr: record, offset: CHOICES_CURSOR)
} unplace

/// Counts a generator call entering: its depth among enclosing ones, before it counts.
fn generate_enter(mut fx: Fx, record: clif::Value) -> clif::Value {
    let depth = mut fx.load(PTR, addr: record, offset: CHOICES_DEPTH)
    let deeper = mut fx.b.iadd_imm_s(depth, y: 1)
    mut fx.store(deeper, addr: record, offset: CHOICES_DEPTH)
    return depth
} generate_enter

fn leave(mut fx: Fx, record: clif::Value, depth: clif::Value) {
    mut fx.store(depth, addr: record, offset: CHOICES_DEPTH)
} leave

/// Generates a value of a type through its generator, into a new slot.
fn generate_generate(mut lo: Lowering, mut fx: Fx, ty: ty::Ty, choices_value: clif::Value, alloc: clif::Value) -> clif::Value {
    let laid = mut lo.layout_of(ty)
    let generate_interface = lo.core_interface("Generate")
    var type_args = mem::List[ty::Arg].empty(lo.alloc)
    mut type_args.push(ty::Arg.Ty(ty))
    let fn_ref = nir::FnRef(callable: nir::Callable.Method(item: generate_interface, method: 0), args: lo.ck.types().args(take type_args))
    let instance = mut lo.callable_instance(fn_ref, as_value: false)
    let abi = mut lo.abi(instance)
    let id = mut lo.instance(take instance)
    let alloc_slot = mut fx.slot(8, align: 8)
    mut fx.store(alloc, addr: alloc_slot, offset: 0)
    let alloc_ty = lo.std_ty("mem", type_name: "Alloc", args: mem::List[ty::Ty].empty(lo.alloc))
    let alloc_held = mut lo.held_at(mut fx, ty: alloc_ty, address: alloc_slot)
    var args = Array[Held, 2].filled(Held.Address(choices_value))
    args[1] = alloc_held
    let called = mut lo.invoke(mut fx, invoked: Invoked.Direct(id), abi, args: args.view())
    let slot = mut fx.slot(laid.contents().size, align: laid.contents().align)
    mut lo.store_held(mut fx, address: slot, held: called.result, ty)
    return slot
} generate_generate

/// The parameters a generator receives: the address of the `Choices` value, the allocator's
/// cell, and where its result goes.
fn generator_params(mut fx: Fx, abi: Abi) -> GeneratorArgs {
    let incoming = mut fx.entry()
    expect incoming.len() > 1
    var next: usize = 0
    var sret: Option[clif::Value] = None
    if abi.returned == Returned.Indirect {
        sret = Some(incoming[next])
        next += 1
    }
    var params = mem::List[Option[clif::Value]].empty(fx.alloc)
    for param in abi.params {
        match param.repr {
            Repr.Empty => mut params.push(None)
            else => {
                if next < incoming.len() {
                    mut params.push(Some(incoming[next]))
                    next += 1
                } else {
                    mut params.push(None)
                }
            }
        }
    }
    expect params.len() == 2 and abi.params.len() == 2
    let Some(choices_value) = params[0] else {
        expect false
        return GeneratorArgs(choices_value: incoming[0], alloc: incoming[0], sret: sret)
    }
    let Some(alloc_param) = params[1] else {
        expect false
        return GeneratorArgs(choices_value: choices_value, alloc: choices_value, sret: sret)
    }
    let alloc = match abi.params[1].repr {
        Repr.Scalar(_) => alloc_param
        else => mut fx.load(PTR, addr: alloc_param, offset: 0)
    }
    return GeneratorArgs(choices_value: choices_value, alloc: alloc, sret: sret)
} generator_params

/// Returns a generated value at an address as a generator's form gives it.
fn give(mut lo: Lowering, mut fx: Fx, abi: Abi, sret: Option[clif::Value], ty: ty::Ty, at: clif::Value) {
    match abi.returned {
        Returned.Indirect => {
            let laid = mut lo.layout_of(ty)
            let Some(result_address) = sret else {
                expect false
                return
            }
            mut lo.copy(mut fx, dst: result_address, src: at, size: laid.contents().size, align: laid.contents().align)
            let returned = mem::List[clif::Value].empty(fx.alloc)
            mut fx.b.ret(returned.view())
        }
        Returned.Scalar(_) => {
            let held = mut lo.held_at(mut fx, ty, address: at)
            let nty = nir::NTy.Owned(ty)
            let repr = mut lo.owned_repr(ty)
            let adapted = adapt_value(mut lo, mut fx, held, nty, wanted: repr)
            let returned = fx.list1(adapted.scalar_value())
            mut fx.b.ret(returned.view())
        }
        else => {
            let returned = mem::List[clif::Value].empty(fx.alloc)
            mut fx.b.ret(returned.view())
        }
    }
} give

/// The address of the choice record a `Choices` value at an address names.
fn record_of(mut fx: Fx, choices_value: clif::Value) -> clif::Value {
    return mut fx.load(PTR, addr: choices_value, offset: 0)
} record_of

/// Defines the generator std supplies for a type: integer scalars between their minimum and
/// maximum, `bool`, `char`, `Unit` and floats by their bits; arrays of Copy elements in index
/// order; collections and strings by a length, then their elements; boxes, Untrusted values
/// and ids by their contents.
fn generate_conformance(mut lo: Lowering, mut fx: Fx, abi: Abi, ty: ty::Ty) {
    let params = generator_params(mut fx, abi)
    let record = record_of(mut fx, choices_value: params.choices_value)
    let depth = generate_enter(mut fx, record)
    let laid = mut lo.layout_of(ty)
    let slot = mut fx.slot(laid.contents().size, align: laid.contents().align)
    match lo.ck.types().kind(ty) {
        ty::TyKind.Unit => {}
        ty::TyKind.Scalar(scalar) => {
            let value = scalar_value(mut lo, mut fx, record, scalar)
            mut fx.store(value, addr: slot, offset: 0)
        }
        ty::TyKind.Item(item: item, args: _) => generate_item(mut lo, mut fx, params, record, ty, item, slot, depth)
        else => {
            expect false
        }
    }
    leave(mut fx, record, depth)
    give(mut lo, mut fx, abi, sret: params.sret, ty, at: slot)
} generate_conformance

/// The std generator of a value of an item type into `slot`: an array's elements, an Untrusted
/// value's or a box's contents, an id's index, or a collection's or string's elements.
fn generate_item(mut lo: Lowering, mut fx: Fx, params: GeneratorArgs, record: clif::Value, ty: ty::Ty, item: ty::ItemId, slot: clif::Value, depth: clif::Value) {
    let choices_value = params.choices_value
    let alloc = params.alloc
    let path = lo.ck.db().canonical(item)
    let leading = lo.ck.types().type_arg(ty, index: 0)
    match path.as_str() {
        "core::Array" => {
            let Some(element) = leading else {
                expect false
                return
            }
            let element_laid = mut lo.layout_of(element)
            unplace(mut fx, record)
            let count = const_count(lo, ty, index: 1)
            for index in 0..<count {
                let value = generate_generate(mut lo, mut fx, ty: element, choices_value, alloc)
                let at = mut fx.offset(slot, offset: index * element_laid.contents().size)
                mut lo.copy(mut fx, dst: at, src: value, size: element_laid.contents().size, align: element_laid.contents().align)
            }
        }
        "core::Untrusted" => {
            let Some(inner) = leading else {
                expect false
                return
            }
            unplace(mut fx, record)
            let value = generate_generate(mut lo, mut fx, ty: inner, choices_value, alloc)
            let laid = mut lo.layout_of(ty)
            mut lo.copy(mut fx, dst: slot, src: value, size: laid.contents().size, align: laid.contents().align)
        }
        "mem::Id" => {
            unplace(mut fx, record)
            let index = scalar_value(mut lo, mut fx, record, scalar: ty::Scalar.Unsigned32)
            mut fx.store(index, addr: slot, offset: 0)
        }
        "mem::Box" => {
            let Some(inner) = leading else {
                expect false
                return
            }
            unplace(mut fx, record)
            let value = generate_generate(mut lo, mut fx, ty: inner, choices_value, alloc)
            let heap_ty = lo.std_ty("mem", type_name: "Heap", args: mem::List[ty::Ty].empty(lo.alloc))
            let held_alloc = generate_alloc_held(mut lo, mut fx, alloc)
            let heap_args = Array[Held, 1].filled(held_alloc)
            let no_types = mem::List[ty::Ty].empty(lo.alloc)
            let heap = call_member(mut lo, mut fx, owner: heap_ty, member: "of", own: no_types.view(), args: heap_args.view())
            let held = mut lo.held_at(mut fx, ty: inner, address: value)
            var boxed_types = mem::List[ty::Ty].empty(lo.alloc)
            mut boxed_types.push(inner)
            var boxed_args = Array[Held, 2].filled(heap)
            boxed_args[1] = held
            let boxed = call_member(mut lo, mut fx, owner: heap_ty, member: "boxed", own: boxed_types.view(), args: boxed_args.view())
            mut lo.store_held(mut fx, address: slot, held: boxed, ty)
        }
        else => generate_sequence(mut lo, mut fx, record, choices_value, alloc, ty, slot, depth)
    }
} generate_item

/// A drawn scalar: an integer between its minimum and maximum, `bool` from 0 or 1, a `char`
/// from 0 to 1_112_063 skipping the surrogates, a float by its bits.
fn scalar_value(mut lo: Lowering, mut fx: Fx, record: clif::Value, scalar: ty::Scalar) -> clif::Value {
    let laid = mut lo.layout_of(ty::Ty.scalar(scalar))
    let LayoutShape.Scalar(ty: ir, big: _) = laid.contents().shape else {
        expect false
        return record
    }
    match scalar {
        ty::Scalar.Bool => {
            let zero = mut fx.ptr(0)
            let one = mut fx.ptr(1)
            let value = generate_draw(mut lo, mut fx, record, low: zero, high: one, signed: false)
            return mut fx.b.ireduce(clif::Type.Int8, x: value)
        }
        ty::Scalar.Char => {
            let zero = mut fx.ptr(0)
            let top = mut fx.ptr(1_112_063)
            let value = generate_draw(mut lo, mut fx, record, low: zero, high: top, signed: false)
            let past = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: value, y: 0xD800)
            let moved = mut fx.b.iadd_imm_s(value, y: 0x800)
            let code = mut fx.b.select(past, x: moved, y: value)
            return mut fx.b.ireduce(clif::Type.Int32, x: code)
        }
        ty::Scalar.Float32 or ty::Scalar.Float64 => {
            let zero = mut fx.ptr(0)
            var top_bits: i64 = -1
            if scalar == ty::Scalar.Float32 {
                top_bits = 4_294_967_295
            }
            let top = mut fx.int(PTR, value: top_bits)
            let drawn_bits = generate_draw(mut lo, mut fx, record, low: zero, high: top, signed: false)
            var bits = drawn_bits
            if scalar == ty::Scalar.Float32 {
                bits = mut fx.b.ireduce(clif::Type.Int32, x: drawn_bits)
            }
            return mut fx.b.bitcast(ir, flags: clif::MemFlags.new(), x: bits)
        }
        else => {
            let range = scalar.range()
            let low = mut fx.int(PTR, value: i64.from_bits(range.low.low_bits()))
            let high = mut fx.int(PTR, value: i64.from_bits(range.high.low_bits()))
            let value = generate_draw(mut lo, mut fx, record, low, high, signed: scalar.is_signed())
            if ir == clif::Type.Int64 {
                return value
            }
            return mut fx.b.ireduce(ir, x: value)
        }
    }
} scalar_value

/// The `mem::Alloc` value of a cell, held as its parameters take it.
fn generate_alloc_held(mut lo: Lowering, mut fx: Fx, alloc: clif::Value) -> Held {
    let slot = mut fx.slot(8, align: 8)
    mut fx.store(alloc, addr: slot, offset: 0)
    let alloc_ty = lo.std_ty("mem", type_name: "Alloc", args: mem::List[ty::Ty].empty(lo.alloc))
    return mut lo.held_at(mut fx, ty: alloc_ty, address: slot)
} generate_alloc_held

/// Calls a member function of a type, its own type arguments after the type's.
fn call_member(mut lo: Lowering, mut fx: Fx, owner: ty::Ty, member: Str, own: Slice[ty::Ty], args: Slice[Held]) -> Held {
    let ty::TyKind.Item(item: item, args: type_args) = lo.ck.types().kind(owner) else {
        expect false
        return Held.Empty
    }
    let members = lo.ck.db().members(check::TypeKey.Item(item), name: member)
    if members.len() == 0 {
        expect false
        return Held.Empty
    }
    let function = members[0]
    var fn_args = mem::List[ty::Arg].empty(lo.alloc)
    for arg in lo.ck.types().arg_list(type_args) {
        mut fn_args.push(arg)
    }
    for own_ty in own {
        mut fn_args.push(ty::Arg.Ty(own_ty))
    }
    let fn_ref = nir::FnRef.item(function, args: lo.ck.types().args(take fn_args))
    let instance = mut lo.callable_instance(fn_ref, as_value: false)
    let abi = mut lo.abi(instance)
    let id = mut lo.instance(take instance)
    let called = mut lo.invoke(mut fx, invoked: Invoked.Direct(id), abi, args)
    return called.result
} call_member

/// A collection or string: a length drawn at the length's node, as a bound allows or none
/// under `GENERATE_DEEP` enclosing generator calls, then that many elements, entries or chars;
/// a hash map draws its seed first.
fn generate_sequence(mut lo: Lowering, mut fx: Fx, record: clif::Value, choices_value: clif::Value, alloc: clif::Value, ty: ty::Ty, slot: clif::Value, depth: clif::Value) {
    let ty::TyKind.Item(item: item, args: _) = lo.ck.types().kind(ty) else {
        expect false
        return
    }
    let path = lo.ck.db().canonical(item)
    let node = mut fx.load(PTR, addr: record, offset: CHOICES_CURSOR)
    let held_alloc = generate_alloc_held(mut lo, mut fx, alloc)
    let no_types = mem::List[ty::Ty].empty(lo.alloc)
    var limit = GENERATE_ELEMENTS
    var empty = Held.Empty
    match path.as_str() {
        "mem::List" or "mem::Set" or "mem::Bytes" or "text::String" or "mem::Map" => {
            let empty_args = Array[Held, 1].filled(held_alloc)
            empty = call_member(mut lo, mut fx, owner: ty, member: "empty", own: no_types.view(), args: empty_args.view())
        }
        "mem::HashMap" => {
            unplace(mut fx, record)
            let seed = scalar_value(mut lo, mut fx, record, scalar: ty::Scalar.Unsigned64)
            var empty_args = Array[Held, 2].filled(Held.Scalar(seed))
            empty_args[1] = held_alloc
            empty = call_member(mut lo, mut fx, owner: ty, member: "empty", own: no_types.view(), args: empty_args.view())
        }
        "mem::Bounded" or "text::Fixed" => {
            let empty_args = mem::List[Held].empty(lo.alloc)
            empty = call_member(mut lo, mut fx, owner: ty, member: "empty", own: no_types.view(), args: empty_args.view())
            limit = i64.from_bits(const_arg(sequence_bound(lo, ty, path: path.as_str())).low_bits())
        }
        else => {
            expect false
            return
        }
    }
    mut lo.store_held(mut fx, address: slot, held: empty, ty)
    descend(mut fx, record, node, index: 0)
    let deep = mut fx.b.icmp_imm_s(clif::IntCC.SignedGreaterThanOrEqual, x: depth, y: GENERATE_DEEP)
    let most = mut fx.ptr(limit.to_bits())
    let none = mut fx.ptr(0)
    let high = mut fx.b.select(deep, x: none, y: most)
    let zero = mut fx.ptr(0)
    let len = generate_draw(mut lo, mut fx, record, low: zero, high, signed: false)
    unplace(mut fx, record)
    mut fx.each(zero, end: len, body: fn[mut lo](mut fx1: Fx, index: clif::Value) {
        generate_entry(mut lo, fx: mut fx1, record, choices_value, alloc, ty, path: path.as_str(), slot)
    })
} generate_sequence

/// The const argument bounding a bounded list or fixed text: the second of a bounded list's,
/// the first of a fixed text's.
fn sequence_bound(lo: Lowering, ty: ty::Ty, path: Str) -> ty::Arg {
    var index: usize = 0
    if path == "mem::Bounded" {
        index = 1
    }
    let listed = lo.ck.types().arg_list(lo.ck.types().args_of(ty))
    expect index < listed.len()
    return listed[index]
} sequence_bound

/// Generates one element, entry or char of a collection or string at `slot` and adds it.
fn generate_entry(mut lo: Lowering, mut fx: Fx, record: clif::Value, choices_value: clif::Value, alloc: clif::Value, ty: ty::Ty, path: Str, slot: clif::Value) {
    let receiver = Held.Address(slot)
    let no_types = mem::List[ty::Ty].empty(lo.alloc)
    match path {
        "mem::Map" or "mem::HashMap" => {
            let Some(key) = lo.ck.types().type_arg(ty, index: 0) else {
                expect false
                return
            }
            let Some(value) = lo.ck.types().type_arg(ty, index: 1) else {
                expect false
                return
            }
            let key_at = generate_generate(mut lo, mut fx, ty: key, choices_value, alloc)
            let value_at = generate_generate(mut lo, mut fx, ty: value, choices_value, alloc)
            let key_held = mut lo.held_at(mut fx, ty: key, address: key_at)
            let value_held = mut lo.held_at(mut fx, ty: value, address: value_at)
            var insert_args = Array[Held, 3].filled(receiver)
            insert_args[1] = key_held
            insert_args[2] = value_held
            let replaced = call_member(mut lo, mut fx, owner: ty, member: "insert", own: no_types.view(), args: insert_args.view())
            var option_args = mem::List[ty::Ty].empty(lo.alloc)
            mut option_args.push(value)
            let option = lo.std_ty("core", type_name: "Option", args: take option_args)
            let laid = mut lo.layout_of(option)
            let held_at = mut fx.slot(laid.contents().size, align: laid.contents().align)
            mut lo.store_held(mut fx, address: held_at, held: replaced, ty: option)
            mut lo.release(mut fx, ty: option, address: held_at)
        }
        "text::Fixed" => {
            let low = mut fx.ptr(0x20)
            let high = mut fx.ptr(0x7E)
            let drawn_code = generate_draw(mut lo, mut fx, record, low, high, signed: false)
            let code = mut fx.b.ireduce(clif::Type.Int32, x: drawn_code)
            var push_args = Array[Held, 2].filled(receiver)
            push_args[1] = Held.Scalar(code)
            discard call_member(mut lo, mut fx, owner: ty, member: "push", own: no_types.view(), args: push_args.view())
        }
        else => {
            let element = match path {
                "mem::Bytes" => ty::Ty.scalar(ty::Scalar.Unsigned8)
                "text::String" => ty::Ty.scalar(ty::Scalar.Char)
                else => lo.ck.types().type_arg(ty, index: 0).value_or(ty::Ty.unit())
            }
            let at = generate_generate(mut lo, mut fx, ty: element, choices_value, alloc)
            let held = mut lo.held_at(mut fx, ty: element, address: at)
            var member = "push"
            if path == "mem::Set" {
                member = "insert"
            }
            var element_args = Array[Held, 2].filled(receiver)
            element_args[1] = held
            discard call_member(mut lo, mut fx, owner: ty, member, own: no_types.view(), args: element_args.view())
        }
    }
} generate_entry

/// Defines the generator a derive writes for a struct or enum: a struct's fields in
/// declaration order, each at its node, then the struct, its own predicates' frame pushed when
/// no frame reaches it; an enum's variant by a draw among the eligible ones, then its payload.
fn generate_derived(mut lo: Lowering, mut fx: Fx, abi: Abi, ty: ty::Ty) {
    let params = generator_params(mut fx, abi)
    let record = record_of(mut fx, choices_value: params.choices_value)
    let depth = generate_enter(mut fx, record)
    let laid = mut lo.layout_of(ty)
    let slot = mut fx.slot(laid.contents().size, align: laid.contents().align)
    let ty::TyKind.Item(item: item, args: _) = lo.ck.types().kind(ty) else {
        expect false
        return
    }
    let sig = lo.ck.sig(item)
    match sig.contents().kind {
        check::SigKind.Struct(fields: fields) => derived_struct(mut lo, mut fx, params, record, ty, fields: fields.view(), slot)
        check::SigKind.Enum(variants: variants) => derived_enum(mut lo, mut fx, params, record, ty, item, variants: variants.view(), slot, depth)
        else => {
            expect false
        }
    }
    leave(mut fx, record, depth)
    give(mut lo, mut fx, abi, sret: params.sret, ty, at: slot)
} generate_derived

/// A derived struct generator's fields, each generated at its node, its own predicates' frame
/// pushed around them when no frame reaches the struct.
fn derived_struct(mut lo: Lowering, mut fx: Fx, params: GeneratorArgs, record: clif::Value, ty: ty::Ty, fields: Slice[check::FieldSig], slot: clif::Value) {
    let own = struct_table(mut lo, ty)
    let cursor = mut fx.load(PTR, addr: record, offset: CHOICES_CURSOR)
    var pushed: Option[clif::Value] = None
    match own {
        Some(table_id) => {
            let unplaced = mut fx.b.icmp_imm_s(clif::IntCC.SignedLessThan, x: cursor, y: 0)
            mut fx.if_true(unplaced, then: fn[mut lo](mut fx1: Fx) {
                generate_push_frame(mut lo, fx: mut fx1, record, table_id)
            })
            pushed = Some(unplaced)
        }
        None => {}
    }
    let node = mut fx.load(PTR, addr: record, offset: CHOICES_CURSOR)
    for index in 0..<fields.len() {
        let name = fields[index].name.as_str()
        let Some(field_ty) = lo.ck.field_type(ty, name) else {
            expect false
            return
        }
        descend(mut fx, record, node, index: u64.widen(index))
        let value = generate_generate(mut lo, mut fx, ty: field_ty, choices_value: params.choices_value, alloc: params.alloc)
        let at = mut lo.layouts.field(lo.ck, ty, variant: None, label: name)
        let field_laid = mut lo.layout_of(field_ty)
        let target = mut fx.offset(slot, offset: at.offset)
        mut lo.copy(mut fx, dst: target, src: value, size: field_laid.contents().size, align: field_laid.contents().align)
    }
    mut fx.store(node, addr: record, offset: CHOICES_CURSOR)
    match pushed {
        Some(unplaced) => {
            mut fx.if_true(unplaced, then: fn(mut fx1: Fx) {
                pop_frame(mut fx1, record)
            })
        }
        None => {}
    }
} derived_struct

/// A derived enum generator's variant, drawn among every variant, or under `GENERATE_DEEP`
/// enclosing generator calls among those whose payload does not hold the enum, then its
/// payload.
fn derived_enum(mut lo: Lowering, mut fx: Fx, params: GeneratorArgs, record: clif::Value, ty: ty::Ty, item: ty::ItemId, variants: Slice[check::VariantSig], slot: clif::Value, depth: clif::Value) {
    var eligible = mem::List[usize].empty(lo.alloc)
    for index in 0..<variants.len() {
        if not holds_itself(lo, ty, variant_payload: variants[index].payload, enumeration: item) {
            mut eligible.push(index)
        }
    }
    let cursor = mut fx.load(PTR, addr: record, offset: CHOICES_CURSOR)
    unplace(mut fx, record)
    let deep = mut fx.b.icmp_imm_s(clif::IntCC.SignedGreaterThanOrEqual, x: depth, y: GENERATE_DEEP)
    expect variants.len() > 0
    let count_all = mut fx.ptr(u64.widen(variants.len()) - 1)
    var eligible_count = eligible.len()
    if eligible_count < 1 {
        eligible_count = 1
    }
    let count_eligible = mut fx.ptr(u64.widen(eligible_count) - 1)
    let high = mut fx.b.select(deep, x: count_eligible, y: count_all)
    let zero = mut fx.ptr(0)
    let position = generate_draw(mut lo, mut fx, record, low: zero, high, signed: false)
    let names = lo.variant_names(item)
    expect names.len() == variants.len()
    for index in 0..<variants.len() {
        let deep_position = eligible.position(fn(chosen: usize) => chosen == index)
        let shallow = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: position, y: i64.fit(index))
        let deep_chosen = match deep_position {
            Some(at) => mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: position, y: i64.fit(at))
            None => mut fx.int(clif::Type.Int8, value: 0)
        }
        let this = mut fx.b.select(deep, x: deep_chosen, y: shallow)
        let payload = payload_types(lo, ty, variant_payload: variants[index].payload)
        let name = names[index].as_str()
        mut fx.if_true(this, then: fn[mut lo](mut fx1: Fx) {
            var held = mem::List[Held].empty(fx1.alloc)
            for payload_ty in payload {
                let at = generate_generate(mut lo, fx: mut fx1, ty: payload_ty, choices_value: params.choices_value, alloc: params.alloc)
                mut held.push(mut lo.held_at(fx: mut fx1, ty: payload_ty, address: at))
            }
            let value = mut lo.variant_value(fx: mut fx1, ty, variant: name, payload_values: held.view(), wrapped: None)
            mut lo.store_held(fx: mut fx1, address: slot, held: value, ty)
        })
    }
    mut fx.store(cursor, addr: record, offset: CHOICES_CURSOR)
} derived_enum

/// The types of a variant's payload for an instantiation of its enum.
fn payload_types(lo: Lowering, ty: ty::Ty, variant_payload: check::Payload) -> mem::List[ty::Ty] {
    var types = mem::List[ty::Ty].empty(lo.alloc)
    let ty::TyKind.Item(item: item, args: args) = lo.ck.types().kind(ty) else {
        expect false
        return types
    }
    let subst = lo.subst(item, args)
    match variant_payload {
        check::Payload.None => {}
        check::Payload.Single(single) => mut types.push(subst.ty(lo.ck.types(), ty: single))
        check::Payload.Labelled(fields) => {
            for field in fields {
                mut types.push(subst.ty(lo.ck.types(), ty: field.ty))
            }
        }
    }
    return types
} payload_types

/// Whether a variant's payload holds its enum as a constituent type at any depth.
fn holds_itself(lo: Lowering, ty: ty::Ty, variant_payload: check::Payload, enumeration: ty::ItemId) -> bool {
    for payload_ty in payload_types(lo, ty, variant_payload) {
        var seen = mem::List[ty::ItemId].empty(lo.alloc)
        if generate_reaches(lo, ty: payload_ty, target: enumeration, mut seen) {
            return true
        }
    }
    return false
} holds_itself

/// Whether a type is an item or holds it as a constituent type, through fields, payloads and
/// type arguments.
fn generate_reaches(lo: Lowering, ty: ty::Ty, target: ty::ItemId, mut seen: mem::List[ty::ItemId]) -> bool {
    let ty::TyKind.Item(item: item, args: args) = lo.ck.types().kind(ty) else {
        return false
    }
    if item == target {
        return true
    }
    if seen.position(fn(known: ty::ItemId) => known == item).is_some() {
        return false
    }
    mut seen.push(item)
    for arg in lo.ck.types().arg_list(args) {
        let Some(arg_ty) = arg.ty() else {
            continue
        }
        if generate_reaches(lo, ty: arg_ty, target, mut seen) {
            return true
        }
    }
    for constituent in lo.ck.constituents(item) {
        let subst = lo.subst(item, args)
        if generate_reaches(lo, ty: subst.ty(lo.ck.types(), ty: constituent), target, mut seen) {
            return true
        }
    }
    return false
} generate_reaches

/// Generates the parameters of a property test's case into slots, each at its node of the
/// test's table, through a new choice record of the run's case and forced draws.
fn generate_case(mut lo: Lowering, mut fx: Fx, item: ty::ItemId, params: Slice[ty::Ty], alloc: clif::Value, run: CaseRun) -> mem::List[clif::Value] {
    let size = mut fx.ptr(CHOICES_SIZE)
    let record = mut lo.record_alloc(mut fx, size)
    exhausted_unless(mut lo, mut fx, address: record)
    mut fx.store(run.case_index, addr: record, offset: CHOICES_CASE)
    mut fx.store(run.forced, addr: record, offset: CHOICES_FORCED)
    mut fx.store(run.forced_count, addr: record, offset: CHOICES_FORCED_COUNT)
    unplace(mut fx, record)
    let table_id = case_table(mut lo, item, params)
    match table_id {
        Some(table) => generate_push_frame(mut lo, mut fx, record, table_id: table)
        None => {}
    }
    let choices_value = mut fx.slot(8, align: 8)
    mut fx.store(record, addr: choices_value, offset: 0)
    var slots = mem::List[clif::Value].empty(lo.alloc)
    for index in 0..<params.len() {
        match table_id {
            Some(_) => {
                let root = mut fx.ptr(0)
                descend(mut fx, record, node: root, index: u64.widen(index))
            }
            None => unplace(mut fx, record)
        }
        mut slots.push(generate_generate(mut lo, mut fx, ty: params[index], choices_value, alloc))
    }
    return slots
} generate_case

/// A read-only data object holding bytes, aligned to 8.
fn Lowering.data_object(mut self, kind: Str, take contents: mem::Bytes) -> object::DataId {
    expect self.glue < 0xFFFF_FFFF
    self.glue += 1
    var prefix = text::String.of("_NSdata_", alloc: self.alloc)
    mut prefix.append(kind)
    let name = numbered(prefix.as_str(), number: self.glue, alloc: self.alloc)
    let id = mut self.module.declare_data(name.as_str(), linkage: object::Linkage.Local, writable: false, tls: false)
    var description = object::DataDescription.new(self.alloc)
    mut description.define(take contents)
    mut description.set_align(8)
    mut self.module.define_data(id, take description)
    return id
} Lowering.data_object
