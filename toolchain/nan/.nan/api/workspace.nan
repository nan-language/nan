item "nan::workspace::holder_of"
head "fn holder_of(walked: Slice[Found], path: Str, alloc: mem::Alloc) -> Option[usize]"
accepted "ensures match result {         Some(index) => index < walked.len()         None => true     }"
item "nan::workspace::line_of_source"
head "fn line_of_source(lock: machine::Lock, source: Str) -> Option[usize]"
accepted "ensures match result {         Some(index) => index < lock.deps.len()         None => true     }"
item "nan::workspace::segment_end"
head "fn segment_end(bytes: Slice[u8], from: usize) -> usize"
accepted "ensures result <= bytes.len()"
