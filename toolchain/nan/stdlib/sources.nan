    \\
    \\pub fn u64.overflowing_add(self, other: u64) -> Overflowing[u64] limits pure, notrap, terminates
    \\    example (~0u64).overflowing_add(1) == Overflowing(value: 0, overflowed: true)
    \\{
    \\    let value = self.wrapping_add(other)
    \\    return Overflowing(value: value, overflowed: value < self)
    \\} u64.overflowing_add
    \\
    \\pub fn u64.checked_add(self, other: u64) -> Option[u64] limits pure, notrap, terminates
    \\    example (~0u64).checked_add(1) == None
    \\{
    \\    let sum = self.overflowing_add(other)
