//! An x86_64 bare kernel holding instances of the components of nanos bundles in isolated spaces.

package nanos_isolated_components {
    language 1
    targets x86_64-bare
    entry main
    dep gauges "./gauges"
    allow capability in nanos_isolated_components
    allow device in nanos_isolated_components
    allow priv in nanos_isolated_components
    allow trusted in nanos_isolated_components
    allow validate in nanos_isolated_components
} nanos_isolated_components
