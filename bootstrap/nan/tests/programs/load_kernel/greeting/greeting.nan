//! The tables of greeters and scalers, keyed by id.

/// A greeter: its id and the answer it gives a value.
pub closed struct Greeter {
    pub id: u32
    pub answer: fn(value: u32) -> u32 limits stack 4_096
} Greeter

pub loaded registry greeters: Greeter keyed by id

/// A scaler: its id and the value it scales a value to.
pub closed struct Scaler {
    pub id: u32
    pub scale: fn(value: u32) -> u32 limits stack 16_384
} Scaler

pub loaded registry scalers: Scaler keyed by id
