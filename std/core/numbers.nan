    let value = self.wrapping_sub(other)
    let overflowed = (self >= 0) != (other >= 0) and (value >= 0) != (self >= 0)
    return Overflowing(value: value, overflowed: overflowed)
} isize.overflowing_sub

pub fn isize.checked_sub(self, other: isize) -> Option[isize] limits pure, notrap, terminates
    example 0isize.checked_sub(1) == Some(-1)
{
    let difference = self.overflowing_sub(other)
    if difference.overflowed {
        return None
    }
    return Some(difference.value)
} isize.checked_sub

pub fn isize.saturating_sub(self, other: isize) -> isize limits pure, notrap, terminates
    example 0isize.saturating_sub(1) == -1
{
    let difference = self.overflowing_sub(other)
    if not difference.overflowed {
        return difference.value
    }
    if other < 0 {
        return 9_223_372_036_854_775_807
    }
    return -9_223_372_036_854_775_808
} isize.saturating_sub

pub fn isize.overflowing_mul(self, other: isize) -> Overflowing[isize] limits pure, notrap, terminates
    example (-2isize).overflowing_mul(3) == Overflowing(value: -6, overflowed: false)
{
    let wide = i64.widen(self).wide_mul(i64.widen(other))
    let value = i64.from_bits(wide.low)
    let negative = (wide.low >> 63) == 1
    let overflowed = not ((wide.high == 0 and not negative) or (wide.high == -1 and negative))
    return Overflowing(value: isize.widen(value), overflowed: overflowed)
} isize.overflowing_mul

pub fn isize.checked_mul(self, other: isize) -> Option[isize] limits pure, notrap, terminates
    example (-2isize).checked_mul(3) == Some(-6)
{
    let product = self.overflowing_mul(other)
    if product.overflowed {
        return None
    }
    return Some(product.value)
} isize.checked_mul

pub fn isize.saturating_mul(self, other: isize) -> isize limits pure, notrap, terminates
    example (-2isize).saturating_mul(3) == -6
{
    let product = self.overflowing_mul(other)
    if not product.overflowed {
        return product.value
    }
    if (self < 0) == (other < 0) {
        return 9_223_372_036_854_775_807
    }
    return -9_223_372_036_854_775_808
} isize.saturating_mul

pub fn isize.wrapping_neg(self) -> isize limits pure, notrap, terminates
    example (-5isize).wrapping_neg() == 5
{
    return 0isize.wrapping_sub(self)
} isize.wrapping_neg

pub fn isize.overflowing_neg(self) -> Overflowing[isize] limits pure, notrap, terminates
    example (-5isize).overflowing_neg() == Overflowing(value: 5, overflowed: false)
{
    return Overflowing(value: self.wrapping_neg(), overflowed: self == -9_223_372_036_854_775_808)
} isize.overflowing_neg

pub fn isize.checked_neg(self) -> Option[isize] limits pure, notrap, terminates
    example (-5isize).checked_neg() == Some(5)
{
    if self == -9_223_372_036_854_775_808 {
        return None
    }
    return Some(-self)
} isize.checked_neg

pub fn isize.saturating_neg(self) -> isize limits pure, notrap, terminates
    example (-5isize).saturating_neg() == 5
{
    if self == -9_223_372_036_854_775_808 {
        return 9_223_372_036_854_775_807
    }
    return -self
} isize.saturating_neg

pub fn isize.div_trunc(self, divisor: isize) -> isize limits pure, terminates
    example (-7isize).div_trunc(2) == -3

pub fn isize.rem_trunc(self, divisor: isize) -> isize limits pure, terminates
    example (-7isize).rem_trunc(2) == -1

pub fn isize.div_floor(self, divisor: isize) -> isize limits pure, terminates
    example (-7isize).div_floor(2) == -4
{
    let quotient = self.div_trunc(divisor)
    let remainder = self.rem_trunc(divisor)
    if remainder != 0 and (remainder < 0) != (divisor < 0) {
        return quotient - 1
    }
    return quotient
} isize.div_floor

pub fn isize.mod_floor(self, divisor: isize) -> isize limits pure, terminates
    example (-7isize).mod_floor(2) == 1
{
    let remainder = self.rem_trunc(divisor)
    if remainder != 0 and (remainder < 0) != (divisor < 0) {
        return remainder + divisor
    }
    return remainder
} isize.mod_floor

pub fn isize.shr_arith(self, amount: u32) -> isize limits pure, terminates
    example (-8isize).shr_arith(1) == -4

pub fn isize.wrapping_shl(self, amount: u32) -> isize limits pure, terminates
    example (-3isize).wrapping_shl(2) == -12

pub fn isize.checked_shl(self, amount: u32) -> Option[isize] limits pure, notrap, terminates
    example (-3isize).checked_shl(64) == None

pub fn isize.count_ones(self) -> u32 limits pure, notrap, terminates
    ensures result <= 64
    example 0b1011isize.count_ones() == 3

pub fn isize.leading_zeros(self) -> u32 limits pure, notrap, terminates
    ensures result <= 64
    example 0isize.leading_zeros() == 64

pub fn isize.trailing_zeros(self) -> u32 limits pure, notrap, terminates
    ensures result <= 64
    example 8isize.trailing_zeros() == 3

pub fn u64.wide_mul(self, other: u64) -> WideProduct[u64] limits pure, notrap, terminates
    example (~0u64).wide_mul(2) == WideProduct(high: 1, low: ~1u64)
    example (~0u64).wide_mul(~0u64) == WideProduct(high: ~1u64, low: 1)

pub fn i64.wide_mul(self, other: i64) -> WideProduct[i64] limits pure, notrap, terminates
    example (-1i64).wide_mul(1) == WideProduct(high: -1, low: ~0u64)

pub fn f64.abs(self) -> f64 limits pure, notrap, terminates
    example (-2.5f64).abs() == 2.5
{
    return f64.from_bits(self.to_bits() & ~(1u64 << 63))
} f64.abs

pub fn f64.sqrt(self) -> f64 limits pure, notrap, terminates
    example 2.25f64.sqrt() == 1.5

pub fn f64.fused_mul_add(self, factor: f64, addend: f64) -> f64 limits pure, notrap, terminates
    example 2.0f64.fused_mul_add(3.0, addend: 1.0) == 7.0

pub fn f64.is_nan(self) -> bool limits pure, notrap, terminates
    example (0.0f64 / 0.0).is_nan()
{
    return self != self
} f64.is_nan

pub fn f64.total_cmp(self, other: f64) -> Ordering limits pure, notrap, terminates
    example (-0.0f64).total_cmp(0.0) == Ordering.Less
{
    return total_key_u64(self.to_bits()).cmp(total_key_u64(other.to_bits()))
} f64.total_cmp

fn total_key_u64(bits: u64) -> u64 limits pure, notrap, terminates {
    if (bits & (1u64 << 63)) == 0 {
        return bits | (1u64 << 63)
    }
    return ~bits
} total_key_u64

pub fn f32.abs(self) -> f32 limits pure, notrap, terminates
    example (-2.5f32).abs() == 2.5
{
    return f32.from_bits(self.to_bits() & ~(1u32 << 31))
} f32.abs

pub fn f32.sqrt(self) -> f32 limits pure, notrap, terminates
    example 2.25f32.sqrt() == 1.5

pub fn f32.fused_mul_add(self, factor: f32, addend: f32) -> f32 limits pure, notrap, terminates
    example 2.0f32.fused_mul_add(3.0, addend: 1.0) == 7.0

pub fn f32.is_nan(self) -> bool limits pure, notrap, terminates
    example (0.0f32 / 0.0).is_nan()
{
    return self != self
} f32.is_nan

pub fn f32.total_cmp(self, other: f32) -> Ordering limits pure, notrap, terminates
    example (-0.0f32).total_cmp(0.0) == Ordering.Less
{
    return total_key_u32(self.to_bits()).cmp(total_key_u32(other.to_bits()))
} f32.total_cmp

fn total_key_u32(bits: u32) -> u32 limits pure, notrap, terminates {
    if (bits & (1u32 << 31)) == 0 {
        return bits | (1u32 << 31)
    }
    return ~bits
} total_key_u32

pub closed struct TotalF64 derives Copy {
    pub value: f64
} TotalF64

impl TotalF64: Eq

impl TotalF64: Ord

impl TotalF64: Hash

pub fn TotalF64.eq(self, other: TotalF64) -> bool limits pure, notrap, terminates
    ensures result == (self.value.to_bits() == other.value.to_bits())
    example not TotalF64(value: -0.0).eq(TotalF64(value: 0.0))
{
    return self.value.to_bits() == other.value.to_bits()
} TotalF64.eq

pub fn TotalF64.cmp(self, other: TotalF64) -> Ordering limits pure, notrap, terminates
    ensures result == self.value.total_cmp(other.value)
    example TotalF64(value: 1.0).cmp(TotalF64(value: 2.0)) == Ordering.Less

pub fn TotalF64.hash[H: Hasher](self, mut hasher: H) limits pure, notrap, terminates {
    self.value.to_bits().hash(mut hasher)
} TotalF64.hash

pub closed struct TotalF32 derives Copy {
    pub value: f32
} TotalF32

impl TotalF32: Eq

impl TotalF32: Ord

impl TotalF32: Hash

pub fn TotalF32.eq(self, other: TotalF32) -> bool limits pure, notrap, terminates
    ensures result == (self.value.to_bits() == other.value.to_bits())
    example not TotalF32(value: -0.0).eq(TotalF32(value: 0.0))
{
    return self.value.to_bits() == other.value.to_bits()
} TotalF32.eq

pub fn TotalF32.cmp(self, other: TotalF32) -> Ordering limits pure, notrap, terminates
    ensures result == self.value.total_cmp(other.value)
    example TotalF32(value: 1.0).cmp(TotalF32(value: 2.0)) == Ordering.Less

pub fn TotalF32.hash[H: Hasher](self, mut hasher: H) limits pure, notrap, terminates {
    self.value.to_bits().hash(mut hasher)
} TotalF32.hash

struct ByteSum {
    total: u64
} ByteSum

impl ByteSum: Hasher

fn ByteSum.write(mut self, bytes: Slice[u8]) limits pure, notrap, terminates {
    for byte in bytes {
        self.total = self.total.wrapping_add(u64.widen(byte))
    }
} ByteSum.write

test total_f64_hash_writes_the_bits for TotalF64.hash {
    var sum = ByteSum(total: 0)
    TotalF64(value: -0.0).hash(mut sum)
    expect sum.total == 0x80
} total_f64_hash_writes_the_bits

test total_f32_hash_writes_the_bits for TotalF32.hash {
    var sum = ByteSum(total: 0)
    TotalF32(value: -0.0).hash(mut sum)
    expect sum.total == 0x80
} total_f32_hash_writes_the_bits
