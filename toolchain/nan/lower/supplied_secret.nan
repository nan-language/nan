//! Secret values: each member of `core::Secret` lowered to one fixed sequence of integer instructions, without a branch, a division or an address computed from its operands, but for the shifts' check of their public amount; over a lane type, its lanes' loads and stores at its operands' addresses.

/// Defines a member of `core::Secret`.
fn secret_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) -> bool {
    if not supply.path.starts_with("core::Secret.") {
        return false
    }
    let Some(scalar) = lo.ck.types().scalar_of(supply.type_arg(lo, index: 0)) else {
        expect false
        return false
    }
    let signed = scalar.is_signed()
    let member = supply.member()
    let a = supply.param(0).scalar_value()
    if member == "of" or member == "reveal" {
        supply.ret(mut lo, mut fx, held: Held.Scalar(a))
        return true
    }
    if member == "bit_not" {
        var flipped = a
        if scalar == ty::Scalar.Bool {
            flipped = mut fx.b.bxor_imm_s(a, y: 1)
        } else {
            flipped = mut fx.b.bnot(a)
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(flipped))
        return true
    }
    if member == "widen" {
        let Some(source) = lo.ck.types().scalar_of(supply.type_arg(lo, index: 1)) else {
            expect false
            return false
        }
        var widened = a
        if source.is_signed() {
            widened = mut fx.b.sextend(scalar_type(scalar, machine: lo.machine()), x: a)
        } else {
            widened = mut fx.b.uextend(scalar_type(scalar, machine: lo.machine()), x: a)
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(widened))
        return true
    }
    if member == "truncate" {
        supply.ret(mut lo, mut fx, held: Held.Scalar(place_resize(mut fx, value: a, target: scalar_type(scalar, machine: lo.machine()))))
        return true
    }
    let b = supply.param(1).scalar_value()
    if member == "shl" or member == "shr" {
        let amount = body_widen(mut fx, value: b)
        let too_far = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: amount, y: i64.widen(scalar.bits()))
        mut fx.if_true(too_far, then: fn[mut lo](mut fx1: Fx) {
            raise_kind(mut lo, fx: mut fx1, kind: "trap.shift")
        })
        var shifted = a
        if member == "shl" {
            shifted = mut fx.b.ishl(a, y: b)
        } else if signed {
            shifted = mut fx.b.sshr(a, y: b)
        } else {
            shifted = mut fx.b.ushr(a, y: b)
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(shifted))
        return true
    }
    if member == "rotate_left" {
        let width = mut fx.int(clif::Type.Int32, value: i64.widen(scalar.bits()))
        let turn = mut fx.b.isub(width, y: b)
        supply.ret(mut lo, mut fx, held: Held.Scalar(mut fx.b.rotr(a, y: turn)))
        return true
    }
    if member == "select" {
        let chosen = mut fx.b.select(a, x: b, y: supply.param(2).scalar_value())
        supply.ret(mut lo, mut fx, held: Held.Scalar(chosen))
        return true
    }
    let Some(cond) = secret_comparison(member, signed) else {
        let Some(held) = secret_binary(mut fx, member, signed, a, b) else {
            return false
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(held))
        return true
    }
    supply.ret(mut lo, mut fx, held: Held.Scalar(mut fx.b.icmp(cond, x: a, y: b)))
    return true
} secret_lower

/// The condition a Secret comparison tests, by its name and the signedness of its operands.
fn secret_comparison(member: Str, signed: bool) -> Option[clif::IntCC] {
    return match first member {
        "eq" => Some(clif::IntCC.Equal)
        "ne" => Some(clif::IntCC.NotEqual)
        "lt" if signed => Some(clif::IntCC.SignedLessThan)
        "lt" => Some(clif::IntCC.UnsignedLessThan)
        "le" if signed => Some(clif::IntCC.SignedLessThanOrEqual)
        "le" => Some(clif::IntCC.UnsignedLessThanOrEqual)
        "gt" if signed => Some(clif::IntCC.SignedGreaterThan)
        "gt" => Some(clif::IntCC.UnsignedGreaterThan)
        "ge" if signed => Some(clif::IntCC.SignedGreaterThanOrEqual)
        "ge" => Some(clif::IntCC.UnsignedGreaterThanOrEqual)
        else => None
    }
} secret_comparison

/// The one instruction computing a Secret member on two values, by its name.
fn secret_binary(mut fx: Fx, member: Str, signed: bool, a: clif::Value, b: clif::Value) -> Option[clif::Value] {
    return match first member {
        "wrapping_add" => Some(mut fx.b.iadd(a, y: b))
        "wrapping_sub" => Some(mut fx.b.isub(a, y: b))
        "wrapping_mul" => Some(mut fx.b.imul(a, y: b))
        "mul_high" if signed => Some(mut fx.b.smulhi(a, y: b))
        "mul_high" => Some(mut fx.b.umulhi(a, y: b))
        "bit_and" => Some(mut fx.b.band(a, y: b))
        "bit_or" => Some(mut fx.b.bor(a, y: b))
        "bit_xor" => Some(mut fx.b.bxor(a, y: b))
        "rotate_right" => Some(mut fx.b.rotr(a, y: b))
        else => None
    }
} secret_binary

/// Defines a member of `core::Secret` over an integer lane type.
fn secret_lanes_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) -> bool {
    if not supply.path.starts_with("core::Secret.") {
        return false
    }
    let Some(lanes) = secret_lane_type(lo, supply) else {
        return false
    }
    secret_lanes(mut lo, mut fx, supply, lanes: lanes.as_str())
    return true
} secret_lanes_lower

/// The canonical path of the lane type a member of `core::Secret` computes on, or for `select` the
/// one it chooses between, none for a scalar.
fn secret_lane_type(lo: Lowering, supply: Supply) -> Option[text::String] {
    var held_ty = supply.type_arg(lo, index: 0)
    if supply.member() == "select" {
        held_ty = supply.type_arg(lo, index: 1)
    }
    let ty::TyKind.Item(item: lanes, args: _) = lo.ck.types().kind(held_ty) else {
        return None
    }
    return Some(lo.ck.db().canonical(lanes))
} secret_lane_type

/// Defines a member of `core::Secret` over an integer lane type, its values held in memory: the
/// lanes computed with vector instructions on a host target and one by one on a machine target,
/// the equality of all lanes over the two 64-bit halves, and `select` through a mask of the whole
/// value.
fn secret_lanes(mut lo: Lowering, mut fx: Fx, supply: Supply, lanes: Str)
    waive length "one sequence per kind of member, as the bootstrap gives them"
{
    var path_owner = text::String.of(lanes, alloc: lo.alloc)
    mut path_owner.append(".")
    let Some(ty) = simd_vector(path_owner.as_str()) else {
        expect false
        return
    }
    let signed = lanes.starts_with("core::simd::I")
    let member = supply.member()
    if member == "of" or member == "reveal" {
        supply.ret(mut lo, mut fx, held: supply.param(0))
        return
    }
    if member == "eq" or member == "ne" {
        let a = supply.param(0).address_value()
        let b = supply.param(1).address_value()
        let left_low = mut fx.load(clif::Type.Int64, addr: a, offset: 0)
        let right_low = mut fx.load(clif::Type.Int64, addr: b, offset: 0)
        let low = mut fx.b.bxor(left_low, y: right_low)
        let left_high = mut fx.load(clif::Type.Int64, addr: a, offset: 8)
        let right_high = mut fx.load(clif::Type.Int64, addr: b, offset: 8)
        let high = mut fx.b.bxor(left_high, y: right_high)
        let either = mut fx.b.bor(low, y: high)
        var cond = clif::IntCC.Equal
        if member == "ne" {
            cond = clif::IntCC.NotEqual
        }
        supply.ret(mut lo, mut fx, held: Held.Scalar(mut fx.b.icmp_imm_s(cond, x: either, y: 0)))
        return
    }
    let Some(sret) = supply.sret else {
        expect false
        return
    }
    if member == "select" {
        let wide = mut fx.b.uextend(clif::Type.Int64, x: supply.param(0).scalar_value())
        let mask = mut fx.b.ineg(wide)
        let a = supply.param(1).address_value()
        let b = supply.param(2).address_value()
        if lo.machine() {
            for half in 0u64..<2 {
                let left = mut fx.load(clif::Type.Int64, addr: a, offset: half * 8)
                let right = mut fx.load(clif::Type.Int64, addr: b, offset: half * 8)
                let kept = mut fx.b.band(left, y: mask)
                let rest = mut fx.b.band_not(right, y: mask)
                mut fx.store(mut fx.b.bor(kept, y: rest), addr: sret, offset: half * 8)
            }
        } else {
            let masks = mut fx.b.splat(clif::Type.Int64x2, x: mask)
            let left = mut fx.b.load(clif::Type.Int64x2, flags: simd_lanes(), p: a, offset: 0)
            let right = mut fx.b.load(clif::Type.Int64x2, flags: simd_lanes(), p: b, offset: 0)
            mut fx.b.store(simd_lanes(), x: mut fx.b.bitselect(masks, x: left, y: right), p: sret, offset: 0)
        }
        supply.ret(mut lo, mut fx, held: Held.Address(sret))
        return
    }
    let shifting = member == "shl" or member == "shr"
    var amount = clif::Value(index: 0)
    if shifting {
        amount = supply.param(1).scalar_value()
        let wide = body_widen(mut fx, value: amount)
        let too_far = mut fx.b.icmp_imm_s(clif::IntCC.UnsignedGreaterThanOrEqual, x: wide, y: i64.widen(ty.lane_type().bits()))
        mut fx.if_true(too_far, then: fn[mut lo](mut fx1: Fx) {
            raise_kind(mut lo, fx: mut fx1, kind: "trap.shift")
        })
    }
    let a = supply.param(0).address_value()
    let binary = not shifting and member != "bit_not"
    var b = a
    if binary {
        b = supply.param(1).address_value()
    }
    var count: u32 = 1
    var width: u32 = 16
    var value_ty = ty
    if lo.machine() {
        value_ty = ty.lane_type()
        width = value_ty.bytes()
        count = 16 / width
    }
    for index in 0u32..<count {
        let offset = i32.fit(index * width)
        let left = mut fx.b.load(value_ty, flags: simd_lanes(), p: a, offset: offset)
        var result = left
        if member == "bit_not" {
            result = mut fx.b.bnot(left)
        } else if member == "shl" {
            result = mut fx.b.ishl(left, y: amount)
        } else if member == "shr" and signed {
            result = mut fx.b.sshr(left, y: amount)
        } else if member == "shr" {
            result = mut fx.b.ushr(left, y: amount)
        } else {
            let right = mut fx.b.load(value_ty, flags: simd_lanes(), p: b, offset: offset)
            let Some(computed) = secret_binary(mut fx, member, signed, a: left, b: right) else {
                expect false
                return
            }
            result = computed
        }
        mut fx.b.store(simd_lanes(), x: result, p: sret, offset: offset)
    }
    supply.ret(mut lo, mut fx, held: Held.Address(sret))
} secret_lanes
