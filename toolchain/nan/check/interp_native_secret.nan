//! The members of `core::Secret` the interpreter supplies, over the value a Secret value holds.

/// A member of `core::Secret[T]` without a body.
fn Interpreter.secret_member(mut self, member: Str, type_args: Slice[ty::Arg], args: Slice[Val], at: ItemSpan) -> InterpFlow fails End {
    expect args.len() >= 1 and type_args.len() >= 1
    let Some(element) = type_args[0].ty() else {
        fail End.Missing
    }
    match self.ck.types().kind(element) {
        ty::TyKind.Item(item: lanes, args: _) => if member != "select" {
            return InterpFlow.Return(try mut self.secret_lanes(member, lanes, args, at))
        }
        else => {}
    }
    let Some(scalar) = self.ck.types().scalar_of(element) else {
        fail End.Missing
    }
    let held = self.deref(args[0])
    match member {
        "of" => return InterpFlow.Return(mut self.secret_of(take held))
        "reveal" => return InterpFlow.Return(self.inspected(args[0]))
        else => {}
    }
    let a = self.inspected(args[0]).int_value()
    if member == "bit_not" {
        return InterpFlow.Return(mut self.secret_of(secret_bits(scalar, value: a.bit_not())))
    }
    if member == "widen" {
        return InterpFlow.Return(self.deref(args[0]))
    }
    if member == "truncate" {
        return InterpFlow.Return(mut self.secret_of(Val.Int(wrap_scalar(a, scalar))))
    }
    expect args.len() >= 2
    if member == "select" {
        expect args.len() >= 3
        if self.inspected(args[0]).bool_value() {
            return InterpFlow.Return(self.deref(args[1]))
        }
        return InterpFlow.Return(self.deref(args[2]))
    }
    if member == "shl" or member == "shr" or member == "rotate_left" or member == "rotate_right" {
        let amount = self.deref(args[1]).int_value()
        return InterpFlow.Return(mut self.secret_of(try self.secret_shifted(scalar, member, a, amount, at)))
    }
    let Some(value) = secret_binary(scalar, member, a, b: self.inspected(args[1]).int_value()) else {
        fail End.Missing
    }
    return InterpFlow.Return(mut self.secret_of(take value))
} Interpreter.secret_member

/// A member of `core::Secret[T]` computing on two values, by its name.
fn secret_binary(scalar: ty::Scalar, member: Str, a: wide::Wide, b: wide::Wide) -> Option[Val] {
    return match member {
        "wrapping_add" => Some(Val.Int(wrap_scalar(a.wrapping_add(b), scalar)))
        "wrapping_sub" => Some(Val.Int(wrap_scalar(a.wrapping_sub(b), scalar)))
        "wrapping_mul" => Some(Val.Int(wrap_scalar(a.wrapping_mul(b), scalar)))
        "mul_high" => Some(Val.Int(product_high(a.wrapping_mul(b), signed: scalar.is_signed())))
        "bit_and" => Some(secret_bits(scalar, value: a.bit_and(b)))
        "bit_or" => Some(secret_bits(scalar, value: a.bit_or(b)))
        "bit_xor" => Some(secret_bits(scalar, value: a.bit_xor(b)))
        "eq" => Some(Val.Bool(a == b))
        "ne" => Some(Val.Bool(a != b))
        "lt" => Some(Val.Bool(a.lt(b)))
        "le" => Some(Val.Bool(a.le(b)))
        "gt" => Some(Val.Bool(b.lt(a)))
        "ge" => Some(Val.Bool(b.le(a)))
        else => None
    }
} secret_binary

/// A Secret value holding `value`.
fn Interpreter.secret_of(mut self, take value: Val) -> Val {
    let secret = self.ty_item("core", name: "Secret")
    return Val.Struct(item: secret, fields: mem::Shared.of(Val.single(take value, alloc: self.alloc), alloc: self.alloc))
} Interpreter.secret_of

/// A shift or rotation of the bits of `a` by `amount`, a shift trapping at an amount of at
/// least the width.
fn Interpreter.secret_shifted(self, scalar: ty::Scalar, member: Str, a: wide::Wide, amount: wide::Wide, at: ItemSpan) -> Val fails End {
    let width = scalar.bits()
    if member == "shl" or member == "shr" {
        if not amount.lt(wide::Wide.of_u64(u64.widen(width))) {
            fail self.trap("trap.shift", at)
        }
        let shift = u32.truncate(amount.low_bits())
        if member == "shl" {
            return Val.Int(wrap_scalar(a.shift_left(shift), scalar))
        }
        return Val.Int(a.shift_right(shift))
    }
    var turn = u32.truncate(amount.low_bits() % u64.widen(width))
    if member == "rotate_right" {
        turn = (width - turn) % width
    }
    let bits = integer_bits(a, scalar)
    if turn == 0 {
        return Val.Int(wrap_scalar(wide::Wide.of_u64(bits), scalar))
    }
    var mask = ~0u64
    if width < 64 {
        mask = ~((~0u64) << width)
    }
    let rotated = ((bits << turn) | (bits >> (width - turn))) & mask
    return Val.Int(wrap_scalar(wide::Wide.of_u64(rotated), scalar))
} Interpreter.secret_shifted

/// The value of a scalar type, `bool` included, whose two's complement bits are those of an
/// integer within its width.
fn secret_bits(scalar: ty::Scalar, value: wide::Wide) -> Val {
    if scalar == ty::Scalar.Bool {
        return Val.Bool(not value.bit_and(wide::Wide.one()).is_zero())
    }
    return Val.Int(wrap_scalar(value, scalar))
} secret_bits

/// The high 64 bits of a 128-bit product, signed or unsigned.
fn product_high(product: wide::Wide, signed: bool) -> wide::Wide {
    if signed {
        return product.shift_right(64)
    }
    return wide::Wide.of_u64(product.shift_right(64).low_bits())
} product_high

/// A member of `core::Secret[L]` for an integer lane type `L`: lane by lane on the lanes of the
/// values it holds, `eq` and `ne` comparing every lane.
fn Interpreter.secret_lanes(mut self, member: Str, lanes: ty::ItemId, args: Slice[Val], at: ItemSpan) -> Val fails End {
    let alloc = self.alloc
    if member == "of" {
        return mut self.secret_of(self.deref(args[0]))
    }
    let held = self.inspected(args[0])
    if member == "reveal" {
        return held
    }
    let a = held.fields()[0].fields()
    if member == "eq" or member == "ne" {
        let other = self.inspected(args[1])
        let same = Val.all_equal(a, right: other.fields()[0].fields())
        return Val.Bool(same == (member == "eq"))
    }
    let path = self.ck.db().canonical(lanes)
    let Some(scalar) = lane_scalar(path.as_str()) else {
        fail End.Missing
    }
    var amount = wide::Wide.zero()
    if member == "shl" or member == "shr" {
        amount = self.deref(args[1]).int_value()
        if not amount.lt(wide::Wide.of_u64(u64.widen(scalar.bits()))) {
            fail self.trap("trap.shift", at)
        }
    }
    var computed = mem::List[Val].empty(alloc)
    for index in 0..<a.len() {
        let x = a[index].int_value()
        if member == "bit_not" {
            mut computed.push(Val.Int(wrap_scalar(x.bit_not(), scalar)))
        } else if member == "shl" {
            mut computed.push(Val.Int(wrap_scalar(x.shift_left(u32.truncate(amount.low_bits())), scalar)))
        } else if member == "shr" {
            mut computed.push(Val.Int(x.shift_right(u32.truncate(amount.low_bits()))))
        } else {
            let other = self.inspected(args[1])
            let Some(value) = secret_binary(scalar, member, a: x, b: other.fields()[0].fields()[index].int_value()) else {
                fail End.Missing
            }
            mut computed.push(take value)
        }
    }
    let array = Val.Array(mem::Shared.of(take computed, alloc))
    let lane_value = Val.Struct(item: lanes, fields: mem::Shared.of(Val.single(take array, alloc), alloc))
    return mut self.secret_of(take lane_value)
} Interpreter.secret_lanes

/// The scalar of the lanes of an integer lane type named by its canonical path.
fn lane_scalar(path: Str) -> Option[ty::Scalar] {
    return match path {
        "core::simd::U8x16" => Some(ty::Scalar.Unsigned8)
        "core::simd::I8x16" => Some(ty::Scalar.Signed8)
        "core::simd::U16x8" => Some(ty::Scalar.Unsigned16)
        "core::simd::I16x8" => Some(ty::Scalar.Signed16)
        "core::simd::U32x4" => Some(ty::Scalar.Unsigned32)
        "core::simd::I32x4" => Some(ty::Scalar.Signed32)
        "core::simd::U64x2" => Some(ty::Scalar.Unsigned64)
        "core::simd::I64x2" => Some(ty::Scalar.Signed64)
        else => None
    }
} lane_scalar
