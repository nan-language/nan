//! The timers of the clocks the runtime keeps itself, the seeded scheduler's virtual clock, a kernel's clock and a Windows or macOS target's monotonic clock: one list of operations ordered by the nanosecond each is due, then by the order in which they were armed. A kernel's CPUs and a Windows or macOS target's executor threads share the list behind the timer lock.

/// The nanoseconds of a millisecond.
const NS_PER_MS: u64 = 1_000_000

/// Takes a timer that is armed and has not expired out of the timers, under the timer lock,
/// giving whether it did so; its cancelled completion is then the caller's to deliver.
fn claim_armed(mut lo: Lowering, mut fx: Fx, op: clif::Value) -> clif::Value {
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TIMER_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let done = mut fx.load(PTR, addr: op, offset: OPERATION_DONE)
    let pending = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: done, y: 0)
    let order = mut fx.load(PTR, addr: op, offset: OPERATION_ORDER)
    let armed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: order, y: 0)
    let in_flight = mut fx.b.band(pending, y: armed)
    mut fx.if_true(in_flight, then: fn[mut lo](mut fx1: Fx) {
        disarm(mut lo, fx: mut fx1, op)
        claim_timer(mut fx1, op)
    })
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    return in_flight
} claim_armed

/// Marks a timer taken out of the timers as completed, so no other thread or CPU delivers it.
fn claim_timer(mut fx: Fx, op: clif::Value) {
    let completed = mut fx.ptr(u64.fit(OPERATION_COMPLETED))
    mut fx.store(completed, addr: op, offset: OPERATION_DONE)
} claim_timer

/// Arms a timer due at nanosecond `due`, after every timer due no later.
fn arm(mut lo: Lowering, mut fx: Fx, op: clif::Value, due: clif::Value) {
    mut fx.store(due, addr: op, offset: OPERATION_DUE)
    let order = next_order(mut lo, mut fx)
    mut fx.store(order, addr: op, offset: OPERATION_ORDER)
    let zero = mut fx.ptr(0)
    mut fx.store(zero, addr: op, offset: OPERATION_WITHDRAW)
    mut fx.store(zero, addr: op, offset: OPERATION_DONE)
    let state_address = mut lo.state(mut fx)
    let head = mut fx.load(PTR, addr: state_address, offset: STATE_TIMERS)
    let found = mut fx.repeat(fx.list2(head, b: zero).view(), body: fn(mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        expect state.len() > 1
        let current = state[0]
        let previous = state[1]
        let present = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: current, y: 0)
        let compared = mut fx1.choose(present, results: fx1.types1(clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let other = mut fx2.load(PTR, addr: current, offset: OPERATION_DUE)
            let no_later = mut fx2.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: other, y: due)
            return fx2.list1(no_later)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(no)
        })
        let earlier = compared[0]
        let next = mut fx1.choose(earlier, results: fx1.types2(PTR, b: PTR).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let following = mut fx2.load(PTR, addr: current, offset: OPERATION_NEXT)
            return fx2.list2(following, b: current)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            return fx2.list2(current, b: previous)
        })
        return Pass(again: earlier, next: take next)
    })
    let after = found[0]
    let before = found[1]
    mut fx.store(after, addr: op, offset: OPERATION_NEXT)
    mut fx.store(before, addr: op, offset: OPERATION_PREVIOUS)
    let has_after = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: after, y: 0)
    mut fx.if_true(has_after, then: fn(mut fx1: Fx) {
        mut fx1.store(op, addr: after, offset: OPERATION_PREVIOUS)
    })
    let at_head = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: before, y: 0)
    discard mut fx.choose(at_head, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(op, addr: state_address, offset: STATE_TIMERS)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(op, addr: before, offset: OPERATION_NEXT)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
} arm

/// Takes a timer out of the timers.
fn disarm(mut lo: Lowering, mut fx: Fx, op: clif::Value) {
    let state_address = mut lo.state(mut fx)
    let next = mut fx.load(PTR, addr: op, offset: OPERATION_NEXT)
    let previous = mut fx.load(PTR, addr: op, offset: OPERATION_PREVIOUS)
    let at_head = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: previous, y: 0)
    discard mut fx.choose(at_head, results: mem::List[clif::Type].empty(fx.alloc).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(next, addr: state_address, offset: STATE_TIMERS)
        return mem::List[clif::Value].empty(fx1.alloc)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        mut fx1.store(next, addr: previous, offset: OPERATION_NEXT)
        return mem::List[clif::Value].empty(fx1.alloc)
    })
    let has_next = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: next, y: 0)
    mut fx.if_true(has_next, then: fn(mut fx1: Fx) {
        mut fx1.store(previous, addr: next, offset: OPERATION_PREVIOUS)
    })
} disarm

/// Arms a timer of the monotonic clock due `ns` nanoseconds from now in the timers a host
/// target's executor threads share.
fn arm_shared(mut lo: Lowering, mut fx: Fx, op: clif::Value, ns: clif::Value) {
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TIMER_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let now = mut lo.now_ns(mut fx)
    let due = due_after(mut fx, now, delay: ns)
    arm(mut lo, mut fx, op, due)
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
} arm_shared

/// Whether a timer is armed, and the nanoseconds until the first is due, zero once it is.
struct FirstDue derives Copy {
    armed: clif::Value
    left: clif::Value
} FirstDue

/// When the first of the timers a host target's executor threads share is due.
fn first_due_in(mut lo: Lowering, mut fx: Fx) -> FirstDue {
    let state_address = mut lo.state(mut fx)
    let lock = mut fx.offset(state_address, offset: STATE_TIMER_LOCK)
    discard mut lo.call_routine(mut fx, routine: Routine.Lock, args: fx.list1(lock).view())
    let earliest = mut fx.load(PTR, addr: state_address, offset: STATE_TIMERS)
    let armed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: earliest, y: 0)
    let due = mut fx.choose(armed, results: fx.types1(PTR).view(), then: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let first_due = mut fx1.load(PTR, addr: earliest, offset: OPERATION_DUE)
        return fx1.list1(first_due)
    }, otherwise: fn(mut fx1: Fx) -> mem::List[clif::Value] {
        let never = mut fx1.int(PTR, value: -1)
        return fx1.list1(never)
    })
    discard mut lo.call_routine(mut fx, routine: Routine.Unlock, args: fx.list1(lock).view())
    let now = mut lo.now_ns(mut fx)
    let ahead = mut fx.b.icmp(clif::IntCC.UnsignedGreaterThan, x: due[0], y: now)
    let difference = mut fx.b.isub(due[0], y: now)
    let zero = mut fx.ptr(0)
    let left = mut fx.b.select(ahead, x: difference, y: zero)
    return FirstDue(armed: armed, left: left)
} first_due_in

/// Takes each timer due out of the timers a host target's executor threads share, one at a
/// time under the timer lock, and delivers its expiry outside it.
fn expire_timers(mut lo: Lowering, mut fx: Fx) {
    let now = mut lo.now_ns(mut fx)
    discard mut fx.repeat(mem::List[clif::Value].empty(fx.alloc).view(), body: fn[mut lo](mut fx1: Fx, state: Slice[clif::Value]) -> Pass {
        let state_address = mut lo.state(mut fx1)
        let lock = mut fx1.offset(state_address, offset: STATE_TIMER_LOCK)
        discard mut lo.call_routine(mut fx1, routine: Routine.Lock, args: fx1.list1(lock).view())
        let earliest = mut fx1.load(PTR, addr: state_address, offset: STATE_TIMERS)
        let armed = mut fx1.b.icmp_imm_s(clif::IntCC.NotEqual, x: earliest, y: 0)
        let due = mut fx1.choose(armed, results: fx1.types1(clif::Type.Int8).view(), then: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let first_due = mut fx2.load(PTR, addr: earliest, offset: OPERATION_DUE)
            let passed = mut fx2.b.icmp(clif::IntCC.UnsignedLessThanOrEqual, x: first_due, y: now)
            return fx2.list1(passed)
        }, otherwise: fn(mut fx2: Fx) -> mem::List[clif::Value] {
            let no = mut fx2.int(clif::Type.Int8, value: 0)
            return fx2.list1(no)
        })
        mut fx1.if_true(due[0], then: fn[mut lo](mut fx2: Fx) {
            disarm(mut lo, fx: mut fx2, op: earliest)
            claim_timer(mut fx2, op: earliest)
        })
        discard mut lo.call_routine(mut fx1, routine: Routine.Unlock, args: fx1.list1(lock).view())
        mut fx1.if_true(due[0], then: fn[mut lo](mut fx2: Fx) {
            let expired = mut fx2.int(clif::Type.Int32, value: TASKS_EXPIRED)
            deliver(mut lo, fx: mut fx2, op: earliest, result: expired)
        })
        return Pass(again: due[0], next: mem::List[clif::Value].empty(fx1.alloc))
    })
} expire_timers

/// The nanosecond `delay` after `now`, the latest one when that is past it.
fn due_after(mut fx: Fx, now: clif::Value, delay: clif::Value) -> clif::Value {
    let sum = mut fx.b.uadd_overflow(now, y: delay)
    let latest = mut fx.int(PTR, value: -1)
    return mut fx.b.select(sum.flag, x: latest, y: sum.value)
} due_after

/// The delay from `now` until `ns` nanoseconds have passed and the time elapsed since `origin` is
/// a multiple of `resolution`, zero standing for one, saturating.
fn on_grid(mut fx: Fx, now: clif::Value, origin: clif::Value, resolution: clif::Value, ns: clif::Value) -> clif::Value {
    let one = mut fx.ptr(1)
    let step = mut fx.b.umax(resolution, y: one)
    let elapsed = mut fx.b.isub(now, y: origin)
    let end = due_after(mut fx, now: elapsed, delay: ns)
    let rest = mut fx.b.urem(end, y: step)
    let short = mut fx.b.isub(step, y: rest)
    let rounded = due_after(mut fx, now: end, delay: short)
    let exact = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: rest, y: 0)
    let ended = mut fx.b.select(exact, x: end, y: rounded)
    return mut fx.b.isub(ended, y: elapsed)
} on_grid

/// The nanoseconds of `ms` milliseconds, the most a word holds when they are more.
fn from_ms(mut fx: Fx, ms: clif::Value) -> clif::Value {
    let per_ms = mut fx.ptr(NS_PER_MS)
    let low = mut fx.b.imul(ms, y: per_ms)
    let high = mut fx.b.umulhi(ms, y: per_ms)
    let overflow = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: high, y: 0)
    let latest = mut fx.int(PTR, value: -1)
    return mut fx.b.select(overflow, x: latest, y: low)
} from_ms
