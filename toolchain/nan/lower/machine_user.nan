//! User mode on the machine targets: the code through which `hw::Ring0.run_user` enters it and the paths that end that call when code there raises an exception, makes a system call or is interrupted, which the vector seam holds after its common seam; and the `syscall` instruction's target on x86_64.

/// The exits the user paths give: a system call, an exception, with its vector, code and address
/// written to a fault record of three words, and an interrupt.
const USER_SYSCALL: i64 = 0

const USER_FAULT: i64 = 1

// The user paths keep the kernel stack pointer, the state, on x86_64 the user stack pointer of a
// system call, the root to reinstall and the entry stack's top at these offsets of the CPU
// record, set the task-state segment's `RSP0`, and on AArch64 restore the interrupt stack's top
// and take the entry stack below the record's end.
const assert CPU_USER_SP == 0x160 and CPU_USER_STATE == 0x168

const assert CPU_USER_SCRATCH == 0x170 and CPU_TSS + 4 == 0x7c

const assert CPU_KERNEL_ROOT == 0x178 and CPU_ENTRY_TOP == 0x180

const assert CPU_STACK_TOP == 0x10 and CPU_SIZE == 0x200

/// The x86_64 user path, which follows the common seam in the vector seam. Its entry `X64_ENTER`
/// takes the state, the fault record, and a user root to install and the running root to
/// reinstall at the exit, both CR3 values or zero. For an instruction pointer outside the
/// canonical lower half it gives the fault of a general protection fault at once. Otherwise it
/// saves the callee-saved registers, the flags and the fault record, keeps that 16-byte-aligned
/// stack pointer, the state and the root to reinstall in the CPU record, moves to the entry stack
/// with a user root, makes the stack it is on `RSP0`, and enters user mode through `iretq` with
/// the state's registers, its arithmetic and direction flags with interrupts enabled, and the
/// privilege-level-3 segments, installing the user root last. `X64_SYSCALL`, the `syscall`
/// target, and its entry 0x143 bytes in, which the vector seam's checks jump to for a vector
/// raised in user mode, swap the GS base back, reinstall the running root when one is kept, save
/// the user registers, instruction pointer, flags and stack pointer in the state and return to
/// the kept stack. An exception vector other than 2, 8 and 18 writes its fault: the vector, the
/// error code and, for a page fault, `CR2`. Any other vector clears the flags and pushes an
/// interrupt frame of the kernel's segments returning, with the kept stack and the caller's
/// flags, to the code giving an interrupt's exit, then jumps to the common seam's first entry,
/// which serves the vector and may preempt the task there. Each exit restores the caller's
/// registers and flags and returns.
const X64_USER: Slice[u8] = b"\x48\x8b\x87\x00\x01\x00\x00\x48\xc1\xe8\x2f\x0f\x85\xaf\x00\x00\x00\x55\x53\x41\x54\x41\x55\x41\x56\x41\x57\x56\x9c\x48\x83\xec\x08\xfa\x65\x48\x89\x24\x25\x60\x01\x00\x00\x65\x48\x89\x3c\x25\x68\x01\x00\x00\x65\x48\x89\x0c\x25\x78\x01\x00\x00\x48\x85\xd2\x74\x09\x65\x48\x8b\x24\x25\x80\x01\x00\x00\x65\x48\x89\x24\x25\x7c\x00\x00\x00\x6a\x1b\xff\xb7\xf8\x00\x00\x00\x48\x8b\x87\x08\x01\x00\x00\x25\xd5\x0c\x00\x00\x0d\x02\x02\x00\x00\x50\x6a\x23\xff\xb7\x00\x01\x00\x00\xff\x37\x52\x48\x8b\x4f\x08\x48\x8b\x57\x10\x48\x8b\x5f\x18\x48\x8b\x6f\x20\x48\x8b\x77\x28\x4c\x8b\x47\x38\x4c\x8b\x4f\x40\x4c\x8b\x57\x48\x4c\x8b\x5f\x50\x4c\x8b\x67\x58\x4c\x8b\x6f\x60\x4c\x8b\x77\x68\x4c\x8b\x7f\x70\x48\x8b\x7f\x30\x58\x48\x85\xc0\x74\x03\x0f\x22\xd8\x58\x0f\x01\xf8\x48\xcf\x48\xc7\x06\x0d\x00\x00\x00\x48\xc7\x46\x08\x00\x00\x00\x00\x48\xc7\x46\x10\x00\x00\x00\x00\xb8\x01\x00\x00\x00\xc3\x0f\x01\xf8\x65\x48\x89\x24\x25\x70\x01\x00\x00\x65\x48\x8b\x24\x25\x78\x01\x00\x00\x48\x85\xe4\x74\x03\x0f\x22\xdc\x65\x48\x8b\x24\x25\x60\x01\x00\x00\x50\x65\x48\x8b\x04\x25\x68\x01\x00\x00\xe8\xf8\x00\x00\x00\x59\x48\x89\x08\x65\x48\x8b\x0c\x25\x70\x01\x00\x00\x48\x89\x88\xf8\x00\x00\x00\x48\x8b\x48\x08\x48\x89\x88\x00\x01\x00\x00\x48\x8b\x48\x50\x48\x89\x88\x08\x01\x00\x00\x31\xc0\xe9\xb6\x00\x00\x00\x0f\x01\xf8\x50\x65\x48\x8b\x04\x25\x78\x01\x00\x00\x48\x85\xc0\x74\x03\x0f\x22\xd8\x65\x48\x8b\x04\x25\x68\x01\x00\x00\xe8\xa4\x00\x00\x00\x59\x48\x89\x08\x48\x8b\x4c\x24\x10\x48\x89\x88\x00\x01\x00\x00\x48\x8b\x4c\x24\x20\x48\x89\x88\x08\x01\x00\x00\x48\x8b\x4c\x24\x28\x48\x89\x88\xf8\x00\x00\x00\x48\x8b\x3c\x24\x48\x8b\x74\x24\x08\x65\x48\x8b\x24\x25\x60\x01\x00\x00\x6a\x02\x9d\x48\x83\xff\x20\x73\x30\x83\xff\x02\x74\x2b\x83\xff\x08\x74\x26\x83\xff\x12\x74\x21\x48\x8b\x44\x24\x10\x48\x89\x38\x48\x89\x70\x08\x31\xd2\x83\xff\x0e\x75\x03\x0f\x20\xd2\x48\x89\x50\x10\xb8\x01\x00\x00\x00\xeb\x20\x48\x89\xe0\x6a\x10\x50\xff\x70\x08\x6a\x08\x48\x8d\x0d\x09\x00\x00\x00\x51\x6a\x00\x57\xe9\x53\xfd\xff\xff\xb8\x02\x00\x00\x00\x48\x83\xc4\x08\x9d\x5e\x41\x5f\x41\x5e\x41\x5d\x41\x5c\x5b\x5d\xc3\x48\x89\x48\x08\x48\x89\x50\x10\x48\x89\x58\x18\x48\x89\x68\x20\x48\x89\x70\x28\x48\x89\x78\x30\x4c\x89\x40\x38\x4c\x89\x48\x40\x4c\x89\x50\x48\x4c\x89\x58\x50\x4c\x89\x60\x58\x4c\x89\x68\x60\x4c\x89\x70\x68\x4c\x89\x78\x70\xc3"

const X64_ENTER: u32 = 0

const X64_SYSCALL: u32 = 0xdd


/// The AArch64 user path, which follows the common seam in the vector table. Its entry
/// `AARCH64_ENTER` takes the state, the fault record, and a user root to install and the running
/// root to reinstall at the exit, both `TTBR0_EL1` values or zero. It saves the callee-saved
/// registers, the fault record and the caller's interrupt masks, keeps that stack pointer, the
/// state and the root to reinstall in the CPU record, masks every exception, makes the entry
/// stack below the record's end the one exceptions switch to, and enters EL0 through `eret` with
/// the state's registers, its condition flags and no mask, installing the user root last with
/// `TTBR1_EL1` walks disabled and dropping every translation cached under its ASID. Its entry
/// 0xd0 bytes in, which each EL0 entry of the vector table branches to with the kind of
/// exception in `x0` and the user's `x0` and `x1` pushed on the entry stack, reinstalls the
/// running root when one is kept, enabling `TTBR1_EL1` walks again, saves the user registers, stack pointer, return address and
/// state in the state, makes the interrupt stack the one exceptions switch to again, restores
/// the kept stack as `SP_EL0` and returns to EL1 with the caller's masks: from an `svc`, to the
/// code giving a system call's exit; from another synchronous exception, writing its fault, the
/// vector the dispatcher gives its syndrome, the syndrome and, for an abort, `FAR_EL1`, to the
/// code giving a fault's exit; from an interrupt or SError, through the vector table's entry for
/// that kind from kernel code, which serves it and may preempt the task, to the code giving an
/// interrupt's exit. Each exit restores the caller's registers and returns.
const AARCH64_USER: Slice[u8] = b"\xfd\x7b\xba\xa9\xf3\x53\x01\xa9\xf5\x5b\x02\xa9\xf7\x63\x03\xa9\xf9\x6b\x04\xa9\xfb\x73\x05\xa9\x24\x42\x3b\xd5\xe1\x13\xbf\xa9\xdf\x4f\x03\xd5\xe5\x03\x00\x91\x86\xd0\x38\xd5\xc5\xb0\x00\xf9\xc0\xb4\x00\xf9\xc3\xbc\x00\xf9\x07\x20\x50\xa9\x27\x40\x18\xd5\x08\x0d\x64\x92\x08\x40\x18\xd5\x07\x7c\x40\xf9\xbf\x41\x00\xd5\xc8\x00\x08\x91\x1f\x01\x00\x91\x07\x41\x18\xd5\x07\x20\x40\xa9\xe7\x23\xbf\xa9\xe2\x7f\xbf\xa9\x02\x0c\x41\xa9\x04\x14\x42\xa9\x06\x1c\x43\xa9\x08\x24\x44\xa9\x0a\x2c\x45\xa9\x0c\x34\x46\xa9\x0e\x3c\x47\xa9\x10\x44\x48\xa9\x12\x4c\x49\xa9\x14\x54\x4a\xa9\x16\x5c\x4b\xa9\x18\x64\x4c\xa9\x1a\x6c\x4d\xa9\x1c\x74\x4e\xa9\x1e\x78\x40\xf9\xe0\x07\xc1\xa8\x00\x01\x00\xb4\x00\x20\x18\xd5\x41\x20\x38\xd5\x21\x00\x69\xb2\x41\x20\x18\xd5\x40\x87\x08\xd5\x9f\x37\x03\xd5\xdf\x3f\x03\xd5\xe0\x07\xc1\xa8\xe0\x03\x9f\xd6\x81\xd0\x38\xd5\x21\xbc\x40\xf9\xc1\x00\x00\xb4\x01\x20\x18\xd5\x41\x20\x38\xd5\x21\xf8\x68\x92\x41\x20\x18\xd5\xdf\x3f\x03\xd5\x81\xd0\x38\xd5\x21\xb4\x40\xf9\x22\x0c\x01\xa9\x24\x14\x02\xa9\x26\x1c\x03\xa9\x28\x24\x04\xa9\x2a\x2c\x05\xa9\x2c\x34\x06\xa9\x2e\x3c\x07\xa9\x30\x44\x08\xa9\x32\x4c\x09\xa9\x34\x54\x0a\xa9\x36\x5c\x0b\xa9\x38\x64\x0c\xa9\x3a\x6c\x0d\xa9\x3c\x74\x0e\xa9\x3e\x78\x00\xf9\xe2\x0f\xc1\xa8\x22\x0c\x00\xa9\x02\x41\x38\xd5\x22\x7c\x00\xf9\x22\x40\x38\xd5\x03\x40\x38\xd5\x22\x0c\x10\xa9\x82\xd0\x38\xd5\x43\x08\x40\xf9\x7f\x00\x00\x91\x42\xb0\x40\xf9\x02\x41\x18\xd5\x43\x04\x40\xf9\x63\x00\x7e\xb2\x03\x40\x18\xd5\xa0\x02\x00\xb5\x03\x52\x38\xd5\x64\xfc\x5a\xd3\x9f\x54\x00\xf1\x61\x00\x00\x54\x00\x00\x80\xd2\x0c\x00\x00\x14\x45\x00\x40\xf9\x47\x07\x80\xd2\x84\x00\x07\x8a\x9f\x80\x00\xf1\xe4\x17\x9f\x9a\x06\x60\x38\xd5\x9f\x00\x00\xf1\xe6\x03\x86\x9a\xa4\x0c\x00\xa9\xa6\x08\x00\xf9\x20\x00\x80\xd2\xa1\x01\x00\x10\x21\x40\x18\xd5\xe0\x03\x9f\xd6\x21\x01\x00\x10\x21\x40\x18\xd5\x1f\x04\x00\xf1\x80\x00\x00\x54\x1f\x08\x00\xf1\x60\x00\x00\x54\x8b\xfd\xff\x17\x4a\xfd\xff\x17\x69\xfd\xff\x17\x40\x00\x80\xd2\xe1\x0f\xc1\xa8\xf3\x53\x41\xa9\xf5\x5b\x42\xa9\xf7\x63\x43\xa9\xf9\x6b\x44\xa9\xfb\x73\x45\xa9\xfd\x7b\xc6\xa8\xc0\x03\x5f\xd6"

const AARCH64_ENTER: u32 = 0

/// The PCID bits of a CR3 value, its no-flush bit, and the PCID bit a user root's translations
/// flip; the ASID bits of a `TTBR0_EL1` value, and the ASID bit a user root's flip.
const PCID_MASK: i64 = 0xFFF

const NO_FLUSH: i64 = ~0x7FFF_FFFF_FFFF_FFFF

const USER_PCID: i64 = 0x800

const ASID_MASK: i64 = 0xFF << 48

const USER_ASID: i64 = 0x80 << 48

/// The model-specific registers enabling `syscall` and giving its segments, its target and
/// the flags it clears, the bit of `EFER` enabling it, the selectors `STAR` holds, and the
/// trap, interrupt, direction, I/O privilege, nested task and alignment check flags.
const MSR_EFER: u32 = 0xC000_0080

const MSR_STAR: u32 = 0xC000_0081

const MSR_LSTAR: u32 = 0xC000_0082

const MSR_FMASK: u32 = 0xC000_0084

const SYSCALL_ENABLE: i64 = 1

const SYSCALL_SEGMENTS: u64 = (0x10u64 << 48) | (0x08u64 << 32)

const SYSCALL_CLEARED: u64 = 0x4_7700

/// The running CPU's record, and whether the running code is in thread context.
struct ThreadContext derives Copy {
    record: clif::Value
    inside: clif::Value
} ThreadContext

/// The running CPU's record, and whether the running code is in thread context: the anchor is
/// installed and no interrupt fn runs.
fn Lowering.thread_context(mut self, mut fx: Fx) -> ThreadContext {
    let state_address = mut self.state(mut fx)
    let anchor = mut fx.load(PTR, addr: state_address, offset: STATE_ANCHOR)
    let installed = mut fx.b.icmp_imm_s(clif::IntCC.NotEqual, x: anchor, y: 0)
    let record = mut self.running_cpu(mut fx)
    let serving = mut fx.load(PTR, addr: record, offset: CPU_FRAME)
    let outside = mut fx.b.icmp_imm_s(clif::IntCC.Equal, x: serving, y: 0)
    let inside = mut fx.b.band(installed, y: outside)
    return ThreadContext(record: record, inside: inside)
} Lowering.thread_context

/// Enters user mode with the `hw::UserState` at `user_state` through the vector seam's user path,
/// under `user_root`, and reinstalling `kernel_root` at the exit, or under the running root when
/// both are zero; gives the exit and writes a fault's vector, code and address at `fault`.
fn Lowering.enter_user(mut self, mut fx: Fx, user_state: clif::Value, fault: clif::Value, user_root: clif::Value, kernel_root: clif::Value) -> clif::Value {
    let path = mut self.user_path()
    let seam_ref = mut self.func_ref(mut fx, id: path.seam)
    let seam = mut fx.b.func_addr(PTR, func_ref: seam_ref)
    var enter = X64_ENTER
    if self.machine_arch() == workspace::Arch.Aarch64 {
        enter = AARCH64_ENTER
    }
    let entry = mut fx.b.iadd_imm_s(seam, y: i64.widen(path.at + enter))
    var signature = clif::Signature.new(CALL_CONV, alloc: fx.alloc)
    for _ in 0..<4u32 {
        mut signature.params.push(clif::AbiParam(value_type: PTR))
    }
    mut signature.returns.push(clif::AbiParam(value_type: PTR))
    let sig_ref = mut fx.b.import_signature(take signature)
    var call_args = mem::List[clif::Value].empty(fx.alloc)
    mut call_args.push(user_state)
    mut call_args.push(fault)
    mut call_args.push(user_root)
    mut call_args.push(kernel_root)
    let call = mut fx.b.call_indirect(sig_ref, callee: entry, args: call_args.view())
    mut fx.sites.push(CallSite(inst: call, site: Site(kind: StackKind.Stub, at: None)))
    let results = fx.b.inst_results(call, alloc: fx.alloc)
    expect results.len() > 0
    return results[0]
} Lowering.enter_user

/// The values a user path installs for a user root and reinstalls for the running root.
struct SplitRoots derives Copy {
    user_root: clif::Value
    kernel_root: clif::Value
} SplitRoots

/// The values a user path installs for a user root, the frame of `root`, and reinstalls for the
/// running root at the exit. On x86_64 the user root's translations take the running root's PCID
/// with bit 11 flipped, and with PCIDs enabled the running root keeps its translations while
/// installing the user root drops those of its PCID; on AArch64 the user root takes the running
/// root's ASID with bit 7 flipped, whose translations the user path drops.
fn Lowering.split_roots(mut self, mut fx: Fx, root: clif::Value) -> SplitRoots {
    let none = mem::List[clif::Value].empty(fx.alloc)
    if self.machine_arch() == workspace::Arch.Aarch64 {
        let ttbr = mut self.call_stub(mut fx, stub: Stub.ReadTtbr0, args: none.view())
        expect ttbr.len() > 0
        let asid = mut fx.b.band_imm_s(ttbr[0], y: ASID_MASK)
        let flipped_asid = mut fx.b.bxor_imm_s(asid, y: USER_ASID)
        let user_root = mut fx.b.bor(root, y: flipped_asid)
        return SplitRoots(user_root: user_root, kernel_root: ttbr[0])
    }
    let cr3 = mut self.call_stub(mut fx, stub: Stub.ReadCr3, args: none.view())
    expect cr3.len() > 0
    let running = cr3[0]
    let pcid = mut fx.b.band_imm_s(running, y: PCID_MASK)
    let keep = mut fx.ptr(1)
    var tag_args = Array[clif::Value, 2].filled(pcid)
    tag_args[1] = keep
    let tags = mut self.call_stub(mut fx, stub: Stub.Cr3Tag, args: tag_args.view())
    expect tags.len() > 0
    let kept = mut fx.b.band_imm_s(tags[0], y: NO_FLUSH)
    let kernel_root = mut fx.b.bor(running, y: kept)
    let flipped_pcid = mut fx.b.bxor_imm_s(pcid, y: USER_PCID)
    let drop = mut fx.ptr(0)
    tag_args[0] = flipped_pcid
    tag_args[1] = drop
    let user_tags = mut self.call_stub(mut fx, stub: Stub.Cr3Tag, args: tag_args.view())
    expect user_tags.len() > 0
    let user_root = mut fx.b.bor(root, y: user_tags[0])
    return SplitRoots(user_root: user_root, kernel_root: kernel_root)
} Lowering.split_roots

/// The entry area's first address and length.
struct EntrySpan derives Copy {
    base: clif::Value
    len: clif::Value
} EntrySpan

/// The entry area, the image's first address and length.
fn Lowering.entry_area(mut self, mut fx: Fx) -> EntrySpan {
    let extent = mut self.image_extent(mut fx)
    let len = mut fx.b.isub(extent.end, y: extent.start)
    return EntrySpan(base: extent.start, len: len)
} Lowering.entry_area

/// Enables `syscall` on the running x86_64 CPU, its target the user path's and the flags it
/// clears those the kernel runs without.
fn Lowering.enable_syscall(mut self, mut fx: Fx) {
    let efer = mut fx.ptr(u64.widen(MSR_EFER))
    let read = mut self.call_stub(mut fx, stub: Stub.Rdmsr, args: Array[clif::Value, 1].filled(efer).view())
    expect read.len() > 0
    let flags = mut fx.b.bor_imm_s(read[0], y: SYSCALL_ENABLE)
    mut self.write_msr(mut fx, msr: MSR_EFER, value: flags)
    let selectors = mut fx.ptr(SYSCALL_SEGMENTS)
    mut self.write_msr(mut fx, msr: MSR_STAR, value: selectors)
    let path = mut self.user_path()
    let seam_ref = mut self.func_ref(mut fx, id: path.seam)
    let seam = mut fx.b.func_addr(PTR, func_ref: seam_ref)
    let target = mut fx.b.iadd_imm_s(seam, y: i64.widen(path.at + X64_SYSCALL))
    mut self.write_msr(mut fx, msr: MSR_LSTAR, value: target)
    let cleared = mut fx.ptr(SYSCALL_CLEARED)
    mut self.write_msr(mut fx, msr: MSR_FMASK, value: cleared)
} Lowering.enable_syscall
