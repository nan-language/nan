//! The AArch64 instruction set: its registers, numbered 0 to 30 for the general-purpose ones, 31 for the stack pointer or zero register (read as `xzr` and written as `sp` by the instructions that name it so) and 32 to 63 for the SIMD and floating-point ones, its condition codes and memory operands.

pkg const X0: machinst::Reg = machinst::Reg(index: 0)

pkg const X1: machinst::Reg = machinst::Reg(index: 1)

pkg const X2: machinst::Reg = machinst::Reg(index: 2)

/// The frame pointer, `x29`.
pkg const FP: machinst::Reg = machinst::Reg(index: 29)

/// The link register, `x30`.
pkg const LR: machinst::Reg = machinst::Reg(index: 30)

/// The stack pointer or zero register, encoded as 31.
pkg const SP: machinst::Reg = machinst::Reg(index: 31)

/// A general-purpose register by its number.
pkg fn xreg(number: u32) -> machinst::Reg
    requires number < 31
{
    return machinst::Reg(index: number)
} xreg

/// A SIMD and floating-point register by its number.
pkg fn vreg(number: u32) -> machinst::Reg
    requires number < 32
    ensures is_vector(result)
{
    return machinst::Reg(index: 32 + number)
} vreg

/// Whether a register is a physical SIMD and floating-point register.
pkg fn is_vector(reg: machinst::Reg) -> bool = reg.index >= 32 and reg.index < 64

/// The 5-bit number a general-purpose register or the stack pointer has in an instruction field.
pkg fn hw(reg: machinst::Reg) -> u32
    requires reg.index < 32
{
    return reg.index
} hw

/// The 5-bit number a SIMD register has in an instruction field.
pkg fn vhw(reg: machinst::Reg) -> u32
    requires is_vector(reg)
{
    return reg.index - 32
} vhw

/// A condition on the flags, numbered as the instruction encodings number it.
pkg enum Cond derives Copy, Eq {
    Eq
    Ne
    Hs
    Lo
    Mi
    Pl
    Vs
    Vc
    Hi
    Ls
    Ge
    Lt
    Gt
    Le
} Cond

pkg fn Cond.code(self) -> u32
    ensures result <= 13
{
    return match self {
        Cond.Eq => 0
        Cond.Ne => 1
        Cond.Hs => 2
        Cond.Lo => 3
        Cond.Mi => 4
        Cond.Pl => 5
        Cond.Vs => 6
        Cond.Vc => 7
        Cond.Hi => 8
        Cond.Ls => 9
        Cond.Ge => 10
        Cond.Lt => 11
        Cond.Gt => 12
        Cond.Le => 13
    }
} Cond.code

/// The condition holding exactly when this one does not.
pkg fn Cond.invert(self) -> Cond {
    return match self {
        Cond.Eq => Cond.Ne
        Cond.Ne => Cond.Eq
        Cond.Hs => Cond.Lo
        Cond.Lo => Cond.Hs
        Cond.Mi => Cond.Pl
        Cond.Pl => Cond.Mi
        Cond.Vs => Cond.Vc
        Cond.Vc => Cond.Vs
        Cond.Hi => Cond.Ls
        Cond.Ls => Cond.Hi
        Cond.Ge => Cond.Lt
        Cond.Lt => Cond.Ge
        Cond.Gt => Cond.Le
        Cond.Le => Cond.Gt
    }
} Cond.invert

/// A memory operand: `base + disp`, with the base a general-purpose register or the stack
/// pointer; or `base + index` with the index a general-purpose register scaled by the access
/// size when `scaled`.
pkg enum Amode derives Copy, Eq {
    Imm(base: machinst::Reg, disp: i32)
    Reg(base: machinst::Reg, index: machinst::Reg, scaled: bool)
} Amode

/// `[base, #disp]`.
pkg fn Amode.at(base: machinst::Reg, disp: i32) -> Amode = Amode.Imm(base: base, disp: disp)

/// The operand `disp` bytes further on, when it is a displacement operand.
pkg fn Amode.offset(self, disp: i32) -> Amode {
    return match self {
        Amode.Imm(base: base, disp: at) => Amode.Imm(base: base, disp: at.wrapping_add(disp))
        Amode.Reg(base: _, index: _, scaled: _) => self
    }
} Amode.offset
