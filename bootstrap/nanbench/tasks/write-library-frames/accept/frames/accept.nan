//! Acceptance tests of frame decoding.

test valid_frames_give_their_payload for decode_frame {
    let urgent_frame = attempt decode_frame(Untrusted.of(b"\x01\x03\x00\x02AB\x89"))
    expect urgent_frame == Ok(Frame(urgent: true, start: 4, length: 2))
    let plain_frame = attempt decode_frame(Untrusted.of(b"\x01\x02\x00\x00\x03"))
    expect plain_frame == Ok(Frame(urgent: false, start: 4, length: 0))
} valid_frames_give_their_payload

test checksums_wrap_and_lengths_are_big_endian for decode_frame {
    let wrapped_frame = attempt decode_frame(Untrusted.of(b"\x01\x00\x00\x02\xFF\xFF\x01"))
    expect wrapped_frame == Ok(Frame(urgent: false, start: 4, length: 2))
    var long_bytes = Array[u8, 261].filled(0)
    long_bytes[0] = 1
    long_bytes[2] = 1
    long_bytes[260] = 2
    let long_frame = attempt decode_frame(Untrusted.of(long_bytes.view()))
    expect long_frame == Ok(Frame(urgent: false, start: 4, length: 256))
} checksums_wrap_and_lengths_are_big_endian

test malformed_frames_are_refused for decode_frame {
    let short_frame = attempt decode_frame(Untrusted.of(b"\x01\x00\x00"))
    expect short_frame == Err(FrameError.Truncated)
    let foreign_frame = attempt decode_frame(Untrusted.of(b"\x02\x00\x00\x00\x02"))
    expect foreign_frame == Err(FrameError.BadVersion(2))
    let unsummed_frame = attempt decode_frame(Untrusted.of(b"\x01\x00\x00\x02AB"))
    expect unsummed_frame == Err(FrameError.Truncated)
    let padded_frame = attempt decode_frame(Untrusted.of(b"\x01\x00\x00\x02AB\x86\x00"))
    expect padded_frame == Err(FrameError.Trailing)
    let corrupt_frame = attempt decode_frame(Untrusted.of(b"\x01\x00\x00\x02AB\x87"))
    expect corrupt_frame == Err(FrameError.BadChecksum)
} malformed_frames_are_refused
