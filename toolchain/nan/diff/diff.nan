//! Merging two versions of a list of lines.

/// The lines of `old` and `new` merged along their longest common subsequence of lines whose old,
/// then new, line numbers are least in lexicographic order: kept lines prefixed with 2 spaces,
/// removed ones `- ` and added ones `+ `, removals first.
pkg fn merged(old: Slice[text::String], new: Slice[text::String], alloc: mem::Alloc) -> mem::List[text::String] {
    let width = new.len() + 1
    var longest = mem::List[usize].empty(alloc)
    while longest.len() < (old.len() + 1) * width {
        mut longest.push(0)
    }
    var at = old.len()
    while at > 0 {
        at -= 1
        var other = new.len()
        while other > 0 {
            other -= 1
            if old[at].as_str() == new[other].as_str() {
                longest[at * width + other] = longest[(at + 1) * width + other + 1] + 1
            } else {
                let below = longest[(at + 1) * width + other]
                let right = longest[at * width + other + 1]
                if below > right {
                    longest[at * width + other] = below
                } else {
                    longest[at * width + other] = right
                }
            }
        }
    }
    var lines = mem::List[text::String].empty(alloc)
    var from: usize = 0
    var from_new: usize = 0
    loop {
        let next = next_kept(old, new, longest: longest.view(), from, from_new)
        var until = old.len()
        var until_new = new.len()
        match next {
            Some(kept) => {
                until = kept.old
                until_new = kept.new
            }
            None => {}
        }
        for index in from..<until {
            mut lines.push(marked("- ", line: old[index].as_str(), alloc))
        }
        for index in from_new..<until_new {
            mut lines.push(marked("+ ", line: new[index].as_str(), alloc))
        }
        let Some(kept) = next else {
            return lines
        }
        mut lines.push(marked("  ", line: old[kept.old].as_str(), alloc))
        from = kept.old + 1
        from_new = kept.new + 1
    }
} merged

/// A line kept by the merge, by its index in the old and the new lines.
struct Kept derives Copy {
    old: usize
    new: usize
} Kept

/// The next kept line from `from` and `from_new`: the first old line, then the first new line,
/// that are equal and start a longest common subsequence of what remains.
fn next_kept(old: Slice[text::String], new: Slice[text::String], longest: Slice[usize], from: usize, from_new: usize) -> Option[Kept] {
    let width = new.len() + 1
    let remaining = longest[from * width + from_new]
    if remaining == 0 {
        return None
    }
    for index in from..<old.len() {
        for other in from_new..<new.len() {
            if old[index].as_str() == new[other].as_str() and longest[(index + 1) * width + other + 1] + 1 == remaining {
                return Some(Kept(old: index, new: other))
            }
        }
    }
    return None
} next_kept

fn marked(sign: Str, line: Str, alloc: mem::Alloc) -> text::String {
    var written = text::String.of(sign, alloc)
    mut written.append(line)
    return written
} marked
