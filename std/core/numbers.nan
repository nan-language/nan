    example (-2i16).saturating_mul(3) == -6
{
    let product = self.overflowing_mul(other)
    if not product.overflowed {
        return product.value
    }
    if (self < 0) == (other < 0) {
        return 32_767
    }
    return -32_768
} i16.saturating_mul

