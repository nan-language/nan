pkgname=nan-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='The NaN toolchain, built by itself'
arch=('x86_64' 'aarch64')
url='https://github.com/nan-language/nan'
license=('Apache-2.0 WITH LLVM-exception')
depends=('glibc')
optdepends=('gcc: link programs for the host target'
            'qemu-system-x86: run and test programs for the x86_64 uefi and bare targets'
            'qemu-system-aarch64: run and test programs for the aarch64 uefi and bare targets'
            'edk2-ovmf: run and test programs for the x86_64-uefi target'
            'edk2-aarch64: run and test programs for the aarch64-uefi target')
optdepends_x86_64=('aarch64-linux-gnu-gcc: link programs for the aarch64-host target')
provides=('nan')
conflicts=('nan')
options=('!strip' '!debug')
source=("LICENSE-v$pkgver::$url/raw/v$pkgver/LICENSE")
source_x86_64=("$url/releases/download/v$pkgver/nan-v$pkgver-x86_64-linux")
source_aarch64=("$url/releases/download/v$pkgver/nan-v$pkgver-aarch64-linux")
sha256sums=('@SHA256_LICENSE@')
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
    install -Dm755 "nan-v$pkgver-$CARCH-linux" "$pkgdir/usr/bin/nan"
    install -Dm644 "LICENSE-v$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
