//! Tests of the encoder: each instruction's bytes against those GNU `as` gives for it, and the labels and relocations of encoded code.

/// The bytes an instruction encodes as on its own.
fn encoded(inst: Inst, alloc: mem::Alloc) -> mem::Bytes {
    var asm = Assembler.new(alloc)
    mut asm.emit(inst)
    let code = take asm.finish()
    let Encoded(bytes: bytes, relocs: _) = code
    return bytes
} encoded

/// Expects an instruction alone to encode as `expected`.
fn encodes_as(inst: Inst, expected: Slice[u8], alloc: mem::Alloc) {
    let bytes = encoded(inst, alloc)
    expect bytes.view() == expected
} encodes_as

test encodes_moves_and_memory_operands_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.Mov(dst: RAX, src: RBX), expected: b"\x48\x89\xd8", alloc)
    encodes_as(Inst.Mov(dst: R12, src: RSP), expected: b"\x49\x89\xe4", alloc)
    encodes_as(Inst.Mov(dst: RDI, src: R15), expected: b"\x4c\x89\xff", alloc)
    encodes_as(Inst.Mov(dst: Reg.xmm(1), src: Reg.xmm(9)), expected: b"\x41\x0f\x28\xc9", alloc)
    encodes_as(Inst.Mov(dst: Reg.xmm(15), src: Reg.xmm(0)), expected: b"\x44\x0f\x28\xf8", alloc)
    encodes_as(Inst.MovImm(dst: RAX, imm: 1), expected: b"\xb8\x01\x00\x00\x00", alloc)
    encodes_as(Inst.MovImm(dst: R9, imm: 0xFFFF_FFFF), expected: b"\x41\xb9\xff\xff\xff\xff", alloc)
    encodes_as(Inst.MovImm(dst: RCX, imm: 0xFFFF_FFFF_FFFF_FFFF), expected: b"\x48\xc7\xc1\xff\xff\xff\xff", alloc)
    encodes_as(Inst.MovImm(dst: RDX, imm: 0xFFFF_FFFF_8000_0000), expected: b"\x48\xc7\xc2\x00\x00\x00\x80", alloc)
    encodes_as(Inst.MovImm(dst: R10, imm: 0x1_2345_6789), expected: b"\x49\xba\x89\x67\x45\x23\x01\x00\x00\x00", alloc)
    encodes_as(Inst.MovImm(dst: R15, imm: 0x8000_0000_0000_0000), expected: b"\x49\xbf\x00\x00\x00\x00\x00\x00\x00\x80", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Qword, dst: RAX, src: Amode.at(RBX, disp: 0)), expected: b"\x48\x8b\x03", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Qword, dst: R8, src: Amode.at(RSP, disp: 8)), expected: b"\x4c\x8b\x44\x24\x08", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Qword, dst: RAX, src: Amode.at(RBP, disp: 0)), expected: b"\x48\x8b\x45\x00", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Qword, dst: RAX, src: Amode.at(R13, disp: 4096)), expected: b"\x49\x8b\x85\x00\x10\x00\x00", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Qword, dst: RSI, src: Amode.at(R12, disp: -8)), expected: b"\x49\x8b\x74\x24\xf8", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Dword, dst: RCX, src: Amode.Mem(base: RDX, index: Some(RSI), shift: 2, disp: 16)), expected: b"\x8b\x4c\xb2\x10", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Zx8, dst: RSI, src: Amode.at(RDI, disp: 0)), expected: b"\x0f\xb6\x37", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Zx16, dst: R11, src: Amode.Mem(base: R14, index: Some(R15), shift: 1, disp: -300)), expected: b"\x47\x0f\xb7\x9c\x7e\xd4\xfe\xff\xff", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Zx8, dst: RAX, src: Amode.Mem(base: RSP, index: Some(R12), shift: 0, disp: 0)), expected: b"\x42\x0f\xb6\x04\x24", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Float32, dst: Reg.xmm(2), src: Amode.at(RAX, disp: 4)), expected: b"\xf3\x0f\x10\x50\x04", alloc)
    encodes_as(Inst.Load(kind: LoadKind.Float64, dst: Reg.xmm(10), src: Amode.at(RSP, disp: 512)), expected: b"\xf2\x44\x0f\x10\x94\x24\x00\x02\x00\x00", alloc)
    encodes_as(Inst.Store(size: Size.Byte, src: RSI, dst: Amode.at(RAX, disp: 0)), expected: b"\x40\x88\x30", alloc)
    encodes_as(Inst.Store(size: Size.Byte, src: RAX, dst: Amode.at(R9, disp: 1)), expected: b"\x41\x88\x41\x01", alloc)
    encodes_as(Inst.Store(size: Size.Word, src: RCX, dst: Amode.at(RBX, disp: 0)), expected: b"\x66\x89\x0b", alloc)
    encodes_as(Inst.Store(size: Size.Dword, src: R10, dst: Amode.at(RSP, disp: 0)), expected: b"\x44\x89\x14\x24", alloc)
    encodes_as(Inst.Store(size: Size.Qword, src: RBP, dst: Amode.at(RBP, disp: -16)), expected: b"\x48\x89\x6d\xf0", alloc)
    encodes_as(Inst.Store(size: Size.Dword, src: Reg.xmm(3), dst: Amode.at(RCX, disp: 0)), expected: b"\xf3\x0f\x11\x19", alloc)
    encodes_as(Inst.Store(size: Size.Qword, src: Reg.xmm(12), dst: Amode.at(R13, disp: 0)), expected: b"\xf2\x45\x0f\x11\x65\x00", alloc)
    encodes_as(Inst.StoreImm(size: Size.Byte, imm: 127, dst: Amode.at(RAX, disp: 0)), expected: b"\xc6\x00\x7f", alloc)
    encodes_as(Inst.StoreImm(size: Size.Word, imm: 1000, dst: Amode.at(RBX, disp: 2)), expected: b"\x66\xc7\x43\x02\xe8\x03", alloc)
    encodes_as(Inst.StoreImm(size: Size.Dword, imm: 0, dst: Amode.at(RSP, disp: 0)), expected: b"\xc7\x04\x24\x00\x00\x00\x00", alloc)
    encodes_as(Inst.StoreImm(size: Size.Qword, imm: -1, dst: Amode.at(R12, disp: 8)), expected: b"\x49\xc7\x44\x24\x08\xff\xff\xff\xff", alloc)
    encodes_as(Inst.Lea(dst: RAX, src: Amode.Mem(base: RBX, index: Some(RCX), shift: 0, disp: 0)), expected: b"\x48\x8d\x04\x0b", alloc)
    encodes_as(Inst.Lea(dst: R13, src: Amode.at(RSP, disp: 64)), expected: b"\x4c\x8d\x6c\x24\x40", alloc)
    encodes_as(Inst.Lea(dst: RDI, src: Amode.Mem(base: R8, index: Some(R9), shift: 3, disp: -1)), expected: b"\x4b\x8d\x7c\xc8\xff", alloc)
    encodes_as(Inst.Lea(dst: RAX, src: Amode.Mem(base: R13, index: Some(RAX), shift: 0, disp: 0)), expected: b"\x49\x8d\x44\x05\x00", alloc)
} encodes_moves_and_memory_operands_as_gnu_as_does

test encodes_arithmetic_and_logic_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.Alu(op: AluOp.Add, size: Size.Qword, dst: RAX, src: RBX), expected: b"\x48\x01\xd8", alloc)
    encodes_as(Inst.Alu(op: AluOp.Sub, size: Size.Dword, dst: R8, src: R9), expected: b"\x45\x29\xc8", alloc)
    encodes_as(Inst.Alu(op: AluOp.And, size: Size.Byte, dst: RSI, src: RDI), expected: b"\x40\x20\xfe", alloc)
    encodes_as(Inst.Alu(op: AluOp.Or, size: Size.Word, dst: RAX, src: R12), expected: b"\x66\x44\x09\xe0", alloc)
    encodes_as(Inst.Alu(op: AluOp.Xor, size: Size.Dword, dst: RDX, src: RDX), expected: b"\x31\xd2", alloc)
    encodes_as(Inst.Alu(op: AluOp.Adc, size: Size.Qword, dst: R15, src: RAX), expected: b"\x49\x11\xc7", alloc)
    encodes_as(Inst.Alu(op: AluOp.Sbb, size: Size.Qword, dst: RCX, src: R11), expected: b"\x4c\x19\xd9", alloc)
    encodes_as(Inst.AluImm(op: AluOp.Add, size: Size.Qword, dst: RAX, imm: 1000), expected: b"\x48\x05\xe8\x03\x00\x00", alloc)
    encodes_as(Inst.AluImm(op: AluOp.Add, size: Size.Qword, dst: RCX, imm: 1000), expected: b"\x48\x81\xc1\xe8\x03\x00\x00", alloc)
    encodes_as(Inst.AluImm(op: AluOp.Sub, size: Size.Qword, dst: RSP, imm: 8), expected: b"\x48\x83\xec\x08", alloc)
    encodes_as(Inst.AluImm(op: AluOp.And, size: Size.Dword, dst: RAX, imm: -16), expected: b"\x83\xe0\xf0", alloc)
    encodes_as(Inst.AluImm(op: AluOp.Or, size: Size.Byte, dst: RAX, imm: 1), expected: b"\x0c\x01", alloc)
    encodes_as(Inst.AluImm(op: AluOp.Xor, size: Size.Byte, dst: RDI, imm: -128), expected: b"\x40\x80\xf7\x80", alloc)
    encodes_as(Inst.AluImm(op: AluOp.Sub, size: Size.Word, dst: RAX, imm: 1000), expected: b"\x66\x2d\xe8\x03", alloc)
    encodes_as(Inst.AluImm(op: AluOp.Adc, size: Size.Qword, dst: R8, imm: 0), expected: b"\x49\x83\xd0\x00", alloc)
    encodes_as(Inst.Cmp(size: Size.Qword, lhs: RAX, rhs: RBX), expected: b"\x48\x39\xd8", alloc)
    encodes_as(Inst.Cmp(size: Size.Byte, lhs: RCX, rhs: RSI), expected: b"\x40\x38\xf1", alloc)
    encodes_as(Inst.CmpImm(size: Size.Dword, lhs: R10, imm: 100000), expected: b"\x41\x81\xfa\xa0\x86\x01\x00", alloc)
    encodes_as(Inst.CmpImm(size: Size.Qword, lhs: RAX, imm: -1), expected: b"\x48\x83\xf8\xff", alloc)
    encodes_as(Inst.CmpImm(size: Size.Word, lhs: RDX, imm: -1), expected: b"\x66\x83\xfa\xff", alloc)
    encodes_as(Inst.Test(size: Size.Byte, lhs: RAX, rhs: RAX), expected: b"\x84\xc0", alloc)
    encodes_as(Inst.Test(size: Size.Qword, lhs: R9, rhs: R9), expected: b"\x4d\x85\xc9", alloc)
    encodes_as(Inst.Unary(op: UnaryOp.Neg, size: Size.Qword, reg: RAX), expected: b"\x48\xf7\xd8", alloc)
    encodes_as(Inst.Unary(op: UnaryOp.Not, size: Size.Dword, reg: R12), expected: b"\x41\xf7\xd4", alloc)
    encodes_as(Inst.Unary(op: UnaryOp.Neg, size: Size.Byte, reg: RSI), expected: b"\x40\xf6\xde", alloc)
    encodes_as(Inst.Imul(size: Size.Qword, dst: RAX, src: R10), expected: b"\x49\x0f\xaf\xc2", alloc)
    encodes_as(Inst.Imul(size: Size.Word, dst: RCX, src: RDX), expected: b"\x66\x0f\xaf\xca", alloc)
    encodes_as(Inst.ImulImm(size: Size.Dword, dst: RAX, src: RBX, imm: 10), expected: b"\x6b\xc3\x0a", alloc)
    encodes_as(Inst.ImulImm(size: Size.Qword, dst: R8, src: R9, imm: 1000), expected: b"\x4d\x69\xc1\xe8\x03\x00\x00", alloc)
    encodes_as(Inst.MulWide(signed: false, size: Size.Qword, src: RCX), expected: b"\x48\xf7\xe1", alloc)
    encodes_as(Inst.MulWide(signed: true, size: Size.Byte, src: RBX), expected: b"\xf6\xeb", alloc)
    encodes_as(Inst.Div(signed: false, size: Size.Dword, divisor: RSI), expected: b"\xf7\xf6", alloc)
    encodes_as(Inst.Div(signed: true, size: Size.Qword, divisor: R11), expected: b"\x49\xf7\xfb", alloc)
    encodes_as(Inst.SignExtendData(size: Size.Qword), expected: b"\x48\x99", alloc)
    encodes_as(Inst.SignExtendData(size: Size.Dword), expected: b"\x99", alloc)
    encodes_as(Inst.SignExtendData(size: Size.Word), expected: b"\x66\x99", alloc)
    encodes_as(Inst.SignExtendData(size: Size.Byte), expected: b"\x66\x98", alloc)
} encodes_arithmetic_and_logic_as_gnu_as_does

test encodes_shifts_flags_and_extensions_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.Shift(op: ShiftOp.Shl, size: Size.Qword, dst: RAX, amount: 1), expected: b"\x48\xd1\xe0", alloc)
    encodes_as(Inst.Shift(op: ShiftOp.Shr, size: Size.Dword, dst: RCX, amount: 4), expected: b"\xc1\xe9\x04", alloc)
    encodes_as(Inst.Shift(op: ShiftOp.Sar, size: Size.Qword, dst: R13, amount: 63), expected: b"\x49\xc1\xfd\x3f", alloc)
    encodes_as(Inst.Shift(op: ShiftOp.Rol, size: Size.Word, dst: RDX, amount: 8), expected: b"\x66\xc1\xc2\x08", alloc)
    encodes_as(Inst.Shift(op: ShiftOp.Ror, size: Size.Qword, dst: RAX, amount: 13), expected: b"\x48\xc1\xc8\x0d", alloc)
    encodes_as(Inst.Shift(op: ShiftOp.Shr, size: Size.Byte, dst: RSI, amount: 3), expected: b"\x40\xc0\xee\x03", alloc)
    encodes_as(Inst.ShiftCl(op: ShiftOp.Shl, size: Size.Qword, dst: RBX), expected: b"\x48\xd3\xe3", alloc)
    encodes_as(Inst.ShiftCl(op: ShiftOp.Sar, size: Size.Byte, dst: RDI), expected: b"\x40\xd2\xff", alloc)
    encodes_as(Inst.Setcc(cond: Cond.Equal, dst: RAX), expected: b"\x0f\x94\xc0", alloc)
    encodes_as(Inst.Setcc(cond: Cond.Below, dst: RSI), expected: b"\x40\x0f\x92\xc6", alloc)
    encodes_as(Inst.Setcc(cond: Cond.Greater, dst: R9), expected: b"\x41\x0f\x9f\xc1", alloc)
    encodes_as(Inst.Setcc(cond: Cond.Parity, dst: RCX), expected: b"\x0f\x9a\xc1", alloc)
    encodes_as(Inst.Cmov(cond: Cond.NotEqual, size: Size.Qword, dst: RAX, src: RBX), expected: b"\x48\x0f\x45\xc3", alloc)
    encodes_as(Inst.Cmov(cond: Cond.Less, size: Size.Dword, dst: R8, src: RCX), expected: b"\x44\x0f\x4c\xc1", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Zx8, dst: RAX, src: RSI), expected: b"\x40\x0f\xb6\xc6", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Zx8, dst: RSI, src: RAX), expected: b"\x0f\xb6\xf0", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Zx16, dst: R9, src: RDX), expected: b"\x44\x0f\xb7\xca", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Zx32, dst: RAX, src: R10), expected: b"\x44\x89\xd0", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Sx8, dst: RAX, src: RDI), expected: b"\x48\x0f\xbe\xc7", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Sx16, dst: RBX, src: RCX), expected: b"\x48\x0f\xbf\xd9", alloc)
    encodes_as(Inst.Extend(kind: ExtendKind.Sx32, dst: R12, src: RAX), expected: b"\x4c\x63\xe0", alloc)
    encodes_as(Inst.BitScan(reverse: true, size: Size.Qword, dst: RAX, src: RBX), expected: b"\x48\x0f\xbd\xc3", alloc)
    encodes_as(Inst.BitScan(reverse: false, size: Size.Dword, dst: RCX, src: R8), expected: b"\x41\x0f\xbc\xc8", alloc)
    encodes_as(Inst.Bswap(size: Size.Qword, reg: RAX), expected: b"\x48\x0f\xc8", alloc)
    encodes_as(Inst.Bswap(size: Size.Dword, reg: R9), expected: b"\x41\x0f\xc9", alloc)
} encodes_shifts_flags_and_extensions_as_gnu_as_does

test encodes_atomics_calls_and_sse_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.LockXadd(size: Size.Qword, reg: RAX, mem: Amode.at(RBX, disp: 0)), expected: b"\xf0\x48\x0f\xc1\x03", alloc)
    encodes_as(Inst.LockXadd(size: Size.Word, reg: RAX, mem: Amode.at(RBX, disp: 0)), expected: b"\x66\xf0\x0f\xc1\x03", alloc)
    encodes_as(Inst.LockXadd(size: Size.Byte, reg: RSI, mem: Amode.at(RDI, disp: 0)), expected: b"\xf0\x40\x0f\xc0\x37", alloc)
    encodes_as(Inst.Xchg(size: Size.Dword, reg: RCX, mem: Amode.at(RDX, disp: 4)), expected: b"\x87\x4a\x04", alloc)
    encodes_as(Inst.Xchg(size: Size.Byte, reg: RSI, mem: Amode.at(RBX, disp: 0)), expected: b"\x40\x86\x33", alloc)
    encodes_as(Inst.LockCmpxchg(size: Size.Qword, replacement: R8, mem: Amode.at(R9, disp: 0)), expected: b"\xf0\x4d\x0f\xb1\x01", alloc)
    encodes_as(Inst.LockCmpxchg(size: Size.Byte, replacement: RCX, mem: Amode.at(RAX, disp: 0)), expected: b"\xf0\x0f\xb0\x08", alloc)
    encodes_as(Inst.Mfence, expected: b"\x0f\xae\xf0", alloc)
    encodes_as(Inst.Ud2, expected: b"\x0f\x0b", alloc)
    encodes_as(Inst.Call(target: CallTarget.Indirect(RAX), args: RegSet.empty(), results: RegSet.empty(), clobbers: RegSet.empty()), expected: b"\xff\xd0", alloc)
    encodes_as(Inst.Call(target: CallTarget.Indirect(R11), args: RegSet.empty(), results: RegSet.empty(), clobbers: RegSet.empty()), expected: b"\x41\xff\xd3", alloc)
    encodes_as(Inst.Push(reg: RBP), expected: b"\x55", alloc)
    encodes_as(Inst.Push(reg: R12), expected: b"\x41\x54", alloc)
    encodes_as(Inst.Pop(reg: R15), expected: b"\x41\x5f", alloc)
    encodes_as(Inst.Ret(results: RegSet.empty()), expected: b"\xc3", alloc)
    encodes_as(Inst.FloatArith(op: FloatOp.Add, size: Size.Qword, dst: Reg.xmm(0), src: Reg.xmm(1)), expected: b"\xf2\x0f\x58\xc1", alloc)
    encodes_as(Inst.FloatArith(op: FloatOp.Sub, size: Size.Dword, dst: Reg.xmm(8), src: Reg.xmm(2)), expected: b"\xf3\x44\x0f\x5c\xc2", alloc)
    encodes_as(Inst.FloatArith(op: FloatOp.Mul, size: Size.Qword, dst: Reg.xmm(3), src: Reg.xmm(15)), expected: b"\xf2\x41\x0f\x59\xdf", alloc)
    encodes_as(Inst.FloatArith(op: FloatOp.Div, size: Size.Dword, dst: Reg.xmm(4), src: Reg.xmm(5)), expected: b"\xf3\x0f\x5e\xe5", alloc)
    encodes_as(Inst.FloatSqrt(size: Size.Qword, dst: Reg.xmm(1), src: Reg.xmm(2)), expected: b"\xf2\x0f\x51\xca", alloc)
    encodes_as(Inst.FloatConvert(source: Size.Dword, dst: Reg.xmm(0), src: Reg.xmm(1)), expected: b"\xf3\x0f\x5a\xc1", alloc)
    encodes_as(Inst.FloatConvert(source: Size.Qword, dst: Reg.xmm(9), src: Reg.xmm(9)), expected: b"\xf2\x45\x0f\x5a\xc9", alloc)
    encodes_as(Inst.FloatBits(op: BitOp.And, dst: Reg.xmm(0), src: Reg.xmm(1)), expected: b"\x0f\x54\xc1", alloc)
    encodes_as(Inst.FloatBits(op: BitOp.AndNot, dst: Reg.xmm(2), src: Reg.xmm(10)), expected: b"\x41\x0f\x55\xd2", alloc)
    encodes_as(Inst.FloatBits(op: BitOp.Or, dst: Reg.xmm(3), src: Reg.xmm(4)), expected: b"\x0f\x56\xdc", alloc)
    encodes_as(Inst.FloatBits(op: BitOp.Xor, dst: Reg.xmm(15), src: Reg.xmm(15)), expected: b"\x45\x0f\x57\xff", alloc)
    encodes_as(Inst.Ucomis(size: Size.Qword, lhs: Reg.xmm(0), rhs: Reg.xmm(1)), expected: b"\x66\x0f\x2e\xc1", alloc)
    encodes_as(Inst.Ucomis(size: Size.Dword, lhs: Reg.xmm(12), rhs: Reg.xmm(3)), expected: b"\x44\x0f\x2e\xe3", alloc)
    encodes_as(Inst.CvtIntToFloat(int_size: Size.Qword, size: Size.Qword, dst: Reg.xmm(0), src: RAX), expected: b"\xf2\x48\x0f\x2a\xc0", alloc)
    encodes_as(Inst.CvtIntToFloat(int_size: Size.Dword, size: Size.Dword, dst: Reg.xmm(1), src: R9), expected: b"\xf3\x41\x0f\x2a\xc9", alloc)
    encodes_as(Inst.CvtFloatToInt(size: Size.Qword, int_size: Size.Qword, dst: RAX, src: Reg.xmm(1)), expected: b"\xf2\x48\x0f\x2c\xc1", alloc)
    encodes_as(Inst.CvtFloatToInt(size: Size.Dword, int_size: Size.Dword, dst: R10, src: Reg.xmm(8)), expected: b"\xf3\x45\x0f\x2c\xd0", alloc)
    encodes_as(Inst.MovToXmm(size: Size.Qword, dst: Reg.xmm(0), src: RAX), expected: b"\x66\x48\x0f\x6e\xc0", alloc)
    encodes_as(Inst.MovToXmm(size: Size.Dword, dst: Reg.xmm(9), src: R12), expected: b"\x66\x45\x0f\x6e\xcc", alloc)
    encodes_as(Inst.MovFromXmm(size: Size.Qword, dst: RCX, src: Reg.xmm(2)), expected: b"\x66\x48\x0f\x7e\xd1", alloc)
    encodes_as(Inst.MovFromXmm(size: Size.Dword, dst: RAX, src: Reg.xmm(15)), expected: b"\x66\x44\x0f\x7e\xf8", alloc)
} encodes_atomics_calls_and_sse_as_gnu_as_does

test encodes_sequences_as_gnu_as_does for Assembler.emit {
    let alloc = testing::world().alloc
    encodes_as(Inst.CheckedSrem(size: Size.Qword, divisor: RCX), expected: b"\x48\x83\xf9\xff\x75\x04\x31\xd2\xeb\x03\x48\xf7\xf9", alloc)
    encodes_as(Inst.CanonNan(size: Size.Qword, reg: Reg.xmm(3), temp: R11), expected: b"\x66\x0f\x2e\xdb\x7b\x0f\x49\xbb\x00\x00\x00\x00\x00\x00\xf8\x7f\x66\x49\x0f\x6e\xdb", alloc)
    encodes_as(Inst.CanonNan(size: Size.Dword, reg: Reg.xmm(0), temp: RAX), expected: b"\x0f\x2e\xc0\x7b\x09\xb8\x00\x00\xc0\x7f\x66\x0f\x6e\xc0", alloc)
    encodes_as(Inst.XmmCmov(cond: Cond.Equal, dst: Reg.xmm(1), src: Reg.xmm(2)), expected: b"\x75\x03\x0f\x28\xca", alloc)
    encodes_as(Inst.UintToFloat(size: Size.Qword, dst: Reg.xmm(0), src: RDI, temp: RAX), expected: b"\x48\x85\xff\x78\x07\xf2\x48\x0f\x2a\xc7\xeb\x15\x48\x89\xf8\x48\xd1\xe8\x73\x04\x48\x83\xc8\x01\xf2\x48\x0f\x2a\xc0\xf2\x0f\x58\xc0", alloc)
    encodes_as(Inst.FloatToIntSat(signed: true, size: Size.Qword, dst: RAX, src: Reg.xmm(0), temp: Reg.xmm(1)), expected: b"\xf2\x48\x0f\x2c\xc0\x48\x83\xf8\x01\x71\x1d\x66\x0f\x2e\xc0\x7b\x04\x31\xc0\xeb\x13\x0f\x57\xc9\x66\x0f\x2e\xc8\x73\x0a\x48\xb8\xff\xff\xff\xff\xff\xff\xff\x7f", alloc)
    encodes_as(Inst.FloatToIntSat(signed: false, size: Size.Dword, dst: RCX, src: Reg.xmm(2), temp: Reg.xmm(3)), expected: b"\xb9\x00\x00\x00\x5f\x66\x0f\x6e\xd9\x0f\x2e\xd3\x73\x15\x7b\x04\x31\xc9\xeb\x35\xf3\x48\x0f\x2c\xca\x48\x83\xf9\x00\x7d\x2a\x31\xc9\xeb\x26\xb9\x00\x00\x00\xdf\x66\x0f\x6e\xd9\xf3\x0f\x58\xda\xf3\x48\x0f\x2c\xcb\x48\x83\xf9\x00\x7d\x09\x48\xc7\xc1\xff\xff\xff\xff\xeb\x05\x48\x0f\xba\xe9\x3f", alloc)
    encodes_as(Inst.AtomicRmwLoop(op: AluOp.And, size: Size.Qword, operand: RSI, mem: Amode.at(RDI, disp: 0), temp: RCX), expected: b"\x48\x8b\x07\x48\x89\xc1\x48\x21\xf1\xf0\x48\x0f\xb1\x0f\x75\xf3", alloc)
    encodes_as(Inst.AtomicRmwLoop(op: AluOp.Or, size: Size.Byte, operand: RDX, mem: Amode.at(RBX, disp: 1), temp: RCX), expected: b"\x0f\xb6\x43\x01\x48\x89\xc1\x09\xd1\xf0\x0f\xb0\x4b\x01\x75\xf4", alloc)
    encodes_as(Inst.StackSwitch(store: RSI, load: RDX, temp: RAX, other: RCX), expected: b"\x48\x8b\x02\x48\x89\x26\x48\x89\xc4\x48\x8b\x42\x08\x48\x89\x6e\x08\x48\x89\xc5\x48\x8b\x42\x10\x48\x8d\x0d\x06\x00\x00\x00\x48\x89\x4e\x10\xff\xe0", alloc)
} encodes_sequences_as_gnu_as_does


test binds_labels_and_records_relocations for Assembler.finish {
    let alloc = testing::world().alloc
    let callee = Symbol.Name(clif::ExternalName(namespace: 0, index: 7))
    let data = Symbol.Name(clif::ExternalName(namespace: 1, index: 2))
    var asm = Assembler.new(alloc)
    let back = mut asm.new_label()
    let ahead = mut asm.new_label()
    mut asm.bind(back)
    mut asm.emit(Inst.Jcc(cond: Cond.Equal, label: ahead))
    mut asm.emit(Inst.Jmp(label: back))
    mut asm.emit(Inst.Lea(dst: RAX, src: Amode.Rip(target: RipTarget.Label(ahead), disp: 0)))
    mut asm.bind(ahead)
    mut asm.emit(Inst.Call(target: CallTarget.Direct(symbol: callee, kind: RelocKind.CallPlt4), args: RegSet.empty(), results: RegSet.empty(), clobbers: RegSet.empty()))
    mut asm.emit(Inst.Load(kind: LoadKind.Qword, dst: RCX, src: Amode.Rip(target: RipTarget.Got(data), disp: 0)))
    mut asm.emit(Inst.StoreImm(size: Size.Dword, imm: 5, dst: Amode.Rip(target: RipTarget.Direct(data), disp: 8)))
    mut asm.emit(Inst.TlsGetAddr(symbol: data))
    mut asm.emit(Inst.MovSymbol(dst: R9, symbol: callee, addend: 16))
    let code = take asm.finish()
    expect code.bytes.view() == b"\x0f\x84\x0c\x00\x00\x00\xe9\xf5\xff\xff\xff\x48\x8d\x05\x00\x00\x00\x00\xe8\x00\x00\x00\x00\x48\x8b\x0d\x00\x00\x00\x00\xc7\x05\x00\x00\x00\x00\x05\x00\x00\x00\x66\x48\x8d\x3d\x00\x00\x00\x00\x66\x66\x48\xe8\x00\x00\x00\x00\x49\xb9\x00\x00\x00\x00\x00\x00\x00\x00"
    expect code.relocs.len() == 6
    expect code.relocs[0] == Reloc(offset: 19, kind: RelocKind.CallPlt4, target: callee, addend: -4)
    expect code.relocs[1] == Reloc(offset: 26, kind: RelocKind.GotRelative4, target: data, addend: -4)
    expect code.relocs[2] == Reloc(offset: 32, kind: RelocKind.Relative4, target: data, addend: 0)
    expect code.relocs[3] == Reloc(offset: 44, kind: RelocKind.TlsGeneralDynamic, target: data, addend: -4)
    expect code.relocs[4] == Reloc(offset: 52, kind: RelocKind.CallPlt4, target: Symbol.TlsGetAddr, addend: -4)
    expect code.relocs[5] == Reloc(offset: 58, kind: RelocKind.Absolute8, target: callee, addend: 16)
} binds_labels_and_records_relocations

/// The registers an instruction names and how, in the order it visits them.
fn accesses(inst: Inst, alloc: mem::Alloc) -> mem::List[Access] {
    var found = mem::List[Access].empty(alloc)
    discard inst.map_regs(fn[mut found](reg: Reg, role: Role) -> Reg {
        mut found.push(Access(reg: reg, role: role))
        return reg
    })
    return found
} accesses

struct Access derives Copy, Eq {
    reg: Reg
    role: Role
} Access

test reports_operands_and_implicit_registers_and_rewrites_operands for Inst.map_regs {
    let alloc = testing::world().alloc
    let vreg_a = Reg.virtual_number(0)
    let vreg_b = Reg.virtual_number(1)
    let division = accesses(Inst.Div(signed: true, size: Size.Qword, divisor: vreg_a), alloc)
    expect division.len() == 3
    expect division[0] == Access(reg: vreg_a, role: Role.Use)
    expect division[1] == Access(reg: RAX, role: Role.Mod)
    expect division[2] == Access(reg: RDX, role: Role.Mod)
    let load = accesses(Inst.Load(kind: LoadKind.Qword, dst: vreg_a, src: Amode.Mem(base: vreg_b, index: Some(R9), shift: 3, disp: 8)), alloc)
    expect load.len() == 3
    expect load[0] == Access(reg: vreg_a, role: Role.Def)
    expect load[1] == Access(reg: vreg_b, role: Role.Use)
    expect load[2] == Access(reg: R9, role: Role.Use)
    let call = accesses(Inst.Call(target: CallTarget.Indirect(vreg_a), args: RegSet.of(RDI).plus(RSI), results: RegSet.of(RAX), clobbers: RegSet.caller_saved()), alloc)
    expect call.len() == 4
    expect call[0] == Access(reg: vreg_a, role: Role.Use)
    expect call[1] == Access(reg: RSI, role: Role.Use)
    expect call[2] == Access(reg: RDI, role: Role.Use)
    expect call[3] == Access(reg: RAX, role: Role.Def)
    expect Inst.StackSwitch(store: vreg_a, load: vreg_b, temp: RAX, other: RCX).clobbers() == RegSet.all().minus(RegSet.of(RDI))
    let rewritten = Inst.Alu(op: AluOp.Add, size: Size.Qword, dst: vreg_a, src: vreg_b).map_regs(fn(reg: Reg, role: Role) -> Reg {
        if role == Role.Mod and reg == vreg_a {
            return RBX
        }
        return R12
    })
    expect rewritten == Inst.Alu(op: AluOp.Add, size: Size.Qword, dst: RBX, src: R12)
} reports_operands_and_implicit_registers_and_rewrites_operands
