item "text::construction::Codec.decode"
text "pub fn Codec.decode(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> T fails core::DecodeError"
text "    example attempt Codec[Option[i16]].decode(Untrusted.of(b\" Some(-1_200) \"), alloc: testing::world().alloc) == Ok(Some(-1_200))"
text "    example attempt Codec[mem::List[u8]].decode(Untrusted.of(b\"[1, 2,]\"), alloc: testing::world().alloc) == Err(core::DecodeError.Malformed)"
text "    example attempt Codec[char].decode(Untrusted.of(b\"'\\\\u{D800}'\"), alloc: testing::world().alloc) == Err(core::DecodeError.InvalidText)"
