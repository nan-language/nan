item "text::utf8::char_at"
text "pub fn char_at(bytes: Slice[u8], at: usize) -> Option[char] limits pure, notrap, terminates"
text "    example char_at(b\"\\xC3\\xA9\", at: 0) == Some('é')"
text "    example char_at(b\"\\xC3\\xA9\", at: 1) == None"
text "    example char_at(b\"\\xED\\xA0\\x80\", at: 0) == None"
