item "nan::codegen::is_first"
head "fn is_first(operands: mem::List[Operand], at: usize, read: bool) -> bool"
accepted "requires at < operands.len()"
item "nan::codegen::is_jcc"
head "fn is_jcc(code: VCode[x64::Inst], at: u32, begin: u32) -> bool"
accepted "requires begin <= at and usize.widen(at) < code.insts.len()"
