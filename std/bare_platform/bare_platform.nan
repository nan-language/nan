//! The bare entry landing fn, which mints the kernel root grant, and kernel task preemption.

/// The bare entry landing fn, which mints the kernel root grant. The start information the seam
/// records stands behind that grant: the PVH start information on x86_64 and the device tree on
/// AArch64.
pub landing fn enter(start: usize) -> boot::Kernel limits stack 4_096 {
    discard start
    return hw::mint_root()
} enter

/// Makes the preempted task ready again and switches its CPU to the next ready task, returning
/// once a later switch resumes it.
landing fn preempted() limits stack 1_024 {
    yield_task()
} preempted

/// Switches the CPU from the running kernel task, ready again, to its next ready task.
pkg fn yield_task()

contribute hw::preempt preempt = hw::PreemptEntry(slot: Unit, handler: preempted)
