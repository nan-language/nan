//! Tests of linking objects into images.

/// An object as lowering writes it for a machine target: `entry` calling `callee` through a
/// relocation of the kind given, `table` holding the address of `callee`, then 64 zeroed bytes.
fn machine_object(call: machinst::RelocKind, alloc: mem::Alloc) -> mem::Bytes {
    var module = object::Module.new(workspace::Target.X64Bare, alloc)
    let nullary = clif::Signature.new(clif::CallConv.SystemV, alloc)
    let entry = mut module.declare_function("entry", linkage: object::Linkage.Local, signature: nullary)
    let callee = mut module.declare_function("callee", linkage: object::Linkage.Local, signature: nullary)
    var relocs = mem::List[object::ModuleReloc].empty(alloc)
    mut relocs.push(object::ModuleReloc(offset: 1, kind: call, target: object::RelocTarget.Function(callee), addend: -4))
    mut module.define_function_bytes(entry, align: 16, bytes: b"\xe8\x00\x00\x00\x00\xc3", relocs: relocs.view())
    mut module.define_function_bytes(callee, align: 16, bytes: b"\xc3", relocs: mem::List[object::ModuleReloc].empty(alloc).view())
    var table = object::DataDescription.new(alloc)
    mut table.define(mem::Bytes.zeroed(8, alloc))
    let address = mut table.import_function(callee)
    mut table.write_function_addr(0, function: address)
    var zeroed = object::DataDescription.new(alloc)
    mut zeroed.define_zeroinit(64)
    mut zeroed.set_align(64)
    let table_id = mut module.declare_data("table", linkage: object::Linkage.Local, writable: true, tls: false)
    mut module.define_data(table_id, description: take table)
    let zeroed_id = mut module.declare_data("zeroed", linkage: object::Linkage.Local, writable: true, tls: false)
    mut module.define_data(zeroed_id, description: take zeroed)
    return take module.finish(None, alloc)
} machine_object

test link_patches_relative_and_absolute_addresses_and_counts_zeroed_bytes_in_memory_only for link {
    let alloc = testing::world().alloc
    let base: u64 = 0x0010_0000
    let linked = link(machine_object(machinst::RelocKind.Relative4, alloc).view(), base, alloc)
    expect linked.segments.len() == 2
    let text = linked.segments[0]
    expect text.address == base and text.access == Access.Execute
    var called = mem::Bytes.empty(alloc)
    mut called.append(b"\xe8\x0b\x00\x00\x00\xc3")
    object::resize(mut called, length: 16)
    mut called.push(0xC3)
    expect text.bytes.view() == called.view()
    let data = linked.segments[1]
    expect data.address == base + 0x1000 and data.access == Access.Write and data.size == 128
    var address = mem::Bytes.empty(alloc)
    object::append_u64(mut address, value: base + 16)
    expect data.bytes.view() == address.view()
    expect linked.absolute.len() == 1 and linked.absolute[0] == Absolute(address: base + 0x1000, width: 8)
} link_patches_relative_and_absolute_addresses_and_counts_zeroed_bytes_in_memory_only

test base_relocations_group_addresses_by_page_and_pad_odd_blocks for base_relocations {
    let alloc = testing::world().alloc
    var rvas = mem::List[u64].empty(alloc)
    mut rvas.push(0x1008)
    mut rvas.push(0x1010)
    mut rvas.push(0x1FF8)
    mut rvas.push(0x3000)
    let low = b"\x00\x10\x00\x00\x10\x00\x00\x00\x08\xa0\x10\xa0\xf8\xaf\x00\x00"
    let high = b"\x00\x30\x00\x00\x0c\x00\x00\x00\x00\xa0\x00\x00"
    var expected = mem::Bytes.empty(alloc)
    mut expected.append(low)
    mut expected.append(high)
    let written = base_relocations(rvas.view(), alloc)
    expect written.view() == expected.view()
} base_relocations_group_addresses_by_page_and_pad_odd_blocks

test uefi_images_reject_32_bit_absolute_addresses for pe_write {
    let world = testing::world()
    let alloc = world.alloc
    let relocatable = machine_object(machinst::RelocKind.Absolute4, alloc)
    let outcome = try await sys::Domain.run(fn[take relocatable]() -> usize {
        return write(workspace::Target.X64Uefi, object: relocatable.view(), entry: "entry", alloc).len()
    }, exec: world.exec, alloc)
    let Err(trap) = outcome else {
        expect false
        return
    }
    expect trap.kind() == sys::TrapKind.Expect
} uefi_images_reject_32_bit_absolute_addresses
