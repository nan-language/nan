/// The stub's name, which its symbol ends with.
proj fn Stub.name(self) -> Str
    waive length "one arm per stub"
{
    return match self {
        Stub.Out1 => "Out1"
        Stub.Out2 => "Out2"
        Stub.Out4 => "Out4"
        Stub.In1 => "In1"
        Stub.In2 => "In2"
        Stub.In4 => "In4"
        Stub.MmioRead1 => "MmioRead1"
        Stub.MmioRead2 => "MmioRead2"
        Stub.MmioRead4 => "MmioRead4"
        Stub.MmioRead8 => "MmioRead8"
        Stub.MmioWrite1 => "MmioWrite1"
        Stub.MmioWrite2 => "MmioWrite2"
        Stub.MmioWrite4 => "MmioWrite4"
        Stub.MmioWrite8 => "MmioWrite8"
        Stub.Fill => "Fill"
        Stub.Copy => "Copy"
        Stub.Pause => "Pause"
        Stub.Mfence => "Mfence"
        Stub.IdleWait => "IdleWait"
        Stub.Lidt => "Lidt"
        Stub.Sti => "Sti"
        Stub.Cli => "Cli"
        Stub.IrqSave => "IrqSave"
        Stub.IrqRestore => "IrqRestore"
        Stub.Thread => "Thread"
        Stub.Wrmsr => "Wrmsr"
        Stub.Rdmsr => "Rdmsr"
        Stub.ReadCr2 => "ReadCr2"
        Stub.ReadCr3 => "ReadCr3"
        Stub.WriteCr3 => "WriteCr3"
        Stub.Invlpg => "Invlpg"
        Stub.LoadTables => "LoadTables"
        Stub.EnableAvx => "EnableAvx"
        Stub.GigabytePages => "GigabytePages"
        Stub.ReadTsc => "ReadTsc"
        Stub.ConstantTime => "ConstantTime"
        Stub.CpuFeatures => "CpuFeatures"
        Stub.Cpuid => "Cpuid"
        Stub.Rdtscp => "Rdtscp"
        Stub.Rdrand => "Rdrand"
        Stub.Rdseed => "Rdseed"
        Stub.MonitorWait => "MonitorWait"
        Stub.FlushAll => "FlushAll"
        Stub.Invpcid => "Invpcid"
        Stub.Shootdown => "Shootdown"
        Stub.Cr3Tag => "Cr3Tag"
        Stub.ReadXcr0 => "ReadXcr0"
        Stub.Xgetbv => "Xgetbv"
        Stub.WriteXcr0 => "WriteXcr0"
        Stub.EnableProtection => "EnableProtection"
        Stub.ClearBuffers => "ClearBuffers"
        Stub.UserOpen => "UserOpen"
        Stub.UserClose => "UserClose"
        Stub.Halt => "Halt"
        Stub.DisableFloats => "DisableFloats"
        Stub.SetCpu => "SetCpu"
        Stub.ReadSysReg(_) => "ReadSysReg"
        Stub.WriteSysReg(_) => "WriteSysReg"
        Stub.ReadTtbr0 => "ReadTtbr0"
        Stub.WriteTtbr0 => "WriteTtbr0"
        Stub.WriteTtbr0Tagged => "WriteTtbr0Tagged"
        Stub.TlbiPage => "TlbiPage"
        Stub.TlbiAsid => "TlbiAsid"
        Stub.TlbiAsidPage => "TlbiAsidPage"
        Stub.TlbiAll => "TlbiAll"
        Stub.TlbiBroadcast => "TlbiBroadcast"
        Stub.CleanCache => "CleanCache"
        Stub.CleanInvalidateCache => "CleanInvalidateCache"
