//! Tests of the merge driver.

/// A merged file's text and its number of conflicts.
struct MergedText {
    text: text::String
    conflicts: usize
} MergedText

/// Merges three versions of a file at `path` given as texts.
fn merged_text(path: Str, base: Str, ours: Str, theirs: Str, alloc: mem::Alloc) -> MergedText {
    let grammar = syntax::Grammar.load(alloc)
    let merged = merge(path, base: Some(bytes_of(base, alloc)), ours: Some(bytes_of(ours, alloc)), theirs: Some(bytes_of(theirs, alloc)), grammar, alloc)
    var written = text::String.empty(alloc)
    match merged.content {
        Some(content) => {
            written = output::lossy(content.view(), alloc)
        }
        None => {}
    }
    return MergedText(text: take written, conflicts: merged.conflicts.len())
} merged_text

fn bytes_of(written: Str, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(written.as_bytes())
    return bytes
} bytes_of

test variants_both_sides_add_merge_in_order for merge {
    let alloc = testing::world().alloc
    let base = "//! Signals.\n\npub closed enum Signal {\n    Start\n    Stop\n} Signal\n"
    let ours = "//! Signals.\n\npub closed enum Signal {\n    Start\n    Stop\n    Pause\n} Signal\n"
    let theirs = "//! Signals.\n\npub closed enum Signal {\n    Start\n    Stop\n    Resume\n} Signal\n"
    let merged = merged_text("app/app.nan", base, ours, theirs, alloc)
    expect merged.conflicts == 0
    expect merged.text.as_str() == "//! Signals.\n\npub closed enum Signal {\n    Start\n    Stop\n    Pause\n    Resume\n} Signal\n"
} variants_both_sides_add_merge_in_order

test items_changed_on_one_side_take_that_side_and_others_keep_ours_order for merge {
    let alloc = testing::world().alloc
    let base = "//! Levels.\n\npub fn low() -> u8 = 1\n\npub fn high() -> u8 = 9\n"
    let ours = "//! Levels.\n\npub fn low() -> u8 = 2\n\npub fn high() -> u8 = 9\n\npub fn mid() -> u8 = 5\n"
    let theirs = "//! Levels.\n\npub fn top() -> u8 = 10\n\npub fn low() -> u8 = 1\n\npub fn high() -> u8 = 8\n"
    let merged = merged_text("app/app.nan", base, ours, theirs, alloc)
    expect merged.conflicts == 0
    expect merged.text.as_str() == "//! Levels.\n\npub fn top() -> u8 = 10\n\npub fn low() -> u8 = 2\n\npub fn high() -> u8 = 8\n\npub fn mid() -> u8 = 5\n"
} items_changed_on_one_side_take_that_side_and_others_keep_ours_order

test an_item_both_sides_change_differently_is_a_conflict_block for merge {
    let alloc = testing::world().alloc
    let base = "//! Levels.\n\npub fn low() -> u8 = 1\n"
    let ours = "//! Levels.\n\npub fn low() -> u8 = 2\n"
    let theirs = "//! Levels.\n\npub fn low() -> u8 = 3\n"
    let merged = merged_text("app/app.nan", base, ours, theirs, alloc)
    expect merged.conflicts == 1
    expect merged.text.as_str() == "//! Levels.\n\n<<<<<<< ours\npub fn low() -> u8 = 2\n=======\npub fn low() -> u8 = 3\n>>>>>>> theirs\n"
} an_item_both_sides_change_differently_is_a_conflict_block

test manifest_targets_both_sides_change_merge_as_sets for merge {
    let alloc = testing::world().alloc
    let base = "//! App.\n\npackage app {\n    language 1\n    targets x86_64-host\n} app\n"
    let ours = "//! App.\n\npackage app {\n    language 1\n    targets x86_64-bare, x86_64-host\n} app\n"
    let theirs = "//! App.\n\npackage app {\n    language 1\n    targets x86_64-host, x86_64-uefi\n} app\n"
    let merged = merged_text("app/package.nan", base, ours, theirs, alloc)
    expect merged.conflicts == 0
    expect merged.text.as_str().find("    targets x86_64-bare, x86_64-host, x86_64-uefi\n").is_some()
} manifest_targets_both_sides_change_merge_as_sets
