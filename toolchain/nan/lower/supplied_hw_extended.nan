//! `hw::ExtendedState`, the address of the frame holding its save area: `of` writes the initial state there and `into_frame` gives the frame back, `vector` and `set_vector` read and write a vector register of the saved state, and `with` runs its body with the running task owning that state; and the save area an optional one holds, which the user path owns.

fn extended_lower(mut lo: Lowering, mut fx: Fx, supply: Supply) {
    let base = cpu_word(mut fx, held: supply.param(0))
    match supply.member() {
        "of" => {
            mut lo.initial_extended(mut fx, base)
            word_result(mut lo, mut fx, supply, value: base)
        }
        "into_frame" => word_result(mut lo, mut fx, supply, value: base)
        "vector" => {
            let narrow = supply.param(1).scalar_value()
            let index = mut fx.b.uextend(PTR, x: narrow)
            let vector = mut lo.extended_vector(mut fx, base, index)
            let zero = mut fx.ptr(0)
            let value = mut fx.slot(16, align: 8)
            for step in 0..<2u64 {
                let half = step * 8
                let bits = mut fx.load(PTR, addr: vector.at, offset: half)
                let chosen = mut fx.b.select(vector.held, x: bits, y: zero)
                mut fx.store(chosen, addr: value, offset: half)
            }
            let held = mut lo.held_at(mut fx, ty: supply.abi.result, address: value)
            supply.ret(mut lo, mut fx, held)
        }
        "set_vector" => {
            let narrow = supply.param(1).scalar_value()
            let index = mut fx.b.uextend(PTR, x: narrow)
            let value_ty = supply.abi.params[2].nty.ty()
            let value = mut fx.slot(16, align: 8)
            mut lo.store_held(mut fx, address: value, held: supply.param(2), ty: value_ty)
            mut lo.hold_extended_vectors(mut fx, base)
            let vector = mut lo.extended_vector(mut fx, base, index)
            for step in 0..<2u64 {
                let half = step * 8
                let bits = mut fx.load(PTR, addr: value, offset: half)
                mut fx.store(bits, addr: vector.at, offset: half)
            }
            supply.done(mut lo, mut fx)
        }
        "with" => {
            let previous = mut lo.call_routine(mut fx, routine: Routine.Extended, args: fx.list1(base).view())
            let body_ty = fn_param(lo, supply, index: 1)
            let called = mut lo.call_value(mut fx, fn_ty: body_ty, function: supply.param(1).address_value(), args: mem::List[Held].empty(fx.alloc).view())
            discard mut lo.call_routine(mut fx, routine: Routine.Extended, args: fx.list1(previous[0]).view())
            hw_forward(mut lo, mut fx, supply, called)
        }
        else => {
            expect false
        }
    }
} extended_lower

/// The save area of the `Option[hw::ExtendedState]` at an address, zero for `None`.
fn extended_optional_area(mut lo: Lowering, mut fx: Fx, ty: ty::Ty, address: clif::Value) -> clif::Value {
    let present = mut lo.variant_is(mut fx, address, ty, variant: "Some")
    let payload = mut lo.payload_address(mut fx, ty, variant: "Some", label: "", address)
    let base = mut fx.load(PTR, addr: payload, offset: 0)
    let zero = mut fx.ptr(0)
    return mut fx.b.select(present, x: base, y: zero)
} extended_optional_area
